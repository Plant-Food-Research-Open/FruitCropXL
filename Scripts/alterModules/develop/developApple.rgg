import static absOrgan.*;
import static leaf.*;
import static shoot.*;
import static plantBase.*;
import static charts.*;
import static outputTables.*;
import static environment.*;
import static globalParameters.*;
import static plantParameters.*;
import static modelOptions.*;
import static initialConditions.*;
import static carbonTransport.*;
import static shootPositioning.*;
import static structuralVariation.*;
import static pruning.*;
import static extraTools.*;
import static archReader.*;
import static flowerBase.*;
import static phenology.*;
import static developBase.*;
import static fruitBase.*;
import static budBase.*;
import static budApple.*;
import static fieldBase.*;
import static shootBase.*;
import static diagnosticTables.*;
import java.util.ArrayList;

/**
 * Apple dynamic-growth rewrite stage.
 *
 * <p>This file owns the <em>topology-changing</em> half of apple growth. It
 * consumes the bud-side plans created in {@code budApple.rgg}, converts buds to
 * apices, advances vegetative and floral apexes one phytomer at a time, and
 * spawns any planned lateral or bourse child axes when the current rank reaches
 * the attached plan slot.</p>
 *
 * <p>The file is deliberately split between rules that only update state
 * ({@code increment()}, water potential, fruit bookkeeping) and rules that
 * create or delete topology (bud burst, phytomer emission, child-axis creation,
 * cleanup). The comments below document that distinction explicitly because it is
 * easy to lose once XL rewrite blocks become long.</p>
 *
 * <h2>Dynamic-growth chain</h2>
 * <ol>
 *   <li>Bud burst: a dormant bud passes phenology and idempotency checks.</li>
 *   <li>Apex initiation: the bud plan is copied into a new apex.</li>
 *   <li>Phytomer emission: the apex decides whether the next rank is due.</li>
 *   <li>Topology rewrite: the develop rule creates internodes, joints, leaves,
 *       flowers, and any planned lateral or bourse child buds/apices.</li>
 *   <li>Cleanup and termination: duplicate candidates are pruned conservatively
 *       and terminal apices are removed when their life cycle ends.</li>
 * </ol>
 */
public class DevelopApple extends DevelopService {
	/** Keep deserialization compatibility with previously saved graphs. */
	private static final long serialVersionUID = -1849543602051133894L;




	/** Main apple develop pass; see class-level workflow summary for stage ordering. */
	public void develop() {
		boolean newShootAppeared = false;
		resetLateralAttachClaimCacheIfNeeded();
		reportAppleIdempotencyStatsIfDebug();
		[
		/**
		 * Bud-burst rewrite.
		 *
		 * <p>Biological role: convert a dormant bud into a growing apex once the
		 * bud-side phenology and idempotency guards allow it.</p>
		 *
		 * <p>Structural effect: delete the bud node and create an apex in its place,
		 * preserving the bud's axis identity, shoot type, and declination orientation.</p>
		 *
		 * <p>State updates: the new apex is initiated from the source bud, and the
		 * debug block reports the source bud/site relationship for duplicate tracing.</p>
		 */
		{//start a java block inside the Lsystem [] block
			if (initiation_method.contains("ArchReader") && globalParameters.addBuds == false) 
			{ //java if statement
				[ //XL replacement rules
				
					ShootMeristem b:BudService, (b.shouldBreak()) ==>
						{ApexService apex = b.createApex();} 
						//RV(-1 * random(-0.3, 0.3)) 
						RL(b.declinationAngleDeg) a:apex
						{		
							a.initiate(b);
							if (printFlag || debug) {
								Internode parentInternode = resolveBudParentInternode(b);
								int budCountOnSite = countBudsOnInternodeSite(parentInternode);
								println("[bud-burst] step=" + step
									+ " budId=" + b.getId()
									+ " budType=" + b.budType
								+ " shootType=" + b.shootType
								+ " parentInternodeId=" + ((parentInternode != null) ? parentInternode.getId() : 0L)
								+ " budCountOnSite=" + budCountOnSite
								+ " apexId=" + a.getId());
						}
					}
					; //end of the replacement rule
				]
			} else {
				[ //XL replacement rules
				
					b:BudService, (b.shouldBreak()) ==>
						{ApexService apex = b.createApex();} 
						//RV(-1 * random(-0.3, 0.3)) 
						RL(b.declinationAngleDeg) a:apex
						{		
							a.initiate(b);
							if (printFlag || debug) {
								Internode parentInternode = resolveBudParentInternode(b);
								int budCountOnSite = countBudsOnInternodeSite(parentInternode);
								println("[bud-burst] step=" + step
									+ " budId=" + b.getId()
									+ " budType=" + b.budType
								+ " shootType=" + b.shootType
								+ " parentInternodeId=" + ((parentInternode != null) ? parentInternode.getId() : 0L)
								+ " budCountOnSite=" + budCountOnSite
								+ " apexId=" + a.getId());
						}
					}
					; //end of the replacement rule
				]
			
			} // end of the java if statement
			
		} //end of the java block
		 
		/**
		 * Mixed-bud floral apex rewrite.
		 *
		 * <p>Biological role: advance the rosette leaf sequence on a mixed bud, emit
		 * the flower cluster on the final rosette event, and spawn any planned bourse
		 * child axes at the attach ranks stored on the bud-side spur plan.</p>
		 *
		 * <p>Structural effect: create one rosette phytomer per activation, optionally
		 * create a flower cluster, and instantiate child apexes for any scheduled
		 * bourse shoots. The rule leaves the rosette axis branch-free except for the
		 * planned bourse children.</p>
		 *
		 * <p>State updates: consumes {@code spurAttachPlan} / {@code bourseShootPlans},
		 * marks the mixed-bud flower appearance, and advances the rosette-rank cursor.</p>
		 */
		a:ApexService, (useStaticArc == false &&
						a.shouldProduceFlower == true &&
						a.shouldProducePhytomer() == true &&
						a.rank <= ((a instanceof ApexApple) ? ((ApexApple)a).floralRosetteLeafCount : 5)) ==>
			{
				ShootBase sb1 = first((* s:ShootBase, (s.isBaseOf(a)) *));
				// Keep raw collections here; RGG action blocks do not parse generic declarations reliably.
				ArrayList bourseApexes = new ArrayList();
				ArrayList boursePlans = new ArrayList();
				ArrayList boursePlanIndices = new ArrayList();
				boolean flowerAppearanceNow = false;
				int attachRank = Math.max(1, a.rank);
				FlowerCreator flowerCreator = null;
				Flower flower = null;
				int flowerCount = 0;
				int flowerColor = 1;
				float flowerRL = 0;
				if (a instanceof ApexApple) {
					ApexApple aa = (ApexApple)a;
					int childPlanIndex = aa.popPlannedBoursePlanIndexAtRosetteRank(attachRank);
					while (childPlanIndex >= 0) {
						AppleShootPlan childShootPlan = aa.getBourseShootPlan(childPlanIndex);
						if (childShootPlan == null && printFlag) {
							println("[mixed-bud][bourse] missing child plan parentApex=" + a.getId()
								+ " attachRank=" + attachRank
								+ " childPlanIdx=" + childPlanIndex);
						}
						if (childShootPlan != null && aa.bourseShootCountSpawned < aa.bourseShootCountTarget) {
							BudService bud = new BudCreator(species).createBud();
							ApexService apex1 = bud.createApex();
							aa.bourseShootCountSpawned = aa.bourseShootCountSpawned + 1;
							bourseApexes.add(apex1);
							boursePlans.add(childShootPlan);
							boursePlanIndices.add(childPlanIndex);
							if (printFlag) {
								println("[mixed-bud][bourse] spawned parentApex=" + a.getId()
									+ " attachRank=" + attachRank
									+ " childPlanIdx=" + childPlanIndex
									+ " childTotalNodes=" + childShootPlan.totalNodes
									+ " childMainNodes=" + childShootPlan.mainNodesPlanned
									+ " childBranches=" + childShootPlan.nBranches
									+ " spawnedCount=" + aa.bourseShootCountSpawned
									+ "/" + aa.bourseShootCountTarget);
							}
						} else if (childShootPlan != null && printFlag) {
							println("[mixed-bud][bourse] skipped parentApex=" + a.getId()
								+ " attachRank=" + attachRank
								+ " childPlanIdx=" + childPlanIndex
								+ " childTotalNodes=" + childShootPlan.totalNodes
								+ " reason=targetAlreadyReached");
						}
						childPlanIndex = aa.popPlannedBoursePlanIndexAtRosetteRank(attachRank);
					}
					flowerAppearanceNow = aa.shouldCreateFlowerAtCurrentRosetteRank(attachRank);
					if (flowerAppearanceNow) {
						// Mixed-bud flower appearance coincides with the final rosette leaf event.
						aa.markMixedBudFlowerAppearance(attachRank);
						flowerCreator = new FlowerCreator(species);
						
						flowerColor = irandom(1,99);
						flowerRL = irandom(10,35);
						int flowerMaxConfigured = Math.max(1, FLOWERS_PER_FLORAL);
						flowerCount = a.flowerNumber;
						if (flowerCount <= 0) flowerCount = flowerMaxConfigured;
						flowerCount = Math.min(flowerMaxConfigured, flowerCount);
					}
				}
			}
			if (sb1 == null) (
				sb2:ShootBase
				{
					sb2.initiate(a);
					if (printFlag || debug) {
						println("[apple][shootbase-new] step=" + step
							+ " apexId=" + a.getId()
							+ " order=" + a.order
							+ " rank=" + a.rank
							+ " shootType=" + a.shootType
							+ " shootNumber=-1"
							+ " syllepticOrder=" + a.syllepticOrder
							+ " axis2=" + a.axis2ID
							+ " axis3=" + a.axis3ID
							+ " axis4=" + a.axis4ID
							+ " axis5=" + a.axis5ID
							+ " axis6=" + a.axis6ID
							+ " axis7=" + a.axis7ID
							+ " axis8=" + a.axis8ID
							+ " axis9=" + a.axis9ID
							+ " cpn=" + a.cpn);
					}
				}
			)
			if (bourseApexes != null && bourseApexes.size() > 0) (
				for (int bourseIdx = 0; bourseIdx < bourseApexes.size(); bourseIdx++) (
					{
						ApexService apexPlanned = (ApexService) bourseApexes.get(bourseIdx);
						AppleShootPlan childShootPlan = (AppleShootPlan) boursePlans.get(bourseIdx);
						int childPlanIndex = ((Integer) boursePlanIndices.get(bourseIdx)).intValue();
						float childAzimuth = (float) (137.5 * (bourseIdx + 1) + random(-15, 15));
						float childDecl = (float) random(35, 60);
						float childRoll = (float) random(-0.3, 0.3);
					}
					[ RH(childAzimuth) RL(childDecl) RV(childRoll) a1:apexPlanned {
						if (a1 instanceof ApexApple) {
							((ApexApple)a1).initiateBourseFromParent(a, childShootPlan, childPlanIndex, attachRank);
						} else {
							a1.phytomerNumber = (childShootPlan != null) ? childShootPlan.mainNodesPlanned : 1;
							a1.initiate(a);
						}
					} ]
				)
			)
			[
				{
					int rosetteRankIndex0 = Math.max(0, a.rank - 1);
					int profileIndex0 = rosetteRankIndex0;
					int leafRank = profileIndex0 + 1;
					int nRosetteLeaf = (a instanceof ApexApple) ? ((ApexApple)a).floralRosetteLeafCount : 5;
					double actualArea_m2 = Double.NaN;
					double potentialArea_m2 = Double.NaN;
					double actualLeafLength_m = Double.NaN;
					double actualLeafWidth_m = Double.NaN;
					double potentialLeafLength_m = Double.NaN;
					double potentialLeafWidth_m = Double.NaN;
					double actualRosetteAxis_m = Double.NaN;
					double potentialRosetteAxis_m = Double.NaN;
					double actualRosettePetiole_m = Double.NaN;
					double potentialRosettePetiole_m = Double.NaN;
					if (hasOrganSizeInput() && rosetteLeafProfile != null) {
						actualArea_m2 = Organ.profileValueAtRank(rosetteLeafProfile, profileIndex0 + 1);
						if (rosetteLeafLengthProfile != null) {
							actualLeafLength_m = Organ.profileValueAtRank(rosetteLeafLengthProfile, profileIndex0 + 1);
							potentialLeafLength_m = Organ.actualToPotentialSize(actualLeafLength_m);
						}
						if (rosetteLeafWidthProfile != null) {
							actualLeafWidth_m = Organ.profileValueAtRank(rosetteLeafWidthProfile, profileIndex0 + 1);
							potentialLeafWidth_m = Organ.actualToPotentialSize(actualLeafWidth_m);
						}
						potentialArea_m2 = Organ.actualToPotentialSize(actualArea_m2);
						if (rosetteInternodeProfile != null) {
							actualRosetteAxis_m = Organ.profileValueAtRank(rosetteInternodeProfile, profileIndex0 + 1);
							potentialRosetteAxis_m = Organ.actualToPotentialSize(actualRosetteAxis_m);
						}
						if (rosettePetioleProfile != null) {
							actualRosettePetiole_m = Organ.profileValueAtRank(rosettePetioleProfile, profileIndex0 + 1);
							potentialRosettePetiole_m = Organ.actualToPotentialSize(actualRosettePetiole_m);
						}
					}
					float rH = irandom(69,85);
					float rL = irandom(60,85);
					float rosettePetDecl = JMidrib.samplePetioleDeclDeg();
					float rosetteRollDeg = JMidrib.sampleLeafRollDeg();
				}
				// keep the original rosette placement style, but emit one rosette leaf per phytomer event
				RH(rosetteRankIndex0 * rH) RL(rL) pt:Petiole
				{
					pt.initiate_apex(a);
					pt.rank = leafRank;
					double rosetteShortAxisTarget_m = resolvePotentialPetioleLength(rosettePetioleProfile, profileIndex0 + 1, potentialLeafLength_m, pt.fpetio);
					if (!(Double.isNaN(rosetteShortAxisTarget_m) || rosetteShortAxisTarget_m <= 0.0)) {
						Organ.applyPetioleTargetLengthAtInit(pt, rosetteShortAxisTarget_m);
					}
				}
				jm:JMidrib(0.0)
				for (int m = 0; m < leafShape.polyleaf[0].length; m++) (
					[lf:Leaf]
					{
						lf.initiate_apex(a);
							lf.fid = m;
							lf.organType = "rosetteLeaf";
							lf.markFastEarlyExpansionLeaf("rosette");
							lf.rank = leafRank;
							lf.rosetteRankIndex = profileIndex0;
							lf.rosetteLeafCount = nRosetteLeaf;
						if (hasOrganSizeInput() && rosetteLeafProfile != null) {
							lf.rosetteRankScale = Organ.actualToPotentialSize(1.0);
						}
						lf.expansionHalfTimePotential = lf.te;
						lf.expansionHalfTimeRealized = lf.te;
						if (hasOrganSizeInput() && rosetteLeafProfile != null) {
							double realizedLeafArea_m2 = leafAreaFromGeometry(actualLeafLength_m, actualLeafWidth_m, m, actualArea_m2);
							double targetLeafArea_m2 = leafAreaFromGeometry(potentialLeafLength_m, potentialLeafWidth_m, m, potentialArea_m2);
							lf.potentialFinalSize = targetLeafArea_m2;
							lf.realizedFinalSize = realizedLeafArea_m2;
							lf.realizationRatio = safeRealizationRatio(lf.realizedFinalSize, lf.potentialFinalSize);
							lf.profileFinalSizeLocked = true;
							if (hasLeafGeometry(potentialLeafLength_m, potentialLeafWidth_m)) {
								// Apple profile files define final target geometry; current area remains separate.
								Organ.applyLeafTargetGeometryAtInit(lf, potentialLeafLength_m, potentialLeafWidth_m);
							} else {
								Organ.applyLeafTargetAreaAtInit(lf, Math.max(1.0e-8, targetLeafArea_m2));
							}
						}
						lf.area = leafShape.calcLeafPolygonArea(lf.length, lf.width, lf.fid);
						if (lf.potentialFinalSize > 0.0 && !(hasOrganSizeInput() && rosetteLeafProfile != null)) {
							lf.realizedFinalSize = lf.area;
							lf.realizationRatio = safeRealizationRatio(lf.realizedFinalSize, lf.potentialFinalSize);
						}
						jm.initiateWithAngles(lf, rosettePetDecl, rosetteRollDeg);
						if (outputAppleDevelopmentDiagnostics) {
							appendMixedBudDebug(lf, a, "mixed", nRosetteLeaf,
								((a instanceof ApexApple) ? ((ApexApple) a).bourseShootCountTarget : 0),
								"spur", lf.rank, lf.potentialFinalSize, lf.realizedFinalSize,
								safeStress(a), dafbApprox(a), "rosette", dafbApprox(a) >= 0.0);
						}
					}
				)
			]
			{
				if (outputAppleDevelopmentDiagnostics || debug) {
					logAppleLeafInitiation(a, "rosetteLeaf", rosetteRankIndex0 + 1, resolveApexParentInternodeId(a));
				}
			}
			if (flowerAppearanceNow && flowerCreator != null) (
				for (int i = 0; i < flowerCount; i++) (
					{flower = flowerCreator.createFlower();}
					[ f:flower {
						f.initiate(a, flowerColor, i*irandom(69,85), flowerRL);
						configureMixedBudFlowerFromApex(f, a, i == 0);
						if (outputAppleDevelopmentDiagnostics) {
							appendFlowerTimingDebug("appearance", f, (a instanceof ApexApple) ? (ApexApple)a : null);
						}
					} ]
				)
			)
			if (!flowerAppearanceNow) (
			a
			{
				if (a instanceof ApexApple) {
					// Block same-step recursive derive() from letting one apex emit twice in one external pass.
					((ApexApple) a).markPhytomerProducedThisStep();
				}
				a.increment();
				derive();
				newShootAppeared = true;
			}
			)
			{
				if (flowerAppearanceNow) {
					// Final mixed-bud rosette event must still advance the apex rank; otherwise the same
					// floral apex remains eligible on later steps and can emit a duplicate leaf at this rank.
					if (a instanceof ApexApple) {
						// Block same-step recursive derive() from letting one apex emit twice in one external pass.
						((ApexApple) a).markPhytomerProducedThisStep();
					}
					a.increment();
					derive();
					newShootAppeared = true;
				}
			}
		; // end dynamic floral rosette rule

			 
		/**
		 * Compatibility bud-germination wrapper.
		 *
		 * <p>This file now performs bud burst through the explicit bud-burst rule
		 * above, but this marker remains so older code paths and comments still point
		 * to the same biological event.</p>
		 */
		
		/**
		 * Update apex water potential without changing topology.
		 */
		a:ApexService ::> 
		{
			a.updateWaterPotential();
		}
		/**
		 * Vegetative phytomer rewrite.
		 *
		 * <p>Biological role: extend an active vegetative shoot by one main-axis
		 * phytomer and, if the plan says so, emit one lateral bud from the newly
		 * formed internode.</p>
		 *
		 * <p>Structural effect: create the internode/joint/leaf set, consult the
		 * apex-side branch cursor for the current rank, and then advance the apex.</p>
		 *
		 * <p>State updates: {@code popPlannedBranchLenAtCurrentNode()} consumes the
		 * bud-side plan, and {@code a.increment()} happens only after the new topology
		 * has been created.</p>
		 */
		a:ApexService, (useStaticArc == false && 
						a.shouldProducePhytomer() == true && 
						a.shouldProduceFlower == false) ==>
		{	
			ShootBase sb1 = first((* s:ShootBase, (s.isBaseOf(a)) *));			
		}
			if (sb1 == null) (
				sb2:ShootBase
				{
					sb2.initiate(a);
					if (printFlag || debug) {
						println("[apple][shootbase-new] step=" + step
							+ " apexId=" + a.getId()
							+ " order=" + a.order
							+ " rank=" + a.rank
							+ " shootType=" + a.shootType
							+ " shootNumber=-1"
							+ " syllepticOrder=" + a.syllepticOrder
							+ " axis2=" + a.axis2ID
							+ " axis3=" + a.axis3ID
							+ " axis4=" + a.axis4ID
							+ " axis5=" + a.axis5ID
							+ " axis6=" + a.axis6ID
							+ " axis7=" + a.axis7ID
							+ " axis8=" + a.axis8ID
							+ " axis9=" + a.axis9ID
							+ " cpn=" + a.cpn);
					}
				}
			) 	
			RH(phyllotaxis) 
			i:Internode jt:Joint {
			if (printFlag || debug) println("new internode");
			i.initiate_apex(a);
		if (hasOrganSizeInput() && "bourseShoot".equals(a.shootType) && bourseInternodeProfile != null) {
			double actualI = Organ.profileValueAtRank(bourseInternodeProfile, a.rank);
			double potI = Organ.actualToPotentialSize(actualI);
			double gI = safeStress(a);
			double realI = actualI;
				i.potentialFinalSize = potI;
				i.realizedFinalSize = realI;
				i.realizationRatio = safeRealizationRatio(i.realizedFinalSize, i.potentialFinalSize);
				Organ.applyInternodeTargetLengthAtInit(i, Math.max(0.001, potI));
			} else if (hasOrganSizeInput() && !"bourseShoot".equals(a.shootType) && vegShootInternodeProfile != null) {
			double actualIveg = Organ.profileValueAtRank(vegShootInternodeProfile, a.rank);
			double potIveg = Organ.actualToPotentialSize(actualIveg);
				i.potentialFinalSize = potIveg;
				i.realizedFinalSize = actualIveg;
				i.realizationRatio = safeRealizationRatio(i.realizedFinalSize, i.potentialFinalSize);
				Organ.applyInternodeTargetLengthAtInit(i, Math.max(0.001, potIveg));
			}
		jt.initiate(i); jt.setTropism(a);}
		
		{
			// Ask the apex if a branch is planned for THIS node (1-based = a.rank)
			int plannedLen = 0;
			int existingBudCountOnNode = 0;
			long existingBudId = 0L;
			boolean skipExistingLateral = false;
			if (a instanceof ApexApple) {
				plannedLen = ((ApexApple) a).popPlannedBranchLenAtCurrentNode();
				if (plannedLen > 0) {
					existingBudCountOnNode = countBudsOnInternodeSite(i);
					BudService existingBud = firstBudOnInternodeSite(i);
					skipExistingLateral = (existingBud != null);
					existingBudId = skipExistingLateral ? existingBud.getId() : 0L;
					if (skipExistingLateral == false && !reserveLateralBudSite(i)) {
						skipExistingLateral = true;
						existingBudId = -1L;
					}
					if (printFlag || debug) {
						String axisLabel = "bourseShoot".equals(a.shootType) ? "[mixed-bud][child-lateral]" : "[vegetative][lateral]";
						println(axisLabel + " parentApex=" + a.getId()
							+ " nodeRank=" + a.rank
							+ " internodeId=" + i.getId()
							+ " plannedBranchLen=" + plannedLen
							+ " existingBudCountOnSite=" + existingBudCountOnNode
							+ " existingBudId=" + existingBudId);
					}
				}
			}
		
			// If a lateral is planned, create a Bud now and initialize with preplanned nodes
		}
		if (plannedLen > 0 && skipExistingLateral == false) (
			[
				{BudService bud = new BudCreator(species).createBud(); }
					bd:bud {
						if (bd instanceof BudAppleService) {
							((BudAppleService) bd).initiatePreplanned(i, plannedLen);
							((BudAppleService) bd).setParentAxisApexId(a.getId());
						} else {
							// Fallback for non-apple (keeps pipeline robust)
							bd.initiate(i, 0);
					}
					bd.storeParentId(i);
					if (printFlag || debug) {
						println("[lat-create] step=" + step
							+ " parentApexId=" + a.getId()
							+ " nodeRank=" + a.rank
							+ " internodeId=" + i.getId()
							+ " plannedLen=" + plannedLen
							+ " budId=" + bd.getId()
							+ " budOrder=" + bd.order
							+ " existingBudCountOnSite=" + existingBudCountOnNode);
					}
				}
			]
		)
		if (plannedLen > 0 && skipExistingLateral == true) (
			{
				if (printFlag || debug) {
					println("[lat-skip-existing] step=" + step
						+ " parentApexId=" + a.getId()
						+ " nodeRank=" + a.rank
						+ " internodeId=" + i.getId()
						+ " plannedLen=" + plannedLen
						+ " existingBudCountOnSite=" + existingBudCountOnNode
						+ " existingBudId=" + existingBudId
						+ " reason=" + ((existingBudId == -1L) ? "siteAlreadyClaimedThisStep" : "existingBudOnSite"));
				}
			}
		)

		{
			boolean emitLeafBranch = true;
			int existingPetiolesOnInternode = 0;
			if ("apple".equals(species)) {
				existingPetiolesOnInternode = countDirectPetiolesOnInternode(i);
				emitLeafBranch = shouldEmitLeafBranchOnInternode(i);
			}
			if (!emitLeafBranch && (printFlag || debug)) {
				println("[dup-petiole-skip] step=" + step
					+ " apex=" + a.getId()
					+ " internode=" + i.getId()
					+ " rank=" + a.rank
