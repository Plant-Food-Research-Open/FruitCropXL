						} else if (outputAppleDevelopmentDiagnostics && hasOrganSizeInput() && !"bourseShoot".equals(a.shootType) && vegShootLeafProfile != null) {
							appendMixedBudDebug(lf, a, "vegetative", 0, 0, "vegetative", a.rank,
