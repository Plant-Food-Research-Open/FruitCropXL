							double realVegA = leafAreaFromGeometry(actualVegL, actualVegW, m, actualVegA);
							lf.potentialFinalSize = potVegA;
							lf.realizedFinalSize = realVegA;
							lf.realizationRatio = safeRealizationRatio(lf.realizedFinalSize, lf.potentialFinalSize);
							lf.profileFinalSizeLocked = true;
							if (hasLeafGeometry(potVegL, potVegW)) {
