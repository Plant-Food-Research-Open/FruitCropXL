						} else if (hasOrganSizeInput() && !"bourseShoot".equals(a.shootType) && vegShootLeafProfile != null) {
							double actualVegA = Organ.profileValueAtRank(vegShootLeafProfile, a.rank);
							double actualVegL = Double.NaN;
							double actualVegW = Double.NaN;
							double potVegL = Double.NaN;
							double potVegW = Double.NaN;
