											+ " flowerId=" + f.getId()
											+ " plant=" + f.plantNumber
											+ " pbNull=" + (pb == null)
											+ " internodeNull=" + (itn == null));
									}
								
							}
							//adding fruit to the graph
							if(pb != null && itn != null) (
								[ 
									b:main.FRUIT_CREATOR.createFruit(FruitService.originalParametersFactory, FruitService.DELTA)
									{
										b.initiate_pb(pb, itn); 
