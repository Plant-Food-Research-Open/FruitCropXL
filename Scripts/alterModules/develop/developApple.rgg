	/**
	 * Helper functions used by the develop-stage rewrite rules.
	 *
	 * <p>This section contains step-local claim caches, topology lookups, geometry
	 * helpers, and duplicate-detection predicates that keep the long XL rules
	 * readable without hiding the actual state transitions.</p>
	 */
	static int lateralAttachClaimStep = Integer.MIN_VALUE;
	static java.util.Set claimedLateralBudSiteIds = new java.util.HashSet();
	
		/**
		 * Reset the lateral-attach claim cache for the current step.
		 *
		 * <p>Used to prevent two planned laterals from attaching to the same site
		 * within one external derive pass.</p>
		 */
	static void resetLateralAttachClaimCacheIfNeeded() {
		if (lateralAttachClaimStep == step) return;
		lateralAttachClaimStep = step;
		claimedLateralBudSiteIds = new java.util.HashSet();
	}

	/**
	 * Reserve an internode attach site for a lateral bud in the current step.
	 *
	 * @param site internode attachment site
	 * @return {@code true} when the site is reserved now; {@code false} when already claimed
	 */
	static boolean reserveLateralBudSite(Internode site) {
		if (site == null) return false;
		resetLateralAttachClaimCacheIfNeeded();
		Long siteKey = Long.valueOf(site.getId());
		if (claimedLateralBudSiteIds.contains(siteKey)) return false;
		claimedLateralBudSiteIds.add(siteKey);
		return true;
	}

	/** Resolve immediate/ancestral Joint ownership for a Petiole branch root. */
	static Joint parentJointForPetiole(Petiole pt) {
		if (pt == null) return null;
		Joint jt = null;
		try {
			jt = first((* pt (<--)+ j:Joint *));
		} catch (Throwable t) {
			jt = null;
		}
		return jt;
	}

	/** Resolve owning internode via stored parentID contract (safe fallback path). */
	static Internode parentInternodeFromStoredParentId(Petiole pt) {
		if (pt == null || pt.parentID <= 0) return null;
		try {
			Organ parentNode = pt.getParent();
			if (parentNode instanceof Internode) return (Internode) parentNode;
		} catch (Throwable t) {
			return null;
		}
		return null;
	}

	/** Resolve owning internode for a petiole (stored parent first, topology fallback second). */
	static Internode parentInternodeForPetiole(Petiole pt) {
		if (pt == null) return null;
		Internode storedSite = parentInternodeFromStoredParentId(pt);
		if (storedSite != null) return storedSite;
		Joint jt = parentJointForPetiole(pt);
		return parentInternodeForJoint(jt);
	}

	/** Resolve nearest internode ancestor for a joint site. */
	static Internode parentInternodeForJoint(Joint jt) {
		if (jt == null) return null;
		Internode site = null;
		try {
			site = first((* jt (<--)+ i:Internode *));
		} catch (Throwable t) {
			site = null;
		}
		return site;
	}

	static int countDirectPetiolesOnInternode(Internode site) {
		if (site == null) return 0;
		int petioleCount = 0;
		long siteId = site.getId();
		for (Petiole petioleNode : (* storedPetiole:Petiole, (storedPetiole.parentID == siteId) *)) {
			if (petioleNode == null) continue;
			petioleCount++;
		}
		if (petioleCount > 0) return petioleCount;
		for (Petiole petioleNode : (* site (-->)+ petCand:Petiole *)) {
			if (petioleNode == null) continue;
			Internode parentSite = parentInternodeForPetiole(petioleNode);
			if (parentSite == null || parentSite != site) continue;
			petioleCount++;
		}
		return petioleCount;
	}

	static boolean shouldEmitLeafBranchOnInternode(Internode site) {
		return countDirectPetiolesOnInternode(site) == 0;
	}

	static double safeStress(ApexService a) {
		double g = 1.0;
		try {
			PlantBase pb = first((* p:PlantBase, (p.plantNumber == a.plantNumber) *));
			if (pb != null) g = pb.fMb_shoot;
		} catch (Throwable t) {
			g = 1.0;
		}
		if (Double.isNaN(g) || Double.isInfinite(g)) g = 1.0;
		if (g < 0.0) g = 0.0;
		if (g > 1.0) g = 1.0;
		return g;
	}

	static double dafbApprox(ApexService a) {
		return a.age - FLOWERING_TARGET;
	}

	static boolean hasLeafGeometry(double leafLength_m, double leafWidth_m) {
		return !(Double.isNaN(leafLength_m) || Double.isInfinite(leafLength_m) || leafLength_m <= 0.0 ||
			Double.isNaN(leafWidth_m) || Double.isInfinite(leafWidth_m) || leafWidth_m <= 0.0);
	}

	static double leafAreaFromGeometry(double leafLength_m, double leafWidth_m, int fid, double fallbackArea_m2) {
		if (!hasLeafGeometry(leafLength_m, leafWidth_m)) return fallbackArea_m2;
		double area_m2 = leafShape.calcLeafPolygonArea((float) leafLength_m, (float) leafWidth_m, fid);
		if (Double.isNaN(area_m2) || Double.isInfinite(area_m2) || area_m2 <= 0.0) return fallbackArea_m2;
		return area_m2;
	}

	static double resolvePotentialPetioleLength(double[][] petioleProfile, int rank1, double potentialLeafLength_m, double fpetioScale) {
		double targetLength_m = Double.NaN;
		double scale = fpetioScale;
		if (Double.isNaN(scale) || Double.isInfinite(scale) || scale <= 0.0) {
			scale = 0.5;
		}
		if (!(Double.isNaN(potentialLeafLength_m) || Double.isInfinite(potentialLeafLength_m) || potentialLeafLength_m <= 0.0)) {
			targetLength_m = scale * potentialLeafLength_m;
		}
		if ((Double.isNaN(targetLength_m) || Double.isInfinite(targetLength_m) || targetLength_m <= 0.0) && petioleProfile != null) {
			double actualPetioleLength_m = Organ.profileValueAtRank(petioleProfile, rank1);
			if (!(Double.isNaN(actualPetioleLength_m) || Double.isInfinite(actualPetioleLength_m) || actualPetioleLength_m <= 0.0)) {
				targetLength_m = Organ.actualToPotentialSize(actualPetioleLength_m);
			}
		}
		return targetLength_m;
	}

	static boolean isMixedBudDynamicFloralApex(ApexService a) {
		return (a instanceof ApexApple) && a.shouldProduceFlower == true;
	}

	static double safeRealizationRatio(double realized, double potential) {
		if (Double.isNaN(potential) || Double.isInfinite(potential) || potential <= 1.0e-12) return 1.0;
		double ratio = realized / potential;
		if (Double.isNaN(ratio) || Double.isInfinite(ratio)) return 1.0;
		return Math.max(0.0, ratio);
	}

	static void configureMixedBudFlowerFromApex(Flower f, ApexService a, boolean bloomReporter) {
		if (f == null) return;
		if (!(a instanceof ApexApple)) return;
		ApexApple aa = (ApexApple)a;
		double floweringTD = aa.getMixedBudFloweringTDFromBudBurst();
		if (Double.isNaN(floweringTD) || Double.isInfinite(floweringTD) || floweringTD <= 0.0) {
			floweringTD = 20.0;
		}
		f.mixedBudAppearanceDriven = true;
		f.bloomControlledByApexBudBurst = true;
		f.sourceApexID = a.getId();
		f.sourceRosetteTarget = aa.floralRosetteLeafCount;
		f.sourceRosetteAppearanceRank = aa.mixedBudFlowerAppearanceRank;
		f.sourceApexBirthAge = aa.birthAge;
		f.sourceApexBirthAgeD = aa.birthAgeD;
		f.sourceApexBirthAgeGdd = aa.birthAgeGdd;
		f.sourceApexAppearanceAge = aa.mixedBudFlowerAppearanceAge;
		f.sourceApexAppearanceAgeD = aa.mixedBudFlowerAppearanceAgeD;
		f.sourceApexAppearanceAgeGdd = aa.mixedBudFlowerAppearanceAgeGdd;
		f.sourceApexThermalSinceBudBurstAtAppearance = aa.thermalTimeSinceBudBurst();
		f.floweringTDFromBudBurst = floweringTD;
		f.floweringTD = (float) floweringTD;
		/*
		 * For mixed buds, tm records the source-apex thermal threshold from bud burst.
		 * Local Flower.age is not used to decide bloom for mixed buds.
		 */
		f.tm = floweringTD;
		f.te = floweringTD + f.fruitingTD;
		f.sourceApexThermalSinceBudBurst = aa.thermalTimeSinceBudBurst();
		f.sourceApexDaysSinceBudBurst = aa.daysSinceBudBurst();
		f.mixedBudBloomDelayAfterAppearance = floweringTD;
		f.mixedBudBloomDebugReporter = bloomReporter;
	}

	static ApexApple resolveMixedBudFlowerSourceApex(Flower f) {
		if (f == null) return null;
		if (f.sourceApexID == 0L) return null;
		ApexApple aa = first((* a:ApexApple, (a.getId() == f.sourceApexID) *));
		return aa;
	}

	static void updateMixedBudFlowerTimingFromSourceApex(Flower f) {
		if (f == null) return;
		if (!f.bloomControlledByApexBudBurst) return;
		ApexApple aa = resolveMixedBudFlowerSourceApex(f);
		if (aa == null) return;
		f.sourceApexThermalSinceBudBurst = aa.thermalTimeSinceBudBurst();
		f.sourceApexDaysSinceBudBurst = aa.daysSinceBudBurst();
		f.sourceApexAppearanceAge = aa.mixedBudFlowerAppearanceAge;
		f.sourceApexAppearanceAgeD = aa.mixedBudFlowerAppearanceAgeD;
		f.sourceApexAppearanceAgeGdd = aa.mixedBudFlowerAppearanceAgeGdd;
	}

	static void appendFlowerTimingDebug(String recordType, Flower f, ApexApple aa) {
		if (!outputAppleDevelopmentDiagnostics) return;

		AppleFlowerTimingDiagnosticOutputData row = new AppleFlowerTimingDiagnosticOutputData();
		row.timestamp = timestamp;
		row.step = step;
		row.year = year;
		row.dayOfYear = dayOfYear;
		row.hourOfDay = hourOfDay;
		row.scenario = scenario;
		row.simuuid = simUUID;
		row.plantNumber = (f != null) ? f.plantNumber : ((aa != null) ? aa.plantNumber : -1);
		row.fieldInstanceId = (aa != null) ? aa.fieldInstanceId : ((f != null) ? f.fieldInstanceId : 0);
		row.recordType = recordType;
		row.sourceApexID = (f != null) ? f.sourceApexID : ((aa != null) ? aa.getId() : 0L);
		row.flowerId = (f != null) ? f.getId() : 0L;
		row.sourceRosetteTarget = (f != null) ? f.sourceRosetteTarget : ((aa != null) ? aa.floralRosetteLeafCount : 0);
		row.sourceRosetteAppearanceRank = (f != null) ? f.sourceRosetteAppearanceRank : ((aa != null) ? aa.mixedBudFlowerAppearanceRank : 0);
		row.apexBirthAge = (f != null) ? f.sourceApexBirthAge : ((aa != null) ? aa.birthAge : Double.NaN);
		row.apexBirthAgeD = (f != null) ? f.sourceApexBirthAgeD : ((aa != null) ? aa.birthAgeD : Double.NaN);
		row.apexBirthAgeGdd = (f != null) ? f.sourceApexBirthAgeGdd : ((aa != null) ? aa.birthAgeGdd : Double.NaN);
		row.apexAppearanceAge = (f != null) ? f.sourceApexAppearanceAge : ((aa != null) ? aa.mixedBudFlowerAppearanceAge : Double.NaN);
		row.apexAppearanceAgeD = (f != null) ? f.sourceApexAppearanceAgeD : ((aa != null) ? aa.mixedBudFlowerAppearanceAgeD : Double.NaN);
		row.apexAppearanceAgeGdd = (f != null) ? f.sourceApexAppearanceAgeGdd : ((aa != null) ? aa.mixedBudFlowerAppearanceAgeGdd : Double.NaN);
		row.apexThermalSinceBudBurstAtAppearance = (f != null) ? f.sourceApexThermalSinceBudBurstAtAppearance : ((aa != null) ? aa.thermalTimeSinceBudBurst() : Double.NaN);
		row.currentApexThermalSinceBudBurst = (aa != null) ? aa.thermalTimeSinceBudBurst() : ((f != null) ? f.sourceApexThermalSinceBudBurst : Double.NaN);
		row.floweringTDFromBudBurst = (f != null) ? f.floweringTDFromBudBurst : ((aa != null) ? aa.getMixedBudFloweringTDFromBudBurst() : Double.NaN);
		row.flowerLocalAge = (f != null) ? f.age : Double.NaN;
		row.flowerLocalAgeD = (f != null) ? f.ageD : Double.NaN;
		row.hasFlowered = (f != null) ? f.hasFlowered : false;
		row.ageDAtFlowering = (f != null) ? f.ageDAtFlowering : Double.NaN;
		row.daysAfterBloom = (f != null) ? f.ageD - f.ageDAtFlowering : Double.NaN;
		row.fruitingDaysAfterBloom = (f != null) ? f.fruitingDaysAfterBloom : Double.NaN;
		DiagnosticTableCoordinator.writeAppleFlowerTiming(row);
	}

	static void appendMixedBudDebug(Leaf lf, ApexService a, String budType,
		int nSpurLeaves, int nBourseShoots, String leafType, int leafRank,
		double potentialArea, double realizedArea, double carbonStressFactor,
		double dafb, String stage, boolean bourseExporterFlag) {
		if (!outputAppleDevelopmentDiagnostics) return;

		AppleSpurBourseDiagnosticOutputData row = new AppleSpurBourseDiagnosticOutputData();
		row.timestamp = timestamp;
		row.step = step;
		row.year = year;
		row.dayOfYear = dayOfYear;
		row.hourOfDay = hourOfDay;
		row.scenario = scenario;
		row.simuuid = simUUID;
		row.plantNumber = (lf != null) ? lf.plantNumber : ((a != null) ? a.plantNumber : -1);
		row.fieldInstanceId = (lf != null) ? lf.fieldInstanceId : ((a != null) ? a.fieldInstanceId : 0);
		row.recordType = "profilePlan";
		row.plantId = row.plantNumber;
		// Preserve the legacy column semantics: budId stores the emitting apex ID.
		row.budId = (a != null) ? a.getId() : 0L;
		row.budType = budType;
		row.nSpurLeaves = nSpurLeaves;
		row.nBourseShoots = nBourseShoots;
		row.leafType = leafType;
		row.leafRank = leafRank;
		row.potentialArea = potentialArea;
		row.realizedArea = realizedArea;
		row.carbonStressFactor = carbonStressFactor;
		row.DAFB = dafb;
		row.stage = stage;
		row.bourseExporterFlag = bourseExporterFlag;
		DiagnosticTableCoordinator.writeAppleSpurBourse(row);
	}

	static void appendFlowerToFruitDebug(Flower f, FruitService b, PlantBase pb, Internode itn) {
		if (!outputAppleDevelopmentDiagnostics) return;

		AppleFlowerToFruitDiagnosticOutputData row = new AppleFlowerToFruitDiagnosticOutputData();
		row.timestamp = timestamp;
		row.step = step;
		row.year = year;
		row.dayOfYear = dayOfYear;
		row.hourOfDay = hourOfDay;
		row.scenario = scenario;
		row.simuuid = simUUID;
		row.plantNumber = (pb != null) ? pb.plantNumber : ((f != null) ? f.plantNumber : -1);
		row.fieldInstanceId = (pb != null) ? pb.fieldInstanceId : ((f != null) ? f.fieldInstanceId : 0);
		row.flowerId = (f != null) ? f.getId() : 0L;
		row.fruitId = (b != null) ? b.getId() : 0L;
		row.parentInternodeId = (itn != null) ? itn.getId() : 0L;
		row.flowerBiomass = (f != null) ? f.biomass : Double.NaN;
		row.flowerFreshWeight = (f != null) ? f.freshWeight : Double.NaN;
		row.flowerWaterContent = (f != null) ? f.waterContent : Double.NaN;
		row.fruitBiomassAfterInit = (b != null) ? b.biomass : Double.NaN;
		row.fruitFreshWeightAfterInit = (b != null) ? b.freshWeight : Double.NaN;
		row.flowerAge = (f != null) ? f.age : Double.NaN;
		row.flowerAgeD = (f != null) ? f.ageD : Double.NaN;
		row.ageDAtFlowering = (f != null) ? f.ageDAtFlowering : Double.NaN;
		row.daysAfterBloom = (f != null) ? f.ageD - f.ageDAtFlowering : Double.NaN;
		row.fruitingDaysAfterBloom = (f != null) ? f.fruitingDaysAfterBloom : Double.NaN;
		row.FRUIT_DRY_WEIGHT = FRUIT_DRY_WEIGHT;
		row.FRUIT_FRESH_WEIGHT = FRUIT_FRESH_WEIGHT;
		row.FRUIT_AGE_AFTER_FULLBLOOM = FRUIT_AGE_AFTER_FULLBLOOM;
		row.hasFlowered = (f != null) ? f.hasFlowered : false;
		row.dropped = (f != null) ? f.dropped : false;
		DiagnosticTableCoordinator.writeAppleFlowerToFruit(row);
	}

	static long resolveApexParentInternodeId(ApexService a) {
		if (a == null) return 0L;
		Internode parentInternode = null;
		try {
			parentInternode = first((* a (<--)+ ip:Internode *));
		} catch (Throwable t) {
			parentInternode = null;
		}
		return (parentInternode != null) ? parentInternode.getId() : 0L;
	}

	static Internode resolveBudParentInternode(BudService bud) {
		return parentInternodeForBud(bud);
	}

	static String resolveAppleAxisRole(ApexService a) {
		if (!(a instanceof ApexApple)) return "unknown";
		ApexApple aa = (ApexApple) a;
		if (aa.shouldProduceFlower == true) return "rosetteParent";
		if ("bourseShoot".equals(aa.shootType)) return "bourseChild";
		if (aa.getParentAxisApexId() > 0L) return "lateralChild";
		return "parentAxis";
	}

	static void logAppleLeafInitiation(ApexService a, String eventName, int localRank, long parentInternodeId) {
		if (!(outputAppleDevelopmentDiagnostics || debug)) return;
		long apexId = (a != null) ? a.getId() : 0L;
		long parentAxisApexId = 0L;
		long sourceBudId = 0L;
		String shootType = (a != null && a.shootType != null) ? a.shootType : "";
		int order = (a != null) ? a.order : -1;
		if (a instanceof ApexApple) {
			ApexApple aa = (ApexApple) a;
			parentAxisApexId = aa.getParentAxisApexId();
			sourceBudId = aa.getSourceBudId();
		}
		String axisRole = resolveAppleAxisRole(a);
		if (outputAppleDevelopmentDiagnostics) {
			AppleLeafAxisDiagnosticOutputData row = new AppleLeafAxisDiagnosticOutputData();
			row.timestamp = timestamp;
			row.step = step;
			row.year = year;
			row.dayOfYear = dayOfYear;
			row.hourOfDay = hourOfDay;
			row.scenario = scenario;
			row.simuuid = simUUID;
			row.plantNumber = (a != null) ? a.plantNumber : -1;
			row.fieldInstanceId = (a != null) ? a.fieldInstanceId : 0;
			row.plantId = row.plantNumber;
			row.apexId = apexId;
			row.parentAxisApexId = parentAxisApexId;
			row.sourceBudId = sourceBudId;
			row.axisRole = axisRole;
			row.shootType = shootType;
			row.order = order;
			row.localRank = localRank;
			row.parentInternodeId = parentInternodeId;
			row.event = eventName;
			DiagnosticTableCoordinator.writeAppleLeafAxis(row);
		}
		if (debug) {
			println("[apple][leaf-init] step=" + step
				+ " apex=" + apexId
				+ " parentAxisApex=" + parentAxisApexId
				+ " axisRole=" + axisRole
				+ " shootType=" + shootType
				+ " order=" + order
				+ " rank=" + localRank
				+ " parentInternode=" + parentInternodeId
				+ " event=" + eventName);
		}
	}

	/**
	 * Strict apple duplicate-apex identity check.
	 * Duplicate candidates must share the same local axis tuple and apex-role metadata.
	 */
	static boolean sharesAppleApexIdentityKey(ApexService a, ApexService b) {
		if (a == null || b == null) return false;
		if (a == b || a.getId() == b.getId()) return false;
		if (a.plantNumber != b.plantNumber) return false;
		if (a.fieldInstanceId != b.fieldInstanceId) return false;
		if (a.order != b.order) return false;
		if (a.rank != b.rank) return false;
		if (a.cpn != b.cpn) return false;
		if (a.syllepticOrder != b.syllepticOrder) return false;
		if (a.shouldProduceFlower != b.shouldProduceFlower) return false;
		if (!String.valueOf(a.shootType).equals(String.valueOf(b.shootType))) return false;
		if (a.axis1ID != b.axis1ID) return false;
		if (a.axis2ID != b.axis2ID) return false;
		if (a.axis3ID != b.axis3ID) return false;
		if (a.axis4ID != b.axis4ID) return false;
		if (a.axis5ID != b.axis5ID) return false;
		if (a.axis6ID != b.axis6ID) return false;
		if (a.axis7ID != b.axis7ID) return false;
		if (a.axis8ID != b.axis8ID) return false;
		if (a.axis9ID != b.axis9ID) return false;
		return true;
	}

	/** Choose canonical apex (lowest ID) among apple apexes with the same identity tuple. */
	static ApexService canonicalApexAmongIdentityDuplicates(ApexService target) {
		if (target == null) return null;
		ApexService keep = target;
		for (ApexService cand : (* apx:ApexService, (apx.plantNumber == target.plantNumber) *)) {
			if (cand == null || cand.getId() == target.getId()) continue;
			if (!sharesAppleApexIdentityKey(target, cand)) continue;
			if (cand.getId() < keep.getId()) keep = cand;
		}
		return keep;
	}

	/** @return true when target apex is non-canonical among same-identity apple apexes. */
	static boolean isDuplicateIdentityApex(ApexService target) {
		if (target == null) return false;
		ApexService keep = canonicalApexAmongIdentityDuplicates(target);
		if (keep == null) return false;
		return keep.getId() != target.getId();
	}
}
