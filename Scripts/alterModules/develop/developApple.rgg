							double realA = leafAreaFromGeometry(actualL, actualW, m, actualA);
							lf.potentialFinalSize = potA;
							lf.realizedFinalSize = realA;
							lf.realizationRatio = safeRealizationRatio(lf.realizedFinalSize, lf.potentialFinalSize);
							lf.profileFinalSizeLocked = true;
							if (hasLeafGeometry(potL, potW)) {
