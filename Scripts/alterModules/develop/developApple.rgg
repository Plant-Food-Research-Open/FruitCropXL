										println("[flower-to-fruit] rewrite start"
											+ " flowerId=" + f.getId()
											+ " plant=" + f.plantNumber
											+ " ageD=" + f.ageD
											+ " ageDAtFlowering=" + f.ageDAtFlowering
											+ " daysAfterBloom=" + (f.ageD - f.ageDAtFlowering)
											+ " threshold=" + f.fruitingDaysAfterBloom
											+ " biomass=" + f.biomass
											+ " freshWeight=" + f.freshWeight);
									}
									PlantBase pb = first((* p:PlantBase, (p.plantNumber == f.plantNumber)*));	
								Internode itn = first((*f (<--)+ i:Internode, (i.ID > 1)*));
									if ((pb == null || itn == null) && (printFlag || debug)) {
