					+ " phase=postdevelop"
					+ " plantId=" + dupApex.plantNumber
					+ " fieldInstanceId=" + dupApex.fieldInstanceId
					+ " keepApexId=" + ((keepApex != null) ? keepApex.getId() : 0L)
					+ " removeApexId=" + dupApex.getId()
					+ " order=" + dupApex.order
					+ " rank=" + dupApex.rank
					+ " syllepticOrder=" + dupApex.syllepticOrder
					+ " shootType=" + dupApex.shootType
					+ " shouldProduceFlower=" + dupApex.shouldProduceFlower
					+ " cpn=" + dupApex.cpn
