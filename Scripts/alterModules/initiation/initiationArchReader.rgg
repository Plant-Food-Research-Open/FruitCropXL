/**
 * Handles the initiation of the architecture reader, including both shoots and roots.
 * Extends the base initiation service and incorporates specific methods for
 * managing the architecture and additional plant systems like light sensors and roots.
 */
public class InitiationArchReader extends InitiationService {
	private static final long serialVersionUID = 1L;
	/** Initialization handler for plant and root systems. */
	private InitArch initArch;
	
	/**
	 * Constructor initializing the architecture using InitArchReader.
	 * Responsible for creating a specific architecture initializer instance.
	 */
	public InitiationArchReader() {
		// Instantiate an InitArch instance specific to InitiationArchReader.
		initArch = new InitArchReader();
	}
	
    /**
     * Starts the initialization process for plant and root systems.
     * 
     * This method initializes key parameters such as water potential and focal plants,
     * and sets up the simulation environment, including plant rows, strips, soil, and roots.
     * It also enables light sensors if required.
     * 
     * Steps performed:
     * - Initializes environmental settings and plant variables.
     * - Loads architecture components like light, roots, and soil grids.
     * - Defines the simulation's spatial structure using plants and tiles.
     */
    public void initiate() {[
        {
            continueRunning = true;  // Keeps the initialization loop active
			focalPlants = 0;         // Reset plant count
			
			InitArchReader.init();  // Initialize the architecture system
        }
        
        // Setting up the global environment
        Axiom ==>
        // Position adjustment for the starting point of the trunk based on the input data
        Translate(tx, ty, 0)
	        if(isRayTracingLightMode() && useDirectRadiation) (
        // Initialize direct light settings 
           [dir:DirectLight]            
           { dir.update();}  
        )
	        if(isRayTracingLightMode() && useDiffuseRadiation) (
        // Initialize diffuse light settings 
           [dif:DiffuseLight]            
           { dif.update();}  
        )

        
       // Initialize plant row orientation
        RH(rowOrientation)
	        if(isRayTracingLightMode() && useShadingFactor == false && cloneX > 0) (
        	GridClonerNode(cloneX, (plantDistance+random(0,0.1)) * nrPlants, cloneY, (rowDistance+random(0,0.1)) * nrRows)
        )
        // Prepare the field base and calculate the tile width
        temp //temp is empty and just for refreshing scene 
        FieldBase
        {double tileWidth = plantDistance/nrTiles;}
        /** measure stick (to compare ..) *************************************/
            [
                //Translate(-(nrTiles+1)*tileWidth,-tileWidth,0) 
                //measureStick(10, 0.1) // (number of steps, step length (in m))
            ] 
         
        // Initialize and iterate through strips, rows, and plants    
        [
            {
                int i = 0; // Global plant counter
            }
            for (int strip=1; strip<=nrStrips; strip++) (
            
            //setup of a strip
            for (int row=1; row<=nrRows; row++) (
    
                //setup of a row
                [
                    {borderX = 0;}// Reset row boundary marker
                    for (int pos=1; pos<=nrPlants; pos++) (
                    	// Define plant-specific initiation processes
                        //if one wants to reduce the overlap between rows
                        //	if(pos == 1) (Translate(row%2 == 0 ? 0.5*plantDistance : 0,0,0))
                            
                    [
                            {i++;} // Increment plant counter
                            
                            /** adding the tiles on the ground */
                            if (associatePlantsToTiles == true) (
                            [
                                Translate(-0.5*(nrTiles-1)*tileWidth,0,0)
                                {int tn = 0;} // Tile number tracker
                                for (1:nrTiles) (
                                    [
                                        for (1:nrTiles) (
                                            t:Tile
                                            Translate(plantDistance/nrTiles,0,0)
                                            {
                                                tn++;
                                            	t.initiate(i, row, pos, strip, tn);
                                            }
                                        )
                                    ]
                                Translate(0,rowDistance/nrTiles,0)
                                )
                            ]   
                            )//end of associatePlantsToTiles
                            
                            /** If complex root system is disabled, initiate simple root system */
							if(useComplexRoot == false) (
								pi:PlantIdentifier pb:PlantBase [RU(180) rb:RootBase]
							{
								pi.initiate(i, row, pos, strip, species);  // Plant identifier setup
								pb.initiate(i, row, pos, strip, pi);  // Plant base initialization
								rb.initiate_pb(pb, numofSoilLayers);  // Root base initialization
								if (pb.border == false) {focalPlants++;}  // Count focal plants
								
								println("initiation pb id: " + pb.getId());
							}
							
								// Simple-root-only legacy topology; complex-root voxels use sibling SR/FR nodes.
								// Add the soil and root layers as branches.
							[
								RU(180) for (int r = 0; r < numofSoilLayers; r++) (
								sl:Soil {	
									sl.initiate(r, pb);
								}
								[ M(-sl.length) sr:StructuralRoot [fr:FineRoot]] 
									
									{
										fr.initiate_pb(r, pb);							
										
										sr.initiate_pb(r, pb);
										rb.addChildSoilRoot(r, sl, fr, sr);
									}
									
								)
							]
								
			
						) //close useCompleRoot == false
							
						/** Initialize complex root system if enabled */
						if(useComplexRoot == true) (
							pi:PlantIdentifier pb:PlantBase [RU(180) rb:RootBase] 					
							{
								pi.initiate(i, row, pos, strip, species);  // Plant initialization
								pb.initiate(i, row, pos, strip, pi);  // Plant base setup
								int gridNumber = InitArchReader.rootData.maxNodeID;
								println("total grid from the input " + gridNumber);  // Debug output
								rb.initiate_pb(pb, gridNumber);  // Root base setup
								if (pb.border == false) {focalPlants++;}  // Update plant count
							}
						) //end of complexRoot 
					
                        
					 /** Add light sensors if enabled */
					 if (useLightSensors == true && sensor_heights.length >= 1) (
					 [
					 	 // Sensor heights include one extra top layer used only as the sky reference.
					 	 for (int h :(0 : sensor_heights.length - 1)) (
					 	 	 {float height = (float) sensor_heights[h];}
							[
								Translate(-plantDistance/2 + plantDistance/10,0.3,height)
								for (1 :9) ( 
									ls:LightSensor Translate((plantDistance)/10, 0, 0) 
									{ls.initiate(height); }	
									)
							]
							)
						]
					) //close useLightSensors == ture 
    
					
		] //loop for plants
    	/* #############################################################*/					
                        if (pos != nrPlants && pos % 4 == 0) (
                                        Translate(plantDistance, 0, 0)
                                    )
                        else (Translate(plantDistance,0,0) )
                        
                        {if (pos != nrPlants) {borderX += plantDistance;}}
                        )
                ]
                if (row != nrRows) (
                    Translate(0,rowDistance,0)
                    {borderY += rowDistance;}
                )
            )
            // Adjust strip position if not the last strip
            Translate(0,stripDistance,0)
            {if (strip != nrStrips) {borderY += stripDistance;}}
        )	
        ] // end of strip settings	
        
        // Update area calculations
        {
            totalArea = rowDistance * plantDistance * totalPlants;
            focalArea = rowDistance * plantDistance * focalPlants;
            dens = 1 / (rowDistance * plantDistance);	
        }
        
    	; //end of Axiom
    ]
    } //end of the initiate method

    /**
     * Overrides the default architecture initialization process.
     * 
     * This method calls the initArchitecture method from the InitArch instance
     * to initialize plant structures such as shoots, roots, and soil grids.
     */
	public void initArchitecture() {
		initArch.initArchitecture();
	}
}







/**
 * Handles the initialization and configuration of the plant and root system architecture.
 * This class extends `InitArch` and supports loading architectural data for shoots, roots,
 * and associated components such as leaves, buds, and soil grids.
 * 
 * Responsibilities include:
 * - Initializing shoots and roots using external data sources.
 * - Managing architectural structures by processing plant models.
 * - Supporting dynamic architectural growth if enabled.
 */

class InitArchReader extends InitArch {
	/** Keep deserialization compatibility with previously saved graphs. */
	private static final long serialVersionUID = -5014632200300883167L;

/** Data reader for loading shoot architecture information. */
    public static XEGDataReader treeData;

    /** Data reader for loading root architecture information. */
    public static XEGDataReader rootData;
    
    /**
     * Initializes the architecture reader by setting default states and loading data.
     * 
     * This method performs the following:
     * - Resets the bunch count for tracking plant clusters.
     * - Initializes the shoot data reader and loads shoot data from files.
     * - If the complex root system is enabled, initializes and loads root data.
     */
	public static void init() {
		InitArchReader.bunchCount = 0;
		InitArchReader.initShoot();
		InitArchReader.readShootData();

		if(useComplexRoot == true) {
			InitArchReader.initRoot();
			InitArchReader.readRootData();
		}
	}
	
    /**
     * Manages the architecture initialization process.
     * 
     * This method:
     * - Loads architectural data, including shoots, roots, and environmental components.
     * - Adds leaves and buds if these features are enabled.
     * - Finalizes the initialization by invoking the derive() method.
     * 
     * This ensures that the architecture setup is consistent and ready for simulation.
     */
    @Override 
	public void initArchitecture() {	
		if (shootsInitiated == false)
		{
            
			loadArchitectureData(); 
			if(addLeaves == true) addLeaves();
			if(addBuds == true) addBuds();
			derive();  // Finalizes architectural initialization		
		} 	
	}

	
	/**
	 * Initializes shoot-related architectural data.
	 * Sets the `shootsInitiated` flag to `false`, ensuring that shoots
	 * are not considered initialized until properly processed.
	 */
	static void initShoot() {
		shootsInitiated = false;
	}
	/**
	 * Initializes root-related architectural data.
	 * Sets the `rootsInitialised` flag to `false`, preparing for root data initialization.
	 */
	static void initRoot() {
		rootsInitialised = false;
	}
	
	/**
	 * Loads architectural data by processing both shoots and roots.
	 * 
	 * This method performs the following:
	 * - Loads shoot data if the initialization step is the first.
	 * - If the complex root system is enabled, loads root data and associated soil grids.
	 * - Adjusts the trunk position after initializing the soil and roots.
	 */	
	static void loadArchitectureData() { 
		if(step <= 1)
		{
			loadShoots();
			 if(useComplexRoot == true) {
				if (rootDataHasNonGridRootNodes()) {
					loadRoots();
					debugRootMeristemSummary();
				} else {
					rootsInitialised = true;
					if (printFlag) { println("root is here"); }
				}
				addRootSoilGridFromRootData();
				debugRootBaseAndSoilActualLocations();
			 	//handle the misteriour change of the 
			 	//trunk after initializing the soil and root
			 	[t:Trunk ==> RV(10) t;]
			 }	
		} 	 
	}
	/**
	 * Loads shoots from external data sources and initializes them.
