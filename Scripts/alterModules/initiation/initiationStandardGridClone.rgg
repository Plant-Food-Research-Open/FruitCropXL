            {WOOD_LENGTH = 0.95;}
            
            {if (strip != nrStrips) {borderY += stripDistance;}}
        )	
        ]	

        {
            totalArea = rowDistance * plantDistance * totalPlants;
            focalArea = rowDistance * plantDistance * focalPlants;
            dens = 1 / (rowDistance * plantDistance);
            initializeReportableFieldMetadata();
        }
        
    ; //end of Axiom

