								[ M(-0.5*sl.length) [sr:StructuralRoot] [fr:FineRoot]] 
								 
									{
										fr.initiate_pb(r, pb);							
										fr.addSoilArray(sl);
										sr.initiate_pb(r, pb);
										rb.addChildSoilRoot(r, sl, fr, sr);
