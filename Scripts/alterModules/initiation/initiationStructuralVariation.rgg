public class InitiationStructuralVariation extends InitiationService {

	/**
	 * Flag variable to control bd.initiate on cordon when no annual shoots are
	 * added
	 */
	static boolean shouldInitiateBd = ENDING_PHYTOMER_NUM == 0 ? true : false;

	public void initiate() {[
		{
			day = 0;
			tt = 0;
			step = 0;
			continueRunning = true;
			initiateStructuralVariationParameters();
			shouldInitiateBd =ENDING_PHYTOMER_NUM == 0 ? true : false;
		}
		
		Axiom ==>
		//GridClonerNode(3,plantDistance * nrPlants, 3, nrRows*rowDistance)
		temp
			if(isRayTracingLightMode() && useDirectRadiation) (
        // Initialize direct light settings 
           [dir:DirectLight]            
           { dir.update();}  
        )
	        if(isRayTracingLightMode() && useDiffuseRadiation) (
        // Initialize diffuse light settings 
           [dif:DiffuseLight]            
           { dif.update();
           	 leafAngleOptimization.initRadiationLocations();
           }  
        )
           RH(rowOrientation)
        //for this particular situation, where we stack rows above each other
	        if(isRayTracingLightMode() && useShadingFactor == false && cloneX >0) (
        	if(nrStrips == 1) (GridClonerNode(cloneX, plantDistance * nrPlants, cloneY, rowDistance * nrRows))
        )
		FieldBase
		{double tileWidth = plantDistance/nrTiles;}
		/** measure stick (to compare ..) *************************************/
			[
