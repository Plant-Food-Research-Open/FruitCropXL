											lf.initiate_pb(pb,j, k, l);
											lf.fid = m;
											lf.area = leafShape.calcLeafPolygonArea(lf.length, lf.width, lf.fid);
											jm.initiate(lf);
										}
									)
									]
									)
								if(j > ENDING_LEAF_NUMBER && j <= ENDING_PHYTOMER_NUM ) (
									//RV(-0.05) RL(random(-10,10)) itn:Internode [if(fruitPosition == j) (b:fruitTemplate {b.initiate_pb(pb,j, k, l);})]
									RV(-0.05) itn:Internode  [bd:bud]
									{itn.initiate_pb(pb, j, k, l); bd.initiate(itn,2); itn.length = sb.getInternodeLength(j);}
									)
								)
								if(ENDING_PHYTOMER_NUM > 0) (
									//create a localized budCreator to avoid circle pointing
									{
										BudService bud = new BudCreator(species).createBud();
										ApexService apex = bud.createApex();
									}
									ap:apex {ap.initiate_pb(pb,ENDING_PHYTOMER_NUM, 0, 0);}
									)
								
							] 
							)
							])  //this bracket for the number of cordons
							) //bracket for the cane pruning system
	
		/* #############################Lyre PRUNING SYSTEM ################################*/
							if(trainingSystem == 4) (   
							//add the soil and root and pb
							pi:PlantIdentifier pb:PlantBase [RU(180) rb:RootBase]
							{
								
									pi.initiate(i, row, pos, strip, species);
									pb.initiate(i, row, pos, strip, pi);
									rb.initiate_pb(pb,numofSoilLayers);
									
									pb.addRootBase(rb);
									if (pb.border == false) {focalPlants++;}
															
							}
							
									//add the soil and root layers as branches
							[
								RU(180) for (int r = 0; r < numofSoilLayers; r++) (
								sl:Soil {sl.initiate(r, pb);}
								[ M(-sl.length) [sr:StructuralRoot] [fr:FineRoot]] 
								 
									{
										fr.initiate_pb(r, pb);							
										fr.addSoilArray(sl);
										sr.initiate_pb(r, pb);
										rb.addChildSoilRoot(r, sl, fr, sr);
									}
								)
							]
								w:Trunk {w.initiate_pb(pb);} 
								//for (int l:(1 : CORDEN_NUM)) ([ RU( Math.pow(-1,l) * random(85,92))   //l L was used for the identification of cordon number, sorry for the sequence of i, j, k,
																							//because they were added in different time 
							//suppress random process for optimization procedure
							for(int horizontalCordon : (1 : 2)) ([
									RU(Math.pow(-1, horizontalCordon) * 90) Cylinder(0.2, 0.02)	
						for (int l:(1 : 2)) ( [RL( Math.pow(-1,l) * 90)
							// add the cordon of the plant
							for(int k:(1:SHOOT_NUM)) (//RU( Math.pow(-1, k) * random(-10,10)) 
								cor : Cordon 
															
								{
									BudService bud1 = new BudCreator(species).createBud();
								}
							[RU(Math.pow(-1,horizontalCordon) * -85) RL(Math.pow(-1,l) * -20 * random(0.9,1.1)) b:bud1] 
								{cor.initiate_pb(pb,k, l);  b.initiate(cor,1);
								
								int fruitPosition = random_int(1, 6); }							
							// add the one-year shoots of the plant
							[
							sb:ShootBase
							{sb.initiate(i, l, k);}
							RG() RU(180)
							RH(Math.pow(-1,l) * 90 + Math.pow(-1, horizontalCordon) * 90 + 180)
							RH(-sb.azimuthAngle)
							RU(90 - sb.basalElevation)
							for(int j:(1:ENDING_PHYTOMER_NUM)) (
								//create a localized budCreator to avoid circle pointing
								{
									BudService bud = new BudCreator(species).createBud();
									FruitService fruitTemplate = main.FRUIT_CREATOR.createFruit();
								}
								if(j < STARTING_LEAF_NUMBER) (
								itn:Internode  [if(fruitPosition == j) (be:fruitTemplate  { be.initiate_pb(pb, j, k, l); })]
								{itn.initiate_pb(pb, j, k, l);  itn.length = sb.getInternodeLength(j);}
								RU(sb.getInternodeAngle(j))
									)
								if(j >= STARTING_LEAF_NUMBER && j <= ENDING_LEAF_NUMBER ) ( 
								
									itn:Internode  [if(fruitPosition == j) (be:fruitTemplate  { be.initiate_pb(pb, j, k, l); })]
									[bd:bud {bd.initiate(itn, 2);itn.initiate_pb(pb, j,k,l);  itn.length = sb.getInternodeLength(j);}]
									RU(sb.getInternodeAngle(j))
									[RG() RU(180) // Make z axis vertical
									RH(sb.getPetioleRotation(j))
									RU(sb.getPetioleDeclination(j)) 
									pt:Petiole 
									{pt.initiate_pb(pb, j, k, l); } 
									RH(90)
									jm:JMidrib(sb.getLeafDeclination(j))
									for (int m = 0; m < leafShape.polyleaf[0].length; m++) (
										[lf:Leaf]
										{
											lf.initiate_pb(pb,j, k, l);
											lf.fid = m;
											lf.area = leafShape.calcLeafPolygonArea(lf.length, lf.width, lf.fid);
											jm.initiate(lf);
										}
									)
									]
									)
								if(j > ENDING_LEAF_NUMBER && j <= ENDING_PHYTOMER_NUM ) (
									itn:Internode  [bd:bud]
									{itn.initiate_pb(pb, j, k, l); bd.initiate(itn, 2); itn.length = sb.getInternodeLength(j);}
									RU(sb.getInternodeAngle(j))
									)
									
								)
								if(ENDING_PHYTOMER_NUM > 0) (
									{
										BudService bud = new BudCreator(species).createBud();
										ApexService apex = bud.createApex();
									}
									ap:apex {ap.initiate_pb(pb,ENDING_PHYTOMER_NUM, 0, 0);})
								
							] 
							)
							])  //this bracket for the number of cordons
							])//horizontal cordon
							) //bracket for the cane pruning system
	
		/* #############################GENEVA DOUBLE CURTAIN PRUNING SYSTEM ################################*/
							if(trainingSystem == 5) (   //cane prunning
							//add the soil and root and pb
							pi:PlantIdentifier pb:PlantBase [RU(180) rb:RootBase]
							{
								
									pi.initiate(i, row, pos, strip, species);
									pb.initiate(i, row, pos, strip, pi);
									rb.initiate_pb(pb,numofSoilLayers);
									
									pb.addRootBase(rb);
									if (pb.border == false) {focalPlants++;}
							}
							
									//add the soil and root layers as branches
							[
								RU(180) for (int r = 0; r < numofSoilLayers; r++) (
								sl:Soil {sl.initiate(r, pb);}
								[ M(-sl.length) [sr:StructuralRoot] [fr:FineRoot]] 
								 
									{
										fr.initiate_pb(r, pb);							
										fr.addSoilArray(sl);
										sr.initiate_pb(r, pb);
										rb.addChildSoilRoot(r, sl, fr, sr);
									}
								)
							]
							w:Trunk {w.initiate_pb(pb);} 	
								//for (int l:(1 : CORDEN_NUM)) ([ RU( Math.pow(-1,l) * random(85,92))   //l L was used for the identification of cordon number, sorry for the sequence of i, j, k,
																							//because they were added in different time 
							//suppress random process for optimization procedure
							for(int horizontalCordon : (1 : 2)) ([
									RU(Math.pow(-1, horizontalCordon) * 70) Cylinder(0.3, 0.02)	//note cylinder was not considered in the carbon calculation
						for (int l:(1 : 2)) ( [RL( Math.pow(-1,l) * 90)
							// add the cordon of the plant
							for(int k:(1:SHOOT_NUM)) (//RU( Math.pow(-1, k) * random(-10,10))
								{
									BudService bud1 = new BudCreator(species).createBud();
								}
								cor : Cordon  [RU(Math.pow(-1,horizontalCordon) * 85 * random(0.9, 1.1)) b:bud1] 
								{cor.initiate_pb(pb,k, l); b.initiate(cor,0); 
								 int fruitPosition = random_int(1, 6); }
								
							// add the one-year shoots of the plant
							[sb:ShootBase
							{sb.initiate(i, k, l);}
							RU(Math.pow(-1,horizontalCordon) * 85)  //RL increase the canopy width, reduce the overlap between shoots, but may not obsolutely correct
							// RL(random(-15, 15)) RV(-0.1) i0:Internode  {i0.initiate_pb(pb,0,k,l); }
							for(int j:(1:ENDING_PHYTOMER_NUM)) (
								//create a localized budCreator to avoid circle pointing
								{
									BudService bud = new BudCreator(species).createBud();
									FruitService fruitTemplate = main.FRUIT_CREATOR.createFruit();
								}
								//RH(random(-10,10)) itn:Internode 
								if(j < STARTING_LEAF_NUMBER) (
								 RL(Math.pow(-1,k) * 1) itn:Internode  [if(fruitPosition == j) (be:fruitTemplate  { be.initiate_pb(pb, j, k, l); })]
								//RV(-0.05) itn:Internode [if(fruitPosition == j) (b:fruitTemplate {b.initiate_pb(pb,j, k, l);})]
								{itn.initiate_pb(pb, j, k, l);  itn.length = sb.getInternodeLength(j);}
									)
								if(j >= STARTING_LEAF_NUMBER && j <= ENDING_LEAF_NUMBER ) (
									//with some random angle between internodes
									RL(random(-5,5)) RH(phyllotaxis) itn:Internode  [if(fruitPosition == j) (be:fruitTemplate  { be.initiate_pb(pb, j, k, l); })]
									[bd:bud {bd.initiate(itn, 2);itn.initiate_pb(pb, j,k,l);  itn.length = sb.getInternodeLength(j);}]
									[RG() RU(180) // Make z axis vertical
									RH(random(1, 360))
									RU(sb.getPetioleDeclination(j)) 
									pt:Petiole 
									{pt.initiate_pb(pb, j, k, l); } 
									RH(90)
									jm:JMidrib(sb.getLeafDeclination(j))
									for (int m = 0; m < leafShape.polyleaf[0].length; m++) (
										[lf:Leaf]
										{
											lf.initiate_pb(pb,j, k, l);
											lf.fid = m;
											lf.area = leafShape.calcLeafPolygonArea(lf.length, lf.width, lf.fid);
											jm.initiate(lf);
										}
									)
									]
									)
								if(j > ENDING_LEAF_NUMBER && j <= ENDING_PHYTOMER_NUM ) (
									//RV(-0.05) RL(random(-10,10)) itn:Internode [if(fruitPosition == j) (b:fruitTemplate {b.initiate_pb(pb,j, k, l);})]
									itn:Internode  [bd:bud]
									{itn.initiate_pb(pb, j, k, l); bd.initiate(itn, 2); itn.length = sb.getInternodeLength(j);}
									)
									
								)
								if(ENDING_PHYTOMER_NUM > 0) (
									{
										BudService bud = new BudCreator(species).createBud();
										ApexService apex = bud.createApex();
									}
									ap:apex {ap.initiate_pb(pb,ENDING_PHYTOMER_NUM, 0, 0);})
								
							] 
							)
							])  //this bracket for the number of cordons
							])//horizontal cordon
							) //bracket for the cane pruning system
		/* #############################Bush potted vines ############################*/
							if(trainingSystem == 6) (   //cane prunning
						//add the soil and root and pb
							pi:PlantIdentifier pb:PlantBase [RU(180) rb:RootBase]
							{
								
									pi.initiate(i, row, pos, strip, species);
									pb.initiate(i, row, pos, strip, pi);
									rb.initiate_pb(pb,numofSoilLayers);
									
									pb.addRootBase(rb);
									if (pb.border == false) {focalPlants++;}

							}
							
									//add the soil and root layers as branches
							[
								RU(180) for (int r = 0; r < numofSoilLayers; r++) (
								sl:Soil {sl.initiate(r, pb);}
								[ M(-sl.length) [sr:StructuralRoot] [fr:FineRoot]] 
								 
									{
										fr.initiate_pb(r, pb);							
										fr.addSoilArray(sl);
										sr.initiate_pb(r, pb);
										rb.addChildSoilRoot(r, sl, fr, sr);
									}
								)
							]
						w:Trunk {w.initiate_pb(pb);} 	
						//add the primary spur or cordon of the plant 
						//CORDEN_NUM = 1;
						for (int l:(1 : CORDEN_NUM)) ( [
								RH(l * 70) RU(Math.pow(-1, l) * 80)
							// add the cordon of the plant
							//SHOOT_NUM = 0
							for(int k:(1:SHOOT_NUM)) (//RU( Math.pow(-1, k) * random(-10,10)) 
								{
									BudService bud1 = new BudCreator(species).createBud();
								}
								cor : Cordon  [RH(Math.pow(-1, SHOOT_NUM) * 70) b:bud1] 
								{cor.initiate_pb(pb,k, l); b.initiate(cor,1); 
								 //int fruitPosition = random_int(1, 6);
								 int fruitPosition = 3;
								}
								
							// add the one-year shoots of the plant
							[
							sb:ShootBase
							{sb.initiate(i, l, k);}
							RG() RU(180)
							RH(-sb.azimuthAngle)
							RU(90 - sb.basalElevation)
							for(int j:(1:ENDING_PHYTOMER_NUM)) (
								//RH(random(-10,10)) itn:Internode
								//create a localized budCreator to avoid circle pointing
								{
									BudService bud = new BudCreator(species).createBud();
									FruitService fruitTemplate = main.FRUIT_CREATOR.createFruit();
								}
								if(j < STARTING_LEAF_NUMBER) (
								 RL(Math.pow(-1,k) * 1) itn:Internode  [if(fruitPosition == j) (be:fruitTemplate  { be.initiate_pb(pb, j, k, l); })]
								{itn.initiate_pb(pb, j, k, l);  itn.length = sb.getInternodeLength(j);}
								RU(sb.getInternodeAngle(j))
									)
								if(j >= STARTING_LEAF_NUMBER && j <= ENDING_LEAF_NUMBER ) (
									RV(-0.03)
									RL(random(-5,5)) RH(phyllotaxis) itn:Internode  [if(fruitPosition == j) (be:fruitTemplate  { be.initiate_pb(pb, j, k, l); })]
									[bd:bud {bd.initiate(itn, 2);itn.initiate_pb(pb, j,k,l);  itn.length = sb.getInternodeLength(j);}]
									RU(sb.getInternodeAngle(j))
									[RG() RU(180) // Make z axis vertical
									RH(sb.getPetioleRotation(j))
									RU(sb.getPetioleDeclination(j)) 
									pt:Petiole 
									{pt.initiate_pb(pb, j, k, l); } 
									RH(90)
									jm:JMidrib(sb.getLeafDeclination(j))
									for (int m = 0; m < leafShape.polyleaf[0].length; m++) (
										[lf:Leaf]
										{
											lf.initiate_pb(pb,j, k, l);
											lf.fid = m;
											lf.area = leafShape.calcLeafPolygonArea(lf.length, lf.width, lf.fid);
											jm.initiate(lf);
										}
									)
									]
									)
								if(j > ENDING_LEAF_NUMBER && j <= ENDING_PHYTOMER_NUM ) (
									itn:Internode  [bd:bud] 
									[if(fruitPosition == j) 
									(be:fruitTemplate  { be.initiate_pb(pb, j, k, l); })]							
									{itn.initiate_pb(pb, j, k, l); bd.initiate(itn, 2); itn.length = sb.getInternodeLength(j);}
									RU(sb.getInternodeAngle(j))
									)
								)
								if(ENDING_PHYTOMER_NUM > 0) (
									{
										BudService bud = new BudCreator(species).createBud();
										ApexService apex = bud.createApex();
									}
									
									ap:apex {ap.initiate_pb(pb,ENDING_PHYTOMER_NUM, 0, 0);}
									)
								
							] 
							)
							])  //this bracket for the number of cordons
							) //bracket for the cane pruning system
							
		/* ###############################*/			
		/* #############################carbon transport single vines ############################*/
	
							if(trainingSystem == 7) 
								(   //scenario simulation with one shoot and bunches in different positions along the cordon
								//add the soil and root and pb
							pi:PlantIdentifier pb:PlantBase [RU(180) rb:RootBase]
							{
								
									pi.initiate(i, row, pos, strip, species);
									pb.initiate(i, row, pos, strip, pi);
									rb.initiate_pb(pb,numofSoilLayers);
									
									pb.addRootBase(rb);
									if (pb.border == false) {focalPlants++;}
							}
							
									//add the soil and root layers as branches
							[
								RU(180) for (int r = 0; r < numofSoilLayers; r++) (
								sl:Soil {sl.initiate(r, pb);}
								[ M(-sl.length) [sr:StructuralRoot] [fr:FineRoot]] 
								 
									{
										fr.initiate_pb(r, pb);							
										fr.addSoilArray(sl);
										sr.initiate_pb(r, pb);
										rb.addChildSoilRoot(r, sl, fr, sr);
									}
								)
							]
						[ber:main.FRUIT_CREATOR.createFruit()]	{ber.initiate_pb(pb, 1, 0, 0);}
						//add the primary spur or cordon of the plant 
						{CORDEN_NUM = 1; SHOOT_NUM = 1; int fruitPosition = 0; int k = 4;}
						
						for (int l:(1 : CORDEN_NUM)) ( 
						//create a localized budCreator to avoid circle pointing
						{
							BudService bud = new BudCreator(species).createBud();
							FruitService fruitTemplate = main.FRUIT_CREATOR.createFruit();
						}
						[
							RU(Math.pow(-1, l) * 90)
							// add the cordon of the plant			 
							cor : Cordon  [RH(Math.pow(-1, 1) * 70) b:bud][cb:fruitTemplate ] 
							{
								cor.initiate_pb(pb,1, 1); 
								cor.length= 0.3;	
								b.initiate(cor,1); 
									
								cb.initiate_pb(pb, 0, 1, 1); 
								
							}
							cor1 : Cordon  [RH(Math.pow(-1, 1) * 70) bb:bud][cb1:fruitTemplate]  
							{
								cor1.initiate_pb(pb, 2, 1); //initiate_pb(PlantBase pb, int nodeNumber, int cordonNumber)
								cor1.length= 0.3;	
								bb.initiate(cor,1);; //initiate_pb(PlantBase pb, int rank, int nodeNumber, int cordonNumber)
									
								cb1.initiate_pb(pb, 0, 2, 1); 
								
							}	
							
							cor2 : Cordon [RH(Math.pow(-1, 1) * 70) bb2:bud][cb2:fruitTemplate]  
							{
								cor2.initiate_pb(pb, 3, 1); //initiate_pb(PlantBase pb, int nodeNumber, int cordonNumber)
								cor2.length= 0.3;	
								bb2.initiate(cor,1);
									
								cb2.initiate_pb(pb, 0, 3, 1); 
								
							}	
							
							cor3 : Cordon  [RH(Math.pow(-1, 1) * 70) bb3:bud][cb3:fruitTemplate ]  
							{
								cor3.initiate_pb(pb, 4, 1); //initiate_pb(PlantBase pb, int nodeNumber, int cordonNumber)
								cor3.length= 0.3;	
								bb2.initiate(cor,1);
									
								cb3.initiate_pb(pb, 0, 4, 1); 
								
							}	
							
							// add the one-year shoots of the plant
							[
							sb:ShootBase
							{sb.initiate(i, l, k);}
							RG() RU(180)  // Make z axis vertical
							RH(-90) //different for each scenario based on local conditions
							RH(-sb.azimuthAngle)
							RU(90 - sb.basalElevation)
							for(int j:(1:ENDING_PHYTOMER_NUM)) (
								//create a localized budCreator to avoid circle pointing
								{
									BudService bud1 = new BudCreator(species).createBud();
									FruitService berryTemplate1 = main.FRUIT_CREATOR.createFruit();
								}
								//RH(random(-10,10)) itn:Internode 
								if(j < STARTING_LEAF_NUMBER) (
									itn:Internode  [if(fruitPosition == j) (be:berryTemplate1  { be.initiate_pb(pb, j, k, l); })]
									{itn.initiate_pb(pb, j, k, l);  itn.length = sb.getInternodeLength(j);}
									RU(sb.getInternodeAngle(j))
									)
								if(j >= STARTING_LEAF_NUMBER && j <= ENDING_LEAF_NUMBER ) (
								
									//with some random angle between internodes
									itn:Internode  [if(fruitPosition == j) (be:berryTemplate1  { be.initiate_pb(pb, j, k, l); })]
									[bd:bud1 {bd.initiate(itn, 2);itn.initiate_pb(pb, j,k,l);  itn.length = sb.getInternodeLength(j);}]
									
									RU(sb.getInternodeAngle(j))
									[RG() RU(180) // Make z axis vertical
									
									RH(sb.getPetioleRotation(j))  //this considered the shoot azimuth
									RU(sb.getPetioleDeclination(j)) 
									pt:Petiole 
									{pt.initiate_pb(pb, j, k, l); }
									RH(90) //this relates to the ploygonmesh; to make the polygon point to downwards insteads of sidewards
									jm:JMidrib(sb.getLeafDeclination(j))
									for (int m = 0; m < leafShape.polyleaf[0].length; m++) (
										[lf:Leaf]
										{
											lf.initiate_pb(pb,j, k, l);
											lf.fid = m;
											lf.area = leafShape.calcLeafPolygonArea(lf.length, lf.width, lf.fid);
											jm.initiate(lf);
										}
									)
									]
									
								)	
								if(j > ENDING_LEAF_NUMBER && j <= ENDING_PHYTOMER_NUM ) (
									itn:Internode  [bd:bud] 
									[if(fruitPosition == j) 
									(be:berryTemplate1  { be.initiate_pb(pb, j, k, l); })]							
									{itn.initiate_pb(pb, j, k, l); bd.initiate(itn, 2); itn.length = sb.getInternodeLength(j);}
									RU(sb.getInternodeAngle(j))
									)
								)
								if(ENDING_PHYTOMER_NUM > 0) (
									{
										BudService bud3 = new BudCreator(species).createBud();
										ApexService apex = bud.createApex();
									}
									
									ap:apex {ap.initiate_pb(pb,ENDING_PHYTOMER_NUM, 0, 0);})
								
							] //one year shoot
							
							])  //this bracket for the number of cordons
							) //bracket for the cane pruning system
	
	
	
							
	
		]
		/* #############################################################*/					
						if (pos != nrPlants && pos % 4 == 0) (
										Translate(plantDistance+0.2, 0, 0)
									)
						else (Translate(plantDistance,0,0) )
						
						{if (pos != nrPlants) {borderX += plantDistance;}}
						)
				]
				if (row != nrRows) (
					Translate(0,rowDistance,0)
					{borderY += rowDistance;}
				)
			)
			Translate(0,stripDistance,0)
			{if (strip != nrStrips) {borderY += stripDistance;}}
		)	
		]	
	
		{
			totalArea = rowDistance * plantDistance * totalPlants;
			focalArea = rowDistance * plantDistance * focalPlants;
			dens = 1 / (rowDistance * plantDistance);	
			
		}
		
		; //end of Axiom
	]}

}
