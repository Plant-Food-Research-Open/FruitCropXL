public class InitiationOptimalCanopyArchitecture extends InitiationService {
	//whether two canopy layer or one layer, 
	//if false, the second row will be added above the first row
	// FIXME: check if this needs to be public
	public static boolean dLayer = false;
	//special case for a fourth layer
	public static boolean quadLayer = false;
	static boolean shouldInitiateBd = ENDING_PHYTOMER_NUM == 0 ? true : false; // Flag variable to control bd.initiate on cordon when no annual shoots are added

	private static boolean useGridLayout() {
		return "layer_row_grid".equals(optimalCanopyLayoutMode);
	}

	private static int safeLayerCount() {
		return Math.max(1, optimalCanopyLayerCount);
	}

	private static int safeRowsPerLayer() {
		return Math.max(1, optimalCanopyRowsPerLayer);
	}

	private static int expectedTotalRows() {
		return safeLayerCount() * safeRowsPerLayer();
	}

	private static int layerIndexForRow(int row) {
		return (row - 1) / safeRowsPerLayer();
	}

	private static int rowWithinLayerForRow(int row) {
		return (row - 1) % safeRowsPerLayer();
	}

	private static double rowYOffsetForRow(int row) {
		return rowWithinLayerForRow(row) * rowDistance;
	}

	private static double yTranslateToNextRow(int row) {
		return rowYOffsetForRow(row + 1) - rowYOffsetForRow(row);
	}

	private static double woodLengthForLayer(int layerIndex) {
		if ("wood_length_explicit".equals(optimalCanopyLayerHeightMode) &&
				optimalCanopyWoodLengthValues != null &&
				optimalCanopyWoodLengthValues.length > 0) {
			int idx = Math.min(layerIndex, optimalCanopyWoodLengthValues.length - 1);
			return optimalCanopyWoodLengthValues[idx];
		}

		return optimalCanopyWoodLengthBase + optimalCanopyWoodLengthStep * layerIndex;
	}

	private static double woodLengthForRow(int row) {
		return woodLengthForLayer(layerIndexForRow(row));
	}

	private static double blockWidthY() {
		if ("use_stripDistance".equals(optimalCanopyStripSpacingMode)) {
			return stripDistance;
		}

		return Math.max(0, safeRowsPerLayer() - 1) * rowDistance + stripDistance;
	}

	private static double rowStartXOffset(int row) {
		if (!optimalCanopyStaggerAlternateRows) {
			return 0;
		}

		return row % 2 == 0
				? plantDistance * optimalCanopyAlternateRowXOffsetFraction
				: 0;
	}
	
