						{println("quadLayer " + quadLayer);}
						//if one wants to reduce the overlap between rows
						if(pos == 1) (Translate(rowStartXOffset(row),0,0))
	
					[
							{i++;}
						
						//the ground
	/* 					 if (associatePlantsToTiles == false) (
							[
								//M(-0.0011) Box(0.001,plantDistance * (nrPlants-2), rowDistance * (nrRows-2) + (nrStrips-1)*stripDistance).(setShader(BLACK))
								//t:TestTile {t.initiate();}
							] 
							)
							else (
							 [
								Translate(-0.5*(nrTiles-1)*tileWidth,0,0)
