					}
				}
			)	
			]	
		
			{
				if (useGridLayout() && "derived_block_width".equals(optimalCanopyDensityCalculationMode)) {
					double effectiveBlockWidth = blockWidthY();
					if (effectiveBlockWidth <= 0) {
						effectiveBlockWidth = rowDistance;
					}
					totalArea = plantDistance * nrPlants * effectiveBlockWidth * nrStrips;
					focalArea = plantDistance * focalPlants / Math.max(1, nrRows) * effectiveBlockWidth;
					if (focalArea <= 0 || Double.isNaN(focalArea) || Double.isInfinite(focalArea)) {
						focalArea = plantDistance * Math.max(1, focalPlants) * Math.max(1.0e-6, effectiveBlockWidth);
					}
					dens = focalPlants / focalArea;
					if (printFlag) {
						println("Optimal canopy density calculation:");
						println("  totalArea=" + totalArea);
						println("  focalArea=" + focalArea);
						println("  dens=" + dens);
					}
				} else {
					totalArea = rowDistance * plantDistance * totalPlants;
					focalArea = rowDistance * plantDistance * focalPlants;
					dens = 1 / (rowDistance * plantDistance);

					if("legacy_dlayer".equals(optimalCanopyLayoutMode))
					{
						int multiply= nrRows/2;
						focalArea = rowDistance * plantDistance * focalPlants/multiply +
									(stripDistance - rowDistance)*plantDistance*focalPlants/multiply/2;
						dens = 	focalPlants/focalArea;
						if (printFlag) { println("dens " + dens); }

					}
					if("legacy_single".equals(optimalCanopyLayoutMode))
					{
						focalArea =  stripDistance *plantDistance*focalPlants/nrRows;
						dens = 	focalPlants/focalArea;
						println("dens " + dens);
					}

					if("legacy_quad".equals(optimalCanopyLayoutMode))
					{
						focalArea = (plantDistance * focalPlants) * (rowDistance * 3 + stripDistance);
						dens = 	focalPlants/focalArea;
						if (printFlag) { println("dens " + dens); }
					}
				}
				
			}
			
