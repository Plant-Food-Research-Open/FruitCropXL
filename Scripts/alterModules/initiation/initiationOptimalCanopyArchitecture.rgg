					/********************************************************************/
						if("legacy_quad".equals(optimalCanopyLayoutMode)) (
								
						{double DEFAULT_WOOD_LENGTH = 0.38;}			
						if(row == 1 || row == 2 || row == 3) 
						( Translate(0,rowDistance,0)
							{ //this takes effect for next row
							WOOD_LENGTH = DEFAULT_WOOD_LENGTH;
						} 
						)
						
						if(row == 4 ) 
						( Translate(0, -3*rowDistance,0)
						{//prepare for row 5
