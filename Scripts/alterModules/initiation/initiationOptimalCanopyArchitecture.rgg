							] 
							) */ 
							// add the plants
				
			
	/* #############################canopy tier system ############################*/
		if(trainingSystem == 7) 
		   (   //scenario simulation with one shoot and bunches in different positions along the cordon
							{int berryID = 1; int SID = 1;}
							
							pi:PlantIdentifier pb:PlantBase [RU(180) rb:RootBase]
							{
								
									pi.initiate(i, row, pos, strip, species);
									pb.initiate(i, row, pos, strip, pi);
