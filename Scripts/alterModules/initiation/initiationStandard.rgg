/**
 * Standard coded initiation service for FruitCropXL.
 *
 * <p>This class builds a regular field/orchard/vineyard scene directly from the
 * current JSON-controlled runtime options. It creates the field scaffold, optional
 * tile grid, plant identifiers, plant bases, root/soil branches, and a
 * {@link StandardCanopyScaffold} marker for each plant. The actual above-ground
 * canopy architecture is then emitted in {@link #initArchitecture()} according to
 * {@code trainingSystem}.</p>
 *
 * <p>Important index convention used throughout the training-system blocks:</p>
 * <ul>
 *   <li>{@code i}: plant number within the generated field.</li>
 *   <li>{@code l}: cordon/layer/arm identifier, depending on the training system.</li>
 *   <li>{@code k}: shoot or cane position along the current cordon/layer.</li>
 *   <li>{@code j}: phytomer rank along the current annual shoot.</li>
 * </ul>
 *
 * <p>The code intentionally mixes Java-style blocks with XL/RGG production syntax.
 * Java blocks initialise services and assign object state, while turtle commands
 * such as {@code RH}, {@code RU}, {@code RL}, {@code RV}, {@code RG},
 * {@code Translate}, and {@code M} control local orientation and geometry.</p>
 */
public class InitiationStandard extends InitiationService {
    // Preserve the UID already stored in Scripts/graph.xml so GroIMP does not
    // reset the saved graph and drop project shader/object links after class edits.
    private static final long serialVersionUID = -6873756884043871125L;

    /**
     * Legacy flag for one-layer versus two-layer canopy logic.
     *
     * <p>The current standard-initiation code does not actively branch on this
     * field, but it is kept to avoid changing the serialized class layout and to
     * preserve compatibility with older graph/project files.</p>
     */
    private boolean dLayer;
    /**
     * Controls whether a dormant bud is attached directly to the cordon/trunk.
     *
     * <p>When {@code ENDING_PHYTOMER_NUM == 0}, the standard initiation creates
     * permanent structure only and places buds on cordons so that later dynamic
     * development can create annual shoots. When {@code ENDING_PHYTOMER_NUM > 0},
     * the annual shoot and phytomers are built immediately, so the direct cordon
     * bud is skipped.</p>
     */
    private boolean shouldInitiateBd = ENDING_PHYTOMER_NUM == 0 ? true : false;

    /**
     * Guard against repeated expansion of {@link StandardCanopyScaffold} markers.
     *
     * <p>Several runtime paths can call {@link #initArchitecture()}. This flag
     * prevents same-step re-entry from duplicating trunks, cordons, shoots,
     * leaves, fruit, and apices under the same {@code PlantBase}.</p>
     */
    private boolean canopyInitiated = false;

