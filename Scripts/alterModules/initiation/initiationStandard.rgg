/**
 * Clone proxy for copying the already-built reportable {@code FieldBase}.
 *
 * <p>The module instantiation rule resolves the original reportable field with
 * {@code fieldInstanceId == 0}. Final clone materialisation is handled by
 * {@code finalizeCloneFieldCopies(fieldIdCutoff)} in {@link #cloneFieldBase()}.</p>
 */
module CopyFieldBase==>{
    FieldBase fb = first((* i:FieldBase, (i.isReportable && i.fieldInstanceId == 0) *));
}fb;
