    /**
	 * Clone the already-built reportable {@code FieldBase} after Axiom creation.
	 *
	 * <p>The source field is first built once under the configured {@code rowOrientation}.
	 * This method then emits {@code CopyFieldBase} nodes around it for neighbour/edge
	 * radiation calculations. The clone loop is intentionally outside {@link #initiate()}
	 * so it does not recursively clone clone-fields.</p>
	 */
	private void cloneFieldBase() {[
		Axiom ==>
		{
			long fieldIdCutoff = getMaxFieldBaseId();
			int cloneLayersX = Math.max(0, cloneX);
			int cloneLayersY = Math.max(0, cloneY);
		}
		for (int y = -cloneLayersY; y <= cloneLayersY; y++) (
			for (int x = -cloneLayersX; x <= cloneLayersX; x++) (
				if (x != 0 || y != 0) (
					{
						float posY = y * rowDistance * nrRows;
						float posX = x * plantDistance * nrPlants;
					}
					// The source field is already built under RH(rowOrientation) in the Axiom.
					// Reapplying that rotation here rotates each copied field a second time.
					[Translate(posX, posY, 0) CopyFieldBase]
				)
			)
		)
		{
            if (shouldSkipCloneFinalizationForDebug()) {
                println("[cloneFieldBase] Skipping finalizeCloneFieldCopies for GPU grapevine diagnostic.");
            } else {
			    finalizeCloneFieldCopies(fieldIdCutoff);
            }
		}
		;
	]}

    /**
     * Temporary diagnostic guard for isolating GPU flux-light clone-field hangs.
     *
     * <p>Returning {@code true} skips final clone materialisation/finalisation while
     * preserving the rest of the initiation pathway. Keep this guard narrow so normal
     * scenarios still use complete clone-field metadata.</p>
     */
    private boolean shouldSkipCloneFinalizationForDebug() {
        // Diagnostic path for the full-clone GPU grapevine hang:
        // isolate clone-copy materialization from FieldBase finalization.
	        return isGpuLightMode()
            && useShadingFactor == false
            && "grapevine".equals(species);
    }

    /**
     * Replace each {@code StandardCanopyScaffold} with the selected canopy topology.
     *
     * <p>The training-system switch controls only the above-ground structure emitted
     * below each already-created {@code PlantBase}. Each block should initialise the
     * same biological identifiers ({@code plantNumber}, {@code rank},
     * {@code shootNumber}, {@code cordonNumber}) so downstream physiology, outputs,
     * and development services can treat the generated organs consistently.</p>
     *
     * <p>General construction pattern inside each training system:</p>
     * <ol>
     *   <li>Initialise trunk/permanent wood.</li>
     *   <li>Loop over cordons/layers ({@code l}) and shoot positions ({@code k}).</li>
     *   <li>Create cordons/canes and optional dormant buds if no annual shoot exists.</li>
     *   <li>If {@code ENDING_PHYTOMER_NUM > 0}, emit a {@code ShootBase}, internodes,
     *       buds, petioles, leaves, optional fruit, and the terminal apex.</li>
     * </ol>
     */
    public void initArchitecture() {
        if (canopyInitiated == true) {
            // Prevent repeated derive/init calls from expanding the same scaffold twice.
            return;
        }
        canopyInitiated = true;
        [
            sc:StandardCanopyScaffold ==>
            
            {
                // Find the PlantBase that owns this scaffold marker. The reverse-path
                // query walks from the scaffold back to the current plant anchor.
                PlantBase pb = first((* sc (<--)+ parentPlantQuery:PlantBase *));
                int i = pb.plantNumber;
            }
            /**
             * Training system 0: fruiting-cutting / single-shoot system.
             *
             * <p>Creates one trunk, one {@code ShootBase}, one short cordon-like basal
             * axis, and a single annual shoot. This is the simplest static topology and
             * is useful for calibration of leaf gas exchange, hydraulics, carbon status,
             * and berry/fruit modules without field-scale canopy complexity.</p>
             */
            /* ############################# FRUITING CUTTING SYSTEM ################################*/
            if(trainingSystem == 0) (
                // Permanent trunk anchor for the single-shoot plant.
                w:Trunk {w.initiate_pb(pb);}
                [
                    // ShootBase stores shoot-level metadata and helper functions used
                    // by organs emitted along this single annual axis.
                    sb:ShootBase
                    {sb.initiate(i, 0, 0);}
                    // Basal cordon-like element before the annual phytomer sequence.
                    RV(-2) i0:Cordon   {
                        i0.initiate_pb(pb,1, 1);
                    }
                    for(int j:(1:ENDING_PHYTOMER_NUM)) (
                        {
                            // Create a fresh bud and fruit template for this phytomer.
                            // Reusing the same service object across phytomers can cause
                            // aliasing/circular-reference problems in the generated graph.
                            BudService bud = new BudCreator(species).createBud();
                            FruitService fruitTemplate = main.FRUIT_CREATOR.createFruit();
                        }
                        // Pre-leaf ranks: emit internodes and optional early fruit only.
                        if(j < STARTING_LEAF_NUMBER) (
                            RV(-3) RH(phyllotaxis) itn:Internode
                            [if(j == 2) (RV(0.71) b2:fruitTemplate {b2.initiate_pb(pb, j,0,0); })]
                            {itn.initiate_pb(pb, j, 0, 0); }
                        )
                        // Leaf-bearing ranks: emit internode, lateral bud, petiole,
                        // midrib, and polygonal leaflets that make up the full leaf shape.
                        if(j >= STARTING_LEAF_NUMBER && j <= ENDING_LEAF_NUMBER ) (
                            RV(-2) RH(phyllotaxis) RL(random(0,5)) itn:Internode {itn.initiate_pb(pb, j,0,0);}
                            [
                                bd:bud
                                {
                                    bd.initiate(itn, 1);
                                }
                            ]
                            [
                                RU(-45) AdjustLU pt:Petiole {pt.initiate_pb(pb, j, 0, 0); }
                                RH(180)
                                jm:JMidrib(JMidrib.calcLeafDeclination(pt.rank, pt.order, 0.1))
                                for (int m = 0; m < leafShape.polyleaf[0].length; m++) (
                                    [lf:Leaf]
                                    {
                                        lf.initiate_pb(pb, pt.rank, pt.nodeNumber, pt.cordonNumber);
                                        lf.order = pt.order;
                                        lf.fid = m;
                                        lf.area = leafShape.calcLeafPolygonArea(lf.length, lf.width, lf.fid);
                                        jm.initiate(lf);
                                    }
                                )
                            ]
                            [if(j == 2) (RV(0.71) b2:fruitTemplate {b2.initiate_pb(pb, j,0,0); })]
                            [if(j == 4 && bunchNumPerShoot>1) (RV(0.71) b:fruitTemplate  {b.initiate_pb(pb, j,0,0); })]
                        )
                    )
                    {
                        BudService bud = new BudCreator(species).createBud();
                        ApexService apex = bud.createApex();
                    }
                    if(ENDING_PHYTOMER_NUM > 0) (
                        ap:apex {ap.initiate_pb(pb,ENDING_PHYTOMER_NUM, 0, 0);}
                    )
                    if(ENDING_PHYTOMER_NUM == 0) (bd:bud {bd.initiate(i0,2);})
                ]
            ) //bracket for the fruit cutting system
            
            /**
             * Training system 1: cane-pruning system.
             *
             * <p>Creates multiple cordons/canes controlled by {@code CORDEN_NUM} and
             * {@code SHOOT_NUM}. Special cases for {@code l == 3 || l == 4} adjust the
             * first and fifth shoots to mimic angled positions near the vine head. When
             * {@code ENDING_PHYTOMER_NUM == 0}, buds are attached to cordons for later
             * dynamic development; otherwise annual shoots are generated immediately.</p>
             */
            /* ############################# CANE PRUNNING SYSTEM ################################*/
            if(trainingSystem == 1) (
                w:Trunk {w.initiate_pb(pb);}
                // Loop over cordons/canes. The sign of Math.pow(-1,l) alternates
                // left/right orientation around the trunk.
                for (int l:(1 : CORDEN_NUM)) ([ RU( Math.pow(-1,l) * 90)
                    // Loop over shoot positions along the current cordon/cane.
                    for(int k:(1:SHOOT_NUM)) (
                        {
                            BudService bud = new BudCreator(species).createBud();
                        }
                        // Lower/inner cane start: angle the first shoot away from the head
                        // to avoid all shoots occupying the same initial turtle frame.
                        if((l == 3 | l == 4) & k == 1) (
                            RL(45) RU(-Math.pow(-1,l) * 30)
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2); println("new syllepticOrder" + b.syllepticOrder);})
                        )
                        if((l == 3 | l == 4) &(k == 2 | k == 3 | k == 4)) (
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2); println("new syllepticOrder" + b.syllepticOrder);})
                        )
                        // Lower/inner cane end: mirror the opening angle used for k == 1.
                        if((l == 3 | l == 4) & k == 5) (
                            RU(Math.pow(-1,l) * 30) RL(-45)
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2);println("new syllepticOrder" + b.syllepticOrder);})
                        )
                        if((l == 1 | l == 2) & k == 1) (
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2); println("new syllepticOrder" + b.syllepticOrder);})
                        )
                        else if(!((l == 3 | l == 4) & (k > 1 & k <= 5))) (
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2);})
                        )

                        {int fruitPosition = random_int(2, 6);}

                        if(ENDING_PHYTOMER_NUM > 0) (
                            [
                                sb:ShootBase
                                {sb.initiate(i, l, k);}
                                // Set annual-shoot insertion angle from the cane and add a
                                // small alternating roll so neighbouring shoots separate.
                                RU(Math.pow(-1,l) * -random(85,92)) RL(Math.pow(-1,k) *  random(1,30))
                                for(int j:(1:ENDING_PHYTOMER_NUM)) (
                                    {
                                        BudService bud1 = new BudCreator(species).createBud();
                                        FruitService fruitTemplate = main.FRUIT_CREATOR.createFruit();
                                    }

                                    if(j < STARTING_LEAF_NUMBER) (
                                        if((l == 3 | l == 4) & j <= 4) (RV(-1)) else (RV(-0.05))
                                        itn:Internode  jt:Joint [if(fruitPosition == j) (b:fruitTemplate  {b.initiate_pb(pb,j, k, l); })]
                                        {itn.initiate_pb(pb, j, k, l);  }
                                    )
                                    if(j >= STARTING_LEAF_NUMBER && j <= ENDING_LEAF_NUMBER ) (
                                        RV(-0.05) RL(random(-5,5)) RH(phyllotaxis)
                                        itn:Internode  jt:Joint [if(fruitPosition == j) (RH(phyllotaxis) be:fruitTemplate  { be.initiate_pb(pb, j, k, l); })]
                                        [bd:bud1 {bd.initiate(itn, 1); itn.initiate_pb(pb, j,k,l);  }]
                                        [RU(-45) AdjustLU
                                        pt:Petiole
                                        {pt.initiate_pb(pb, j, k, l); }
                                        RH(180)
                                        jm:JMidrib(JMidrib.calcLeafDeclination(pt.rank, pt.order, 0.1))
                                        for (int m = 0; m < leafShape.polyleaf[0].length; m++) (
                                            [lf:Leaf]
                                            {
                                                lf.initiate_pb(pb, j, k, l);
                                                lf.order = pt.order;
                                                lf.fid = m;
                                                lf.area = leafShape.calcLeafPolygonArea(lf.length, lf.width, lf.fid);
                                                jm.initiate(lf);
                                            }
                                        )]
                                    )
                                    if(j > ENDING_LEAF_NUMBER && j <= ENDING_PHYTOMER_NUM ) (
                                        RV(-0.05)
                                        itn:Internode  jt:Joint [b:bud]
                                        {itn.initiate_pb(pb, j, k, l); b.initiate(itn, 1);}
                                    )
                                )
                                if(ENDING_PHYTOMER_NUM > 0) (
                                    {
                                        // Terminal apex is created from the same bud service family
                                    // so species-specific apex implementation stays consistent.
                                    ApexService apex = bud.createApex();
                                    }
                                    ap:apex {ap.initiate_pb(pb,ENDING_PHYTOMER_NUM, k, l);}
                                )
                            ]
                        )
                    )
                ])
            )
            /**
             * Training system 2: Scott Henry split-canopy system.
             *
             * <p>Creates four canopy layers/cordon sets. The first two layers behave as
             * upper canes/cordons, while {@code l == 3 || l == 4} represent the lower
             * downward-oriented Scott Henry layer. The first three shoots on the lower
             * layers are angled explicitly to spread shoots around the lower fruiting
             * zone.</p>
             *
             * <p>For lower layers, {@code RG} is applied immediately after
             * {@code ShootBase} creation to orient the following annual shoot downward.
             * Be careful when adding {@code RU(180)} or negative {@code RV} values here:
             * those can flip or bend the local growth direction back upward.</p>
             */
            /* ############################# SCOTT HENRY SYSTEM ################################*/
            if(trainingSystem == 2) (
                w:Trunk {w.initiate_pb(pb);}
                // Scott Henry uses exactly four layers: two upper layers and two lower
                // downward-trained layers. The alternating RU sign separates sides.
                for (int l:(1 : 4)) ([ RU( Math.pow(-1,l) * 90)
                    for(int k:(1:SHOOT_NUM)) (
                        {
                            BudService bud = new BudCreator(species).createBud();
                        }
                        if((l == 3 | l == 4) & k == 1) (RU(-Math.pow(-1,l) * 25) RL(20)
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2);})
                        )
                        if((l == 3 | l == 4) & k == 2) (
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2);})
                        )
                        if((l == 3 | l == 4) & k == 3) ( RU(Math.pow(-1,l) * 25) RL(-20)
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2);})
                        )
                        else if(!((l == 3 | l == 4) & (k <= 3))) (
                            cor : Cordon {cor.initiate_pb(pb,k, l);}
                            if(ENDING_PHYTOMER_NUM == 0) ([b:bud] {b.initiate(cor,2);})
                        )

                        {int fruitPosition = random_int(1, 6);}

                        if(ENDING_PHYTOMER_NUM > 0) (
                            [sb:ShootBase
                            {sb.initiate(i, l, k);}
                           // Lower Scott Henry layers should initiate downward. RG sets the
