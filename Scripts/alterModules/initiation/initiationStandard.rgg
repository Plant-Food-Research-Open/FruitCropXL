        // All row, strip, plant, and canopy turtle operations below inherit this frame.
        RH(rowOrientation)
        //for this particular situation, where we stack rows above each other
        {println("useShadingFactor: " + useShadingFactor);}
        // FieldBase is the reportable orchard/vineyard anchor. PlantBase nodes are
        // emitted below it; cloneFieldBase() may later duplicate this reportable field
        // for edge-effect-free radiation calculations.
        FieldBase
        {double tileWidth = plantDistance/nrTiles;}
        /** measure stick (to compare ..) *************************************/
            [
                //Translate(-(nrTiles+1)*tileWidth,-tileWidth,0) 
                //measureStick(10, 0.1) // (number of steps, step length (in m))
