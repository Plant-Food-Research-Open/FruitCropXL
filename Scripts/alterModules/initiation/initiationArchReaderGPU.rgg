				int pos = 1;
			}

			
			// ============================================ one plant
			//setup of a row
			{borderX = 0;} // TODO: what is this used for?
					
			
			{i++;}
			
			/** adding the tiles on the ground */
			if (associatePlantsToTiles == true) ([
				Translate(-0.5*(nrTiles-1)*tileWidth,0,0)
				{int tn = 0;}
				for (1:nrTiles) (
					[
						for (1:nrTiles) (
							t:Tile
							Translate(plantDistance/nrTiles,0,0)
							{
								tn++;
								t.initiate(i, row, pos, strip, tn);
							}
						)
					]
					Translate(0,rowDistance/nrTiles,0)
				)
			])
				
	 /** If complex root system is disabled, initiate simple root system */
			if(useComplexRoot == false) (
				//rootbase needs to be in branch because xeg reader uses it 
				// to initiate all the shoot, and it would push the soil up 
				//if this is not in branch
				pi:PlantIdentifier pb:PlantBase [RU(180) rb:RootBase]
