	/**
	 * Need to specify a new function to modify Axiom, as inserting this double for loop in the initiate() Axiom
	 * will result in an infinite recursive loop.
	 */
			private void cloneFieldBase() {[
				Axiom ==>

				{
					long fieldIdCutoff = getMaxFieldBaseId();
					int cloneLayersX = Math.max(0, cloneX);
					int cloneLayersY = Math.max(0, cloneY);
				}

				for (int y = -cloneLayersY; y <= cloneLayersY; y++) (
					for (int x = -cloneLayersX; x <= cloneLayersX; x++) (
					if (x != 0 || y != 0) ( // Check so we do not clone at the original's position
						{ 
							// Account for original position (tx, ty)
							float posY = ty + y * rowDistance * nrRows; 
							float posX = tx + x * plantDistance * nrPlants;
						}
						
						// The arch-reader field already carries its row-orientation transform.
						// Apply translation only so copied fields keep the same orientation.
						[Translate(posX, posY, 0)  CopyFieldBase]
					)

					)
				)
			{
				finalizeCloneFieldCopies(fieldIdCutoff);
			}
			;
		]}

	/**
	 * Override default initArchitecture with ArchReader specific initiation.
