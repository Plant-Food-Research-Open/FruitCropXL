/**
 * Apple apex state used during dynamic growth.
 *
 * <p>This module is the runtime consumer of the bud-side plan. It receives a bud,
 * copies the bud identity and shoot plan into a growing apex, then exposes the
 * rank-based emission logic that {@code developApple.rgg} queries when it decides
 * whether to create a new internode, a lateral bud, a rosette leaf, a flower, or
 * a bourse-shoot child.</p>
 *
 * <p>In other words: {@code budApple.rgg} prepares plan state, this module keeps
 * the active growth cursor, and {@code developApple.rgg} performs the actual XL
 * topology rewrites.</p>
 */
module ApexApple extends ApexService
{
	/**
	 * Preserve the serial UID from the last stable saved graph so GroIMP can reopen
	 * existing projects without resetting shader/object links after mixed-bud planner changes.
	 */
	private static final long serialVersionUID = 3237166342247603854L;

	boolean isSpur;
	/** Planned rosette leaf count for a mixed floral bud (-). */
	public int floralRosetteLeafCount = 0;
	/** Planned number of bourse shoots to spawn from the mixed bud (-). */
	public int bourseShootCountTarget = 0;
	/** Number of bourse shoots already spawned from the mixed bud (-). */
	public int bourseShootCountSpawned = 0;
	/** Spur-level plan rows {rosetteAttachRank, childPlanIndex}. */
	public int[][] spurAttachPlan = new int[0][0];
	/** Full child shoot plans consumed by mixed-bud bourse spawning. */
	public AppleShootPlan[] bourseShootPlans = new AppleShootPlan[0];
	/** Cursor into {@code spurAttachPlan} during rosette development. */
	public int nextSpurAttachIdx = 0;
	/** True once the mixed-bud flower cluster becomes visible on the finished rosette. */
	public boolean mixedBudFlowerAppeared = false;
	/** Spur rank of the rosette event that created the visible flower cluster (-). */
	public int mixedBudFlowerAppearanceRank = 0;
	/** Apex thermal age at flower appearance (same unit as Apex.age). */
	public double mixedBudFlowerAppearanceAge = Double.NaN;
	/** Apex day age at flower appearance (d). */
	public double mixedBudFlowerAppearanceAgeD = Double.NaN;
	/** Apex GDD age at flower appearance (degree-days). */
	public double mixedBudFlowerAppearanceAgeGdd = Double.NaN;
	/** Legacy/debug bloom threshold after flower appearance; now stores the bud-burst threshold for mixed buds. */
	public double mixedBudBloomDelayAfterAppearance = Double.NaN;
	/** Apex age at birth; normally 0 for newly burst dynamic apices, but explicit for diagnostics. */
	public double birthAge = 0.0;
	/** Apex day age at birth, d. */
	public double birthAgeD = 0.0;
	/** Apex GDD age at birth, degree-days. */
	public double birthAgeGdd = 0.0;
	/** Absolute model thermal-time marker at apex birth if available; fallback is birthAge. */
	public double budBurstThermalTime = 0.0;
	/** Absolute model day marker at apex birth if available; fallback is birthAgeD. */
	public double budBurstDay = 0.0;
	/** Absolute model GDD marker at apex birth if available; fallback is birthAgeGdd. */
	public double budBurstGdd = 0.0;
	/** Parent-axis apex ID for axis-aware debug on lateral and bourse child axes. */
	public long parentAxisApexID = 0L;
	/** Last external simulation step that emitted a phytomer from this apex (-). */
	public int lastPhytomerEmissionStep = -1;
	/** External simulation step when this apex instance was created from a bud or parent apex. */
	public int birthStep = -1;
	
	

	float deltaHeight; //the height difference with the tip of the upright

	
		/**
		 * Load apple-apex parameters from the configured category context.
		 *
		 * <p>The apex currently only resolves the shared bud-general context, but the
		 * helper is kept separate so this module mirrors the legacy GroIMP loading
		 * pattern used by related organ classes.</p>
		 */
		public void loadParameters() {
			
		/** Set the context for file name parameters*/
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();
		
		/** Configuration context for carbon-related parameters */
		config.setCategoryContext("bud-general");
		

	}

	/** Record this apex birth / bud-burst timing using the current apex clocks. */
	private void markApexBirth() {
		this.birthStep = step;
		this.birthAge = this.age;
		this.birthAgeD = this.ageD;
		this.birthAgeGdd = this.ageGdd;
		/*
		 * If a reliable absolute model thermal-time clock becomes available, store it here.
		 * For dynamic mixed-bud control, the apex-local age marker is sufficient and unit-explicit.
		 */
		this.budBurstThermalTime = this.age;
		this.budBurstDay = this.ageD;
		this.budBurstGdd = this.ageGdd;
	}

	/** Thermal time elapsed since bud burst / apex creation, in the same unit as Apex.age. */
	public double thermalTimeSinceBudBurst() {
		double dt = this.age - this.birthAge;
		if (Double.isNaN(dt) || Double.isInfinite(dt)) return 0.0;
		return Math.max(0.0, dt);
	}

	/** Calendar days elapsed since bud burst / apex creation, d. */
	public double daysSinceBudBurst() {
		double dt = this.ageD - this.birthAgeD;
		if (Double.isNaN(dt) || Double.isInfinite(dt)) return 0.0;
		return Math.max(0.0, dt);
	}

	/** Growing degree-days elapsed since bud burst / apex creation, degree-days. */
	public double gddSinceBudBurst() {
		double dt = this.ageGdd - this.birthAgeGdd;
		if (Double.isNaN(dt) || Double.isInfinite(dt)) return 0.0;
		return Math.max(0.0, dt);
	}

	/**
	 * Bloom threshold for mixed-bud flowers, counted from bud burst / apex creation.
	 * Unit is the same thermal-development unit as Apex.age.
	 */
	public double getMixedBudFloweringTDFromBudBurst() {
		double td = mixedBudFloweringTDFromBudBurst;
		if (Double.isNaN(td) || Double.isInfinite(td) || td <= 0.0) {
			td = 20.0;
		}
		return td;
	}

	/** Compatibility alias for old call sites; now returns the bud-burst bloom threshold. */
	public double getMixedBudBloomDelayThermal() {
		return getMixedBudFloweringTDFromBudBurst();
	}

	/**
	 * Test whether the mixed bud should expose its flower cluster at this rosette rank.
	 *
	 * @param rosetteRank1 current 1-based rosette rank
	 * @return {@code true} when the final rosette leaf should also trigger flower appearance
	 */
	public boolean shouldCreateFlowerAtCurrentRosetteRank(int rosetteRank1) {
		return this.shouldProduceFlower
			&& !this.mixedBudFlowerAppeared
			&& this.floralRosetteLeafCount > 0
			&& rosetteRank1 == this.floralRosetteLeafCount;
	}

	/**
	 * Record the first visible flower-cluster appearance on a mixed bud.
	 *
	 * @param rosetteRank1 rosette rank at which the flower appears
	 */
	public void markMixedBudFlowerAppearance(int rosetteRank1) {
		this.mixedBudFlowerAppeared = true;
		this.mixedBudFlowerAppearanceRank = rosetteRank1;
		this.mixedBudFlowerAppearanceAge = this.age;
		this.mixedBudFlowerAppearanceAgeD = this.ageD;
		this.mixedBudFlowerAppearanceAgeGdd = this.ageGdd;
		this.mixedBudBloomDelayAfterAppearance = this.getMixedBudFloweringTDFromBudBurst();
		if (printFlag) {
			println("[mixed-bud][flower-appearance] apex=" + this.getId()
				+ " rosetteTarget=" + this.floralRosetteLeafCount
				+ " finalRosetteRank=" + rosetteRank1
				+ " birthAge=" + this.birthAge
				+ " appearanceAge=" + this.mixedBudFlowerAppearanceAge
				+ " appearanceAgeD=" + this.mixedBudFlowerAppearanceAgeD
				+ " appearanceAgeGdd=" + this.mixedBudFlowerAppearanceAgeGdd
				+ " thermalSinceBudBurstAtAppearance=" + this.thermalTimeSinceBudBurst()
				+ " floweringTDFromBudBurst=" + this.getMixedBudFloweringTDFromBudBurst());
		}
	}
	
	
	/** Assign the source bud by ID (preferred). */
    public void setSourceBudId(long id) {
        this.sourceBudID = id;
    }

    /** Convenience: set from an actual bud once, but only keep its ID. */
    public void setSourceBud(BudService b) {
        this.sourceBudID = (b != null) ? b.getId() : 0L;
    }

    /** ID-based resolver (null-safe, type-safe). */
	    public BudAppleService getSourceBud() {
        if (this.sourceBudID <= 0) return null;
        Organ o = getOrgan(this.sourceBudID); // you already have getOrgan(long)
        return (o instanceof BudAppleService) ? (BudAppleService) o : null;
    }

	/**
	 * Read the bud ID that created this apex.
	 *
	 * @return source bud ID, or {@code 0} when none is recorded
	 */
	public long getSourceBudId() {
		return this.sourceBudID;
	}

	/**
	 * Read the parent-axis apex ID recorded for lateral and bourse child axes.
	 *
	 * @return parent axis apex ID, or {@code 0} when unavailable
	 */
	public long getParentAxisApexId() {
		return this.parentAxisApexID;
	}

	/**
	 * Test whether this apex can emit another phytomer in the current step.
	 *
	 * @return {@code true} when no step-local claim or prior emission blocks it
	 */
	public boolean canEmitPhytomerThisStep() {
		return this.lastPhytomerEmissionStep != step && !isPhytomerEmissionClaimedThisStep(this);
	}

	/**
	 * Mark this apex as having emitted a phytomer in the current step.
	 */
	public void markPhytomerProducedThisStep() {
		this.lastPhytomerEmissionStep = step;
	}
    
	
    /**
     * Record that a new main-axis internode has formed.
     *
     * <p>This hook is bookkeeping only. The develop-stage rule consumes the branch
     * plan directly from {@link #popPlannedBranchLenAtCurrentNode()}, so this method
     * does not create topology or advance the branch cursor itself.</p>
     *
     * @param itn newly created internode on the main axis
     */
    public void onNodeFormed(Internode itn) {
        int nodeRank = (itn != null && itn.rank > 0) ? itn.rank : (this.formedNodes + 1);
        if (nodeRank < 1) nodeRank = 1;
        this.formedNodes = Math.max(this.formedNodes, nodeRank);

        // Canonical branch spawning happens in developApple.rgg via popPlannedBranchLenAtCurrentNode().
        // Keep this hook bookkeeping-only so branchPlan/nextBranchIdx have a single consumer.
        if ((printFlag || debug) && this.branchPlan != null && this.nextBranchIdx < this.nBranches) {
            int legacyHits = 0;
            int firstPlannedLen = 0;
            int scanIdx = this.nextBranchIdx;
            while (scanIdx < this.nBranches && this.branchPlan[scanIdx][0] == nodeRank) {
                if (legacyHits == 0) firstPlannedLen = this.branchPlan[scanIdx][1];
                legacyHits++;
                scanIdx++;
            }
            if (legacyHits > 0) {
                println("[onNodeFormed-legacy-hit] step=" + step
                    + " apexId=" + this.getId()
                    + " nodeRank=" + nodeRank
                    + " internodeId=" + ((itn != null) ? itn.getId() : 0L)
                    + " plannedLen=" + firstPlannedLen
                    + " pendingHits=" + legacyHits
                    + " note=branchPlanNotConsumedHere");
            }
        }
    }
    
    
	/**
	 * Initiate an apex from a bud.
	 *
	 * <p>This is the bud-burst handoff path. The apex inherits bud identity,
	 * shoot type, flower state, axis IDs, and the bud-local shoot plan so the
	 * develop-stage rewrite can continue from the same biological line.</p>
	 *
	 * @param b bud being converted to an apex
	 */
	public void initiate(BudService b)
	{ 
		loadParameters();
		plantNumber = b.plantNumber;
		border = b.border;
		//when initiating from bud, a new apex appears. 
		//by default i use rank as the rank counting from the shoot it is growing
		rank = 1;		
		order = b.order;                                                 
		nodeNumber = b.nodeNumber; 
		cordonNumber = b.cordonNumber;
		syllepticOrder = b.syllepticOrder;
		
		this.axis2ID = b.axis2ID; 
		this.axis3ID = b.axis3ID;
		this.axis4ID = b.axis4ID;
		this.axis5ID = b.axis5ID;
		this.axis6ID = b.axis6ID;
		this.axis7ID = b.axis7ID;
		this.axis8ID = b.axis8ID;
		this.axis9ID = b.axis9ID;
		this.cpn = axis2ID + axis3ID + axis4ID + axis5ID + axis6ID + axis7ID + axis8ID + axis9ID + b.rank;
		
		age = plastochron;
		ageGdd = 0;
		length = 1e-4;
		 	
		budType = b.budType;
		shootType = b.shootType;
		flowerNumber = b.flowerNumber;
		
		
		
		
		shouldProduceFlower = b.budType == 2 ? true : false;
		if (shouldProduceFlower && (b instanceof BudAppleService)) {
			BudAppleService bb = (BudAppleService) b;
			this.floralRosetteLeafCount = bb.rosetteLeafTarget;
			this.bourseShootCountTarget = bb.nBourseTarget;
			this.spurAttachPlan = AppleShootPlan.copyPlanMatrix(bb.spurAttachPlan);
			this.bourseShootPlans = AppleShootPlan.copyShootPlans(bb.bourseShootPlans);
		} else {
			this.floralRosetteLeafCount = 0;
			this.bourseShootCountTarget = 0;
			this.spurAttachPlan = new int[0][0];
			this.bourseShootPlans = new AppleShootPlan[0];
		}
		this.nextSpurAttachIdx = 0;
		this.bourseShootCountSpawned = 0;
		this.mixedBudFlowerAppeared = false;
		this.mixedBudFlowerAppearanceRank = 0;
		this.mixedBudFlowerAppearanceAge = Double.NaN;
		this.mixedBudFlowerAppearanceAgeD = Double.NaN;
		this.mixedBudFlowerAppearanceAgeGdd = Double.NaN;
		this.mixedBudBloomDelayAfterAppearance = Double.NaN;
		this.parentAxisApexID = (b instanceof BudAppleService) ? ((BudAppleService) b).parentAxisApexID : 0L;
		this.lastPhytomerEmissionStep = -1;
		
		if (printFlag) { 
			println("shootType " + shootType + " shouldProduceFlower " + shouldProduceFlower);
			println("phytomerNumber " + phytomerNumber);
		}
		
		
			// Keep only the ID (robust across GC/serialization)
        this.setSourceBud(b);
        // ApexApple.initiate(BudService b)  (add the line shown)
        
        this.shootGrowthDelay = b.shootGrowthDelay;
		this.totalNodes = b.totalNodes;

		if (this.shouldProduceFlower) {
			this.phytomerNumber = Math.max(1, this.floralRosetteLeafCount);
			this.mainNodesPlanned = this.phytomerNumber;
			this.formedNodes = 0;
			this.branchPlan = new int[0][0];
			this.nBranches = 0;
			this.nextBranchIdx = 0;
			this.nodeAllocation = new int[1];
			this.nodeAllocation[0] = this.phytomerNumber;
			this.isSpur = true;
			this.mixedBudBloomDelayAfterAppearance = this.getMixedBudBloomDelayThermal();
		} else {
			this.nodeAllocation = AppleShootPlan.copyIntArray(b.nodeAllocation);
			this.phytomerNumber = (this.nodeAllocation != null && this.nodeAllocation.length > 0) ? this.nodeAllocation[0] : 1;
			this.phytomerNumber = Math.max(1, this.phytomerNumber);
			this.mainNodesPlanned = this.phytomerNumber;
			this.formedNodes = 0;
			this.branchPlan = AppleShootPlan.copyPlanMatrix(b.branchPlan);
			this.nBranches = this.branchPlan.length;
			this.nextBranchIdx = 0;
			this.isSpur = b.isSpur;
		}
		this.minBranchGap = MIN_BRANCH_GAP;
		this.potentialLength = b.potentialLength;
		this.markApexBirth();
		
		if (printFlag) {
			println("Apex from Bud#" + b.getId()
				+ " mainNodesPlanned=" + mainNodesPlanned
				+ " nBranches=" + nBranches
				+ " minGap=" + minBranchGap);
			if (this.shouldProduceFlower) {
				println("[mixed-bud][plan] apex=" + this.getId()
					+ " rosetteNodes=" + this.floralRosetteLeafCount
					+ " spurAttachPlan=" + AppleShootPlan.formatPlanMatrix(this.spurAttachPlan)
					+ " bourseShootPlans=" + this.bourseShootPlans.length);
			}
		}
		if (printFlag || debug) {
			println("[apple][apex-from-bud] step=" + step
				+ " apexId=" + this.getId()
				+ " sourceBudId=" + b.getId()
				+ " parentAxisApexId=" + this.parentAxisApexID
				+ " order=" + this.order
				+ " rank=" + this.rank
				+ " shootType=" + this.shootType
				+ " syllepticOrder=" + this.syllepticOrder
				+ " axis2=" + this.axis2ID
				+ " axis3=" + this.axis3ID
				+ " axis4=" + this.axis4ID
				+ " axis5=" + this.axis5ID
				+ " axis6=" + this.axis6ID
				+ " axis7=" + this.axis7ID
				+ " axis8=" + this.axis8ID
				+ " axis9=" + this.axis9ID
				+ " cpn=" + this.cpn);
		}

		
	}
	
	
	/**
	 * Initiate a bourse-shoot apex from a parent apex.
	 *
	 * <p>This is the mixed-bud child-axis path. It creates a one-level fallback child
	 * plan when needed and forwards to {@link #initiateBourseFromParent(ApexService, AppleShootPlan, int, int)}.
	 *
	 * @param a parent apex
	 */
	public void initiate(ApexService a)
	{ 
		int plannedNodes = (this.phytomerNumber > 0) ? this.phytomerNumber : a.phytomerNumber;
		AppleShootPlan fallbackPlan = new AppleShootPlan();
		fallbackPlan.totalNodes = Math.max(1, plannedNodes);
		fallbackPlan.isSpur = (fallbackPlan.totalNodes < SPUR_LIMIT);
		fallbackPlan.nodeAllocation = new int[]{ fallbackPlan.totalNodes };
		fallbackPlan.branchPlan = new int[0][0];
		fallbackPlan.nBranches = 0;
		fallbackPlan.mainNodesPlanned = fallbackPlan.totalNodes;
		
		fallbackPlan.potentialLength = 0.005;
		this.initiateBourseFromParent(a, fallbackPlan, -1, a.rank);
		this.markApexBirth();
	}

	/**
	 * Initialize a bourse-shoot apex from a parent apex using a full preplanned child shoot plan.
	 *
	 * <p>The parent mixed-bud apex supplies the child shoot plan and the attach rank.
	 * This method copies that plan, propagates child-axis identity, and records the
	 * parent apex ID so the develop-stage rules can keep the child axis tied to the
	 * correct spur.</p>
	 *
	 * @param a parent apex
	 * @param childShootPlan preplanned child shoot
	 * @param childPlanIndex index of the child plan within the mixed-bud plan set
	 * @param attachRank attach rank on the parent rosette/spur
	 */
	public void initiateBourseFromParent(ApexService a, AppleShootPlan childShootPlan, int childPlanIndex, int attachRank)
	{
		AppleShootPlan safeChildPlan = (childShootPlan != null) ? childShootPlan.copy() : null;
		if (safeChildPlan == null) {
			safeChildPlan = new AppleShootPlan();
			safeChildPlan.totalNodes = 1;
			safeChildPlan.isSpur = true;
			safeChildPlan.nodeAllocation = new int[]{ 1 };
			safeChildPlan.branchPlan = new int[0][0];
			safeChildPlan.nBranches = 0;
			safeChildPlan.mainNodesPlanned = 1;
			safeChildPlan.potentialLength = 0.005;
		}
		if (safeChildPlan.mainNodesPlanned < 1) safeChildPlan.mainNodesPlanned = 1;
		if (safeChildPlan.totalNodes < safeChildPlan.mainNodesPlanned) safeChildPlan.totalNodes = safeChildPlan.mainNodesPlanned;
		if (safeChildPlan.nodeAllocation == null || safeChildPlan.nodeAllocation.length == 0) {
			safeChildPlan.nodeAllocation = new int[]{ safeChildPlan.mainNodesPlanned };
		}
		loadParameters();
		plantNumber = a.plantNumber;
		border = a.border;
		//when initiating from bud, a new apex appears. 
		//by default i use rank as the rank counting from the shoot it is growing
		//reset to 1 as I want the bourse shoot leaf to count from 1 to maxPhytomer
		rank = 1;		
		order = a.order+1;                                                 
		nodeNumber = a.nodeNumber; 
		cordonNumber = a.cordonNumber;
		syllepticOrder = a.syllepticOrder + 1;
		assignChildAxisIdsFromParent(a, this, this.order, attachRank);
		
		age = plastochron;
		ageGdd = 0;
		length = 1e-4;
		 	
		budType = a.budType;
		shootType = "bourseShoot";
		flowerNumber = a.flowerNumber;
		this.shouldProduceFlower = false;
		this.floralRosetteLeafCount = 0;
		this.bourseShootCountTarget = 0;
		this.bourseShootCountSpawned = 0;
		this.spurAttachPlan = new int[0][0];
		this.bourseShootPlans = new AppleShootPlan[0];
		this.nextSpurAttachIdx = 0;
		this.mixedBudFlowerAppeared = false;
		this.mixedBudFlowerAppearanceRank = 0;
		this.mixedBudFlowerAppearanceAge = Double.NaN;
		this.mixedBudFlowerAppearanceAgeD = Double.NaN;
		this.mixedBudFlowerAppearanceAgeGdd = Double.NaN;
		this.mixedBudBloomDelayAfterAppearance = Double.NaN;
		this.parentAxisApexID = a.getId();
		this.lastPhytomerEmissionStep = -1;
		this.totalNodes = safeChildPlan.totalNodes;
		this.phytomerNumber = Math.max(1, safeChildPlan.mainNodesPlanned);
		this.mainNodesPlanned = this.phytomerNumber;
		this.formedNodes = 0;
		this.branchPlan = AppleShootPlan.copyPlanMatrix(safeChildPlan.branchPlan);
		this.nBranches = (this.branchPlan != null) ? this.branchPlan.length : 0;
		this.nextBranchIdx = 0;
		this.minBranchGap = MIN_BRANCH_GAP;
		this.nodeAllocation = AppleShootPlan.copyIntArray(safeChildPlan.nodeAllocation);
		this.isSpur = safeChildPlan.isSpur;
		this.potentialLength = safeChildPlan.potentialLength;
		if (printFlag || debug) {
			println("[mixed-bud][bourse] parentApex=" + a.getId()
				+ " attachRank=" + attachRank
				+ " childPlanIdx=" + childPlanIndex
				+ " childApex=" + this.getId()
				+ " " + safeChildPlan.summary()
				+ " order=" + this.order
				+ " shootType=" + this.shootType
				+ " syllepticOrder=" + this.syllepticOrder
				+ " axis2=" + this.axis2ID
				+ " axis3=" + this.axis3ID
				+ " axis4=" + this.axis4ID
				+ " axis5=" + this.axis5ID
				+ " axis6=" + this.axis6ID
				+ " axis7=" + this.axis7ID
				+ " axis8=" + this.axis8ID
				+ " axis9=" + this.axis9ID
				+ " cpn=" + this.cpn);
		}
		                  
		// Apply shoot-growth delay only to the bourse shoot growing out of a floral spur.
		float sgMean = shootGrowthDelay_mean;
		this.shootGrowthDelay = sgMean + budBurst_sd * Math.abs(sgMean) * (float) rng.nextGaussian(); 
		this.markApexBirth();
		
		
	}
	
	/**
	 * Legacy apex-initialization path from a plant base.
	 *
	 * <p>This path is retained for compatibility but is not used in the current apple
	 * dynamic-growth flow.</p>
	 *
	 * @param pb plant base
	 * @param i rank index
	 * @param k node number
	 * @param l cordon number
	 */
	
	public void initiate_pb(PlantBase pb, int i, int k, int l)
	{ 
		plantNumber = pb.plantNumber;
		border = pb.border;
		rank = i+1;
		nodeNumber = k; 
		cordonNumber = l;
		cpn = rank;
		order = 0;	
		age = this.rank * plastochron;
		length = 1e-4;
		this.markApexBirth();
	
	}
	

	/**
	 * Decide whether this apex should produce the next phytomer now.
	 *
	 * <p>The decision is rank-based and shoot-class-specific: floral rosette leaves,
	 * early vegetative leaves, and bourse shoots use different cadence values, but
	 * all paths respect the same same-step re-entry guards and planned-node cap.</p>
	 *
	 * @return {@code true} when the next phytomer should be produced now
	 */
	boolean shouldProducePhytomer() {
		final int floralRosetteLeafCount = (this.floralRosetteLeafCount > 0) ? this.floralRosetteLeafCount : 5;

		// 1) cap by planned nodes.
		// For floral apexes (mixed buds), reuse the same rank scheduler to emit the
		// rosette leaves before the flower cluster is created, without changing the
		// inherited bourse-shoot node plan (phytomerNumber).
		int effectivePhytomerCap = this.phytomerNumber;
		if (this.shouldProduceFlower == true) {
			effectivePhytomerCap = Math.max(effectivePhytomerCap, floralRosetteLeafCount);
		}
		if (this.rank > effectivePhytomerCap) {
			return false;
		}
		boolean freshAxisThisStep = (this.birthStep == step)
			&& this.rank <= 1
			&& (this.sourceBudID > 0L || this.parentAxisApexID > 0L);
		if (freshAxisThisStep) {
			resetAppleIdempotencyStatsIfNeeded();
			phytomerBirthStepBlocks++;
			if (printFlag || debug) {
				println("[phytomer-birth-step-block] step=" + step
					+ " apexId=" + this.getId()
					+ " shootType=" + this.shootType
					+ " rank=" + this.rank
					+ " sourceBudId=" + this.sourceBudID
					+ " parentAxisApexId=" + this.parentAxisApexID);
			}
			return false;
		}
		if (!this.canEmitPhytomerThisStep()) {
			resetAppleIdempotencyStatsIfNeeded();
			phytomerClaimsBlocked++;
			if (printFlag || debug) {
				println("[phytomer-reentry-block] step=" + step
					+ " apexId=" + this.getId()
					+ " shootType=" + this.shootType
					+ " rank=" + this.rank
					+ " lastEmissionStep=" + this.lastPhytomerEmissionStep);
			}
			return false;
		}
	
		// 2) timing check (single rule, all ranks)
		float delay = (Float.isNaN(this.shootGrowthDelay) || this.shootGrowthDelay < 0f)
					  ? 0f : this.shootGrowthDelay;

		double nodeCadence = plastochron;
		boolean isBourseShoot = "bourseShoot".equals(this.shootType);
		boolean isFloralRosette = this.shouldProduceFlower == true;
		if (isFloralRosette) {
			double rosetteCadence = rosettePhyllochronFactor * phyllochron;
			if (!(Double.isNaN(rosetteCadence) || Double.isInfinite(rosetteCadence) || rosetteCadence <= 0.0)) {
				nodeCadence = rosetteCadence;
			}
		} else if (!isBourseShoot && this.rank <= earlyVegetativeLeafCount) {
			double fastCadence = rosettePhyllochronFactor * phyllochron;
			if (!(Double.isNaN(fastCadence) || Double.isInfinite(fastCadence) || fastCadence <= 0.0)) {
				nodeCadence = fastCadence;
			}
		}
		nodeCadence = Math.max(0.05, nodeCadence);

		boolean due = (this.age - delay) >= (this.rank * nodeCadence);
		if (!due) return false;
		if (!reservePhytomerEmissionThisStep(this)) {
			if (printFlag || debug) {
				println("[phytomer-reentry-block] step=" + step
					+ " apexId=" + this.getId()
					+ " shootType=" + this.shootType
					+ " rank=" + this.rank
					+ " lastEmissionStep=" + this.lastPhytomerEmissionStep
					+ " reason=alreadyClaimedThisStep");
			}
			return false;
		}
	
		if (printFlag) println("new shoot phytomer");
		return true;
	}

	
	/**
	 * Pop the planned branch length for the just-created main node.
	 *
	 * <p>The develop-stage vegetative rule calls this after creating the internode
	 * but before incrementing the apex rank. That keeps the branch cursor aligned
	 * with the 1-based rank of the node that was just formed.</p>
	 *
	 * @return planned branch length for the current node, or {@code 0} when none is scheduled
	 */
	public int popPlannedBranchLenAtCurrentNode() {
		if (this.branchPlan == null) return 0;
		if (this.nextBranchIdx >= this.nBranches) return 0;
	
		int nodeIdx = this.rank;
	
		// Advance past any stale entries (shouldn’t happen, but safe)
		while (this.nextBranchIdx < this.nBranches &&
			   this.branchPlan[this.nextBranchIdx][0] < nodeIdx) {
			this.nextBranchIdx++;
		}
	
		// If the next planned attachment matches this node, consume it
		if (this.nextBranchIdx < this.nBranches &&
			this.branchPlan[this.nextBranchIdx][0] == nodeIdx) {
			int len = this.branchPlan[this.nextBranchIdx][1];
			if (len < 1) len = 1; // guard
			this.nextBranchIdx++; // consume the plan entry
			return len;
		}
	
		return 0;
	}

	/**
	 * Pop the next planned mixed-bud bourse child index when the rosette rank matches.
	 *
	 * @param rosetteRank1 current 1-based rosette rank
	 * @return child-plan index, or {@code -1} when no bourse child is scheduled
	 */
	public int popPlannedBoursePlanIndexAtRosetteRank(int rosetteRank1) {
		if (this.spurAttachPlan == null) return -1;
		if (this.nextSpurAttachIdx >= this.spurAttachPlan.length) return -1;
		if (rosetteRank1 < 1) rosetteRank1 = 1;

		while (this.nextSpurAttachIdx < this.spurAttachPlan.length &&
			   this.spurAttachPlan[this.nextSpurAttachIdx][0] < rosetteRank1) {
			if (printFlag) {
				println("[mixed-bud][bourse] skip stale plan parentApex=" + this.getId()
					+ " idx=" + this.nextSpurAttachIdx
					+ " attachRank=" + this.spurAttachPlan[this.nextSpurAttachIdx][0]
					+ " childPlanIdx=" + this.spurAttachPlan[this.nextSpurAttachIdx][1]
					+ " currentRosetteRank=" + rosetteRank1);
			}
			this.nextSpurAttachIdx++;
		}

		if (this.nextSpurAttachIdx < this.spurAttachPlan.length &&
			this.spurAttachPlan[this.nextSpurAttachIdx][0] == rosetteRank1) {
			int childPlanIndex = this.spurAttachPlan[this.nextSpurAttachIdx][1];
			this.nextSpurAttachIdx++;
			return childPlanIndex;
		}
		return -1;
	}

	/**
	 * Copy out one planned bourse shoot for the requested child-plan index.
	 *
	 * @param childPlanIndex index inside {@link #bourseShootPlans}
	 * @return copied plan, or {@code null} when no plan exists
	 */
	public AppleShootPlan getBourseShootPlan(int childPlanIndex) {
		if (childPlanIndex < 0) return null;
		if (this.bourseShootPlans == null) return null;
		if (childPlanIndex >= this.bourseShootPlans.length) return null;
		AppleShootPlan childShootPlan = this.bourseShootPlans[childPlanIndex];
		return (childShootPlan != null) ? childShootPlan.copy() : null;
	}

	
	/**
	 * Get the branching angle used for a newly emitted phytomer.
	 *
	 * @return random branching angle in degrees
	 */
	public double getAngle()
	{
		// this needs to be coupled to branchType
		return irandom(60, 80);
	}
	
	/**
	 * Advance the apex rank and cpn after phytomer creation.
	 */
	public void increment()
	{
		rank = rank +1;
		cpn = cpn + 1;
	}
	/**
	 * Update the apex water potential from the nearest parent internode when available.
	 */
	public void updateWaterPotential()
	{
		if(parent[0] == null) { this.parent[0] = first((*this (<--)+ Internode*));}
		
		if(parent[0] == null) {
			this.waterPotential = inputWaterPotential;
		} else {
			this.waterPotential = parent[0].waterPotential;
			this.order = parent[0].order;
		}
	}
	
