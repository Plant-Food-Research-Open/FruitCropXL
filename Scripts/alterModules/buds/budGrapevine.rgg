public module BudGrapevineService extends BudService {
	
	public void loadParameters() {
			
		/** Set the context for file name parameters*/
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();
		
		/** Configuration context for carbon-related parameters */
		config.setCategoryContext("bud-general");
		//common parameters
		stDormancyStage      = config.getInteger("stDormancyStage", 4);
	}
	 
	
    // bud initiation for shoot growing
	// used in the XEG reader, more information can be added in the tree factory if needed
	public BudService initiate_pi(PlantIdentifier pi, String budShootType)
	{ 
		loadParameters();
		plantNumber = pi.plantNumber;
		border = pi.border;
		age = plastochron;
		dormant = true;
		length = 1e-4;
				
		String[] splitValues = budShootType.split("[_\\.]");
		if (splitValues.length > 1) {
			shootType = splitValues[1];
			// Check if the second value contains 'V'
			if (shootType.contains("V")) {
				budType = 1;
			}
			// Check if the second value contains 'F'
			if (shootType.contains("F")) {
				budType = 2;
			}
		} else if (splitValues.length == 1) {
			shootType = "";
			budType = 2;
		}
		
		syllepticOrder = 0;
		dormancyStage = stDormancyStage;
		accumulatedChill = 0;
		accumulatedHeat = 0;
		heatTarget = Double.POSITIVE_INFINITY;
		diameter = 1e-3;
		// Init variables for branching
		ageGdd = phyllochron * rank;
		gcCounter = rank;
		probBudBreak = rank <= 1 ? 0 : 1;
		this.gcDuration = gcDurationGlobal; 
		int bunchPosition = budType == 2? random_int(2,6) : 0;
		bunchPositions = new int[] {bunchPosition};
		//println("bunchPositions " + Arrays.toString(bunchPositions));		
		return this;
	}	
		
	// bud initiation for shoot growing
	// used in the normal initiation for setting the initial condition from the start
	// or development rules
	public void initiate(Internode itn, float FBUD_FLORAL)
	{ 
		loadParameters();
		//general identifers
		plantNumber = itn.plantNumber;
		cordonNumber = itn.cordonNumber;
		nodeNumber = itn.nodeNumber;
		this.ID = itn.nodeID;
		this.order = itn.order + 1; 
		this.rank = 0;
		this.axis2ID = itn.axis2ID; 
		this.axis3ID = itn.axis3ID;
		this.axis4ID = itn.axis4ID;
		this.axis5ID = itn.axis5ID;
		this.axis6ID = itn.axis6ID;
		this.axis7ID = itn.axis7ID;
		this.axis8ID = itn.axis8ID;
		this.axis9ID = itn.axis9ID;
		this.cpn = axis2ID + axis3ID + axis4ID + axis5ID + axis6ID + axis7ID + axis8ID + axis9ID + rank;	
		
		if(itn.rank == 0 || itn instanceof Cordon) { 
			this.syllepticOrder = 0; 
			dormant = true;
		} else { 
			this.syllepticOrder = itn.syllepticOrder + 1;
			dormant = false;
		} 
		
		//information for the bud
		this.budType = budTypeDraw(FBUD_FLORAL);
		
		age = plastochron;
		
		length = 1e-4;
				
		//used in phenology module
		dormancyStage = stDormancyStage;
		accumulatedChill = 0;
		accumulatedHeat = 0;
		heatTarget = Double.POSITIVE_INFINITY;
		// Init variables for branching
		ageGdd = phyllochron * rank;
		gcCounter = rank;
		
		if(useTrophicCompetition == true) {
			this.gcDuration = gcDurationGlobal;
		}	
		gcDegreeDays = 0;
		//probBudBreak = rank <= 1 ? 0 : 1;
		
		//position for visualization, 
		//for convience in dynamic growth add 
		//one bunch per shoot as it is hard to deal with decimals
		int bunchPosition = budType == 2? random_int(2,6) : 0;
		bunchPositions = new int[] {bunchPosition};
		
		//if (printFlag) { println("bunchPositions " + Arrays.toString(bunchPositions)); }
		
		
	}

	

	
	// Determine when bud should produce secondary shoot based on thermal time and soil water potential
	public void updateOrganogenesisParams()
	{
		shouldBreak = false;
		gcDegreeDays += wangEngelTempFunction(Ta, MIN_TEMP, OPT_TEMP, MAX_TEMP,REFTMP)*DT;	// Add thermal time to duration of current growth cycle
		
		if (budType == 1 && syllepticOrder == 1 && gcDegreeDays > gcDuration) {
			
			// Calculate duration in thermal time of next growth cycle using soil water potential
			gcCounter++;
			this.gcDuration = gcDurationGlobal;
			gcDegreeDays = 0;
			
			// Determine whether bud should break in this growth cycle
			float p = Math.random();
			if (p < probBudBreak) {
				shouldBreak = true;
			}
		}
	}
	
	// conditions for germinations
	public boolean shouldBreak() {
		if (useTrophicCompetition == true) {
			return shouldBreak;
		} else {
			//if(dormant == true && syllepticOrder ==0 && useStaticArc == false && dormancyStage == phenology.POST_ECODORMANCY) return age > this.germinationDelay;
			//if(dormant == true && syllepticOrder == 0 && useStaticArc == false &&  age <2) return Math.random() >0.2; //control bud break of primary shoot
			if(this.dormant == true && this.dormancyStage == phenology.POST_ECODORMANCY && 
			   this.syllepticOrder == 0 && useStaticArc == false &&  this.age > budBurstDelay)  
		   {	
				this.dormant = false;
				if (printFlag) { println("bud burst happens" + "this.syllepticOrder " + this.syllepticOrder); }
				return true;
			} else 
				return false;
		}
	}

	public ApexService createApex() {
		return new ApexGrapevine();
	}

	
