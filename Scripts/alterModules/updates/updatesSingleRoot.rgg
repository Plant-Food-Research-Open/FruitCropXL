import java.util.Arrays;

public class UpdatesSingleRoot extends UpdatesService {
    public void updates() {[
        {
            updateEnvironment();
            updateSolarPosition(year, month, dayOfMonth, hourOfDay, 
										latitude, longitude, elevation,airPressure, Ta);
             if(hourOfDay == 0) {
                day++;
                if(inputEnvironmentCondition == false) dayOfYear++; 
                }
            tt = tt + (Ta - baseT)/24;
             println(" Year " + year + " dayOfYear " + dayOfYear + " hourOfDay " + hourOfDay + "\n" 
                 + " step " + step + " daytime " + daytime + " degree days, " + Math.round(tt * 100.0)/100.0);
        }
        s:Soil ::> { 
			s.updateSoilWaterStatus();
			//if (printFlag) { println("waterPotential of layer" + s.layer + ": " + s.waterPotential); }
			//if (printFlag) { println("waterContent of layer" + s.layer + ": " + s.waterContent); }
		}
        
        // calculate all organ ages
        o:Organ ::> 
        {
            o.calcAge();
            o.update3D();
            
        }
        
        rt:RootBase ::>  
        {
            rt.getPlantBase().leafArea = 0.2;
            rt.updateInput();
            rt.calcfluxAllocation();
            rt.calcXylemWaterPotential(rt.plantWaterFlux, rt.f_flux);
            rt.updateFineRootTurnoverAndExudation();
            
        }
    ]}
}