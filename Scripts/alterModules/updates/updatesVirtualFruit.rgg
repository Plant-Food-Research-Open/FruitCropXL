public class UpdatesVirtualFruit extends UpdatesService {
    public void updates() {[
        /* pb:PlantBase ::>  				
        {   
            pb.updateBiomass();
            pb.updateSurfaceArea();
        } */
        
        
        
        {
            updateEnvironment();
            updateSolarPosition(year, month, dayOfMonth, hourOfDay, 
                                        latitude, longitude, elevation,airPressure, Ta);
            if(hourOfDay == 0) {
                day++;
                if(inputEnvironmentCondition == false) dayOfYear++; 
                }
            tt = tt + deltaAgeGdd(Ta, baseT, DT);
            println(day +" days, "+ hourOfDay + " hour,"  + Math.round(tt * 100.0)/100.0 +" degree days, " + step + " step " + "daytime " + daytime); 
        }
       
        s:Soil ::> { 
			s.updateSoilWaterStatus();
			//if (printFlag) { println("waterPotential of layer" + s.layer + ": " + s.waterPotential); }
			//if (printFlag) { println("waterContent of layer" + s.layer + ": " + s.waterContent); }
		}
            
        // calculate all organ ages
        g:GrowingOrgan ::> 
        {
            g.calcAge();
            g.update();
            g.calcUnloading(0.1);		
        } 	
    ]}
}