		public void printAllFields(ObjectNode node) {
		// Use raw Map.Entry to maintain Java 1.5 compatibility (no generics)
		for (Iterator it = node.fields(); it.hasNext(); ) {
			Map.Entry entry = (Map.Entry) it.next();
			String key = (String) entry.getKey();
			JsonNode value = (JsonNode) entry.getValue();
			println(key + " : " + value.asText());
		}
	}
	
	@Override
	public void syncOutputs(ObjectNode node) {
		//printAllFields(node);
		
		waterMass = node.get("w").asDouble()/mgTogram;
		biomass = node.get("s").asDouble() /mgTogram;
		this.diameter = calculateDiameter(biomass*1e-6); //need kg as input
		
		osmoticWaterPotential_phloem = node.get("pip").asDouble();
		osmoticWaterPotential_vascular = node.get("piv").asDouble();
		osmoticWaterPotential_fruit = node.get("pif").asDouble();
		
		turgorPressure_phloem = node.get("pp").asDouble();
		turgorPressure_vascular = node.get("pv").asDouble();
		turgorPressure_fruit = node.get("pf").asDouble();
		
		seedDryWeight = node.get("sfstone").asDouble()/mgTogram;
		Afruit = node.get("af").asDouble();
		sugarConcentrationMole_fruit = node.get("ctcs").asDouble();
		
				
		transpirationMass = node.get("tf").asDouble();
		sucroseConcentration_vascular = node.get("cv").asDouble();
		sugarUptake_active = node.get("ua").asDouble();
		
		waterUptake_vascular_xylem = node.get("ux1").asDouble();
		waterUptake_vascular_phloem = node.get("up1").asDouble();
		
		Lxylem = node.get("khx").asDouble();
		Lphloem = node.get("khp").asDouble();
		
		waterUptake_xylem = node.get("ux").asDouble();
		waterUptake_phloem = node.get("up").asDouble();
		
		sugarUptake_massflow = node.get("masfls").asDouble();
		sugarUptake_passive = node.get("pasfls").asDouble();
		
		maintenanceDM = node.get("rM").asDouble();
		growthCost = Math.max(0,node.get("rG").asDouble());
		
		pf1 = node.get("pf1").asDouble();
		pf2 = node.get("pf2").asDouble();
				
		vol = node.get("v").asDouble();
		
		waterPotential_fruit = turgorPressure_fruit - osmoticWaterPotential_fruit;
		waterPotential_phloem = turgorPressure_phloem - osmoticWaterPotential_phloem;

		mSta = node.get("mSta").asDouble();
		mSyn = node.get("mSyn").asDouble();
		
		//special to the sugar model, "mSol";
		if ((active & Active.SUGAR) != 0) {
			mSol = node.get("mSol").asDouble();
		}
		//special to sugar2 model
		if ((active & Active.SUGAR2) != 0) {
			try {
				mSuc = node.get("mSuc").asDouble();
				mSor = node.get("mSor").asDouble();
				mGlu = node.get("mGlu").asDouble();
				mFru = node.get("mFru").asDouble();

				if (debug && printFlag) {
					double sugar2SolubleSugarMass_g = calcSugar2SolubleSugarMass_g();
					double fruitWaterMass_g = getFruitWaterMass_g();
					println(String.format(
						"Sugar2 pools: w=%.6f g, S=%.6f g",
						fruitWaterMass_g, sugar2SolubleSugarMass_g));
				}
			} catch (RuntimeException e) {
				// Compatibility fallback for legacy outputs that do not expose Sugar2 pools.
			}
		}
		
		// decide not to synchronize the sugars as it changes with different sugar model
		// can see the detail output in the json file
		//just as a approximate, not absolutly as the fraction may differ
		//not in use for big calculations
		freshWeight = waterMass + biomass + seedDryWeight; //mg
		carbon_total = (biomass + seedDryWeight) * CARBON_FRACTION_GLUCOSE;
		//carbon_structure = carbon_total-carbon_nonStructure; 

		double solubleSugarMass_g = calcSyncedSolubleSugarMass_g();
		if (isFiniteVF(solubleSugarMass_g)) {
			solubleSugar = solubleSugarMass_g / mgTogram;
		}

		double syncedSugarConcentration = calcSyncedSugarConcentration_g_per_g_water();
		if (isFiniteVF(syncedSugarConcentration)) {
			sugarConcentration_fruit = syncedSugarConcentration;
		} else {

			double waterMass_g = getFruitWaterMass_g();
			if (isFiniteVF(sugarConcentration_fruit) && isFiniteVF(waterMass_g) && waterMass_g > 0.0) {
				solubleSugar = sugarConcentration_fruit * waterMass_g / mgTogram;
			}
		}
		if (species.equals("apple") &&((active & Active.SUGAR2) != 0)) {
			unloadingPerFruit = maintenanceDM + ( (1 - FRACTION_SORBITOL) * CARBON_FRACTION_SUCROSE +  FRACTION_SORBITOL * CARBON_FRACTION_SORBITOL) * 
		 						(sugarUptake_active + sugarUptake_passive + sugarUptake_massflow)/mgTogram; 
			unloading = unloadingPerFruit; 		 						
		} else {
			unloadingPerFruit = maintenanceDM + (CARBON_FRACTION_SUCROSE) * 
		 						(sugarUptake_active + sugarUptake_passive + sugarUptake_massflow)/mgTogram;
		 	unloading = unloadingPerFruit;
		}
		
	}
	


	
	
	/**
	 * Update each fruit within the simulation.
	 * This gives age differences between fruits
	 * needs to vary the initial fruit fresh weight, dry weight and sugar concentration as well
	 */


@Override
void calcPTCTRAM(double sc) 
{   					
	if (!calcCarbonAllocation) {
		resetCarbonAllocationOffState();
		return;
	}
	
	calcUnloading(sc);
	sugarConcentration_phloem_pre = sc; // update previous sugar at end of timestep for next MM scaling
	structureDM_PRI_PT = unloading;
	structureDM_SEC_PT = 0; 
			
	maintenanceDM_PT = maintenanceDM; 
	
	reserveDM_PT = 0;
	
	loading_PT =  0; 
	
	//println("structureDM_PRI_PT: " + structureDM_PRI_PT);
	
}

	
	
@Override
void calcUnloading(double sugarConcentration_phloem) {
	if (!calcCarbonAllocation) {
		resetCarbonAllocationOffState();
		return;
	}
    
	// ---------- Scale the per-fruit demand by MM factor (previous vs current sugar) ----------
    double s_prev = sugarConcentration_phloem_pre;
    if (s_prev <= 0f || Double.isNaN(s_prev) || Double.isInfinite(s_prev)) s_prev = sugarConcentration_phloem;

    float mm_prev = sinkUnloading(s_prev, this.km_pri);
    if (mm_prev < 1e-8f) mm_prev = 1e-8f;  // avoid division by ~0
    float mm_curr = sinkUnloading(sugarConcentration_phloem, this.km_pri);
    if (shouldUsePreT1PotentialGrowth()) {
        // Pre-T1 mode keeps virtual-fruit potential demand without carbon down-scaling.
        mm_curr = mm_prev;
    }

    // NOTE: unloadingPerFruit is mg·h⁻¹ (from VF sync); keep units in mg·h⁻¹ here.
    unloading   = unloadingPerFruit <= 0 ? 0.1 : (unloadingPerFruit * (mm_curr / mm_prev)); // mg/h
    structureDM = unloading;

    if ((debug && printFlag) || (VF_DEBUG_MM && printFlag)) { 
        float mm_ratio = mm_curr / mm_prev;
        println("VF.calcUnloading"
            + " s_prev=" + s_prev
            + " s_curr=" + sugarConcentration_phloem
            + " mm_prev=" + mm_prev
            + " mm_curr=" + mm_curr
            + " ratio=" + mm_ratio
            + " unloadingPerFruit(mg/h)=" + unloadingPerFruit
            + " -> unloading(mg/h)=" + unloading);
           }
    
}


