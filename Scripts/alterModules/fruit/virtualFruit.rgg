	/**
	 * Constructor used by FruitPlanner add-fruit for virtual-fruit species (apple path).
	 *
	 * Initialization is intentionally two-stage:
	 * 1) Build an instance-specific ParametersFactory and seed it with DEFAULT init values from
	 *    `initial.conditions.*` (FW/DW + Sugar2.c*0) so this fruit has a valid standalone baseline.
	 * 2) FruitPlanner later calls `initiate_pb(...)` for graph placement and then, if a nearby
	 *    template fruit was found, calls `applyInitState(FruitInitState)` on this new fruit.
	 *
	 * The later template override updates both:
	 * - FruitService runtime fields (FW/DW/sugars/etc.), and
	 * - this VirtualFruit instanceParametersFactory (`Growth.*`, `Sugar2.*`),
	 * then rebuilds the JFruit runtime so model state and parameter init keys stay consistent.
	 */
	public VirtualFruit(ParametersFactory parametersFactory, int delta) {
		// Create an instance-specific parameter factory so per-fruit init can vary.
		this.instanceParametersFactory = copyParametersFactory(parametersFactory);
		FruitService.FruitInitState initState = buildDefaultVirtualFruitInitStateFromConfig();
		applyInitStateToInstanceParametersFactory(initState, true, false);
		rebuildVirtualFruitRuntime(delta);
		
		loadParameters();
		initOutputHeaders();
		this.isFirstUpdate = true;
		this.length = 2e-2;
		this.active = instanceParametersFactory.getJfruit2Param().getActive();
		
	}

	private FruitService.FruitInitState buildDefaultVirtualFruitInitStateFromConfig() {
		FruitService.FruitInitState s = new FruitService.FruitInitState();
		s.valid = true;
		s.freshWeight_mg = FRUIT_FRESH_WEIGHT;
		s.dryWeight_mg = FRUIT_DRY_WEIGHT;

		CategoryStore config_Init =
			((DocumentCategoryNameGroup) CONFIG.getGroup(
				FILE_NAME_INITIAL_CONDITIONS,
				DocumentCategoryNameGroup.class))
			.getCategoryStore();
		config_Init.setCategoryContext("fruit");

		s.hasSugar2Concentrations = false;
		Double cSuc0 = readOptionalSugar2InitDouble(config_Init, "cSuc0");
		Double cSor0 = readOptionalSugar2InitDouble(config_Init, "cSor0");
		Double cGlu0 = readOptionalSugar2InitDouble(config_Init, "cGlu0");
		Double cFru0 = readOptionalSugar2InitDouble(config_Init, "cFru0");
		Double cSta0 = readOptionalSugar2InitDouble(config_Init, "cSta0");
		if (cSuc0 != null && cSor0 != null && cGlu0 != null && cFru0 != null && cSta0 != null) {
			s.cSuc0 = cSuc0.doubleValue();
			s.cSor0 = cSor0.doubleValue();
			s.cGlu0 = cGlu0.doubleValue();
			s.cFru0 = cFru0.doubleValue();
			s.cSta0 = cSta0.doubleValue();
			s.hasSugar2Concentrations = true;
		}
		return s;
	}

	private boolean isFiniteVF(double v) {
		return !(Double.isNaN(v) || Double.isInfinite(v));
	}

	private Double readOptionalSugar2InitDouble(CategoryStore config_Init, String key) {
		double v;
		try {
			v = config_Init.getDouble(key, Double.NaN);
		} catch (Exception e) {
			return null;
		}
		if (!isFiniteVF(v) || v < 0.0) return null;
		return Double.valueOf(v);
	}

	private Double readOptionalSugar2InitDouble(ParametersFactory parametersFactory, String key) {
		double v;
		try {
			if (parametersFactory == null || parametersFactory.getConfiguration() == null) return null;
			v = parametersFactory.getConfiguration().getDouble(key, Double.NaN);
		} catch (RuntimeException e) {
			return null;
		}
		if (!isFiniteVF(v) || v < 0.0) return null;
		return Double.valueOf(v);
	}

	private void populateSugar2InitStateFromParameters(FruitService.FruitInitState s) {
		if (s == null) return;

		ParametersFactory parametersFactory = instanceParametersFactory;
		if (parametersFactory == null && jLaunch != null) {
			parametersFactory = jLaunch.getParamFct();
		}
		if (parametersFactory == null) return;

		Double cSuc0 = readOptionalSugar2InitDouble(parametersFactory, "Sugar2.cSuc0");
		Double cSor0 = readOptionalSugar2InitDouble(parametersFactory, "Sugar2.cSor0");
		Double cGlu0 = readOptionalSugar2InitDouble(parametersFactory, "Sugar2.cGlu0");
		Double cFru0 = readOptionalSugar2InitDouble(parametersFactory, "Sugar2.cFru0");
		Double cSta0 = readOptionalSugar2InitDouble(parametersFactory, "Sugar2.cSta0");
		if (cSuc0 == null || cSor0 == null || cGlu0 == null || cFru0 == null || cSta0 == null) return;

		s.cSuc0 = cSuc0.doubleValue();
		s.cSor0 = cSor0.doubleValue();
		s.cGlu0 = cGlu0.doubleValue();
		s.cFru0 = cFru0.doubleValue();
		s.cSta0 = cSta0.doubleValue();
		s.hasSugar2Concentrations = true;
	}

	private void applyInitStateToInstanceParametersFactory(FruitService.FruitInitState s,
			boolean printKeys, boolean templateOverride) {
		if (instanceParametersFactory == null || s == null || !s.valid) return;

		double w0 = FRUIT_FRESH_WEIGHT * mgTogram;
		if (isFiniteVF(s.freshWeight_mg) && s.freshWeight_mg > 0) {
			w0 = s.freshWeight_mg * mgTogram;
		}

		double s0 = FRUIT_DRY_WEIGHT * mgTogram;
		if (isFiniteVF(s.dryWeight_mg) && s.dryWeight_mg >= 0) {
			s0 = s.dryWeight_mg * mgTogram;
		}

		boolean sugar2Active = false;
		try {
			int activeFlags = instanceParametersFactory.getJfruit2Param().getActive();
			sugar2Active = ((activeFlags & Active.SUGAR2) != 0);
		} catch (Throwable t) {
			sugar2Active = true; // compatibility fallback: keep Sugar2-centric behavior
		}

		String[] growthKeys = {"Growth.stot0", "Growth.w0", "Sugar2.s0"};
		String[] growthVals = {String.valueOf(s0), String.valueOf(w0), String.valueOf(s0)};
		int i;
		for (i = 0; i < growthKeys.length; i++) {
			instanceParametersFactory.getConfiguration().setProperty(growthKeys[i], growthVals[i]);
		}

		if (sugar2Active && s.hasSugar2Concentrations) {
			String[] sugarKeys = {
				"Sugar2.cSuc0",
				"Sugar2.cSor0",
				"Sugar2.cGlu0",
				"Sugar2.cFru0",
				"Sugar2.cSta0"
			};
			String[] sugarVals = {
				String.valueOf(s.cSuc0),
				String.valueOf(s.cSor0),
				String.valueOf(s.cGlu0),
				String.valueOf(s.cFru0),
				String.valueOf(s.cSta0)
			};
			for (i = 0; i < sugarKeys.length; i++) {
				instanceParametersFactory.getConfiguration().setProperty(sugarKeys[i], sugarVals[i]);
			}
		} else if (templateOverride && sugar2Active && fruitAddDebug && printFlag) {
			println("[VirtualFruit] template init missing Sugar2 concentrations; keeping existing Sugar2.c*0 defaults.");
		}

		try {
			instanceParametersFactory.writeAndCheck();
		} catch (IOException e) {
			e.printStackTrace();
		}

		if (printKeys && fruitAddDebug && printFlag && templateOverride
			&& !loggedTemplateInitOverrideKeysOnce) {
			loggedTemplateInitOverrideKeysOnce = true;
			println("[VirtualFruit] template init override applied:");
			println("  Growth.stot0=" + instanceParametersFactory.getConfiguration().getString("Growth.stot0"));
			println("  Growth.w0=" + instanceParametersFactory.getConfiguration().getString("Growth.w0"));
			println("  Sugar2.s0=" + instanceParametersFactory.getConfiguration().getString("Sugar2.s0"));
			if (sugar2Active) {
				println("  Sugar2.cSuc0=" + instanceParametersFactory.getConfiguration().getString("Sugar2.cSuc0"));
				println("  Sugar2.cSor0=" + instanceParametersFactory.getConfiguration().getString("Sugar2.cSor0"));
				println("  Sugar2.cGlu0=" + instanceParametersFactory.getConfiguration().getString("Sugar2.cGlu0"));
				println("  Sugar2.cFru0=" + instanceParametersFactory.getConfiguration().getString("Sugar2.cFru0"));
				println("  Sugar2.cSta0=" + instanceParametersFactory.getConfiguration().getString("Sugar2.cSta0"));
			}
		}
	}

	private void rebuildVirtualFruitRuntime(int delta) {
		if (instanceParametersFactory == null) return;
		jLaunch = new ExtendedJLaunch(instanceParametersFactory);
		input = jLaunch.initInput(delta);
		this.active = instanceParametersFactory.getJfruit2Param().getActive();
	}

	@Override
	public FruitService.FruitInitState captureInitState() {
		FruitService.FruitInitState s = super.captureInitState();
		populateSugar2InitStateFromParameters(s);
		return s;
	}

	@Override
	public void applyInitState(FruitService.FruitInitState s) {
		// Called by FruitPlanner after initiate_pb(...) when a neighbour/template fruit exists.
		// This keeps FruitService fields and VirtualFruit instance init keys synchronized.
		super.applyInitState(s);
		if (s == null || !s.valid) return;
		if (instanceParametersFactory == null) return;

		applyInitStateToInstanceParametersFactory(s, true, true);
		rebuildVirtualFruitRuntime(DELTA);
		initOutputHeaders();
		this.isFirstUpdate = true;
		delayExecutionFlag = true;
	}
		

		/**
	 * Calculates the carbon potential molarity (Cpm) in the fruit phloem based on the given
	 * sugar concentration in the phloem sap.
	 * <p>
	 * The sugar concentration is first converted into molar concentration (mol/L)
	 * using {@code convertSugarToMol(double)}. The result is then capped at a maximum
	 * of 0.69 mol/L to avoid numerical instability in the virtual fruit model simulations.
	 * <p>
	 * <b>Conversion background:</b><br>
	 * The molar concentration is calculated from the sugar concentration (g/g) assuming:
	 * <ul>
	 *   <li>Solution density ≈ 1000 g/L (for dilute sugar solutions)</li>
	 *   <li>Molar mass is a weighted average depending on sugar type: 
	 *       sucrose (342.3 g/mol) and sorbitol (182.17 g/mol).</li>
	 *   <li>Formula: {@code mol/L = (sugar concentration * 1000) / (effective molar mass)}</li>
	 *   <li>The effective molar mass is calculated as:<br>
	 *       {@code effective molar mass = FRACTION_SORBITOL × MOL_SORBITOL + (1 - FRACTION_SORBITOL) × MOL_SUCROSE}</li>
	 * </ul>
	 * <p>
	 * For example, with 30% sorbitol and 70% sucrose, the effective molar mass is about 294 g/mol.
	 * Thus, a sugar concentration of 0.15 g/g corresponds approximately to 0.51 mol/L.
	 * <p>
	 * Note: Previously, random noise was added to Cpm to prevent singularities. The current
	 * implementation strictly caps the value instead.
	 * when cpm exceeds 0.69, there will be error pop up from the virtual fruit and the turgor pressure is too big
	 *
	 * @param sugarConcentration_phloem Sugar concentration in the phloem (g/gSolution).
	 * @see #convertSugarToMol(double)
	 */
	void calcCpm(double sugarConcentration_phloem) {
		this.Cpm = Math.min(0.69, convertSugarToMol(sugarConcentration_phloem));
	}
	
