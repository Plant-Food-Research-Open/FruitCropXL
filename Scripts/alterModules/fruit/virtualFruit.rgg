	/**
 * #########################################
 * # Hour/Time Conventions (overview)
 * #########################################
 *
 * There are two hour domains in FruitCropXL + JFruit2:
 *
 *  1) MODEL hour: 0..23      (used internally by FruitCropXL)
 *  2) FILE hour : 1..24      (used in CSV / JFruit2 input "age_h")
 *
 * Why the mismatch?
 *   - FruitCropXL's simulation clock uses the usual 0-based hour-of-day.
 *   - JFruit2 and the CSV inputs encode hours 1..24 (inclusive).
 *
 * Core rules implemented here:
 *   - All *internal* code uses MODEL hour (0..23).
 *   - Any time we read/write JSON/CSV rows for JFruit2, we convert MODEL->FILE (0..23 -> 1..24).
 *   - Indexing into inputNodeList uses FILE hour (1..24) and a (firstAgeD, firstAgeH) FILE-based origin.
 *   - Canonical simulation minutes are built from (age_d, age_h[FILE]) and then forced to be strictly increasing
 *     when pushed to JFruit2 to avoid "integration interval length = 0".
 *
 * Key helpers:
 *   - toFileHour(int h0_23)   : 0..23 -> 1..24
 *   - toModelHour(int h1_24)  : 1..24 -> 0..23
 *   - toMinutes(ageD, h1_24)  : (ageD * 24 + toModelHour(h1_24)) * 60
 *
 * Persisted origins:
 *   - firstAgeD : first day observed in the input series
 *   - firstAgeH : first hour observed in the input series, stored as FILE hour (1..24)
 *
 * Typical flow (per update()):
 *   1) We ask for a row with getFruitInput(ageD, modelHour0_23).
 *      - If file-backed, we convert to FILE hour and index inputNodeList.
 *      - If synthesized, we keep MODEL hour and emit FILE hour in the row.
 *   2) We call processInput(row):
 *      - setTimeFromRow(row) parses (age_d, age_h[FILE]) -> MODEL hour, canonical minutes.
 *      - We guarantee the minute index we push to JFruit2 is strictly increasing.
 *   3) We step the ODEs and then write outputs (only if the step ran).
 *
 * Midnight boundary:
 *   - There is no "0" FILE hour. 00:00 in MODEL hour is "1" in FILE hour for that day.
 *   - (age_d, age_h=24) FILE is the last hour of the day; the next hour is (age_d+1, age_h=1).
 */

 
	// File-hour (CSV/JFruit2) is 1..24; Model-hour is 0..23
	private static int toFileHour(int hour0_23) { return hour0_23 + 1; }
	private static int toModelHour(int hour1_24) {
		int h = hour1_24 - 1;
		if (h < 0) h = 0;
		if (h > 23) h = 23;
		return h;
	}
	
	// Build minutes from (age_d, fileHour) deterministically
	private static int toMinutes(int ageD, int fileHour1_24) {
		return (ageD * 24 + toModelHour(fileHour1_24)) * 60;
	}
	
	/** Set internal time from row (age_d, age_h in 1..24). 
	    this is for input into the fruit model 
	    thus row is using file hour for the virtual fruit*/
	private void setTimeFromRow(JsonNode row) {
		int ageD_file  = row.get("age_d").asInt();
		int hourF      = row.get("age_h").asInt();   // 1..24
		//this.ageD    = ageD_file;
		//this.ageHour = toModelHour(hourF);           // keep 0..23 inside the model
		//this.ageMin  = toMinutes(ageD_file, hourF);  // canonical minutes
	}
     
	// Use fruit's own clock to produce FILE hour (1..24)
	private int fileHourFromOrganClock() {
		int h = this.ageHour % 24;
		if (h < 0) h += 24;
		return toFileHour(h);
	}
	
	// Build VF minutes strictly from fruit's organ day + hour
	private int vfMinutesFromOrganClock() {
		int d  = (int) Math.floor(this.ageD);
		int fh = fileHourFromOrganClock();
		return toMinutes(d, fh);
	}

	
	/** Returns input Json either from file-backed list or synthesized from model state.
	 *  Expects hour_ in MODEL space (0..23).
	 */
	private JsonNode getFruitInput(int ageD_, int hour_) {
		if (inputVesselConditions) {
			int fileHour = toFileHour(hour_);              // 1..24
			JsonNode n = tryGetInput(ageD_, fileHour, false);
			if (n == null) n = tryGetInput(ageD_, fileHour, true);
			return n;
		}
		// Synthesis path expects MODEL hour; it will write age_h as 1..24 itself
		return synthesizeInputNode(ageD_, hour_);
	}


	/** Build a Json input row from current model/environment state (no file). */
	private JsonNode synthesizeInputNode(int ageD_, int hour_) {
		ObjectMapper om = new ObjectMapper();
		ObjectNode n = om.createObjectNode();
	
		// --- Age fields expected downstream ---
		n.put("age_d", ageD_);
		n.put("age_h", toFileHour(hour_)); // write 1..24
	
		// --- Temperature in °C (your fromArray will convert to K) ---
		double Tc = (Ta > 200.0) ? (Ta - 273.15) : Ta; // °C
	
		// --- Relative humidity as percent (from 0–1 rh) ---
		int Ha = (int) (rh * 100.0);
	
		// --- Water potential psi_x in bar ---
		double psiBar;
		if (parentID > 0) {
			Organ par = getParent();
			if (par instanceof GrowingOrgan) {
				double pWP = ((GrowingOrgan) par).waterPotential;
				psiBar = (pWP <= 0) ? (pWP * 10.0) : (inputWaterPotential * 10.0);
			} else {
				psiBar = inputWaterPotential * 10.0;
			}
		} else {
			psiBar = inputWaterPotential * 10.0;
		}
		if (psiBar < -25) psiBar = -25; // keep your guard
		// --- Hydraulic conductance ro (cm/h) ---
		calcRo(ageD_); // updates this.ro
		double roLocal = this.ro;
	
		// --- Phloem sugar concentration Cpm (mol/L) via your calcCpm(sugar) ---
		double sc_curr;
		if (!organGrowthMethod.equals("TempLimited")) {
			if (!useCTRAM) {
				if (plantBaseID > 0 && getPlantBase().sugarConcentration_phloem > 0) {
					sc_curr = getPlantBase().sugarConcentration_phloem;
				} else {
					sc_curr = 1e-2;
				}
			} else {
				sc_curr = sugarFromCp(this.cpt);
			}
		} else {
			sc_curr = 1e-2;
		}

		// Keep stored previous sugar for MM scaling; initialize once if absent/invalid.
		double sc_prev = sugarConcentration_phloem_pre;
		if (!(sc_prev > 0) || Double.isNaN(sc_prev) || Double.isInfinite(sc_prev)) {
			sc_prev = sc_curr;
			sugarConcentration_phloem_pre = sc_curr;
		} else {
			sugarConcentration_phloem_pre = sc_prev;
		}

		calcCpm(sc_curr);                   // sets this.Cpm in mol/L (capped)
		double cpmMolPerL = this.Cpm;
	
		// --- Emit fields as your updateInput(inputVesselConditions==true) expects ---
		n.put("T",    Tc);          // °C  -> fromArray adds 273.15
		n.put("H_a",  Ha);          // %   -> fromArray divides by 100
		n.put("psi_x", psiBar);     // bar (as-is)
		n.put("Cpm",  cpmMolPerL);  // mol/L -> fromArray divides by 1000
		n.put("rho",  roLocal);     // cm/h (as-is)
	
		return n;
	}

	
	
	/**
	 * Attempts to retrieve the fruit simulation input at a specific age (in days and hours).
	 * If the inputNodeList is missing or not initialized correctly, the method will attempt
	 * one retry by invoking {@code initData()}.
	 *
	 * <p>This method is designed to be resilient to deserialization or reload gaps where
	 * transient fields like inputNodeList are not restored.</p>
	 *
	 * @param ageD The age of the fruit in days.
	 * @param hour The hour of the day.
	 * @return The corresponding {@link JsonNode} for the given age and hour, or {@code null} if unavailable.
	 */
	private JsonNode getInputByIndex(int ageD, int hour) {
		JsonNode result = tryGetInput(ageD, hour, false);
		if (result == null) {
			result = tryGetInput(ageD, hour, true);
		}
		return result;
	}
	/**
	 * Internal utility method to retrieve a {@link JsonNode} from the inputNodeList,
	 * optionally reinitializing the data if requested.
	 *
	 * <p>This function calculates an index based on the fruit's age and checks that
	 * the node exists in the list. If not, it returns the final element as a fallback,
	 * or {@code null} if the list is empty or uninitialized.</p>
	 *
	 * @param ageD  Age in days (used to compute list index).
	 * @param hour  Hour offset from the starting hour (used to compute list index).
	 * @param retry If {@code true}, will call {@code initData()} to repopulate inputNodeList.
	 * @return The matching {@link JsonNode} from the list, or {@code null} if data is missing.
	 */
	private JsonNode tryGetInput(int ageD, int hour, boolean retry) {
		if (retry) {
			println("⚠️ Reinitializing fruit input data...");
			initData();
		}
	
		if (inputNodeList == null || firstAgeD == -1 || firstAgeH == -1) {
			println("❌ Input metadata missing" + (retry ? " after retry." : "."));
			return null;
		}
	
		int index = ((ageD - firstAgeD) * 24) + (hour - firstAgeH);
		if (index >= 0 && index < inputNodeList.size()) {
			return (JsonNode) inputNodeList.get(index);
		} else if (!inputNodeList.isEmpty()) {
			return (JsonNode) inputNodeList.get(inputNodeList.size() - 1); // return last known input
		} else {
			println("❌ Input list is empty" + (retry ? " after retry." : "."));
			return null;
		}
	}


/**
 * Processes input when inputVesselConditions == true.
 *
 * @param ageMin    The computed age in minutes.
 * @param inputJsonNode The JsonNode containing input data.
 */
// Class field (per fruit)
private int lastPushedMin = Integer.MIN_VALUE;

private void processInput(JsonNode row) {
    if (input == null && jLaunch != null) input = jLaunch.initInput(DELTA);
    if (row == null) { println("⚠️ processInput: row == null, skipping."); return; }

    // Minutes from the SAME organ day/hour used for the CSV index
    int nowMin = vfMinutesFromOrganClock();

    int cadence = (input != null && input.getDelta() > 0) ? input.getDelta() : Math.max(DELTA, 60);

    // Ensure strictly increasing time for VF ODEs
    if (lastPushedMin != Integer.MIN_VALUE && nowMin <= lastPushedMin) {
        nowMin = lastPushedMin + cadence;
    }

    if (isFirstUpdate || !input.isValid() || input.getDelta() <= 0) {
        int prevMin = nowMin - cadence;
        if (prevMin < 0) prevMin = Math.max(0, nowMin - 60);

        fromArray(prevMin, row);  // prime older frame
        fromArray(nowMin,  row);  // prime current frame

        lastPushedMin      = nowMin;
        isFirstUpdate      = false;
        delayExecutionFlag = true;   // step next tick
        return;
    }

    fromArray(nowMin, row);
    lastPushedMin      = nowMin;
    delayExecutionFlag = false;
}


 private boolean stepRanOk = false;

	private boolean shouldRunVirtualFruitStep() {
		return calcCarbonAllocation;
	}

	private void syncAgeFromFruitClock() {
		double min = this.ageMin;
		this.ageHour = (int)Math.floor(min / 60.0);
		this.ageD = min / 1440.0;
	}

	private void resetCarbonAllocationOffState() {
		// Carbon allocation is disabled: expose zero fruit demand (mg C h-1) and keep JFruit2 state frozen.
		unloadingPerFruit = 0.0;
		unloading = 0.0;
		structureDM = 0.0;
		structureDM_PRI = 0.0;
		structureDM_SEC = 0.0;
		maintenanceDM_PT = 0.0;
		structureDM_PRI_PT = 0.0;
		structureDM_SEC_PT = 0.0;
		reserveDM_PT = 0.0;
		loading_PT = 0.0;
		reserveDM = 0.0;
		loading = 0.0f;
	}
/**
     * Executes the core computational step for the fruit model.
     * Handles arithmetic exceptions and unexpected errors to prevent crashes.
     */
private void executeStepCalculation() {
    stepRanOk = false;
    try { step(); stepRanOk = true; }
    catch (ArithmeticException e) { shouldDrop = true; logArithmeticException(e); }
    catch (Exception e) { if (printFlag) println("Unexpected: " + e.getMessage()); }
}

    /**
     * Logs details for ArithmeticException and prevents further processing
     * when a critical mathematical error occurs during computation.
     *
     * @param e The ArithmeticException encountered.
     */
	private void logArithmeticException(ArithmeticException e) {
	    println("*** Error ***  ArithmeticException occurred : " + e.getMessage() + "\n" +
	            "**... ageMin: " + ageMin + "\n" +
	            "**... biomass: " + biomass + "\n" +
	            "**... freshweight: " + freshWeight + "\n" +
	            "**... sugarConcentration_fruit(last synced): " + sugarConcentration_fruit + "\n" +
	            "**... T: " + T + "\n" +
	            "**... H_a: " + H_a + "\n" +
	            "**... psi_x: " + psi_x + "\n" +
	            "**... Cpm(mol/L): " + Cpm + "\n" +
	            "**... Cpm_jf2_input(mol/cm3): " + lastInputCpmMolPerCm3 + "\n" +
	            "**... ro: " + ro);

}


	private void debugCheckAddedFruitPostCalc() {
		if (!(fruitAddDebug && printFlag)) return;
		if (!addFruitDebugPendingPostCalcCheck) return;

		try {
			Internode p = null;
			try { p = (Internode) getParent(); } catch (Throwable t0) { p = null; }
			boolean parentOk = (p != null)
				&& (addFruitDebugParentInternodeId <= 0 || p.nodeID == addFruitDebugParentInternodeId);

			FruitService tpl = null;
			if (addFruitDebugTemplateFruitId > 0) {
				try {
					tpl = first((* f:FruitService, (f.nodeID == addFruitDebugTemplateFruitId) *));
				} catch (Throwable t1) {
					tpl = null;
				}
			}

			println("[FruitPlanner/add/VF-check]"
				+ " fruitId=" + this.nodeID
				+ " parentInternodeId=" + (p != null ? String.valueOf(p.nodeID) : "null")
				+ " expectedParentInternodeId=" + addFruitDebugParentInternodeId
				+ " parentOk=" + parentOk
				+ " scFruit=" + sugarConcentration_fruit
				+ " FW=" + freshWeight
				+ " DW=" + biomass);

			if (!isFiniteVF(sugarConcentration_fruit) || sugarConcentration_fruit <= 0.0) {
				println("[FruitPlanner/add/VF-check] WARN non-positive sugarConcentration_fruit after sync for fruitId=" + this.nodeID);
			}

			if (tpl != null) {
				println("[FruitPlanner/add/VF-check/template]"
					+ " tplId=" + tpl.nodeID
					+ " scFruit_tpl=" + tpl.sugarConcentration_fruit
					+ " FW_tpl=" + tpl.freshWeight
					+ " DW_tpl=" + tpl.biomass
					+ " ageD_tpl=" + tpl.ageD
					+ " ageD_new=" + this.ageD);
			}
		} catch (Throwable t) {
			println("[FruitPlanner/add/VF-check] WARN post-calc check failed: " + t);
		}

		addFruitDebugPendingPostCalcCheck = false;
	}


	    /**
	     * Synchronizes outputs and writes JSON data to file.
	     * Ensures the results of the fruit model simulation are properly stored.
     */
		private void processOutput() {
			try {
				   output = this.getJsonValues();
				   syncOutputs(output);
				   debugCheckAddedFruitPostCalc();
				if (outputIndividualFruit) {
					if(this.nodeID <= 0 || this.outputFilePath == null) 
					{
					initOutputFilePath();
				}
				
				writeObjectNodeToCsv(output, this.outputFilePath, 2); // Start writing only at step 2 as data is not initialized beforehand
			}
		} catch (Exception e) {
			println("*** Error -- virtualFruit: Exception calling syncOutputs (possibly due to previous ArithmeticException) ***");
		}
	}
	

	/**
	 * Update each fruit within the simulation.
	 * Go through the following processes:
	 * - Parameter and file loading
	 * - Data processing and input conditions handling
	 * - Execution of stepwise calculations with error handling
	 * - Logging and debugging information
	 * - Synchronization of outputs and data storage
	 * - Iterative updates during the simulation cycle
	 *
	 *  It also handles:
	 * - Lazy initialization of fruit input data if not yet available (e.g., after deserialization and reloading from gsz).
	 * - Retrieval and processing of time-specific input from a preloaded JSON input dataset.
	 * If input data is missing during the first call (common after loading a `.gsz` file),
	 * the method reinitializes the data and skips numerical computations for that step.
	 */
	@Override
	void update() {
		// wiring (parent/plant base) as you already have...
		if (this.plantBaseID <= 0) {
			PlantBase pbq = first((* p0:PlantBase, (p0.plantNumber == this.plantNumber) *));
			if (pbq != null) this.plantBaseID = pbq.nodeID;
		}

		if (parentID <= 0) {
			GrowingOrgan parentOrgan = (GrowingOrgan) first((* this (<--)+ Internode*));
			if (parentOrgan != null) {
				this.parentID = parentOrgan.nodeID;
				parentOrgan.addChildFruitId(this.nodeID);
			}
		}

		if (!shouldRunVirtualFruitStep()) {
			super.update();
			syncAgeFromFruitClock();
			resetCarbonAllocationOffState();
			return;
		}
	
		// If file-backed mode and nothing loaded yet, load once and prefill
		if (inputVesselConditions && (inputNodeList == null || inputNodeList.isEmpty())) {
			println("⏳ Waiting for fruit input to be initialized...");
			initData(); // loads file only when inputVesselConditions==true
			
			JsonNode row = getFruitInput((int) this.ageD, hourOfDay);
			// Make sure ageMin is synced before processInput
			processInput(row);
			return;
		}
	
		// Advance organ-level time state
		super.update();
		
		// after super.update()
		syncAgeFromFruitClock();

		
		// --- derive FILE coordinates from the same organ clock ---
		int dOrgan  = (int) Math.floor(this.ageD);
		int fhOrgan = fileHourFromOrganClock();     // 1..24
		int hModel  = toModelHour(fhOrgan);         // 0..23

		// Always fetch input (from file or synthesized), then run
		// hourOfDay is 0..23 -> pass MODEL hour directly
		//println( this.ageD + " int ageD: " + (int) ageD);
		
		JsonNode row;
		if (inputVesselConditions) {
			// Read from CSV using the organ-driven index
			row = tryGetInput(dOrgan, fhOrgan, false);
			if (row == null) row = tryGetInput(dOrgan, fhOrgan, true);
			if (row == null) row = synthesizeInputNode(dOrgan, hModel); // last fallback
		} else {
			// Synthesis path: emit a row that matches organ time
			row = synthesizeInputNode(dOrgan, hModel);
		}
		
		if (row == null) { println("⚠️ No input JSON for ageD=" + dOrgan + ", fileHour=" + fhOrgan); return; }


		processInput(row);
		if (!delayExecutionFlag) {
			executeStepCalculation();
			if (stepRanOk) processOutput(); // never write a primed/zero row
		}
	}

} 
