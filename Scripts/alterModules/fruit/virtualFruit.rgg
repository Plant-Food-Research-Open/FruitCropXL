	public void loadParameters() {
			
		/** Set the context for file name parameters*/
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();

		
		/** Configuration context for fruit parameters */
		config.setCategoryContext("fruit");
		FRUIT_BEGIN   = FRUIT_AGE_AFTER_FULLBLOOM;
		km_pri        = config.getDouble("KM_PRI");

		//get the skin conductance parameters
		roMin		 = config.getDouble("roMin");
		roMax		 = config.getDouble("roMax");
		kro		 	 = config.getDouble("kro");
		coefRo		 = config.getDouble("coefRo");
		
		if (debug && printFlag) println( "fruit roMax " + roMax + " " +  kro + " " +  coefRo);
		
		config.setCategoryContext("leaf-water");
		//a list of parameters for the sensitivities of hydraulic conductance 
		//for generic parameter initiation
		growth_a	 = config.getDouble("growth_a", -10);
		growth_b	 = config.getDouble("growth_b", -0.5);
		
		

				
	}
	
	@Override
	FruitService initiate_pi(PlantIdentifier pi, float length_, float diameter_)
	{
		loadParameters();
		//IDENTIFIERS
		this.plantNumber = pi.plantNumber;
		this.border = pi.border;
		this.length = length_;
		this.diameter = diameter_;
		
		ageD = FRUIT_AGE_AFTER_FULLBLOOM; 
		ageHour = (int) ageD *24;
		ageMin = 60 * ageHour;
		double thermalDayUnit = OPT_TEMP == 0 ? 0.5 : (Tmax + Tmin) / 2 / OPT_TEMP;
		double degreeDayUnit = Math.min(1, ((Tmax + Tmin) / 2 - baseT));
		
		age = ageTd = ageD * thermalDayUnit; //Age in the main model is thermal time, assume the effective day is 0.6
		ageGdd = ageD * degreeDayUnit; 
		this.organType = "Fruit";
		initOutputFilePath();
		initOutputHeaders();
		
		return this;
	}
	
	@Override
	void initiate_pb(PlantBase pb, Internode N)
	{
		loadParameters();
		//IDENTIFIERS
		plantNumber = pb.plantNumber;
		border = pb.border;
		this.organType = "Fruit";
		this.plantBaseID = pb.nodeID;
		// Check if N is not null to prevent NullPointerException
		if (N != null) {
			this.ID = N.ID;
			this.order = N.order; 
			this.rank = N.rank;
			this.axis2ID = N.axis2ID; 
			this.axis3ID = N.axis3ID;
			this.axis4ID = N.axis4ID;
			this.axis5ID = N.axis5ID;
			this.axis6ID = N.axis6ID;
			this.cpn = axis2ID + axis3ID + axis4ID + axis5ID + axis6ID + rank;
			this.nodeNumber = N.nodeNumber; 
			this.cordonNumber = N.cordonNumber;
		} else {this.ID = 10000;}
		length = 1e-3;
		diameter = 1e-3; 	
		
		ageD = FRUIT_AGE_AFTER_FULLBLOOM; 
		ageHour = (int) ageD *24;
		ageMin = 60 * ageHour;
		double thermalDayUnit = OPT_TEMP == 0 ? 0.5 : (Tmax + Tmin) / 2 / OPT_TEMP;
		double degreeDayUnit = Math.min(1, ((Tmax + Tmin) / 2 - baseT));
		
		age = ageTd = ageD * thermalDayUnit; //Age in the main model is thermal time, assume the effective day is 0.6
		ageGdd = ageD * degreeDayUnit; 
		initOutputFilePath();
		initOutputHeaders();
	}
		
	/**
	 * Initiate from apex
	 */
	@Override
	void initiate_apex(ApexService a)
	{
		loadParameters();
		//IDENTIFIERS
		plantNumber = a.plantNumber;
		border = a.border;
		rank = a.rank;		
		order = a.order;                                                 
		nodeNumber = a.nodeNumber; 
		cordonNumber = a.cordonNumber;
				
		this.axis2ID = a.axis2ID; 
		this.axis3ID = a.axis3ID;
		this.axis4ID = a.axis4ID;
		this.axis5ID = a.axis5ID;
		this.axis6ID = a.axis6ID;
		this.cpn = axis2ID + axis3ID + axis4ID + axis5ID + axis6ID + rank;
		this.organType = "Fruit";
		
		length = 1e-4;
		diameter = 1e-3; 		
				
		ageD = FRUIT_BEGIN; 
		
		ageHour = (int) ageD *24;
		ageMin = 60 * ageHour;
		double thermalDayUnit = OPT_TEMP == 0 ? 0.5 : (Tmax + Tmin) / 2 / OPT_TEMP;
		double degreeDayUnit = Math.min(1, ((Tmax + Tmin) / 2 - baseT));
		
		age = ageTd = ageD * thermalDayUnit; //Age in the main model is thermal time, assume the effective day is 0.6
		ageGdd = ageD * degreeDayUnit; 
		initOutputFilePath();
		initOutputHeaders();
	}
	
	
	
	
	/**
	 * Converts the fruit's environmental and physiological parameters into an array format 
	 * and passes them to the virtual fruit model.
	 * <p>
	 * This method first calls the parent class's {@code fromArray} method to initialize the 
	 * standard properties. Then, it prepares an array of five values representing the fruit's 
	 * environmental and physiological conditions, ensuring that units are appropriately 
	 * converted before passing them to the {@code input} object.
	 * </p>
	 *
	 * <h3>Processing Steps:</h3>
	 * <ol>
	 *   <li>Calls {@code super.fromArray(ageMin, fruitRow)} to initialize standard parameters.</li>
	 *   <li>Creates a double array to store converted parameter values.</li>
	 *   <li>Assigns the values with necessary unit conversions:
	 *      <ul>
	 *          <li>Temperature (`T`) converted from Celsius to Kelvin.</li>
	 *          <li>Humidity (`H_a`) converted from percentage to a decimal fraction.</li>
	 *          <li>Water potential (`psi_x`) stored in bar as is.</li>
	 *          <li>Phloem sugar concentration (`Cpm`) converted from mol/dm³ to mol/dm³ by dividing by 1000.</li>
	 *          <li>Hydraulic conductance (`ro`) stored as is.</li>
	 *      </ul>
	 *   </li>
	 *   <li>Passes the formatted values to the virtual fruit simulation via {@code input.fromArray(ageMin, values)}.</li>
	 * </ol>
	 *
	 * @param ageMin   The minimum age of the fruit in minutes.
	 * @param fruitRow The JSON node containing fruit properties, extracted prior to this method.
	 */
 	@Override
	public void fromArray(int ageMin, JsonNode fruitRow) {
		updateInput(ageMin, fruitRow);
		
		//convert into array and passing to the virtual fruit model
		double[] values = new double[5];
		//feed JFruit2 via fromArray(...), you must pre-convert exactly what convertData()
		//as Input.convertData() (where T→K, h_a→0–1, cpm÷1000) is called only by Data.fromFile(...) 
		//Data.fromArray(...) does not call convertData().
		values[0] = (T > 200.0 ? T : T + 273.15);    //K
		values[1] = (H_a> 1.0) ? H_a / 100.0 : H_a;   //0-1
		values[2] = psi_x;		   //bar	
		double cpmInputMolPerL = Cpm;
		if (!isFiniteVF(cpmInputMolPerL) || cpmInputMolPerL <= 0.0) {
			// Compatibility guard: zero/negative cpm causes JFruit2 Growth.computeDerivatives() fatal cP errors.
			cpmInputMolPerL = VF_CPM_MIN_MOL_PER_L;
		}
		double cpmInputMolPerCm3 = cpmInputMolPerL / 1000.0;
		values[3] = cpmInputMolPerCm3;    //pass cpm in mol·cm⁻³ (mol·L⁻¹ / 1000), [mol sucre.dm-3 sève 0.05 - 0.53, divided by 1000 to convert into mol sucre.cm-3 sève 
		values[4] = ro;		   //cm/h  40- 370	
		lastInputCpmMolPerL = cpmInputMolPerL;
		lastInputCpmMolPerCm3 = cpmInputMolPerCm3;
		
		if (debug && printFlag) { println(Arrays.toString(values)); }
		//this is needed to passing the values to the virtual fruit
		if (input == null && jLaunch != null) {
			input = jLaunch.initInput(DELTA);
		}
		input.fromArray(ageMin, values);
	}
	
	
	/**
	 * Updates the input values for the fruit simulation based on the provided JSON node.
	 * <p>
	 * This method assigns environmental and physiological parameters either from the JSON input 
	 * (if {@code inputVesselConditions} is true) or through calculated/default values (if {@code inputVesselConditions} is false).
	 * Additionally, it performs conversions for key parameters, assigns default values to prevent errors,
	 * and includes a temporary solution to prevent ODE calculation errors.
	 * </p>
	 *
	 * <h3>Behavior:</h3>
	 * <ul>
	 *   <li>If {@code inputVesselConditions} is true, it loads values directly from the JSON node.</li>
	 *   <li>If {@code inputVesselConditions} is false, it calculates and assigns default values, including:
	 *     <ul>
	 *       <li>Estimating water potential if missing or invalid.</li>
	 *       <li>Converting carbon concentration to sucrose concentration.</li>
	 *       <li>Computing `ro` based on fruit age.</li>
	 *     </ul>
	 *   </li>
	 *   <li>Ensures values are not NaN, infinite, or invalid to maintain stability in the simulation.</li>
	 *   <li>Handles a special case where the organ growth method is "TempLimited".</li>
	 * </ul>
	 *
	 * @param ageMin   The minimum age in minutes.
	 * @param fruitRow A JSON node containing the following fruit properties:
	 *                 <ul>
	 *                     <li>{@code age_d} - Fruit age in days.</li>
	 *                     <li>{@code age_h} - Fruit age in hours.</li>
	 *                     <li>{@code T} - Temperature (Kelvin).</li>
	 *                     <li>{@code H_a} - Humidity level.</li>
	 *                     <li>{@code psi_x} - Water potential.</li>
	 *                     <li>{@code Cpm} - Phloem sucrose concentration.</li>
	 *                     <li>{@code rho} - Density.</li>
	 *                 </ul>
	 */
	@Override
	public void updateInput(int ageMin, JsonNode fruitRow) {
		Double Tm   = firstNum(fruitRow, new String[]{"T","t"});            // °C
		Double Ham  = firstNum(fruitRow, new String[]{"H_a","h_a","Ha"});   // %
		Double psim = firstNum(fruitRow, new String[]{"psi_x","Psi_x","psiX"});
		Double CpmM = firstNum(fruitRow, new String[]{"Cpm","cpm"});
		Double rom  = firstNum(fruitRow, new String[]{"ro","rho","Ro","Rho"});
	
		T     = (Tm  != null) ? Tm.doubleValue()   : 20.0;
		H_a   = (int) Math.max(0, Math.min(100, Math.round((Ham != null ? Ham.doubleValue() : 50.0))));
		psi_x = (psim!= null) ? psim.doubleValue() : -8.0;
		Cpm   = (CpmM!= null) ? CpmM.doubleValue() : 0.20;
		ro    = (rom != null) ? rom.doubleValue()  : roMin;
		
		if (Double.isNaN(T)    || Double.isInfinite(T))    T    = 20.0;
		if (Double.isNaN(psi_x)|| Double.isInfinite(psi_x)) psi_x = -8.0;
		if (Double.isNaN(Cpm)  || Double.isInfinite(Cpm))  Cpm   = 0.20;
		if (Double.isNaN(ro)   || Double.isInfinite(ro))   ro    = roMin;
		if (Cpm <= 0.0) Cpm = VF_CPM_MIN_MOL_PER_L;

	}
	
	// Java 1.5-friendly (raw types, Double.valueOf)
// Accept numbers OR numeric strings; Java 1.5 compatible (no generics; Double.valueOf)
private static Double firstNum(JsonNode row, String[] keys) {
    if (row == null) return null;
    for (int i = 0; i < keys.length; i++) {
        JsonNode v = row.get(keys[i]);
        if (v == null || v.isNull()) continue;

        // Already numeric?
        if (v.isNumber()) return Double.valueOf(v.asDouble());

        // Text node that looks like a number?
        if (v.isTextual()) {
            String s = v.asText();
            if (s != null) {
                s = s.trim();
                if (s.length() > 0) {
                    // guard for locales that might sneak in a comma
                    if (s.indexOf(',') >= 0) s = s.replace(',', '.');
                    try { return Double.valueOf(Double.parseDouble(s)); }
                    catch (NumberFormatException e) { /* ignore and check next key */ }
                }
            }
        }
    }
    return null;
}


	// Java 1.5-compatible helpers (no generics)
	private static double getNum(JsonNode row, String k, double dflt) {
		JsonNode v = row != null ? row.get(k) : null;
		return (v != null && v.isNumber()) ? v.asDouble() : dflt;
	}
	private static Double getNumMaybe(JsonNode row, String k) {
		JsonNode v = row != null ? row.get(k) : null;
		return (v != null && v.isNumber()) ? Double.valueOf(v.asDouble()) : null; // Double.valueOf for Java 1.5
	}


	
