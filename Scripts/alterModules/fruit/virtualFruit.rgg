	/**
	 * Initializes the first age_d and age_h from the list.
	 */
	private void initializeFirstAge() {
		if (inputNodeList != null && !inputNodeList.isEmpty()) {
			
			JsonNode firstEntry = (JsonNode) inputNodeList.get(0); // Fix: Use index 0 instead of 1
			println("DEBUG: First entry in INPUT FRUIT DATA " + firstEntry.toString());
			  
			firstAgeD = firstEntry.has("age_d") ? firstEntry.get("age_d").asInt() : -1;
			firstAgeH = firstEntry.has("age_h") ? firstEntry.get("age_h").asInt() : -1;
		
		}

	}
	
	/** for indicating the selected model functions as a bitwise combination
		Constants Defined with Hexadecimal Values
		NONE = 0: This constant represents a situation where no flags are set. It is zero in binary, meaning all bits are off.
		GROWTH = 0x01: This is represented as 0001 in binary (4 bits for simplicity). It sets the lowest bit to 1.
		SUGAR = 0x02: This is 0010 in binary. It sets the second lowest bit to 1.
		SUGAR2 = 0x04: This is 0100 in binary. It sets the third lowest bit to 1.
		CITRATE = 0x08: This is 1000 in binary. It sets the fourth lowest bit to 1.
		MALATE = 0x10: This is 1 0000 in binary (5 bits to show the fifth position). It sets the fifth lowest bit to 1. 
	*/
		/**
	 * Modèle actifs.
	 */
	public final static class Active {
		/**
		 * Constructeur privé qui interdit la création d'une instance de la classe.
		 */
		private Active() {
		}

		public static final int NONE = 0;
		public static final int GROWTH = 0x01;
		public static final int SUGAR = 0x02;
		public static final int SUGAR2 = 0x04;
		public static final int CITRATE = 0x08;
		public static final int MALATE = 0x10;
	}
	





    /**
     * Initialise the simulation context.
     */
    void initContext() {
    	
    	
        CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_MODEL_OPTIONS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();
		
		config.setFlattenedAccess(true);
  	
        FruitService.PARAMS = PATH_SCENARIOS + config.getString("virtualFruitParameter_file");
       
       if (jLaunch == null) {  // <- don't clobber a pre-wired jLaunch/ParametersFactory
        jLaunch = new ExtendedJLaunch();
		jLaunch.readProperties(FruitService.PARAMS);
	   }
		originalParametersFactory = jLaunch.getParamFct(); 
        
		//parametersFactory.print();
		active = originalParametersFactory.getJfruit2Param().getActive();
		
		input = jLaunch.initInput(DELTA);
		inputHeaders = input.getHeader();
		
		if(printFlag) {
			println(" active " + active);
			println("Fruit input Headers: " + Arrays.toString(inputHeaders));
			println(FruitService.PARAMS);
		}
		
		
		//if (printFlag) { println("FruitService.PARAMS " + FruitService.PARAMS); }
		config.setFlattenedAccess(false);	
		
		
    }
    
    

    /**
     * Initialise the fruit data for the simulation.
     */
	@Override
	void initData() {
		if (jLaunch == null) {
			initContext();
		}
	
		if (inputVesselConditions) {
			String csvPath = PATH_INPUT + virtualFruitModelInput_file;
	
			// Detect delimiter from the header line
			char sep = detectDelimiter(csvPath); // ';' or ','
			CsvMapper csvMapper = new CsvMapper();
			CsvSchema  csvSchema = CsvSchema.emptySchema().withHeader().withColumnSeparator(sep);
	
			inputNodeList = csvMapper.readerFor(JsonNode.class)
									 .with(csvSchema)
									 .readValues(new File(csvPath))
									 .readAll();
	
			// quick sanity
			if (inputNodeList != null && !inputNodeList.isEmpty()) {
				JsonNode head = (JsonNode) inputNodeList.get(0);
				println("DEBUG first row keys: " + head.fieldNames().next()); // will show real keys now
			}
			initializeFirstAge();  // now finds age_d / age_h
		} else {
			inputNodeList = null;
			if (firstAgeD == -1) firstAgeD = (int) this.ageD;
			if (firstAgeH == -1) firstAgeH = toFileHour(hourOfDay);
		}
	}
	
	// --- helper ---
	private static char detectDelimiter(String path) {
		BufferedReader br = null;
		try {
			br = new BufferedReader(new FileReader(path));
			String line = br.readLine();
			if (line != null) {
				if (line.indexOf(';') >= 0) return ';';
				if (line.indexOf(',') >= 0) return ',';
			}
		} catch (IOException e) {
			// ignore, fall through
		} finally {
			try { if (br != null) br.close(); } catch (IOException e) {}
		}
		return ';'; // your file clearly uses ';'
	}

    
    
