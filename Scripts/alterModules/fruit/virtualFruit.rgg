	@Override
	void calcRo(double ageD) {
		// If we’re driving vessel conditions from file, KEEP the CSV 'rho' untouched.
		if (inputVesselConditions) return;
	
		// otherwise use the logistic
		ro = Math.max(roMin, (roMax- roMin) / (1 + Math.exp(kro * (ageD - coefRo))) + roMin);
		
	  // println("roMax: " + roMax + " kro " + kro + " roMin " + roMin + "ageD" + ageD + "coefRo" + coefRo);
	  // if (printFlag) { println("ro" + ro); }
	  //roMax         kro      coefRo       roMin 
	  //450.8257928   0.4015518  23.4633682  36.6229140 
	}
  
  
	
