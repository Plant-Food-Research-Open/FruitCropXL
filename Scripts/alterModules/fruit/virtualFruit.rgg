/**  
 * The Virtual Fruit module, shell for the virtual fruit jar.
 * this class is designed to simulate fruit growth and development within the FruitCropXL framework.
 * It integrates various submodules for handling environmental inputs, growth processes, 
 * carbon and water transport, and output synchronization. 
 *
 * <h2>Key Functionalities:</h2>
 * <ul>
 *   <li><b>Parameter and File Loading:</b> Reads simulation parameters from configuration files 
 *       and initializes input data, including environmental conditions and fruit attributes.</li>
 *   <li><b>Data Processing:</b> Retrieves fruit data based on age and processes inputs dynamically 
 *       depending on vessel conditions. and then passing to the jLaunch through fromArrays function 
 *		 which calls the updateInput function to update the values if needed 
 * 		 input.fromArray(ageMin, values);</li>
 *   <li><b>Execution and Error Handling:</b> Computes growth parameters and handles exceptions 
 *       (e.g., arithmetic errors) to ensure robustness.</li>
 *   <li><b>Logging and Debugging:</b> Captures runtime details for debugging and analysis.</li>
 *   <li><b>Output Synchronization:</b> Stores computed values in JSON format and writes them 
 *       to an output file for further analysis.</li>
 *   <li><b>Iterative Simulation Updates:</b> Continuously updates fruit attributes through multiple 
 *       simulation steps, ensuring realistic growth dynamics.</li>
 * </ul>
 *
 * <h2>Implementation Highlights:</h2>
 * <ul>
 *   <li>Bitwise model selection using hex flags to toggle different simulation components.</li>
 *   <li>Integration with external libraries such as JFruit2 for model execution and configuration management.</li>
 *   <li>Dynamic fruit property initialization and modification, ensuring adaptability for different species.</li>
 *   <li>Real-time computation of physiological factors such as osmotic potential, turgor pressure, 
 *       and transpiration effects.</li>
 * </ul>
 *
 * This module serves as a key component within the FruitCropXL system, 
 * supporting detailed, flexible, and scalable fruit growth simulations.
 * pass model hour (0..23) into getFruitInput(..) and convert inside to file-hour for virtual fruit when needed.
 */
public module VirtualFruit extends FruitService {
	// Preserve compatibility with serialized GroIMP graphs in project storage.
	private static final long serialVersionUID = 7760587866344920309L;

	@Override
	void updateCarbonAllocation(double sugarConcentration) {
		calcPTCTRAM(sugarConcentration);
		calcLoading(sugarConcentration);
		calcLeakage(sugarConcentration);
		calcUnloading(sugarConcentration);
	}

