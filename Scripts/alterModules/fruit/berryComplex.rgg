	// Update all attributes of fruit without ODE
	void updateWithoutODE() {
		
		if(age >= 0) {
			calcDimensions();
			
			updateInput();
			//fractionOfSolubleSugar = 0.2783+0.4116*(1-0.987**ageHour);
						
			//growth stage and seed, and allocation parameters
			calcBerryGrowthStage();
			
			calcAllocationAmongHexoseAcids();
			//surface transpiration
			calcSurfaceArea();
			calcRo(this.ageD);
			calcTranspiration();
			//xylem and phloem hydraulic conductance and water potential
			calcWaterPotential_xylem();
			calcXylemHydraulicConductance();
			calcPhloemHydraulicConductance(); 
			calcOsmoticPotential_phloem(sugarConcentration_phloem);
			calcOsmoticPotential_furit();
			//membrane and cell wall 
			calcSigmap();
			calcCellWallExtensibility();
			calcVol();

			//turgor pressure
			calcTurgorPressure_fruit();
			//calcElasticity();
			//water uptake from xylem and phloem, sugar uptake from phloem
			caclWaterUptake_xylem();
			caclWaterUptake_phloem();
			calcUnloading(sugarConcentration_phloem);
			//update all state variables
			updateStateVariables();
			//if (printFlag) { println("Biomass: "+biomass + " sugar uptake: "+unloading); }
				
			//N balance
			nitrogen_total = biomass * Nm;
			nitrogen_structure = biomass * Nm_min; 
			nitrogen_nonStructure = nitrogen_total - nitrogen_structure;
			nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
			/* calcNdegradation();
			calcNSynthesis(); 
			nitrogen_total = nitrogen_structure + nitrogen_nonStructure; */
			initialized = true;
			
			//if (printFlag) { println( " fruit fresh Weight " + freshWeight + " biomass " + biomass ); }
		}
	}
	
	
	
	// @override
	@Override
	void update() {
		super.update();
		// If ODE used then update state only needs to be called in first step to set initial values
		//println("berry");
		/**searching and update state and pointer variables */
		if(this.plantBaseID <= 0) { this.plantBaseID = first((* p:PlantBase, (p.plantNumber == this.plantNumber)*)).nodeID;} 
		
		if (parentID <= 0) {  // Assuming 0 is an uninitialized ID
			GrowingOrgan parentOrgan = (GrowingOrgan) first((* this (<--)+ Internode*));
			if (parentOrgan != null) {
				this.parentID = parentOrgan.nodeID;
				parentOrgan.addChildFruitId(this.nodeID);
			}
		}
		
		updateWithoutODE();
		
		if(step > 1) {
			output = this.getJsonValues();
			syncOutputs(output);
			if(outputIndividualFruit == true) {
				writeObjectNodeToCsv(output, this.outputFilePath, 2); // Start writing only at step 2 as data is not initialized beforehand
			}
		}
	}

	@Override
	void initOutputFilePath() {
		if(outputIndividualFruit == true) {
			outputFilePath = PATH_OUTPUT + "P_" +plantNumber + "_F_" + this.ID  + ".output.csv";
			initializeOutputFile(outputFilePath);			
		}
	}
	

	@Override
	void initOutputHeaders() {
		outputHeader = new ArrayList();
		outputHeader.addAll(Arrays.asList(growthHeader));
	}
	
