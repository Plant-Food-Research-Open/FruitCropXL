	@Override
	public void loadParameters() {
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();

		config.setCategoryContext("fruit");
		FRUIT_BEGIN        = FRUIT_AGE_AFTER_FULLBLOOM;
		// Safeguard against undefined/null/NaN values of BERRY_AGE_AT_VERASION
		
		if (BERRY_AGE_AT_VERASION > 0 && FRUIT_AGE_AFTER_FULLBLOOM > 0) {
			ageD_afver = (double) (FRUIT_AGE_AFTER_FULLBLOOM - BERRY_AGE_AT_VERASION);
		} else {
			ageD_afver = 10 - BERRY_AGE_AT_VERASION;  // or another safe default, 10 days after flowering
			println("Warning: age is zero; t_afver defaulted to 10 - BERRY_AGE_AT_VERASION.");
		}
		//t_afver =  FRUIT_AGE_AFTER_FULLBLOOM - 
		//common parameters
		maintenanceCoff        = config.getDouble("MTNCE");
		growthCoff             = config.getDouble("GROWTHRQ");
		km_pri                 = config.getDouble("KM_PRI");
		km_sec = km_pri; 
		
		Cf_veraison		 = config.getDouble("Cf_veraison");
		sigmax		 = config.getDouble("sigmax");
		sigmaP0		 = config.getDouble("sigmaP0");
		ksip		 = config.getDouble("ksip");
		coefSip		 = config.getDouble("coefSip");
		permeability_sugar		 = config.getDouble("permeability_sugar");
		acnst		 = config.getDouble("acnst");
		Lpmin		 = config.getDouble("Lpmin");
		Lpmax		 = config.getDouble("Lpmax");
		Lpscale		 = config.getDouble("Lpscale");
		Lpstar		 = config.getDouble("Lpstar");
		Lxmin		 = config.getDouble("Lxmin");
		Lxmax		 = config.getDouble("Lxmax");
		Lxscale		 = config.getDouble("Lxscale");
		Lxstar		 = config.getDouble("Lxstar");
		el0		 = config.getDouble("el0");
		kel		 = config.getDouble("kel");
		Hf		 = config.getDouble("Hf");
		roMin		 = config.getDouble("roMin");
		roMax		 = config.getDouble("roMax");
		kro		 = config.getDouble("kro");
		coefRo		 = config.getDouble("coefRo");
		rwtr		 = config.getDouble("rwtr");
		phi0		 = config.getDouble("phi0");
		phiMax		 = config.getDouble("phiMax");
		phiMin		 = config.getDouble("phiMin");
		kPhi		 = config.getDouble("kPhi");
		coefPhi		 = config.getDouble("coefPhi");
		YC		 = config.getDouble("YC");
		Y0		 = config.getDouble("Y0");
		gamma	 = config.getDouble("gamma");
		eta		 = config.getDouble("eta");
		//empirical parameter for seed weight
		share1		 = config.getDouble("share1");
		share2		 = config.getDouble("share2");
		noysf1		 = config.getDouble("noysf1");
		noysf2		 = config.getDouble("noysf2");

		//carbon allocation within fruit		 
		kst_bv		 = config.getDouble("kst_bv");
		kss_bv		 = config.getDouble("kss_bv");
		koa_bv		 = config.getDouble("koa_bv");
		kmalic_bv		 = config.getDouble("kmalic_bv");
		ktartaric_bv		 = config.getDouble("ktartaric_bv");
		kothers_bv		 = config.getDouble("kothers_bv");
		DegradationRateMalic_bv		 = config.getDouble("DegradationRateMalic_bv");
		//after veraison		 
		kst_av		 = config.getDouble("kst_av");
		kss_av		 = config.getDouble("kss_av");
		koa_av		 = config.getDouble("koa_av");
		kmalic_av		 = config.getDouble("kmalic_av");
		ktartaric_av		 = config.getDouble("ktartaric_av");
		kothers_av		 = config.getDouble("kothers_av");
