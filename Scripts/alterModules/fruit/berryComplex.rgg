// module for the reproductive organ
// biomass of fruit was expressed in mg, but during calculation the unit of gram was used as in zhanwu's fruit model
// so at last, the unit need to be reversed into mg

/** COMPLEX grapevine BERRY module 
* 	this module uses mg as the unit
*   for fruit calculation, all water potential parts needs to converted from MPa to bar (1 bar = 0.1 MPa; needs * 10);
*/
public module BerryComplex extends FruitService implements Configurable,Serializable 
{
	@Override
	void updateCarbonAllocation(double sugarConcentration) {
		calcPTCTRAM(sugarConcentration);
		calcLoading(sugarConcentration);
		calcLeakage(sugarConcentration);
		calcUnloading(sugarConcentration);
	}
	
