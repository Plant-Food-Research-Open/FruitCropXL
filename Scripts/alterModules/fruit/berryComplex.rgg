	/**
	 * Computes effective fruit light area for complex berry bunch rendering.
	 * Uses bunch sphere proxy only in grapevine bunch mode; otherwise falls back to Afruit-derived area.
	 */
	@Override
	public double computeFruitLightArea_m2() {
		double defaultArea = (Afruit > 0) ? Afruit * 1e-4 : area;
		fruitBerryCountEffective = 1;

		boolean useBunchProxyArea = false;
		try {
			useBunchProxyArea = (fruitVisibility == true)
				&& "grapevine".equals(species)
				&& (special_scenario == null || !special_scenario.equals("berry_population"));
		} catch (RuntimeException e) {
			useBunchProxyArea = false; // compatibility fallback for legacy/scenario configs
		}
		if (useBunchProxyArea == false) {
			return defaultArea;
		}

		int nR = (numberOfRachis > 0) ? numberOfRachis : 1;
		int nB = (numberOfBranchtigs > 0) ? numberOfBranchtigs : 1;
		int nS = (numberOfSubtwigs > 0) ? numberOfSubtwigs : 1;
		int nP = (numberOfPedicles > 0) ? numberOfPedicles : 1;
		int berryCount = nR * nB * nS * nP;
		if (berryCount <= 0) {
			berryCount = 1;
		}

		// In GroIMP Sphere(r), input is radius. Keep same radius proxy as current bunch renderer.
		double sphereRadius = Math.min(brRatio, Math.max(1e-2, brRatio * biomass));
		if (Double.isNaN(sphereRadius) || Double.isInfinite(sphereRadius) || sphereRadius <= 1e-6) {
			sphereRadius = 1e-6;
		}

		double singleBerryArea = 4 * Math.PI * sphereRadius * sphereRadius;
		double totalArea = berryCount * singleBerryArea;
		if (Double.isNaN(totalArea) || Double.isInfinite(totalArea) || totalArea <= 0) {
			return defaultArea;
		}

		fruitBerryCountEffective = berryCount;
		return totalArea;
	}
	
