	/**
	 * Synchronise the output from JFruit2 output values to the state variables in the fruit module.
	 * 
	 * @param see the Abstractfruit module
	 */
	public void syncOutputs(ObjectNode node) {
		node.put("w", waterMass); //mgTogram;
		node.put("s", biomass); //mgTogram;
		
		node.put("pip", osmoticWaterPotential_phloem);
		node.put("piv", osmoticWaterPotential_vascular);
		node.put("pif", osmoticWaterPotential_fruit);
	
		node.put("pp", turgorPressure_phloem);
		node.put("pv", turgorPressure_vascular);
		node.put("pf", turgorPressure_fruit);
	
		node.put("sfstone", seedDryWeight); //mgTogram;
		node.put("af", Afruit);
		node.put("ctcs", sugarConcentrationMole_fruit);
	
			
		node.put("tf", transpirationMass);
		node.put("cv", sucroseConcentration_vascular);
		node.put("ua", sugarUptake_active);
	
		node.put("ux1", waterUptake_vascular_xylem);
		node.put("up1", waterUptake_vascular_phloem);
	
		node.put("khx", Lxylem);
		node.put("khp", Lphloem);
	
		node.put("ux", waterUptake_xylem);
		node.put("up", waterUptake_phloem);
	
		node.put("masfls", sugarUptake_massflow);
		node.put("pasfls", sugarUptake_passive);
	
		node.put("rM", maintenanceDM);
		node.put("rG", growthCost);
	
		node.put("pf1", pf1);
		node.put("pf2", pf2);
			
		node.put("v", vol);
	}
	

