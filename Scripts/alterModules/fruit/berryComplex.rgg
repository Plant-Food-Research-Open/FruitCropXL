	@Override
	void initData() {}
	
	@Override
	FruitService initiate_pi(PlantIdentifier pi, float length_, float diameter_)
	{
		loadParameters();
		//IDENTIFIERS
		if(plantBaseID <= 0) {
			PlantBase pb = first((* this (<--)+ PlantBase*));
			if(pb != null) {
				this.plantBaseID = pb.getId();
			}
		}
		plantNumber = pi.plantNumber;
		border = pi.border;
		length = length_;
		diameter = diameter_;
		//need a more specific input from the data
		ageD = FRUIT_AGE_AFTER_FULLBLOOM;
		ageGdd = FRUIT_AGE_AFTER_FULLBLOOM * (REFTMP - baseT);
		//assume that the mean daily temperature is 0.6 of a optimal day. Not used in current calculation.
		age =  FRUIT_AGE_AFTER_FULLBLOOM * 0.6; 
		ageHour = (int) ageD *24;
		
		this.organType = "Fruit";
		FruitService.veraison = true;
		berryNum = berryNumPerBunch;
			
	/* 	Lpmax = coefLpmax * FRUIT_FRESH_WEIGHT;
		Lpstar= coefLpstar * FRUIT_FRESH_WEIGHT;
		
		Lxmax = coefLxmax * FRUIT_FRESH_WEIGHT;
		Lxstar= coefLxstar* FRUIT_FRESH_WEIGHT; */
		//SPECIFIC PARAMETERS TO COMMON PARAMETERS
		//STATE VARIABLES
		//CARBON
		seedDryWeight = SEED_FRESH_MASS * 0.5;
		biomass = FRUIT_DRY_WEIGHT; // - seedDryWeight;  //HERE the dry mass of the fruit does not include the seed, so it is just the mass of the pulp  
		sugarConcentration_fruit = CONENTRATION_SOLUBLE_SUGAR;
		waterMass = FRUIT_FRESH_WEIGHT - biomass;// - SEED_FRESH_MASS;  
		freshWeight = waterMass + biomass; 
		
		//Acid concentration
		malicConcentration_fruit = CONENTRATION_MALIC_INITIAL;  //0.016 #0.0048  # fruit set ~0.0048 g/gh20  veraison ~0.02 g/gh20
		tartaricConcentration_fruit = CONENTRATION_TARTARIC_INITIAL; //0.01 #0.015  # fruit set ~0.015 g/gh20  veraison ~0.017 g/gh20
	
		solubleSugar = sugarConcentration_fruit * freshWeight;
		malicAcid    = malicConcentration_fruit * freshWeight;
		tartaricAcid = tartaricConcentration_fruit * freshWeight;
		structuralBiomass = biomass - solubleSugar - malicAcid - tartaricAcid + seedDryWeight;
  		freshWeight = waterMass + biomass; 
		carbon_total = biomass * CARBON_FRACTION_GLUCOSE;
		waterContent = waterMass/freshWeight; //WATER_CONTENT_BERRY;  //pulp
	
	  	//NITROGEN		
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total - nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		//UPDATE STATE VARIABLES
		calcAllocationAmongHexoseAcids();
		calcSurfaceArea();
		calcCellWallExtensibility();
		calcPhloemHydraulicConductance();
		calcOsmoticPotential_furit();
		Ka = 1;
		length = 1;
		//GENERATE RANDOM RACHIS LENGTH
		for(int i:(0:berryNumPerBunch-1)) {
		rachiesLength[i] = lognormal(lengthOfRachis_u, lengthOfRachis_sigma);
		}
		
		calcDimensions();
		
		elasticModulus = el0;
		turgorPressure_fruit = YC;
		initialized = true;
		
		//if (printFlag) { println("Vmax_berry" + Vmax_berry + " freshWeight " + freshWeight + " biomass " + biomass ); }

		initOutputFilePath();
		initOutputHeaders();
		return this;
	}
	
	// bunch initiation at veraison
	@Override
	void initiate_pb(PlantBase pb, int Rank_, int NodeNumber_, int CordonNumber_)
	{
		
		loadParameters();
		//IDENTIFIERS
		plantBaseID = pb.nodeID;
		plantNumber = pb.plantNumber;
		rank = Rank_;
		cpn = rank;
		nodeNumber = NodeNumber_; 
		cordonNumber = CordonNumber_;
		border = pb.border;
			//need a more specific input from the data
		ageD = FRUIT_BEGIN;
		ageGdd = (ageD + hourOfDay/24) * ((Tmax+Tmin)/2 - baseT);
		//assume that the mean daily temperature is 0.6 of a optimal day. Not used in current calculation.
		age =  (ageD + hourOfDay/24) * (Tmax+Tmin)/2/OPT_TEMP; 
		ageHour = (int) ageD *24 + hourOfDay;
		
		FruitService.veraison = true;
		this.organType = "Fruit";
		
		berryNum = berryNumPerBunch;
		
		//SPECIFIC PARAMETERS TO COMMON PARAMETERS
		//STATE VARIABLES
		//CARBON
		seedDryWeight = SEED_FRESH_MASS * 0.5;
		biomass = FRUIT_DRY_WEIGHT - seedDryWeight;  //HERE the dry mass of the fruit does not include the seed, so it is just the mass of the pulp  
		sugarConcentration_fruit = CONENTRATION_SOLUBLE_SUGAR;
		waterMass = FRUIT_FRESH_WEIGHT - biomass - SEED_FRESH_MASS;
		 
		freshWeight = waterMass + biomass;
		
		//Acid concentration
		malicConcentration_fruit = CONENTRATION_MALIC_INITIAL;  //0.016 #0.0048  # fruit set ~0.0048 g/gh20  veraison ~0.02 g/gh20
		tartaricConcentration_fruit = CONENTRATION_TARTARIC_INITIAL; //0.01 #0.015  # fruit set ~0.015 g/gh20  veraison ~0.017 g/gh20
	
		solubleSugar = sugarConcentration_fruit * waterMass;
		malicAcid    = malicConcentration_fruit * waterMass;
		tartaricAcid = tartaricConcentration_fruit * waterMass;
		structuralBiomass = biomass - solubleSugar - malicAcid - tartaricAcid + seedDryWeight;
  		freshWeight = waterMass + biomass; 
		carbon_total = biomass * CARBON_FRACTION_GLUCOSE;
		waterContent = waterMass/freshWeight; //WATER_CONTENT_BERRY;  //pulp
		
		if (printFlag) { 
			println("Berries per bunch = "+ berryNum);
			/* println("freshWeight = "+ freshWeight); */
			println("fruit biomass = "+ biomass);
			println("solubleSugar = "+ solubleSugar); 
		
		}
		/* println("sugarConcentration_fruit " + sugarConcentration_fruit + 
				" solubleSugar " + solubleSugar/freshWeight ); */
				
		//NITROGEN		
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total - nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		//UPDATE STATE VARIABLES
		calcAllocationAmongHexoseAcids();
		calcSurfaceArea();
		calcCellWallExtensibility();
		calcPhloemHydraulicConductance();
		calcOsmoticPotential_furit();
		calcBerryGrowthStage();
		Ka = 1;
		length = 0.005;
		diameter = 0.005;
		//GENERATE RANDOM RACHIS LENGTH
		for(int i:(0:berryNumPerBunch-1)) {
		rachiesLength[i] = lognormal(lengthOfRachis_u, lengthOfRachis_sigma);
		}
		
		calcDimensions();
		
		elasticModulus = el0;
		turgorPressure_fruit = YC;
		initialized = true;
		
		//if (printFlag) { println("Vmax_berry" + Vmax_berry + " freshWeight " + freshWeight + " biomass " + biomass ); }

		initOutputFilePath();
		initOutputHeaders();
	}
	
	// bunch initiation at flowering/fruitset
	@Override
	void initiate_pb_fruitset(PlantBase pb, int j, int k, int l)
	{
		loadParameters();
		//IDENTIFIERS
		plantBaseID = pb.nodeID;
		plantNumber = pb.plantNumber;
		rank = j;
		cpn = rank;
		nodeNumber = k; 
		cordonNumber = l;
		border = pb.border;
		
		FruitService.veraison = false;
		this.organType = "Fruit";
		ageD = 7; 
		age =  ageD * 0.6; //assume the effective day is 0.6 
		ageHour = (int) ageD *24;
		ageGdd = age; 
		length = 1e-2;
		berryNum = berryNumPerBunch;
	
		//STATE VARIABLES
		//CARBON
		seedDryWeight =  0.017/2;
		SEED_FRESH_MASS = noysf1 + noysf2 * seedDryWeight;
		biomass = 20.6/2;  //HERE the dry mass of the fruit does not include the seed, so it is just the mass of the pulp  
		sugarConcentration_fruit =  0.0045;
		waterMass = 180/2 - biomass;
		sugarConcentration_fruit = 0.0045; // 0.0365 #0.0045 # fruit set  ~0.0045 g/gh20  veraison ~0.0135 g/gh20
		malicConcentration_fruit = 0.0048;  //0.016 #0.0048  # fruit set ~0.0048 g/gh20  veraison ~0.02 g/gh20
		tartaricConcentration_fruit = 0.015; //0.01 #0.015  # fruit set ~0.015 g/gh20  veraison ~0.017 g/gh20
		
		solubleSugar = sugarConcentration_fruit * waterMass;
		malicAcid    = malicConcentration_fruit * waterMass;
		tartaricAcid = tartaricConcentration_fruit * waterMass;
		structuralBiomass = biomass - solubleSugar - malicAcid - tartaricAcid + seedDryWeight;
  		freshWeight = waterMass + biomass; 
		carbon_total = biomass * CARBON_FRACTION_GLUCOSE;
		waterContent = waterMass/freshWeight; //WATER_CONTENT_BERRY;  //pulp
		
		//NITROGEN		
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total - nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		//UPDATE STATE VARIABLES
		calcAllocationAmongHexoseAcids();
		calcSurfaceArea();
		calcCellWallExtensibility();
		calcPhloemHydraulicConductance();
		calcOsmoticPotential_furit();
		Ka = 1; //add a fake ka
		length = 0.005;
		//GENERATE RANDOM RACHIS LENGTH
		for(int i:(0:berryNumPerBunch-1)) {
		rachiesLength[i] = lognormal(lengthOfRachis_u, lengthOfRachis_sigma);
		}
		calcDimensions();
		elasticModulus = el0;
		turgorPressure_fruit = YC;
		initialized = true;
		//if (printFlag) { println("Vmax_berry" + Vmax_berry + " freshWeight " + freshWeight + " biomass " + biomass ); }

		initOutputFilePath();
		initOutputHeaders();
	}
	
	
	@Override
	void initiate_apex(ApexService a)
	{
		loadParameters();
		//IDENTIFIERS
		if(plantBaseID <= 0) {
			PlantBase pb = first((* this (<--)+ PlantBase*));
			if(pb != null) {
				this.plantBaseID = pb.getId();
			}
		}
		plantNumber = a.plantNumber;
		border = a.border;
		rank = a.rank;
		nodeNumber = a.nodeNumber; 
		cordonNumber = a.cordonNumber;
		cpn = a.cpn + 1;
		order = a.order;
		
		FruitService.veraison = false;
		age = -thermalDay_BB_FS;   //use a negative age. It will start grow when flowering happens.  
		ageHour = 120;
		ageGdd = 5; 
		length = 1e-3;
		
		//CARBON
		seedDryWeight =  0.017/2;
		SEED_FRESH_MASS = noysf1 + noysf2 * seedDryWeight;
		biomass = 20.6/2;  //HERE the dry mass of the fruit does not include the seed, so it is just the mass of the pulp  
		sugarConcentration_fruit =  0.0045;
		waterMass = 180/2 - biomass;
		sugarConcentration_fruit = 0.0045; // 0.0365 #0.0045 # fruit set  ~0.0045 g/gh20  veraison ~0.0135 g/gh20
		malicConcentration_fruit = 0.0048;  //0.016 #0.0048  # fruit set ~0.0048 g/gh20  veraison ~0.02 g/gh20
		tartaricConcentration_fruit = 0.015; //0.01 #0.015  # fruit set ~0.015 g/gh20  veraison ~0.017 g/gh20
		
		solubleSugar = sugarConcentration_fruit * waterMass;
		malicAcid    = malicConcentration_fruit * waterMass;
		tartaricAcid = tartaricConcentration_fruit * waterMass;
		structuralBiomass = biomass - solubleSugar - malicAcid - tartaricAcid + seedDryWeight;
  		freshWeight = waterMass + biomass; 
		carbon_total = biomass * CARBON_FRACTION_GLUCOSE;
		waterContent = waterMass/freshWeight; //WATER_CONTENT_BERRY;  //pulp
		
		//NITROGEN		
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total - nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		
		elasticModulus = el0;
		
		turgorPressure_fruit = YC;
		initialized = false;
		
		if (usePhenology == true) {
			phenologyStage = 1;
			double bunchesPerShoot = a.bunchesPerShoot;
			float berriesPerBunch = getBerriesPerBunch(a);
			//because sometimes for saving running time, we start at budburst
			//thus the berryYield module is not completed executed
			if(Double.isNaN(bunchesPerShoot) || Double.isNaN(berriesPerBunch))
			{	
				//for convinence the direct input of fruit number already consider how to deal with
				//bunches per shoot and fruit number per bunch by taking an integer of it
				berryNum = berryNumPerBunch;	
			} else {			
				berryNum = (int) Math.round(berriesPerBunch * bunchesPerShoot);
			}
			tmaxBM_apex = a.accumulatedTmaxBM / a.tmaxDaysBM;
			rainfallBM_apex = a.accumulatedRainfallBM;
			radBM_apex = a.accumulatedRadBM / a.radHoursBM;
			carbonBM_apex = a.accumulatedCarbonBM / a.carbonHoursBM;
			
			if (printFlag) { println("Bunches per shoot = "+ bunchesPerShoot); }
			if (printFlag) { println("Berries per bunch = "+ berryNum); }
		}
			
		//UPDATE STATE VARIABLES
		calcAllocationAmongHexoseAcids();
		calcSurfaceArea();
		calcCellWallExtensibility();
		calcPhloemHydraulicConductance();
		calcOsmoticPotential_furit();
		Ka = 1; //add a fake ka
		//GENERATE RANDOM RACHIS LENGTH
		for(int i:(0:berryNumPerBunch-1)) {
		rachiesLength[i] = lognormal(lengthOfRachis_u, lengthOfRachis_sigma);
		}
		calcDimensions();

		initOutputFilePath();
		initOutputHeaders();
	}
	 
	
	
	
	void calcDimensions()
	{
	   if(age > 0) {
		for(int i:(0:berryNumPerBunch-1)) {
		   rachiesLengthDynamic[i] = rachiesLength[i]*betaGrowthFunction(age, 0.5 * phenology.VERAISON_TARGET, phenology.VERAISON_TARGET);		
		}
		 radiusDyn  = Math.max(1e-3, radius*betaGrowthFunction(age, 0.5 * phenology.VERAISON_TARGET, phenology.VERAISON_TARGET));
	}
	}
	
	// calculate organ age
   @Override
	void calcAge() 
	{
		//confounded by the original fruit model, here ageD is using in some calculation
		age_pre = age;
		age = age + DT * wangEngelTempFunction(Ta, MIN_TEMP, OPT_TEMP, MAX_TEMP,REFTMP);
		
		if(age > 0) {
			ageHour++;
			ageD =ageD + DT;
			ageD_afver = ageD_afver + DT; 
			//agePrevious = age;	
			ageGdd += (Ta-baseT)*DT;
			//devAge += specificGrowthRate(TAU, Ta)*DT;
		}
	}
	
	
	//update input for the fruit module
	//Input is considered separately from load parameters
@Override
void updateInput() 
{
	if(inputVesselConditions == true) 
	{
		this.ageD = berryModelInput[step][0];
		this.ageHour = (int)(this.ageD)*24 + (int) berryModelInput[step][1];
		Ta = berryModelInput[step][2];  //This is a global parameters
		rh = berryModelInput[step][3];  //This is a global parameters
		this.sugarConcentration_phloem = berryModelInput[step][4];  
		this.waterPotential_xylem = berryModelInput[step][5] * 10;  //convert from MPa to bar
		age = ageD * 0.8;
	}
	
	if(inputVesselConditions == false) 
	{
		
		
		if(plantBaseID <= 0) {
			PlantBase pb = first((* this (<--)+ PlantBase*));
			if(pb != null) {
				this.plantBaseID = pb.getId();
			}
	   }
	
	  if (parentID <= 0) {  // Assuming 0 is an uninitialized ID
		GrowingOrgan parentOrgan = (GrowingOrgan) first((* this (<--)+ Internode*));
		if (parentOrgan != null) {
			storeParentId(parentOrgan);
			//this is based on the organ type of the current organ
			parentOrgan.addChildFruitId(this.nodeID);
			
		}
	}
	
		//FineRoot rt = first((*fr:FineRoot, (fr.plantNumber == this.plantNumber)*));
		waterPotential_xylem =  parentID > 0 ? getParent().waterPotential * 10 : -1.0; //convert from MPa to bar 
		//waterPotential_xylem = rt.xylemWaterPotential* 10; //in the fruit part, we use bar
		
		if(useCTRAM == false) {
			sugarConcentration_phloem = getPlantBase().sugarConcentration_phloem;			
		} else if(useCTRAM == true) {
			sugarConcentration_phloem = sugarFromCp(this.cpt);
		} else {
			sugarConcentration_phloem = 1e-4;
			// optional debug
		}
	} 
		
}
	
	
	

	  /* OVERALL FUNCTIONS TO CALCULATE CARBON DEMNAD */
	@Override
	void calcPTCTRAM(double sugarConcentration_phloem_input) 
	{   
		//need to fix this, the int[0] should be replaced by findinternode id
		
		
		updateInput();
		this.sugarConcentration_phloem = sugarConcentration_phloem_input;
		//assign active as primary, mass flow as secondary
		//growth stage and seed, and allocation parameters
		calcBerryGrowthStage();
        calcAllocationAmongHexoseAcids();
		//surface transpiration
		calcSurfaceArea();
        calcRo(this.ageD);
        calcTranspiration();
	    //xylem and phloem hydraulic conductance and water potential
		calcWaterPotential_xylem();
		calcXylemHydraulicConductance();
		calcPhloemHydraulicConductance(); 
		calcOsmoticPotential_phloem(sugarConcentration_phloem_input);
		calcOsmoticPotential_furit();
		//membrane and cell wall 
	    calcSigmap();
	    calcCellWallExtensibility();
	    calcVol();
		caclSugarUptake_active(sugarConcentration_phloem_input);
		
		//calcElasticity();
		//water uptake from xylem and phloem, sugar uptake from phloem
		caclWaterUptake_xylem();
		caclWaterUptake_phloem();
				
		structureDM_PRI_PT = berryNum * caclSugarUptake_active_CTRAM() * CARBON_FRACTION_SUCROSE/mgTogram;  //potential uptake without km limitation
		structureDM_SEC_PT = berryNum * max(0, (1.0-sigmap) * waterUptake_phloem *(sugarConcentration_phloem_input))* CARBON_FRACTION_SUCROSE/mgTogram; 
		
		//assume after veraison all maintenanceDM is satisfied by malic acid degradation 
		if(FruitService.veraison == false) {    
			maintenanceDM_PT = berryNum*calcMaintanceRespiration(0.3);
		} else
		{	maintenanceDM_PT = 0;}
		
		reserveDM_PT = 0;
		
		loading_PT =  0; 
		//if (printFlag) { println("sugarUptake_active " + structureDM_PRI_PT); }
		//if (printFlag) { println(structureDM_PRI_PT+structureDM_SEC_PT+maintenanceDM_PT); }
	}
	
	@Override
	void calcLeakage(double sugarConcentration_phloem_input) 
	{ //leakage only calculates for shoot, leaf is zero
		leakage = 0;
	}	
	@Override
	void calcLoading(double sugarConcentration_phloem_input)
	{
		loading =  0;
	}
	
	@Override
	  double caclSugarUptake_active_CTRAM() {
		 //unit is gram
		//g sucrose/h
		sugarUptake_active = biomass * mgTogram * Vmax_berry / (
								1+ Math.exp((ageHour-Cstar)/Cscale));
		 // if (printFlag) { println("sugarUptake_active " + sugarUptake_active); }
		 return(sugarUptake_active);
	   }
 
   // three pathway of sucrose uptake
   void caclSugarUptake_active(double sugarConcentration_phloem_input) {
	//sugarUptake_active = biomass * mgTogram * Vmax_berry_zhanwu * sugarConcentration_phloem / ((km_pri + sugarConcentration_phloem)*(1+exp((ageHour - tstar)/tau)));
	//g sucrose/h
	//for consistent with all other KM values, KM_BERRY was refer to carbon concentration
	/* float Cstar = 1700;
	float Cscale = 150; */
	double constrains_age = 1/(1+ Math.exp((ageHour-Cstar)/Cscale)); 
	//println("constrains:" + constrains);
	//double constrains_sugar = 1/((1+ Math.exp((sugarConcentration_fruit - Cstar)*Cscale)));
	//double constrains = Math.min(constrains_age, constrains_sugar);
	
	sugarUptake_active = sinkUnloading(sugarConcentration_phloem_input, km_pri) * 
						 biomass * mgTogram * Vmax_berry * constrains_age;
						
	//1/(1+exp((t-tStar)/tauA))						
	//if (printFlag) { println("sugarUptake_active " + sugarUptake_active + "sugarConcentration_phloem " + sugarConcentration_phloem ); }
	  
	}
 
    void caclSugarUptake_passive() {
		sugarUptake_passive = 0; //min(0, Axylem * permeability_sugar * (sugarConcentration_phloem - sugarConcentration_fruit)); //g sucrose/h
	}
	
	void caclSugarUptake_massflow(double sugarConcentration_phloem_input) {
		//sugarConcentration_phloem = sugarConcentration_phloem / CARBON_FRACTION_SUCROSE;
		//sugarUptake_massflow = (1.0-sigma) * waterUptake_phloem * (sugarConcentration_fruit + sugarConcentration_phloem)*0.5;
		sugarUptake_massflow = max(0, (1.0-sigmap) * waterUptake_phloem * (sugarConcentration_fruit + sugarConcentration_phloem_input)*0.5); // as phloem carbon concentration is far less than fruit
																							// when adding the furit sugar concentration, sometimes it causes unblances in carbon
		//println("sugarUptake_massflow " + sugarUptake_massflow);																						//as mysterious carbon comes;
	}
	
	
	
	@Override	
	void calcUnloading(double sugarConcentration_phloem_input) {
		 this.sugarConcentration_phloem = sugarConcentration_phloem_input;
		 caclSugarUptake_active(sugarConcentration_phloem_input); //unit is gram
		 caclSugarUptake_passive(); //unit is gram
		 caclSugarUptake_massflow(sugarConcentration_phloem_input); //unit is gram
		 //assume after veraison all maintenanceDM is satisfied by malic acid degradation 
		if(FruitService.veraison == false) {    
		   maintenanceDM = calcMaintanceRespiration(sugarConcentration_fruit) * 
         				sinkUnloading(sugarConcentration_phloem_input, KM_MTNCE);
		} else { 
			maintenanceDM = 0;
		}
		
		 //converted to mg c, in agree with other parts
		 //unloading needs to be expressed in mg carbon in fruit as we need to link with other components in order to calculate phloem
		 //CARBON concentration, we can not completely change the unit into carbon, as sucrose concentration needed in the osmotic calculation
		 unloadingPerFruit = maintenanceDM + CARBON_FRACTION_SUCROSE * 
		 (sugarUptake_active + sugarUptake_passive + sugarUptake_massflow)/mgTogram; 
		 unloading  = unloadingPerFruit * berryNum;  //unloading per bunch
		 structureDM = (1 - kss)*unloading;  //just add this to make the growth cost calculation easier. 
		 //return unloading;
		 //if (printFlag) { println("sugarUptake_active " + sugarUptake_active + " sugarUptake_massflow " + sugarUptake_massflow ); }
		 //if (printFlag) { println("unloading " + unloading +  " unloadingPerFruit " + unloadingPerFruit + " sugarConcentration_phloem " + sugarConcentration_phloem); }
	 }
	
  //******************************************************************************/
  // growth stage update
  //******************************************************************************/
   void calcBerryGrowthStage() 
  {
   //based on Bobeica and Rob Agnew's data Brix = 5 or soluble sugar around 0.0135 is veraison on individual fruit
    if(FruitService.veraison == false && (sugarConcentration_fruit >= Cf_veraison | age >=  phenology.VERAISON_TARGET )) 
		FruitService.veraison = true;    
  }
  
 
  
  //need to be updated, has been included in parameter reading, but later we can use this function to include the temperature effect
  void calcAllocationAmongHexoseAcids() 
  {
   if(FruitService.veraison == false) { //later add the effects of age and temperature on the allocation based on the kliewer data
     kst = kst_bv;
	 koa = koa_bv;
     kss = 1- koa_bv;
     kmalic = koa_bv * kmalic_bv;
     ktartaric = koa_bv * ktartaric_bv;
     kothers = koa_bv * kothers_bv;
     DegradationRateMalic = DegradationRateMalic_bv;
    }
    if(FruitService.veraison == true) { //later add the effects of age and temperature on the allocation based on the kliewer data
     kst = kst_av;
	 koa = koa_av;
     kss = 1- koa_av;
     kmalic = koa_av * kmalic_av;
     ktartaric = koa_av * ktartaric_av;
     kothers = koa_av * kothers_av;
     DegradationRateMalic = DegradationRateMalic_av;
    
     
    }
    //if (printFlag) { println("DegradationRateMalic " + "" + DegradationRateMalic); }
  }
	
  //******************************************************************************/
  // surface conductance and transpiration
  //******************************************************************************/
	void calcSurfaceArea() {
		double TotalWeight = waterMass + biomass + SEED_FRESH_MASS;
		
		Afruit = gamma*(TotalWeight * mgTogram)**eta;
		Axylem = Afruit * acnst;
		Aphloem = Axylem;
	}
	 
  //calculate skin conductance
  @Override
  void calcRo(double ageD) {
  	   //based on fruit age
       ro = Math.max(roMin, roMax/(1+exp(kro *(ageD_afver - coefRo))) + roMin);
      // if (printFlag) { println("ro" + ro); }
  	  //calculate with fresh weight, need to change the parameters kro = -1.67 coefRo = 34.2
  	  //ro = Math.max(roMin, roMin + roMax * exp(kro*(freshWeight + SEED_FRESH_MASS)*mgTogram));
  	  // return(roMax/(1+exp(kRo*(FFW-coefRo)))+roMin)     #3 [cm.h-1]  Conductance Fruit
      //ro = roMax/(1+exp(kro *(ageD - coefRo))) + roMin; 
  }
  
  
  void calcTranspiration() {
	  double Pstar = 0.00804817*exp(0.0546961*(Ta)); // partial pressure of water in fruit
	  double alfa = MOL_H2O * Pstar /(Rberry * (Ta+273.15)); 
	  	   
     if(berrySkinTranspiration == true) { transpirationMass = ro * alfa * Afruit * (Hf - rh);}
	 //if (printFlag) { println("transpirationMass" + transpirationMass); }
	 if(berrySkinTranspiration == false) { transpirationMass = 0;}
	  
	}
	
  //******************************************************************************/
  // xylem phloem conductance, water and osmotic potential, and fruit osmotic potential
  //******************************************************************************/
	void calcWaterPotential_xylem() 
	{
		
		turgorPressure_xylem = waterPotential_xylem; 
	    waterPotential_phloem = waterPotential_xylem;
	}
   void calcXylemHydraulicConductance()
   {
     /* calculate xylem conductivity by water mass */
    /* Lxylem  = Lxmin+(Lxmax-Lxmin)/(1+ Math.exp(Lxscale*(
				(waterMass + biomass + SEED_FRESH_MASS)*mgTogram - Lxstar))); */
	 
	 Lxylem = Lxmin + (Lxmax - Lxmin)/(1 + Math.exp(Lxscale*(ageD_afver -Lxstar)));				
	/* println("Lxmax " + Lxmax + " Lxylem " + Lxylem + 
			"weight" + (waterMass + biomass + SEED_FRESH_MASS)*mgTogram+
			" Lxscale " + Lxscale +
			" Lxstar" + Lxstar); */
	
  }
  void calcPhloemHydraulicConductance() {
		/* calculate phloem conductivity based on agehour after veraison */
		//Lphloem  = Lpmin+(Lpmax-Lpmin)/(1+exp(Lk*(ageHour - Lh)));	
		/* calculate phloem conductivity by water mass */
		//float constrains = (1+Math.exp(Lpscale*((waterMass + biomass + SEED_FRESH_MASS)*mgTogram - Lpstar)));
		/* Lpscale = 0.09;
		Lpstar = -4; 
		float constrains = (1+exp(Lpscale * (ageHour/24 -Lpstar))); */
		
		Lphloem  = Lpmin+(Lpmax-Lpmin)/(1 + Math.exp(Lpscale*(ageD_afver - Lpstar)));
				     
				     
				     
	}
	void calcOsmoticPotential_phloem(double sugarConcentration_phloem_input) {
		sugarConcentrationMole_phloem = sugarConcentration_phloem_input/MOL_SURCROSE / 
					(sugarConcentration_phloem_input/MOL_SURCROSE + (1-sugarConcentration_phloem_input)/MOL_H2O);   //#### sucrose is the major sugar in phloem!!!
		osmoticWaterPotential_phloem = 12.53 + Rberry * (273.15 + Ta )* sugarConcentrationMole_phloem / SpVw;
		turgorPressure_phloem = waterPotential_phloem + osmoticWaterPotential_phloem;
	}
	
  void calcOsmoticPotential_furit() 
  {
	 sugarConcentrationMole_fruit = sugarConcentration_fruit/MOL_HEXOSE /
      		(sugarConcentration_fruit/MOL_HEXOSE + (1-sugarConcentration_fruit)/MOL_H2O);
    
    //the mole concentration of acids in fruit
    malicConcentrationMole_fruit = malicConcentration_fruit/MOL_MALIC /
      		(malicConcentration_fruit/MOL_MALIC + (1-malicConcentration_fruit)/MOL_H2O);
    
    tartaricConcentrationMole_fruit = tartaricConcentration_fruit/MOL_TARTARIC /
      		(tartaricConcentration_fruit/MOL_TARTARIC + (1-tartaricConcentration_fruit)/MOL_H2O);
    
    //calculate the partial pressure of amino acids in osmotic pressure
    //osmoticWaterPotential_partialContribution <<- 0.4 + 3.2 * Math.exp(-194.23 * sugarConcentrationMole_fruit);
    //this needs to be updated, as we have organic acids now, so the partial pressure of other compounds
    osmoticWaterPotential_partialContribution = veraison == false? 0.1 : 0.15;
    
    osmoticWaterPotential_fruit = (1 + osmoticWaterPotential_partialContribution) * (Rberry * (273.15 + Ta ) * 
         (sugarConcentrationMole_fruit + malicConcentrationMole_fruit + tartaricConcentrationMole_fruit)/SpVw);	
  }

  //******************************************************************************/
  // membrane reflection coefficient and cell wall extensibility
  //******************************************************************************/
  void calcSigmap() 
  {
    sigmap = max(0, sigmaP0/(1+exp(-ksip*(ageD - coefSip))));
  }
  
  void calcCellWallExtensibility() 
  {
    cellWallExtensibility = phi0;
   
	cellWallExtensibility = phiMin + ( phiMax - phiMin )/( 1 + exp( kPhi *(ageD-coefPhi))); 
	
  }
  
  // Calculate fruit volume  -----------------------------
  void calcVol() 
  {
    vol = waterMass*mgTogram/Dw + biomass*mgTogram/Ds;		  // [cm3]  fruit volume
  }
   


	
  void calcTurgorPressure_fruit() {	
	//Turgor regulation biomass unit should be converted into gram, 
    double prod1 =  (Axylem * Lxylem + Aphloem * Lphloem); 
    double prod2 =  (Axylem * Lxylem + Aphloem * Lphloem * sigmap);
    double prod3 =  sugarUptake_active + (Aphloem * permeability_sugar * 
                                    (sugarConcentration_phloem - sugarConcentration_fruit));
    double prod4 =  (1 - sigmap) * Aphloem * Lphloem * 0.5 * (sugarConcentration_phloem + sugarConcentration_fruit);
    // calculate aCoef
    double div1 = (rwtr * (maintenanceCoff*biomass*mgTogram  + (growthCoff-1) * prod3) - transpirationMass * growthCoff)/Dw;
    double div2 = (prod3 - maintenanceCoff*biomass*mgTogram)/Ds;
    double aCoef = (div1 + div2)/growthCoff;
    // calculate bCoef
    double div3 = (rwtr * (growthCoff-1) * prod4 + prod1 * growthCoff)/Dw;
    double div4 = prod4/Ds;
    double bCoef = (div3 + div4)/growthCoff;
    // calculate cCoef
    double prod5 = prod4 *sigmap;
    double div5 = (rwtr * (growthCoff-1) * prod5 +prod2 * growthCoff)/Dw;
    double div6 = prod5/Ds;
    double cCoef = (div5 + div6)/growthCoff;
    
    // calculate fruit turgor 
    double pF1 = ( aCoef + bCoef * turgorPressure_phloem - cCoef * 
                (osmoticWaterPotential_phloem - osmoticWaterPotential_fruit) + 
                vol * cellWallExtensibility*YC )/(bCoef + vol * cellWallExtensibility);
    double pF2 = (turgorPressure_phloem + ( aCoef - cCoef * (osmoticWaterPotential_phloem - osmoticWaterPotential_fruit))/ bCoef) > 0 ?
                      turgorPressure_phloem + ( aCoef - cCoef * (osmoticWaterPotential_phloem - osmoticWaterPotential_fruit))/ bCoef : 0;
					  
    turgorPressure_fruit = (pF1-YC)>0 ? pF1 : pF2;
   
	waterPotential_fruit = turgorPressure_fruit - osmoticWaterPotential_fruit;	
	}
	
  //******************************************************************************/
  // water uptake from xylem and phloem
  //******************************************************************************/
	double caclWaterUptake_xylem() {
		waterUptake_xylem = Axylem * Lxylem * (turgorPressure_xylem - turgorPressure_fruit - 
							sigmax*(osmoticWaterPotential_xylem- osmoticWaterPotential_fruit));
		return waterUptake_xylem;
	}
	double caclWaterUptake_phloem() {
	    waterUptake_phloem = Axylem * Lphloem * (turgorPressure_phloem - turgorPressure_fruit - sigmap*(osmoticWaterPotential_phloem- osmoticWaterPotential_fruit));
	    //println("turgorPressure_phloem " + turgorPressure_phloem);	
		//println("turgorPressure_fruit " + turgorPressure_fruit);	
	    return waterUptake_phloem;
	}
	

  

	//******************************************************************************/
  // update the maintenance and growth carbon cost
  //******************************************************************************/
	void updateStateVariables() {
		//dry mass
		double growth = unloadingPerFruit - growthCost/berryNum - maintenanceDM - carbonMobilizationCost;  //growth cost calculated in all growing organ in relation to unloading 
		
		double deltaBiomass = growth/CARBON_FRACTION_SUCROSE;   //mg
		
		double Stot = biomass + seedDryWeight;
		double dSstone = share1 * share2 * Math.exp(-share2 * Stot)/(1-share1 * share2 * Math.exp(-share2 * Stot))*deltaBiomass;
		seedDryWeight += dSstone; 
		SEED_FRESH_MASS = noysf1 + noysf2 * seedDryWeight;
			
		
		deltaBiomass = deltaBiomass - dSstone;
		//biomass exclude the stone/seed biomass
		
		biomass += deltaBiomass;
			
		structuralBiomass = structuralBiomass + kst * deltaBiomass;
		
		double deltaNonStructural = (1-kst) * deltaBiomass;
        solubleSugar = solubleSugar + kss * deltaNonStructural;  //the increase of soluble sugar is in proportion to dry mass
        malicAcid    = malicAcid + kmalic * deltaNonStructural - DegradationRateMalic * malicAcid * ((Ta-baseT)*DT); 
        tartaricAcid = tartaricAcid + ktartaric * deltaNonStructural;
		
        carbon_total = (biomass + seedDryWeight) * CARBON_FRACTION_GLUCOSE;

		//water
		respirationWater = rwtr * (growthCost + maintenanceDM) * mgTogram;  //gram
		deltaWater = waterUptake_xylem + waterUptake_phloem + respirationWater - transpirationMass; //g
		waterMass += deltaWater/ mgTogram; //mg, change into mg in accordance with biomass
		freshWeight = biomass + waterMass; //mg
		waterContent = 1 - biomass/freshWeight;
		
		
		//sugar concentration
		sugarConcentration_fruit = solubleSugar/waterMass;  //g/gh20
		malicConcentration_fruit = malicAcid/waterMass;  //g/gh20
		tartaricConcentration_fruit = tartaricAcid/waterMass;  //g/gh20
		
		//update hydraulic conductance based on fruit weight before veraison
		//after veraison this stays the same
		if(FruitService.veraison == false) {

		}
		//if (printFlag) { println("dbiomass " + deltaBiomass + " dsugar " + deltaNonStructural*kss + " dw " + deltaWater/mgTogram ); }
	}
	
