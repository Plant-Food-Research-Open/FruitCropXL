	double Lpstar; /**< Proportional to the slope at the inflection point of Lp (g-1). */
	double Lxmax; /**< Maximum conductivity for water transport in the xylem (g.cm-2.h-1.bar-1). */
	double Lxstar; /**< Proportional to the slope at the inflection point of Lx (g-1). */
