	float kst; /**< Fraction of sugar allocated to structural biomass. */
	float koa; /**< Fraction of sugar allocated to organic acid. */
	float kmalic; /**< Fraction of acids allocated to malic acid within organic acids. */
	float ktartaric; /**< Fraction of acids allocated to tartaric acid. */
	float kothers; /**< Fraction of acids allocated to other acids within organic acids. */
	float DegradationRateMalic; /**< Rate of degradation of malic acids. */
	
