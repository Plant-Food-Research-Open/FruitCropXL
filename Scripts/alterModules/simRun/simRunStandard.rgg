public class SimRunStandard extends SimRunService implements Serializable {
	public void simRun() 
	{
		if("true".equalsIgnoreCase(ModelArgs.reset)) {
		  mainInstance.resetGraph();
		  mainInstance.init();
		  derive();
		}
			if (printFlag) { println(FILE_NAME_MODEL_OPTIONS); }

		mainInstance.runEnd();
		
	}
}
