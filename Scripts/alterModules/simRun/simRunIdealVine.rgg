public class SimRunIdealVine extends SimRunService implements Serializable {
	public void simRun() 
	{
		/* ############################# SIMULATING VARIOUS PARAMETER COMBINATIONS FOR SENSITIVITY ANALYSIS #############*/

		String [] site = {"MA07.", "MA16.", "WA06." };

		for (scenario = 2018; scenario <= 2018; scenario++) {	
			keepTable = false; 
			mainInstance.resetGraph();
			for(int i = 0; i<=2; i++) {	
							
				FILE_NAME_MODEL_OPTIONS = "model.options.PN."+site[i]+scenario+".txt";
				
				if (printFlag) { println(FILE_NAME_MODEL_OPTIONS); }
				mainInstance.init();
				derive();
					mainInstance.runEnd();
				
				mainInstance.resetGraph();	
			}
		}
	}
}
