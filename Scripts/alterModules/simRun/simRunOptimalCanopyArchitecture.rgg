public class SimRunOptimalCanopyArchitecture extends SimRunService implements Serializable {
	public void simRun() {
		keepTable = false;	
		mainInstance.resetGraph();
		
		commandLineArgs = new CommandLineArgs();
		String scenarioNum = commandLineArgs.getRawProperty("scenario");
		if(optimalCanopyUseLegacyScenarioPreset && scenarioNum == null) {
			throw new IllegalArgumentException(
				"Legacy optimal-canopy preset mode requires a scenario number."
		);
		}
		
		if(scenarioNum != null) {
			scenario = Integer.parseInt(scenarioNum);
		}
		if(optimalCanopyUseLegacyScenarioPreset) {
		cloneX = 4;
		cloneY = 4;
	
			
		//Default simulations will be run with small shoots for various scenarios,
		//with the 10 cm distance between the shoot as the industry more familiar with this distance.
		/* 		Few additional simulations
			1.	comparison between north-south, west-east, 135 for 3 tiers system;
			2.	comparison between big and small shoot for 3 tiers system;
			3.	comparison between 10 cm and 20 cm shoot distance for 3 tiers system;  
		*/

		if(scenario == 0) 
		{
			//S0 homogeneous canopy
			rowOrientation = 0; //row orientation. 0 is for east-west, 90 is for south-north. rotate counter clock wise
			nrRows = 2;
			nrPlants=8;
			INDI_ID_A = 10; 
			borderRows=2;
			borderPlants=3; 
			nrStrips= 3;
			plantDistance = rowDistance;
			stripDistance = rowDistance;
			InitiationOptimalCanopyArchitecture.dLayer = true;
			InitiationOptimalCanopyArchitecture.quadLayer = false;
		} 
		if(scenario == 1) 
		{
			//S1 Trellis 1, Layer 1
			//2-cane wide-row, 2.4 meter
