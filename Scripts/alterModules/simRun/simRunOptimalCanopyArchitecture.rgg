			nrRows = 1;
			nrPlants=8;
			INDI_ID_A = 10; 
			borderRows=1;
			borderPlants=3; 
			nrStrips= 3;
			plantDistance = 0.1;
			rowDistance = 0.2;
			stripDistance = 2.4;
			InitiationOptimalCanopyArchitecture.dLayer = false;
			InitiationOptimalCanopyArchitecture.quadLayer = false;
		}
	 	if(scenario == 2) 
