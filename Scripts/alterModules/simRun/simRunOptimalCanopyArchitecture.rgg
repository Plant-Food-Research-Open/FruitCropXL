			rowDistance = 0.08;
			stripDistance = 1.7;
			InitiationOptimalCanopyArchitecture.dLayer = false;
			InitiationOptimalCanopyArchitecture.quadLayer = true;
			cloneX = 20;
			cloneY = 20;
		}
	
		//for testing the border row effects. it seems one plant also works well
		if(scenario == 31) 
		{
			FILE_NAME_MODEL_OPTIONS = "model.options.optimal.canopy.architecture.bigShoot.txt";
			rowOrientation = 90; //row orientation. 0 is for east-west, 90 is for south-north. rotate counter clock wise 
			nrRows = 1;
			nrPlants=1;
			INDI_ID_A = 10; 
			borderRows=0;
			borderPlants=0; 
			nrStrips=2;
			plantDistance = 0.1;
			rowDistance = 0.2;
			stripDistance = 2.4;
			InitiationOptimalCanopyArchitecture.dLayer = false;
			cloneX 	= 40;			// number of grid clones along the row 
			cloneY 	= 10;		
			InitiationOptimalCanopyArchitecture.quadLayer = false;
		}
		
		if(InitiationOptimalCanopyArchitecture.quadLayer) {
			optimalCanopyLayoutMode = "legacy_quad";
		} else if(InitiationOptimalCanopyArchitecture.dLayer) {
			optimalCanopyLayoutMode = "legacy_dlayer";
		} else {
			optimalCanopyLayoutMode = "legacy_single";
		}
		} else {
			InitiationOptimalCanopyArchitecture.dLayer = false;
			InitiationOptimalCanopyArchitecture.quadLayer = false;
		}

		charts.CHARTS[0] = 10;
		
		if (printFlag) { println(FILE_NAME_MODEL_OPTIONS); }
		println("Current scenario_" + scenario + " chart number " + charts.CHARTS[0]);		
				
		
		
		mainInstance.init();
		derive();
		mainInstance.runEnd();
		
		String name =  splitAndCombine(FILE_NAME_MODEL_OPTIONS);
		
	    if (printFlag) { println("Current scenario_" + scenario + "simEnd "); }
		
	    String chart0 = PATH_OUTPUT+ name + "_ro" + rowOrientation + "_shootd" + plantDistance + "_s" + scenario +".csv";
		outputChartData(chart0, 0);
	}
}
