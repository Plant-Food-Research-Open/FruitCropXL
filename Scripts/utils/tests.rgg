	@Test
	public void diagnosticCoordinatorControlsFilesMetadataAndEventRows() throws Exception {
		File testRoot = new File(PATH_OUTPUT,
			"diagnostic-table-unit-" + System.currentTimeMillis());
		File disabledCsv = new File(testRoot,
			"diagnostics/apple_leaf_axis_debug.csv");
		File disabledMetadata = new File(testRoot,
			"diagnostics/apple_leaf_axis_debug.metadata.json");
		try {
			assertTrue(disabledCsv.getParentFile().mkdirs());
			assertTrue(disabledCsv.createNewFile());
			assertTrue(disabledMetadata.createNewFile());
			DiagnosticTableCoordinator.initialize(
				testRoot.getPath() + File.separator, "unit",
				false, false, false, false);
			assertFalse("Disabled diagnostics must remove a stale CSV", disabledCsv.exists());
			assertFalse("Disabled diagnostics must remove stale metadata", disabledMetadata.exists());

			DiagnosticTableCoordinator.initialize(
				testRoot.getPath() + File.separator, "unit",
				false, true, false, true);
			String csvPath = DiagnosticTableCoordinator.getCsvPath(
				DiagnosticTableCoordinator.TABLE_APPLE_LEAF_AXIS);
			String metadataPath = DiagnosticTableCoordinator.getMetadataPath(
				DiagnosticTableCoordinator.TABLE_APPLE_LEAF_AXIS);
			String leafMetadataPath = DiagnosticTableCoordinator.getMetadataPath(
				DiagnosticTableCoordinator.TABLE_LEAF_EXPANSION);
			assertNotNull(csvPath);
			assertNotNull(metadataPath);
			assertNotNull(leafMetadataPath);
			assertTrue(new File(metadataPath).isFile());
			assertTrue(new File(leafMetadataPath).isFile());

			AppleLeafAxisDiagnosticOutputData firstRow =
				new AppleLeafAxisDiagnosticOutputData();
			firstRow.timestamp = "2001-01-01T00:00:00";
			firstRow.step = 1;
			firstRow.year = 2001;
			firstRow.dayOfYear = 1;
			firstRow.hourOfDay = 0;
			firstRow.scenario = 1;
			firstRow.simuuid = "unit-run";
			firstRow.plantNumber = 1;
			firstRow.fieldInstanceId = 0;
			firstRow.event = "created, \"quoted\"";
			DiagnosticTableCoordinator.writeAppleLeafAxis(firstRow);

			AppleLeafAxisDiagnosticOutputData secondRow =
				new AppleLeafAxisDiagnosticOutputData();
			secondRow.timestamp = firstRow.timestamp;
			secondRow.step = 1;
			secondRow.year = 2001;
			secondRow.dayOfYear = 1;
			secondRow.hourOfDay = 0;
			secondRow.scenario = 1;
			secondRow.simuuid = "unit-run";
			secondRow.plantNumber = 1;
			secondRow.fieldInstanceId = 0;
			secondRow.event = "second event";
			DiagnosticTableCoordinator.writeAppleLeafAxis(secondRow);

			assertEquals(2L, DiagnosticTableCoordinator.getRowCount(
				DiagnosticTableCoordinator.TABLE_APPLE_LEAF_AXIS));
			BufferedReader reader = new BufferedReader(new FileReader(new File(csvPath)));
			String header;
			String firstValue;
			String secondValue;
			try {
				header = reader.readLine();
				firstValue = reader.readLine();
				secondValue = reader.readLine();
				assertNull("Only two event rows should be written", reader.readLine());
			} finally {
				reader.close();
			}
			assertEquals(19, csvColumnCount(header));
			assertEquals(csvColumnCount(header), csvColumnCount(firstValue));
			assertEquals(csvColumnCount(header), csvColumnCount(secondValue));
			assertTrue(firstValue.indexOf("\"created, \"\"quoted\"\"\"") >= 0);

			String metadataText = readText(new File(metadataPath));
			assertTrue(metadataText.indexOf("description") >= 0);
			assertTrue(metadataText.indexOf("tags") >= 0);
			String leafMetadataText = readText(new File(leafMetadataPath));
			assertTrue(leafMetadataText.indexOf("unit") >= 0);
		} finally {
			DiagnosticTableCoordinator.initialize(
				PATH_OUTPUT, outputTable_name,
				outputWaterFluxSolverDebug,
				outputLeafGrowthDiagnostics,
				outputCarbonTransportDiagnostics,
				outputAppleDevelopmentDiagnostics);
			deleteTree(testRoot);
		}
	}

	@Test
	public void canopyZonePhysiologyUsesDeterministicHalfOpenZonesAndFiniteMeans() {
		double[] heights = {0.9, 1.4, 2.0, 3.0};
		Leaf[] leaves = {
			leafFixture(1.0, 10.0, -0.5, 0.1f),
			leafFixture(1.2, Double.NaN, -0.7, 0.3f),
			leafFixture(1.4, 20.0, Double.NaN, 0.4f),
			leafFixture(2.0, 40.0, -1.5, Float.NaN),
			leafFixture(3.0, 80.0, -2.0, 0.8f),
			leafFixture(0.8, 1000.0, -4.0, 1.0f)
		};

		double[][] result = calculateCanopyZonePhysiology(leaves, heights);
		assertEquals(10.0, result[CANOPY_ZONE_MEAN_ANET][0], 1.0e-12);
		assertEquals(-0.6, result[CANOPY_ZONE_MEAN_WATER_POTENTIAL][0], 1.0e-12);
		assertEquals(0.2, result[CANOPY_ZONE_MEAN_GS][0], 1.0e-7);
		assertEquals(20.0, result[CANOPY_ZONE_MEAN_ANET][1], 1.0e-12);
		assertEquals(0.0, result[CANOPY_ZONE_MEAN_WATER_POTENTIAL][1], 0.0);
		assertEquals(0.4, result[CANOPY_ZONE_MEAN_GS][1], 1.0e-7);
		assertEquals(40.0, result[CANOPY_ZONE_MEAN_ANET][2], 1.0e-12);
		assertEquals(-1.5, result[CANOPY_ZONE_MEAN_WATER_POTENTIAL][2], 1.0e-12);
		assertEquals(0.0, result[CANOPY_ZONE_MEAN_GS][2], 0.0);
		assertEquals(80.0, result[CANOPY_ZONE_MEAN_ANET][3], 1.0e-12);
		assertEquals(-2.0, result[CANOPY_ZONE_MEAN_WATER_POTENTIAL][3], 1.0e-12);
		assertEquals(0.8, result[CANOPY_ZONE_MEAN_GS][3], 1.0e-7);
		assertEquals(1.0, result[CANOPY_ZONE_COUNT_ANET][0], 0.0);
		assertEquals(2.0, result[CANOPY_ZONE_COUNT_WATER_POTENTIAL][0], 0.0);
		assertEquals(2.0, result[CANOPY_ZONE_COUNT_GS][0], 0.0);
		assertEquals(0.0, result[CANOPY_ZONE_COUNT_WATER_POTENTIAL][1], 0.0);
		assertEquals(0.0, result[CANOPY_ZONE_COUNT_GS][2], 0.0);

		double[][] emptyZoneResult = calculateCanopyZonePhysiology(
			new Leaf[] {leafFixture(1.0, 5.0, -0.25, 0.05f)}, heights);
		assertEquals(0.0, emptyZoneResult[CANOPY_ZONE_MEAN_ANET][1], 0.0);
		assertEquals(0.0, emptyZoneResult[CANOPY_ZONE_MEAN_WATER_POTENTIAL][2], 0.0);
		assertEquals(0.0, emptyZoneResult[CANOPY_ZONE_MEAN_GS][3], 0.0);

		assertEquals(1, findOutputHeightZone(1.4, heights));
		assertEquals(2, findOutputHeightZone(2.0, heights));
		assertEquals(3, findOutputHeightZone(3.0, heights));
		assertEquals(-1, findOutputHeightZone(0.8, heights));
	}
}

public class WaterHydraulicsTopologyUnitTest {
	private static void assertInvalid(String expectedMessage,
			long[] ids, long[] parents, long[] basal,
			long[] leafParents, double[] leafPotentials) {
		WaterHydraulicTestResult result = testWaterHydraulicFold(
			ids, parents, basal, leafParents, leafPotentials, 0.4);
		assertFalse("Topology unexpectedly valid", result.valid);
		assertTrue("Expected error containing '" + expectedMessage + "' but was '"
			+ result.error + "'", result.error.indexOf(expectedMessage) >= 0);
	}

	@Test
	public void branchedTreeFoldsDemandAndVisitsEverySegmentOnce() {
		long[] ids = {10L, 11L, 12L, 13L};
		long[] parents = {-1L, 10L, 10L, 12L};
		long[] basal = {10L};
		long[] leafParents = {11L, 13L};
		double[] leafPotentials = {2.0, 3.0};
		WaterHydraulicTestResult result = testWaterHydraulicFold(
			ids, parents, basal, leafParents, leafPotentials, 0.4);

		assertTrue(result.error, result.valid);
		double[] expectedSubtree = {5.0, 2.0, 3.0, 3.0};
		double[] expectedFlux = {2.0, 0.8, 1.2, 1.2};
		for (int i = 0; i < ids.length; i++) {
			assertEquals(expectedSubtree[i], result.subtreePotential[i], 1.0e-12);
			assertEquals(expectedFlux[i], result.waterFlux[i], 1.0e-12);
			assertEquals("Segment must fold exactly once", 1, result.foldCount[i]);
			assertEquals("Segment must unfold exactly once", 1, result.unfoldCount[i]);
		}
	}

	@Test
	public void invalidTopologiesFailClearly() {
		assertInvalid("missing leaf parent",
			new long[] {1L}, new long[] {-1L}, new long[] {1L},
			new long[] {99L}, new double[] {1.0});
		assertInvalid("missing internode parent",
			new long[] {1L, 2L}, new long[] {-1L, 99L}, new long[] {1L},
			new long[0], new double[0]);
		assertInvalid("self-parent",
			new long[] {1L}, new long[] {1L}, new long[0],
			new long[0], new double[0]);
		assertInvalid("cycle",
			new long[] {1L, 2L}, new long[] {2L, 1L}, new long[0],
			new long[0], new double[0]);
		assertInvalid("duplicate internode ID",
			new long[] {1L, 2L, 2L}, new long[] {-1L, 1L, 1L}, new long[] {1L},
			new long[0], new double[0]);
		assertInvalid("duplicate parent assignment",
			new long[] {1L, 2L, 3L, 2L},
			new long[] {-1L, 1L, 1L, 3L}, new long[] {1L},
			new long[0], new double[0]);
		assertInvalid("disconnected internode",
			new long[] {1L, 2L}, new long[] {-1L, -1L}, new long[] {1L},
			new long[0], new double[0]);
	}
}

public class ReserveTurnoverUnitTest {
	private static GrowingOrgan reserveFixture(double reserveCarbon) {
		GrowingOrgan fixture = new GrowingOrgan();
		fixture.biomass = 100.0;
		fixture.maxRes = 0.4;
		fixture.synRate = 0.1;
		fixture.hydRate = 0.05;
		fixture.carbon_nonStructure = reserveCarbon;
		return fixture;
	}

	@Test
	public void reserveSynthesisStopsAtCapacityWithoutDisablingHydrolysis() {
		float previousTa = Ta;
		int previousDaysSinceWinterSolstice = daysSinceWinterSolstice;
		try {
			Ta = 20.0f;
			daysSinceWinterSolstice = 0;
			double reserveCapacity = 100.0 * 0.4 * CARBON_FRACTION_SUCROSE;

			GrowingOrgan belowCapacity = reserveFixture(0.5 * reserveCapacity);
			assertTrue("Reserve below capacity must have positive synthesis",
				belowCapacity.reserveSynthesis() > 0.0);

			GrowingOrgan atCapacity = reserveFixture(reserveCapacity);
			assertEquals("Reserve at capacity must have zero synthesis",
				0.0, atCapacity.reserveSynthesis(), 0.0);

			GrowingOrgan aboveCapacity = reserveFixture(1.1 * reserveCapacity);
			assertEquals("Reserve above capacity must have zero synthesis",
				0.0, aboveCapacity.reserveSynthesis(), 0.0);
			assertTrue("Hydrolysis must remain independently available above capacity",
				aboveCapacity.reserveHydrolysis() > 0.0);
		} finally {
			Ta = previousTa;
			daysSinceWinterSolstice = previousDaysSinceWinterSolstice;
		}
	}
}

public class VirtualFruitCarbonDemandUnitTest {
	private String previousSpecies;
	private float previousSorbitolFraction;
	private boolean previousEnablePreT1;
	private boolean previousPreT1Active;
	private boolean previousUseStaticArc;

	@Before
	public void useAppleCarbonFixture() {
		previousSpecies = species;
		previousSorbitolFraction = FRACTION_SORBITOL;
		previousEnablePreT1 = enablePotentialGrowthBeforeT1;
		previousPreT1Active = preT1PotentialGrowthActive;
		previousUseStaticArc = useStaticArc;
		species = "apple";
		FRACTION_SORBITOL = 0.75f;
		enablePotentialGrowthBeforeT1 = false;
		preT1PotentialGrowthActive = false;
		useStaticArc = false;
	}

	@After
	public void restoreCarbonFixture() {
		species = previousSpecies;
		FRACTION_SORBITOL = previousSorbitolFraction;
		enablePotentialGrowthBeforeT1 = previousEnablePreT1;
		preT1PotentialGrowthActive = previousPreT1Active;
		useStaticArc = previousUseStaticArc;
	}

	public static double mm(double sugar, double km) {
		return sugar / (km + sugar);
	}

	private static double phiFromSugar(double sugar) {
		double carbon = convertSugarToPhloemC((float) sugar);
		return 0.5 * carbon * carbon;
	}

	@Test
	public void inwardMassFlowUsesAcceptedHydraulicSlopeAndIsHistoryIndependent() {
		double referenceMassFlow = 2.0;
		double referenceSugar = 0.10;
		double referenceWaterFlow = 0.5;
		double[] candidates = {0.05, 0.15, 0.08, 0.05};
		double[] expected = {1.0, 3.0, 1.6, 1.0};
		for (int i = 0; i < candidates.length; i++) {
			assertEquals(expected[i], VirtualFruit.laggedVirtualFruitMassFlowCarbon(
				referenceMassFlow, referenceSugar, referenceWaterFlow,
				candidates[i]), 1.0e-12);
		}
		assertEquals(referenceMassFlow,
			VirtualFruit.laggedVirtualFruitMassFlowCarbon(referenceMassFlow,
				referenceSugar, referenceWaterFlow, referenceSugar), 0.0);
	}

	@Test
	public void fileBackedCpmHasMatchingFruitCropXLSugarReference() {
		double expectedSugar = 0.15;
		double molarMass = 0.75 * MOL_SORBITOL + 0.25 * MOL_SURCROSE;
		double cpm = 1000.0 * expectedSugar / molarMass;
		assertEquals(expectedSugar, VirtualFruit.virtualFruitSugarFromCpm(cpm), 1.0e-12);
		assertTrue(Double.isNaN(VirtualFruit.virtualFruitSugarFromCpm(Double.NaN)));
	}

	@Test
	public void analyticalMassFlowDerivativeMatchesFiniteDifferenceAndTaylorPoint() {
		double referenceMassFlow = 2.0;
		double referenceSugar = 0.10;
		double referenceWaterFlow = 0.5;
		double[] sugars = {0.04, 0.10, 0.18};
		for (int i = 0; i < sugars.length; i++) {
			double phi = phiFromSugar(sugars[i]);
			double sugar = sugarFromCp(phi);
			double analytical = VirtualFruit.laggedVirtualFruitMassFlowDerivativePhi(
				referenceMassFlow, referenceSugar, referenceWaterFlow, phi, sugar);
			/* sugarFromCp currently returns legacy float precision. */
			double epsilon = phi * 1.0e-3;
			double above = VirtualFruit.laggedVirtualFruitMassFlowCarbon(
				referenceMassFlow, referenceSugar, referenceWaterFlow,
				sugarFromCp(phi + epsilon));
			double below = VirtualFruit.laggedVirtualFruitMassFlowCarbon(
				referenceMassFlow, referenceSugar, referenceWaterFlow,
				sugarFromCp(phi - epsilon));
			double numerical = (above - below) / (2.0 * epsilon);
			double scale = Math.max(1.0, Math.abs(numerical));
			assertTrue(Math.abs(analytical - numerical) / scale < 2.0e-3);

			double massFlow0 = VirtualFruit.laggedVirtualFruitMassFlowCarbon(
				referenceMassFlow, referenceSugar, referenceWaterFlow, sugar);
			double massFlowA = massFlow0 - phi * analytical;
			assertEquals("A+B*Phi must reconstruct the exact CP mass flow at Phi0",
				massFlow0, massFlowA + analytical * phi, 1.0e-12);
		}
	}

	@Test
	public void preT1PrimaryGrowthIsUnscaledWithZeroTransportDerivative() {
		enablePotentialGrowthBeforeT1 = true;
		preT1PotentialGrowthActive = true;
		useStaticArc = false;

		double growthReference = 10.0;
		GrowingOrgan fixture = new GrowingOrgan();
		fixture.km_pri = 0.072;
		fixture.structureDM_PRI_PT = VirtualFruit.reconstructVirtualFruitPotentialGrowth(
			growthReference, mm(0.15, fixture.km_pri), true);
		fixture.structureDM_SEC_PT = 0.0;
		fixture.reserveDM_PT = 0.0;
		fixture.maintenanceDM_PT = 0.0;
		fixture.loading_PT = 0.0;
		fixture.cpt = phiFromSugar(0.08);
		fixture.cpb = fixture.cpt;

		lineariseOrgan(fixture);
		double reconstructedSink = (fixture.sink_source_a
			+ fixture.sink_source_b * fixture.cpt) / mgTogram;
		assertEquals(growthReference, fixture.structureDM_PRI_PT, 0.0);
		assertEquals(growthReference, reconstructedSink, 1.0e-12);
		assertEquals("Pre-T1 primary derivative must be zero",
			0.0, fixture.sink_source_b, 0.0);
	}

	@Test
	public void outwardMassFlowIsSignedFixedAndHasZeroDerivative() {
		double massFlowReference = -2.0;
		double referenceSugar = 0.10;
		double[] candidates = {0.03, 0.08, 0.15, 0.03};
		for (int i = 0; i < candidates.length; i++) {
			double phi = phiFromSugar(candidates[i]);
			assertEquals(massFlowReference,
				VirtualFruit.laggedVirtualFruitMassFlowCarbon(massFlowReference,
					referenceSugar, -0.5, candidates[i]), 0.0);
			assertEquals(0.0,
				VirtualFruit.laggedVirtualFruitMassFlowDerivativePhi(
					massFlowReference, referenceSugar, -0.5, phi,
					candidates[i]), 0.0);
		}
		assertEquals(-2.0,
			VirtualFruit.sanitizeSignedVirtualFruitMassFlow(-2.0), 0.0);
		assertEquals("Invalid Cpref must use a fixed reference with zero slope",
			2.0, VirtualFruit.laggedVirtualFruitMassFlowCarbon(
				2.0, 0.0, 0.5, 0.15), 0.0);
	}

}

public class BerryComplexCarbonDemandUnitTest {
	private static double mm(double sugar, double km) {
		return sugar / (km + sugar);
	}

	private static double phiFromSugar(double sugar) {
		double carbon = convertSugarToPhloemC((float) sugar);
		return 0.5 * carbon * carbon;
	}

	@Test
	public void potentialImportsUseOnlyPrimarySinkChannel() {
		BerryComplex fruit = new BerryComplex((String) null, 0);
		fruit.sugarUptake_passive = 7.0;
		fruit.mapBerryImportPotentialChannels(10.0);

		assertEquals(10.0, fruit.structureDM_PRI_PT, 0.0);
		assertEquals(0.0, fruit.maintenanceDM_PT, 0.0);
		assertEquals(0.0, fruit.structureDM_SEC_PT, 0.0);
		assertEquals(0.0, fruit.reserveDM_PT, 0.0);
		assertEquals(0.0, fruit.sugarUptake_passive, 0.0);
	}

	@Test
	public void berryMassFlowPotentialIsLaggedAcrossCandidatesAndAcceptedAtHourBoundary() {
		BerryComplex fruit = new BerryComplex((String) null, 0);
		boolean previousUseCTRAM = useCTRAM;
		boolean previousInputVesselConditions = inputVesselConditions;
		boolean previousEnablePreT1 = enablePotentialGrowthBeforeT1;
		boolean previousPreT1Active = preT1PotentialGrowthActive;
		try {
			useCTRAM = true;
			inputVesselConditions = false;
			enablePotentialGrowthBeforeT1 = false;
			preT1PotentialGrowthActive = false;
			fruit.km_pri = 0.072;
			fruit.biomass = 1000.0;
			fruit.berryNum = 1;
			fruit.Vmax_berry = 0.0025f;
			fruit.Cstar = 1000.0f;
			fruit.Cscale = 1.0f;
			fruit.commitBerryMassFlowReference(2.0, 0.08, 0.5);
			double[] candidates = {0.03, 0.08, 0.15, 0.03};
			double[] expectedMassFlow = {0.75, 2.0, 3.75, 0.75};
			double previousActive = -1.0;
			for (int i = 0; i < candidates.length; i++) {
				fruit.calcPTCTRAM(candidates[i]);
				fruit.calcUnloading(candidates[i]);
				assertEquals(0.0, fruit.maintenanceDM_PT, 0.0);
				assertEquals(expectedMassFlow[i],
					fruit.getDirectMassFlowCarbon(candidates[i]), 1.0e-12);
				assertEquals(0.0, fruit.structureDM_SEC_PT, 0.0);
				assertEquals(0.0, fruit.sugarUptake_passive, 0.0);
				if (i > 0 && i < 3) {
					assertTrue(fruit.structureDM_PRI > previousActive);
				}
				previousActive = fruit.structureDM_PRI;
			}

			assertEquals("Solver candidates must not update the accepted berry reference",
				2.0, fruit.previousMassFlowCarbon, 0.0);
			assertEquals(0.08, fruit.massFlowPhloemSugarReference, 0.0);
			assertEquals(0.5, fruit.massFlowWaterFlowReference, 0.0);
			fruit.commitBerryMassFlowReference(3.0, 0.10, 0.4);
			fruit.calcPTCTRAM(0.08);
			assertEquals("Accepted physical flow becomes the next-hour reference",
				3.0, fruit.getDirectMassFlowCarbon(0.10), 0.0);
		} finally {
			useCTRAM = previousUseCTRAM;
			inputVesselConditions = previousInputVesselConditions;
			enablePotentialGrowthBeforeT1 = previousEnablePreT1;
			preT1PotentialGrowthActive = previousPreT1Active;
		}
	}

	@Test
	public void physicalMassFlowUsesDirectionalCarrierAndPreservesSign() {
		double inward = (1.0 - 0.9) * 0.8 * 0.15;
		assertEquals(inward, BerryComplex.berryMassFlowSugarPotential(
			0.9, 0.8, 0.03, 0.15), 1.0e-12);
		double outward = (1.0 - 0.9) * -0.8 * 0.03;
		assertEquals(outward, BerryComplex.berryMassFlowSugarPotential(
			0.9, -0.8, 0.03, 0.15), 1.0e-12);
		assertTrue(outward < 0.0);
		assertEquals(0.0, BerryComplex.berryMassFlowSugarPotential(
			0.9, 1.0e-14, 0.03, 0.15), 0.0);
	}

	@Test
	public void berryLaggedMassFlowDerivativeMatchesFiniteDifferenceAndOutwardIsFixed() {
		double referenceMassFlow = 2.0;
		double referenceSugar = 0.10;
		double phi = phiFromSugar(0.08);
		double sugar = sugarFromCp(phi);
		double analytical = BerryComplex.laggedBerryMassFlowDerivativePhi(
			referenceMassFlow, referenceSugar, 0.5, phi, sugar);
		double epsilon = phi * 1.0e-3; // sugarFromCp retains legacy float precision
		double above = BerryComplex.laggedBerryMassFlowCarbon(referenceMassFlow,
			referenceSugar, 0.5, sugarFromCp(phi + epsilon));
		double below = BerryComplex.laggedBerryMassFlowCarbon(referenceMassFlow,
			referenceSugar, 0.5, sugarFromCp(phi - epsilon));
		double numerical = (above - below) / (2.0 * epsilon);
		double scale = Math.max(1.0, Math.abs(numerical));
		assertTrue(Math.abs(analytical - numerical) / scale < 2.0e-3);
		double massFlow0 = BerryComplex.laggedBerryMassFlowCarbon(referenceMassFlow,
			referenceSugar, 0.5, sugar);
		double massFlowA = massFlow0 - phi * analytical;
		assertEquals(massFlow0, massFlowA + analytical * phi, 1.0e-12);

		double[] candidates = {0.03, 0.08, 0.15};
		for (int i = 0; i < candidates.length; i++) {
			assertEquals(-2.0, BerryComplex.laggedBerryMassFlowCarbon(
				-2.0, referenceSugar, -0.5, candidates[i]), 0.0);
			assertEquals(0.0, BerryComplex.laggedBerryMassFlowDerivativePhi(
				-2.0, referenceSugar, -0.5, phiFromSugar(candidates[i]),
				candidates[i]), 0.0);
		}
	}

	@Test
	public void turgorCarrierBranchMatchesImpliedWaterFlowDirection() {
		double inwardTurgor = 1.2;
		double outwardTurgor = 2.4;
		double inwardFlow = BerryComplex.berryPhloemWaterFlowAtTurgor(
			1.0, 1.0, 2.0, inwardTurgor, 0.0, 0.0, 0.0);
		double outwardFlow = BerryComplex.berryPhloemWaterFlowAtTurgor(
			1.0, 1.0, 2.0, outwardTurgor, 0.0, 0.0, 0.0);
		assertTrue(inwardFlow > 0.0);
		assertTrue(outwardFlow < 0.0);
		assertEquals(inwardTurgor, BerryComplex.selectBerryTurgorPressure(
			inwardTurgor, inwardFlow, outwardTurgor, outwardFlow, 2.0), 0.0);
		assertEquals(outwardTurgor, BerryComplex.selectBerryTurgorPressure(
			inwardTurgor, -0.1, outwardTurgor, outwardFlow, 2.0), 0.0);
	}

	@Test
	public void wholePlantImportExcludesMaintenanceButInternalBalanceDeductsIt() {
		double active = 10.0;
		double massFlow = -2.0;
		double maintenance = 3.0;
		double imported = BerryComplex.berryImportedCarbonPerFruit(active, massFlow);
		assertEquals("Berry maintenance must not be added to unloading",
			8.0, imported, 0.0);
		assertEquals("Berry maintenance must remain an internal post-unloading cost",
			3.5, BerryComplex.berryInternalCarbonAfterCosts(
				imported, 1.0, maintenance, 0.5), 0.0);
	}

	@Test
	public void commonPoolAndTaylorMassFlowAgreeAtExpansionPoint() {
		double sugar = 0.08;
		double kmPri = 0.072;
		double activePotential = 10.0;
		double referenceMassFlow = 2.0;
		double referenceSugar = 0.10;
		double referenceWaterFlow = 0.5;
		double phi = phiFromSugar(sugar);
		double physicalMassFlow = BerryComplex.laggedBerryMassFlowCarbon(
			referenceMassFlow, referenceSugar, referenceWaterFlow, sugar);
		double massFlowB = BerryComplex.laggedBerryMassFlowDerivativePhi(
			referenceMassFlow, referenceSugar, referenceWaterFlow, phi, sugar);
		double massFlowA = physicalMassFlow - phi * massFlowB;
		double commonPool = BerryComplex.realiseBerryCarbonDemand(
			activePotential, mm(sugar, kmPri))
			+ physicalMassFlow;
		double transport = activePotential * mm(sugar, kmPri)
			+ massFlowA + massFlowB * phi;

		assertEquals(transport, commonPool, 1.0e-12);
		assertTrue("Active uptake must remain limited through KM_PRI",
			BerryComplex.realiseBerryCarbonDemand(activePotential, mm(sugar, kmPri))
				< BerryComplex.realiseBerryCarbonDemand(activePotential, mm(0.2, kmPri)));
	}

	@Test
	public void exactBerryAuditPreservesAcceptedReferencesAndSignedOutflow() {
		BerryComplex fruit = new BerryComplex((String) null, 0);
		fruit.km_pri = 0.072;
		fruit.structureDM_PRI_PT = 1.0;
		fruit.commitBerryMassFlowReference(-2.0, 0.10, -0.5);
		double phi = phiFromSugar(0.08);
		double exactMass = exactFruitMassFlowMg(fruit, phi);
		double exactActive = exactFruitActiveUnloadingMg(fruit, phi);
		double exact = exactFruitUnloadingMg(fruit, phi);
		double derivative = exactFruitUnloadingDerivativePhiMg(fruit, phi);
		double intercept = exact - phi * derivative;

		assertEquals(-2.0, exactMass, 0.0);
		assertEquals(exactActive + exactMass, exact, 0.0);
		assertEquals(exact, intercept + derivative * phi, 1.0e-12);
		assertEquals(-2.0, fruit.previousMassFlowCarbon, 0.0);
		assertEquals(0.10, fruit.massFlowPhloemSugarReference, 0.0);
		assertEquals(-0.5, fruit.massFlowWaterFlowReference, 0.0);
	}
}

public class PlantBaseCarbonBoundaryUnitTest {
	private String previousSpecies;

	@Before
	public void useStableSugarConversion() {
		previousSpecies = species;
		species = "grapevine";
	}

	@After
	public void restoreSpecies() {
		species = previousSpecies;
	}

	private static PlantBase boundaryFixture(double branchA, double branchB,
			double previousPotential) {
		PlantBase fixture = new PlantBase();
		fixture.branch_flux_a = branchA;
		fixture.branch_flux_b = branchB;
		fixture.cpb = previousPotential;
		fixture.cpt = previousPotential;
		return fixture;
	}

	private static PlantBase applyBoundary(double branchA, double branchB,
			double previousPotential) {
		PlantBase fixture = boundaryFixture(branchA, branchB, previousPotential);
		applyGuardedPlantBaseCarbonBoundary(fixture, 1.0);
		assertTrue(isFiniteCarbonValue(fixture.cpt));
		assertTrue(fixture.cpt >= CT_PHI_FLOOR);
		assertTrue(isFiniteCarbonValue(fixture.sugarConcentration_phloem));
		assertTrue(fixture.sugarConcentration_phloem >= 0.0);
		return fixture;
	}

	@Test
	public void normalFiniteBoundaryAcceptsDirectSolution() {
		double branchA = -2.0e-4;
		double branchB = 0.4;
		double expected = -branchA / branchB;
		PlantBase fixture = applyBoundary(branchA, branchB, 0.001);
		assertEquals(expected, fixture.cpt, 0.0);
		assertEquals(0, fixture.ctPlantBaseFallbackUsed);
		assertEquals(0, fixture.ctPlantBaseFallbackReason);
		assertEquals(0, fixture.ctPlantBaseFallbackCount);
		assertEquals(branchB, fixture.ctPlantBaseDenominator, 0.0);
		assertEquals(branchA + branchB * fixture.cpt,
			fixture.ctPlantBaseResidual, 0.0);
	}

	@Test
	public void largePlantBaseJumpIsUnderRelaxed() {
		PlantBase fixture = boundaryFixture(-0.009, 1.0, 0.001);
		applyGuardedPlantBaseCarbonBoundary(fixture, 0.5);
		assertEquals(0.005, fixture.cpt, 1e-15);
		assertEquals(-0.004, fixture.ctPlantBaseResidual, 1e-15);
		assertEquals(0, fixture.ctPlantBaseFallbackUsed);
	}

	@Test
	public void worseningMeritReducesDamping() {
		assertEquals(0.25, adaptCtDampingFactor(0.5, 1.0, 1.1), 0.0);
		assertEquals(CT_DAMPING_MIN,
			adaptCtDampingFactor(CT_DAMPING_MIN, 1.0, 1.1), 0.0);
	}

	@Test
	public void improvingMeritAllowsDampingToRecover() {
		assertEquals(0.625, adaptCtDampingFactor(0.5, 10.0, 5.0), 0.0);
		assertEquals(0.55, adaptCtDampingFactor(0.5, 1.0, 0.9), 1e-15);
		assertEquals(CT_DAMPING_MAX,
			adaptCtDampingFactor(CT_DAMPING_MAX, 10.0, 5.0), 0.0);
	}

	@Test
	public void mixedFluxCriterionUsesAbsoluteAndRelativeScale() {
		assertTrue(ctMixedErrorConverged(5e-5, 1.0));
		assertFalse(ctMixedErrorConverged(5e-5, 0.01));
		// Both individual criteria fail here; an additive tolerance would pass.
		assertFalse(ctMixedErrorConverged(1.5e-5, 0.1));
	}

	@Test
	public void plantBaseResidualPreventsFalseFluxConvergence() {
		assertFalse(ctSolveConverged(
			1e-6, 1.0, 1e-3, 1.0));
		assertTrue(ctSolveConverged(
			1e-6, 1.0, 1e-6, 1.0));
	}

	@Test
	public void closureDiagnosticsDoNotChangeIsolationPatchConvergence() {
		assertTrue(ctSolveConverged(
			1e-6, 1.0, 1e-6, 1.0));
	}

	@Test
	public void zeroDenominatorRetainsPreviousPotential() {
		PlantBase fixture = applyBoundary(-1.0e-4, 0.0, 0.002);
		assertEquals(0.002, fixture.cpt, 0.0);
		assertEquals(1, fixture.ctPlantBaseFallbackUsed);
		assertEquals(2, fixture.ctPlantBaseFallbackReason);
		assertEquals(1, fixture.ctPlantBaseFallbackCount);
		assertEquals(-1.0e-4, fixture.ctPlantBaseResidual, 0.0);
	}

	@Test
	public void eitherNearZeroDenominatorSignRetainsPreviousPotential() {
		PlantBase positive = applyBoundary(-1.0e-4,
			0.5 * CT_PB_B_ABS_MIN, 0.002);
		PlantBase negative = applyBoundary(-1.0e-4,
			-0.5 * CT_PB_B_ABS_MIN, 0.002);
		assertEquals(0.002, positive.cpt, 0.0);
		assertEquals(0.002, negative.cpt, 0.0);
		assertEquals(2, positive.ctPlantBaseFallbackReason);
		assertEquals(2, negative.ctPlantBaseFallbackReason);
	}

	@Test
	public void nonFiniteCoefficientsRetainPreviousPotential() {
		PlantBase invalidA = applyBoundary(Double.NaN, 0.5, 0.002);
		PlantBase invalidB = applyBoundary(-1.0e-4,
			Double.POSITIVE_INFINITY, 0.002);
		assertEquals(0.002, invalidA.cpt, 0.0);
		assertEquals(0.002, invalidB.cpt, 0.0);
		assertEquals(1, invalidA.ctPlantBaseFallbackReason);
		assertEquals(1, invalidB.ctPlantBaseFallbackReason);
	}

	@Test
	public void negativeSubfloorOrInfiniteCandidateRetainsPreviousPotential() {
		PlantBase negative = applyBoundary(1.0e-4, 0.5, 0.002);
		PlantBase subfloor = applyBoundary(-1.0e-16, 0.5, 0.002);
		PlantBase infinite = applyBoundary(-Double.MAX_VALUE, 0.5, 0.002);
		assertEquals(0.002, negative.cpt, 0.0);
		assertEquals(0.002, subfloor.cpt, 0.0);
		assertEquals(0.002, infinite.cpt, 0.0);
		assertEquals(3, negative.ctPlantBaseFallbackReason);
		assertEquals(3, subfloor.ctPlantBaseFallbackReason);
		assertEquals(3, infinite.ctPlantBaseFallbackReason);
	}

	@Test
	public void invalidPreviousPotentialUsesPositiveFloor() {
		PlantBase nanPrevious = applyBoundary(-1.0e-4, 0.0, Double.NaN);
		PlantBase negativePrevious = applyBoundary(-1.0e-4, 0.0, -0.5);
		assertEquals(CT_PHI_FLOOR, nanPrevious.cpt, 0.0);
		assertEquals(CT_PHI_FLOOR, negativePrevious.cpt, 0.0);
	}

	@Test
	public void invalidTransformedSugarRetainsPreviousPotential() {
		PlantBase fixture = applyBoundary(-Double.MAX_VALUE, 1.0, 0.002);
		assertEquals(0.002, fixture.cpt, 0.0);
		assertEquals(1, fixture.ctPlantBaseFallbackUsed);
		assertEquals(4, fixture.ctPlantBaseFallbackReason);
	}

	@Test
	public void fallbackCountAccumulatesAndAcceptedSolveClearsCurrentFlag() {
		PlantBase fixture = boundaryFixture(-1.0e-4, 0.0, 0.002);
		applyGuardedPlantBaseCarbonBoundary(fixture, 1.0);
		applyGuardedPlantBaseCarbonBoundary(fixture, 1.0);
		assertEquals(2, fixture.ctPlantBaseFallbackCount);

		fixture.branch_flux_a = -2.0e-4;
		fixture.branch_flux_b = 0.4;
		applyGuardedPlantBaseCarbonBoundary(fixture, 1.0);
		assertEquals(0, fixture.ctPlantBaseFallbackUsed);
		assertEquals(0, fixture.ctPlantBaseFallbackReason);
		assertEquals(2, fixture.ctPlantBaseFallbackCount);
	}

	@Test
	public void generalPotentialGuardRejectsNonFiniteAndSubfloorValues() {
		assertEquals(CT_PHI_FLOOR, safePhi(Double.POSITIVE_INFINITY), 0.0);
		assertEquals(CT_PHI_FLOOR, safePhi(Double.NaN), 0.0);
		assertEquals(CT_PHI_FLOOR, safePhi(0.0), 0.0);
		assertEquals(0.002, safePhi(0.002), 0.0);
	}
}

public class CarbonTransportNumericsUnitTest {
	private static void configureSimpleRootLayer(
			StructuralRoot root, FineRoot fine, int layer) {
		root.layer = layer;
		root.sink_source_a = 0.001 * Double.valueOf(layer + 1).doubleValue();
		root.sink_source_b = 0.10 + 0.02 * layer;
		root.r = 0.15 + 0.03 * layer;
		root.xp = 0.00001 * Double.valueOf(layer + 1).doubleValue();
		root.cpb = root.cpt = 0.02;
		fine.layer = layer;
		fine.sink_source_a = 0.0002 * Double.valueOf(layer + 1).doubleValue();
		fine.sink_source_b = 0.03 + 0.01 * layer;
		fine.r = 0.0;
		fine.xp = 0.0;
		fine.cpb = fine.cpt = 0.02;
	}

	private static void assertSimpleRootChain(int layerCount) {
		StructuralRoot[] roots = new StructuralRoot[layerCount];
		FineRoot[] fineRoots = new FineRoot[layerCount];
		double[] expectedFoldA = new double[layerCount];
		double[] expectedFoldB = new double[layerCount];
		CarbonTransportSolveContext ctx = new CarbonTransportSolveContext();
		ctx.foldStep = 100 + layerCount;
		ctx.unfoldStep = 200 + layerCount;
		ctx.dampingFactor = 1.0;
		ctx.simpleRootActive = true;
		ctx.simpleRootTopologyValid = true;
		ctx.simpleRootFoldValid = true;
		ctx.simpleRootUnfoldValid = true;
		ctx.simpleStructuralRootExpected = layerCount;
		ctx.simpleFineRootExpected = layerCount;

		int layer;
		for (layer = 0; layer < layerCount; layer++) {
			roots[layer] = new StructuralRoot();
			fineRoots[layer] = new FineRoot();
			configureSimpleRootLayer(roots[layer], fineRoots[layer], layer);
		}

		for (layer = layerCount - 1; layer >= 0; layer--) {
			double rawA = roots[layer].sink_source_a
				+ fineRoots[layer].sink_source_a;
			double rawB = roots[layer].sink_source_b
				+ fineRoots[layer].sink_source_b;
			StructuralRoot child = null;
			if (layer < layerCount - 1) {
				rawA += expectedFoldA[layer + 1];
				rawB += expectedFoldB[layer + 1];
				child = roots[layer + 1];
			}
			double denominator = 1.0 + rawB * roots[layer].r;
			expectedFoldA[layer] = (rawA - rawB * roots[layer].xp)
				/ denominator;
			expectedFoldB[layer] = rawB / denominator;

			assertTrue(foldSimpleRootSegment(
				roots[layer], fineRoots[layer], child, ctx));
			assertEquals(expectedFoldA[layer],
				roots[layer].branch_flux_a, 1.0e-7);
			assertEquals(expectedFoldB[layer],
				roots[layer].branch_flux_b, 1.0e-7);
		}
		roots[0].foldRecv++;

		assertEquals(layerCount, ctx.simpleStructuralRootFolded);
		assertEquals(layerCount, ctx.simpleFineRootFolded);
		assertEquals(0, ctx.simpleRootDoubleFoldCount);
		for (layer = 0; layer < layerCount; layer++) {
			assertEquals(1, roots[layer].foldRecv);
			assertEquals(1, fineRoots[layer].foldRecv);
			assertEquals(ctx.foldStep, roots[layer].lastFoldStep);
			assertEquals(ctx.foldStep, fineRoots[layer].lastFoldStep);
		}

		double upstreamPhi = 0.02;
		double localRootCurrent = 0.0;
		for (layer = 0; layer < layerCount; layer++) {
			assertTrue(unfoldSimpleRootSegment(
				roots[layer], fineRoots[layer], upstreamPhi,
				1000L + layer, ctx));
			roots[layer].j = roots[layer].sink_source_a
				+ roots[layer].sink_source_b * roots[layer].cpt;
			fineRoots[layer].j = fineRoots[layer].sink_source_a
				+ fineRoots[layer].sink_source_b * fineRoots[layer].cpt;
			localRootCurrent += roots[layer].j + fineRoots[layer].j;
			upstreamPhi = roots[layer].cpt;
		}
		double foldedRootCurrent = roots[0].branch_flux_a
			+ roots[0].branch_flux_b * 0.02;
		assertEquals(localRootCurrent, foldedRootCurrent, 1.0e-9);
		assertEquals(layerCount, ctx.simpleStructuralRootUnfolded);
		assertEquals(layerCount, ctx.simpleFineRootUnfolded);
		for (layer = 0; layer < layerCount; layer++) {
			assertEquals(1, roots[layer].unfoldRecv);
			assertEquals(1, fineRoots[layer].unfoldRecv);
			assertEquals(ctx.unfoldStep, roots[layer].lastUnfoldStep);
			assertEquals(ctx.unfoldStep, fineRoots[layer].lastUnfoldStep);
		}
	}

	@Test
	public void oneLayerSimpleRootFoldsAndUnfoldsWithFullCoverage() {
		assertSimpleRootChain(1);
	}

	@Test
	public void twoLayerSimpleRootTransformsEveryStructuralRootOnce() {
		assertSimpleRootChain(2);
	}

	@Test
	public void fourLayerSimpleRootMatchesDirectRecursiveFold() {
		assertSimpleRootChain(4);
	}

	@Test
	public void simpleRootDoubleFoldIsRejected() {
		StructuralRoot root = new StructuralRoot();
		FineRoot fine = new FineRoot();
		configureSimpleRootLayer(root, fine, 0);
		CarbonTransportSolveContext ctx = new CarbonTransportSolveContext();
		ctx.foldStep = 9;
		ctx.simpleRootFoldValid = true;
		assertTrue(foldSimpleRootSegment(root, fine, null, ctx));
		assertFalse(foldSimpleRootSegment(root, fine, null, ctx));
		assertEquals(1, ctx.simpleRootDoubleFoldCount);
		assertFalse(ctx.simpleRootFoldValid);
	}

	@Test
	public void legacyTwoLayerDoubleTransformDiffersFromCorrectFold() {
		GrowingOrgan parent = new GrowingOrgan();
		parent.r = 0.25;
		parent.xp = 0.0002;
		parent.branch_flux_a = 0.004;
		parent.branch_flux_b = 0.8;
		parent.Update_Branch_Flux();
		double parentAlreadyFoldedA = parent.branch_flux_a;
		double parentAlreadyFoldedB = parent.branch_flux_b;
		double childFoldedA = 0.003;
		double childFoldedB = 0.4;
		parent.branch_flux_a += childFoldedA;
		parent.branch_flux_b += childFoldedB;
		parent.Update_Branch_Flux();

		double correctRawA = 0.004 + childFoldedA;
		double correctRawB = 0.8 + childFoldedB;
		double correctDenominator = 1.0 + correctRawB * 0.25;
		double correctFoldA = (correctRawA - correctRawB * 0.0002)
			/ correctDenominator;
		double correctFoldB = correctRawB / correctDenominator;
		assertTrue(Math.abs(parent.branch_flux_a - correctFoldA) > 1.0e-5);
		assertTrue(Math.abs(parent.branch_flux_b - correctFoldB) > 1.0e-3);
		assertTrue(parentAlreadyFoldedA != 0.004
			|| parentAlreadyFoldedB != 0.8);
	}

	@Test
	public void multipleChildrenAreSummedBeforeOneResistanceTransform() {
		// Update_Branch_Flux is defined by GrowingOrgan and is the exact
		// resistance transform used by Petiole after its children are collected.
		GrowingOrgan segment = new GrowingOrgan();
		segment.r = 0.4;
		segment.xp = 0.003;
		double ownA = -0.03, ownB = 1.2;
		double child1A = 0.01, child1B = 0.5;
		double child2A = 0.02, child2B = 0.7;
		double sumA = ownA + child1A + child2A;
		double sumB = ownB + child1B + child2B;
		double denominator = 1.0 + sumB * segment.r;
		segment.branch_flux_a = sumA;
		segment.branch_flux_b = sumB;
		segment.Update_Branch_Flux();

		assertEquals((sumA - sumB * segment.xp) / denominator,
			segment.branch_flux_a, 1.0e-7);
		assertEquals(sumB / denominator, segment.branch_flux_b, 1.0e-7);
	}

	@Test
	public void branchedStructuralRootTransformPreservesLocalFoldIdentity() {
		// StructuralRoot uses the inherited transform after deterministic
		// post-order child accumulation; use its instantiable base as the fixture.
		GrowingOrgan parent = new GrowingOrgan();
		parent.r = 0.2;
		parent.xp = 0.001;
		double localA = -0.04;
		double localB = 1.1;
		double childA = 0.03;
		double childB = 0.9;
		double distalA = localA + childA;
		double distalB = localB + childB;
		parent.branch_flux_a = distalA;
		parent.branch_flux_b = distalB;
		parent.Update_Branch_Flux();
		double basalPhi = 0.006;
		double distalPhi = (basalPhi - distalA * parent.r - parent.xp)
			/ (1.0 + distalB * parent.r);
		double localCurrent = distalA + distalB * distalPhi;
		double foldedCurrent = parent.branch_flux_a
			+ parent.branch_flux_b * basalPhi;

		assertEquals(localCurrent, foldedCurrent, 1.0e-7);
	}

	@Test
	public void unfoldOwnerRejectsASecondTransportWriter() {
		GrowingOrgan organ = new GrowingOrgan();
		CarbonTransportSolveContext context =
			new CarbonTransportSolveContext();
		context.unfoldStep = 7;
		assertTrue(claimCarbonUnfoldOwner(organ, 11L, context));
		assertFalse(claimCarbonUnfoldOwner(organ, 12L, context));
		assertEquals(2, organ.unfoldRecv);
		assertEquals(11L, organ.lastWriterId);
	}

	@Test
	public void validOrganTrialUsesCurrentHalfDamping() {
		CarbonTransportSolveContext ctx = new CarbonTransportSolveContext();
		double accepted = underRelaxOrganPhi(0.001, 0.003, 0.5, ctx);
		assertEquals(0.002, accepted, 1e-15);
		assertFalse(ctx.invalidUnfoldTrial);
	}

	@Test
	public void largePositiveOrganTrialIsDamped() {
		CarbonTransportSolveContext ctx = new CarbonTransportSolveContext();
		double accepted = underRelaxOrganPhi(0.001, 0.101, 0.5, ctx);
		assertEquals(0.051, accepted, 1e-15);
		assertTrue(accepted < 0.101);
	}

	@Test
	public void negativeOrganTrialRetainsPreviousPhi() {
		CarbonTransportSolveContext ctx = new CarbonTransportSolveContext();
		double accepted = underRelaxOrganPhi(0.002, -0.1, 0.5, ctx);
		assertEquals(0.002, accepted, 0.0);
		assertTrue(ctx.invalidUnfoldTrial);
		assertEquals(1, ctx.invalidUnfoldTrialCount);
		assertEquals(1, ctx.totalInvalidUnfoldTrialCount);
	}

	@Test
	public void nonFiniteOrganTrialsRetainPreviousPhi() {
		CarbonTransportSolveContext nanContext = new CarbonTransportSolveContext();
		CarbonTransportSolveContext infContext = new CarbonTransportSolveContext();
		assertEquals(0.002,
			underRelaxOrganPhi(0.002, Double.NaN, 0.5, nanContext), 0.0);
		assertEquals(0.002,
			underRelaxOrganPhi(0.002, Double.POSITIVE_INFINITY, 0.5, infContext), 0.0);
		assertTrue(nanContext.invalidUnfoldTrial);
		assertTrue(infContext.invalidUnfoldTrial);
	}

	@Test
	public void invalidOrganTrialForcesNonConvergenceAndLowerDamping() {
		CarbonTransportSolveContext ctx = new CarbonTransportSolveContext();
		ctx.converged = true;
		underRelaxOrganPhi(0.002, -1.0, 0.5, ctx);
		assertFalse(ctx.converged);
		assertEquals(0.25,
			adaptCtDampingFactor(0.5, 1.0, Double.POSITIVE_INFINITY), 0.0);
	}

	@Test
	public void normalLimitTriggersExactlyOneRetry() {
		CarbonTransportSolveContext normal = new CarbonTransportSolveContext();
		normal.iterationCount = CT_MAX_ITERATIONS;
		normal.maxIterationReached = true;
		normal.converged = false;
		assertTrue(shouldStartCarbonTransportRetry(normal));

		CarbonTransportSolveContext retry = createCarbonTransportRetryContext(normal);
		retry.iterationCount = CT_RETRY_MAX_ITERATIONS;
		retry.maxIterationReached = true;
		assertFalse("A retry failure must not trigger a second retry",
			shouldStartCarbonTransportRetry(retry));
	}

	@Test
	public void finiteNormalTrialWarmStartsRetryButInvalidTrialRollsBack() {
		CarbonTransportSolveContext finiteNormal =
			new CarbonTransportSolveContext();
		finiteNormal.failedTrialCaptured = true;
		finiteNormal.totalInvalidUnfoldTrialCount = 0;
		assertTrue(shouldWarmStartCarbonTransportRetry(finiteNormal));

		finiteNormal.totalInvalidUnfoldTrialCount = 1;
		assertFalse(shouldWarmStartCarbonTransportRetry(finiteNormal));
		finiteNormal.failedTrialCaptured = false;
		finiteNormal.totalInvalidUnfoldTrialCount = 0;
		assertFalse(shouldWarmStartCarbonTransportRetry(finiteNormal));
	}

	@Test
	public void retryStartsAtPointOneWithSixtyIterationLimit() {
		CarbonTransportSolveContext retry =
			createCarbonTransportRetryContext(new CarbonTransportSolveContext());
		assertTrue(retry.retryUsed);
		assertEquals(CT_RETRY_DAMPING_INITIAL, retry.dampingFactor, 0.0);
		assertEquals(0.1, retry.dampingFactor, 0.0);
		assertEquals(60, retry.finalIterationLimit);
	}

}

public class ModelUnitTest {
	private static double mm(double sugar, double km) {
		return sugar / (km + sugar);
	}

	@Before
	public void setup() {
		mainInstance.resetGraph();	
		mainInstance.init();	
        derive();
	}

	@Test
	public void plantBaseCarbonTransportInitializationSynchronizesSugarFromPhi() {
		PlantBase plant = new PlantBase();
		plant.initializeCarbonTransport();
		assertTrue(plant.cpt > 0.0);
		assertTrue(plant.cpb > 0.0);
		assertTrue(plant.sugarConcentration_phloem > 0.0);
		assertEquals(sugarFromCp(plant.cpt),
			plant.sugarConcentration_phloem, 1e-15);
		assertEquals(plant.sugarConcentration_phloem,
			plant.sugarConcentration_phloem_pre, 0.0);
		assertFalse(hasAcceptedHourlyCarbonTransportState(plant));
		verifyPlantBaseSugarForOutput(
			plant, plant.sugarConcentration_phloem);
	}

	@Test
	public void failedTrialDiagnosticsAreCapturedBeforeRollback() {
		PlantBase plant = first((* failedTrialPb:PlantBase *));
		assertNotNull(plant);
		plant.cpb = plant.cpt = 0.003;
		plant.sugarConcentration_phloem = sugarFromCp(plant.cpt);
		CarbonTransportSolveContext failedTrial =
			new CarbonTransportSolveContext();
		failedTrial.converged = false;
		failedTrial.nonlinearMerit = 12.5;
		captureFailedCarbonTransportTrial(plant, failedTrial);
		assertTrue(failedTrial.failedTrialCaptured);
		assertEquals(plant.cpt,
			failedTrial.failedTrialPlantBasePhi, 0.0);
		assertEquals(sugarFromCp(plant.cpt),
			failedTrial.failedTrialPlantBaseSugar, 0.0);
		assertTrue(failedTrial.failedTrialMinSugar >= 0.0);
		assertTrue(failedTrial.failedTrialMaxSugar
			>= failedTrial.failedTrialMinSugar);
		assertTrue(failedTrial.failedTrialMeanSugar
			>= failedTrial.failedTrialMinSugar);
		assertTrue(failedTrial.failedTrialMeanSugar
			<= failedTrial.failedTrialMaxSugar);
		assertEquals(12.5, failedTrial.failedTrialMerit, 0.0);
	}

	@Test
	public void carbonTransportSnapshotRestoresStateAndResistance() {
		PlantBase plant = first((* snapshotPb:PlantBase *));
		assertNotNull(plant);
		GrowingOrgan organ = first((* snapshotGrowing:GrowingOrgan, (
			snapshotGrowing.plantNumber == plant.plantNumber
		) *));
		assertNotNull(organ);
		updateResistence(plant);
		plant.sugarConcentration_phloem = sugarFromCp(plant.cpt);
		plant.sugarConcentration_phloem_pre = 0.0;
		CarbonTransportStateSnapshot snapshot = snapshotCarbonTransportState(plant);
		double acceptedCpb = organ.cpb;
		double acceptedCpt = organ.cpt;
		double acceptedJ = organ.j;
		double acceptedR = organ.r;
		double acceptedXp = organ.xp;
		double acceptedUnloading = organ.unloading;
		double acceptedPlantPhi = plant.cpt;
		double acceptedPlantSugar = sugarFromCp(acceptedPlantPhi);

		organ.cpb = 0.9;
		organ.cpt = 0.8;
		organ.j = 0.7;
		organ.r = 123.0;
		organ.xp = 456.0;
		organ.unloading = 789.0;
		plant.cpb = plant.cpt = acceptedPlantPhi + 0.25;
		plant.sugarConcentration_phloem = 0.99;
		restoreCarbonTransportState(plant, snapshot);

		assertEquals(acceptedCpb, organ.cpb, 0.0);
		assertEquals(acceptedCpt, organ.cpt, 0.0);
		assertEquals(acceptedJ, organ.j, 0.0);
		assertEquals(acceptedR, organ.r, 1e-15);
		assertEquals(acceptedXp, organ.xp, 1e-15);
		assertEquals(acceptedUnloading, organ.unloading, 0.0);
		assertEquals(acceptedPlantSugar, plant.sugarConcentration_phloem, 0.0);
		assertEquals(sugarFromCp(plant.cpt),
			plant.sugarConcentration_phloem, 0.0);
		assertEquals(acceptedPlantSugar,
			plant.sugarConcentration_phloem_pre, 0.0);
	}

	@Test
	public void firstHourRetryFailureUsesInitializedStateOnceAsBootstrap() {
		PlantBase plant = new PlantBase();
		plant.plantNumber = -987655;
		plant.initializeCarbonTransport();
		prepareInitialCarbonTransportSnapshotState(plant);
		CarbonTransportStateSnapshot snapshot = snapshotCarbonTransportState(plant);
		double initializedPhi = plant.cpt;

		plant.cpb = plant.cpt = initializedPhi + 0.5;
		plant.sugarConcentration_phloem = 0.0;
		CarbonTransportSolveContext failedRetry = new CarbonTransportSolveContext();
		failedRetry.retryUsed = true;
		failedRetry.maxIterationReached = true;
		failedRetry.iterationCount = CT_RETRY_MAX_ITERATIONS;

		assertFalse(finalizeCarbonTransportState(plant, snapshot, failedRetry));
		assertFalse(failedRetry.converged);
		assertTrue(failedRetry.retryUsed);
		assertFalse(failedRetry.retryConverged);
		assertTrue(failedRetry.solverFallbackUsed);
		assertTrue(failedRetry.maxIterationReached);
		assertEquals(initializedPhi, plant.cpt, 0.0);
		assertTrue(plant.sugarConcentration_phloem > 0.0);
		assertEquals(sugarFromCp(plant.cpt),
			plant.sugarConcentration_phloem, 0.0);
		assertEquals(1, failedRetry.carbonStatusUpdateCount);
		assertTrue(failedRetry.bootstrapFallbackUsed);
		assertFalse(hasAcceptedHourlyCarbonTransportState(plant));
	}

	@Test
	public void laterRetryFailureRestoresAcceptedHourWithoutStatusCommit() {
		PlantBase plant = first((* failurePb:PlantBase *));
		assertNotNull(plant);
		GrowingOrgan organ = first((* failureGrowing:GrowingOrgan, (
			failureGrowing.plantNumber == plant.plantNumber
		) *));
		assertNotNull(organ);
		plant.cpb = plant.cpt = 0.003;
		plant.sugarConcentration_phloem = sugarFromCp(plant.cpt);
		plant.sugarConcentration_phloem_pre = plant.sugarConcentration_phloem;
		setAcceptedHourlyCarbonTransportState(plant, true);
		CarbonTransportStateSnapshot snapshot = snapshotCarbonTransportState(plant);
		double acceptedPlantPhi = plant.cpt;
		double acceptedPlantSugar = plant.sugarConcentration_phloem;
		double acceptedCpt = organ.cpt;
		double acceptedJ = organ.j;
		double acceptedUnloading = organ.unloading;
		organ.cpt = acceptedCpt + 0.5;
		organ.j = acceptedJ + 0.5;
		organ.unloading = acceptedUnloading + 0.5;
		plant.cpb = plant.cpt = 0.9;
		plant.sugarConcentration_phloem = 0.0;

		CarbonTransportSolveContext failedRetry = new CarbonTransportSolveContext();
		failedRetry.retryUsed = true;
		failedRetry.maxIterationReached = true;
		failedRetry.iterationCount = CT_RETRY_MAX_ITERATIONS;
		assertFalse(finalizeCarbonTransportState(plant, snapshot, failedRetry));
		assertTrue(failedRetry.solverFallbackUsed);
		assertFalse(failedRetry.bootstrapFallbackUsed);
		assertFalse(failedRetry.retryConverged);
		assertEquals("Failed trials must never call updateCarbonStatus",
			0, failedRetry.carbonStatusUpdateCount);
		assertEquals(acceptedCpt, organ.cpt, 0.0);
		assertEquals(acceptedJ, organ.j, 0.0);
		assertEquals(acceptedUnloading, organ.unloading, 0.0);
		assertEquals(acceptedPlantPhi, plant.cpt, 0.0);
		assertEquals(acceptedPlantSugar,
			plant.sugarConcentration_phloem, 0.0);
		assertTrue(hasAcceptedHourlyCarbonTransportState(plant));
	}

	@Test
	public void successfulFirstSolveReplacesInitializedStateWithoutBootstrap() {
		PlantBase plant = new PlantBase();
		plant.plantNumber = -987656;
		plant.initializeCarbonTransport();
		prepareInitialCarbonTransportSnapshotState(plant);
		CarbonTransportStateSnapshot snapshot = snapshotCarbonTransportState(plant);
		double initializedPhi = plant.cpt;
		double solvedPhi = initializedPhi + 0.002;
		plant.cpb = plant.cpt = solvedPhi;
		plant.sugarConcentration_phloem = sugarFromCp(solvedPhi);
		plant.sugarConcentration_phloem_pre = plant.sugarConcentration_phloem;

		CarbonTransportSolveContext successfulNormal =
			new CarbonTransportSolveContext();
		successfulNormal.converged = true;
		assertTrue(finalizeCarbonTransportState(
			plant, snapshot, successfulNormal));
		assertEquals(solvedPhi, plant.cpt, 0.0);
		assertTrue(plant.cpt != initializedPhi);
		assertFalse(successfulNormal.retryUsed);
		assertFalse(successfulNormal.retryConverged);
		assertFalse(successfulNormal.solverFallbackUsed);
		assertFalse(successfulNormal.bootstrapFallbackUsed);
		assertEquals(1, successfulNormal.carbonStatusUpdateCount);
		assertTrue(hasAcceptedHourlyCarbonTransportState(plant));
	}

	@Test
	public void retrySuccessIsAcceptedWithOneStatusCommit() {
		PlantBase plant = new PlantBase();
		plant.plantNumber = -987654;
		plant.cpb = plant.cpt = 0.001;
		plant.sugarConcentration_phloem = sugarFromCp(plant.cpt);
		plant.sugarConcentration_phloem_pre = plant.sugarConcentration_phloem;
		assertFalse(hasAcceptedHourlyCarbonTransportState(plant));
		CarbonTransportStateSnapshot snapshot = snapshotCarbonTransportState(plant);
		CarbonTransportSolveContext successfulRetry =
			createCarbonTransportRetryContext(new CarbonTransportSolveContext());
		successfulRetry.converged = true;
		assertTrue(finalizeCarbonTransportState(
			plant, snapshot, successfulRetry));
		assertTrue(successfulRetry.retryConverged);
		assertFalse(successfulRetry.solverFallbackUsed);
		assertEquals(1, successfulRetry.carbonStatusUpdateCount);
		assertTrue(hasAcceptedHourlyCarbonTransportState(plant));
	}

	    @Test
	    public void assertStartingStepTest() {
    	int expected = 0;
        int actual = step;
    	assertEquals(expected, actual);
	    }

	@Test
	public void virtualFruitUsesSignedDirectMassFlowAcrossCandidates() {
		VirtualFruit fruit = first((* vf:VirtualFruit *));
		if (fruit == null) {
			mainInstance.run();
			fruit = first((* vf:VirtualFruit *));
		}
		assertNotNull("Default apple graph must contain a VirtualFruit fixture", fruit);

		double referenceSugar = 0.15;
		double km = 0.072;
		double cachedActive = 10.0;
		double cachedMassFlow = 2.0;
		double previousReference = fruit.sugarConcentration_phloem_pre;
		double previousWaterFlowReference = fruit.massFlowWaterFlowReference;
		double previousUnloadingPerFruit = fruit.unloadingPerFruit;
		double previousActiveReference = fruit.activeUnloadingReference;
		double previousMassFlowReference = fruit.massFlowUnloadingReference;
		boolean previousMassFlowReferenceInitialized =
			fruit.massFlowUnloadingReferenceInitialized;
		double previousFruitSugar = fruit.sugarConcentration_fruit;
		double previousSugarUptakeActive = fruit.sugarUptake_active;
		double previousSugarUptakeMassFlow = fruit.sugarUptake_massflow;
		double previousSugarUptakePassive = fruit.sugarUptake_passive;
		double previousWaterUptakePhloem = fruit.waterUptake_phloem;
		double previousKmPri = fruit.km_pri;
		double previousAge = fruit.age;
		double previousCpb = fruit.cpb;
		double previousCpt = fruit.cpt;
		double previousMaintenancePt = fruit.maintenanceDM_PT;
		double previousStructurePriPt = fruit.structureDM_PRI_PT;
		double previousStructureSecPt = fruit.structureDM_SEC_PT;
		double previousStructure = fruit.structureDM;
		double previousStructurePri = fruit.structureDM_PRI;
		double previousStructureSec = fruit.structureDM_SEC;
		double previousUnloading = fruit.unloading;
		boolean previousCalcCarbonAllocation = calcCarbonAllocation;
		boolean previousEnablePreT1 = enablePotentialGrowthBeforeT1;
		boolean previousPreT1Active = preT1PotentialGrowthActive;
		boolean previousStaticArc = useStaticArc;
		try {
			calcCarbonAllocation = true;
			enablePotentialGrowthBeforeT1 = false;
			preT1PotentialGrowthActive = false;
			useStaticArc = false;
			fruit.commitVirtualFruitImportReferences(cachedActive,
				cachedMassFlow, referenceSugar, 0.5);
			fruit.sugarConcentration_fruit = 0.08;
			fruit.sugarUptake_passive = 7.0;
			fruit.km_pri = km;
			fruit.age = Math.max(1.0, fruit.age);

			double[] candidates = {0.03, 0.08, 0.15, 0.03};
			double[] expectedMassFlow = {0.4, 16.0 / 15.0, 2.0, 0.4};
			double[] realisedActive = new double[candidates.length];
			double firstUnloading = 0.0;
			for (int i = 0; i < candidates.length; i++) {
				fruit.updateCarbonAllocation(candidates[i]);
				realisedActive[i] = fruit.structureDM_PRI;
				if (i == 0) firstUnloading = fruit.unloading;
				assertEquals("Fruit mass flow must bypass the maintenance channel",
					0.0, fruit.maintenanceDM_PT, 0.0);
				assertEquals(0.0, fruit.structureDM_SEC_PT, 0.0);
				assertEquals(0.0, fruit.structureDM_SEC, 0.0);
				assertEquals(expectedMassFlow[i],
					fruit.getDirectMassFlowCarbon(candidates[i]), 1.0e-12);
				assertEquals("Passive JFruit2 import must not enter unloading",
					fruit.structureDM_PRI + expectedMassFlow[i],
					fruit.unloading, 1.0e-12);
			}

			assertEquals("Candidate evaluation must not mutate the JFruit2 reference",
				referenceSugar, fruit.sugarConcentration_phloem_pre, 0.0);
			assertEquals(cachedMassFlow, fruit.massFlowUnloadingReference, 0.0);
			assertEquals(0.5, fruit.massFlowWaterFlowReference, 0.0);
			assertEquals("Repeated candidates must be order independent",
				firstUnloading, fruit.unloading, 0.0);
			assertTrue("Active uptake must still rise through KM_PRI",
				realisedActive[0] < realisedActive[1]
					&& realisedActive[1] < realisedActive[2]);
			assertEquals("Primary PT must contain only active import and undo reference MM once",
				cachedActive / (referenceSugar / (km + referenceSugar)),
				fruit.structureDM_PRI_PT, 1.0e-12);
			assertEquals("Realised structure must contain only active import",
				fruit.structureDM_PRI, fruit.structureDM, 0.0);
			assertEquals(previousSugarUptakeActive, fruit.sugarUptake_active, 0.0);
			assertEquals(previousSugarUptakeMassFlow, fruit.sugarUptake_massflow, 0.0);
			assertEquals(previousWaterUptakePhloem, fruit.waterUptake_phloem, 0.0);

			double candidateCarbon = convertSugarToPhloemC(0.20f);
			fruit.cpb = fruit.cpt = 0.5 * candidateCarbon * candidateCarbon;
			lineariseOrgan(fruit);
			double reconstructed = (fruit.sink_source_a
				+ fruit.sink_source_b * fruit.cpt) / mgTogram;
			assertEquals("CT A+B*Phi must match exact CP/direct unloading at Phi0",
				fruit.unloading, reconstructed, 2.0e-5);
			assertEquals(0.0, fruit.maintenanceDM_PT, 0.0);
			assertEquals(cachedMassFlow, fruit.massFlowUnloadingReference, 0.0);
			assertEquals(referenceSugar, fruit.sugarConcentration_phloem_pre, 0.0);
			assertEquals(0.5, fruit.massFlowWaterFlowReference, 0.0);

			fruit.commitVirtualFruitImportReferences(cachedActive,
				-3.0, referenceSugar, -0.4);
			fruit.updateCarbonAllocation(0.08);
			assertEquals("Accepted outward JFruit2 flow is fixed and signed next hour",
				-3.0, fruit.getDirectMassFlowCarbon(0.08), 0.0);
			assertEquals(0.0, fruit.getDirectMassFlowDerivativePhi(
				fruit.cpt, 0.08), 0.0);
		} finally {
			fruit.sugarConcentration_phloem_pre = previousReference;
			fruit.massFlowWaterFlowReference = previousWaterFlowReference;
			fruit.unloadingPerFruit = previousUnloadingPerFruit;
			fruit.activeUnloadingReference = previousActiveReference;
			fruit.massFlowUnloadingReference = previousMassFlowReference;
			fruit.massFlowUnloadingReferenceInitialized =
				previousMassFlowReferenceInitialized;
			fruit.sugarConcentration_fruit = previousFruitSugar;
			fruit.sugarUptake_active = previousSugarUptakeActive;
			fruit.sugarUptake_massflow = previousSugarUptakeMassFlow;
			fruit.sugarUptake_passive = previousSugarUptakePassive;
			fruit.waterUptake_phloem = previousWaterUptakePhloem;
			fruit.km_pri = previousKmPri;
			fruit.age = previousAge;
			fruit.cpb = previousCpb;
			fruit.cpt = previousCpt;
			fruit.maintenanceDM_PT = previousMaintenancePt;
			fruit.structureDM_PRI_PT = previousStructurePriPt;
			fruit.structureDM_SEC_PT = previousStructureSecPt;
			fruit.structureDM = previousStructure;
			fruit.structureDM_PRI = previousStructurePri;
			fruit.structureDM_SEC = previousStructureSec;
			fruit.unloading = previousUnloading;
			calcCarbonAllocation = previousCalcCarbonAllocation;
			enablePotentialGrowthBeforeT1 = previousEnablePreT1;
			preT1PotentialGrowthActive = previousPreT1Active;
			useStaticArc = previousStaticArc;
		}
	}

	@Test
	public void waterFluxSolverDebugOutputIsConditionalAndReadOnly() throws Exception {
		PlantBase pb = findOutputPlantBase();
		assertNotNull(pb);
		Leaf focalLeaf = first((* l:Leaf, (
			l.plantNumber == pb.plantNumber &&
			l.fieldInstanceId == pb.fieldInstanceId &&
			l.isReportable == pb.isReportable
		) *));
		if (focalLeaf == null) {
			mainInstance.run();
			pb = findOutputPlantBase();
			assertNotNull(pb);
			focalLeaf = first((* l:Leaf, (
				l.plantNumber == pb.plantNumber &&
				l.fieldInstanceId == pb.fieldInstanceId &&
				l.isReportable == pb.isReportable
			) *));
		}
		assertNotNull(focalLeaf);

		double meanAnetBefore = pb.meanAnet;
		double carbonAssimilationBefore = pb.carbonAssimilation;
		double waterFluxBefore = pb.waterFlux_optimized;
		double xylemPotentialBefore = pb.xylemWaterPotential;
		double biomassBefore = pb.biomass;
		double unloadingBefore = pb.totalUnloading;
		double reserveDemandBefore = pb.cordonReserveDM;
		double absorbedParBefore = pb.leafPAR;
		double leafAnetBefore = focalLeaf.AlimActual;
		double leafPotentialBefore = focalLeaf.waterPotential;
		double leafGsBefore = focalLeaf.gs;
		double leafIncidentParBefore = focalLeaf.incPARm2;

		File debugCsv = new File(waterFluxSolverDebugOutputFilePath);
		File debugMetadata = new File(waterFluxSolverDebugMetadataFilePath);
		debugCsv.delete();
		debugMetadata.delete();
		boolean previousDebugSetting = outputWaterFluxSolverDebug;
		try {
			outputWaterFluxSolverDebug = false;
			DiagnosticTableCoordinator.initialize(
				PATH_OUTPUT, outputTable_name, false, false, false, false);
			writeWaterFluxSolverDebug(pb);
			assertFalse("Disabled solver debug output must not create a CSV", debugCsv.exists());
			assertFalse("Disabled solver debug output must not create metadata", debugMetadata.exists());

			outputWaterFluxSolverDebug = true;
			DiagnosticTableCoordinator.initialize(
				PATH_OUTPUT, outputTable_name, true, false, false, false);
			writeWaterFluxSolverDebug(pb);
			assertTrue("Enabled solver debug output must create a CSV", debugCsv.isFile());
			assertTrue("Enabled solver debug output must create metadata", debugMetadata.isFile());

			BufferedReader reader = new BufferedReader(new FileReader(debugCsv));
			String headerLine;
			String valueLine;
			try {
				headerLine = reader.readLine();
				valueLine = reader.readLine();
			} finally {
				reader.close();
			}
			assertNotNull(headerLine);
			assertNotNull(valueLine);
			String[] headers = headerLine.split(",", -1);
			String[] values = valueLine.split(",", -1);
			assertEquals(21, headers.length);
			assertEquals(headers.length, values.length);
			assertEquals("waterFluxSolverResidual", headers[8]);
			assertEquals(pb.waterFluxSolverResidual, Double.parseDouble(values[8]), 0.0);
			assertEquals(pb.waterFluxSolverFallbackUsed, Integer.parseInt(values[9]));
			assertEquals(pb.waterFluxSolverAccepted, Integer.parseInt(values[10]));
			assertEquals(pb.meanLeafWaterPotential_solver, Double.parseDouble(values[11]), 0.0);
			assertEquals(pb.minLeafWaterPotential_solver, Double.parseDouble(values[12]), 0.0);
			assertEquals(pb.maxLeafWaterPotential_solver, Double.parseDouble(values[13]), 0.0);
			assertEquals(pb.meanPLC_leaf_solver, Double.parseDouble(values[14]), 0.0);
			assertEquals(pb.meanGs_solver, Double.parseDouble(values[15]), 0.0);
			assertEquals(pb.waterFluxSolverLowerBound, Double.parseDouble(values[16]), 0.0);
			assertEquals(pb.waterFluxSolverUpperBound, Double.parseDouble(values[17]), 0.0);
			assertEquals(pb.waterFluxSolverLeafSum, Double.parseDouble(values[18]), 0.0);
			assertEquals(pb.waterFluxSolverRepeatedResidualDelta, Double.parseDouble(values[19]), 0.0);
			assertEquals("waterFluxSolverEvalCount", headers[20]);
			assertEquals(pb.waterFluxSolverEvalCount, Integer.parseInt(values[20]));

			assertEquals(meanAnetBefore, pb.meanAnet, 0.0);
			assertEquals(carbonAssimilationBefore, pb.carbonAssimilation, 0.0);
			assertEquals(waterFluxBefore, pb.waterFlux_optimized, 0.0);
			assertEquals(xylemPotentialBefore, pb.xylemWaterPotential, 0.0);
			assertEquals(biomassBefore, pb.biomass, 0.0);
			assertEquals(unloadingBefore, pb.totalUnloading, 0.0);
			assertEquals(reserveDemandBefore, pb.cordonReserveDM, 0.0);
			assertEquals(absorbedParBefore, pb.leafPAR, 0.0);
			assertEquals(leafAnetBefore, focalLeaf.AlimActual, 0.0);
			assertEquals(leafPotentialBefore, focalLeaf.waterPotential, 0.0);
			assertEquals(leafGsBefore, focalLeaf.gs, 0.0);
			assertEquals(leafIncidentParBefore, focalLeaf.incPARm2, 0.0);
		} finally {
			outputWaterFluxSolverDebug = previousDebugSetting;
			DiagnosticTableCoordinator.initialize(
				PATH_OUTPUT, outputTable_name,
				outputWaterFluxSolverDebug,
				outputLeafGrowthDiagnostics,
				outputCarbonTransportDiagnostics,
				outputAppleDevelopmentDiagnostics);
			debugCsv.delete();
			debugMetadata.delete();
		}
	}

    
    @Test
    public void assertTenStepTest() {
    	int expected = 10;    	
    	for(int i = 0; i < expected; i++) {
    		mainInstance.run();
    	}
    	
        int actual = step;
    	assertEquals("Step should be equal to 10", expected, actual);
    	assert continueRunning;
    	
    	
    	PlantBase pb = null;
		try {
			pb = first((* p:PlantBase, (p.plantNumber == INDI_ID_A) *));
		} catch (Exception e) {
			println("Error locating PlantBase: " + e.getMessage());
		} 
	 	
	 	 if(pb != null) { 	 
			assertFalse("waterFlux_optimized should not be NaN", Double.isNaN(pb.waterFlux_optimized));
			assertFalse("sugarConcentration_phloem should not be NaN", Double.isNaN(pb.sugarConcentration_phloem));
			assertFalse("totalLoading should not be NaN", Double.isNaN(pb.totalLoading));
			assertFalse("totalUnloading should not be NaN", Double.isNaN(pb.totalUnloading));
		 }
    }
       
    
	  @Test
		public void assertNodeCount() {
			mainInstance.run();
			int expected = nrRows * nrPlants;
			int actual = (int) count((*pb:PlantBase*));
			assertEquals("Mismatch in PlantBase count: expected " + expected + ", but got " + actual, expected, actual);
	
			int leafCount = array((*l:Leaf, (l.plantNumber == INDI_ID_A)*)).length;
			int internodeCount = array((*l:Internode, (l.plantNumber == INDI_ID_A)*)).length;
			int fruitCount = array((*l:FruitService, (l.plantNumber == INDI_ID_A)*)).length;
	
			assertEquals("Leaf array length mismatch: expected 16, got " + leafCount, 14, leafCount);
			assertEquals("Internode array length mismatch: expected 16, got " + internodeCount, 16, internodeCount);
			assertEquals("FruitService array length mismatch: expected 3, got " + fruitCount, 3, fruitCount);
	
			boolean soilValid = InitArch.validateSoilParams();
			boolean rootValid = InitArch.validateRootProportions();
	
			assertTrue("Soil parameter validation failed", soilValid);
			assertTrue("Root proportion validation failed", rootValid);
		} 
}
