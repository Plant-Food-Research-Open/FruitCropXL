public class LightInterceptionModeUnitTest {
	private static Leaf laiLeaf(double z, double area, int fieldInstance,
			boolean reportable, boolean borderLeaf) {
		Leaf fixture = new Leaf();
		fixture.z = z;
		fixture.area = area;
		fixture.fieldInstanceId = fieldInstance;
		fixture.isReportable = reportable;
		fixture.border = borderLeaf;
		return fixture;
	}

	@Test
	public void canonicalModesAreCaseInsensitive() {
		assertEquals("cpu", normalizeLightInterceptionMode("CPU"));
		assertEquals("gpu", normalizeLightInterceptionMode("Gpu"));
		assertEquals("empiricalRegression", normalizeLightInterceptionMode("EMPIRICALREGRESSION"));
		assertEquals("surrogateModel", normalizeLightInterceptionMode("surrogatemodel"));
		assertEquals("directInput", normalizeLightInterceptionMode("DirectInput"));
	}

	@Test
	public void legacyBooleanMapsToRayBackend() {
		assertEquals("cpu", resolveConfiguredLightInterceptionMode(null, Boolean.FALSE, false, true));
		assertEquals("gpu", resolveConfiguredLightInterceptionMode(null, Boolean.TRUE, false, true));
		assertEquals("cpu", resolveConfiguredLightInterceptionMode(null, null, false, false));
	}

	@Test
	public void canonicalModeWinsConflict() {
		assertEquals("directInput",
			resolveConfiguredLightInterceptionMode("directInput", Boolean.TRUE, true, true));
	}

	@Test
	public void invalidAndEmptyModesFail() {
		boolean invalidFailed = false;
		boolean emptyFailed = false;
		try {
			normalizeLightInterceptionMode("cpux");
		} catch (IllegalArgumentException e) {
			invalidFailed = true;
		}
		try {
			normalizeLightInterceptionMode("  ");
		} catch (IllegalArgumentException e) {
			emptyFailed = true;
		}
		assertTrue("Unknown light mode must fail", invalidFailed);
		assertTrue("Empty light mode must fail", emptyFailed);
	}

	@Test
	public void zeroLightInterceptionResultHasOnlyZeroRadiationValues() {
		LightInterceptionResult result = LightInterceptionResult.zero();
		assertNotNull(result);
		assertEquals(0.0, result.incPARm2, 0.0);
		assertEquals(0.0, result.absPAR, 0.0);
		assertEquals(0.0, result.absFarRed, 0.0);
		assertEquals(0.0, result.abs, 0.0);
		assertEquals(0.0, result.absm2, 0.0);
		assertEquals(0.0, result.absPARm2, 0.0);
		assertEquals(0.0, result.fpar, 0.0);
		assertEquals(0.0, result.fabs, 0.0);
	}

	@Test
	public void leafGasExchangeScenariosShareLightButNotHydraulicBypass() {
		String previousScenario = special_scenario;
		try {
			special_scenario = "photosynthesisTest";
			assertTrue(isLeafGasExchangeTestScenario());
			assertTrue(isLeafHydraulicBypassTestScenario());
			special_scenario = "singleLeaf";
			assertTrue(isLeafGasExchangeTestScenario());
			assertFalse(isLeafHydraulicBypassTestScenario());
			special_scenario = "default";
			assertFalse(isLeafGasExchangeTestScenario());
		} finally {
			special_scenario = previousScenario;
		}
	}

	@Test
	public void beerLambertLaiAboveUsesStrictGroupedFieldProfile() {
		Leaf topA = laiLeaf(3.0, 0.4, 1, true, false);
		Leaf topB = laiLeaf(3.0, 0.6, 1, true, false);
		Leaf middle = laiLeaf(2.0, 1.0, 1, true, false);
		Leaf bottom = laiLeaf(1.0, 1.0, 1, true, false);
		Leaf borderAbove = laiLeaf(4.0, 20.0, 1, true, true);
		Leaf otherField = laiLeaf(4.0, 20.0, 2, true, false);
		Leaf[] leaves = {topA, topB, middle, bottom, borderAbove, otherField};

		updateCumulativeLaiAboveForLeaves(leaves, 2.0);

		assertEquals(0.0, borderAbove.cumulativeLaiAbove, 1e-12);
		assertEquals(0.0, topA.cumulativeLaiAbove, 1e-12);
		assertEquals(topA.cumulativeLaiAbove, topB.cumulativeLaiAbove, 1e-12);
		assertEquals(0.5, middle.cumulativeLaiAbove, 1e-12);
		assertEquals(1.0, bottom.cumulativeLaiAbove, 1e-12);
		assertEquals(0.0, otherField.cumulativeLaiAbove, 1e-12);
	}
}

public class PlantOutputSchemaUnitTest {
	private static String[] indexedPropertyNames(Class dtoClass, int expectedCount) {
		String[] namesByIndex = new String[expectedCount];
		HashSet names = new HashSet();
		HashSet indices = new HashSet();
		int propertyCount = 0;

		Field[] fields = dtoClass.getDeclaredFields();
		for (Field field : fields) {
			JsonProperty property = (JsonProperty) field.getAnnotation(JsonProperty.class);
			if (property == null) continue;
			int index = property.index();
			String name = property.value();
			assertEquals(dtoClass.getSimpleName() + " declaration/index order",
				propertyCount, index);
			assertTrue(dtoClass.getSimpleName() + " has an out-of-range index " + index,
				index >= 0 && index < expectedCount);
			assertTrue(dtoClass.getSimpleName() + " has duplicate index " + index,
				indices.add(Integer.valueOf(index)));
			assertTrue(dtoClass.getSimpleName() + " has duplicate property " + name,
				names.add(name));
			namesByIndex[index] = name;
			propertyCount++;
		}

		assertEquals(dtoClass.getSimpleName() + " indexed property count",
			expectedCount, propertyCount);
		for (int index = 0; index < expectedCount; index++) {
			assertNotNull(dtoClass.getSimpleName() + " missing index " + index,
				namesByIndex[index]);
		}
		return namesByIndex;
	}

	private static void assertPropertyBlock(String[] actual, int start, String[] expected) {
		for (int offset = 0; offset < expected.length; offset++) {
			assertEquals("Unexpected property at index " + (start + offset),
				expected[offset], actual[start + offset]);
		}
	}

	private static int csvColumnCount(String line) {
		if (line == null || line.length() == 0) return 0;
		int columns = 1;
		boolean quoted = false;
		for (int i = 0; i < line.length(); i++) {
			char current = line.charAt(i);
			if (current == '"') {
				if (quoted && i + 1 < line.length() && line.charAt(i + 1) == '"') {
					i++;
				} else {
					quoted = !quoted;
				}
			} else if (current == ',' && !quoted) {
				columns++;
			}
		}
		return columns;
	}

	private static String readText(File file) throws Exception {
		StringBuilder text = new StringBuilder();
		BufferedReader reader = new BufferedReader(new FileReader(file));
		try {
			String line;
			while ((line = reader.readLine()) != null) {
				text.append(line).append('\n');
			}
		} finally {
			reader.close();
		}
		return text.toString();
	}

	private static void deleteTree(File file) {
		if (file == null || !file.exists()) return;
		if (file.isDirectory()) {
			File[] children = file.listFiles();
			if (children != null) {
				for (int i = 0; i < children.length; i++) deleteTree(children[i]);
			}
		}
		file.delete();
	}

	private static Leaf leafFixture(double z, double anet, double waterPotential, float gs) {
		Leaf fixture = new Leaf();
		fixture.z = z;
		fixture.AlimActual = anet;
		fixture.waterPotential = waterPotential;
		fixture.gs = gs;
		return fixture;
	}

	@Test
	public void csvPlaceholdersAndRunProgressExistImmediatelyAfterInitialization()
			throws Exception {
		File testRoot = new File(PATH_OUTPUT,
			"early-output-unit-" + System.currentTimeMillis());
		String previousOutputPath = PATH_OUTPUT;
		String previousPlantPath = plantLevelOutputFilePath;
		String previousFieldPath = fieldLevelOutputFilePath;
		String previousFruitPath = meanFruitOutputFilePath;
		String previousProgressPath = runProgressOutputFilePath;
		String previousPlantMetadataPath = plantLevelMetadataFilePath;
		String previousFieldMetadataPath = fieldLevelMetadataFilePath;
		String previousFruitMetadataPath = meanFruitMetadataFilePath;
		try {
			assertTrue(testRoot.mkdirs());
			PATH_OUTPUT = testRoot.getPath() + File.separator;
			initCsvWriters("placeholder-unit");

			File plantCsv = new File(plantLevelOutputFilePath);
			File fieldCsv = new File(fieldLevelOutputFilePath);
			File fruitCsv = new File(meanFruitOutputFilePath);
			File progressCsv = new File(runProgressOutputFilePath);
			assertTrue(plantCsv.isFile());
			assertTrue(fieldCsv.isFile());
			assertTrue(fruitCsv.isFile());
			assertEquals("Placeholder must not add a biological row", 0L, plantCsv.length());
			assertEquals("Placeholder must not add a biological row", 0L, fieldCsv.length());
			assertEquals("Placeholder must not add a biological row", 0L, fruitCsv.length());
			assertTrue(new File(plantLevelMetadataFilePath).isFile());
			assertTrue(new File(fieldLevelMetadataFilePath).isFile());
			assertTrue(new File(meanFruitMetadataFilePath).isFile());

			touchRunProgress("water_start", "started");
			String progress = readText(progressCsv);
			assertTrue(progress.indexOf(
				"timestamp,step,year,dayOfYear,hourOfDay,stage,status,elapsedMs") == 0);
			assertTrue(progress.indexOf(",initialized,ok,") >= 0);
			assertTrue(progress.indexOf(",water_start,started,") >= 0);
		} finally {
			PATH_OUTPUT = previousOutputPath;
			plantLevelOutputFilePath = previousPlantPath;
			fieldLevelOutputFilePath = previousFieldPath;
			meanFruitOutputFilePath = previousFruitPath;
			runProgressOutputFilePath = previousProgressPath;
			plantLevelMetadataFilePath = previousPlantMetadataPath;
			fieldLevelMetadataFilePath = previousFieldMetadataPath;
			meanFruitMetadataFilePath = previousFruitMetadataPath;
			deleteTree(testRoot);
		}
	}

	@Test
	public void plantAndSolverDebugDtoSchemasAreStable() {
		String[] plantNames = indexedPropertyNames(PlantLevelOutputData.class, 160);
		String[] fieldNames = indexedPropertyNames(FieldLevelOutputData.class, 33);
		String[] fruitNames = indexedPropertyNames(MeanFruitOutputData.class, 92);
		assertEquals("timestamp", fieldNames[0]);
		assertEquals("simuuid", fieldNames[32]);
		assertEquals("timestamp", fruitNames[0]);
		assertEquals("mSyn", fruitNames[91]);
		String[] carbonFields = {
			"previousDailyNetCarbonBalance", "cordonStructureDM_SEC",
			"trunkStructureDM_SEC", "perennielWoodStructureDM_SEC",
			"structuralRootStructureDM_SEC", "cordonMaintenanceDM",
			"trunkMaintenanceDM", "perennielWoodMaintenanceDM",
			"structuralRootMaintenanceDM", "cordonReserveDM", "trunkReserveDM",
			"perennielWoodReserveDM", "structuralRootReserveDM"
		};
		assertPropertyBlock(plantNames, 84, carbonFields);

		String[] canopyFields = {
			"intWaterPotential_1", "intWaterPotential_2", "intWaterPotential_3", "intWaterPotential_4",
			"meanAnet_1", "meanAnet_2", "meanAnet_3", "meanAnet_4",
			"meanLeafWaterPotential_1", "meanLeafWaterPotential_2",
			"meanLeafWaterPotential_3", "meanLeafWaterPotential_4",
			"meanGs_1", "meanGs_2", "meanGs_3", "meanGs_4",
			"sugarConcentration_1", "sugarConcentration_2",
			"sugarConcentration_3", "sugarConcentration_4"
		};
		assertPropertyBlock(plantNames, 118, canopyFields);

		String[] solverFields = {
			"waterFluxSolverResidual", "waterFluxSolverFallbackUsed",
			"waterFluxSolverAccepted", "meanLeafWaterPotential_solver",
			"minLeafWaterPotential_solver", "maxLeafWaterPotential_solver",
			"meanPLC_leaf_solver", "meanGs_solver"
		};
		HashSet plantNameSet = new HashSet();
		for (int i = 0; i < plantNames.length; i++) plantNameSet.add(plantNames[i]);
		for (int i = 0; i < solverFields.length; i++) {
			assertFalse("Solver-only field remains in the plant DTO: " + solverFields[i],
				plantNameSet.contains(solverFields[i]));
		}

		String[] debugNames = indexedPropertyNames(PlantWaterFluxSolverDebugOutputData.class, 21);
		String[] debugFields = {
			"timestamp", "year", "dayOfYear", "hourOfDay", "scenario", "simuuid",
			"plantNumber", "fieldInstanceId", "waterFluxSolverResidual",
			"waterFluxSolverFallbackUsed", "waterFluxSolverAccepted",
			"meanLeafWaterPotential_solver", "minLeafWaterPotential_solver",
			"maxLeafWaterPotential_solver", "meanPLC_leaf_solver", "meanGs_solver",
			"waterFluxSolverLowerBound", "waterFluxSolverUpperBound",
			"waterFluxSolverLeafSum", "waterFluxSolverRepeatedResidualDelta",
			"waterFluxSolverEvalCount"
		};
		assertPropertyBlock(debugNames, 0, debugFields);
		HashSet debugNameSet = new HashSet();
		for (int i = 0; i < debugNames.length; i++) debugNameSet.add(debugNames[i]);
		for (int i = 0; i < solverFields.length; i++) {
			assertTrue("Solver field missing from debug DTO: " + solverFields[i],
				debugNameSet.contains(solverFields[i]));
		}
	}

	@Test
	public void diagnosticDtoSchemasHaveContiguousIndexedProperties() {
		Class[] dtoClasses = {
			LeafExpansionDiagnosticOutputData.class,
			ActualLeafSummaryDiagnosticOutputData.class,
			CarbonTransportMassBalanceDiagnosticOutputData.class,
			AppleFlowerTimingDiagnosticOutputData.class,
			AppleSpurBourseDiagnosticOutputData.class,
			AppleFlowerToFruitDiagnosticOutputData.class,
			AppleLeafAxisDiagnosticOutputData.class
		};
		int[] expectedCounts = {60, 29, 111, 29, 23, 27, 19};
		String[] commonIdentifiers = {
			"timestamp", "step", "year", "dayOfYear", "hourOfDay",
			"scenario", "simuuid", "plantNumber", "fieldInstanceId"
		};
		for (int i = 0; i < dtoClasses.length; i++) {
			String[] names = indexedPropertyNames(dtoClasses[i], expectedCounts[i]);
			assertPropertyBlock(names, 0, commonIdentifiers);
		}
		String[] carbonNames = indexedPropertyNames(
			CarbonTransportMassBalanceDiagnosticOutputData.class, 111);
		String[] plantBaseFields = {
			"ctPlantBaseFallbackUsed", "ctPlantBaseFallbackReason",
			"ctPlantBaseFallbackCount", "ctPlantBaseResidual",
