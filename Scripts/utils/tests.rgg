/**
	mainInstance: This is a singleton object of the main class, which seems to be used in the test cases.
	TestRunner Class
	addListeners(String xmlOut): This function adds a listener to JUnitCore. It outputs test results to a given XML file. File output is set using FileOutputStream.
	
	runTests(String xmlOut): This function initializes the JUnitCore with listeners and runs tests defined in FileUnitTest.class and ModelUnitTest.class.
	
	resultReport(Result result): Prints the summary of test results, including failure count, ignore count, run count, and time taken.
	
	FileUnitTest Class
	assertMainPathSet(): Checks if MAINPATH is not null.
	
	assertPhenologyParamsFileExists(): Checks if a file related to Phenology Parameters exists.
	
	assertParamsFileExists(): Checks if a parameter file exists.
	
	assertInputDataFileExists(): Checks if an input data file exists.
	
	ModelUnitTest Class
	setup(): Initializes and resets the graph before each test run.
	
	assertStartingStepTest(): Checks if the starting step is 0.
	
	assertTenStepTest(): Runs mainInstance.run() 10 times and checks if the step becomes 10.
	
	assertPlantBaseCount(): Checks if the number of PlantBase objects is equal to nrRows * nrPlants.
	*/

// ##############################################//

public class TestRunner {
    protected static JUnitCore addListeners(String xmlOut) {
        JUnitCore junit = new JUnitCore();
        
        AntXmlRunListener runListener = new AntXmlRunListener();
        try {
            runListener.setOutputStream(new FileOutputStream(
                new File(xmlOut)));
        } catch (FileNotFoundException e) {
            e.printStackTrace();
        }
        junit.addListener(runListener);

        return junit;
    }

	public static void runTests (String xmlOut) {
		JUnitCore junit = addListeners(xmlOut);
		
			Result result = junit.run(
	            FileUnitTest.class,
				ModelUnitTest.class,
				LightInterceptionModeUnitTest.class,
				PlantOutputSchemaUnitTest.class,
				ReserveTurnoverUnitTest.class,
				VirtualFruitCarbonDemandUnitTest.class,
				BerryComplexCarbonDemandUnitTest.class,
				PlantBaseCarbonBoundaryUnitTest.class,
				CarbonTransportNumericsUnitTest.class,
				WaterHydraulicsTopologyUnitTest.class
			);
		resultReport(result);
	}
	
protected static void resultReport(Result result) {
	println("========== Test Report Summary ==========");
	println("Total tests run   : " + result.getRunCount());
	println("Total failures    : " + result.getFailureCount());
	println("Total ignored     : " + result.getIgnoreCount());
	println("Total passed      : " + (result.getRunCount() - result.getFailureCount() - result.getIgnoreCount()));
	println("Execution time    : " + result.getRunTime() + " ms");
	
	if (!result.wasSuccessful()) {
		println("\n---------- Failure Details ----------");
		for (Failure failure : result.getFailures()) {
			println("✖ Test Failed: " + failure.getDescription().getDisplayName());
			println("  Class      : " + failure.getDescription().getClassName());
			println("  Message    : " + failure.getMessage());
			println("  Trace      : ");
			println(failure.getTrace());
			println("-------------------------------------");
		}
	} else {
		println("✅ All tests passed successfully.");
	}

	println("========================================\n");
}

}

