    /**
     * Calculates and returns the unscaled width of a leaf lobe.
     *
     * @param lobe The index of the leaf lobe.
     * @return The unscaled width of the specified leaf lobe.
     */
    public static double getRefWidth() {
        return calcLeafWidth(leafData.leafVertices);
    }

    public static double getRefLength(String shapeSpecies) {
        LeafData activeLeafData = LeafShapeFactory.getLeafData(LeafShapeFactory.normalizeLeafShapeSpecies(shapeSpecies));
        return calcLeafLength(activeLeafData.getLeafVertices());
    }

    public static double getRefWidth(String shapeSpecies) {
        LeafData activeLeafData = LeafShapeFactory.getLeafData(LeafShapeFactory.normalizeLeafShapeSpecies(shapeSpecies));
        return calcLeafWidth(activeLeafData.getLeafVertices());
    }

    /**
     * Calculates and returns the unscaled surface area of a leaf lobe.
     *
     * @param lobe The index of the leaf lobe.
     * @return The unscaled surface area of the specified leaf lobe.
     */
    public static double getRefArea() {
        return calcLeafPolygonArea(1, 1, 1);
    }

    
    global double referenceArea = -1f; // Cache the calculated reference area
    global double refLength = -1f; // Cache the calculated reference area
    global double refWidth = -1f; // Cache the calculated reference width
    global Vector3D[] referenceVertices;
    /**
     * Calculates the surface area of a leaf based on given length and width inputs.
     * The method is mainly used for facet leaves.
     *
     * @param length_input The length of the leaf.
     * @param width_input  The width of the leaf.
     * @param fid          The facet identifier, 1 for a single leaf.
     * @return The calculated surface area of the leaf.
     */
	
	
	
	public static double calcLeafPolygonArea(String shapeSpecies, double length_input, double width_input, int fid) {
		String active = LeafShapeFactory.normalizeLeafShapeSpecies(shapeSpecies);
		LeafData activeLeafData = LeafShapeFactory.getLeafData(active);
		activeLeafData.initMultiFacet();
		double activeRefLength = calcLeafLength(activeLeafData.getLeafVertices());
		double activeRefWidth = calcLeafWidth(activeLeafData.getLeafVertices());
		double xScale = length_input / activeRefLength;
		double yScale = width_input / activeRefWidth;
		double zScale = Math.sqrt(xScale * yScale);

		double totalArea = 0;
		float[] activeFacetData = activeLeafData.getMultiFacet();
		for (int i = 0; i < activeFacetData.length; i += 9) {
			Vector3D vecA = new Vector3D(activeFacetData[i] * xScale, activeFacetData[i + 1] * yScale, activeFacetData[i + 2] * zScale);
			Vector3D vecB = new Vector3D(activeFacetData[i + 3] * xScale, activeFacetData[i + 4] * yScale, activeFacetData[i + 5] * zScale);
			Vector3D vecC = new Vector3D(activeFacetData[i + 6] * xScale, activeFacetData[i + 7] * yScale, activeFacetData[i + 8] * zScale);
			totalArea += triangleAreaFromVertices(vecA, vecB, vecC);
		}
		return totalArea;
	}

	public static double calcLeafPolygonArea(double length_input, double width_input, int fid) {
		String active = species;
		if (leafShapeSpecies != null && leafShapeSpecies.length() > 0) {
			active = leafShapeSpecies;
		}
		return calcLeafPolygonArea(active, length_input, width_input, fid);
	}
	
	private static void cacheReferenceVertices() {
		referenceVertices = new Vector3D[leafData.MULTI_FACET.length / 3];
		for (int i = 0; i < leafData.MULTI_FACET.length; i += 3) {
			referenceVertices[i / 3] = new Vector3D(leafData.MULTI_FACET[i], leafData.MULTI_FACET[i + 1], leafData.MULTI_FACET[i + 2]);
		}
	}

    /**
     * Calculates the area of a triangle given its three vertices.
     *
     * @param vecA The first vertex of the triangle.
     * @param vecB The second vertex of the triangle.
     * @param vecC The third vertex of the triangle.
     * @return The area of the triangle.
     */
    private static double triangleAreaFromVertices(Vector3D vecA, Vector3D vecB, Vector3D vecC) {
        Vector3D vecAB = vecA.subtract(vecB);
        Vector3D vecAC = vecA.subtract(vecC);
        Vector3D crossProd = vecAB.crossProduct(vecAC);
        return crossProd.getNorm() / 2;
    }
    
	 
	/**
	 * Calculates the total surface area of the multi-faceted leaf.
	 * The method scales each triangle's area based on the given length and width, summing them together.
	 */
	private static double calcMultiFacetArea(float length_input, float width_input) {
		double totalArea = 0;
		double xScale = length_input / getRefLength();
		double yScale = width_input / getRefWidth();
		double zScale = Math.sqrt(xScale*yScale); //length_input/ getRefWidth(0);

		for (int i = 0; i < leafData.MULTI_FACET.length; i+=9) {
			Vector3D vecA = new Vector3D(leafData.MULTI_FACET[i] * xScale, leafData.MULTI_FACET[i+1] * yScale, leafData.MULTI_FACET[i+2]*zScale);
			Vector3D vecB = new Vector3D(leafData.MULTI_FACET[i+3] * xScale, leafData.MULTI_FACET[i+4]* yScale, leafData.MULTI_FACET[i+5]*zScale);
			Vector3D vecC = new Vector3D(leafData.MULTI_FACET[i+6] * xScale, leafData.MULTI_FACET[i+7]* yScale, leafData.MULTI_FACET[i+8]*zScale);
			totalArea += triangleAreaFromVertices(vecA, vecB, vecC);
		}
		
	
		return totalArea;
	}
	
	
	// Returns scaled area of given facet (same as leaf area as leaf is made up of only one facet)
		
	public static float calcFacetPolygonArea(float length_input, float width_input, int lobe, int fid) {
		return calcMultiFacetArea(length_input,width_input);	
	}


