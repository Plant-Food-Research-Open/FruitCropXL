 /**
     * Retrieves the LeafData for a given species.
     * This method fetches the leaf geometry data associated with a specific species.
     *
     * @param species The name of the species for which leaf data is requested.
     * @return The LeafData object containing triangle indices and vertices for the specified species.
     *         Returns null if the species is not found.
     */
    public static LeafData getLeafData(String species) {
        return (LeafData) speciesData.get(species);
    }

    public static boolean hasLeafShapeSpecies(String species) {
        return species != null && speciesData.containsKey(species);
    }

    public static String normalizeLeafShapeSpecies(String shapeSpecies) {
        String active = shapeSpecies;
        if (active == null || active.length() == 0) {
            active = species;
        }
        if (!hasLeafShapeSpecies(active)) {
            if (printFlag) {
                println("[LeafShape] WARN: unknown leafShapeSpecies=" + active + "; using species=" + species + ".");
            }
            active = species;
        }
        if (!hasLeafShapeSpecies(active)) {
            active = "grapevine";
        }
        return active;
    }

    public static LeafData getLeafData(String species, long leafSeed) {
        if (!"apple".equals(species)) {
            return getLeafData(species);
        }
        return createAppleLeafData(leafSeed);
    }

    /**
     * Sets the global triangle index and leaf vertices arrays based on the species specified.
     * This method is used to set up the geometry for a specific type of leaf based on its species.
     *
     * @param species The name of the species whose leaf shape is to be retrieved.
     *                Supported species are "apple", "grapevine", and "kiwifruit".
     */
    public static void getLeafShape(String species) {
        String active = normalizeLeafShapeSpecies(species);
        leafData = getLeafData(active);
        initLeafShape(leafData);
        if ("apple".equals(active) && printFlag && !appleCurlMessagePrinted) {
            println("Apple leaf curl enabled (target edge curl range: 20-40 deg)");
            appleCurlMessagePrinted = true;
        }
        // Additional processing can be done here with triangleIndex and leafVertices
    }

    public static PolygonMesh getPolygonForLeaf(String species, long leafSeed, int lobe, int fid) {
        String active = normalizeLeafShapeSpecies(species);
        if (!"apple".equals(active)) {
            LeafData selectedLeafData = getLeafData(active);
            selectedLeafData.initMultiFacet();
            return createPolygonMesh(selectedLeafData.getMultiFacet());
        }

        Long cacheKey = Long.valueOf(leafSeed);
        PolygonMesh cachedMesh = (PolygonMesh) appleMeshCache.get(cacheKey);
        if (cachedMesh != null) {
            return cachedMesh;
        }

        LeafData appleLeafData = getLeafData(active, leafSeed);
        appleLeafData.initMultiFacet();
        PolygonMesh generatedMesh = createPolygonMesh(appleLeafData.getMultiFacet());
        appleMeshCache.put(cacheKey, generatedMesh);
        return generatedMesh;
    }


/**
 * Initializes the shape of a leaf based on its species.
 * It sets up the leaf geometry and populates the MULTI_FACET array.
 *
 * @param species The species of the leaf to initialize.
 */
public static void initLeafShape(LeafData leafData) {
    leafData.initMultiFacet();
    initLeaf(0, leafData.MULTI_FACET);
}

/**
 * Initializes the geometry of a leaf in the polyleaf array.
 *
 * @param leafID The ID of the leaf to initialize.
 * @param data   The flattened data representing the leaf geometry.
 */
private static void initLeaf(int leafID, float[] data) {
	polyleaf[leafID][0] = createPolygonMesh(data);
}

private static PolygonMesh createPolygonMesh(float[] data) {
	FloatList coordinates = new FloatList(data);
	PolygonMesh mesh = new PolygonMesh();
	int[] tmp = new int[coordinates.size()/3];
	for(int i = 0; i<tmp.length; i++) tmp[i]=i;
	mesh.setIndexData(new IntList(tmp));
	mesh.setVertexData(coordinates);
	return mesh;
}

/**
 * Builds a deterministic per-leaf apple {@link LeafData} instance from the static apple template.
 *
 * <p><b>How per-leaf variability is generated (deterministic):</b></p>
 * <ul>
 *   <li>The method starts from the static apple geometry declared in {@code createAppleLeafData()}.</li>
 *   <li>{@code leafSeed} (passed from {@code Leaf.getId()}) is mixed by {@link #mixSeed(long)} to reduce
 *       obvious correlations for close integer ids.</li>
 *   <li>A local {@link Random} is created from the mixed seed, so results are independent of traversal order
 *       and independent from any global RNG calls.</li>
 * </ul>
 *
 * <p><b>Parameter sampling:</b></p>
 * <ul>
 *   <li>{@code curlDeg = 30 +/- 10} deg (uniform), resulting in a 20-40 deg target edge curl range.</li>
 *   <li>{@code asym = +/- 0.1} (uniform), applied as a relative left/right multiplier.</li>
 * </ul>
 *
 * <p>The base vertices are copied and then deformed by {@link #applyAppleEdgeCurl(float[][], double, double)}.
 * Triangle connectivity is reused unchanged from the base apple leaf.</p>
 *
 * @param leafSeed stable per-leaf identifier used to generate a reproducible mesh for one leaf instance.
 * @return a new apple {@code LeafData} with the same topology and a per-leaf curled vertex set.
 */
private static LeafData createAppleLeafData(long leafSeed) {
    LeafData baseLeafData = (LeafData) speciesData.get("apple");
    int[][] triangleIndex = baseLeafData.getTriangleIndex();
    float[][] baseVertices = baseLeafData.getLeafVertices();
    float[][] transformedVertices = copyVertices(baseVertices);

    Random deterministicRandom = new Random(mixSeed(leafSeed));
    double curlDeg = APPLE_CURL_BASE_DEG + ((deterministicRandom.nextDouble() * 2.0 - 1.0) * APPLE_CURL_JITTER_DEG);
    double asym = (deterministicRandom.nextDouble() * 2.0 - 1.0) * APPLE_ASYMMETRY_MAX;
    applyAppleEdgeCurl(transformedVertices, curlDeg, asym);

    if (printFlag && appleSampleMessageCount < 2) {
        println("Apple leaf curl sample leafSeed=" + leafSeed + " curlDeg=" + curlDeg + " asym=" + asym);
        appleSampleMessageCount++;
    }

    return new LeafData(triangleIndex, transformedVertices);
}

private static float[][] copyVertices(float[][] vertices) {
    float[][] copy = new float[vertices.length][3];
    for (int i = 0; i < vertices.length; i++) {
        copy[i][0] = vertices[i][0];
        copy[i][1] = vertices[i][1];
        copy[i][2] = vertices[i][2];
    }
    return copy;
}

/**
 * Applies apple edge-curl deformation directly on a leaf vertex array.
 *
 * <p><b>Coordinate convention used in this file:</b></p>
 * <ul>
 *   <li>{@code x}: longitudinal leaf direction (petiole to tip)</li>
 *   <li>{@code y}: lateral direction (left/right from midrib)</li>
 *   <li>{@code z}: out-of-plane elevation</li>
 * </ul>
 *
 * <p><b>Exact deformation procedure:</b></p>
 * <ol>
 *   <li>Estimate {@code halfWidth} as {@code max(abs(y))} across vertices.</li>
 *   <li>Compute side-specific target curl:
 *     <ul>
 *       <li>{@code curlDegLeft  = curlDeg * (1 + asym)}</li>
 *       <li>{@code curlDegRight = curlDeg * (1 - asym)}</li>
 *     </ul>
 *   </li>
 *   <li>For each vertex, compute normalized lateral distance to the midrib:
 *       {@code u = clamp01(abs(y)/halfWidth)}.</li>
 *   <li>Compute smooth edge weight with smoothstep:
 *       {@code w = u*u*(3 - 2*u)}.
 *       This keeps curl near zero close to the midrib and smoothly increases it toward margins.</li>
 *   <li>Convert weighted angle: {@code angleRad = radians(sideCurlDeg) * w}.</li>
 *   <li>Apply a lateral-to-vertical rotation proxy by preserving {@code abs(y)} radius:
 *     <ul>
 *       <li>{@code curledY = abs(y) * cos(angleRad)}</li>
 *       <li>{@code zOffset = abs(y) * sin(angleRad)}</li>
 *       <li>{@code y = sign(y) * curledY}</li>
 *       <li>{@code z = z + zOffset}</li>
 *     </ul>
 *   </li>
 * </ol>
 *
 * <p>This produces a gentle upward margin curl while preserving topology and avoiding hard creases.</p>
 *
 * @param vertices mutable vertex array ({@code [n][3]}) to deform in-place.
 * @param curlDeg nominal (pre-asymmetry) edge curl angle in degrees.
 * @param asym relative left/right asymmetry factor (typical range {@code [-0.1, 0.1]}).
 */
private static void applyAppleEdgeCurl(float[][] vertices, double curlDeg, double asym) {
    float halfWidth = 0f;
    for (int i = 0; i < vertices.length; i++) {
        halfWidth = Math.max(halfWidth, Math.abs(vertices[i][1]));
    }
    if (halfWidth <= 0f) {
        return;
    }

    double curlDegLeft = curlDeg * (1.0 + asym);
    double curlDegRight = curlDeg * (1.0 - asym);

    for (int i = 0; i < vertices.length; i++) {
        float y = vertices[i][1];
        float z = vertices[i][2];
        double normalized = clamp01(Math.abs(y) / halfWidth);
        double smoothWeight = normalized * normalized * (3.0 - 2.0 * normalized);
        double sideCurlDeg = (y >= 0f) ? curlDegLeft : curlDegRight;
        double angleRad = Math.toRadians(sideCurlDeg) * smoothWeight;

        double absY = Math.abs(y);
        double curledY = absY * Math.cos(angleRad);
        double zOffset = absY * Math.sin(angleRad);

        vertices[i][1] = (float) (Math.signum(y) * curledY);
        vertices[i][2] = (float) (z + zOffset);
    }
}

private static double clamp01(double value) {
    if (value < 0.0) {
        return 0.0;
    }
    if (value > 1.0) {
        return 1.0;
    }
    return value;
}

private static long mixSeed(long seed) {
    long z = seed + 0x9E3779B97F4A7C15L;
    z = (z ^ (z >>> 30)) * 0xBF58476D1CE4E5B9L;
    z = (z ^ (z >>> 27)) * 0x94D049BB133111EBL;
    return z ^ (z >>> 31);
}
}


	
    /**
     * Calculates the maximum distance from the origin to any vertex, interpreted as leaf length.
     *
     * @param leafVertices An array of leaf vertices, each vertex is an array of 3 coordinates (x, y, z).
     * @return The calculated length of the leaf.
     */
    public static float calcLeafLength(float[][] leafVertices) {
        float length = 0.0f;
        for (int i = 0; i < leafVertices.length; i++) {
            float x = leafVertices[i][0];
            float y = leafVertices[i][1];
            float z = leafVertices[i][2];

            float distance = (float) Math.sqrt(x * x + y * y + z * z);

            if (distance > length) {
                length = distance;
            }
        }
        return length;
    }

    /**
     * Calculates the maximum width of the leaf by comparing all pairs of y-coordinates.
     *
     * @param leafVertices An array of leaf vertices, each vertex is an array of 3 coordinates (x, y, z).
     * @return The calculated width of the leaf.
     */
    public static float calcLeafWidth(float[][] leafVertices) {
        float width = 0.0f;

        for (int i = 0; i < leafVertices.length; i++) {
            for (int j = i + 1; j < leafVertices.length; j++) {
                float y1 = leafVertices[i][1];
                float y2 = leafVertices[j][1];
                float tempWidth = Math.abs(y1 - y2);

                if (tempWidth > width) {
                    width = tempWidth;
                }
            }
        }
        return width;
    }

