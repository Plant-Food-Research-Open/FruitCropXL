/**
 * Custom class to hold leaf data, including triangle indices and vertex coordinates.
 */
public class LeafData implements RunAfterLoad,Serializable {
    /**
     * Static array to store the indices of vertices forming triangles.
     * This array is shared across all instances of LeafData.
     */
    private int[][] triangleIndex;

    /**
     * Static array to store the vertices of the leaf.
     * Each vertex is represented by 3 coordinates (x, y, z).
     * This array is shared across all instances of LeafData.
     */
    private float[][] leafVertices;
    private float[] MULTI_FACET;
    
    @Override
	public void load(RegistryContext ctx) {
		// Example: read from a file in the project directory
		//Object f = getFileFromProject("leafDataFile");
		//Reader r = ctx.getRegistry().getFileSystem().getReader(f);
		// (implement your reading logic here)
	}
	
	// No-arg constructor required for reflection, deserialization, etc.
    public LeafData() {
        // Optionally initialize fields to default values, or leave empty
    }
    
    /**
     * Constructor to create a new instance of LeafData with specified triangle indices and vertices.
     *
     * @param triangleIndex The array of triangle indices.
     * @param leafVertices  The array of leaf vertices.
     */
    public LeafData(int[][] triangleIndex, float[][] leafVertices) {
        this.triangleIndex = triangleIndex;
        this.leafVertices = leafVertices;
    }
    
    public void initMultiFacet() {
        if (triangleIndex == null || leafVertices == null) {
             println("Error: Incomplete leaf data."); 
            return;
        }

        MULTI_FACET = new float[triangleIndex.length * 3 * 3];
        for (int i = 0; i < triangleIndex.length; i++) {
            for (int j = 0; j < 3; j++) {
                int vertexIndex = triangleIndex[i][j];
                for (int k = 0; k < 3; k++) {
                    MULTI_FACET[(i * 9) + (j * 3) + k] = leafVertices[vertexIndex][k];
                }
            }
        }
    }
    
    /**
     * Gets the triangle indices.
     *
     * @return The array of triangle indices.
     */
    public int[][] getTriangleIndex() {
        return triangleIndex;
    }

    /**
     * Gets the leaf vertices.
     *
     * @return The array of leaf vertices.
     */
    public float[][] getLeafVertices() {
        return leafVertices;
    }
    
    
    public float[] getMultiFacet() {
        return MULTI_FACET;
    }
}

