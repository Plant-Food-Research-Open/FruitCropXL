/**
 * Interface for the validation file reader.
 */
public interface IValidationReader {
    /**
     * Return a YAML file.
     * 
     * @param yamlFile The YAML file.
     * 
     * @return The YAML file contents.
     */
    JsonNode readYaml(String yamlFile);

	/**
	 * Read a CSV file.
	 * 
	 * @param csvFile The CSV file.
	 * 
	 * @return The CSV file contents.
	 */
	List readCsv(String csvFile);

	/**
	 * Get the validation testing parameters.
	 * 
	 * @return Validation testing parameters.
	 */
	JsonNode getParams();
	
	/**
	 * Get the validation testing scenario.
	 * 
	 * @return Validation testing scenario.
	 */
	JsonNode getScenario();

	/**
	 * Get the validation data.
	 * 
	 * @return The validation data.
	 */
	List getValidationDataList(JsonNode testParamNode);
}

/**
 * Validation file reader class.
 */
public class ValidationReader implements IValidationReader {
	//Paths
	public static final String VALIDATION_DIR = "tests" + sep + "validation";
	protected static final String PARAMS_FILE = "params.yaml";
	protected static final String SCENARIO_FILE = "scenario.yaml";
	protected String validationDirPath;

	// Jackson Nodes
	protected ObjectMapper yamlMapper;
	protected JsonNode params;
	protected JsonNode scenario;

	// CSV
	protected CsvMapper csvMapper;
	protected CsvSchema csvSchema;

	public JsonNode getParams() {
		return params;
	}

	public JsonNode getScenario() {
		return scenario;
	}

    public JsonNode readYaml(String yamlFile) {
		String fullPath = validationDirPath + sep + yamlFile;
        JsonNode yamlNode = yamlMapper.readTree(new File(fullPath));
        return yamlNode;
    }

	public List readCsv(String csvFile) {
		String fullPath = validationDirPath + sep + csvFile;

		List csvList = csvMapper.readerFor(JsonNode.class)
		.with(csvSchema)
		.readValues(new File(fullPath))
		.readAll();

		return csvList;
	}

	/**
	 * ValidationReader class initiator.
	 */
	protected void init() {
		validationDirPath = MAINPATH + sep + VALIDATION_DIR;
		
		yamlMapper = new ObjectMapper(new YAMLFactory());

		csvMapper = new CsvMapper();
		csvSchema = CsvSchema
		.emptySchema()
		.withHeader();
	}

	/**
	 * Class constructor.
	 */
	public ValidationReader() {
		init();
	}

	/**
	 * Class constructor with validation directory.
	 * 
	 * @param validationDir The validation directory path.
	 */
	public ValidationReader(String validationDir) {
		init();

		validationDirPath = MAINPATH + sep + VALIDATION_DIR + sep + validationDir;
		
		params = readYaml(PARAMS_FILE);
		scenario = readYaml(SCENARIO_FILE);
	}

public List getValidationDataList(JsonNode testParamNode) {
    JsonNode dsNode = testParamNode.get("dataset");
    if (dsNode == null) {
        throw new RuntimeException("Missing 'dataset' in validation params.");
    }

    if (dsNode.isArray()) {
        ArrayNode arr = (ArrayNode) dsNode;
        int n = arr.size();
        if (n == 0) {
            throw new RuntimeException("'dataset' array is empty.");
        }
        String[] files = new String[n];
        for (int i = 0; i < n; i++) {
            files[i] = arr.get(i).asText();
        }
        return readCsvsSameRows(files);
    } else {
        // Backwards compatible (single CSV)
        String validationDataFile = dsNode.asText();
        return readCsv(validationDataFile);
    }
}

	
	// Merge multiple CSV tables (same row count) into one table.
// Raw types; no generics (Java 1.5).
private List readCsvsSameRows(String[] csvFiles) {
    // Read each CSV through existing readCsv (uses this.validationDirPath)
    List fileRowsList = new ArrayList(); // List<List>
    int i, j;

    for (i = 0; i < csvFiles.length; i++) {
        List rows = readCsv(csvFiles[i]);
        fileRowsList.add(rows);
    }

    // Enforce equal row counts
    int rowCount = -1;
    for (i = 0; i < fileRowsList.size(); i++) {
        List rows = (List) fileRowsList.get(i);
        if (rowCount < 0) rowCount = rows.size();
        else if (rows.size() != rowCount) {
            throw new RuntimeException("Validation CSVs have different row counts: expected "
                + rowCount + " but file index " + i + " has " + rows.size());
        }
    }

    // Merge column-wise
    ObjectMapper _mapper = new ObjectMapper();
    List mergedRows = new ArrayList();
    for (i = 0; i < rowCount; i++) {
        com.fasterxml.jackson.databind.node.ObjectNode merged = _mapper.createObjectNode();
        java.util.HashSet used = new java.util.HashSet(); // track output keys

        for (j = 0; j < fileRowsList.size(); j++) {
            List rows = (List) fileRowsList.get(j);
            JsonNode row = (JsonNode) rows.get(i);

            for (java.util.Iterator it = row.fieldNames(); it.hasNext(); ) {
                String key = (String) it.next();

                // Avoid duplicating common index columns from later files
                if (j > 0 && ("step".equals(key) || "timestamp".equals(key))) {
                    continue;
                }

                String outKey = key;
                if (used.contains(outKey)) {
                    outKey = key + "_" + (j + 1);
                    while (used.contains(outKey)) outKey = outKey + "_x";
                }
                used.add(outKey);
                merged.set(outKey, row.get(key));
            }
        }
        mergedRows.add(merged);
    }
    return mergedRows;
}

}

/**
 * Validation testing runner.
 */
public class ValidationRunner {		

	/**
	 * Adding validation testing listener.
	 * 
	 * @param xmlOut The test result output file.
	 */
    protected static JUnitCore addListeners(String xmlOut) {
        JUnitCore junit = new JUnitCore();
        
        AntXmlRunListener runListener = new AntXmlRunListener();
        try {
            runListener.setOutputStream(new FileOutputStream(
                new File(xmlOut)));
        } catch (FileNotFoundException e) {
            e.printStackTrace();
        }
        junit.addListener(runListener);

        return junit;
    }

	/**
	 * Get testing scenario classes as a hash map.
	 * 
	 * @return The testing scenario hash map.
	 */
	protected static Map getTestScenarios() {
		Map scenarioMap = new HashMap();

		// Add validation test classes here
		scenarioMap.put("default", DefaultValidationUnitTest.class);
		scenarioMap.put("antony-2010", Antony2010ValidationUnitTest.class);
		scenarioMap.put("dai-2012-12L", DAI2012With12LUnitTest.class);
		scenarioMap.put("dai-2012-3L", DAI2012With3LUnitTest.class);
		scenarioMap.put("stormTest", StormValidationUnitTest.class);
		scenarioMap.put("FOPS-satDryTest", FOPS_SatDryValidationUnitTest.class);

		return scenarioMap;
	}

	protected static String getRequestedScenarioName() {
		CommandLineArgs commandLineArgs = new CommandLineArgs();
		String testScenario = commandLineArgs.getRawProperty("validationTestScenario");
		if (testScenario == null || testScenario.length() == 0) {
			testScenario = "default";
		}
		return testScenario;
	}

	/**
	 * Resolve the model options file for the requested validation scenario before the
	 * first headless reset/init cycle. This avoids clearing another scenario's output
	 * directory when GroIMP performs its initial validation startup pass.
	 */
	public static String resolveStartupModelOptions() {
		String testScenario = getRequestedScenarioName();
		try {
			ValidationReader validationReader = new ValidationReader(testScenario);
			JsonNode scenarioNode = validationReader.getScenario();
			if (scenarioNode != null) {
				JsonNode modelOptionsNode = scenarioNode.get("file-name-model-options");
				if (modelOptionsNode != null) {
					String resolvedFileName = modelOptionsNode.asText();
					if (resolvedFileName != null && resolvedFileName.length() > 0) {
						return resolvedFileName;
					}
				}
			}
		} catch (RuntimeException e) {
			// Compatibility fallback: keep the existing global default if validation startup
			// cannot read scenario.yaml for any reason.
			println("Note: failed to resolve validation startup model options for scenario '" + testScenario
				+ "'; using existing FILE_NAME_MODEL_OPTIONS. " + e.getMessage());
		}
		return FILE_NAME_MODEL_OPTIONS;
	}
		
	/**
	 * Run validation tests.
	 * 
	 * @param xmlOut The test result output file.
	 */
	public static void runTests (String xmlOut) {
		JUnitCore junit = addListeners(xmlOut);
		String testScenario = getRequestedScenarioName();

		Map scenarioMap = getTestScenarios();
		Class testScenarioClass = (Class) scenarioMap.get(testScenario);
	
		Result result = junit.run(testScenarioClass);
		resultReport(result);
	}
	
	/**
	 * Report test results to stdout.
	 * 
	 * @param result The test results.
	 */
	protected static void resultReport(Result result) {
        if (result.getFailureCount() > 0) {
            println("\nFailures: ");
            for (Failure failure : result.getFailures()) {
                println(" - " + failure);
                println("");
                println("   " + failure.getTrace());
                
                // Add additional output for failure here if needed
                
                println("");
            }
        }

		println(
            "Finished. Result: Failures: " + result.getFailureCount() + 
            ". Ignored: " + result.getIgnoreCount() + 
            ". Tests run: " + result.getRunCount() +
            ". Time: " + result.getRunTime() + "ms."
        );
	}
}

