//public static optimization optInstance = new optimization();

public class SimulationCommand extends LockProtectedCommand {
	final GraphManager graph;

	public SimulationCommand(GraphManager graph) {
		super(graph, true, JobManager.ACTION_FLAGS);
		this.graph = graph;
	}

	@Override
	protected void runImpl(Object info, Context ctx, Lock lock) {
        resetGraph(graph);
        mainInstance.invokeInit();

		SocketWrapper wrapper = (SocketWrapper) info;
		Socket socket = wrapper.socket;
		String body = wrapper.body;
		ObjectMapper objectMapper = new ObjectMapper();
		JsonNode args = objectMapper.readTree(body);
		
		String simResults = simulationRun(args, graph);

		socket.getOutputStream().write(simResults.getBytes("UTF-8"));
		wrapper.reader.close();
		wrapper.writer.close();
		socket.close();
	}
}

