static String simulationRun(JsonNode args, GraphManager graph) {
	Date currentDate;
	currentDate = new Date(System.currentTimeMillis());
	if (printFlag) { println("Start time: " + currentDate); }

	setSimulationArgs(args);

	mainInstance.runEnd(); 
	
	//output results
	int[] tableInd = getTableInd();
	String[] tableDescription = getTableDescription();
	
	Map outputs = new HashMap();
	
	for(int i = 0; i < tableInd.length - 1; i++) {
		int index = tableInd[i];
		String k = tableDescription[index];
		Map simData = getSimData(i);
		outputs.put(k, simData);
	}

	currentDate = new Date(System.currentTimeMillis());
	if (printFlag) { println("End time: " + currentDate); }
	String simResults = new ObjectMapper().writeValueAsString(outputs);
	return simResults;
}

static public void resetGraph (GraphManager graph) {
    Transaction xa = graph.getActiveTransaction ();
    Node root = graph.getRoot ();
    for (Edge e = root.getFirstEdge (), f; e != null; e = f)
    {
        f = e.getNext (root);
        if (e.testEdgeBits (Graph.BRANCH_EDGE)
            && (e.getTarget () instanceof RGGRoot))
        {
            e.remove (xa);
        }
    }
    RGGRoot rr = new RGGRoot ();
    root.addEdgeBitsTo (rr, Graph.BRANCH_EDGE, xa);
    rr.addEdgeBitsTo (new Axiom (), Graph.SUCCESSOR_EDGE, xa);
    xa.commitAll();
}



























