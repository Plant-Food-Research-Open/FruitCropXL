/**
 * Validation testing class for the default case.
 *
 * FIXME: This method is a workaround for parameterized tests (@RunWith and @Parameterized.Parameters)
 * as generics are required in the signature of the method that defines and passes parameters to tests.
 * Generics are not supported by the GroIMP compiler.)
 */
public class DefaultValidationUnitTest extends ValidationTestBase {

  @BeforeClass
  public static void setupAll() {
    validationDir = "default";
    init();
    readSyntheticOutput(plantLevelOutputFilePath);
  }

  @Test
  public void allColumns_withinDiscrepancyThreshold() {
    String[] excludedColumns = {
      "timestamp",
      "simuuid",
      //columns with large variations
      "fPARMid",
      "fPARUp",
      "fPAR_1",
      "fPAR_2",
      "fPAR_3",
      "fPAR_4",
      "cumLAI_4",
      "fs_1",
      "fs_2",
      "fs_3",
      "fs_4",
      "pruneFruitBiomassRemoved",
      "fruitIncidentPAR_mean_umol_m2_s",
      "fruitAbsorbedPAR_sum_umol_s",
      "fruitAbsorbedRadiation_sum_modelRad_s",
      "fruitCount",
      "fruitIncidentPAR_mean_b1_umol_m2_s",
      "fruitIncidentPAR_mean_b2_umol_m2_s",
      "fruitIncidentPAR_mean_b3_umol_m2_s",
      "fruitIncidentPAR_mean_b4_umol_m2_s",
      "fruitAbsorbedPAR_sum_b1_umol_s",
      "fruitAbsorbedPAR_sum_b2_umol_s",
      "fruitAbsorbedPAR_sum_b3_umol_s",
      "fruitAbsorbedPAR_sum_b4_umol_s",
      "fruitAbsorbedRadiation_sum_b1_modelRad_s",
      "fruitAbsorbedRadiation_sum_b2_modelRad_s",
      "fruitAbsorbedRadiation_sum_b3_modelRad_s",
      "fruitAbsorbedRadiation_sum_b4_modelRad_s",
      "fruitCount_b1",
      "fruitCount_b2",
      "fruitCount_b3",
      "fruitCount_b4",
      "fraction_fruitUnloading",
      "growthCostFruit"
      
    };
    List failedColumns = discrepancyTestMethods.columnsWithinDiscrepancyThreshold(
      excludedColumns,
      true
    );

    // List failedColumns = discrepancyTestMethods.columnsWithinDiscrepancyThreshold(
    //   new int[] { 1, 5, 6, 7 },
    //   true // Use a function to pass in a range of indexes if needed
    // );

    assertTrue(
      "Columns not within discrepancy threshold: " +
      Arrays.toString(failedColumns),
      failedColumns.isEmpty()
    );
  }
}



/**
 * Validation testing class for storm test, no radiation, wet
 * Here’s a full day-by-day description of the simulation test setup from the table you shared:

**Days 1–3 (Cloud build-up, Temperature drop, Wind increase)**

* **Radiation:** Gradually decreases, reaching very low values by Day 3.
* **Temperature:** Shows a downward trend, with progressively lower daily highs.
* **Relative Humidity:** Steadily increases, reflecting moistening air.
* **Wind:** Clear and steadily increasing.
* **Soil Water Potential:** Remains constant at −0.05 MPa (no rainfall yet).

**Day 4 (Sustained rain, Saturation, High wind reduces)**

* **Radiation:** Drops to zero due to heavy rainfall lasting all day.
* **Temperature:** Low and nearly constant because of clouds and rain.
* **Relative Humidity:** Extremely high (~0.99), nearly saturated.
* **Wind:** Peaks, then gradually decreases.
* **Soil Water Potential:** Rapid rise from −0.05 MPa to −0.005 MPa, indicating soil saturation.

**Days 5–7 (Normalization, Soil water reduction)**

* **Radiation:** Increases again under clearer skies, but still below the initial peak.
* **Temperature:** Slowly rises, but remains cooler than on Day 1.
* **Relative Humidity:** Gradually decreases, as the air dries out.
* **Wind:** Continues to weaken, with lighter values.
* **Soil Water Potential:** Slowly returns from −0.005 MPa toward −0.05 MPa, though full return is not reached by Day 7.
*/
public class StormValidationUnitTest extends ValidationTestBase {

  @BeforeClass
  public static void setupAll() {
    validationDir = "stormTest";
    init();
    readSyntheticOutput(plantLevelOutputFilePath);
  }

  @Test
  public void allColumns_withinDiscrepancyThreshold() {
    String[] excludedColumns = {
      "timestamp",
      "simuuid",
      "meanAnet",
      "meanPAnet",
      "fPARMid",
      "fPARUp",
      "fPARLow",
      "fPAR_1",
      "fPAR_2",
      "fPAR_3",
      "fPAR_4",
      "cumLAI_4",
      "fs_1",
      "fs_2",
      "fs_3",
      "fs_4",
      "WUE",
      "fraction_structuralRootLoading",
      "pruneFruitBiomassRemoved",
      "fruitIncidentPAR_mean_umol_m2_s",
      "fruitAbsorbedPAR_sum_umol_s",
      "fruitAbsorbedRadiation_sum_modelRad_s",
      "fruitCount",
      "fruitIncidentPAR_mean_b1_umol_m2_s",
      "fruitIncidentPAR_mean_b2_umol_m2_s",
      "fruitIncidentPAR_mean_b3_umol_m2_s",
      "fruitIncidentPAR_mean_b4_umol_m2_s",
      "fruitAbsorbedPAR_sum_b1_umol_s",
      "fruitAbsorbedPAR_sum_b2_umol_s",
      "fruitAbsorbedPAR_sum_b3_umol_s",
      "fruitAbsorbedPAR_sum_b4_umol_s",
      "fruitAbsorbedRadiation_sum_b1_modelRad_s",
      "fruitAbsorbedRadiation_sum_b2_modelRad_s",
      "fruitAbsorbedRadiation_sum_b3_modelRad_s",
      "fruitAbsorbedRadiation_sum_b4_modelRad_s",
      "fruitCount_b1",
      "fruitCount_b2",
      "fruitCount_b3",
      "fruitCount_b4",
      "fraction_fruitUnloading",
      "growthCostFruit",
	  "leafArea",
	  "meanPAnet",
	  "meanAnet",
	  "biomassLeaf",
	  "fraction_leafUnloading",
	  "maintenanceLeaf",
	  "cumLAI_1",
	  "cumLAI_2",
	  "cumLAI_3",
	  "sugarConcentration_1",
	  "sugarConcentration_2",
	  "sugarConcentration_3", 
	  "sugarConcentration_4", 
	  "waterFluxPotential",
	  "leafNSC",
	  "fraction_internodeLoading",
	  "fraction_perennielWoodLoading",
	  "fraction_fineRootLoading",
	  "maintenanceDM"
      // merged duplicate fruit-count columns from multi-file synthetic outputs
      
    };
    List failedColumns = discrepancyTestMethods.columnsWithinDiscrepancyThreshold(
      excludedColumns,
      true
    );

    // List failedColumns = discrepancyTestMethods.columnsWithinDiscrepancyThreshold(
    //   new int[] { 1, 5, 6, 7 },
    //   true // Use a function to pass in a range of indexes if needed
    // );

    assertTrue(
      "Columns not within discrepancy threshold: " +
      Arrays.toString(failedColumns),
      failedColumns.isEmpty()
    );
  }
}


