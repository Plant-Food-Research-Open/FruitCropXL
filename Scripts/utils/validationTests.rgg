/**
 * Validation testing class for ANTONY 2010.
 */
public class Antony2010ValidationUnitTest extends ValidationTestBase {

  @BeforeClass
  public static void setupAll() {
    validationDir = "antony-2010";
    init();
    readSyntheticOutput(plantLevelOutputFilePath);
  }

  @Test
  public void waterFlux_hasLessOrEqualRMSE() {
    assertTrue(
      rmseTestMethods.hasLessOrEqualRMSE("waterFlux_optimized", "E_mg.plant.s")
    );
  }

  @Test
  public void leafWaterPotential_hasLessOrEqualRMSE() {
    assertTrue(
      rmseTestMethods.hasLessOrEqualRMSE("leaf_waterPotential", "leaf.wp")
    );
  }
  
  

  
@Test
public void waterFlux_withinDiscrepancyThreshold() {
    boolean pass = discrepancyTestMethods.withinDiscrepancyThreshold("waterFlux_optimized");

    // Debug output for CI
    println("[CI DEBUG] waterFlux_optimized pass = " + pass);

    // Add a soft fail tolerance if desired (simulate tolerance without internal methods)
    if (!pass) {
        println("[CI WARNING] Water flux discrepancy exceeded threshold.");
    }

    assertTrue(
        "Water flux discrepancy exceeded threshold in CI.",
        pass
    );
}
  

  @Test
  public void leafWaterPotential_withinDiscrepancyThreshold() {
    assertTrue(
      discrepancyTestMethods.withinDiscrepancyThreshold("leaf_waterPotential")
    );
  }
  
   @Test
  public void allColumns_withinDiscrepancyThreshold() {
    String[] excludedColumns = {
      "timestamp",
      "simuuid",
      //columns with large variations
      "fPARMid",
      "fPARUp",
      "fPARLow",
      "fPAR_1",
      "fPAR_2",
