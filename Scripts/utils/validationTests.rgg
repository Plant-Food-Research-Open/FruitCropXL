/**
 * Validation testing class for DAI 2012 with 12L.
 */
public class DAI2012With12LUnitTest extends ValidationTestBase {

  private static int[] steps = new int[] { 1, 169, 337, 505, 673, 841 };

  @BeforeClass
  public static void setupAll() {
    validationDir = "dai-2012-12L";
    init();
    //readSyntheticOutput(meanFruitOutputFilePath);
    // Merge two (or more) synthetic outputs that share the same row count
	 readSyntheticOutputsSameRows(new String[] {
	 	 meanFruitOutputFilePath,
		 plantLevelOutputFilePath
		// , thirdFileIfAny
	  });
  }

  @Test
  public void allColumns_withinDiscrepancyThreshold() {
    String[] excludedColumns = {
      "timestamp",
      // NaN columns
      "meanFruitFW_2",
      "meanFruitFW_3",
      "meanFruitDW_2",
      "meanFruitDW_3",
      "meanFruitSc_2",
      "meanFruitSc_3",
      "simuuid",
      "WUE",
      "waterPotential_phloem",
       //columns with large variations
      "fPARMid",
      "fPARUp",
      "fPARLow",
      "fPAR_1",
      "fPAR_2",
      "fPAR_3",
      "fPAR_4",
      "cumLAI_4",
      "pruneFruitBiomassRemoved",
      "fruitIncidentPAR_mean_umol_m2_s",
      "fruitAbsorbedPAR_sum_umol_s",
      "fruitAbsorbedRadiation_sum_modelRad_s",
      "fruitCount",
      "fruitIncidentPAR_mean_b1_umol_m2_s",
      "fruitIncidentPAR_mean_b2_umol_m2_s",
      "fruitIncidentPAR_mean_b3_umol_m2_s",
      "fruitIncidentPAR_mean_b4_umol_m2_s",
      "fruitAbsorbedPAR_sum_b1_umol_s",
      "fruitAbsorbedPAR_sum_b2_umol_s",
      "fruitAbsorbedPAR_sum_b3_umol_s",
      "fruitAbsorbedPAR_sum_b4_umol_s",
      "fruitAbsorbedRadiation_sum_b1_modelRad_s",
      "fruitAbsorbedRadiation_sum_b2_modelRad_s",
      "fruitAbsorbedRadiation_sum_b3_modelRad_s",
      "fruitAbsorbedRadiation_sum_b4_modelRad_s",
      "fruitCount_b1",
      "fruitCount_b2",
      "fruitCount_b3",
      "fruitCount_b4",
      "fraction_fruitUnloading",
      "growthCostFruit",
      "osmoticWaterPotential_partialContribution",
	  "leafArea",
	  "meanPAnet",
	  "meanAnet",
	  "biomassLeaf",
	  "fraction_leafUnloading",
	  "maintenanceLeaf",
	  "cumLAI_1",
	  "cumLAI_2",
	  "cumLAI_3",
	  "sugarConcentration_1",
	  "sugarConcentration_2",
	  "sugarConcentration_3", 
	  "sugarConcentration_4"
      
    };
    List failedColumns = discrepancyTestMethods.columnsWithinDiscrepancyThreshold(
      excludedColumns,
      true
    );

    assertTrue(
      "Columns not within discrepancy threshold: " +
      Arrays.toString(failedColumns),
      failedColumns.isEmpty()
    );
  }

  @Test
  public void meanFruitFW_hasLessOrEqualRMSE() {
    assertTrue(
      rmseTestMethods
        .at(steps)
        .hasLessOrEqualRMSE("meanFruitFW", "FW.without.seed")
    );
  }

  @Test
  public void meanFruitDW_hasLessOrEqualRMSE() {
    assertTrue(
      rmseTestMethods
        .at(steps)
        .hasLessOrEqualRMSE("meanFruitDW", "berry.dw.NO.SEED.mg")
    );
  }

  @Test
  public void meanFruitSc_hasLessOrEqualRMSE() {
    assertTrue(
      rmseTestMethods
        .at(steps)
        .hasLessOrEqualRMSE("meanFruitSc", "Hexose.g.gh20")
    );
  }
}

