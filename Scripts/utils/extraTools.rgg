}


/**
 * Splits the given string into separate substrings based on the characters "_" and ".",
 * and combines the middle words into a single new string to extract a flexible portion of the filename.
 * 
 * @param str the input string to be split and processed
 * @return a string representing the portion between "model.options." and ".json"
 */
public static String splitAndCombine(String str) {
    // Check if the string contains "model.options." and ".json"
    int modelOptionsIndex = str.indexOf("model.options.");
    int jsonIndex = str.lastIndexOf(".json");

    // Ensure "model.options." and ".json" exist in the string
    if (modelOptionsIndex == -1 || jsonIndex == -1 || modelOptionsIndex >= jsonIndex) {
        return "";  // Return empty if not a valid input
    }

    // Extract the substring between "model.options." and ".json"
    String substring = str.substring(modelOptionsIndex + "model.options.".length(), jsonIndex);

    // Split the extracted substring by special characters: ".", "_", and "-"
    String[] splitValues = substring.split("[._-]");

    // Combine the parts using underscores
    StringBuilder result = new StringBuilder();
    for (String part : splitValues) {
        if (!part.isEmpty()) { // Avoid appending empty strings
            result.append(part).append("_");
        }
    }

    // Remove the trailing underscore
    if (result.length() > 0 && result.charAt(result.length() - 1) == '_') {
        result.setLength(result.length() - 1);
    }

    return result.toString();
}

public static String extractOrGenerateUUID(String filename) {
        // Regex for UUID at the end, before ".json"
        Pattern pattern = Pattern.compile("([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\\.json$");
        Matcher matcher = pattern.matcher(filename);
        if (matcher.find()) {
            return matcher.group(1);
        } else {
            return UUID.randomUUID().toString();
        }
    }





/** 
 * measure stick to have a visual comparison
 *
 * @param steps - number of steps
 * @param stepsize - length of one step (in meter)
 *
 */
module measureStick(int steps, float stepsize) ==>
{
	float width = (0.5*stepsize<0.75)?(0.5*stepsize):0.75;
}
	// position	
	RU(90) M(5* stepsize) RU(-90)
	// constructing the stick
	for(int i:(1:steps))( 
		F(stepsize, width ).(setShader((i%2==0)?WHITE:GRAY), setLayer(0)) 
		[
			RU(90) M(2* width) RU(-90) 
			//round, multiply and divied, because of java has problems with simple calculations :-(
			TextLabel( (Math.round((i*stepsize)*100)/100f)+" m" ).(
				setColor(new Color3f(0,0,0)),
				setLayer(1)
			)
		]
	)
;



// simulation time measurement
static double start;						// starting system time (ms)
static double stop;							// stopping system time (ms)
static double realTime;						// simulation running time (s)
static double simRate;						// current rate of simulation (model time step per second)
static double avgRate;						// average rate of simulation (model time step per second)

static void calcSimTime() {
    if (step == 0) {
        start = System.currentTimeMillis();
        realTime = 0;
        simRate = 0;
    } else {
        double prev = realTime;
        realTime = (System.currentTimeMillis() - start) / 1000;
        simRate = 0.01 * Math.round(100 * (realTime - prev));
    }
 
}
