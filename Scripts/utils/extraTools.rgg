/**
 * The CommandLineArgs class provides methods to interact with the command line arguments and properties,
 * allowing retrieval of raw and parsed properties and arguments.
 * 
 * This class is used to access properties and arguments passed to the application and parse them if they are
 * in JSON format.
 */
public class CommandLineArgs implements Serializable {
    
    /**
     * Retrieves the raw property value associated with the specified key.
     * 
     * This method fetches the raw string value of a property by calling the underlying application logic.
     * The property value is returned as a string without any parsing.
     *
     * @param key the property key whose value is to be retrieved
     * @return the raw property value as a string, or null if the key does not exist or the value is not set
     */
    public String getRawProperty(String key) {
        // Fetches the raw property using an external application method
        String rawProperty = de.grogra.pf.boot.Main.getProperty(key);
        return rawProperty;
    }

    /**
     * Retrieves the property value associated with the specified key, parsed as a JSON object.
     * 
     * This method first retrieves the raw property value using {@link #getRawProperty(String)} and attempts
     * to parse it into a JsonNode object. If the property value is null or empty, null is returned.
     *
     * @param key the property key whose value is to be retrieved and parsed
     * @return the parsed JSON property value as a JsonNode, or null if the raw property is not found or invalid
     */
    public JsonNode getProperty(String key) {
        String rawProperty = getRawProperty(key);
        if (rawProperty == null) {
            return null;
        }

        ObjectMapper objectMapper = new ObjectMapper();
        JsonNode prop = objectMapper.readTree(rawProperty);
        return prop;
    }

    /**
     * Retrieves the count of command-line arguments passed to the application.
     * 
     * This method returns the total number of arguments that were passed to the application when it was started.
     * The count includes all arguments, whether they are named or unnamed.
     *
     * @return the number of arguments passed to the application
     */
    public int getArgCount() {
        return de.grogra.pf.boot.Main.getArgCount();
    }

    /**
     * Retrieves the raw command-line argument at the specified index.
     * 
     * This method returns the argument at the given index as a string without any parsing or modification.
     * The argument is retrieved using an external application method and returned as is.
     *
     * @param index the index of the argument to retrieve
     * @return the raw argument value at the specified index, or null if the index is out of bounds
     */
    public String getRawArg(int index) {
        String rawArg = de.grogra.pf.boot.Main.getArg(index);
        return rawArg;
    }

    /**
     * Retrieves the command-line argument at the specified index, parsed as a JSON object.
     * 
     * This method retrieves the raw argument using {@link #getRawArg(int)} and attempts to parse it into a JsonNode object.
     * If the raw argument is null or invalid, null is returned.
     *
     * @param index the index of the argument to retrieve and parse
     * @return the parsed argument value as a JsonNode, or null if the raw argument is not found or invalid
     */
    public JsonNode getArg(int index) {
        String rawArg = getRawArg(index);
        if (rawArg == null) {
            return null;
        }

        ObjectMapper objectMapper = new ObjectMapper();
        JsonNode arg = objectMapper.readTree(rawArg);
        return arg;
    }
}


