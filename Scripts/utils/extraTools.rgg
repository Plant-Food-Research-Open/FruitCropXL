        }
    } catch (Throwable t) {
        warnOnce("fb_missing", "⚠️ FieldBase not available yet (suppressing repeats).");
    }
    return null;
}


/** Write one sampled, read-only leaf-expansion diagnostic row. */
static void writeLeafExpansionDiagnostic(Leaf lf) {
    if (lf == null || !outputLeafGrowthDiagnostics) {
        return;
    }

    // Compatibility guard: old model-option files may omit the sampling key.
    int sampleEvery = 24;
    try {
        sampleEvery = debugLeafExpansionSampleEvery;
    } catch (RuntimeException e) {
        sampleEvery = 24;
    }
    if (sampleEvery <= 0) {
        sampleEvery = 1;
    }
    if ((step % sampleEvery) != 0) {
        return;
    }

    LeafExpansionDiagnosticOutputData row =
        new LeafExpansionDiagnosticOutputData();
    row.timestamp = timestamp;
    row.step = step;
    row.year = year;
    row.dayOfYear = dayOfYear;
    row.hourOfDay = hourOfDay;
    row.scenario = scenario;
    row.simuuid = simUUID;
    row.plantNumber = lf.plantNumber;
    row.fieldInstanceId = lf.fieldInstanceId;
    row.cordonNumber = lf.cordonNumber;
    row.nodeNumber = lf.nodeNumber;
    row.rank = lf.rank;
    row.leafId = lf.nodeID;
    row.appleLeafDevelopmentClass =
        (lf.appleLeafDevelopmentClass == null)
            ? ""
            : lf.appleLeafDevelopmentClass;
    row.fastEarlyExpansionLeaf = lf.fastEarlyExpansionLeaf;
    row.rosetteExpansionScaleUsed = lf.rosetteExpansionScaleUsed;
    row.debugValid = lf.dbg_validStep == step;
    row.dbg_validStep = lf.dbg_validStep;
    row.age = lf.age;
    row.isGrowing = lf.age < lf.te;
    row.dbg_growthActive = lf.dbg_growthActive;
    row.length = lf.length;
    row.area = lf.area;
    row.potentialFinalSize = lf.potentialFinalSize;
    row.realizedFinalSize = lf.realizedFinalSize;
    row.profileFinalSizeLocked = lf.profileFinalSizeLocked;
    row.currentAreaToRealizedFinalRatio =
        lf.currentAreaToRealizedFinalRatio;
    row.maxLength = lf.maxLength;
    row.potLength = lf.potLength;
    row.tm = lf.tm;
    row.te = lf.te;
    row.parentID = lf.parentID;
    row.plantBaseID = lf.plantBaseID;
    row.earlyLeafFallbackUsedThisStep =
        lf.earlyLeafFallbackUsedThisStep;
    row.hasValidLeafLightForPhotosynthesis =
        lf.hasValidLeafLightForPhotosynthesis;
    row.incPARm2 = lf.incPARm2;
    row.absm2 = lf.absm2;
    row.absPAR = lf.absPAR;
    row.PAnet = lf.Alim;
    row.Anet = lf.AlimActual;
    row.waterFluxPotential = lf.waterFluxPotential;
    row.Lpot = lf.dbg_Lpot;
    row.fw = lf.dbg_fw;
    row.fc = lf.dbg_fc;
    row.dL_pot = lf.dbg_dL_pot;
    row.dL_w = lf.dbg_dL_w;
    row.dL_final = lf.dbg_dL_final;
    row.dA_pot = lf.dbg_dA_pot;
    row.dA_w = lf.dbg_dA_w;
    row.dA_final = lf.dbg_dA_final;
    row.waterPotential = lf.waterPotential;
    row.sugarConcentration_phloem = lf.dbg_sc_phloem;
    row.structureDM_PRI_PT = lf.structureDM_PRI_PT;
    row.structureDM = lf.structureDM;
    row.unloading = lf.unloading;
    row.carbon_nonStructure = lf.carbon_nonStructure;
    row.fNSC = lf.fNSC;
    row.loading = lf.loading;
    row.carbonAssimilation = lf.carbonAssimilation;
    row.maintenanceDM = lf.maintenanceDM;

    DiagnosticTableCoordinator.writeLeafExpansion(row);
}
