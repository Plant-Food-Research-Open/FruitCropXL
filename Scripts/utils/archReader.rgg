/** Factory for creating XNode objects. */
public static IRowFactory xNodeFactory = new XNodeRow();

/** Translation offsets for positioning the first trunk. */
global double tx, ty, tz;

/** Indicates whether the shoot initialization has been performed. */
public static boolean shootsInitiated; 

/** Post-read correction: extend first trunk if internode world-Z goes below ground. */
global boolean fixNegativeZByExtendingTrunk = true;
/** Numerical tolerance for negative Z check. */
global double fixNegativeZ_eps = 1e-6;
/** Debug prints for post-read correction. */
global boolean fixNegativeZ_debug = true;
/** Trace whether creation is using absolute/world placement during reconstruction. */
global boolean fixNegativeZ_traceAbsolutePlacement = true;
/** Placement fallback: clamp negative lateral displacement to avoid below-ground attachment. */
global boolean clampNegativeLateralDisplacement = true;
/** Strengthen first-trunk extension: delta = abs(minZ) * factor. */
global double fixNegativeZ_trunkLengthFactor = 1.5;
/** Final cleanup: skip internodes whose source z is below ground. */
global boolean removeNegativeZInternodes = true;
/** Robust grounding: shift non-root NodeMap z before build and during post-fix if still negative. */
global boolean fixNegativeZ_shiftNodeMapZ = true;
/** Optional world-lift fallback chain (anchor/base/non-root). */
global boolean fixNegativeZ_enableTransformFallback = true;
/** Optional last-resort non-root organ bulk-lift; disabled by default because it can destabilize transforms. */
global boolean fixNegativeZ_enableNonRootOrganLiftFallback = false;
/** Number of derive passes after trunk/global lift so transforms can settle. */
global int fixNegativeZ_settleDerivePasses = 2;
/** Deferred contexts for running post-read negative-Z fix after global init derive. */
global ArrayList deferredNegativeZFixContexts = new ArrayList();
/** Deferred contexts pending stage-2 fallback/prune check. */
global ArrayList deferredNegativeZFixStage2Contexts = new ArrayList();


// --- DEBUG counters ---
static int dbgLeafBodyCreated = 0;
static int dbgRosetteLeafBodyCreated = 0;
static int dbgLeafStemCreated = 0;
static int dbgLeafEndNodesSeen = 0;


/**
 * Record creation for a node id and warn if the same id is created twice.
 */
static void dbgRecordCreate(XNode n, String tag) {
    if (n == null) return;
    Integer key = Integer.valueOf(n.id);
    Object prev = dbgCreatedById.get(key);
    if (prev != null) {
        println("[DUP_CREATE] id=" + n.id + " prev=" + prev + " now=" + tag + " organType=" + n.organType + " pid=" + n.pid);
    } else {
        dbgCreatedById.put(key, tag);
    }
}


