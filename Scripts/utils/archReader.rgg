	/**
	 * Create node object for construction based on row information
	 * add ID to each node and add node to the NodeMap
	 */	
	public void initNodeMapWithID() {
	  for (Object k : rowMap.keySet()) {
		int plantID = (Integer) k;
		Map plantMap = getPlantMap(plantID);
		NodeMap nodes = getNodeMap(plantID);
	
		maxNodeID = 0;
	
		for (List rowList : plantMap.values()) {
		  for (Object obj : rowList) {
			XNodeRow row = (XNodeRow) obj;
	
			// USE CSV IDs (do NOT renumber)
			int csvId = row.getInt("id");
			int csvPid = row.getInt("parent");
	
			XNode node = row.toXNode();
			node.id = csvId;
			node.pid = csvPid;   // ensure consistent (in case toXNode didn’t set it)
	
			row.id = csvId;
			row.pid = csvPid;
	
			nodes.addNode(node);
			if (csvId > maxNodeID) maxNodeID = csvId;
		  }
		}
		assignApexNodes(plantID);
		println("[NM] plantID=" + plantID + " nodes.size=" + nodes.size());
int shown = 0;
for (Object kk : nodes.getKeySet()) {
    if (shown++ >= 5) break;
    XNode t = nodes.getNode(kk);
    println("[NM] sample id=" + kk + " pid=" + (t==null ? "null" : ""+t.pid) + " type=" + (t==null ? "null" : t.organType));
}

	  }
	}



/**
 * assign apex node
 * apex node can grow out in future and make the plants grow dynamics
 */	
	protected void assignApexNodes(int plantID) {
		Map plantMap = getPlantMap(plantID);
		NodeMap nodes = getNodeMap(plantID);

		for (List rowList : plantMap.values()) { 
			/* 	
				We designate the second to last XNode as the apex because
				the very last node is not used to create an organ.
			*/
			int arraySize = rowList.size() -2;
			if(arraySize <= 0) { continue; }
			RowBase apexRow = (RowBase) rowList.get(arraySize);
			XNode node = nodes.getNode(apexRow.id);
			node.isApex = true;
		}
	}

	public XEGDataReader(String pathInput, IRowFactory rowFactory) {
		//super calls the parent constructor
		super(pathInput, rowFactory); 
	}
}

static void loadNodeMap(XEGDataReader reader, String fileName) {
	reader.readData(fileName);
	reader.initNodeMapWithID();
}



//map of XNode


class NodeMap implements Serializable {
    Map r = new HashMap();

    public void addNode(XNode n) { r.put(Integer.valueOf(n.id), n); }

    public XNode getNode(Object id) { return (XNode) r.get(id); }

    // FIX: return a Set so foreach iterates correctly
    public Set getKeySet() { return r.keySet(); }

    public int size() { return r.size(); }
}


public static Point3d minus(Point3d a, Point3d b) {
	return new Point3d(a.x - b.x, a.y - b.y, a.z - b.z);
}

static boolean isEndNode(XNode n) {
    if (n == null || n.organType == null) return false;
    String t = n.organType;
    return isBudEndNode(n)
        || (t.indexOf("LeafEND") >= 0)
        || (t.indexOf("RosetteLeafEND") >= 0)
        || (t.indexOf("FruitEND") >= 0);
}

static boolean isBudEndNode(XNode n) {
    if (n == null || n.organType == null) return false;
    String t = n.organType.toLowerCase();
    return (t.indexOf("end_bud") >= 0) || (t.indexOf("budend") >= 0);
}


