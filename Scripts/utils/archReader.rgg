/** Interface for organ factories used to create plant organs from nodes. */
interface IOrganFactory {

    /**
     * Creates an organ from a given XNode.
     * 
     * @param N The XNode representing the organ.
     * @return A newly created organ.
     */
    Organ create(XNode N);

    /**
     * Creates a new organ node based on the provided XNode.
     * 
     * @param N The XNode used to initialize the organ node.
     * @return A new organ node.
     */
    Organ createNode(XNode N);
}

/**
 * Base class for organ factories, implementing common creation behavior.
 * Can be extended by specific factories such as RootFactory or ShootFactory.
 */
abstract class OrganFactoryBase implements IOrganFactory {
    
    /** Plant identifier containing unique plant metadata. */
    public PlantIdentifier pi;

    /**
     * Creates a generic organ node when no specific organ type is provided.
     *
     * @param N The XNode from which to create the organ node.
     * @return A generic OrganNode instance.
     */
    public Organ createNode(XNode N) {
        return new OrganNode();
    }
}

/**
 * Module representing a generic plant organ node.
 * This is the base node for shoot and root meristems.
 */
module OrganNode() extends Organ {
    {
        // Default length initialization
        this.length = 1e-10;
    }
}

/**
 * Module representing a shoot meristem, derived from OrganNode.
 * Contains shoot-specific attributes such as breakout status and an associated XNode.
 */
module ShootMeristem extends OrganNode {

    /** The associated XNode representing shoot-specific data. */
    XNode N;

    /** Indicates whether the shoot has broken out of dormancy. */
    boolean hasBreakout = false;

    /**
     * Constructor initializing the ShootMeristem with an associated XNode.
     *
     * @param N The XNode containing shoot-specific data.
     */
    public ShootMeristem(XNode N) {
        this.N = N;
    }
}

/** Does this shoot-code string correspond to a vegetative shoot? */
static boolean isVegetativeShootCode(String code) {
    if (code == null) return false;
    String norm  = code.trim();
    String upper = norm.toUpperCase();

    // 1) Strong patterns first
    if (upper.contains("B_V")) return true;   // vegetative bud/shoot
    if (upper.contains("F") || upper.contains("B_F")) return false;

    // 2) Look at tokens after splitting
    String[] splitValues = norm.split("[_\\.]");
    if (splitValues.length > 2 && splitValues[2] != null) {
        String tok = splitValues[2].toUpperCase();  // e.g. "V#1"
        if (tok.contains("V")) return true;
        if (tok.contains("F")) return false;
    }


    return false; // unknown => assume non-vegetative in this helper
}


/**
 * Module representing a root meristem, derived from OrganNode.
 * Specifically used for aggregated root data processing.
 */
module RootMeristem extends OrganNode {
	//for the aggregated root node   
	XRootNode N;
    boolean hasBreakout = false;
    
	 public RootMeristem(XNode node) {
			if (node instanceof XRootNode) {
				this.N = (XRootNode) node;
			} else {
				// Handle the case where node is not an XRootNode
				// For example, leave N as null or throw an exception
				this.N = null; // or do nothing
			}
			hasBreakout = false;
		}
}


/**
	 * Tree factory for creating different organ type based on order levels
	 * For order larger than four, there were different organ types corresponding to the same order
	 */	
class TreeFactory extends OrganFactoryBase { 
	
	private static double sanitizeAxisDiameter(double diameter) {
		// ArchReader input may contain zero/near-zero axis diameters (legacy reconstruction artifacts).
		// Keep a biologically plausible minimum to avoid near-zero biomass and unstable first-step C pools.
		double minAxisDiameter = 2e-3; // m
		if (Double.isNaN(diameter) || Double.isInfinite(diameter) || diameter < minAxisDiameter) {
			return minAxisDiameter;
		}
		return diameter;
	}
	
	
	public Organ create(XNode N) {
				 
		/* Other columns can be accessed from the row object like this: */ 
			 if(N.organType.contains("Trunk")) {
			 	 	N.diameter = sanitizeAxisDiameter(N.diameter);
			 	 	Trunk o = new Trunk();
			 	 	o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
					return o;
			 }
			  else if(N.organType.contains("Cordon") | N.organType.contains("Cane") | N.organType.contains("Arm")) {
			 	 	N.diameter = sanitizeAxisDiameter(N.diameter);
			 	 	Cordon o = new Cordon();
			 	 	o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
			 	 	//if (printFlag) { println("this. ageD: " + o.ageD); }
					return o;
			 }
			 else if(N.organType.contains("Upright")|N.organType.contains("OldShoot")|
			 	 	 N.organType.contains("oldShoot") | 
			 		 N.organType.contains("Spur") | N.organType.contains("Dropper")) {
			 	 	N.diameter = sanitizeAxisDiameter(N.diameter);
			 	 	Cordon o = new Cordon();
					o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
					return o; 
			 }
		 else if(isBudEndNode(N)) {
			  	// Pure bud endpoint: keep available for geometry only, not as a second physiological bud.
			  	return new OrganNode();
	   }
		 else if(N.organType.contains("Bud")) {
				BudService o = new BudCreator(species).createBud();
				//if (printFlag) { println("bud " + N.organType); }
				o.initiate_pi(pi, N.organType).fromXNode(N);
/* 				o.xin = N.start.x;
				o.yin = N.start.y;
				o.zin = N.start.z; */
				//println("N.start.x " + N.start.x);
				return o;
				}
			else if(N.organType.contains("AnnualShoot") | N.organType.equals("Shoot")) {
					Internode o = new Internode();
					N.diameter = sanitizeAxisDiameter(N.diameter);
					o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
					if(isVegetativeShootCode(N.organType)) {
						o.shootType = "_V";
					
				} else {
					o.shootType = "_F";
				} 
				
				return o;
				}
		else if(N.organType.contains("LeafSTEM") | N.organType.contains("RosetteLeafSTEM") ) {
				 dbgLeafStemCreated++;
				 dbgRecordCreate(N, "LeafSTEM");
				Petiole o = new Petiole();
				//if (printFlag) { println("petiole.length" + N.length); }
				o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
				return o;
				}
		else if(N.organType.contains("LeafBODY") | N.organType.contains("RosetteLeafBODY")) {
				 dbgLeafBodyCreated++;
				 dbgRecordCreate(N, "LeafBODY");
				Leaf o = new Leaf();
				o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
				//if(N.organType.contains("Rosette")) if (printFlag) { println("RosetteLeafBODY: length: " + N.length); }
				return o;
				}

		else if(N.organType.contains("FruitSTEM")) {
				Petiole o = new Petiole();
				o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
				
				return o;
				}
		else if(N.organType.contains("FruitBODY")) {
				if(main.FRUIT_CREATOR.usesVirtualFruitService()) {
					FruitService o = main.FRUIT_CREATOR.createFruit(FruitService.originalParametersFactory, FruitService.DELTA);
					o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
					//println("fruit ID:" + o.ID + " " + N.id);
					
					return o;
				} else {
					FruitService o = main.FRUIT_CREATOR.createFruit();
					o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
					return o;
				}
		}
		else if (N.organType != null &&
				(N.organType.indexOf("LeafEND") >= 0
			  	|| N.organType.indexOf("RosetteLeafEND") >= 0
			  	|| N.organType.indexOf("FruitEND") >= 0)) {
			  		dbgLeafEndNodesSeen++;
			  	// Pure endpoint: do not create a physiological organ; avoid falling into default Internode.
			  	return new OrganNode();
	   }
	   else {
				return new OrganNode();
				}
		}
	public Organ createNode(XNode N) {
		return new ShootMeristem(N);
	}

	public TreeFactory(RootBase rb) {
		this.pi = rb.pi;
	}
}


class RootFactory extends OrganFactoryBase { 
	public Organ create(XNode N) {
		String ot = (N == null || N.organType == null) ? "" : N.organType.toLowerCase();
		
		/* Other columns can be accessed from the row object like this: */ 
		  if(ot.indexOf("fineroot") >= 0) {
				FineRoot o = new FineRoot();
				o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
				return o;
			} 
		 else if(ot.indexOf("structuralroot") >= 0) {
		 	    //if (printFlag) { println(pi.plantNumber + "hi" + " N.length " + N.length); }
		 	 	StructuralRoot o = new StructuralRoot();
		 	 	
		 	 	o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
				return o;
				}
		 else if(ot.indexOf("grid") >= 0) {
		 	//if (printFlag) { println(pi.plantNumber + "hi" + " N.length " + N.length); }
				RootMeristem o = new RootMeristem(N);		 		
				o.hasBreakout = true;
				o.pi = this.pi;
				
				return o; 
		 	}				
		 else {
				StructuralRoot o = new StructuralRoot();
		 	 	o.initiate_pi(pi, N.length, N.diameter).fromXNode(N);
				return o;
				}
		}
	
	public Organ createNode(XNode N) {
		return new RootMeristem(N); 	 
	}

	public RootFactory(RootBase rb) {
		this.pi = rb.pi;
	}
}




/* ##################################### Process data from plant reconstruction files #########################################*/


interface IRowFactory {
	RowBase createRow(Map headerMap, String row, String sep);
}

/**
 * Parent module for modules that read, process and store digitalized lidar data
 * name compatible with Ella's previous code on data reconstruction
 */	
abstract module ReconstructionDataReader implements IRowFactory
{
	
	private String filename;
	protected String pathInput;
	protected String sep = ",";
	protected Map headerMap = new HashMap();
	protected Map rowMap = new HashMap();
	protected IRowFactory rowFactory;

	// Return a Vector3D constructed by parsing the coordinates in the given string
	private static Vector3D getCoordVector(String coordString)
	{
		String[] splitString = coordString.split(" ");
		double[] coordArray = new double[splitString.length];
			
		for (int i = 0; i < coordArray.length; i++) {
			coordArray[i] = Double.parseDouble(splitString[i]);
		}
			
		Vector3D coordVector = new Vector3D(coordArray);
		return coordVector;
	}
 
	// Open and read the parameter file into an array of strings
	protected static String[] readFile(String filename) throws IOException 
	{
		String path = PATH_INPUT + filename;
		File file = new File(path);
		StringBuffer sb = new StringBuffer();
		BufferedReader inFile = new BufferedReader(new FileReader(file.getAbsolutePath()));
		String line = "";
		while ((line = inFile.readLine()) != null) {
			sb.append(line+";");
		}				
		inFile.close();
		String data = sb.toString();
		String[] dataArr = data.split(";");
		return dataArr;
	}

	protected String[] readFileFromPath(String filename) throws IOException 
	{
		String path = this.pathInput + filename;	
		File file = new File(path);

		if(!file.exists() || file.isDirectory()) { 
			throw new IOException(String.format("File does not exist: %s", this.pathInput  + filename));
		}

		StringBuffer sb = new StringBuffer();
		BufferedReader inFile = new BufferedReader(new FileReader(file.getAbsolutePath()));
		String line = "";
		while ((line = inFile.readLine()) != null) {
			sb.append(line + "\n");
		}
						
		inFile.close();
		String data = sb.toString();
		String[] dataArr = data.split("\n");
		return dataArr;
	}

	// Read parameters from data file into arrays which will be accessed during initiation
	public void readData(String filename) 
	{	
		String[] dataArr = readFileFromPath(filename);
		List organList;
		RowBase row;

		setHeaders(dataArr[0]);
		overrideHeaders();

		for(int i = 1; i < dataArr.length; i++) { 
			row = createRow(headerMap, dataArr[i], sep);
			organList = getOrganList(row.plantID, row.organID);			
			organList.add(row);
		}
	}
	//put the first row of the data or the column header into headerMap 
	public void setHeaders(String headers) {
		String[] headerArr = headers.split(sep);
		for(int i = 0; i < headerArr.length; i++) { 
			String header = headerArr[i].toLowerCase().trim();
			// Compatibility: some architecture CSVs quote headers (e.g. "id","parent",...)
			// and some editors prepend a UTF-8 BOM to the first header token.
			if ((header.length() > 0) && (header.charAt(0) == '\ufeff')) {
				header = header.substring(1).trim();
			}
			if ((header.length() >= 2) && header.startsWith("\"") && header.endsWith("\"")) {
				header = header.substring(1, header.length() - 1).trim();
			}
			headerMap.put(header, i);
		}
	}
	//get rowMap
	public Map getRowMap() {
		return rowMap;
	}
	//get PlantMap by plantID
	public Map getPlantMap(int plantID) {
		Map plantMap = (HashMap) rowMap.get(plantID);
		if (plantMap == null) {
			plantMap = new HashMap();
			rowMap.put(plantID, plantMap);
		}
		return plantMap;
	}
	//get organ list by plant id and organ id, can add new rows through organList.add(row)
	public List getOrganList(int plantID, int organID) {
		Map plantMap = getPlantMap(plantID);		
		List organList = (ArrayList) plantMap.get(organID);
		if(organList == null) {
			organList = new ArrayList();
			plantMap.put(organID, organList);
		}
		return organList;
	}
	//constructor, not in use
	public ReconstructionDataReader(String pathInput, IRowFactory rowFactory) {
		this.pathInput = pathInput;
		this.rowFactory = rowFactory;
	}
	
	//this is a method in the XNodeRow
	//get the information from the row and convert it into a rowBase
	public RowBase createRow(Map headerMap, String row, String sep) {
		return rowFactory.createRow(headerMap, row, sep);
	}
	////constructor, not in use
	public ReconstructionDataReader setRowFactory(IRowFactory rowFactory) {
		this.rowFactory = rowFactory;
		return this;
	}

	protected void overrideHeaders() {}
}



/**
 * details the information contains in each row
 * contains all the methods for extracting the information from a row string
 */
abstract class RowBase implements IRowFactory {
	
	//identifiers
	int id;
	int pid;  //parent id
	int plantID = 0;
	int organID = 0;
	
	protected String sep = ",";
	protected Map headerMap;
	protected String[] splitRow;

	

	
	public int getHeader(String indxName) {
		//if (printFlag) { println( "indxName " + indxName); }
		//if (printFlag) { println(indxName + " " + headerMap.get(indxName)); }
		String headerKey = indxName;
		if (headerKey != null) {
			headerKey = headerKey.toLowerCase().trim();
		}
		Integer headerIndex = (Integer) headerMap.get(headerKey);
		if ((headerIndex == null) && (headerKey != null) && (headerKey.length() > 0)) {
			headerIndex = (Integer) headerMap.get("\"" + headerKey + "\"");
		}
		if (headerIndex == null) {
			throw new RuntimeException("Missing architecture CSV header '" + indxName
					+ "' in archReader (available=" + headerMap.keySet() + ")");
		}
		return headerIndex.intValue();
	}

	public String get(String indxName) {
		int indx = getHeader(indxName);
		return splitRow[indx];
	}
	
	public int getInt(String indxName) {
		int indx = getHeader(indxName);
		return Integer.parseInt(splitRow[indx]);
	}

	public double getDouble(String indxName) {
		int indx = getHeader(indxName);
		return Double.parseDouble(splitRow[indx]);
	}
	public String getString(String indxName) {
		int indx = getHeader(indxName);
		return splitRow[indx];
	}

 	 public double[] getCoordinates(String indxName) {
		int indx = getHeader(indxName);
		String[] coordinates = splitRow[indx].split(" ");

		double[] c = new double[coordinates.length];
		for (int i = 0; i < coordinates.length; i++) {
			c[i] = Double.parseDouble(coordinates[i]);
		}
		return c;
	}  
 	// Return a Vector3D constructed by parsing the coordinates in the given string
	protected Vector3D getCoordVector(String coordString)
	{
		String[] splitString = coordString.split(" ");
		double[] coordArray = new double[splitString.length];
			
		for (int i = 0; i < coordArray.length; i++) {
			coordArray[i] = Double.parseDouble(splitString[i]);
		}
			
		Vector3D coordVector = new Vector3D(coordArray);
		return coordVector;
	} 

	public String[] split(String row) {
		return row.split(sep);
	}


	public RowBase() {}

	public RowBase(Map headerMap, String row, String sep) {
		this.headerMap = headerMap;
		splitRow = this.split(row);
		this.sep = sep;
	}

	// Convert raw row to row object
	RowBase toRow() { return this; }
}


/*********************************************** 

	XEG Reader
	* Reads object coordinates from a CSV file.
	* Initialises the system based upon these coordinates.
	* Mandatory columns:
		* Order: The object order within the system config.
		* Parent: The object parent ID, in reference to the row ID.
			* The system root has a row ID of -1.
		* Diameter: The object diameter.
		* x, y, and z: The 3D coordinate columns.
	* Optional columns:
		* ID: Unique ID per row starting from 1.

************************************************/

module XEGDataReader extends ReconstructionDataReader {
	protected Map nm = new HashMap();
	int maxNodeID = 0; // Tracks the maximum node ID
	
	public NodeMap getNodeMap(int plantID) {
		NodeMap nodes = (NodeMap) nm.get(plantID);
		if(nodes == null) {
			nodes = new NodeMap();
			nm.put(plantID, nodes);
		}
		return nodes;
	}

