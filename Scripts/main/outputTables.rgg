static PlantBase findOutputPlantBase() {
	PlantBase pb = first((* p:PlantBase, (p.isReportable && p.fieldInstanceId == 0 && p.plantNumber == INDI_ID_A && p.border == false) *));
	if (pb == null) pb = first((* p:PlantBase, (p.isReportable && p.fieldInstanceId == 0 && p.plantNumber == INDI_ID_A) *));
	if (pb == null) pb = first((* p:PlantBase, (p.isReportable && p.fieldInstanceId == 0 && p.border == false) *));
	if (pb == null) pb = first((* p:PlantBase, (p.isReportable && p.fieldInstanceId == 0) *));
	if (pb == null) pb = first((* p:PlantBase, (p.isReportable && p.plantNumber == INDI_ID_A && p.border == false) *));
	if (pb == null) pb = first((* p:PlantBase, (p.isReportable && p.plantNumber == INDI_ID_A) *));
	if (pb == null) pb = first((* p:PlantBase, (p.isReportable && p.border == false) *));
	if (pb == null) pb = first((* p:PlantBase, (p.isReportable) *));
	return pb;
}

static FieldBase findOutputFieldBase() {
	FieldBase fb = first((* f:FieldBase, (f.isReportable && f.fieldInstanceId == 0) *));
	if (fb == null) fb = first((* f:FieldBase, (f.isReportable) *));
	return fb;
}

static RootBase findOutputRootBase(PlantBase pb) {
	if (pb == null) return null;
	return first((* r:RootBase, (
		r.plantNumber == pb.plantNumber &&
		r.fieldInstanceId == pb.fieldInstanceId &&
		r.isReportable == pb.isReportable
	) *));
}

static FineRoot findOutputFineRoot(PlantBase pb) {
	if (pb == null) return null;
	return first((* f:FineRoot, (
		f.plantNumber == pb.plantNumber &&
		f.fieldInstanceId == pb.fieldInstanceId &&
		f.isReportable == pb.isReportable
	) *));
}

static Soil findOutputSoil(PlantBase pb) {
	if (pb == null) return null;
	return first((* s:Soil, (
		s.plantNumber == pb.plantNumber &&
		s.fieldInstanceId == pb.fieldInstanceId &&
		s.isReportable == pb.isReportable
	) *));
}

static FruitService findOutputFruitService(PlantBase pb) {
	if (pb == null) return null;
	return first((* b:FruitService, (
		b.plantNumber == pb.plantNumber &&
		b.fieldInstanceId == pb.fieldInstanceId &&
		b.isReportable == pb.isReportable
	) *));
}

static Trunk findOutputTrunk(PlantBase pb) {
	if (pb == null) return null;
	return first((* t:Trunk, (
		t.plantNumber == pb.plantNumber &&
		t.fieldInstanceId == pb.fieldInstanceId &&
		t.isReportable == pb.isReportable
	) *));
}

static void logSelectedOutputPlant(String context, PlantBase pb) {
	if (pb != null && printFlag && (debug || step <= 3)) {
		println("outputTables[" + context + "] pbId=" + pb.getId()
			+ " plantNumber=" + pb.plantNumber
			+ " fieldInstanceId=" + pb.fieldInstanceId
			+ " isReportable=" + pb.isReportable
			+ " fabs=" + pb.fabs
			+ " fpar=" + pb.fpar
			+ " leafPAR=" + pb.leafPAR);
	}
}







