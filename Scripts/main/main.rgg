 * running with headless mode
***************************************************************************************/
/**
 * Initializes the simulation environment during startup.
 * <p>
 * Checks if the application is running in a headless environment and schedules a deferred
 * execution of the {@link #run(Object)} method if necessary.
 * </p>
 */
protected void startup() 
{
	super.startup();
	if (de.grogra.pf.boot.Main.getProperty("headless") != null) {
		runLater(null);
	}
	
}


/**
 * Stores the arguments for the GroIMP model passed through command line.
 */
public class ModelArgs implements Serializable {
	/**
	 * headless is the default option for running on servers and for
	 * launching large simulations
	 * used for controlling whether to repaint the view as well
	 * If set, the simulation will run without any graphical user interface (useful for server environments).
	 */
	public static String headless;
	
	/**
	 * If set to true, the simulation will reinitialize all model variables and start from scratch.
	 * If set to false, the simulation will attempt to load variables from a previously saved state and continue.
	 * This flag should be set based on whether the user wants to start a new simulation or resume an existing one.
	 * default to true
	 */
	public static String reset = "true";
	
	/**
	 * Path to the root directory of the model.
	 * If set, it will override the default working directory as the main path for the simulation.
	 */
	public static String modelPath;
	
	/**
	 * Path to the directory of the model scenario independently.
	 * If set, it will override the default working directory as the scanrio fold for the simulation.
	 * this is very useful for parameter optimization, batch simulations with different model scenarios
	 * but would like to keep the input the same
	 */
	public static String modelScenarioPath;
	
	/**
	 * Path to the directory of the shoot architecture file
	 * If set, it will read the the shoot architecture file from the new folder instead of Model_input
	 */
	public static String shootArchitecturePath;

	/**
	 * Path to the output directory of the model.
	 * If set, the model will output files to this directory.
	 */
	public static String outputPath;

	/**
	 * Path to a file containing model options.
	 * If provided, the simulation will read model configurations from this file.
	 */
	public static String modelOptions;

	/**
	 * Number of cores to use for the simulation. use in the cocurrent plugin.
	 * If set, the simulation will utilize the specified number of CPU cores for parallel processing.
	 */
	public static int nCores = 4;
	
	/**
	 * useShadingFactor controls whether use cloned plants 
	 * i need to control this in model argument as i need to be able to switch this on powerplant
	 * to run simulations both with clone and without clone to calculate the shading factor
	 */
	public static String shadingFactor = "true";
	
	/**
	 * Number of end steps to run for the simulation.
	 * If specified, the simulation will run scenarios for a given number of steps and output results accordingly.
	 * This value must be between 1 and 9 to use reduced clone nodes.
	 */
	public static String runEndSteps;
	
	
	/**
	 * Mode to run basic unit tests. 
	 * If set, the simulation will execute unit tests and output results to an XML file.
	 */
	public static String testMode;
	
	/**
	 * Mode to run validation tests.
	 * If set, the simulation will execute validation tests to verify expected behaviors.
	 */
	public static String validationMode;
	
	/**
	 * Mode to launch a server instance.
	 * If set, the simulation will start a server to serve simulation-related requests.
	 * if XServer is not added in the headless run command, then it will run the simRun configured in the simRun
	 *	complex simulations will be configured in the simConfig, and launch using the methods in simRun
	 */
	public static String serverMode;
	
	/**
	 * Specifies a dataset for running a simulation.
	 * If set, the simulation will be initialized from the given dataset.
	 */
	public static String fromDataset;
	

	/**
	 * Phase of the simulation in progress.
	 * This is a custom argument used for specialized simulation processes (like DHS workflows).
	 */
	public static String phase;
	
	/**
	 * Path to the simulation instance XML file.
	 * This file provides the necessary configuration for running a specific simulation scenario.
	 */
	public static String request;

	public static void init() {
		ModelArgs.modelPath = commandLineArgs.getRawProperty("modelPath");
		ModelArgs.modelScenarioPath = commandLineArgs.getRawProperty("modelScenarioPath");
		ModelArgs.shootArchitecturePath = commandLineArgs.getRawProperty("shootArchitecturePath");
		
		ModelArgs.outputPath = commandLineArgs.getRawProperty("outputPath");
		ModelArgs.headless = commandLineArgs.getRawProperty("headless");
		ModelArgs.runEndSteps = commandLineArgs.getRawProperty("runEndSteps");
		ModelArgs.shadingFactor = commandLineArgs.getRawProperty("shadingFactor");
		
		String resetArg = commandLineArgs.getRawProperty("reset");
		if (resetArg != null && !resetArg.isEmpty()) {
			ModelArgs.reset = resetArg;
		}
		println("resetArg: " + resetArg + " reset: " + reset);
		
				
	try {
		String nCoresStr = commandLineArgs.getRawProperty("nCores");
		if (nCoresStr != null) {
			nCoresStr = nCoresStr.trim();
			if (nCoresStr.length() > 0 && !"null".equalsIgnoreCase(nCoresStr)) {
				nCores = Integer.valueOf(nCoresStr).intValue(); // 1.5 compatible
			} else {
            ModelArgs.nCores = Runtime.getRuntime().availableProcessors(); // Default to available cores
            println("nCores not provided. Defaulting to: " + ModelArgs.nCores);
        }
	    } else {
            ModelArgs.nCores = Runtime.getRuntime().availableProcessors(); // Default to available cores
            println("nCores not provided. Defaulting to: " + ModelArgs.nCores);
        }
		} catch (NumberFormatException e) {
			println("Invalid value for nCores. Using 1 core as fallback.");
			ModelArgs.nCores = 2; // Fallback to a single core if parsing fails
		}
				
		ModelArgs.testMode = commandLineArgs.getRawProperty("runTests");
		ModelArgs.validationMode = commandLineArgs.getRawProperty("runValidationTests");
		ModelArgs.serverMode = commandLineArgs.getRawProperty("server");
		ModelArgs.fromDataset = commandLineArgs.getRawProperty("fromDataset");
		
		//dhs arguments
		ModelArgs.phase = commandLineArgs.getRawProperty("phase");
		//the simulation instance xml file
		ModelArgs.request = commandLineArgs.getRawProperty("request");

		ModelArgs.modelOptions = commandLineArgs.getRawProperty("modelOptions"); // Deprecated
		if (ModelArgs.phase != null && ModelArgs.modelOptions != null)
		{
			println("*** Warning ***: using (deprecated) commandline model options file specifier: " + ModelArgs.modelOptions);
			println("in conjunction with DHS model phase: " + ModelArgs.phase);
			

			boolean strict_commandline_options = true;
			if (strict_commandline_options)
			{
				println("... terminating execution.");
				System.exit(1);
			} else {
				println("... ambiguous model.options handling may cause errors.");
				println("... use model options passed via the simulation request instead.");
			}
		}


    
		if(ModelArgs.modelPath == null) { 
			MAINPATH = Library.getWD() + "/../";
			assignPath();
		} else { 
			MAINPATH = ModelArgs.modelPath; 
			assignPath();
		}
		if (ModelArgs.modelScenarioPath != null) {
			PATH_SCENARIOS = ModelArgs.modelScenarioPath + "/";
		}
		if (ModelArgs.outputPath != null) {
			PATH_OUTPUT = ModelArgs.outputPath + "/";
		}
	}
	
}

/**
 * Executes the main simulation logic or related tasks based on the input arguments.
 * <p>
 * This method interprets command line arguments to determine the mode of operation.
 * Depending on the arguments, it might:
 * - Run unit tests and output results to an XML file.
 * - Run validation tests.
 * - Run a simulation using a given dataset.
 * - Launch a server instance.
 * - Execute the default simulation logic.
 * </p>
 * <p>
 * After executing the desired task, the application is terminated.
 * </p>
 *
 * @param info Auxiliary information that might be needed for the run. Currently unused.
 */
		 
protected void run(Object info) {
//public void test() {  //on local UI environment

	// BasicMinervaHelper minerva = new BasicMinervaHelper("dhs-simulation-artifacts");  // (global)

	ModelArgs.init();

	println("modelPath: " + ModelArgs.modelPath);

	if (ModelArgs.phase != null && ModelArgs.request != null) {
		println("running on DHS platform.");
		println("sim request: " + ModelArgs.request);

		String xmlFilePath = MAINPATH + ModelArgs.request;
		// In GroIMP, you might use a different method to parse XML, depending on the available API.
		// The following is a hypothetical example as the actual method would depend on GroIMP's XML parsing capabilities.
		
		RequestHandler.init(xmlFilePath);
		println("FruitCropXL_water_OID: " + CacheManager.FruitCropXL_water_OID);
		
		stepwiseOutput = true;

		if (ModelArgs.phase.equals("run")) {
			runModelPhase();
		} else if (ModelArgs.phase.equals("prep")) {
			prepModelPhase();
		} else if (ModelArgs.phase.equals("post")) {
			postModelPhase();
		} else if (ModelArgs.phase.equals("control")) {
			controlModelPhase();
		}
		else {
			println("Error: invalid phase mode '" + ModelArgs.phase + "'"); // FIXME: check how to send errors to the DHS Platform, e.g: RunTimeExceptions
			System.exit(1); // TODO: check if this exit code is a correct error code for the DHS Platform
		}
	} else { // Default case as existing scripts calling the model do not pass a phase or request
		runStandalone();
	}

	println("Ending the model execution");
	System.exit(0);
}  

/**
 * Preparation model phase for the DHS Platform.
 */
private void prepModelPhase() {
	println(MODEL_ID + ": Running prep model phase");
	CacheManager.registerStateVariables();
/* 	double[] waterFlux = {0.1, 0.2, 0.3, 0.3};
	cacheCom.writeWaterUptake(step, waterFlux); */
}


/**
 * Run model phase for the DHS Platform.
 */
protected void runModelPhase() {
	if (printFlag) { println(MODEL_ID + ": Running run model phase"); }
	keepTable = false;
	setSeed(12345679);

    // String scenario_name = "default";
    
    String pfx_plant_level = PATH_OUTPUT + scenario_name + "/plant-level-" + scenario_name + "-step-";
    String pfx_field_level = PATH_OUTPUT + scenario_name + "/field-level-" + scenario_name + "-step-";
    String oid_pl;				// plant-level
    String oid_fl;				// field-level
    String oid_pl_series;
    String oid_fl_series;
    String oid_sim_series;
    String oid_vis_series;
    String of_3D_scene;
    String oid_3D_scene;

	//reset is NEEDED to start the model properly
	if("true".equalsIgnoreCase(ModelArgs.reset) || ModelArgs.reset.isEmpty() || ModelArgs.reset == null) {
		reset();
	}
	// boolean useModelToModelComms = true; // TODO: check how this is determined
	RootBase rb1 = first((* p:RootBase, (p.plantNumber == 1)*)); 

	// used when the model is a plugin model as part of a larger simulation
	// Note: this only runs the model steps (no control loop)
	if (printFlag) { println(" Running as sub-model: " + MODEL_ID); }
	ModelInterface modelInterface = new ModelInterface(MODEL_ID);
	if (printFlag) { println(" ... FruitCrop submodel setup complete, entering wait loop"); }

	oid_pl_series = CacheManager.plant_level_series;      // used as an oid enumeration prefix 
	oid_fl_series = CacheManager.field_level_series;
	oid_vis_series = CacheManager.visualisation_series;             // currently only one output visualisation file type per simulation
	oid_sim_series = CacheManager.FruitCropXL_water_OID;  // we set the artifact series id as the simulation id

	boolean synchronous = false;   // set asynchronous (non-blocking) data uploads.

	int dhs_step;
	while (true) {
		if (printFlag) { println("main.rgg (run): waiting for step"); }
		RunStepArgs runStepArgs = modelInterface.waitForStep();
		dhs_step = runStepArgs.i; 
	
		inputSoilWaterPotential = false;
		useSoilWaterBalanceModel = true;

		// ======== Read in values of state variables from previous step
		CacheManager.readSoilWaterContent(dhs_step-1); 

		println(" soilWaterContentArray[0]: " + soilWaterContentArray[0] +
				"\n soilWaterContentArray[1]: " + soilWaterContentArray[1]);
		//for the first step, it could be zero
		validateSoilWaterContent(soilWaterContentArray);
		
		/**
		 * ======== Run one step
		 * the groimp model has step 0 to do the initiation
		 * update the soil water status
		 */
		[
			s:Soil ::> { 
				s.updateSoilWaterStatus();
				//println("waterPotential of layer" + s.layer + ": " + s.waterPotential);
				//println("waterContent of layer" + s.layer + ": " + s.waterContent);
			}
			
		] 
		
		run();		
	
		println("dhs step: " + (dhs_step) + " rb1.waterUptake_mm " + rb1.waterUptake_mm[0]);
		CacheManager.writeWaterUptake(dhs_step, rb1.waterUptake_mm);
		
		// ======== Check water uptake state variables were written
		CacheManager.readWaterUptake(dhs_step);	
		println(" waterUptake_1: " + CacheManager.waterUptake_1 +
				"\n waterUptake_3: " + CacheManager.waterUptake_3);
		
		oid_pl = oid_pl_series + "." +  Integer.toString(step);
		oid_fl = oid_fl_series + "." +  Integer.toString(step);

		minerva.m_store(pfx_plant_level + Integer.toString(step) + ".csv", "FruitCropXL-plant-level", oid_pl, oid_sim_series);
		minerva.m_store(pfx_field_level + Integer.toString(step) + ".csv", "FruitCropXL-field-level", oid_fl, oid_sim_series);

		
		if (hourOfDay == 12) {
			of_3D_scene = PATH_OUTPUT + scenario_name + "/" + Integer.toString(year) + "-" + Integer.toString(dayOfYear) + "-12." + output3DSceneFormat;
			oid_3D_scene = CacheManager.getVisualisationSeries(output3DSceneFormat) + "." + Integer.toString(step);

			// println("3D scene file: " + of_3D_scene);
			// println("3D scene oid: " +  oid_3D_scene);
			minerva.m_store(of_3D_scene, "FruitCropXL-"+output3DSceneFormat, oid_3D_scene, oid_sim_series);
		}

		println("");
		
		try {
		 	if (shouldOutputXEG(step, outputFreq3DScene) && daytime) {
				println("xeg output : " + year + "-" + dayOfYear);
			}

		} catch (Exception p) {
		     println( "exception displaying status:" +p.getMessage());
		}


		modelInterface.notifyStepComplete(true);

		// ======== Handle output tables
		for (int i = 0; i < TABLES.length; i++) {
			 try {
				if (outputTables.pbID > 0) {
					
					PlantBase pb = getPlantBase();  // e.g., graph().getNodeForId(pbID)	
					// Add any logic here that uses `pb`
					writeTablesToDataModels(TABLES[i], pb);
					CacheManager.write_pb_variables(step, pb);

				}
			} catch (Exception e) {
				//println("⚠️ Failed to retrieve or process PlantBase: " + e.getMessage());
			}
		}
		try {
			if (outputTables.rbID > 0) {
				RootBase rb = getRootBase();  // e.g., graph().getNodeForId(rbID)
				CacheManager.write_rb_variables(step, rb);
			}
		} catch (Exception e) {
		    println("⚠️ Failed to retrieve or process RootBase: " + e.getMessage());
		}
		try {
			if (outputTables.fbID > 0) {
				FieldBase fb = getFieldBase();  // e.g., graph().getNodeForId(fbID)
				CacheManager.write_fb_variables(step, fb);
			}
		} catch (Exception e) {
		    println("⚠️ Failed to retrieve or process FieldBase: " + e.getMessage());
		}
		try {
			CacheManager.write_misc_outputs(step);
		} catch (Exception e) {
		    println("⚠️ Failed to write miscellaneous outputs: " + e.getMessage());
		}
		//it seems it needs to wait the updateTable step finished and then to get the table value
		//Better to use the assign value part to get a new array
		//println(" test " + OUTPUT_TABLES[0].resolve().getCell(0,1).getX());
	}

	System.exit(0);
}

protected void runStandalone() {

	int runEndSteps = 1;
	
	// Assign model argument values

	if (ModelArgs.modelOptions != null) {
		FILE_NAME_MODEL_OPTIONS = ModelArgs.modelOptions;
		if("true".equalsIgnoreCase(ModelArgs.reset)) {
		  reset();
		}
	}
	
	Integer endSteps = parseIntOrNull(ModelArgs.runEndSteps);
	if (endSteps != null) {
		runEndSteps = endSteps.intValue();
		// optionally: System.out.println("runEndSteps=" + runEndSteps);
	} else {
		// keep default or set a fallback
		runEndSteps = 1;
	}


	// Determine run modes

	if (ModelArgs.testMode != null) {
		runBasicUnitTest();
	} else if (ModelArgs.validationMode != null) {
		runValidation();
	} else if (ModelArgs.fromDataset != null) {
		println("Running simulation from dataset.");
		if("true".equalsIgnoreCase(ModelArgs.reset)) {
		  reset();
		}
		new DatasetSimulationRunner().runSimulation();
	} else if (ModelArgs.serverMode != null) {
		println("Starting server.");
		if("true".equalsIgnoreCase(ModelArgs.reset)) {
		  reset();
		}
		launchServer();
	} else if (ModelArgs.runEndSteps != null) {
		// Running scenarios from a list and output tables for each scenario
		if(runEndSteps > 1 && runEndSteps < 10) {
			useShadingFactor = true;
		}
		if("true".equalsIgnoreCase(ModelArgs.reset)) {
		  reset();
		}
		runEnd(runEndSteps); 
	} else {
		// println("Starting simulation...");
		if("true".equalsIgnoreCase(ModelArgs.reset)) {
		  reset();
		}
		simRunService.simRun();
	}
}

/**
 * Control model phase for the DHS Platform.
 */
private void controlModelPhase() {
	// control loop for DHS zone execution, used when the Soil model is
	// running as the main simulation loop controller
	// Note: this only runs the control loop
	println(RequestHandler.request_oid);
	println(MODEL_ID + ": Running as zone controller");
	ZoneControl zone = new ZoneControl(RequestHandler.request_oid, MODEL_ID);
	println(" ... initialising zone: " + MODEL_ID);

	Thread.sleep(200); // TODO: Need to ask why this is necessary as this was present in the SWM
	zone.init();
	
	//reset is NEEDED to initialize the model options
	if("true".equalsIgnoreCase(ModelArgs.reset)) {
		  reset();
	}
	
	// Note: step 0 is for initial conditions
        println("halt day:" + halt);
	for (int step = 1; step <= 24 * halt ; step++) { // Hourly model: run exactly 24 zone steps per halt day.
//	for (int step = 1; step <= 48; step++) { // TODO: Currently run control loop for a max of 10 steps, use halt instead (similar to runEnd)
		// TODO: read updated data to simulate the next step. Do not initialise data structures here.
		println("Run step: " + step);
		// writeTimeCode();  write the timecode for current step to the output table.
		boolean success = zone.runStep(step, step, 1.0);

		if (!success) {
			println("DHS zone error running step " + step);
			break;
		}
	}
	zone.exit();
}


/**
 * Post model phase for the DHS Platform.
 */
private void postModelPhase() {
	println("Running post model phase");
}



/**
 * Safely solves all pending parallel tasks managed by the {@link PTaskManager}.
 * <p>
 * This method guarantees that {@link PTaskManager#solve()} always runs in a valid
 * {@link GraphState} context, which is required for any graph operations in GroIMP.
 * It distinguishes between two execution cases:
 *
 * <ul>
 *   <li><b>Active GraphState (main simulation thread)</b> –
 *       Executes {@link #taskManager}.solve() directly, allowing multi-threaded solving.</li>
 *   <li><b>No GraphState (background or worker thread)</b> –
 *       Wraps {@link #taskManager}.solve() in a
 *       {@link de.grogra.util.LockProtectedRunnable} and calls
 *       {@link de.grogra.graph.Graph#execute(de.grogra.util.LockProtectedRunnable, boolean)}
 *       to temporarily attach a GraphState and execute the task in a locked context.
 *       <b>Single-threaded solving</b> is enforced in this mode to prevent crashes
 *       from detached solver threads (e.g., {@code NonGraphLockedSolver}).</li>
 * </ul>
 *
 * <p>
 * This method is synchronized to avoid simultaneous execution by multiple threads,
 * which could cause concurrent modifications of the graph. The use of
 * {@code graph.execute()} with {@link LockProtectedRunnable} ensures that:
 *
 * <ol>
 *   <li>The graph is locked during execution to prevent concurrent modifications.</li>
 *   <li>A temporary {@link GraphState} is pushed for the current thread.</li>
 *   <li>Tasks execute safely without triggering
 *       {@code IllegalStateException: No active GraphState found}.</li>
 *   <li>Solver threads will not throw {@link NullPointerException} in headless/HPC runs,
 *       because single-thread fallback is used when necessary.</li>
 *   <li>The lock and temporary GraphState are automatically released afterward.</li>
 * </ol>
 *
 * <b>Usage:</b>
 * <pre>
 *     // Safely solve tasks from any thread, in headless or interactive mode
 *     MySimulationClass.solveTasksSafely();
 * </pre>
 *
 * This implementation is HPC- and headless-friendly, avoiding any dependency on
 * UI event loops or {@code runLater} scheduling.
 *
 * @see PTaskManager#solve()
 * @see GraphState#current(Graph)
 * @see de.grogra.graph.Graph#execute(de.grogra.util.LockProtectedRunnable, boolean)
 */
public synchronized static void solveTasksSafely() {
    Context ctx = de.grogra.rgg.Library.workbench();
    Workbench wb = ctx != null ? ctx.getWorkbench() : null;
    Graph graph = (wb != null && wb.getRegistry() != null)
            ? wb.getRegistry().getProjectGraph() : null;

    if (graph == null) {
        println("No project graph available.");
        return;
    }

    GraphState gs = GraphState.current(graph);

    try {
        if (gs == null) {
            // No active GraphState: execute safely in protected context
            graph.execute(new LockProtectedRunnable() {
                @Override
                public void run(boolean write, Lock lock) {
                    taskManager.setSolverCount(1);
                    taskManager.solve();

                    // Reset to prevent stale threads
                    //Tasks already queued are executed.
                    //Thread pool is cleaned for next iteration.
                    //You avoid NullPointerException or AbstractMethodError caused by early reassignment.

                    taskManager = new PTaskManager();
                }
            }, true);
        } else {
            taskManager.setSolverCount(ModelArgs.nCores);
            taskManager.solve();
        }
    } catch (Exception e) {
        println("Exception during task solving: " + e.getMessage());
        e.printStackTrace();
    }
}


/**
 * Runs the simulation until a predefined stopping condition is met.
 * <p>
 * The simulation continues to run hourly steps until either the number of steps reaches 24 times the value of 'halt'
 * or the simulation is manually halted by setting 'continueRunning' to false.
 * </p>
 */
// ------------------------ helpers ------------------------
/** Hard-exit the JVM with an exit code, after best-effort GSZ save. */
private void hardExitNow(int code, String reason, boolean trySave) {
    try {
        System.err.println("FATAL: " + reason + "  (exit=" + code + ")");
        if (trySave && saveGsz == true) {
            String fullFilePath = PATH_OUTPUT + outputTable_name + ".gsz";
            try {
                workbench().save(false);
                saveProjectAs(new java.io.File(fullFilePath));
                System.err.println("Saved GSZ to: " + fullFilePath);
            } catch (Throwable t) {
                System.err.println("Save failed during hard-exit: " + t);
            }
        }
    } catch (Throwable t2) {
        // swallow
    }
    System.exit(code);
}

/** Start a watchdog that hard-exits if no progress heartbeat occurs within stallMs. */
private Thread startWatchdog(final long stallMs, final int exitCode, final String tag,
                             final boolean[] doneFlag, final long[] lastBeatRef) {
    if (stallMs <= 0L) return null;
    Thread wd = new Thread(new Runnable() {
        public void run() {
            while (!doneFlag[0]) {
                try { Thread.sleep(5000L); } catch (InterruptedException ie) { /* ignore */ }
                long now = System.currentTimeMillis();
                long last = lastBeatRef[0];
                if (!doneFlag[0] && (now - last) > stallMs) {
                    hardExitNow(exitCode, "Watchdog("+tag+"): no progress for "+(now-last)+" ms", true);
                    return;
                }
            }
        }
    }, "runEnd-watchdog-"+tag);
    wd.setDaemon(true);
    wd.start();
    return wd;
}
// ---------------------- end helpers ----------------------
