/**
 * Resets the graphical representation of the simulation.
 * <p>
 * This method obtains the current workbench's graph context and clears out any existing edges associated 
 * with the root node that are of type {@code BRANCH_EDGE}. It then sets up a new graph structure 
 * with a fresh {@code RGGRoot} and connects an {@code Axiom} to it.
 * </p>
 * <p>
 * This operation is typically used to initialize or clear the simulation's graphical representation 
 * to ensure a fresh start.
 * </p>
 */
void resetGraph() {
	
	
	Context ctx = de.grogra.rgg.Library.workbench();  
	Workbench wb = ctx.getWorkbench();
    Registry r = wb.getRegistry();
    GraphManager graph = r.getProjectGraph(); 
	
	
    Transaction xa = graph.getActiveTransaction ();
    Node root = graph.getRoot ();
    for (Edge e = root.getFirstEdge (), f; e != null; e = f)
    {
        f = e.getNext (root);
        if (e.testEdgeBits (Graph.BRANCH_EDGE)
            && (e.getTarget () instanceof RGGRoot))
        {
            e.remove (xa);
        }
    }
    RGGRoot rr = new RGGRoot ();
    root.addEdgeBitsTo (rr, Graph.BRANCH_EDGE, xa);
    rr.addEdgeBitsTo (new Axiom (), Graph.SUCCESSOR_EDGE, xa);
    xa.commitAll();
    Internode.resetLeafAllometryRuntimeCache();
}


void reCompile() {
	((de.grogra.pf.ui.ProjectWorkbench)workbench()).compile();
	
}


