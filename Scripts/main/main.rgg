/**
 * Initializes the necessary configurations, parameters, and data for the model.
 * 
 * <p>
 * This method performs several initialization tasks:
 * <ul>
 *   <li>Clears the console and resets command line arguments.</li>
 *   <li>Clears all data stored in the Config module.</li>
 *   <li>Initializes paths, charts, and tables.</li>
 *   <li>Loads model input data, local parameters, and phenology parameters if needed.</li>
 *   <li>Checks the file configuration and reads CSV files.</li>
 *   <li>Initializes fruit data if virtual fruits are being used.</li>
 *   <li>Initializes light models based on the configuration setting.</li>
 * </ul>
 * </p>
 * 
 * @throws RuntimeException if any file configurations are incorrect.
 */
protected void init()
{
	resetGraph();
	derive();
	//mainInstance.reCompile();
	ModelArgs.init();	
	// Reset these values at the start of every simulation
	day = 0;
	tt = 0;
	step = 0;

	clearConsole();
	//command line load from the headless mode
	// Clear all data stored in Config Module
	CONFIG.reset();

	/** global settings, MODEL INPUT AND PARAMETER LOAD */
	SimulationLoader.initSimulationInstance();
	scenario_name = splitAndCombine(FILE_NAME_MODEL_OPTIONS);

	//update the output settings
	outputTable_name = scenario_name;

	PATH_OUTPUT = PATH_OUTPUT + splitAndCombine(FILE_NAME_MODEL_OPTIONS) + "/"; // Create a directory for scenario outputs
	println(" PATH_OUTPUT: " + PATH_OUTPUT + " outputTable_name: " + outputTable_name);
	createOrClearDirectory(PATH_OUTPUT);
	
	simUUID  = extractOrGenerateUUID(FILE_NAME_MODEL_OPTIONS);
	
    println("simUUID:  " + simUUID);
    
		/** initialise the alternative module choices */
	simRunService = SimRunServiceFactory.getService(special_scenario);
	updatesService = UpdatesServiceFactory.getService(special_scenario, species);
	initiationService = InitiationServiceFactory.getService(initiation_method);
	developService = DevelopServiceFactory.getService(special_scenario, species, useStructuralVariation);
	main.FRUIT_CREATOR = new FruitCreator(fruitModule);
	activeLeafShapeSpecies = species;
	if (leafShapeSpecies != null && leafShapeSpecies.length() > 0) {
		activeLeafShapeSpecies = leafShapeSpecies;
	}
	leafShape.LeafShapeFactory.getLeafShape(activeLeafShapeSpecies);
	
	//load csv input files
	readCsvFiles();
	
	if(main.FRUIT_CREATOR.usesVirtualFruitService()) {
		FruitService fruit = main.FRUIT_CREATOR.createFruit();
		fruit.initData();
	}
		ensureLightModelInitialized();
		//initiate after all the modules are being configured correctly
		initiationService.initiate();
		validateCurrentLightInterceptionGraphCapabilities();
	    saveRunInputsAndSnapshot(PATH_OUTPUT, PATH_SCENARIOS + FILE_NAME_MODEL_OPTIONS);

	if(useChart==true) {
		initCharts();
	}
	initCsvWriters(outputTable_name);
	DiagnosticTableCoordinator.initialize(
		PATH_OUTPUT,
		outputTable_name,
		outputWaterFluxSolverDebug,
		outputLeafGrowthDiagnostics,
		outputCarbonTransportDiagnostics,
		outputAppleDevelopmentDiagnostics);

	/*/////////////////////////////////////////////////////
		Remind and check of the files that the model load 
	*//////////////////////////////////////////////////////
	
	println("======== Module configuration ===================");
	println("");
	println("species                 : " + species);
	println("leafShapeSpecies        : " + activeLeafShapeSpecies);
	println("Model options           : " + FILE_NAME_MODEL_OPTIONS);
	println("special_scenario        : " + special_scenario);
	if ("fieldRandomCanopy".equals(initiation_method)) {
		println("fieldCanopy sourceMode  : " + fieldCanopy_sourceMode);
	}
	println("");
	
	println("initiationService       : " + initiationService.getClass().getSimpleName());
	println("updatesService          : " + updatesService.getClass().getSimpleName());	
	println("developService          : " + developService.getClass().getSimpleName());
	println("berryService            : " + FRUIT_CREATOR.getServiceClass().getSimpleName());
	println("fruitModule             : " + FRUIT_CREATOR.getFruitModule());
	println("simRunService           : " + simRunService.getClass().getSimpleName());
	println("useComplexRoot          : " + useComplexRoot);
	println("useComplexLeaf          : " + useComplexLeaf);    
	println("");
	
	println("======== Loaded functionality ===================");
	println("thermalUnit             : " + thermalUnit);	
	println("organGrowthMethod       : " + organGrowthMethod);
	println("calcLightInterception   : " + calcLightInterception);
	println("useShadingFactor        : " + useShadingFactor);
	println("calcPotential_PT        : " + calcPotential_PT);
	println("calcActual_PT           : " + calcActual_PT);
	println("calcCarbonAllocation    : " + calcCarbonAllocation);	
	println("useStructuralVariation  : " + useStructuralVariation);
	println("useStaticArc            : " + useStaticArc);
	println("usePhenology            : " + usePhenology);
	println("useCTRAM                : " + useCTRAM);
	println("");


	println("======== File configuration ===========================");
	println("parameter_file            : " + FILE_NAME_PLANT_PARAMETERS);
	println("initial_conditions_file   : " + FILE_NAME_INITIAL_CONDITIONS);
	println("soil_parameters_file      : " + FILE_NAME_SOIL_PARAMETERS);
	if(FRUIT_CREATOR.usesVirtualFruitService())
	println("VirtualFruitParm_file     : " + virtualFruitParameter_file);
	println();
	
	println("climate_file              : " + climate_file);
	println("organSize_file            : " + organSize_file);
	println("shootArchitecture_file    : " + shootArchitecture_file);
	println("shadingFactor_file        : " + shadingFactor_file);
	println("berryModelInput_file      : " + berryModelInput_file);
	println("");  

	println("======== Debugging and Output Settings ==============");
	println("Use Chart                : " + useChart);
	println("Use Output Table         : " + useOutputTable);
	println("Use JSON Output          : " + useOrganArrays);
	println("Output Individual Fruit  : " + outputIndividualFruit);
	println("Output Individual Leaf   : " + outputIndividualLeaf);
	println("Output Indi- Internode   : " + outputIndividualInternode);
	println("Debug Mode               : " + debug);
	println("Print Flag               : " + printFlag);
	println("");
	
	println("======== Model Arguments from command-line options ============");
	println("Test Mode               : " + ModelArgs.testMode);
	println("Validation Mode         : " + ModelArgs.validationMode);
	println("Server Mode             : " + ModelArgs.serverMode);
	println("From Dataset            : " + ModelArgs.fromDataset);
	println("Run End Steps           : " + ModelArgs.runEndSteps);
	println("Model Options File      : " + ModelArgs.modelOptions);
	println("Model Path              : " + ModelArgs.modelPath);
	println("Number of Cores         : " + ModelArgs.nCores);
	println("Headless Mode           : " + ModelArgs.headless);
	println("DHS Sim Phase           : " + ModelArgs.phase);
	println("DHS Sim Request File    : " + ModelArgs.request);
	println("");

	println("======== Simulation info ========================");
	println("Latitude                 : " + latitude);
	println("Longitude                : " + longitude);
	println("Time Zone                : " + getTimeZoneOffset(longitude));
	println("inputEnvironmentCondition: " + inputEnvironmentCondition);
	println("Start day of year        : " + dayOfYear);
	println("Hour of day              : " + hourOfDay);
	println("Number of simulation days: " + halt);
	println("Current day length       : " + dayLength);
	println("Sunrise time             : " + sunriseTime);
	println("Sunset time              : " + sunsetTime);
	println("Daytime                  : " + daytime);
	println("");
	
	println("======== Population info ========================");
	println("Population density       : " + 0.01 * Math.round(100 * dens) + " plants/m2");
	println("Row distance             : " + rowDistance);
	println("Plant distance           : " + plantDistance);
	println("Number of plants         : " + totalPlants);
	println("Total area               : " + 0.01 * Math.round(100 * totalArea) + " m2");
	println("Focal area               : " + 0.01 * Math.round(100 * focalArea) + " m2");

	println("==========================================================");

	//leafShape.testArea();
	
	derive();
	updateEnvironment();
	updateSolarPosition(year, month, dayOfMonth, hourOfDay,
						latitude, longitude, elevation, airPressure, Ta); 
	System.gc();
	
 /* 
 	//test dynamic growth 	
	organGrowthMethod.equals("TempLimited");
 	plastochron = 0.05;
	// trigger light interception or not
	calcLightInterception = false; 
	// potential photosynthesis and transpiration without water stress 
	calcPotential_PT = false;  		
	// actual photosynthesis and transpiration with water stress 
	calcActual_PT = false; 
	// carbon allocation and carbohydrate reserve dynamics. 
	calcCarbonAllocation = false;
		  */

}

/**
 * Executes a single step in the simulation cycle.
 * <p>
 * This method orchestrates the different stages of the simulation based on the current step.
 * In the initial step, the method loads necessary information and initializes the architecture.
 * For subsequent steps, it updates, develops, and refreshes associated charts and tables.
 * Snapshots are optionally taken based on the current day and hour of the simulation.
 * </p>
 * Note: The method also manages garbage collection and updates the simulation time after every step.
 */
 
public void run()
{
	/**
	 * Step 0: Initialization phase.
	 * Loads architecture and performs initial setup. 
	   It requires a derive to load the information, before you can use the information to load the architecture
	   It takes some time for large files during saving when put in init. 
	   under headless mode, derive in init produce errors after resetgraph.
	*/
try {
	// Ensure step progresses even if an exception occurs later
	
    // =====================================================
    // 0. Soft restart requested by TwinningPlanner (T1 LA check)
    // This is for resetting the bud number to match the leaf area 
    //    We do this BEFORE any other logic in run().
    // =====================================================
/*     if (resetBudNumber && step > 1) {
      println("[main] Restart requested by TwinningPlanner (resetBudNumber=true).");
      println("[main] Resetting graph and re-initialising before step 0…");

      // Hard reset, but in a safe place (run() entry)
      resetGraph();   // instance method of main
      init();         // your existing init() (without derive() inside!)

      // Start new simulation pass from init phase
      step = 0;
      if(debug == true) {
      	  println("Resetting bud bumber did not succeed. Require external optimization and more clear checks");
      	  System.exit(0);
      	  
      }
      // NOTE: DO NOT clear resetBudNumber here.
      // We want step==1 to see it and actually call BudPlanner with budTargetMode=2
      return;
    } */
		
	if(step == 0) 
	 {
		//try to find the issues earlier before large initialization of the tree
		InitArch.checkSoilParams();
		initiationService.initArchitecture();
				
		derive();
		runDeferredPostReadNegativeZFixesStage1();
		derive();
		InitArch.finalizeIDReference();
		syncRootBiomassAfterArchitectureRead("step0_after_finalizeIDReference");
		[ 
			rb0:RootBase ::> {
				rb0.updateLayeredRootBiomassAndCarbon(BIOMASS_ROOT);
			}	
		]

	
			//InitArch.checkRootParams();
		// Check leaf area and crop load after soil and root validations have passed
		//InitArch.checkLeafAreaAndCropLoad();
	   
		assignOutputRef();
		InitArch.setStructuralRootParentID();
		
		
		step = 1;	
		
		long RosetteLeaf = count((* l:Leaf, (l.organType.contains("Rosette"))*));
		long otherLeaf = count((* l:Leaf, (!l.organType.contains("Rosette"))*));
		double leafArea = sum((* l:Leaf *).area);
		println( " \n RosetteLeaf : " + RosetteLeaf + "other: " + otherLeaf +
				" total leaf area: " + String.format("%.4f",leafArea));
				println("[DBG_LEAF_CREATE] LeafSTEM=" + dbgLeafStemCreated
      + " LeafBODY=" + dbgLeafBodyCreated
      + " LeafEND_seen=" + dbgLeafEndNodesSeen);
				
		return;
	 }	
	
	
	 /**
	 * Step 1 and beyond: Main simulation loop.
	 * Includes task scheduling, organ updates, development progression, 3D rendering, output writing, and logging.
	 */
	 /**
	 * Step 1 only: Count total buds and report initial leaf characteristics.
	 * Helps determine flowering potential and initialize phenological context.
	 */
	if(step == 1) { 
		
			{
		
	
		[
			rb:RootBase ::> {
				println("[RootFrame] rb plant=" + rb.plantNumber
					+ " loc=" + location(rb).x + "," + location(rb).y + "," + location(rb).z);
			}
		]
	
		[
			s:Soil, (s.layer == 0 && s.gridX == 0 && s.gridY == 0) ::> {
				println("[SoilActual] id=" + s.id
					+ " grid=" + s.gridX + "," + s.gridY
					+ " layer=" + s.layer
					+ " loc=" + location(s).x + "," + location(s).y + "," + location(s).z
					+ " dims=" + s.widthX + "," + s.widthY + "," + s.length);
			}
		]
	}
		
		runDeferredPostReadNegativeZFixesStage2IfNeeded();
		syncRootBiomassAfterArchitectureRead("step1_after_stage2_fixes");
		[ rb1:RootBase ::> {
			rb1.verifyLayeredRootBiomassAndCarbon(BIOMASS_ROOT, 1e-3);
			} 
		]
		//tidy up the internode biomass in the leaf allometry mode for static architecture
		if(!annualInternodeBiomassMode.equalsIgnoreCase("density")) 
		{
			[	
				i:Internode, (!((i instanceof Cordon) || (i instanceof Trunk))) ::> {
				i.syncAnnualInternodeBiomassFromLocalOrNearbyLeaf();
					//	println("internode biomass: " + i.biomass);
				}		
			]	
		} 
		InitArch.checkStatus(); 
		//set the leaf area if the
		if(useTwinningPlanner && debug) {
		  double nLeaves = count((* l:Leaf, (l.plantNumber == 1)*));
			
		  if (nLeaves > 10) {
			// For this to actually prune, make sure:
			//   - modelOptions.leafPruningDOY == dayOfYear at step 1
			LeafPlanner.runFromProjectParams_Prune(true);  // dryRun=false → real edits
		  }
		
		  // ----------------------------------------------------
		  // 2B. If NO leaves → fall back to BudPlanner T0
		  //     (classic pre-season bud planning)
		  // && useTwinningPlanner
		  // ----------------------------------------------------
		 if(dayOfYear == twinningDOY_T0 && useTwinningPlanner) {
			println("[main] step=1: no leaves found → using BudPlanner T0.");
			BudPlanner.runFromProjectParams(true); //dry run: true
		  }
		  
		  double totalFruit = count((* b:FruitService *));
		  if(totalFruit >= 1) {
			  FruitPlanner.runFromProjectParams_Prune(true);  // dryRun=false → real edits	  	  
		  }
		}
		  
		 if(resetBudNumber == true && debug == false && useTwinningPlanner) {
			  println("resetting budnumber");
			  budTargetMode = 2;
			  BudPlanner.runFromProjectParams(false); //dry run: true
			  resetBudNumber = false;
			  //debug = true;
			  
		  }
		  
	}
		
   		
/**
 * Configure task manager for parallel computation (if multiple cores are used).
 */
	taskManager.setSolverCount(ModelArgs.nCores);
	
/**
 * Update organ states (mass, carbon, water, etc.) using defined physiological rules.
 */
   	updatesService.updates();
	syncRootBiomassAfterArchitectureRead("step1_after_updates");
        
/**
 * Trigger development (organogenesis, elongation, etc.) unless using static architecture.
 */
	if(!useStaticArc && !(step <= 2 && addBuds == true)) {
		developService.develop();
 	}
	
/**
 * Periodic recomputation of derived traits (e.g., canopy geometry, biomass).
 * This helps ensure simulation consistency, especially for dynamic structures.
 */
	if(step % 10 == 0 ) 
	{	
		derive();
		System.gc();
	}
/**
 * Chart output: Optional visualization during simulation for debugging or analysis.
 */
	if(useChart == true) {
		updateCharts();
	}
/**
 * Output table update (e.g., for writing simulation variables to memory structure).
 */
 
	if(useOutputTable == true) {
		updateTables();
		//outputTables(outputTable_name);
	}
	
/**
 * Export organ-level data to CSV files (formerly Excel-based).
 */
	if(useOrganArrays == true) { // FIXME: rename field from Excel as we are now using CSV for output
			writeOutputToCsv(); 
		}
		
		
/**
 * Call the twinning method daily based on the input twinning DOY
 */
 // 1) Twinning – only if useTwinningPlanner=true
  if(useTwinningPlanner && hourOfDay == 2) TwinningPlanner.runFromProjectParams(false);
  
  if(step<= 3) println("fruit number: " + count((* b:FruitService *)));
  // 2) Independent leaf pruning (uses leafPruningDOY internally)
  if(dayOfYear == leafPruningDOY && hourOfDay == 3) { 
  	  LeafPlanner.runFromProjectParams_Prune(false);
  }
  if(step<= 3) println("fruit number: " + count((* b:FruitService *)));
  // 3) Independent fruit pruning (uses fruitPruningDOY internally)
  if(dayOfYear == fruitPruningDOY && hourOfDay == 4) {
  	  FruitPlanner.runFromProjectParams_Prune(false);
  }
	
/**
 * Optional 3D visualization update (only when not in headless mode and during daytime).
 */
	if (Boolean.parseBoolean(ModelArgs.headless) == false && daytime) {
		try {
			repaintView3D();
		} catch (NullPointerException e) {
			println("No 3D view window open");// Ignore the NullPointerException and proceed.
		}
	}
	
/**
 * Save 3D snapshot image (PNG) of the current model view for documentation.
 * not work in headless mode
 */
	if (snapShot == true && hourOfDay == 12) {
		makeSnapshot(PATH_OUTPUT + "Y" + year + "D" + dayOfYear + "H"+ hourOfDay + ".png");
	}
	 
/**
 * Export XEG scene file periodically (GroIMP 3D scene format).
 */
	
 	if (shouldOutputXEG(step, outputFreq3DScene) && daytime) {   
		export3DScene(PATH_OUTPUT + year + "-" + dayOfYear + "-"+ hourOfDay + "." + output3DSceneFormat, output3DSceneFormat);
	}
	
/**
 * Simulation logging: Output all major states and environment metrics if enabled.
 * Includes environmental data, water fluxes, sugar concentration, carbon allocation, and fruit status.
 * The boolean variable of calcLight, potential PT, actual PT, and carbon allocation should be enables one layer by one layer, 
 * else will not have proper results.  
 */

// --------------------------------------------------------------------
// PRINT SNAPSHOT (guarded, null-safe, warn-once)
// --------------------------------------------------------------------
if (printFlag && step >= 1) {
    PlantBase pb = null;
    RootBase  rb = null;
    Trunk     rt = null;
    FieldBase fb = null;

    // ---- Header ----
    println(fmtStepHeader(step));
    println(fmtLine("Time", String.format("Year %d | DOY %d | Hour %d", Integer.valueOf(year), Integer.valueOf(dayOfYear), Integer.valueOf(hourOfDay))));
    println(fmtLine(
        "Env",
        String.format(
            "Ta=%.1f C | RH=%.1f%% | CO2=%.0f ppm | Mean SWP=%.4f MPa",
            Double.valueOf(Ta), Double.valueOf(rh * 100.0), Double.valueOf(cca), Double.valueOf(inputWaterPotential)
        )
    ));
    println(fmtLine(
        "Radiation",
        String.format(
            "Global=%.1f | Diffuse=%.1f | Direct=%.1f | fdiff=%.3f | fPAR=%.3f",
            Double.valueOf(globalRadiation), Double.valueOf(diffuseRadiation), Double.valueOf(directRadiation), Double.valueOf(fdiff), Double.valueOf(fPAR)
        )
    ));

    // ---- Safe retrievals (no exception spam) ----
    if (outputTables.pbID > 0) pb = safeGetPlantBase(outputTables.pbID);
    if (outputTables.rbID > 0) rb = safeGetRootBase(outputTables.rbID);
    if (outputTables.fbID > 0) fb = safeGetFieldBase(outputTables.fbID);

    // ---- Plant info ----
    println(fmtSection("Plant information"));
    if (pb != null) {
     	   println(fmtLine("Height", pb.plantHeight, "m", 4));
     	   println(fmtLine("Leaf Area", pb.leafArea, "m2", 4));

        if (calcLightInterception) {
            println(fmtLine("Absorbed PAR", pb.hourlyAbsorbedRadiation * fPAR, "MJ", 4));
            println(fmtLine("fabs_plant", pb.fabs, "-", 4));
            println(fmtLine("fpar_plant", pb.fpar, "-", 4));
            println(fmtLine("fabs_soil", outputTables.fabsSoil, "-", 4));
            println(fmtLine("fpar_soil", outputTables.fparSoil, "-", 4));

            if (calcPotential_PT) {
                println(fmtLine("meanAnet", pb.meanAnet, "µmol/m2/s", 4));

                println(fmtSection("Water Transport"));
                println(fmtLine("Water Flux Potential", pb.waterFluxPotential, "mg/plant/s", 4));

                if (calcActual_PT) {
                    println(fmtLine("Water Flux Optimized", pb.waterFlux_optimized, "mg/plant/s", 4));
                    println(fmtLine("Xylem Water Potential", pb.xylemWaterPotential, "MPa", 4));
                }
            }
        }

        if (calcCarbonAllocation) {
            println(fmtSection("Phloem sugar concentration"));
            println(fmtLine("Phloem [sugar]", pb.sugarConcentration_phloem, "g_sugar/g_solution", 6));

            println(fmtSection("Fraction of carbon loadings (major)"));
            println(fmtLine("Leaf Loading", pb.fraction_leafLoading, "-", 4));
            println(fmtLine("Internode Loading", pb.fraction_internodeLoading, "-", 4));
            println(fmtLine("SRoot Loading", pb.fraction_structuralRootLoading, "-", 4));

            println(fmtSection("Fraction of carbon unloadings (major)"));
            println(fmtLine("Fruit Unloading", pb.fraction_fruitUnloading, "-", 4));
            println(fmtLine("Fine Root Unloading", pb.fraction_fineRootUnloading, "-", 4));
            println(fmtLine("SRoot Unloading", pb.fraction_structuralRootUnloading, "-", 4));
            println(fmtLine("Internode Unloading", pb.fraction_internodeUnloading, "-", 4));
        }
    } // (no else message; warnOnce already handled missing pb)

    // ---- Root info (quiet defaults; warn once for missing arrays) ----
    if (rb != null) {
        double[] fflux = rb.f_flux; // may be null
	        if (fflux != null) {
	            clearWarn("rb_flux_missing");
	            for (int i = 0; i < fflux.length; i++) {
	                int gid = (rb.gridIndex != null && i < rb.gridIndex.length) ? rb.gridIndex[i] : i;
	                println(fmtLine(String.format("f_flux grid%d", Integer.valueOf(gid)), fflux[i], "-", 4));
	            }
	        } else {
            warnOnce("rb_flux_missing", "⚠️ RootBase.f_flux not available yet (suppressing repeats).");
        }

    }
    // (if rb is null, warnOnce already emitted; no further prints)

    // ---- FieldBase / dataset hook ----
    if (fb == null) {
        warnOnce("fb_missing_still", "No FieldBase found; skipping dataset rows (suppressing repeats).");
    } else {
        clearWarn("fb_missing_still");
        // ... add rows to dataset here
    }

    // ---- Fruit metrics ----
    if (outputTables.fw_mean > 0) {
        println(fmtSection("Fruit Metrics"));
        println(fmtLine("FW Mean", outputTables.fw_mean, "mg", 1));
        println(fmtLine("DW Mean", outputTables.dw_mean, "mg", 2));
        println(fmtLine("Sugar Conc", outputTables.sc_mean, "g/g_pulp", 4));
    }
}

  calcSimTime();
  step++;
	
} catch (Exception e) {
        System.out.println("⚠️ Exception in run(): " + e.getMessage());
        e.printStackTrace();
        // Step will still increment to avoid infinite loops
        step++;
    }
}



public void runEnd() {
    // Hourly model: halt is expressed in days, so run exactly 24 steps per halt day.
    int targetStep;
    if (halt > 0) {
        long tmp = 24L * (long) halt - 3;
        if (tmp < 0L) tmp = 0L;
        if (tmp > Integer.MAX_VALUE) tmp = Integer.MAX_VALUE;
        targetStep = (int) tmp;
    } else {
        targetStep = Integer.MAX_VALUE; // run until continueRunning flips false
    }

    // ---- safety controls
    int calls = 0;
    int lastStep = step;
    int stallCount = 0;

    int expected = (targetStep == Integer.MAX_VALUE) ? 100000 : (targetStep - step + 1);
    if (expected <= 0) expected = 1;
    final int ABS_CAP   = (expected < (Integer.MAX_VALUE / 10)) ? (expected * 10) : 100000;
    final int STALL_CAP = 20000;                  // no-step-advance for this many run() calls → hard exit
    final long STALL_MS = 10L * 60L * 1000L;     // 10 min since last heartbeat → hard exit (watchdog)
    final long[] lastBeat = new long[] { System.currentTimeMillis() };
    final boolean[] done  = new boolean[] { false };

    // Start watchdog (kills JVM if run() blocks and we stop heartbeating)
    startWatchdog(STALL_MS, 98, "runEnd", done, lastBeat);

    while (continueRunning && (step < targetStep) && (calls < ABS_CAP)) {
        // heartbeat before entering run() so watchdog can see activity even if run() blocks intermittently
        lastBeat[0] = System.currentTimeMillis();

        run();
        calls++;

        // heartbeat after returning from run()
        lastBeat[0] = System.currentTimeMillis();

        // no-progress detector (run() returned but step didn't change)
        if (step == lastStep) {
            stallCount++;
            if (stallCount >= STALL_CAP) {
                done[0] = true; // stop watchdog thread
                hardExitNow(97, "No progress for "+STALL_CAP+" consecutive run() calls (step="+step+")", true);
                return; // unreachable
            }
        } else {
            stallCount = 0;
            lastStep = step;
        }
    }

    done[0] = true; // stop watchdog

    if (calls >= ABS_CAP) {
        hardExitNow(96, "Absolute iteration cap hit: "+ABS_CAP+" calls (step="+step+", target="+targetStep+")", true);
        return; // unreachable
    }

    saveGsz();
}



public void runEnd(int maxSteps) {
    // guard inputs
    if (maxSteps <= 0) {
        hardExitNow(94, "Invalid maxSteps="+maxSteps, false);
        return; // unreachable
    }

    // ---- safety controls
    int calls = 0;
    int lastStep = step;
    int stallCount = 0;

    final int ABS_CAP   = (maxSteps < (Integer.MAX_VALUE / 10)) ? (maxSteps * 10) : 100000;
    final int STALL_CAP = 200000;                  // no-step-advance for this many run() calls → hard exit
    final long STALL_MS = 10L * 60L * 10000L;     // 10 min watchdog
    final long[] lastBeat = new long[] { System.currentTimeMillis() };
    final boolean[] done  = new boolean[] { false };

    startWatchdog(STALL_MS, 88, "runEnd(max)", done, lastBeat);

    while ((step < maxSteps) && continueRunning && (calls < ABS_CAP)) {
        lastBeat[0] = System.currentTimeMillis();
        run();
        calls++;
        lastBeat[0] = System.currentTimeMillis();

        if (step == lastStep) {
            stallCount++;
            if (stallCount >= STALL_CAP) {
                done[0] = true;
                hardExitNow(87, "No progress for "+STALL_CAP+" consecutive run() calls (step="+step+")", true);
                return;
            }
        } else {
            stallCount = 0;
            lastStep = step;
        }
    }

    done[0] = true;

    if (calls >= ABS_CAP) {
        hardExitNow(86, "Absolute iteration cap hit: "+ABS_CAP+" calls (final step="+step+")", true);
        return;
    }

   saveGsz();
}

void saveGsz() {
 // ---- normal completion (no hard exit)
    if (saveGsz == true) {
        String fullFilePath = PATH_OUTPUT + outputTable_name + ".gsz";
        try {
            workbench().save(false);
            saveProjectAs(new java.io.File(fullFilePath));
            println("Simulation finished. Final step=" + step + ", saving to " + fullFilePath);
        } catch (Throwable t) {
            System.err.println("Save failed: " + fullFilePath);
            t.printStackTrace();
            // Optionally fail job:
            // hardExitNow(85, "Save failed: " + fullFilePath, false);
        }
    }
}

