// updates the charts
protected static void updateCharts() {
	 if(outputTables.pbID <= 0 || step <= 1) { 
	 	 PlantBase pb1 = first( (* p:PlantBase, (p.plantNumber == INDI_ID_A && p.isReportable) *));
	 	 if(pb1 != null) {
	 	 	 outputTables.addPlantBase(pb1);
	 		 if (printFlag) { println(" Plantbase instance is added to chart"); }
	 	 }
	 } 
	// update charts to monitor a single individual
	for (int i=0; i<CHARTS.length; i++)                           
		updateChart(CHARTS[i], DATASETS[i]);
	// update charts to compare individuals
	 for (int i=0; i<CHARTS_VS.length; i++)                           
		updateChartVS(CHARTS_VS[i], DATASETS[i]); 
}

/**
 * this functions updates the single charts
 */ 
private static void updateChart(int chart, DatasetRef dataset) {
	PlantBase pb = null;
		if(outputTables.pbID <= 0 || step <= 1) { 
	 	 PlantBase pb1 = first( (* p:PlantBase, (p.plantNumber == INDI_ID_A && p.isReportable) *));
	 	 if(pb1 != null) {
	 	 	 outputTables.addPlantBase(pb1);
	 	 	 
	 		 if (printFlag) { println(" Plantbase instance is added to chart"); }
	 	 }
	 } 
		  
		 try {
			if (outputTables.pbID > 0) {
				pb = outputTables.getPlantBase();  // e.g., graph().getNodeForId(pbID)	
				// Add any logic here that uses `pb`
			}
		} catch (Exception e) {
			println("⚠️ Failed to retrieve or process PlantBase: " + e.getMessage());
		}
		
	
	if (chart==0) {
		dataset.addRow().set(0,simRate > 1e8 ? 0 :simRate);
	}
	if (chart==1) {
		FieldBase fb = first( (* f:FieldBase, (f.isReportable) *) );
		dataset.addRow().set(0,fb.lai);
	}
	if (chart==2) {
		dataset.addRow().
		set(0,pb.biomass * mgTogram).
		set(1,pb.carbon_total * mgTogram);  //internal unit is mg
	}
	if (chart==3) {
		dataset.addRow().set(0, pb.nitrogenCommonPool);
	}

	if( chart== 4 )  {
		dataset.addRow().set(0, pb.mobileNContent);
	}

	if(chart==5) {
		dataset.addRow().set(0, pb.leafArea);
	}

	if(chart==6) {
        dataset.addRow().set(0, pb.plantHeight);
	}

	if(chart==7) {
		if(globalRadiation > LIGHT_THRESHOLD) 
		{dataset.addRow().set(0, pb.fabs).set(1, pb.leafRad/pb.leafArea).
							set(2, globalRadiation).set(3, pb.leafRad);}
	}
	if(chart==8) {
		FruitService br = first((* b:FruitService,(b.plantNumber == INDI_ID_A && b.isReportable)*));
		FineRoot fr = first((* f:FineRoot,(f.plantNumber == INDI_ID_A && f.isReportable)*));
		if (printFlag) { println("br.plantNumber " + br.plantNumber + br.km_pri); }
		
		dataset.addRow().
		set(0,pb.biomassLeaf).set(1,pb.biomassInternode).set(2, pb.biomassTrunk).
		set(3,pb.biomassFineRoot).set(4,pb.biomassFruit).
		set(5,pb.leafNSC).set(6,pb.internodeNSC).set(7,pb.trunkNSC).
		set(8,pb.fineRootNSC).set(9,pb.berrySugar).
		set(10,br.km_pri).
		set(11, fr!= null? fr.km_pri : 0).
		set(12,0).	
		set(13,0).
		set(14, day).
		set(15, hourOfDay).
		set(16, scenario).
		set(17, pb.biomassStructuralRoot).
		set(18, pb.structuralRootNSC).
		set(19, pb.biomassCordon).
		set(20, pb.cordonNSC)
		;
		
		
	}
	if(chart==9) {
		dataset.addRow().set(0, (pb.maintenanceDM*mgTogram)).
		set(1, (pb.growthCost*mgTogram)).set(2, (pb.maintenanceDM +  pb.growthCost)*mgTogram);
	}
	if(chart==10) {
		/* FieldBase fb = first((* f:FieldBase *) );
		
		
