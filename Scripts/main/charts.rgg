private final static int MAX_DAILY_UNLOADING_SCENARIOS = 64;
private static int[] dailyMeanUnloadingDay = new int[MAX_DAILY_UNLOADING_SCENARIOS];
private static int[] dailyMeanUnloadingCount = new int[MAX_DAILY_UNLOADING_SCENARIOS];
private static double[] dailyMeanFineRootUnloadingSum = new double[MAX_DAILY_UNLOADING_SCENARIOS];
private static double[] dailyMeanLeafUnloadingSum = new double[MAX_DAILY_UNLOADING_SCENARIOS];
private static double[] dailyMeanPerennielWoodUnloadingSum = new double[MAX_DAILY_UNLOADING_SCENARIOS];
private static double[] dailyMeanFruitUnloadingSum = new double[MAX_DAILY_UNLOADING_SCENARIOS];
private static double[] dailyMeanInternodeUnloadingSum = new double[MAX_DAILY_UNLOADING_SCENARIOS];
private static double[] dailyMeanStructuralRootUnloadingSum = new double[MAX_DAILY_UNLOADING_SCENARIOS];

private static void resetDailyMeanUnloading(int scenarioIndex, int currentDay) {
	dailyMeanUnloadingDay[scenarioIndex] = currentDay;
	dailyMeanUnloadingCount[scenarioIndex] = 0;
	dailyMeanFineRootUnloadingSum[scenarioIndex] = 0;
	dailyMeanLeafUnloadingSum[scenarioIndex] = 0;
	dailyMeanPerennielWoodUnloadingSum[scenarioIndex] = 0;
	dailyMeanFruitUnloadingSum[scenarioIndex] = 0;
	dailyMeanInternodeUnloadingSum[scenarioIndex] = 0;
	dailyMeanStructuralRootUnloadingSum[scenarioIndex] = 0;
}

private static int getDailyMeanUnloadingScenarioIndex(int scenarioNumber) {
	if (scenarioNumber < 0) {
		return 0;
	}
	if (scenarioNumber >= MAX_DAILY_UNLOADING_SCENARIOS) {
		return MAX_DAILY_UNLOADING_SCENARIOS - 1;
	}
	return scenarioNumber;
}

// initialize the charts
protected static void initCharts() {
	// init charts to monitor a single individual
	for (int i=0; i<CHARTS.length; i++) {
		initChart(CHARTS[i], DATASETS[i]);
		chart(DATASETS[i], XY_PLOT); //LINE_PLOT
	}
	// init charts to compare individuals
	/* for (int i=0; i<CHARTS_VS.length; i++) {
		initChartVS(CHARTS_VS[i], DATASETS[i]);
		chart(DATASETS[i], XY_PLOT); //LINE_PLOT
	} */
}

