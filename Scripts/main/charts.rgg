			set(8,a9).set(9,a10).set(10,a11).set(11,a12).set(12,a13).set(13,a14).set(14,a15).set(15,a16);}
		
		//if(chart == 32) {dataset.addRow().set(0,a1).set(1,a2).set(2,a3).set(3,a4).set(4,a5).set(5,a6).set(6,a7).set(7,a8).
		//set(8,a9).set(9,a10).set(10,a11).set(11,a12).set(12,a13).set(13,a14).set(14,a15).set(15,a16).set(16, climate[step+1][12]);}
			
	    if(chart == 13 || chart == 14) 
		{
			dataset.addRow().set(0,a1).set(1,a2).set(2,a3).set(3,a4).set(4,a5).set(5,a6).set(6,a7).set(7,a8).
			 set(8,a9).set(9,a10).set(10,a11).set(11,a12).set(12,a13).set(13,a14).set(14,a15).set(15,a16).
			 set(16,a17).set(17,a18).set(18,a19).set(19,a20).set(20,a21).set(21,a22).set(22,a23).set(23,a24).
			 set(24,a25).set(25,a26).set(26,a27).set(27,a28).set(28,a29).set(29,a30).set(30,a31).set(31,a32);}
		}
	
	if(chart == 15) {
	Soil sl = first((* s:Soil, (s[plantNumber] == INDI_ID_A && s.isReportable) *));
	dataset.addRow().set(0, sl.waterContent);
	}
	
	if(chart == 16) {
		Soil sl = first((* s:Soil, (s[plantNumber] == INDI_ID_A && s.isReportable) *));
		//dataset.addRow().set(0, sl.waterPotential);
		dataset.getRow(step).set(scenario, sl.waterPotential);
	}
	if(chart == 17 ) {
		FineRoot root = first((* r:FineRoot, (r[plantNumber] == INDI_ID_A && r.isReportable) *));
		//dataset.addRow().set(0, root.Gr);
		dataset.getRow(step).set(scenario, root.Gr);
	}
	if(chart==18 ) {
		FineRoot root = first((* r:FineRoot, (r[plantNumber] == INDI_ID_A && r.isReportable) *));
		dataset.getRow(step).
		set(scenario, root!= null? root.waterPotential :0).
		set(2, root.waterPotentialRootSurface); 
	}
    if(chart==19) {
    	FruitService b = null;
		try { 
			FruitService b1 = first((* br:FruitService, (br.plantNumber == INDI_ID_A && br.isReportable) *));
			
			if (b1 != null) {
				b = b1;
			}
		} catch (Exception e) {
			println("⚠️ Failed to retrieve FruitService: " + e.getMessage());
		}

		float meanBerryFW = mean((* br:FruitService, (br.isReportable) *)[freshWeight]);
		float meanBerryDW = mean((* br:FruitService, (br.isReportable) *)[biomass]);
		if (printFlag) { println("test " + (b!= null)); }
		if (printFlag) { println("b.ageD " + b.ageD); }
		dataset.addRow(step).set(0, meanBerryFW).set(1, meanBerryDW).
		set(2, b.ageD).
		set(3, b.ageHour).
		set(4, totalFruitNum).
		set(5, b.sugarConcentration_fruit).
		set(6, b.solubleSugar).set(7, b.sugarUptake_active).
		set(8, b.sugarUptake_passive).set(9, b.sugarUptake_massflow).
		set(10, b.sugarConcentration_phloem).set(11, b.waterUptake_phloem).
		set(12, b.turgorPressure_fruit).
		set(13, scenario).
		set(14, inputVesselConditions ? berryModelInput[step][1] : hourOfDay).
		set(15, inputVesselConditions ? berryModelInput[step][2] : Ta).
		set(16, inputVesselConditions ? berryModelInput[step][3] : rh).
		set(17, inputVesselConditions ? berryModelInput[step][4] : b.sugarConcentration_phloem).
		set(18, inputVesselConditions ? berryModelInput[step][5] : b.waterPotential_xylem).
		set(19, b.structuralBiomass).
		set(20, b.malicAcid).
		set(21, b.tartaricAcid).
		set(22, b.malicConcentration_fruit).
		set(23, b.tartaricConcentration_fruit).
		set(24, b.Lxylem).
		set(25, b.Lphloem).
		set(26, b.osmoticWaterPotential_fruit).
		set(27, b.waterUptake_xylem)
		;
	}
	if(chart== 20) {
		FruitService fruit = first((* b:FruitService, (b[plantNumber] == INDI_ID_A && b.isReportable) *));
		dataset.addRow(step).set(0, fruit.unloading * mgTogram).set(1, fruit.waterUptake_xylem).set(2, fruit.waterUptake_phloem);
	}
	if(chart== 21) {
		FruitService fruit = first((* b:FruitService, (b[plantNumber] == INDI_ID_A && b.isReportable) *));
		dataset.addRow().set(0, fruit.waterUptake_xylem + fruit.waterUptake_phloem).
		set(1, fruit.respirationWater).set(2, fruit.transpirationMass).
		set(3, fruit.deltaWater);
	}
	if(chart== 22) {
	FruitService fruit = first((* b:FruitService, (b[plantNumber] == INDI_ID_A && b.isReportable) *));
	dataset.addRow().set(0, fruit. osmoticWaterPotential_fruit/10).  // convert from bar to MPa
	set(1, fruit.turgorPressure_fruit/10).set(2, fruit.waterPotential_fruit/10);
	}
	if(chart== 23) {
	FruitService fruit = first((* b:FruitService, (b[plantNumber] == INDI_ID_A && b.isReportable) *));
	dataset.addRow().set(0, fruit. osmoticWaterPotential_phloem/10).
	set(1, fruit.turgorPressure_phloem/10).set(2, fruit.waterPotential_phloem/10);
	}
	
	if(chart== 24) {
	dataset.getRow(step).set(0 + 7*scenario, pb.leafLoading).
	set(1+ 7*scenario, pb.internodeLoading).set(2+ 7*scenario, pb.perennielWoodLoading).
	set(3+7*scenario, pb.internodeLeakage).set(4+7*scenario, pb.perennielWoodLeakage).
	set(5+7*scenario, pb.fineRootUnloading).set(6+7*scenario, pb.fruitUnloading);
	}
	if(chart== 25) {
		
		if(useCTRAM == true) {
			 
			double c = Math.sqrt(2.0 * (pb.cpb + pb.cpt)/2.0);
			dataset.addRow().set(0, c);
		}
		if(useCTRAM == false) {dataset.addRow().set(0, pb.sugarConcentration_phloem);}
	}
	if(chart == 26) {
	FineRoot rt = first((* r:FineRoot, (r[plantNumber] == INDI_ID_A && r.isReportable) *));
	dataset.addRow().set(0, rt.Nuptake).set(1, rt.NuptakeCost);
	}
	
	if(chart == 29) {
		dataset.getRow(step).
		set(0+5*scenario, pb.fraction_fruitUnloading).
		set(1+5*scenario, pb.fraction_fineRootUnloading).
		set(2+5*scenario, pb.fraction_internodeUnloading).
		set(3+5*scenario, pb.fraction_leafLoading);
	}
	if(chart == 30) {
		FruitService fruit = first((* b:FruitService, (b[plantNumber] == INDI_ID_A && b.isReportable) *));
		dataset.addRow(step).set(0, fruit.sugarConcentration_fruit); //g sucrose/g water
	}
	if(chart == 33) {
		FineRoot rt = first((* r:FineRoot, (r[plantNumber] == INDI_ID_A && r.isReportable) *));
		dataset.addRow(step).set(0, rt.ABA); //.set(1, climate[step+1][13]);
	}
	
	if (chart==34) {
	//	PlantBase pb = first( (* p:PlantBase, (p.plantNumber == INDI_ID_A) *));
	
		
	}
	
	if(chart == 35) {
		FruitService b1 = first((* s:FruitService, ( s[cordonNumber]==1 && s[nodeNumber]==4 && s.isReportable) *)); //cordon 4
	    FruitService b2 = first((* s:FruitService, ( s[cordonNumber]==1 && s[nodeNumber]==3 && s.isReportable) *)); //cordon 3
	    FruitService b3 = first((* s:FruitService, ( s[cordonNumber]==1 && s[nodeNumber]==2 && s.isReportable) *)); //cordon 2
	    FruitService b4 = first((* s:FruitService, ( s[cordonNumber]==1 && s[nodeNumber]==1 && s.isReportable) *)); //cordon 1

	    dataset.addRow(day).(
			set(0,day).
			set(1,hourOfDay).
			set(2,(b1 != null) ? b1.biomass : 0).
			set(3,(b2 != null) ? b2.biomass : 0).
			set(4,(b3 != null) ? b3.biomass : 0).
			set(5,(b4 != null) ? b4.biomass : 0)
				
			);
	}

	if(chart == 36) {
		int scenarioIndex = getDailyMeanUnloadingScenarioIndex(scenario);
		if ((dailyMeanUnloadingCount[scenarioIndex] == 0) || (dailyMeanUnloadingDay[scenarioIndex] != day)) {
			resetDailyMeanUnloading(scenarioIndex, day);
		}

		dailyMeanUnloadingCount[scenarioIndex]++;
		dailyMeanFineRootUnloadingSum[scenarioIndex] += pb.fraction_fineRootUnloading;
		dailyMeanLeafUnloadingSum[scenarioIndex] += pb.fraction_leafUnloading;
		dailyMeanPerennielWoodUnloadingSum[scenarioIndex] += pb.fraction_perennielWoodUnloading;
		dailyMeanFruitUnloadingSum[scenarioIndex] += pb.fraction_fruitUnloading;
		// Use the current internode fraction as the daily new-shoot proxy.
		dailyMeanInternodeUnloadingSum[scenarioIndex] += pb.fraction_internodeUnloading;
		dailyMeanStructuralRootUnloadingSum[scenarioIndex] += pb.fraction_structuralRootUnloading;

		double sampleCount = dailyMeanUnloadingCount[scenarioIndex];
		dataset.getRow(day).
		set(0 + 6*scenario, dailyMeanFineRootUnloadingSum[scenarioIndex] / sampleCount).
		set(1 + 6*scenario, dailyMeanLeafUnloadingSum[scenarioIndex] / sampleCount).
		set(2 + 6*scenario, dailyMeanPerennielWoodUnloadingSum[scenarioIndex] / sampleCount).
		set(3 + 6*scenario, dailyMeanFruitUnloadingSum[scenarioIndex] / sampleCount).
		set(4 + 6*scenario, dailyMeanInternodeUnloadingSum[scenarioIndex] / sampleCount).
		set(5 + 6*scenario, dailyMeanStructuralRootUnloadingSum[scenarioIndex] / sampleCount);
	}
	
	
	
}


