  // local row coordinate; same as BudPlanner.xRowLocal
  // local row coordinate; same logic as BudPlanner.xRowLocal
static double localXRow(Organ obj){
  try { obj.update3D(); } catch(Throwable t){}

  // use wrapper Double to allow null-checks
  Double xwD = getDoubleField(obj, "x");
  if (xwD == null) xwD = getDoubleField(obj, "X");

  Double ywD = getDoubleField(obj, "y");
  if (ywD == null) ywD = getDoubleField(obj, "Y");

  double xw = (xwD != null) ? xwD.doubleValue() : 0.0;
  double yw = (ywD != null) ? ywD.doubleValue() : 0.0;

  double dx = xw - tx;
  double dy = yw - ty;
  double th = rowOrientation * Math.PI / 180.0;

  return dx * Math.cos(th) + dy * Math.sin(th);
}


  static int gridIndex(Cfg cfg, double xr, double zr){
    if (xr < cfg.gridXmin || xr > cfg.gridXmax) return -1;
    if (zr < cfg.gridZmin || zr > cfg.gridZmax) return -1;

    double dx = (cfg.gridXmax - cfg.gridXmin)/cfg.gridNx;
    double dz = (cfg.gridZmax - cfg.gridZmin)/cfg.gridNz;

    int ix = (int)((xr - cfg.gridXmin)/dx);
    int iz = (int)((zr - cfg.gridZmin)/dz);

    if (ix<0 || ix>=cfg.gridNx) return -1;
    if (iz<0 || iz>=cfg.gridNz) return -1;

    return iz*cfg.gridNx + ix;
  }
  static double round3(double v) {
    return Math.round(v * 1000.0) / 1000.0;
  }


  // --- Safe field readers (fallbacks) ---
  static Double getDoubleField(Object obj, String name) {
    try {
      if (obj == null)
        return null;
      java.lang.reflect.Field f = obj.getClass().getField(name);
      Object v = f.get(obj);
      if (v instanceof Number)
        return Double.valueOf(((Number) v).doubleValue());
      if (v instanceof String)
        return Double.valueOf(Double.parseDouble((String) v));
    } catch (Throwable t) {
      /* ignore */ }
    return null;
  }
  static double zBase(Organ itn) {
    Double v = getDoubleField(itn, "z");
    if (v == null)
      v = getDoubleField(itn, "Z");
    if (v == null)
      v = getDoubleField(itn, "zCoord");
    return (v != null) ? v.doubleValue() : 0.0;
  }

  static double zTip(Organ itn) {
    Double v = getDoubleField(itn, "endZ");
    if (v == null)
      v = getDoubleField(itn, "tipZ");
    if (v == null)
      v = getDoubleField(itn, "Z_end");
    return (v != null) ? v.doubleValue() : zBase(itn);
  }

  static Internode orderRootKey(Internode itn, int targetOrder) {
    if (itn == null)
      return null;
    int ord = (targetOrder > 0) ? targetOrder : 1;
    Internode anchor = itn;
    if (anchor.order != ord) {
      Internode anc = first((* itn (<--)+ j:Internode, (j.order == ord) *));
      if (anc != null)
        anchor = anc;
    }
    Internode cur = anchor;
    int guard = 0;
    while (guard++ < 2000) {
      Internode prev = first((* cur (<--)+ j:Internode, (j.order == anchor.order) *));
      if (prev == null)
        break;
      cur = prev;
    }
    return cur;
  }

  
  // --- Read static global/model option fields safely via reflection ---------
static double getDoubleOption(String fieldName, double defaultVal) {
  String[] classes = new String[] { "modelOptions", "globalParameters", "plantParameters" };
  int i;

  for (i = 0; i < classes.length; i++) {
    try {
      Class cls = Class.forName(classes[i]);
      java.lang.reflect.Field f = cls.getField(fieldName);
      Object v = f.get(null);
      if (v instanceof Number) {
        return ((Number) v).doubleValue();
      }
      if (v instanceof String) {
        return Double.valueOf(Double.parseDouble((String) v)).doubleValue();
      }
    } catch (Throwable t) {
      // ignore and try next
    }
  }
  return defaultVal;
}

static int getIntOption(String fieldName, int defaultVal) {
  double d = getDoubleOption(fieldName, Double.NaN);
  if (d == d) { // not NaN
    return (int) Math.round(d);
  }
  return defaultVal;
}
  // Approximate biomass used for pruning stats
  static double getBiomass(Object organ) {
    Double d;

    d = getDoubleField(organ, "dryMass");
    if (d != null) return Math.max(0.0, d.doubleValue());

    d = getDoubleField(organ, "DW");
    if (d != null) return Math.max(0.0, d.doubleValue());

    d = getDoubleField(organ, "freshMass");
    if (d != null) return Math.max(0.0, d.doubleValue());

    d = getDoubleField(organ, "FW");
    if (d != null) return Math.max(0.0, d.doubleValue());

    d = getDoubleField(organ, "mass");
    if (d != null) return Math.max(0.0, d.doubleValue());

    d = getDoubleField(organ, "biomass");
    if (d != null) return Math.max(0.0, d.doubleValue());

    return 0.0;
  }

