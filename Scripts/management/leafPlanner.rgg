  // --- Safe int field reader (for rank/nodeNumber/cordonNumber, etc.) -------
	static int getIntField(Object obj, String name, int defaultVal) {
	  try {
		if (obj == null) return defaultVal;
		java.lang.reflect.Field f = obj.getClass().getField(name);
		Object v = f.get(obj);
		if (v instanceof Number) return ((Number)v).intValue();
		if (v instanceof String) return Integer.parseInt((String)v);
	  } catch (Throwable t) { /* ignore */ }
	  return defaultVal;
	}
/** 
 * Returns a list of internodes that have no descendant internodes 
 * (tips of axes / shoots).
 */
static java.util.List findShootTips() {
  java.util.List tips = new java.util.ArrayList(); // List<Internode>

  for (Internode itn : (* Internode *)) {
    boolean hasDescendant = false;
    // any descendant internode reachable via "-->"
    for (Internode child : (* itn (-->)+ c:Internode *)) {
      hasDescendant = true;
      break;
    }
    if (!hasDescendant) {
      tips.add(itn);
    }
  }

  println("[LeafPlanner] found " + tips.size() + " shoot tips.");
  return tips;
}

static PlantBase findPlantBaseForInternode(Internode itn) {
  int pn = 0;
  if(itn == null) { println("Input tnternode is null"); return null;};
  
  try { pn = itn.plantNumber; } catch (Throwable t) {
    pn = getIntField(itn, "plantNumber", 0);
  }

  for (PlantBase pb : (* PlantBase *)) {
    try {
      if (pb.plantNumber == pn) return pb;
    } catch (Throwable t) {
      if (getIntField(pb, "plantNumber", -1) == pn) return pb;
    }
  }
  return null;
}

static Leaf findTemplateLeaf(Internode itn) {
  // try leaves downstream of this internode
  for (Leaf lf : (* itn (-->)+ l:Leaf *)) {
    return lf;
  }
  // fallback: any leaf on the same plant
  int pn = getIntField(itn, "plantNumber", 0);
  for (Leaf lf : (* Leaf *)) {
    int pl = getIntField(lf, "plantNumber", 0);
    if (pl == pn) return lf;
  }
  return null;
}


