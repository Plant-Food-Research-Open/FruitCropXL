	 */
	void initOutputHeaders() {
		outputHeader = new ArrayList();
	}

	public double[] getRawValues() {
		return jLaunch.getValues();
	}

	public ObjectNode getJsonValues() {
		ObjectMapper mapper = new ObjectMapper();
		ObjectNode node = mapper.createObjectNode();
		double[] rawValues = getRawValues();

		node.put("ageD", ageD);
		node.put("ageHour", ageHour);
		node.put("ageMin", ageMin);
		// if (printFlag) { println("Output Headers and Values:" +  outputHeader.size()); }
		for (int i = 0; i < outputHeader.size(); i++) {
			String k = (String) outputHeader.get(i);
			double v = rawValues[i];
			node.put(k, v);
		}

		// Fruit light outputs for per-fruit output tables.
		node.put("fruitIncidentPAR_umol_m2_s", fruitIncidentPAR);
		node.put("fruitAbsorbedPAR_umol_s", fruitAbsorbedPAR);
		node.put("fruitAbsorbedRadiation_modelRad_s", fruitAbsorbedRadiation);
		node.put("fruitAbsorbedRadiation_m2_modelRad_m2_s", fruitAbsorbedRadiation_m2);
		node.put("fruitLightArea_m2", fruitLightArea_m2);
		node.put("fruitBerryCountEffective", fruitBerryCountEffective);
		node.put("fruitZ_m", z);
		node.put("fruitHeightBand4", getFruitHeightBand4());

		return node;
	}
	
	public void syncOutputs(ObjectNode node) {
	
	}

