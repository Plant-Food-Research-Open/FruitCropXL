	/**
	 * Retrieves the ParametersFactory instance from the jLaunch object.
	 * 
	 * @return The ParametersFactory instance associated with jLaunch.
	 */
		public ParametersFactory getParamFct() {
			return jLaunch.getParamFct();
		}

		private static boolean isFiniteValue(double v) {
			return !(Double.isNaN(v) || Double.isInfinite(v));
		}

		protected double getFruitWaterMass_g() {
			if (!isFiniteValue(waterMass)) return Double.NaN;
			return waterMass * mgTogram;
		}

		protected double calcSugar2SolubleSugarMass_g() {
			if (!isFiniteValue(mSuc) || !isFiniteValue(mSor)
				|| !isFiniteValue(mGlu) || !isFiniteValue(mFru)) {
				return Double.NaN;
			}

			double suc_g = mSuc / CARBON_FRACTION_SUCROSE;
			double sor_g = mSor / CARBON_FRACTION_SORBITOL;
			double glu_g = mGlu / CARBON_FRACTION_GLUCOSE;
			double fru_g = mFru / CARBON_FRACTION_GLUCOSE;
			return suc_g + sor_g + glu_g + fru_g;
		}

		protected double calcSugarSolubleSugarMass_g() {
			if (!isFiniteValue(mSol)) return Double.NaN;
			return mSol / getCtcsSugarCarbonFraction();
		}

		protected double calcSyncedSolubleSugarMass_g() {
			double sugar2Mass_g = calcSugar2SolubleSugarMass_g();
			if (isFiniteValue(sugar2Mass_g)) return sugar2Mass_g;

			double sugarMass_g = calcSugarSolubleSugarMass_g();
			if (isFiniteValue(sugarMass_g)) return sugarMass_g;

			return Double.NaN;
		}

		protected int getCtcsFunc() {
			try {
				if (jLaunch == null || jLaunch.getParamFct() == null
					|| jLaunch.getParamFct().getConfiguration() == null) {
					return 2;
				}
				return jLaunch.getParamFct().getConfiguration().getInt("Growth.ctcsFunc", 1);
			} catch (RuntimeException e) {
				// Compatibility fallback: preserve legacy hexose interpretation when key/config is absent.
				return 2;
			}
		}


		protected double getCtcsSugarCarbonFraction() {
			return (getCtcsFunc() == 1) ? CARBON_FRACTION_SUCROSE : CARBON_FRACTION_GLUCOSE;
		}

		protected double calcSyncedSugarConcentration_g_per_g_water() {
			double waterMass_g = getFruitWaterMass_g();
			double solubleSugarMass_g = calcSyncedSolubleSugarMass_g();
			if (!isFiniteValue(waterMass_g) || waterMass_g <= 0.0
				|| !isFiniteValue(solubleSugarMass_g) || solubleSugarMass_g < 0.0) {
				return Double.NaN;
			}
			return solubleSugarMass_g / waterMass_g;
		}

		public FruitInitState captureInitState() {
			FruitInitState s = new FruitInitState();

			s.freshWeight_mg = freshWeight;
			s.dryWeight_mg = biomass;
			s.waterMass_mg = waterMass;
			s.seedDryWeight_mg = seedDryWeight;
			s.vol_cm3 = vol;

			s.age_model = age;
			s.ageD_day = ageD;
			s.ageHour = ageHour;
			s.ageMin = ageMin;
			s.length_m = length;
			s.diameter_m = diameter;

			s.mSuc = mSuc;
			s.mSor = mSor;
			s.mGlu = mGlu;
				s.mFru = mFru;
				s.mSta = mSta;
				s.mSyn = mSyn;
				s.sugarConcentration_fruit_g_per_g = sugarConcentration_fruit;

			s.hasSugar2Mass =
				isFiniteValue(s.mSuc) && isFiniteValue(s.mSor)
				&& isFiniteValue(s.mGlu) && isFiniteValue(s.mFru)
				&& isFiniteValue(s.mSta);

			if (!isFiniteValue(s.freshWeight_mg) || s.freshWeight_mg <= 0) {
				if (isFiniteValue(s.waterMass_mg) && isFiniteValue(s.dryWeight_mg)) {
					double seed = isFiniteValue(s.seedDryWeight_mg) ? s.seedDryWeight_mg : 0.0;
					s.freshWeight_mg = Math.max(0.0, s.waterMass_mg + s.dryWeight_mg + seed);
				}
			}

			s.valid = (isFiniteValue(s.freshWeight_mg) && s.freshWeight_mg > 0)
				   || (isFiniteValue(s.dryWeight_mg) && s.dryWeight_mg > 0)
				   || s.hasSugar2Mass;
			return s;
		}

		public void applyInitState(FruitInitState s) {
			if (s == null || !s.valid) return;

			if (isFiniteValue(s.dryWeight_mg) && s.dryWeight_mg >= 0) biomass = s.dryWeight_mg;
			if (isFiniteValue(s.freshWeight_mg) && s.freshWeight_mg >= 0) freshWeight = s.freshWeight_mg;
			if (isFiniteValue(s.waterMass_mg) && s.waterMass_mg >= 0) waterMass = s.waterMass_mg;
			if (isFiniteValue(s.seedDryWeight_mg) && s.seedDryWeight_mg >= 0) seedDryWeight = s.seedDryWeight_mg;
			if (isFiniteValue(s.vol_cm3) && s.vol_cm3 >= 0) vol = s.vol_cm3;

			if (isFiniteValue(s.age_model) && s.age_model >= 0) age = s.age_model;
			if (isFiniteValue(s.ageD_day) && s.ageD_day >= 0) ageD = s.ageD_day;
			if (s.ageHour >= 0) ageHour = s.ageHour;
			if (s.ageMin >= 0) ageMin = s.ageMin;
			if (isFiniteValue(s.length_m) && s.length_m > 0) length = s.length_m;
			if (isFiniteValue(s.diameter_m) && s.diameter_m > 0) diameter = (float) s.diameter_m;

				if (s.hasSugar2Mass) {
					if (isFiniteValue(s.mSuc)) mSuc = s.mSuc;
					if (isFiniteValue(s.mSor)) mSor = s.mSor;
				if (isFiniteValue(s.mGlu)) mGlu = s.mGlu;
				if (isFiniteValue(s.mFru)) mFru = s.mFru;
					if (isFiniteValue(s.mSta)) mSta = s.mSta;
					if (isFiniteValue(s.mSyn)) mSyn = s.mSyn;
				}
				if (isFiniteValue(s.sugarConcentration_fruit_g_per_g) && s.sugarConcentration_fruit_g_per_g > 0) {
					sugarConcentration_fruit = s.sugarConcentration_fruit_g_per_g;
				}

			if (isFiniteValue(freshWeight) && freshWeight > 0
				&& isFiniteValue(waterMass) && waterMass >= 0) {
				double wc = waterMass / freshWeight;
				if (isFiniteValue(wc)) {
					if (wc < 0) wc = 0;
					if (wc > 1) wc = 1;
					waterContent = (float) wc;
				}
			}
		}
		
		public static ParametersFactory copyParametersFactory(ParametersFactory original) {
		ParametersFactory newFactory = new ParametersFactory();
		
		// Create a new Configuration object
		Configuration newConfig = new PropertiesConfiguration();
		
		// Copy all key-value pairs from the original Configuration
		for (Iterator keys = original.getConfiguration().getKeys(); keys.hasNext();) {
			String key = (String) keys.next();
			newConfig.setProperty(key, original.getConfiguration().getProperty(key));
		}
	
		// Assign the copied configuration to the new factory
		newFactory.setConfiguration(newConfig);

	return newFactory;
}

	
