/**
 * Class responsible for creating instances of different types of fruit services.
 * It maps the normalized fruitModule selector to exactly one service class.
 */
public class FruitCreator implements Serializable {
	// Preserve compatibility with serialized GroIMP graphs in project storage.
	private static final long serialVersionUID = 9167376384829494606L;
	private String fruitModule;

    /** The class type of the service to be used for fruit creation. */
    private Class serviceClass;

    /**
     * Constructor for FruitCreator.
     *
     * @param fruitModule normalized selector: simpleFruit, complexBerry, or virtualFruit.
     */
	public FruitCreator(String fruitModule) {
		this.fruitModule = fruitModule;
		this.serviceClass = getServiceClass();
	}

	 /**
     * Retrieves the class of the appropriate FruitService according to the creator's configuration.
     *
     * @return The class object of the selected FruitService.
     */
	public Class getServiceClass() {
		if (this.serviceClass != null) {
			return this.serviceClass;
		}

		if ("simpleFruit".equals(this.fruitModule)) {
			return SimpleFruit.class;
		} else if ("complexBerry".equals(this.fruitModule)) {
			return ComplexBerry.class;
		} else if ("virtualFruit".equals(this.fruitModule)) {
			return VirtualFruit.class;
		}
		throw new IllegalArgumentException("Unknown fruitModule '" + this.fruitModule
			+ "'. Accepted values: simpleFruit, complexBerry, virtualFruit");
	}

	public String getFruitModule() {
		return this.fruitModule;
	}

	public boolean usesSimpleFruitService() {
		return this.serviceClass == SimpleFruit.class
			|| this.serviceClass == BerrySimple.class;
	}

	public boolean usesComplexBerryService() {
		return this.serviceClass == ComplexBerry.class
			|| this.serviceClass == BerryComplex.class;
	}

	public boolean usesVirtualFruitService() {
		return this.serviceClass == VirtualFruit.class;
	}

	/**
     * Creates an instance of FruitService without any parameters.
     *
     * @return An instance of the appropriate FruitService.
     * @throws ReflectiveOperationException If there is an error with reflection during object creation.
     */
	public FruitService createFruit() {
		Constructor constructor = this.serviceClass.getConstructor();
		return (FruitService) constructor.newInstance();
	}

	 /**
     * Creates an instance of FruitService with String parameters and an integer delta.
     *
     * @param fruitParams The parameters to pass to the FruitService constructor.
     * @param delta       An integer delta value for the FruitService.
     * @return An instance of the appropriate FruitService.
     * @throws ReflectiveOperationException If there is an error with reflection during object creation.
     */
	public FruitService createFruit(String fruitParams, int delta) {
		Constructor constructor = this.serviceClass.getConstructor(String.class, int.class);

		return (FruitService) constructor.newInstance(fruitParams, delta);
	}

	public FruitService createFruit(ParametersFactory parametersFactory, int delta) {
		Constructor constructor = this.serviceClass.getConstructor(ParametersFactory.class, int.class);

		return (FruitService) constructor.newInstance(parametersFactory, delta);
	}
}

/**  
 * The Fruit module (merged with FruitService for alternative module switching).
 * 
 */
public abstract module FruitService extends GrowingOrgan implements IFruit, ILightInterceptable, Serializable {

	// Preserve compatibility with serialized GroIMP graphs in project storage.
	private static final long serialVersionUID = -223223826634580231L;

	/**
	 * Shared fruit allocation dispatch.
	 *
	 * Fruit services historically publish their potential/loading/leakage/
	 * unloading terms directly and do not invoke GrowingOrgan.calcSupplyDemand
	 * during the phloem-concentration solve. Keeping that sequence here
	 * preserves complex and virtual fruit numerics while allowing every fruit
	 * implementation, including SimpleFruit, to use one polymorphic boundary.
	 */
	@Override
	abstract void updateCarbonAllocation(double sugarConcentration);


public class ExtendedJLaunch extends JLaunch implements Serializable {
    private final long serialVersionUID = 1L;
    /**
     * Default constructor.
     */
    public ExtendedJLaunch() {
        super(); // Calls the default constructor of JLaunch
    }

    /**
     * Constructor with ParametersFactory.
     * @param paramFct ParametersFactory instance for initialization.
     */
    public ExtendedJLaunch(ParametersFactory paramFct) {
        super(paramFct); // Calls the parent constructor with ParametersFactory
    }
    
    /**
     * Override of the readProperties method to include logging and additional functionality.
     * @param pathname Name of the .properties file.
     */
    @Override
    public void readProperties(String pathname) {
          try {
			// Lecture et vérification des paramètres
			File fParam = new File(pathname);
			if (!fParam.exists()) throw new ParseException("File " + fParam.getPath() + " not found");
			paramFct.load(fParam, null);
			paramFct.writeAndCheck();
			//paramFct.print();
		}
		catch (Exception e) {
			String message = e.getMessage() == null ? e.toString() : e.getMessage();
			System.out.println("FATAL : " + message);
		}
		catch (Error e) {
			String message = e.getMessage() == null ? e.toString() : e.getMessage();
			System.out.println("FATAL : " + message);
		}
	}
}

	/**
	 * Explicit template payload for initializing a newly added fruit.
	 * Units:
	 * - freshWeight_mg, dryWeight_mg, waterMass_mg, seedDryWeight_mg in mg
	 * - vol_cm3 in cm3
	 * - mSuc/mSor/mGlu/mFru/mSta/mSyn in g C (mirrors JFruit Sugar2 outputs)
	 * - c*0 in the raw Sugar2 init-key units from the parameter file; pass through unchanged
	 */
	public static class FruitInitState implements Serializable {
		private static final long serialVersionUID = 1L;
		public boolean valid = false;
		public boolean hasSugar2Mass = false;
		public boolean hasSugar2Concentrations = false;
		public double freshWeight_mg = Double.NaN;
		public double dryWeight_mg = Double.NaN;
		public double waterMass_mg = Double.NaN;
		public double seedDryWeight_mg = Double.NaN;
		public double vol_cm3 = Double.NaN;
		public double age_model = Double.NaN;
		public double ageD_day = Double.NaN;
		public int ageHour = -1;
		public int ageMin = -1;
		public double length_m = Double.NaN;
		public double diameter_m = Double.NaN;
		public double mSuc = Double.NaN;
		public double mSor = Double.NaN;
		public double mGlu = Double.NaN;
		public double mFru = Double.NaN;
		public double mSta = Double.NaN;
		public double mSyn = Double.NaN;
		public double sugarConcentration_fruit_g_per_g = Double.NaN;
		public double cSuc0 = Double.NaN;
		public double cSor0 = Double.NaN;
		public double cGlu0 = Double.NaN;
		public double cFru0 = Double.NaN;
		public double cSta0 = Double.NaN;
	}


