public double sugarConcentration_phloem; /**< Sucrose concentration in the phloem (g sugar/g solution). */

public double unloadingPerFruit; /**< The rate at which substances are unloaded from the phloem into the berry. */
public double sugarUptake_active; /**< Active sugar absorption (g sugar/h). */
public double sugarUptake_massflow; /**< Mass flux of sugar (g sugar/h). */
public double sugarUptake_passive; /**< Passive sugar flux (g sugar/h). */
public double solubleSugar; /**< Amount of soluble sugar in the fruit (mg soluble sugar). */
public double mSol; /**< Amount of carbon in soluble sugars (g C). */
public double mSta; /**< Amount of carbon in starch (g C). */
public double mSyn; /**< Amount of carbon in other compounds (g C). */
