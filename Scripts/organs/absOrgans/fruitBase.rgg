	@Override
	void update() {
		 super.update();
		 // Fruit surface area from fruit models is stored as Afruit [cm2]; light module uses area [m2].
		 if (Afruit > 0) {
		 	area = Afruit * 1e-4;
		 } else {
		 	area = 0;
		 }
		 // Keep light outputs until calcLight() updates/resets them in the interception phase.
		 fruitLightArea_m2 = area;
		 fruitBerryCountEffective = 1;
		 
	} 

	/**
	 * Returns a 1..4 band index for current fruit z-position based on configured output heights.
	 */
	public int getFruitHeightBand4() {
		if (output_height == null || output_height.length < 2) {
			return 1;
		}
		for (int i = 0; i < output_height.length - 1; i++) {
			if (z >= output_height[i] && z < output_height[i + 1]) {
				return i + 1;
			}
		}
		if (z >= output_height[output_height.length - 1]) {
			return Math.min(4, output_height.length);
		}
		return 1;
	}

	/**
	 * Computes effective fruit area for light interception (m2).
	 * Base implementation uses single-fruit surface area from Afruit.
	 */
	public double computeFruitLightArea_m2() {
		fruitBerryCountEffective = 1;
		return area;
	}

	/**
	 * Returns true when fruit should be included in light interception for the current step.
	 */
	public boolean shouldCalcLight() {
		if (Afruit > 0) {
			area = Afruit * 1e-4;
		} else {
			area = 0;
		}
		fruitLightArea_m2 = computeFruitLightArea_m2();
		if (Double.isNaN(fruitLightArea_m2) || Double.isInfinite(fruitLightArea_m2) || fruitLightArea_m2 <= 0) {
			fruitLightArea_m2 = area;
		}
		return (calcLightInterception == true && runLightModel == true
			&& globalRadiation > LIGHT_THRESHOLD && fruitLightArea_m2 > 1e-4);
	}

	/**
	 * Resets fruit light interception outputs when light is not computed.
	 */
	private void resetFruitLightOutputs() {
		fruitIncidentPAR = 0;
		fruitAbsorbedPAR = 0;
		fruitAbsorbedRadiation = 0;
		fruitAbsorbedRadiation_m2 = 0;
		fruitLightArea_m2 = 0;
		fruitBerryCountEffective = 0;
	}

	/**
	 * Calculates fruit light interception using the existing scene light model.
	 */
	@Override
	public void calcLight() {
		if (shouldCalcLight() == false || isLightInterceptionStepPrepared() == false) {
			resetFruitLightOutputs();
			return;
		}
		double singleFruitArea_m2 = Math.max(1e-8, area);
		double effectiveArea_m2 = Math.max(1e-8, fruitLightArea_m2);
		LightInterceptionResult result = getFruitLightResult(this, singleFruitArea_m2, effectiveArea_m2);
		fruitIncidentPAR = result.incPARm2;
		fruitAbsorbedPAR = result.absPAR;
		fruitAbsorbedRadiation = result.abs;
		fruitAbsorbedRadiation_m2 = result.absm2;
	}

	/**
	 * Constructor method.
	 * 
	 * @param fruitParams The fruit parameter file contents.
	 * @param delta The delta value for timesteps.
	 */
	
	public FruitService(String fruitParams, int delta) {
		jLaunch = new ExtendedJLaunch();
		
		loadParameters();
		
		jLaunch.readProperties(fruitParams);
		
		input = jLaunch.initInput(delta);
		
		initOutputHeaders(); 
	}

	/**
	 * Constructor method.
	 * 
	 * @param parametersFactory The fruit parameters factory.
	 * @param delta The delta value for timesteps.
	 */
	public FruitService(ParametersFactory parametersFactory, int delta) {
		loadParameters();
		
		jLaunch = new ExtendedJLaunch(parametersFactory);
		input = jLaunch.initInput(delta);
		
		initOutputHeaders();
	}
	
	public void postLoad() {
		
		if (input == null && jLaunch != null) {
			input = jLaunch.initInput(DELTA);
		}
	}
	
	
