	@Override
	void calcAge() 
	{
		//confounded by the original fruit model, here ageD is using in some calculation
		super.calcAge();
		age_pre = age;
		age = age + DT * wangEngelTempFunction(Ta, MIN_TEMP, OPT_TEMP, MAX_TEMP,REFTMP);
		
		if(age > 0) {
			ageHour++;
			ageD = ageD + DT;
			//agePrevious = age;	
			ageGdd = ageGdd_pre + deltaAgeGdd(Ta, baseT, DT);
			ageMin = 60*ageHour;
			//devAge += specificGrowthRate(TAU, Ta)*DT;
		}
	}
	
		
