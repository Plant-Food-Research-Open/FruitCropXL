	/** 
	 * Used for calculating the dt. 
	 * The dt is then multiplied to the rate. 
	 * Which dt to multiply depends on what time is referred to in the rate definition.
	 * If the rate is naturally in hours, e.g., fruit model, no dt is required to multiply as dt is the same as the model step.
	 */
	double age_pre;
	/** Represents the previous value of the organ age in growing degree days. */
	double ageGdd_pre;
	double ageTd_pre;
	double ageTg_pre;
	
	/** Time at which the maximum growth rate is obtained (0 < tm < te) */
	double tm;
