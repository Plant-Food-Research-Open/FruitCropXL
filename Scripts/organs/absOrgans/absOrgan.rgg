/** Non-static members belong to an object, not to the class itself, 
	so you need to create an instance (or use an existing one) to access these members.
	It is generally not recommended to have static fields in an abstract class intended 
	to be different for each subclass that extends it. 
	Static fields are shared among all instances of a class and its subclasses, 
	meaning if one subclass changes the value of a static field, 
	it changes for all other subclasses and instances of that abstract class.
*/

/**
 * Custom implementation of the M class that conditionally performs movement 
 * along the local z-direction based on a control flag.
 */


/**
 * Abstract class representing a plant organ.
 * <p>
 * This class serves as the parent module for all plant organs.
 * It contains various attributes like length, diameter, ID, etc.
 
 * parent module for all plant organs
 * An abstract module for Organ, with super.length, diameter, ID, organID, and order as inputs
 * ID is based on the identifier (first column) of the architecture input excel
 * OrganID is the organID in the architecture input excel, indicates the type of the organ
 * UUID is a self increasing ID for unique identification
 * order from xnode (1 = main stem (trunk), 2 for cordon, 3 for uprights, 4 for branches on the uprights)
 * note in the shoot.rgg, for differentiate primary annual shoot growth and sylleptic branching, another variable
 * called syllepticOrder was added as well. 
 * Used this convention:
	 * Axis slot means branch path, not organ ID.
	 * For a child of order k, overwrite axiskID.
	 * The value written into that slot should be the attachment-site identity.
	 * For ordinary single axillary buds, that can be the parent internode rank.
	 * For cases with potentially multiple children from one site, use a stronger local identifier than rank alone.
 * There is two initiate methods for the organ. 
 * one is initiating newly grown organ, with a small initial size, mainly for dynamic growth 
 * another one is for initiation of an exisitng architecture with known organ size.
 
 * </p>
 */
 /* only use static before the parameters which will make it the same for each class*/
 /* do not use static before the variables AND EVEN THE PARAMETERS THAT WILL CHANGE BASED ON ORGAN TYPE, LIKE KM*/
abstract module Organ(super.length) extends M(length) implements Configurable
{
	/**
	 * Keep graph-deserialization compatibility for existing project graph/shader links.
	 * Matches the UID used in saved graphs prior to recent helper-method additions.
	 */
	private static final long serialVersionUID = 6522110303210210030L;

	public static double profileValueAt(double[][] profile, double x) {
		if (profile == null || profile.length < 2) return Double.NaN;
		double[] xs = profile[0];
		double[] ys = profile[1];
		if (xs == null || ys == null || xs.length == 0 || ys.length == 0) return Double.NaN;
		if (Double.isNaN(x) || Double.isInfinite(x)) x = xs[0];
		if (x <= xs[0]) return ys[0];
		int last = Math.min(xs.length, ys.length) - 1;
		if (x >= xs[last]) return ys[last];
		int i;
		for (i = 0; i < last; i++) {
			double x0 = xs[i];
			double x1 = xs[i + 1];
			if (x >= x0 && x <= x1) {
				double y0 = ys[i];
				double y1 = ys[i + 1];
				double span = x1 - x0;
				if (span <= 0.0) return y1;
				double w = (x - x0) / span;
				return y0 + w * (y1 - y0);
			}
		}
		return ys[last];
	}

	public static double profileValueAtRank(double[][] profile, int rank1) {
		int safeRank = rank1;
		if (safeRank < 1) safeRank = 1;
		return profileValueAt(profile, Double.valueOf(safeRank).doubleValue());
	}

	public static double actualToPotentialSize(double actualSize) {
		double safeActual = actualSize;
		if (Double.isNaN(safeActual) || Double.isInfinite(safeActual)) safeActual = 0.0;
		if (safeActual < 0.0) safeActual = 0.0;
		if ("potentialFromActual".equalsIgnoreCase(leafSizeMode) &&
			!"TempLimited".equalsIgnoreCase(organGrowthMethod)) {
			return safeActual * potentialLengthMultiplier;
		}
		return safeActual;
	}

	public boolean shouldUsePreT1PotentialGrowth() {
		if (!enablePotentialGrowthBeforeT1) return false;
		if (!preT1PotentialGrowthActive) return false;
		if (!"apple".equalsIgnoreCase(species)) return false;
		if (useStaticArc) return false;
		return true;
	}

	public static void applyLeafTargetLengthAtInit(Leaf lf, double targetLength) {
		if (lf == null) return;
		double safeTarget = targetLength;
		if (Double.isNaN(safeTarget) || Double.isInfinite(safeTarget)) return;
		safeTarget = Math.max(1.0e-4, safeTarget);
		// Dynamic leaves keep a shared emergence size; only their final growth ceiling varies by rank.
		lf.maxLength = safeTarget;
		double safeCurrent = lf.length;
		if (Double.isNaN(safeCurrent) || Double.isInfinite(safeCurrent) || safeCurrent <= 0.0) {
			safeCurrent = Math.max(1.0e-4, lf.initialLength);
		}
		safeCurrent = Math.min(safeCurrent, lf.maxLength);
		lf.length = safeCurrent;
		if (Double.isNaN(lf.initialLength) || Double.isInfinite(lf.initialLength) || lf.initialLength <= 0.0) {
			lf.initialLength = safeCurrent;
		}
		lf.initialLength = Math.min(lf.initialLength, lf.maxLength);
		double safePotLength = lf.potLength;
		if (Double.isNaN(safePotLength) || Double.isInfinite(safePotLength) || safePotLength <= 0.0) {
			safePotLength = safeCurrent;
		}
		lf.potLength = Math.max(safeCurrent, Math.min(safePotLength, lf.maxLength));
		if (Double.isNaN(lf.lwRatio) || lf.lwRatio <= 0.0) {
			lf.lwRatio = leafShape.getRefLength()/leafShape.getRefWidth();
		}
		lf.width = lf.length / lf.lwRatio;
	}

	public static double clampNonShrinkingPotentialLength(double currentLength, double candidateLength, double maxLength) {
		double safeCurrent = currentLength;
		if (Double.isNaN(safeCurrent) || Double.isInfinite(safeCurrent) || safeCurrent <= 0.0) {
			safeCurrent = 1.0e-4;
		}
		double safeMax = maxLength;
		if (Double.isNaN(safeMax) || Double.isInfinite(safeMax) || safeMax <= 0.0) {
			safeMax = Math.max(safeCurrent, candidateLength);
		}
		safeMax = Math.max(1.0e-4, safeMax);
		double safeCandidate = candidateLength;
		if (Double.isNaN(safeCandidate) || Double.isInfinite(safeCandidate) || safeCandidate <= 0.0) {
			safeCandidate = safeCurrent;
		}
		safeCandidate = Math.min(safeCandidate, safeMax);
		return Math.max(safeCurrent, safeCandidate);
	}

	public static void applyLeafTargetGeometryAtInit(Leaf lf, double targetLength, double targetWidth) {
		if (lf == null) return;
		double safeTargetLength = targetLength;
		if (Double.isNaN(safeTargetLength) || Double.isInfinite(safeTargetLength)) return;
		safeTargetLength = Math.max(1.0e-4, safeTargetLength);
		double safeTargetWidth = targetWidth;
		if (Double.isNaN(safeTargetWidth) || Double.isInfinite(safeTargetWidth) || safeTargetWidth <= 0.0) {
			double fallbackRatio = lf.lwRatio;
			if (Double.isNaN(fallbackRatio) || Double.isInfinite(fallbackRatio) || fallbackRatio <= 0.0) {
				fallbackRatio = leafShape.getRefLength()/leafShape.getRefWidth();
			}
			safeTargetWidth = safeTargetLength / fallbackRatio;
		}
		lf.lwRatio = safeTargetLength / Math.max(1.0e-6, safeTargetWidth);
		applyLeafTargetLengthAtInit(lf, safeTargetLength);
		lf.width = lf.length / lf.lwRatio;
	}

	public static void applyLeafTargetAreaAtInit(Leaf lf, double targetArea) {
		if (lf == null) return;
		double safeTarget = targetArea;
		if (Double.isNaN(safeTarget) || Double.isInfinite(safeTarget)) return;
		safeTarget = Math.max(1.0e-8, safeTarget);
		double baseLength = lf.maxLength;
		if (Double.isNaN(baseLength) || Double.isInfinite(baseLength) || baseLength <= 0.0) {
			baseLength = Math.max(1.0e-4, lf.length);
		}
		if (Double.isNaN(lf.lwRatio) || lf.lwRatio <= 0.0) {
			lf.lwRatio = leafShape.getRefLength()/leafShape.getRefWidth();
		}
		double baseWidth = baseLength / lf.lwRatio;
		double baseArea = leafShape.calcLeafPolygonArea((float) baseLength, (float) baseWidth, lf.fid);
		if (Double.isNaN(baseArea) || Double.isInfinite(baseArea) || baseArea <= 0.0) {
			baseArea = Math.max(1.0e-8, lf.area);
		}
		double scale = Math.sqrt(safeTarget / Math.max(1.0e-8, baseArea));
		if (Double.isNaN(scale) || Double.isInfinite(scale) || scale <= 0.0) {
			scale = 1.0;
		}
		applyLeafTargetLengthAtInit(lf, Math.max(1.0e-4, baseLength * scale));
		lf.area = leafShape.calcLeafPolygonArea((float) lf.length, (float) lf.width, lf.fid);
		// Do not overwrite profile-derived final-size targets here. This helper only
		// adjusts current emergence geometry; developApple owns final-size semantics.
	}

	public static void applyPetioleTargetLengthAtInit(Petiole pt, double targetLength) {
		if (pt == null) return;
		double safeTarget = targetLength;
		if (Double.isNaN(safeTarget) || Double.isInfinite(safeTarget)) return;
		safeTarget = Math.max(1.0e-4, safeTarget);
		// Dynamic petioles keep a shared emergence size; only their final growth ceiling varies by rank.
		pt.maxLength = safeTarget;
		double safeCurrent = pt.length;
		if (Double.isNaN(safeCurrent) || Double.isInfinite(safeCurrent) || safeCurrent <= 0.0) {
			safeCurrent = Math.max(1.0e-4, pt.initialLength);
		}
		safeCurrent = Math.min(safeCurrent, pt.maxLength);
		pt.length = safeCurrent;
		if (Double.isNaN(pt.initialLength) || Double.isInfinite(pt.initialLength) || pt.initialLength <= 0.0) {
			pt.initialLength = safeCurrent;
		}
		pt.initialLength = Math.min(pt.initialLength, pt.maxLength);
		double safePotLength = pt.potLength;
		if (Double.isNaN(safePotLength) || Double.isInfinite(safePotLength) || safePotLength <= 0.0) {
			safePotLength = safeCurrent;
		}
		pt.potLength = Math.max(safeCurrent, Math.min(safePotLength, pt.maxLength));
		pt.area = Math.PI * (pt.width * pt.width / 4.0);
		pt.vol = calcVol(pt.length, pt.width);
		pt.biomass = pt.vol * pt.density;
		pt.initCN_content(pt.biomass);
	}

	public static void applyInternodeTargetLengthAtInit(Internode i, double targetLength) {
		if (i == null) return;
		double safeTarget = targetLength;
		if (Double.isNaN(safeTarget) || Double.isInfinite(safeTarget)) return;
		safeTarget = Math.max(1.0e-4, safeTarget);
		// Dynamic internodes keep a shared emergence size; only their final growth ceiling varies by rank.
		i.maxLength = safeTarget;
		double safeCurrent = i.length;
		if (Double.isNaN(safeCurrent) || Double.isInfinite(safeCurrent) || safeCurrent <= 0.0) {
			safeCurrent = Math.max(1.0e-4, i.initialLength);
		}
		safeCurrent = Math.min(safeCurrent, i.maxLength);
		i.length = safeCurrent;
		if (Double.isNaN(i.initialLength) || Double.isInfinite(i.initialLength) || i.initialLength <= 0.0) {
			i.initialLength = safeCurrent;
		}
		i.initialLength = Math.min(i.initialLength, i.maxLength);
		double safePotLength = i.potLength;
		if (Double.isNaN(safePotLength) || Double.isInfinite(safePotLength) || safePotLength <= 0.0) {
			safePotLength = safeCurrent;
		}
		i.potLength = Math.max(safeCurrent, Math.min(safePotLength, i.maxLength));
		i.biomass = Math.PI * (i.diameter*i.diameter/4) * i.length * i.density;
		i.area = Math.PI * (i.diameter*i.diameter/4);
		i.initCN_content(i.biomass);
	}

