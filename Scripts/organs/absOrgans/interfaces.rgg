/**  
 * The virtual Fruit model in the jar file is from INRAe Avignon, 
 * contact Pierre Valsesia regarding to the code
 * The Fruit module interface.
 * @author  James Bristow, Junqi Zhu
 * @version 1.0
 * @since   22-03-2023
 */


 interface IFruit {

	/**
	 * Execute one time step of the simulation.
	 */
	void step();
	
	/**
	 * Get raw output values.
	 * 
	 * @return The raw output values.
	 */
	double[] getRawValues();

	/**
	 * Get JSON output values.
	 * 
	 * @return The output values in JSON format.
	 */
	ObjectNode getJsonValues();

	/**
	 * Synchronise the fruit input values to the input row.
	 * 
	 * @param age The age of the fruit.
	 * @param fruitRow The input row.
	 */
	void updateInput(int age, JsonNode fruitRow);

	/**
	 * Convert an input row into a JFruit2 Input object.
	 * 
	 * @param age The age of the fruit.
	 * @param fruitRow The input row.
	 */
	void fromArray(int age, JsonNode fruitRow);
	
	/**
	 * Synchronise the output from JFruit2 output values to the state variables in the fruit module.
	 * 
	 * @param see the Abstractfruit module
	 */
	void syncOutputs(ObjectNode node);
	

	}

	/**
	 * Minimal contract for organs that participate in light interception.
	 */
	interface ILightInterceptable {
		void calcLight();
	}


/**
 * The Configurable interface is implemented by classes/modules which load parameters
 * they require for initialization from the Config Module.
 */
interface Configurable {
	void loadParameters();
}

/** 
 * interface for soil 
 */
interface ISoil {}



