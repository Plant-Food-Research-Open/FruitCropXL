// @needs to set parameters to private in each class
/** Soil–root Resistance, for making the root calculation easier to use under field conditions. */
global float RSR;
/** maximum Soil–root Resistance, for making the root calculation easier to use under field conditions. */
global float RSR_max;
/** Parameter 'a' in equation 3; Tardieu's model jxb 2015. */
global float eq3_a;
/** ABAconstit in equation 3. */
global float eq3_constit;
/** Parameter 'b' in equation 3. */
global float eq3_b;
/** Initial amplitude of the xylem water potential. */
global float ampliinit;
/** Minimum value of Gr. */
global float Grmin;
/** Maximum value of Gr. */
global float Grmax;
/** Slope for calculating Grmax as a function of fine root biomass, from QualiTree. */
global float Grmax_a;
/** Intercept for calculating Grmax as a function of fine root biomass, from QualiTree. */
global float Grmax_b;
/** Taucircadgr ?circad for Gr (equation 7). */
global float Tautranspigr;
/** Tauevapgr ?evap for Gr (equation 7). */
global float Taucircadgr;
/** TauABAgr ?ABA for Gr (equation 7). */
global float TauABAgr;
/** Water-potential-gradient within the xylem pathway, 0.015 MPa m^-1 (Potkay et al., 2021; Woodruff et al., 2004; Woodruff & Meinzer, 2011). */
global float water_potential_gradient;

global float ROOT_TURNOVER = 2e-5f; // gc/gc/h Buwalda (1993)
// global float ROOTS_GROWTH_RATE = 1e-2f/24f;   // relative root growth rate g C (g C h)^-1. L-kiwi

/** Specific root length, m per mg. */
global double SRL;
/** maximum percentage of fine root to structural root. */
global double FINE_ROOT_CAP_RATIO = 0.3d;
/** The radius of the root, m. */
global float rootRadius;
/** Root tissue density (g/cm3). */
global double RTD;
/** Initial relative growth rate per hour at 25 °C (from QualiTree). */
global double RGRini = 0.15d;
/** The daysSinceWinterSolstice on which root growth occurs (before bud burst is better, as the RGR function is infinity on the first day). */
global double shift;
/** The daysSinceWinterSolstice on which root growth rate reaches the peak. */
global double peakDay;
/** The daysSinceWinterSolstice on which root growth rate reaches the minimum growth rate. */
global double endDay;
/** Root exudation per unit root biomass per unit time (g C g^-1 root h^-1); Converted from µg to g. */
global double SER;

/**
 * Fraction of nitrogen resorbed (remobilized) from senescing tissues back into the plant (dimensionless, 0..1).
 * <p>
 * Loaded from the configuration module; defaults to {@code 0.0} if not set.
 * Typical values: 0.3–0.7 depending on species, status, and phenology.
 */
global double N_resorptionFrac;

/** Extra turnover multiplier at extreme drought (+150%). */
global double K_DRY_TURNOVER    = 1.5d;
/** Absolute cap for turnover multiplier (×3 baseline). */
global double TURNOVER_MULT_MAX = 3.0d;
/** Optional floor for turnover multiplier (×0.5), e.g., in mild wet/cool. */
global double TURNOVER_MULT_MIN = 0.5d;


	public void loadParameters() {
		
		/** Set the context for file name parameters*/
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();
		// Context for root-carbon category
		/** Configuration context for carbon-related parameters */
		config.setCategoryContext("root-carbon");
		//common parameters
		maintenanceCoff        = config.getDouble("MTNCE", 7.6e-5);
		growthCoff             = config.getDouble("GROWTHRQ", 1.2);
		C_content              = config.getDouble("C_CONTENT", 0.46);
		maxRes                 = config.getDouble("RESERVES", 0.4);
		
		km_pri                 = config.getDouble("KM_PRI", 0.08);
		km_sec                 = 0; 
		configureReserveKmAbsolute(config, 0.32, 0.064);
		
		configureReserveTurnover(config, 0.0060, 0.0010);
		
		
		//specific parameters
		ROOT_TURNOVER          = config.getDouble("ROOT_TURNOVER", 5e-5);
		SRL                    = config.getDouble("SRL", 8e-4);
		rootRadius             = config.getDouble("rootRadius", 1e-4);
		RTD                    = config.getDouble("RTD", 5e-2);
		try {
			RGRini             = config.getDouble("RGRini", 0.15);
			SER				   = config.getDouble("SER", 7e-5);	
			FINE_ROOT_CAP_RATIO = config.getDouble("FINE_ROOT_CAP_RATIO", 0.3);
		} catch (Exception e) {
			RGRini = 0.15;
			SER = 7e-5;
			FINE_ROOT_CAP_RATIO = 0.3;
		} 
		
		
		shift          		   = config.getDouble("shift", 80);
		peakDay                = config.getDouble("peakDay", 180);
		endDay  	           = config.getDouble("endDay", 250);
		
		// Context for root-water category
		/** Configuration context for root water-related parameters */
		config.setCategoryContext("root-water");
		RSR                     = config.getDouble("RSR", 2e-05);
		RSR_max                 = config.getDouble("RSR_max", 1e-03);
		eq3_a                   = config.getDouble("eq3_a", 1900);
		eq3_constit             = config.getDouble("eq3_constit", 1);
		eq3_b                   = config.getDouble("eq3_b", 2.07);
		ampliinit               = config.getDouble("ampliinit", 0.4);
		Grmin                   = config.getDouble("Grmin", 3.2);
		Grmax_a                 = config.getDouble("Grmax_a", 0.035);
		Grmax_b                 = config.getDouble("Grmax_b", 12.5);
		Tautranspigr            = config.getDouble("Tautranspigr", 4);
		Taucircadgr             = config.getDouble("Taucircadgr", 0.12);
		TauABAgr                = config.getDouble("TauABAgr", 0.01);
		waterContent            = config.getDouble("WATER_CONTENT", 0.9);
		water_potential_gradient= config.getDouble("water_potential_gradient",0.015); 
		growth_a	 = config.getDouble("growth_a", -3);
		growth_b	 = config.getDouble("growth_b", -0.9);
		
		
		config.setCategoryContext("root-nitrogen");
		/** Clamps for Nm and LMA. */
		Nm_min  = config.getDouble("Nm_min",  0.005);  // 0.5% N
		Nm_max  = config.getDouble("Nm_max",  0.020);  // 6.0% N
		N_resorptionFrac  = config.getDouble("N_resorptionFrac",  0.040);  // 6.0% N

		
		/** Set the context for file name parameters*/
		CategoryStore config_Init = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_INITIAL_CONDITIONS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();
			
		config_Init.setCategoryContext("fineRoot");
		fNSC                   = config_Init.getDouble("fNSC", 0.1);
		structure_C            = 1- fNSC; 
		this.Nm 			   = config_Init.getDouble("Nm",  0.020);  // 2.0% N

		
	}
	

	
	/**
	 * Initializes the FineRoot instance with various parameters based on the 
	 * provided PlantBase object and layer information. Sets up identifiers,
	 * specific parameters to common parameters, and initializes state variables.
	 *
	 * @param layer The layer index where the fine root resides.
	 * @param pb    The PlantBase object containing data relevant to the plant 
	 *              to which this FineRoot instance belongs.
	 */
	void initiate_pb(int layer, PlantBase pb)
	{
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS
		this.plantBaseID = pb.getId();
		plantNumber = pb.plantNumber;
		this.layer = layer;
		border = pb.border;
		this.rbID = pb.rbID;
		cpn = 0;
		order = 0;
		
		this.ageD = 5;
		this.ageTd = this.ageD * (Tmax+Tmin)/2/OPT_TEMP;
		this.ageGdd = Math.max(this.ageD * ((Tmax + Tmin) / 2 - baseT), ageTd);
		
		if (thermalUnit.equals("thermalDay")) {
			this.age = ageD;
		} else if(thermalUnit.equals("growingDegreeDay")) {
			this.age = ageGdd;
		} else if (thermalUnit.equals("day")) {
			this.age = ageD;
		}
		
		
		
		//STATE VARIABLES
		density = SRL; // specific  root length, m per mg
		area = Math.PI * rootRadius*rootRadius;
		
		
		DocumentHybridCategoryNameGroup soilParameters = ((DocumentHybridCategoryNameGroup) CONFIG.getGroup(FILE_NAME_SOIL_PARAMETERS, 
			DocumentHybridCategoryNameGroup.class));

		ParamTable treeModelVariables = soilParameters.getTableStore().getTable("treeModelVariables");

		// Assign default values from layer_1
		fiRootProportion = treeModelVariables.getDouble(ConfigLoader.getTableLayerName(layer), "fiRootProportion", 0.3);	
		
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_INITIAL_CONDITIONS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();
			
		config.setCategoryContext("fineRoot");
			fNSC                   = config.getDouble("fNSC", 0.1);
			structure_C            = 1- fNSC; 
			
		biomass = BIOMASS_ROOT * PERCENT_FINE_ROOT * fiRootProportion; 
		
		//if (printFlag) { println("fine root biomass: " + biomass); }
		
		carbon_total = biomass * this.C_content;
		carbon_structure = carbon_total * this.structure_C;  //mg, amount of structure carbon
		carbon_nonStructure = carbon_total *  this.fNSC;    //mg, amount of starch carbon
		
		//if (printFlag) { println("carbon_structure: " + carbon_structure + "carbon_nonStructure: " + carbon_nonStructure); }
		
		
		length = biomass * SRL; //not used in calculation
		this.diameter = rootRadius;
		
		freshWeight = biomass/(1-waterContent);
		fNSCtoSC = carbon_nonStructure/carbon_structure;
		fNSC = carbon_nonStructure/carbon_total;
		//NITROGEN
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total * (1 - N_CONTENT_MOBILE) -  nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		
		//Initialize few parameters		
		Grmax = Grmax_a * biomass + Grmax_b;		
		Grtranspi  = Grmin;
        
		Psixylmax[0] = -0.05;
		Psixylmin[0] = -ampliinit-0.05;
		ampli[0] = ampliinit;
		GrABA = 0;
        
		//water potential initialize		
		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential + 1e-2;
		this.organType = "FineRoot";
			
	}
	
	
	/**
	 * Initializes a fine root object with rootmeristem node, plant and root data.
	 *
	 * This method assigns biological, physiological, and structural parameters based on the 
	 * provided plant base (`pb`) and root meristem (`rm`). It sets root identifiers, age, 
	 * carbon/nitrogen allocation, water dynamics, and hydraulic properties.
	 *
	 * @param pb The {@link PlantBase} representing the base of the plant.
	 * @param rm The {@link RootMeristem} containing root-specific parameters from the XNode.
	 *
	 * <h2>Initialization Details</h2>
	 * <ul>
	 *   <li><b>Identifiers:</b> Assigns plant number, root layer, and border data.</li>
	 *   <li><b>Age & Growth:</b> Initializes development age and thermal metrics.</li>
	 *   <li><b>Root Geometry:</b> Extracts node ID, length, diameter, and biomass from `rm.N`.</li>
	 *   <li><b>State Variables:</b> Initializes carbon, nitrogen, and water-related properties.</li>
	 *   <li><b>Hydraulic Properties:</b> Sets water potential and hydraulic conductance.</li>
	 * </ul>
	 *
	 * <b>Dependencies:</b> Requires global parameters like `Tmax`, `Tmin`, and constants for carbon, nitrogen, and water dynamics.
	 *
	 * @see PlantBase
	 * @see RootMeristem
	 */
	void initiate_node(PlantBase pb, RootMeristem rm)
	{
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS
		//this assignment does not work well during initiation, thus it needs further assignment checks during updates
		this.plantBaseID = pb.getId();
		
		this.plantNumber = pb.plantNumber;	
		this.border = pb.border;
		this.rbID = pb.rbID;
		cpn = 0;
		order = 0;
		//age
		this.ageD = 5;
		this.ageTd = this.ageD * (Tmax+Tmin)/2/OPT_TEMP;
		this.ageGdd = Math.max(this.ageD * ((Tmax + Tmin) / 2 - baseT), ageTd);
		
		//from the xnode
		this.layer = rm.N.vLayer;
		this.ID = rm.N.id;
		this.length = rm.N.length;
		this.diameter = rm.N.diameter;
		 
		//STATE VARIABLES
		density = RTD*1e6;  //the density was in unit of mg/cm3, so need to times 1e6 to convert into mg/m3
		area = Math.PI * (diameter*diameter/4);
		biomass = Math.max(1, rm.N.fineRootDM); //area * this.length * density;
		fiRootProportion = Math.max(0.001,rm.N.fractionOfFineroot);
		
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_INITIAL_CONDITIONS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();
			
		config.setCategoryContext("fineRoot");
			fNSC                   = config.getDouble("fNSC", 0.1);
			structure_C            = 1- fNSC; 
			
		
			
			
	    carbon_total = biomass * this.C_content;
		
	    
	    carbon_structure = carbon_total * this.structure_C;  //mg, amount of structure carbon
		carbon_nonStructure = carbon_total * this.fNSC;    //mg, amount of starch carbon
		
		if (carbon_total > 0.0) {
			fNSC     = carbon_nonStructure / carbon_total;
			fNSCtoSC = carbon_nonStructure / carbon_structure;
		} else {
			fNSC     = 0.0;
			fNSCtoSC = 0.0;
		}

		freshWeight = biomass/(1-this.waterContent);
		
		
		//println("fNSC: " + this.fNSC + " carbon_nonStructure: " + carbon_nonStructure + " carbon_structure: " + carbon_structure);	
		//NITROGEN
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total * (1 - N_CONTENT_MOBILE) -  nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
	
		//Initialize few parameters
		//needs to check the actual value of the Grmax		
		Grmax = Grmax_b + Grmax_a * biomass;		
		Grtranspi  = Grmin;
                
		Psixylmax[0] = -0.05;
		Psixylmin[0] = -ampliinit-0.05;
		ampli[0] = ampliinit;
		GrABA = 0;
               
		//water potential initialize		
		this.waterPotential_b = rm.N.waterPotential;
		this.waterPotential = inputWaterPotential+1e-2;
		this.organType = "FineRoot";
		

	}

	
	 /**
     * Mainly for the 3D root 
     * Initializes the FineRoot instance with various parameters including 
     * plant identifier, initial length, and diameter.
     *
     * @param pi PlantIdentifier object containing plant metadata.
     * @param length_ Initial length of the fine root.
     * @param diameter_ Initial diameter of the fine root.
     * @return Initialized FineRoot object.
     */
	FineRoot initiate_pi(PlantIdentifier pi, float length_, float diameter_)
	{
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS
		this.pi = pi;
		this.plantNumber = pi.plantNumber;
		this.border = pi[border];
		age = 1;
		this.length = length_;
		this.diameter = diameter_;
		//SPECIFIC PARAMETERS TO COMMON PARAMETERS 
	
		area = Math.PI * (diameter*diameter/4);
		
		//check the density @xiumei
		//STATE VARIABLES
		this.density = RTD*1e6;  //the density was in unit of mg/cm3, so need to times 1e6 to convert into mg/m3
		area = Math.PI * (diameter*diameter/4);
		biomass = area * this.length * density;
		
	    carbon_total = biomass * this.C_content;
		carbon_structure = carbon_total * this.structure_C;  //mg, amount of structure carbon
		carbon_nonStructure = carbon_total * this.fNSC;    //mg, amount of starch carbon
		
		freshWeight = biomass/(1-this.waterContent);
		fNSCtoSC = carbon_nonStructure/carbon_structure;
		fNSC = carbon_nonStructure/carbon_total;
		//NITROGEN
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total * (1 - N_CONTENT_MOBILE) -  nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
	
		//Initialize few parameters
		//needs to check the actual value of the Grmax		
		Grmax = Grmax_b + Grmax_a * biomass;		
		Grtranspi  = Grmin;
                
		Psixylmax[0] = -0.05;
		Psixylmin[0] = -ampliinit-0.05;
		ampli[0] = ampliinit;
		GrABA = 0;
               
		//water potential initialize		
		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential+1e-2;
		this.organType = "FineRoot";
		
		return this;
		
	
	}
