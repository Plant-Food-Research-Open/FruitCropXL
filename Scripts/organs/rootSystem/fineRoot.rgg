/**
 * Represents the FineRoot module, which extends the GrowingOrgan class. 
 * Manages various aspects related to fine roots including water potential, 
 * root hydraulic conductance, ABA effects, and nitrogen uptake.
 *
 */
module FineRoot extends GrowingOrgan {
	
	/***************************************************************************/
	/* this part is for state and other variables*/
	/**************************************************************************/
	/** rootExudation in mg 
	rootExudation is modeled as a soluble carbon flux (mg C step⁻¹) computed from a specific exudation rate (SER; g C g⁻¹ rootDW h⁻¹) 
	applied to fine-root dry mass and scaled by temperature and water stress; 
	*/
	public double rootExudation;
	/** Optional cumulative (mg C) for diagnostics */
	public double rootExudation_cum = 0.0;
	/** Root turnover, in mg. */
	public float rootTurnover;
	public double rootTurnover_cum = 0.0;
	/** Nitrogen uptake. */
	public double Nuptake;
	
	/** Potential exudation (mg C per step), used by CT lineariser */
	double rootExudation_PT = 0.0;

	/** water potential in the previous time step, MPa*/
	double waterPotential_pre;
	/** Root length meter in a certain volume m^3. */
	double lengthPerVolumn;
	/** Resistance from soil to root surface water transfer, in mg-1 MPa s per plant-1). */
	double Rsp;
	/** Water potential at root surface, in MPa. */
	double waterPotentialRootSurface;
	/** Water potential in xylem, in MPa. */
	//double xylemWaterPotential;
	/** Stores the maximum xylem water potential of a day, in MPa. */
	double[] Psixylmax = new double[halt+1];
	/** Stores the minimum xylem water potential of a day. */
	double[] Psixylmin = new double[halt+1];
	/** The fluctuation of xylem water potential, max - min. */
	double[] ampli = new double[halt+1];
	/** FineRoot hydraulic conductance (mg MPa-1 s-1). */
	double Gr;
	/** The effect of ABA on root hydraulic conductance. */
	double GrABA = 0;
	/** Circadian-dependent fraction of root hydraulic conductance. */
	double Grcircad = 0;
	/** Transpiration-dependent fraction of root hydraulic conductance. */
	double Grtranspi = 0;
	/** ABA concentration in xylem (umol m-3). */
	double ABA;
	
	/** Cost of nitrogen uptake. */
	double NuptakeCost;
	/** Half distance between roots. */
	double d;
	/** Root length per plant per surface area, in m m-2. */
	double Lracplante;
	/** Intermediate variable for calculating soil to root resistance based on Lracplante. */
	double radialSoilToRootResistance;
	/** Water potential at the transpiration site. */
	double Psitranspi;
	/** Stomatal conductance as per Tardieu model, in mol m-2 s-1. */
	double gs_tardieu;
	
	/** Trunk biomass. */
	double trunkBiomass;
	/** Proportion of root in the total biomass. */
	double fiRootProportion;
	/** Relative growth rate per hour. */
	double RGR;
	/** The layer in which the root is located. */
	int layer;

    /** ID of the associated Soil object */
	long slID;
	
	protected Soil getSoil() {
		if (slID > 0) {
			return (Soil) graph().getNodeForId(slID);
		}
		return null;
	}
	
	/** ID of the associated RootBase object */
	long rbID;

		protected RootBase getRootBase() {
			if (rbID > 0) {
				return (RootBase) graph().getNodeForId(rbID);
			}
			return null;
		}

		private static boolean isBad(double v) {
			return Double.isNaN(v) || Double.isInfinite(v);
		}

		private static double finiteOr(double v, double fallback) {
			return isBad(v) ? fallback : v;
		}

		private static double positiveOr(double v, double fallback) {
			return (isBad(v) || v <= 0.0) ? fallback : v;
		}

		private static double clampDouble(double v, double lo, double hi) {
			if (isBad(v)) return lo;
			if (v < lo) return lo;
			if (v > hi) return hi;
			return v;
		}

	private StructuralRoot resolveLinkedStructuralRoot() {
		Object parent = getParent();
		if (parent instanceof StructuralRoot) {
			return (StructuralRoot) parent;
		}

		RootBase rb = getRootBase();
		if (rb != null && rb.srIDs != null) {
			for (int i = 0; i < rb.srIDs.length; i++) {
				Object node = graph().getNodeForId(rb.srIDs[i]);
				if (node instanceof StructuralRoot) {
					StructuralRoot sr = (StructuralRoot) node;
					if (sr.plantNumber == this.plantNumber
						&& sr.ID == this.ID
						&& sr.layer == this.layer) {
						this.storeParentId(sr);
						return sr;
					}
				}
			}
		}

		// Legacy fallback for simple-root graphs where FineRoot is still nested below StructuralRoot.
		StructuralRoot parentOrgan = (StructuralRoot) first((* this (<--)+ StructuralRoot*));
		if (parentOrgan != null) {
			this.storeParentId(parentOrgan);
			return parentOrgan;
		}
		return null;
	}
    
			
			
