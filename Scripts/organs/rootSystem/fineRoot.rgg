	/** Add the linked soil*/
	void addSoilArray(Soil s)
	{
		this.slID = s.getId();
		//println("fine root slID: " + this.slID);
	}
	

	/**
	 * Calculates the relative growth rate (RGR) of roots based on the selected growth mode.
	 * Supports both seasonal time-dependent RGR (via beta function) and constant RGR.
	 * Also includes an optional postharvest boost to simulate continued root activity.
	 * @units relative growth rate per hour at the reference temperature 25 degree
	 * to convert with degree day, use RGR per degree day divide /(25-base temperature), 
	 * @param daysSinceWinterSolstice The number of days since the winter solstice.
	 * @return The calculated relative growth rate (RGR).
	 
	 */
	double getRGR(int daysSinceWinterSolstice) {
		final double minGrowthRate = 1e-6;       // Minimum allowed RGR
		final double peakGrowthRate = 0.5;       // Cap for growth rate to avoid runaway values
	
		double baseRGR;
	
		if (rootRGRMode == RGR_MODE_SEASONAL) {
			baseRGR = betaRGR(daysSinceWinterSolstice - shift, peakDay - shift, endDay - shift);
			// --- Post-harvest gate (as before) ---
			double phGate = (daysSinceWinterSolstice >= harvestDAWS && Ta > MIN_TEMP) ? 1.0 : 0.0;
			if (phGate > 0.0) { baseRGR = RGRini; }                  
		} else if (rootRGRMode == RGR_MODE_CONSTANT) {
			baseRGR = RGRini;
		} else {
			throw new IllegalArgumentException("Invalid rootRGRMode: " + rootRGRMode);
		}
	
		
		// Ensure RGR is within bounds
		return Math.max(minGrowthRate, Math.min(peakGrowthRate, baseRGR));
	}

    /**
	 * Calculates the maximum allowable biomass for fine roots based on structural root mass.
	 * This is used to prevent uncontrolled exponential growth when using constant RGR,
	 * by setting a biologically realistic cap on fine root expansion.
	 *
	 * Fine roots are considered ephemeral and highly dynamic, while structural roots (coarse roots)
	 * serve as permanent support and transport tissue. A reasonable upper bound is applied to
	 * maintain physiological balance between fine and structural root systems.
	 * Comas et al. (2002, 2005) – Grapevine root traits	~15–30%	Fine root biomass is a small but variable fraction of total root biomass.
	 * Pagès et al. (2014) – RootTyp model	Model assumes root compartments with upper caps	Fine roots modeled as constrained sinks.
	 * Fahey et al. (1998) – Tree root studies	~20–40% in forest species	Higher in deciduous trees during active growth.
	 * Eissenstat et al. (2000) – Woody plants	~20–30% typical	Suggests functional allocation strategy.
	 * @param structuralRootMass The current dry mass of the structural (coarse) root system [gDM].
	 * @return The maximum allowable fine root dry mass [mgDM].
	 */
	double getMaxFineRootMass() {
		//W_fine: current fine root dry mass [mgDM]
		//W_structural: total structural root biomass [mgDM]
		//FINE_ROOT_CAP_RATIO: e.g., 0.3→ fine roots should not exceed 30% of structural root mass
		double w_max;
		StructuralRoot parent = resolveLinkedStructuralRoot();
		if (parent != null) {
			w_max = parent.biomass * FINE_ROOT_CAP_RATIO;
			// Use Wnr_max as a cap for fine root biomass...
		} else {
			// Handle the case where parent is null
			println("Warning: Fine root has no structural root parent assigned.");
			w_max = this.biomass * 1.05;
		}
		
		return w_max;
	}

	
	/**
	 * Calculates the potential demand for the FineRoot object, including primary and 
	 * structure, maintenance, reserve, and loading. These calculations 
	 * depend on various factors such as carbon concentration, temperature, 
	 * water potential, and other relevant parameters.
	 * The method computes the following demands:
	 * <ul>
	 *   <li>Primary structure demand (structureDM_PRI_PT)</li>
	 *   <li>Secondary structure demand (structureDM_SEC_PT)</li>
	 *   <li>Root turnover (rootTurnover)</li>
	 *   <li>Maintenance respiration (maintenanceDM_PT)</li>
	 *   <li>Reserve synthesis (reserveDM_PT)</li>
	 *   <li>Loading of reserves (loading_PT)</li>
	 * </ul>
	 * 
	 * The calculations are based on the following components:
	 * <ul>
	 *   <li>Temperature response function (for modifying root growth rate based on temperature)</li>
	 *   <li>Water potential response (to model the effect of water stress on root growth)</li>
	 *   <li>Carbon concentration or other relevant parameters affecting growth</li>
	 * </ul>
	 * 
	 * @param cc A float value representing some form of carbon concentration or other relevant 
	 *           parameter that influences root growth.
	 */
	@Override
	void calcPTCTRAM(double sc) 
	{
		
		
		// Convert to hourly growth rate
		RGR = getRGR(daysSinceWinterSolstice) * DT;  // Relative growth rate (RGR) scaled by time step (DT)
	
		// Calculate leakage based on carbon concentration
		calcLeakage(sc);
	
		// Temperature response, scaled by a reference temperature (Tref = 25)
		// Wang and Engel temperature function returns the temperature effect on growth
		double fTemp = wangEngelTempFunction(Ta, MIN_TEMP, OPT_TEMP, MAX_TEMP);
	    //water potential effect
		double fWP = waterPotentialRes(this.waterPotential, growth_a, growth_b);
		// Structure demand for primary root growth, adjusted by temperature and water potential responses
		// getPlantBase().fMb_root: Misbalance factor for adjusting shoot to root ratio based on water flux reduction
		double potentialGrowth = getPlantBase().fMb_root * growthCoff * carbon_structure *
							 RGR * fTemp * fWP;  // already in pure C
		
		double remainingCapacity = Math.max(0, getMaxFineRootMass() - this.biomass)*C_content;
		
		structureDM_PRI_PT = Math.min(potentialGrowth, remainingCapacity);
		
		rootExudation_PT = SER * this.biomass * fTemp * fWP;
		
		// Initialize secondary structure demand (currently set to 0)
		structureDM_SEC_PT = 0;
	
		// Maintenance demand, calculated by respiration rate based on the nitrogen structure to storage ratio
		maintenanceDM_PT = calcMaintanceRespiration(this.fNSCtoSC);
	
		// Reserve demand, calculated through reserve synthesis
		reserveDM_PT = reserveSynthesis();
	
		// Loading demand, based on reserve hydrolysis
		loading_PT = reserveHydrolysis(); 
	}
	
	
	@Override
	void calcLeakage(double sugarConcentration_phloem) 
	{ //leakage only calculates for shoot, leaf is zero
		leakage = 0;
	}	

	/**
	 * Calculates the amount of carbon loaded into the FineRoot based on phloem 
	 * carbon concentration and other root properties.
	 *
	 * @param sugarConcentration_phloem The carbon concentration in the phloem.
	 */
	 @Override
	void calcLoading(double sugarConcentration_phloem)
	{
		loading =  fNSC > MINIMUM_NSC ? reserveHydrolysis() * 
				   sourceLoading(sugarConcentration_phloem, sourceLoading_b, sourceLoading_cp) : 1e-6;
	    //if (printFlag) { println("this is loading from internode " + "node " + nodeNumber + " rank "+ this.rank + " loading " + loading); }
	} 
	/**
	 * Calculates carbon unloading from the FineRoot.
	 *
	 * <p>Primary structural growth uses a dominant-limiter rule for coupled water/carbon stress:
	 * the water response ({@code fw}) and phloem sink-unloading response ({@code fc}) are
	 * evaluated separately and combined as {@code min(fw, fc)} for the primary-growth demand term.
	 *
	 * <p>Reserve synthesis/hydrolysis, maintenance, and root exudation keep their existing
	 * formulations (including their original use of water and carbon response factors).
	 *
	 * @param sugarConcentration_phloem The carbon concentration in the phloem.
	 */
	@Override
	void calcUnloading(double sugarConcentration_phloem)
	{        
		RGR = getRGR(daysSinceWinterSolstice) * DT;
		
		double fTemp = wangEngelTempFunction(Ta, MIN_TEMP, OPT_TEMP, MAX_TEMP);
		  // Water potential effect used in multiple root flux terms. We keep the raw term (fWP)
		  // for exudation below, and use a clamped copy (fw_pri) for the primary-growth limiter.
		double fWP = waterPotentialRes(this.waterPotential, growth_a, growth_b);
		double fw_pri = fWP;
		if (Double.isNaN(fw_pri) || Double.isInfinite(fw_pri)) fw_pri = 1.0;
		if (fw_pri < 0.0) fw_pri = 0.0;
		if (fw_pri > 1.0) fw_pri = 1.0;
		double fc_pri = sinkUnloading(sugarConcentration_phloem, km_pri);
		if (Double.isNaN(fc_pri) || Double.isInfinite(fc_pri)) fc_pri = 0.0;
		if (fc_pri < 0.0) fc_pri = 0.0;
		if (fc_pri > 1.0) fc_pri = 1.0;
		if (shouldUsePreT1PotentialGrowth()) {
			fc_pri = 1.0;
		}
		double stress_pri = (fw_pri < fc_pri) ? fw_pri : fc_pri;
		
		//getPlantBase().fMb_root is the misbalance factor for adjusting shoot root ratio
		double potentialGrowth = carbon_structure * RGR  
								 * growthCoff     
								 * fTemp 
								 * stress_pri 
								 * getPlantBase().fMb_root
								 ;
	   	
		
		double remainingCapacity = Math.max(0, getMaxFineRootMass() - this.biomass)*C_content;
		
		structureDM_PRI = Math.min(potentialGrowth, remainingCapacity);
		
		rootExudation = SER * this.biomass * fTemp * fWP 
						* sinkUnloading(sugarConcentration_phloem, km_res);
		
		
	    maintenanceDM = calcMaintanceRespiration(this.fNSCtoSC) * 
         				sinkUnloading(sugarConcentration_phloem, KM_MTNCE);
        reserveDM = reserveSynthesis() * 
					sinkUnloading(sugarConcentration_phloem, km_res);	

		structureDM_SEC = 0;  

		structureDM = structureDM_PRI + structureDM_SEC;
		
		unloading = structureDM + maintenanceDM + reserveDM + rootExudation;			
	}
	
	/**
	 * Calculates the root length per volume based on biomass and density.
	 *
	 * @return The calculated length per volume.
	 */
	void calcRootLengthPerVolumn()	
	{
	  float totalRootLength = biomass * density; 			// total root length, meter, SRL meter/mg
	  lengthPerVolumn = totalRootLength / getSoil().volume;     // root length per volume, m m-3
	  
	  //for scaling the soil to root resistance based on radialSoilToRootResistance
	  d = pow(PI * lengthPerVolumn,-0.5);       // d : half distance between roots
	  Lracplante = lengthPerVolumn * getSoil().length;      //Lracplante : root length per plant, total root length per column, or per layer/grid      
	  radialSoilToRootResistance = 0.5 * log(d*d/(rootRadius*rootRadius))/(4 * PI/100* Lracplante);
	  //println("radialSoilToRootResistance:" + radialSoilToRootResistance);
	}
	
	/**
	 * Calculates the resistance from soil to root surface for water transfer.
	 * the soil to root resistance are hard to measure, from the previous work on one soil layer
	 * we have obtained one emperical specific radialSoilToRootResistance(RSR) for grapevine under field conditions
	 * RSR can be considered as the resistance under saturated soil. We use the ratio between actual and Ks to scale the calculation, 
	 * and avoid the sharp decrease in ks under water stress 
	 * Study/System	Rsp Range Inferred	Water Flux	ΔΨ Soil–Root
	 * Grape (Hochberg et al.)	~0.0005–0.001	200–500 mg/s	0.2–0.5 MPa
	 * Apple (Lakso et al.)	~0.0005–0.002	300–600 mg/s	0.2–1.2 MPa
	 * Kiwifruit (Minchin et al.)	0.0003–0.0012	150–400 mg/s	0.1–0.5 MPa
	 * for capturing the difference in root length density between soil layers, we thus created added the 
	 * relativeRadialResistance, which will scale up or down the RSR  
	 * @param relativeRadialResistance, relative_RSR, 
	 * The relative density of the root calculated in the root system module.
	 * @return The calculated resistance for soil-to-root water transfer.
	 * Gardner's formula from 1962, Lracplante replaces La in the denominator (expressed per plant).
	 * Rsp is in
	  # m-3 MPa s per plant, if K is in m2 MPa-1 s-1. The whole is divided by 10^6 to 
	  * mg-1 MPa s per plant-1,
	 * scale the Rsp with saturated soil hydraulic conductivity as the original soil parameters are
	 * with pot soil and hypothetical Ks = 1. 
	 * For actual soil type, the Ks_soil is much smaller than 1.
	 * KSoil, saturated one, m2 MPa-1 s-1, range from 1 to 1e-4
	 
	 */
		void calcRspSoilToRoot(double relative_RSR)
		{
			Soil soil = getSoil();
			if (soil == null) {
				Rsp = RSR_max;
				return;
			}
		   //to avoid dramatic decrease in Ks and unrealistic increase in Rsp, constrain it to 1000 times of input RSR
			double rel = positiveOr(relative_RSR, 1.0);
			double ksoil = positiveOr(soil.Ksoil, soil.Ks_soil);
			double kRatio = positiveOr(soil.Ks_soil / ksoil, 1.0);
			Rsp = Math.min(RSR * rel * kRatio / 1e6, RSR_max);
			if (isBad(Rsp) || Rsp <= 0.0) Rsp = RSR_max;
	   //original equation is hard to use under field conditions
	   //double Rsp_cal = 0.5 * log(d*d/(rootRadius*rootRadius))/(4 * PI * getSoil().Ksoil / 100 * Lracplante)/1e6;
	   /* println("getSoil().Ks_soil:" + getSoil().Ks_soil + "getSoil().Ksoil"  + getSoil().Ksoil +
	   " rsp: " + Rsp + " RSR: " + RSR + " getSoil().Ks-ratio: " + getSoil().Ks_soil/getSoil().Ksoil/1e6); */
	   
	}
	
	/**
	 * Calculates the water uptake based on conductance and water potential gradient
	 *
	 * @return The calculated length per volume.
	 */
	double calcWaterUptake() {
		/** 
		 * Adds a water potential gradient constraint using the local water potential.
		 * Prevents a positive feedback loop that could lead to excessive water uptake.
		 * Includes a water stress factor and ensures water uptake is always non-negative.
		 */
	
			Soil soil = getSoil();
			if (soil == null) return 0.0;
			double waterUptake;
			double localWaterPotential = finiteOr(soil.waterPotential, inputWaterPotential);
			double alpha = 0;
			if (isBad(waterPotential_pre)) {
				RootBase rb = getRootBase();
				waterPotential_pre = (rb != null && !isBad(rb.weightedMeanWaterPotential))
					? rb.weightedMeanWaterPotential
					: localWaterPotential - 1e-8;
			}
			if(waterPotential_pre >= localWaterPotential) {waterPotential_pre = localWaterPotential - 1e-8;}
			double safeRsp = positiveOr(Rsp, RSR_max);
			double safeGrmax = positiveOr(Grmax, Math.max(Grmin, 1e-12));
			// Check if local water potential creates a feedback loop
			if (localWaterPotential > soil.h2) {
				RootBase rb = getRootBase();
				alpha = (rb != null) ? rb.calcAlpha(localWaterPotential, soil.h1, soil.h2, soil.h3, soil.h4) : 0.0;
				waterUptake = alpha * (safeGrmax + 1 / safeRsp) * (localWaterPotential - waterPotential_pre);
			} else {
				//I am updating the water potential of individual grids now, so can use root waterPotential_pre to do the calculation.
				//double constrainedPotential = Math.max(getRootBase().meanWaterPotential - water_potential_gradient * totalSoilDepth / 2, this.waterPotential);
				waterUptake = (safeGrmax + 1 / safeRsp) * (localWaterPotential - waterPotential_pre);
			
			}

			// Ensure no NaN values and constrain the result to be non-negative
			if (isBad(waterUptake)) {
				println("warning invalid water uptake of layer" + soil.layer);
				waterUptake = 0;
			}
			if (debug && printFlag) {
				println("[RootFluxRaw]"
					+ " step=" + step
					+ " grid=" + ID
					+ " layer=" + layer
					+ " soilPsi=" + localWaterPotential
					+ " waterPotential_pre=" + waterPotential_pre
					+ " deltaPsi=" + (localWaterPotential - waterPotential_pre)
					+ " Grmax=" + safeGrmax
					+ " Rsp=" + safeRsp
					+ " biomass=" + biomass
					+ " fiRootProportion=" + fiRootProportion
					+ " WUF=" + Math.max(0, waterUptake));
			}
			return Math.max(0, waterUptake);
		}

	
	
	/**
	 * Calculates the amplitude of xylem water potential fluctuations.
	 * Updates the maximum and minimum xylem water potential for the day.
	 *
	 * @return The calculated amplitude.
	 */
		void calcAmpli() {
			int d = day;
			if (d < 0) d = 0;
			if (d >= ampli.length) d = ampli.length - 1;
			double wp = finiteOr(waterPotential, inputWaterPotential);
			Psixylmax[d] = finiteOr(Psixylmax[d], wp);
			Psixylmin[d] = finiteOr(Psixylmin[d], wp);
			Psixylmax[d] = max(Psixylmax[d], wp);
			Psixylmin[d] = min(Psixylmin[d], wp);
			double a = Psixylmax[d] - Psixylmin[d];
			if(d > 1) {
				int p = d - 2;
				double prevMax = finiteOr(Psixylmax[p], Psixylmax[d]);
				double prevMin = finiteOr(Psixylmin[p], Psixylmin[d]);
				a = prevMax - prevMin;
			}
			if (isBad(a) || a < 0.0) a = 0.0;
			ampli[d] = a;
		}
	
	/**
	 * Calculates the water potential at the root surface based on water flux and soil properties.
	 *
	 * @param waterFlux The rate of water flow through the root.
	 * @return Calculated water potential at the root surface.
	 */
	void calcPsir(double waterFlux) {
	 	/* if (printFlag) { println("getSoil().waterPotential" + getSoil().waterPotential); }
		if (printFlag) { println("Rsp: " + Rsp); } 
		if (printFlag) { println("Rsp * waterFlux: " + Rsp * waterFlux); }  */
	    waterPotentialRootSurface = getSoil().waterPotential - Rsp * waterFlux;
	  
	 }
	
	/**
	 * Calculates the Abscisic acid (ABA) concentration in the root based on water flux and other parameters.
	 *
	 * @param waterFlux The rate of water flow through the root.
	 * @return Calculated ABA concentration.
	 */
	void calcABA(double waterFlux, double fiRootProportion) {
	 //this ABA function was fitted based on pot experiment where a plant has a small leaf area and water flux
	 //when scaling up water flux increased a lot, but other parts of this equation stay the same, so dilution effect
	 //fitting condition leaf area = 0.12 m2, assuming plant produce ABA in proportion to their root biomass,
	 //assume leaf has similar ABA concentration under cetain water potential
	
		 PlantBase pb = getPlantBase();
		 double leafArea = (pb != null) ? positiveOr(pb.leafArea, 0.12) : 0.12;
		 double sunFraction = (pb != null) ? finiteOr(pb.sunExposedLeafFraction, 1.0) : 1.0;
		 if (sunFraction <= 0.0) sunFraction = 1.0;
		 double safeRootProp = Math.max(positiveOr(fiRootProportion, 1e-6), 1e-6);
		 double normalizedWaterFlux = finiteOr(waterFlux, 0.0) / leafArea *
									  max(0.12, 0.12/(max(0.1, sunFraction * safeRootProp)));  //did not account the self-shading
		 if(isBad(normalizedWaterFlux) || normalizedWaterFlux < 0.0) {normalizedWaterFlux = 0.1;}
 	 
		 double denom = normalizedWaterFlux + eq3_b;
		 if (isBad(denom) || Math.abs(denom) < 1e-9) denom = 1e-9;
		 ABA = (eq3_constit + (-eq3_a * finiteOr(waterPotentialRootSurface, inputWaterPotential))/denom);
	
	  // Check for NaN in ABA calculation
	  if(debug && step > 1) {
	  	checkForNaN(printFlag, // Assuming printFlag is already defined
        //checkForNaN(true, // Assuming printFlag is already defined
            "waterFlux", waterFlux,
            "getPlantBase().leafArea",getPlantBase().leafArea,
        	"normalizedWaterFlux", normalizedWaterFlux,
        	"sunExposedLeafFraction",getPlantBase().sunExposedLeafFraction,
            "ABA", ABA,
            "fiRootProportion", fiRootProportion,
            "waterPotentialRootSurface", waterPotentialRootSurface
/*             "eq3_constit", eq3_constit,
            "eq3_a", eq3_a,
            "eq3_b", eq3_b */
            // Add other relevant variables here
        );
      }
      
      // Check if ABA value is NaN and print a warning
			if (isBad(ABA) || ABA <= 0.0) {
				println("Warning: ABA value is invalid!");
				println("Setting to a default value");
				ABA = 20.0;
			}

      
      
    
	}
	
	/**
	 * Calculates the root's hydraulic conductance considering various factors like circadian rhythm, ABA effects, etc.
	 *
	 * @param waterFlux The rate of water flow through the root.
	 */
	void calcRootConductance(double waterFlux) {
	   //Hydraulic Conductances
	  //in Gxcircad calculation, 2 days are taken into account
		  int d = day;
		  if (d < 0) d = 0;
		  if (d >= ampli.length) d = ampli.length - 1;
		  double safeAmp = Math.max(0.0, finiteOr(ampli[d], 0.0));
		  double safeRootProp = Math.max(positiveOr(fiRootProportion, 1e-6), 1e-6);
		  Grcircad = (cos((hourOfDay - sunriseTime) * PI / 12) * safeAmp) * Taucircadgr * safeRootProp;
		  if (isBad(Grcircad)) Grcircad = 0.0;
		  // conductances depending on transpiration
		  //this already scaled with water flux so no need to scale with biomass again
		  //for others linked with root size needs to scale with biomass
		  double safeGrmax = Math.max(positiveOr(Grmax, Math.max(Grmin, 1e-12)), Math.max(Grmin, 1e-12));
		  double safeGrmin = Math.max(positiveOr(Grmin, 1e-12), 1e-12);
		  Grtranspi =  clampDouble(Tautranspigr * finiteOr(waterFlux, 0.0), safeGrmin, safeGrmax);
	  
		  //ABA effect
		  double safeABA = positiveOr(ABA, 20.0);
		  GrABA = clampDouble(TauABAgr * log(safeABA / 20.0) * safeRootProp, -0.95, 10.0);
		  // Conductances
		  double baseGr = safeGrmin + Grcircad + Grtranspi;
		  if (isBad(baseGr) || baseGr <= 0.0) baseGr = safeGrmin;
		  double multiplier = Math.max(0.05, 1.0 + GrABA);
		  Gr = clampDouble(baseGr * multiplier, safeGrmin, safeGrmax);
	  
		 //if (printFlag) { println("root conductance " + Gr); }
	  
		  if (isBad(Gr) || Gr <= 0.0) {
				println("Warning: Gr is NaN. " +
				" Grcircad:" + Grcircad + " Grtranspi " + Grtranspi +
				" GrABA " + GrABA);
				Gr = safeGrmin;
			}
		
		Ka = Gr;
	  //if (printFlag) { println("root conductance " + Gr + " maximum root conductance " + Grmax +  " minimum root conductance " + Grmin ); }
	   
	 }
	
	/**
	 * Calculates the xylem water potential without considering Jxc (water flow between mature tissues and bundle sheaths).
	 *
	 * @param waterFlux The rate of water flow through the root.
	 * @return Calculated xylem water potential.
	 */
	void calcPsixyl_without_Jxc(double waterFlux) {	
		//if (printFlag) { println(waterPotentialRootSurface); }
		this.waterPotential = Math.max(-3.5, waterPotentialRootSurface -  waterFlux/Gr);
		
		// Test for NaN
		if (Double.isNaN(waterPotential) && step > 1) {
			println("Warning: xylemWaterPotential is NaN." + 
			"waterPotentialRootSurface:" + waterPotentialRootSurface + " waterFlux " + waterFlux +
			" Gr " + Gr);
		}
		if(debug) {
		 checkForNaN(printFlag, // Assuming printFlag is already defined
            "getSoil().waterPotential", getSoil().waterPotential,
            "Rsp", Rsp,
		 	"waterFlux", waterFlux,
		 	"Rsp * waterFlux", Rsp * waterFlux,
            "waterPotentialRootSurface", waterPotentialRootSurface,
            "Gr ", Gr,
            "Grmax", Grmax,
            "this.wp", waterPotential
        ); 
       }
	}
	
/**
 * Calculates the nitrogen effect factor (0–1) that down-regulates
 * organ nitrogen uptake and assimilation based on the mobile
 * nitrogen pool relative to plant storage capacity.
 *
 * <p><b>Conceptual basis:</b>
 * <ul>
 *   <li><b>NEMA model:</b> Uses an exponential suppression
 *       (exp(–β * mobileNContent)) to represent how increasing
 *       mobile N reduces the marginal benefit of additional N uptake.</li>
 *   <li><b>QualiTree model:</b> Originally used the structural living
 *       dry mass as a proxy for N demand and capacity.</li>
 *   <li><b>This implementation:</b> Replaces structural mass with
 *       {@code carbon_nonStructure_max} (the maximum reserve pool size)
 *       as the denominator when computing {@code mobileNContent}.
 *       This directly links N capacity to the plant’s storage
 *       potential, avoiding the need to recalculate living biomass
 *       fractions for each organ.</li>
 * </ul>
 *
 * <p><b>Returns:</b>
 * <ul>
 *   <li>{@code 0} if the plant has no mobile nitrogen available.</li>
 *   <li>An exponentially declining function of mobile nitrogen
 *       otherwise, bounded between 0 and 1.</li>
 * </ul>
 *
 * <p><b>References:</b>
 * <ul>
 *   <li>Lacointe (2000): Carbon allocation among tree organs: a review of basic processes and representation in functional–structural tree models. Annals of Forest Science,
 * 57:521–533. Discusses C–N feedback and storage regulation.</li>
 *   <li>Da Silva et al. (2011, Annals of Botany) – nitrogen allocation in QualiTree.</li>
 *   <li>NEMA: nitrogen effect module in FSPM literature.</li>
 * </ul>
 *
 * @return suppression factor (0–1) for nitrogen effect
 */

	double calcNeffect()
	{
	
	 if (getPlantBase().totalNitrogen <=0)
	{
		return 0;
	} else
		{
		return exp(-1 * beta_Neffect * getPlantBase().calcNCRatio());	
		/* println(" getPlantBase().mobileNContent: " +  getPlantBase().mobileNContent + 
		"  " + exp(-1 * beta_Neffect * getPlantBase().mobileNContent)); */
		}
	}
	/**
	 * Calculates the effect of carbon content on some root C unloading.
	 *
	 * @return Calculated carbon effect.
	 */
	double calcCeffect() {
		if (fNSCtoSC <= 1e-3) {
			return 0.0;
		}
	
		PlantBase pb = getPlantBase();
		if (pb == null) {
			return 0.0; // no plant context available
		}
	
		double sc = pb.sugarConcentration_phloem;
		if (Double.isNaN(sc) || Double.isInfinite(sc) || sc <= 0.0) {
			return 1e-6; // invalid sugar concentration
		}
	
		return sinkUnloading(sc, km_pri);
	}

/**
 * Calculates nitrogen uptake by roots based on soil N availability, 
 * plant demand (C and N effects), and environmental drivers.
 *
 * <p><b>Units:</b> mg N h⁻¹ (per root system)</p>
 *
 * <p>Biological background: Root N uptake is driven by soil soluble 
 * nitrogen concentration (Nsoil) and down-regulated by both 
 * carbon availability (Ceffect) and nitrogen feedback (Neffect). 
 * The uptake kinetics combine a Michaelis–Menten term for 
 * low-affinity transporters (LATS) with a linear term for high-affinity 
 * transporters (HATS).</p>
 *
 * <p>Key features:</p>
 * <ul>
 *   <li>If Nsoil ≤ 0, uptake is set to 0.</li>
 *   <li>If non-structural carbon is insufficient to pay for uptake cost 
 *       ({@code carbon_nonStructure > NuptakeCost}), uptake is suppressed.</li>
 *   <li>Daily uptake is scaled by thermal time increment ({@code deltaT}) 
 *       converted to hours via {@code DT}.</li>
 *   <li>Carbon cost of uptake is calculated separately for NH₄⁺ and NO₃⁻ 
 *       fractions using {@code CARBON_COST_NH4} and {@code CARBON_COST_NO3}.</li>
 * </ul>
 *
 * @return nitrogen uptake rate (mg N h⁻¹)
 */
 	void calcNitrogenUptake()
	{
		double Nsoil = getSoil().NsolubleConc; //g·L⁻¹
		double deltaT = Ta > 0 ? Ta * DT : 0; //in degree day
		
		if(Nsoil > 0) {
			Nuptake = carbon_nonStructure > NuptakeCost ? 
					  carbon_structure * 
					  calcNeffect() * 
					  calcCeffect() * 
					  ((Umax * Nsoil)/(kRootLats + Nsoil) +(kRootHats * Nsoil)) * 
					  deltaT : 0;
			NuptakeCost = Nuptake * getSoil().FRACTION_NH4 * CARBON_COST_NH4 + Nuptake * getSoil().FRACTION_NO3 * CARBON_COST_NO3;
		} else {
			Nuptake = NuptakeCost = 0; 
		}
		
		//if (printFlag) { println("deltaT "  + deltaT + "Neffect " + calcNeffect() + "Ceffect " + calcCeffect() + "Nuptake " + Nuptake); }
		
	}
	
	/**
	 * Computes fine-root structural turnover (mortality) as a non-phloem loss.
	 * <p>
	 * Turnover increases with temperature using a Q10 formulation and with drought
	 * via an inverse water-potential response. The result is written to
	 * {@code rootTurnover} (units: g C per time step), which should be
	 * subtracted from {@code carbon_structure} during the state update
	 * (i.e., turnover is <b>not</b> a phloem demand and must <b>not</b> be
	 * included in {@code unloading}). Any salvage/retranslocation of C
	 * should be handled elsewhere.
	 * </p>
	 *
	 * <h4>Formulation</h4>
	 * <ul>
	 *   <li>Temperature multiplier (monotonic): {@code fTempMort = Q10MN^((Ta - REFTMP)/10)}</li>
	 *   <li>Water multiplier (drought increases turnover): {@code fWP = waterPotentialRes(...)} in [0..1],
	 *       {@code dryMult = 1 + (1 - fWP)}</li>
	 *   <li>Base per-step turnover: {@code carbon_structure * ROOT_TURNOVER}</li>
	 *   <li>Final: {@code rootTurnover = base * fTempMort * dryMult}</li>
	 * </ul>
	 *
	 * <h4>Assumptions & Notes</h4>
	 * <ul>
	 *   <li>{@code ROOT_TURNOVER} is a per-step rate on the carbon (C) pool.</li>
	 *   <li>{@code waterPotentialRes} returns higher values when water status is favorable; we invert it to
	 *       increase mortality under drought.</li>
	 *   <li>Do <b>not</b> gate turnover with {@code sinkUnloading}; turnover removes existing structure.</li>
	 *   <li>Apply any salvage-to-NSC and routing to soil rhizodeposition in the state update.</li>
	 *   <li>Numeric safety: ensure {@code Ta}, {@code REFTMP}, {@code Q10MN} are finite; optionally clamp
	 *       {@code fWP} into [0,1].</li>
	 * </ul>
	 *
	 * @implNote This method updates {@code rootTurnover} only; it does not mutate pools.
	 *           Subtract {@code rootTurnover} from {@code carbon_structure} after allocation.
   */
	void calcTurnOver() {
		// Temperature effect (monotonic with Q10)
		float tempDiff   = Ta - REFTMP;
		float fTempMort  = (float) Math.pow(Q10MN, tempDiff / 10f);
	
		// Water effect (increase turnover as water potential worsens)
		double fWP       = waterPotentialRes(this.waterPotential, growth_a, growth_b); // 0..1
		double dryMult   = 1.0 + (1.0 - fWP);  // 1 (wet) .. 2 (very dry)
	
		// Base per-step turnover on structural carbon (no phloem gating)
		double baseTurnover = carbon_structure * ROOT_TURNOVER;
	
		// Final turnover (g C per step)
		rootTurnover = baseTurnover * fTempMort * dryMult;
	}

	@Override
	double getExudationPT() { return rootExudation_PT; } // mg C per step

		
	/**
	 * Updates the root's state variables like carbon structure, carbon non-structure,
	 * biomass, fresh weight, and other related parameters.
	 * <p>
	 * This method performs various calculations to update the root's characteristics
	 * like carbon structure, carbon non-structure, and biomass. It also computes the
	 * fresh weight and adjusts the carbon-to-structure ratio.
	 * </p>
	 * <p>
	 * The method is designed to be overridden by subclasses, allowing different types
	 * of roots to update their state in a specific way.
	 * </p>
	 */
	@Override
	void update()
	{
		super.update();
		km_res = adjustKmResSeasonally(daysSinceWinterSolstice, km_res_early, km_res_late);
		calcTurnOver();
		waterPotential_pre = this.waterPotential;
		if(plantBaseID <= 0) {
			PlantBase pb = first((* this (<--)+ PlantBase*));
			if(pb != null) {
				this.plantBaseID = pb.getId();
			}
		}
        
		if (this.rbID <= 0) {
			RootBase r = first((* this (<--)+ RootBase*));
			if (r != null) {
				this.rbID = r.getId();
			}
		}

	        // Keep the explicit fine-root -> structural-root graph-id link warm.
			resolveLinkedStructuralRoot();
		
		
		//	unloading = structureDM + maintenanceDM + reserveDM;
		biomass_pre = biomass; 
		 
		/** update organ carbon and nitrogen status */
		if(organGrowthMethod.equals("TempLimited")) {
			biomass = getPlantBase().biomassLeaf * 1.5 * getPlantBase().SR; //1.5 is an estimation of leaf in the new shoot biomass 
			this.initCN_content(this.biomass);
		} else {
			delta_str = structureDM - growthCost - rootTurnover; 
			delta_NSC = maintenanceDM + reserveDM + leakage 
						   - loading - carbonMobilizationCost - maintenanceDM_PT; 
			updateCarbonStatus(delta_str, delta_NSC);
		
			if(Double.isNaN(this.biomass)) {
				this.initCN_content(this.biomass_pre);
			}
		}
		
		length = biomass * SRL;
		
		//not used just for update
		if(diameter == 0) diameter = 1e-4;
		this.potLength = length; 
		 // optional: accumulate diagnostics
		 rootExudation_cum += Math.max(0.0, rootExudation);
		 rootTurnover_cum += Math.max(0.0, rootTurnover);
		//calcNdegradation();
		//calcNSynthesis(); 
		////nitrogen_total = nitrogen_structure + nitrogen_nonStructure;
	}
} ==> 
