	/**
	 * Initializes the root system object with various plant identifiers.
	 * 
	 * <p>
	 * This method initializes the {@code RootSystem} object with different 
	 * plant identifiers such as plant number, border, strip, row, position, 
	 * and species. It also initializes various arrays and variables that 
	 * will be used for different calculations later on.
	 * </p>
	 *
	 * @param pi The PlantIdentifier object containing various identifiers for the plant.
	 * @see PlantIdentifier
	 */
	void initiate_pb(PlantBase pb, int gridNumber)
	{
		//IDENTIFIERS
		this.pi = pb;
		this.plantNumber = pb.plantNumber;
		println("this.plantNumber" + this.plantNumber);
		this.border = pb[border];
				
		this.strip = pb.strip;
		this.row = pb.row;
		this.pos = pb.pos;
		this.species = pb.species;
		this.length = 0;
		
	 // Initialize arrays using gridNumber
		plantBaseID = pb.nodeID;
		int size = gridNumber + 1;
		println("size: " + size + " gridNumber: " + gridNumber );
		this.gridIndex = new int[size];
		
		this.frIDs = new long[size];
		this.srIDs = new long[size];
		this.slIDs = new long[size];
		//clear the following arrays after initiation
		sl  = new Soil[size];
        frs = new FineRoot[size];
        srs = new StructuralRoot[size];
        
        
		this.fiRootProportion = new double[size];
		this.f_flux = new double[size];
		this.waterUptake_mm = new double[size];
		this.relative_RSR = new double[size];
		this.WUF = new double[size];
		this.availalbeWater = new double[size];
		this.nitrogenUptake_mgm2 = new double[size];
		
		this.fineRootExudation_mg = new double[size];
		this.fineRootTurnover_mg = new double[size];
		this.fineRootExudation_cum_mg = new double[size];
		this.fineRootTurnover_cum_mg = new double[size];
		this.fineRootExudation_total_mg = 0.0;
		this.fineRootTurnover_total_mg = 0.0;
		this.fineRootExudation_total_cum_mg = 0.0;
		this.fineRootTurnover_total_cum_mg = 0.0;
		
		
		//this.k_a = numofSoilLayers > 1 ? (double) 1.0/(numofSoilLayers-1) : 1.0;
		//Arrays.fill(ones, 1.0);	
		    // Fill relative_RSR safely
		double fill;
		if (numofSoilLayers > 1 && size > 1) {
			fill = 1.0 / (size - 1);
		} else if (size > 0) {
			fill = 1.0;
		} else {
			fill = 0.0;
		}
		java.util.Arrays.fill(relative_RSR, fill);
		
		 

        pb.addRootBase(this);
		println("pb id: " + pb.getId() + " rb id: " + this.getId());
	}
/**
 * Adds a single Soil–Root layer entry.
 *
 * @param fid XEG node id of the grid cell (r2.N.id)
 * @param s   Soil object
 * @param fr  FineRoot object
 * @param sr  StructuralRoot object
 */
void addChildSoilRoot(int fid, Soil s, FineRoot fr, StructuralRoot sr) {
    // We expect fid in 1..gridNumber; slot 0 is unused.
    if (fid < 0 || fid >= sl.length) {
        println("Warning addChildSoilRoot: fid=" + fid
                + " is out of bounds for arrays of length " + sl.length
                + " (plant " + this.plantNumber + ")");
        return; // do not crash the simulation
    }

    // Detect duplicates (same grid cell matched multiple times) and preserve
    // the first linked voxel so later accidental matches do not orphan it.
    if (sl[fid] != null || frs[fid] != null || srs[fid] != null) {
        println("[RootSoilGrid:duplicate] fid=" + fid
                + " plant=" + this.plantNumber
                + " existingSoilId=" + (sl[fid] == null ? -1 : sl[fid].getId())
                + " existingFineRootId=" + (frs[fid] == null ? -1 : frs[fid].getId())
                + " existingStructuralRootId=" + (srs[fid] == null ? -1 : srs[fid].getId())
                + " newSoilId=" + (s == null ? -1 : s.getId())
                + " newFineRootId=" + (fr == null ? -1 : fr.getId())
                + " newStructuralRootId=" + (sr == null ? -1 : sr.getId()));
        return;
    }

    if (fr != null) {
        fr.nodeID = fr.getId();
        fr.rbID = this.getId();
        if (s != null) {
            fr.addSoilArray(s);
        }
    }
    if (sr != null) {
        sr.nodeID = sr.getId();
    }
    if (fr != null && sr != null) {
        fr.storeParentId(sr);
        sr.addFineRoot(fr);
    }

    // Store references in the slot indexed by fid
    sl[fid]  = s;
    frs[fid] = fr;
    srs[fid] = sr;

    // Bookkeeping: remember which XEG grid this slot corresponds to
    gridIndex[fid] = fid;

    // Root traits
    if (fr != null) {
        fiRootProportion[fid] = fr.fiRootProportion;
        this.Tautranspigr     = fr.Tautranspigr;
    }

    
}

	
	/**
	 * Finalizes the organ IDs and removes the object references to avoid duplication
	 * or memory conflicts in the scene graph (recommended to call at step 1 or 2).
	 */
	void finalizeSoilRootIDs() {
		int len = Math.max(sl.length, Math.max(frs.length, srs.length));
	
		for (int i = 0; i < len; i++) {
			// Temporarily hold references
			Soil s = (sl != null && i < sl.length) ? sl[i] : null;
			FineRoot fr = (frs != null && i < frs.length) ? frs[i] : null;
			StructuralRoot sr = (srs != null && i < srs.length) ? srs[i] : null;
	
			// Assign IDs and clear references
			if (s != null) {
				slIDs[i] = s.getId();
				sl[i] = null;
			}
			if (fr != null) {
				frIDs[i] = fr.getId();
				frs[i] = null;
			}
			if (sr != null) {
				srIDs[i] = sr.getId();
				srs[i] = null;
			}
	
			// Logical linkage after assignment
			if (s != null && fr != null) {
				fr.addSoilArray(s);
				fr.rbID = this.getId();
			}
			if (sr != null && fr != null) {
				sr.addFineRoot(fr);
			}
		}
		if (printFlag) {
			println("Finalized root system IDs and linked components (length = " + len + ").");
		}
	}

	
