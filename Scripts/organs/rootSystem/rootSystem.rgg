    public double phloemSugarConcentration;

    /** Plant water flux for water and growth calculations. */
    public double plantWaterFlux;

    /** Mean soil water potential, used by the shoot branching algorithm. */
    public double meanSoilWaterPotential = -0.1;

    /** Mean water potential of all the roots. 
    used for comparing water potential gradient within the root system*/
    double meanWaterPotential;
    
    /** weighted water potential of the root by water flux. */
