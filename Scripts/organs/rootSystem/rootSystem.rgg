	/**
	 * Retrieves the FineRoot object at the specified soil layer index.
	 *
	 * @param i The index of the soil layer.
	 * @return The FineRoot object at the given index, or null if the ID is invalid or out of bounds.
	 */
	protected FineRoot getFineRootAt(int i) {
		if (frIDs != null && i >= 0 && i < frIDs.length) {
			return getFineRootById(frIDs[i]);
		}
		return null;
	}

	/**
	 * Retrieves the FineRoot object corresponding to the given node ID.
	 *
	 * @param id The node ID of the FineRoot.
	 * @return The FineRoot object, or null if the ID is invalid or the node is not a FineRoot.
	 */
	protected FineRoot getFineRootById(long id) {
		if (id > 0) {
			Node n = (Node) graph().getNodeForId(id);
			if (n instanceof FineRoot) {
				return (FineRoot) n;
			}
		}
		return null;
	}
	
	/**
	 * Retrieves a node from the graph by its ID and casts it to the desired type using raw Class.
	 *
	 * @param id The node ID.
	 * @param type The expected class type (e.g., FineRoot.class).
	 * @return The node cast to the specified type, or null if not valid.
	 * FineRoot fr = (FineRoot) getNodeById(frIDs[i], FineRoot.class);
	 * StructuralRoot sr = (StructuralRoot) getNodeById(srIDs[i], StructuralRoot.class);
	 * Soil sl = (Soil) getNodeById(slIDs[i], Soil.class);
	 */
	protected Object getNodeById(long id, Class type) {
		if (id > 0) {
			Object node = graph().getNodeForId(id);
			if (type.isInstance(node)) {
				return node;
			}
		}
		return null;
	}


	
