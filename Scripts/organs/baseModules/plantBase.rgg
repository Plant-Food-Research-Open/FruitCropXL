/**
 * This module contains plant-wide identifier variables.
 * These variables are used to identify and characterize plants in a field.
 */
module PlantIdentifier extends Node 
{
    /**
     * Represents the plant number in the field.
     */
    int plantNumber; // plant number in the field

    /**
     * Indicates whether the plant is a border plant (true) or a focal plant (false).
     */
    boolean border; // true: border plant, false: focal plant

    /**
     * Represents the strip number.
     */
    int strip; // strip number

    /**
     * Represents the row number.
     */
    int row; // row number

    /**
     * Represents the position within the row.
     */
    int pos; // position within row

    /**
     * Represents the species of the plant.
     */
    String species;
    /** True for the original field domain that may be reported to outputs. */
    boolean isReportable = true;
    /** Field instance identifier; original field = 0, clones > 0. */
    int fieldInstanceId = 0;
	
	 /**
     * Initializes the plant with the provided parameters.
     *
     * @param i      The plant number.
     * @param row    The row number.
     * @param pos    The position within the row.
     * @param strip  The strip number.
     * @param species The species name.
     */
	void initiate(int i, int row, int pos, int strip, String species)
	{
		// assign plant number
		this.plantNumber = i;		
		// assign strip number
		this.strip = strip;
		// assign row number
		this.row = row;
		// assign position number
		this.pos = pos;
		// assign species name
		this.species = species;
		// assign border
		assignBorder(row,pos,strip);
	}
	
	/**
     * Assigns whether the plant is a border plant based on its location in the plot.
     *
     * @param row   The row number.
     * @param pos   The position within the row.
     * @param strip The strip number.
     */
	void assignBorder(int row, int pos, int strip) {
		if (strip == 1) {
			if (row <= borderRows || pos <= borderPlants || pos > nrPlants - borderPlants) {
				border = true;
			}
			
		}
		if (strip > 1 && strip < nrStrips) {
			if (pos <= borderPlants || pos > nrPlants - borderPlants) {
				border = true;
			}
		}
		if (strip == nrStrips) {
			if (row > nrRows - borderRows || pos <= borderPlants || pos > nrPlants - borderPlants) {
				border = true;
			}
		}
	}
	
} ==> Sphere(0.01).(setShader(border?RED:YELLOW));


/**
 * The `PlantBase` class serves as the core modeling component for simulating a plant's life cycle, 
 * physiological processes, and interactions with environmental conditions. This class extends the `PlantIdentifier` 
 * class and incorporates a myriad of plant-related attributes for simulating plant behavior, such as growth rates,
 * age, water and carbon flux, and more.
 * It solves the actual water flux and phloem carbon concentration at plant level under a certain soil water potential and environemntal conditions
 * This class adheres to the ODD (Object Design Description) principle for documentation.
 *
 * @author junqi zhu
 * @version 1.0
 *
 * Attributes:
 * ------------
 * - age, ageD, ageGdd: Various forms of representing the age of the plant.
 * - biomass, biomassLeaf, biomassFineRoot, etc.: Metrics to track the biomass in different plant organs.
 * - leafNSC, internodeNSC, etc.: Non-Structural Carbohydrate (NSC) content in various plant organs.
 * - maintenanceDM, growthCost, carbonMobilizationCost: Substrate costs related to different physiological activities.
 * - leafArea, plantHeight: Physical dimensions of the plant.
 * - leafRad, leafPAR, fabs, fpar, etc.: Metrics related to light and radiation absorption.
 * - assimilatedCO2, carbonAssimilation, meanAnet, meanPAnet: Metrics related to carbon assimilation and photosynthesis.
 * - sugarConcentration_phloem, totalLoading, totalUnloading, etc.: Variables related to phloem transport.
 * - nitrogenCommonPool: Common pool of nitrogen available to the plant.
 *
 * Methods:
 * --------
 * - initiate(): Initializes the plant with given parameters such as row position, plant number, etc.
 * - addRootBase(): Adds a root base to the plant.
 * - calcAge(): Calculates the plant's age based on environmental conditions.
 * - updateWaterFlux(): Updates the water flux of the plant based on environmental conditions.
 * - updateCarbonAssimilation(): Calculates the carbon assimilation of the plant based on environmental conditions.
 * - updateWaterPotential(): Calculates the water potential considering Munch counter flow.
 * - getLeafStatus(): Retrieves and stores various attributes of individual leaves.
 * - shouldCalcWaterFlux(): Determines whether to commence water flux and photosynthesis calculations.
 * - calcActualWaterFlux(): Calculates the actual water flux using an iterative solver.
 * - calcphloemSugarConcentration(): Calculates the phloem concentration of carbon compounds in the plant.
 *
 */
module PlantBase extends PlantIdentifier
{
	/** Preserve saved-graph compatibility across the transport-facade addition. */
	private static final long serialVersionUID = 2880287385063320302L;

	//the groimp unique node id of itself, can also use getId() function
	long nodeID;
	/** the id of RootBase objects */
	long rbID;
	
	protected RootBase getRootBase() {
		if (rbID > 0) {
			Node n = (Node) graph().getNodeForId(rbID);
			if (n instanceof RootBase) {
				return (RootBase) n;
			}
		}
		return null;
	}
	
	
	
	/** the id of trunk or first internode connected to plantbase */
	long childTrunkID;
	long childStructuralRootID;
	/** Target mean leaf area from plant-bud-property (m2 leaf-1); <=0 disables size scaling. */
	public double meanLeafAreaTarget_m2 = 0.0;
	
	protected Internode getChildInternode() {
		if (childTrunkID > 0) {
			Node n = (Node) graph().getNodeForId(childTrunkID);
			if (n instanceof Trunk) {
				return (Trunk) n;
			} else if (n instanceof Internode) {
				return (Internode) n;
			}
		}
		return null;
	}
	
	protected StructuralRoot getChildStructuralRoot() {
		if (childStructuralRootID > 0) {
			Node n = (Node) graph().getNodeForId(childStructuralRootID);
			if (n instanceof StructuralRoot) {
				return (StructuralRoot) n;
			} 
		}
		return null;
	}
	
