/**
 * Update the plant biomass, considering various plant organs and growth-related variables.
 * calculates the ShootRootRatio of the newly growned shoot and root, age is smaller than 365 day
 * This method calculates and updates the plant's biomass, taking into account growth costs, carbon mobilization costs,
 * biomass for different plant organs (leaves, fine roots, structural roots, internodes, trunk, cordon, and berries), and
 * nitrogen content within the common pool. It also tracks the total biomass and the change in biomass over time.
 */
 void updateBiomass()
	{   
		/** update the biomass of different component */							
		biomassLeaf = sum((* g:Leaf, (g.plantNumber == plantNumber) *).biomass);
		biomassFineRoot = sum((* g:FineRoot, (g.plantNumber == plantNumber) *).biomass);
		biomassStructuralRoot = sum((* g:StructuralRoot, (g.plantNumber == plantNumber) *).biomass);
		biomassInternode = sum((* g:Internode, (g.plantNumber == plantNumber) *).biomass);
		biomassTrunk = sum((* g:Trunk, (g.plantNumber == plantNumber) *).biomass);
		biomassCordon = sum((* g:Cordon, (g.plantNumber == plantNumber) *).biomass);	
		
		biomassPerennielWood = biomassTrunk + biomassCordon;
		
		double biomassPetiole = sum((* g:Petiole, (g.plantNumber == plantNumber) *).biomass);
		double biomassNewInternode = sum((* g:Internode, (g.plantNumber == plantNumber && g.ageD < 300)*).biomass);
		double newShootBiomass = (biomassLeaf + biomassPetiole + biomassNewInternode);
		
		//this accounts for the number of bunches as each bunch is treated as one object
		//for apple and others, berryNumPerBunch needs to be set to 1
		biomassFruit =  sum((* g:FruitService, (g.plantNumber == plantNumber) *).biomass) * berryNumPerBunch;
		
		biomassFlower =  sum((* g:Flower, (g.plantNumber == plantNumber) *).biomass) * berryNumPerBunch;
		
		biomass = sum((* g:GrowingOrgan, (g.plantNumber == plantNumber &&
						!(g instanceof FruitService)) *).biomass) + biomassFruit;
		
		if(step > 1) {accBiomass += (biomass - biomassPre);}
							
		//if (printFlag) { println( "biomassFruit " + biomassFruit); }
		double carbon_total_fruit =  sum((* g:FruitService, (g.plantNumber == plantNumber) *)[carbon_total]) * berryNumPerBunch;
		
		carbon_total = sum((* g:GrowingOrgan, (g.plantNumber == plantNumber &&
							!(g instanceof FruitService))*)[carbon_total]) + carbon_total_fruit;
	
		freshWeightFruit = sum((* g:FruitService, (g.plantNumber == plantNumber) *).freshWeight)* berryNumPerBunch;		
		
		
		/** update the growth, maintenance and other cost of different component */
		/**maintenance cost */
		maintenanceDM = sum((* g:GrowingOrgan, (g.plantNumber == plantNumber)*).maintenanceDM);
		
			
		maintenanceLeaf = sum((* l:Leaf, (l.plantNumber == plantNumber) *).maintenanceDM);
		maintenanceInternode = sum((* l:Internode, (l.plantNumber == plantNumber)*).maintenanceDM);
		
		maintenanceFruit = sum((* g:FruitService, (g.plantNumber == plantNumber) *).maintenanceDM)* berryNumPerBunch;
		
		maintenanceFineRoot = sum((* l:FineRoot, (l.plantNumber == plantNumber) *).maintenanceDM);
		maintenanceStructuralRoot = sum((* l:StructuralRoot,(l.plantNumber == plantNumber)*).maintenanceDM);
		
		/**growth cost*/
		growthCost = sum((* g:GrowingOrgan, (g.plantNumber == plantNumber) *).growthCost);
		
		growthCostLeaf = sum((* l:Leaf, (l.plantNumber == plantNumber) *).growthCost);
		growthCostInternode = sum((* l:Internode, (l.plantNumber == plantNumber)*).growthCost);
		
		growthCostFruit = Math.max(0, sum((* g:FruitService, (g.plantNumber == plantNumber) *).growthCost)* berryNumPerBunch);
		
		growthCostFineRoot = sum((* l:FineRoot, (l.plantNumber == plantNumber) *).growthCost);
		growthCostStructuralRoot = sum((* l:StructuralRoot,(l.plantNumber == plantNumber)*).growthCost);
		
		carbonMobilizationCost = sum((* g:GrowingOrgan, (g.plantNumber == plantNumber) *).carbonMobilizationCost) + 
									(totalFruitNum)* mean((* g:FruitService, (g.plantNumber == plantNumber) *).carbonMobilizationCost); 
		
			/** update physiological WUE (mg C per mg H2O) with night/near-zero water-loss guards */
			double waterLossMg = waterFlux_optimized * timeInterval;
			if (globalRadiation <= LIGHT_THRESHOLD ||
				waterFlux_optimized <= 1e-6 ||
				waterLossMg <= 1e-6 ||
				carbonAssimilation <= 0 ||
				Double.isNaN(waterFlux_optimized) ||
				Double.isInfinite(waterFlux_optimized)) {
				WUE = 0.0;
			} else {
				WUE = carbonAssimilation / waterLossMg;
			}
		
		/** update the fraction of fine root and structural root in the total root biomass*/
			[
				f:FineRoot::> {
					if (!useComplexRoot) {
						f.fiRootProportion = (biomassFineRoot > 0.0) ? f.biomass / biomassFineRoot : 0.0;
					}
				}
			
			s:StructuralRoot::> {
				s.stRootProportion = s.biomass/biomassStructuralRoot;			
			}
		]
		
		
		/** calc ShootRootRatio, only conducts calculation when new shoots are growing */
		if(!Double.isNaN(biomassFineRoot) && !Double.isNaN(newShootBiomass)) { 
			SR = newShootBiomass/biomassFineRoot;
		}
		/** use transpiration and root conductance to adjust the carbon allocation. 
			this is only one factor. */
		//when there is potential transpiration is reduced because of root biomass and soil water conditions
		//only starts the calculation after a day
		if(step > 24 && this.leafArea >= 3.0) { //the leaf area threshold is set to avoid the adjustment at the very early stage when the plant is very small and the water flux is low, which could lead to over adjustment. This threshold can be further tuned based on the specific crop and growth conditions.
			if( daily_waterFluxReduction < FLUX_REDUCTION_THRESHOLD_RS_ADJUSTMENT &&
				daily_waterFluxReduction > 0) { 
				fMb_root = 1.0/daily_waterFluxReduction;
				fMb_shoot = daily_waterFluxReduction;
			} else if(daily_waterFluxReduction >= FLUX_REDUCTION_THRESHOLD_RS_ADJUSTMENT
					 && Mb >= 1 && this.leafArea >= 3.0) {
			//this is a condition when root conductance is larger than transpiration, thus more leaves could be grow 
				fMb_shoot = Mb;
				fMb_root = 1/Mb;
			} else { //no adjustment needed
				fMb_root = 1; fMb_shoot = 1;
			}
		}
		
		if(calcNUptake || step <= 2) updateNPool();

		//double sumFlux;
		//if (printFlag) { println("pb.biomass" + biomassTrunk ); }
		//if (printFlag) { println( "sumFlux " + sum((* g:GrowingOrgan, (g.plantNumber == plantNumber) *)[Cflux])/1000); }
		biomassPre = biomass;
		
		//println(" biomassLeaf " + biomassLeaf + " biomassFineRoot " + biomassFineRoot + " biomassStructuralRoot " + biomassStructuralRoot +
		//" biomassInternode " + biomassInternode + " biomassTrunk " + biomassTrunk + " biomassCordon " + biomassCordon);
		
		
	}
	
	
/**
 * Update the sum of potential supply and demand of biomass for the organs of this plant.
 *
 * This method calculates and updates the total potential biomass demand and supply for the plant's organs.
 * These values are essential for evaluating the balance of supply and demand within the plant.
 */
	void updateSupplyDemand()
	{
		int currentPlantNumber = plantNumber;
		potentialBiomassDemand = sum((* g:GrowingOrgan, (g.plantNumber == currentPlantNumber)*)[biomassDemand]);
		potentialBiomassSupply = sum((* g:GrowingOrgan, (g.plantNumber == currentPlantNumber)*)[biomassSupply]);
		potentialSupplyDemandRatio = potentialBiomassSupply/potentialBiomassDemand;
	}
/**
 * Update the Non-Structural Carbon (NSC) content for different plant organs.
 *
 * This method calculates and updates the NSC content for various plant organs, including leaves, fine roots,
 * structural roots, internodes, trunk, and cordons. It also computes the mean soluble sugar content of fruit bunches.
 */
	void updateNSC()
	{   
		leafNSC = sum((* g:Leaf, (g.plantNumber == plantNumber) *).carbon_nonStructure);
		fineRootNSC = sum((* g:FineRoot, (g.plantNumber == plantNumber) *).carbon_nonStructure);
		structuralRootNSC = sum((* g:StructuralRoot, (g.plantNumber == plantNumber) *).carbon_nonStructure);
		internodeNSC = sum((* g:Internode, (g.plantNumber == plantNumber) *).carbon_nonStructure);
		trunkNSC = sum((* g:Trunk, (g.plantNumber == plantNumber) *).carbon_nonStructure);
		cordonNSC = sum((* g:Cordon, (g.plantNumber == plantNumber) *).carbon_nonStructure);
		//has fruit bunchs in each shoot
		berrySugar = mean((* g:FruitService, (g.plantNumber == plantNumber) *).solubleSugar);
		flowerSelfAssimC = sum((* g:Flower, (g.plantNumber == plantNumber) *).flowerSelfAssimC);
		int currentPlantNumber = plantNumber;
		int today = (int)Math.floor(this.ageD);
		int retainedFlowersPlant = 0;
        int droppedFlowersPlant = 0;
        int droppedTodayPlant = 0;
		for (Flower fl : (* Flower *)) {
			if (fl.plantNumber == currentPlantNumber) {
				if (fl.dropped) {
					droppedFlowersPlant++;
					if (fl.dropDay == today) droppedTodayPlant++;
				} else {
					retainedFlowersPlant++;
				}
			}
		}

		
		if (debug) { 
			println(" leafNSC " + String.format("%.4f",leafNSC) + "\n" +
					" leaf fNSC:" + leafNSC/(biomassLeaf*0.42) + "\n" +
					" internodeNSC " + String.format("%.4f",internodeNSC) +  "\n" +
					" structuralRootNSC " + String.format("%.4f",structuralRootNSC));
					}
	}
	
/**
 * Update the nitrogen pools and content for the plant.
 *
 * This method calculates and updates various nitrogen-related parameters, including N degradation, N synthesis,
 * and N uptake by fine roots. It then updates the common nitrogen pool and mobile nitrogen content.
 */	
	void updateNPool() 
	{		
		// Initialize baseline plant N if not already set
		if (totalNitrogen_start < 1.0) {
			totalNitrogen_start = sum(
				(* l:GrowingOrgan, (l.plantNumber == plantNumber) *).nitrogen_total
			);
		}
		
		
		Ndegradation = sum((* g:GrowingOrgan, (g.plantNumber == plantNumber) *).Ndegradation);
		Nsynthesis = sum((* g:GrowingOrgan, (g.plantNumber == plantNumber) *).Nsynthesis);
		Nuptake = sum((* r:FineRoot, (r.plantNumber == plantNumber) *).Nuptake);
		
		//nitrogenCommonPool = nitrogenCommonPool + Ndegradation - Nsynthesis + Nuptake;
	 
		totalNitrogen = sum((*l:GrowingOrgan, (l.plantNumber == plantNumber)*).nitrogen_total);
	    //mobileNContent -= Nsynthesis;
	    
	    // Current mobile N pool = initial N + cumulative root uptake
		double totalNuptake = getRootBase().totalNuptake_overTime;
		
		totalNitrogen = totalNitrogen_start + totalNuptake;
		nitrogenCommonPool  =  totalNitrogen * N_CONTENT_MOBILE;
		
		mobileNContent = nitrogenCommonPool/this.biomass;
		NConcentration = totalNitrogen / this.biomass;
	}
	
	
/**
 * Computes the nitrogen-to-carbon capacity ratio (N_C_ratio) at the plant level.
 * <p>
 * This metric compares the plant’s total mobile nitrogen pool against the
 * sum of maximum non-structural carbon storage capacities across all organs.
 * It is used as a proxy for "N fullness" relative to available C storage
 * potential, inspired by the QualiTree concept of living structural mass,
 * but here simplified via {@code carbon_nonStructure_max}.
 * </p>
 *
 * <p><b>Formula:</b></p>
 * <pre>
 *   NmobilePool = totalNitrogen_start + totalNuptake_overTime
 *   Ccap_total  = Σ(carbon_nonStructure_max)
 *   N_C_ratio   = NmobilePool / Ccap_total
 * </pre>
 *
 * <p><b>Details:</b></p>
 * <ul>
 *   <li>{@code totalNitrogen_start} is lazily initialized from the sum of
 *       all organ nitrogen contents at the first call.</li>
 *   <li>{@code totalNuptake_overTime} is cumulative N uptake from roots.</li>
 *   <li>If {@code Ccap_total} is very small or zero, the ratio is clamped
 *       to zero to avoid divide-by-zero.</li>
 * </ul>
 *
 * <p><b>Interpretation:</b></p>
 * <ul>
 *   <li>Low values (≈0) → N pool small relative to storage capacity,
 *       high potential demand, uptake favored.</li>
 *   <li>High values (≫1) → N pool large relative to capacity,
 *       uptake increasingly suppressed.</li>
 * </ul>
 *
 * @return N_C_ratio (dimensionless) = mobile nitrogen pool / carbon storage capacity
 */
double carbonStorageCapacitySum = -1.0;
double calcNCRatio() {

    if (carbonStorageCapacitySum <= 1.0 || hourOfDay == 2) {
        int currentPlantNumber = plantNumber;

        carbonStorageCapacitySum = sum(
            (* g:GrowingOrgan, (g.plantNumber == currentPlantNumber) *).carbon_nonStructure_max
        );
    }

    if (Double.isNaN(carbonStorageCapacitySum) || Double.isInfinite(carbonStorageCapacitySum) || carbonStorageCapacitySum <= 1.0) {
        N_C_ratio = 1e-6;
        return N_C_ratio;
    }

    if (Double.isNaN(nitrogenCommonPool) || Double.isInfinite(nitrogenCommonPool) || nitrogenCommonPool <= 0.0) {
        N_C_ratio = 1e-6;
        return N_C_ratio;
    }

    N_C_ratio = nitrogenCommonPool / carbonStorageCapacitySum;

    if (Double.isNaN(N_C_ratio) || Double.isInfinite(N_C_ratio)) {
        N_C_ratio = 1e-6;
    }

    return N_C_ratio;
}

 
 
/**
 * Update the plant's leaf and stem surface area.
 *
 * This method calculates and updates the total leaf area and the fraction of sun-exposed leaves. It also determines whether to run the light model
 * based on the presence of leaf area.
 */
	void updateSurfaceArea() {
		leafArea = sum((* l:Leaf, (l.plantNumber == plantNumber) *)[area]);
		sunExposedLeafFraction = Math.max(0.1, sum((* l:Leaf, (l.plantNumber == plantNumber & l.fpar >= 0.1) *)[area])/leafArea);
		//runLightModel = leafArea > 1e-4 ? true : false; 
		
	}

/**
 * Update the plant's height and trunk height.
 *
 * This method calculates and updates the total plant height and the mean trunk height.
 */
	void updateHeight() {

		if ("fieldRandomCanopy".equals(initiation_method)) {
			trunkHeight = 0.0;
			if (count((* l0:Leaf, (l0.plantNumber == plantNumber) *)) >= 1) {
				plantHeight = max((* l:Leaf, (l.plantNumber == plantNumber) *)[z]);
				height_low = plantHeight / 3.0;
				height_mid = 2.0 * plantHeight / 3.0;
			}
			return;
		}

		if(trunkHeight == 0 || trunkHeight <= 0.1 || step <= 2) {
			trunkHeight = mean((* t:Trunk, (t.plantNumber == plantNumber) *)[length]);
		}
		
		if(useStaticArc == false || step <= 2) {
			plantHeight = max((* it:Internode, (it.plantNumber == plantNumber) *)[endZ]);
			height_low = trunkHeight + (plantHeight - trunkHeight)/3.0;
			height_mid = trunkHeight + 2 * (plantHeight - trunkHeight)/3.0;
		}
   		
	}

/**
 * Update the internode and cordon orders
 *
 * This method updates the min and max order of the internode and cordon and use it to 
 * control the loop in the update water potential method
 */
	void updateOrder() {		   
		minOrder = min((* it:Internode, (it.plantNumber == plantNumber ) *)[order]);
		maxOrder = max((* it:Internode, (it.plantNumber == plantNumber ) *)[order]);
	}
	

/**
 * Update the plant's absorbed radiation.
 *
 * This method calculates and updates various radiation-related parameters, such as leaf radiation, leaf PAR,
 * absorbed radiation fractions (fabs and fpar), hourly absorbed radiation, accumulated radiation, and fPAR
 * fractions at different height levels.
 */
	void updateAbsorbedRadiation() {
		if(globalRadiation > LIGHT_THRESHOLD ) {
			leafRad = sum((* l:Leaf,(
				l.plantNumber == this.plantNumber &&
				l.fieldInstanceId == this.fieldInstanceId
			)*)[abs]);
			
			leafPAR = sum((* l:Leaf,(
				l.plantNumber == this.plantNumber &&
				l.fieldInstanceId == this.fieldInstanceId
			)*)[absPAR]);
					
			if (globalRadiation > 10) {
				fabs = (leafRad * dens) / globalRadiation;
				fpar = (leafPAR * dens) / (fPAR * globalRadiation);
			} else {
				fabs = fpar = 0;
			}

			
			//println("leafRad " + leafRad + " globalRadiation " +  globalRadiation + " dens " + dens);
			
			
			hourlyAbsorbedRadiation = 1e-6 * leafRad * timeInterval/WATT_TO_PPFD;  //MJ       //umol/s * S /WATT_TO_PPFD, J	Watt
			accumulatedRadiation +=  hourlyAbsorbedRadiation;  //MJ
			
		
			
			/* if (printFlag) {
				println("leafRad " + leafRad + " fpar " +  fpar); 
								println( " check " +  mean((* l:Leaf,(l.plantNumber == plantNumber && 
							 height_low < l.z &&  l.z < height_mid)*)[incPARm2]));
			} */
			double lowMean = mean((* l:Leaf,(
				l.plantNumber == plantNumber &&
				l.fieldInstanceId == this.fieldInstanceId &&
				l.layer == LAYER_LOW
				)*)[incPARm2]);
			double midMean = mean((* l:Leaf,(
				l.plantNumber == plantNumber &&
				l.fieldInstanceId == this.fieldInstanceId &&
				l.layer == LAYER_MID
				)*)[incPARm2]);
			double upMean = mean((* l:Leaf,(
				l.plantNumber == plantNumber &&
				l.fieldInstanceId == this.fieldInstanceId &&
				l.layer == LAYER_UP
				)*)[incPARm2]);				
				
			fPARLow = Double.isNaN(lowMean) ? 0 : lowMean / (fPAR * globalRadiation);
			fPARMid = Double.isNaN(midMean) ? 0 : midMean / (fPAR * globalRadiation);
			fPARUp  = Double.isNaN(upMean)  ? 0 : upMean / (fPAR * globalRadiation);			
		}
		else {
			leafRad = 0;
			leafPAR = 0;
			fabs = 0;
			fpar = 0;
			fPARLow = 0;
			fPARMid = 0;
			fPARUp = 0;
			hourlyAbsorbedRadiation = 0;        //umol/m2/s * S /WATT_TO_PPFD, J	Watt(umol/m2/s)
			accumulatedRadiation += 0;  //MJ
		}
		
		 /* if (printFlag) { 
			println(String.format("%-10s %.4f", "pb.leafarea:", leafArea));
			println(String.format("%-11s %.4f", "plant fabs:", fabs));
		} */
	}
/**
 * Check if it's time to harvest the plant.
 *
 * @return {@code true} if the current day is greater than or equal to the harvest day plus the delay, indicating that it's time to harvest; otherwise, {@code false}.
 */
	boolean shouldHarvest() {
		return daysSinceWinterSolstice >= harvestDAWS;
	}
