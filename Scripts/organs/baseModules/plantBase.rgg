/**
 * Initializes the plant with the given parameters.
 *
 * @param i The plant number.
 * @param row The row position of the plant.
 * @param pos The position of the plant.
 * @param strip The strip number.
 */
	void initiate(int i, int row, int pos, int strip, PlantIdentifier pi)
	{
		plantNumber = i;		
		this.strip = strip;
		this.row = row;
		this.pos = pos;
		
		this.ageD = PLANT_AGE_DAYS;
		this.ageTd = this.ageD * (Tmax+Tmin)/2/OPT_TEMP;
		this.ageGdd = Math.max(this.ageD * ((Tmax + Tmin) / 2 - baseT), ageTd);
		
		if (thermalUnit.equals("thermalDay")) {
			this.age = ageTd;
		} else if(thermalUnit.equals("growingDegreeDay")) {
			this.age = ageGdd;
		} else if (thermalUnit.equals("day")) {
			this.age = ageD;
		}
		//this.pi = pi;
		this.species = pi.species;
		println("species: " + this.species);
		try {
			io.github.fruitcropxl.config.params.groups.DocumentCategoryNameGroup ppGroup =
				(io.github.fruitcropxl.config.params.groups.DocumentCategoryNameGroup) CONFIG.getGroup(
					FILE_NAME_PLANT_PARAMETERS,
					io.github.fruitcropxl.config.params.groups.DocumentCategoryNameGroup.class);
			io.github.fruitcropxl.config.params.structures.CategoryStore cfg = ppGroup.getCategoryStore();
			cfg.setCategoryContext("plant-bud-property");
			// Compatibility guard: legacy files may not provide meanLeafArea_m2.
			this.meanLeafAreaTarget_m2 = cfg.getDouble("meanLeafArea_m2");
		} catch (io.github.fruitcropxl.config.util.exceptions.KeyNotFoundException e) {
			this.meanLeafAreaTarget_m2 = 0.0;
		} catch (Exception e) {
			this.meanLeafAreaTarget_m2 = 0.0;
		}
		assignBorder(row,pos,strip);
		
	}
	
	/**
 * Adds a root base to the plant, reducing unnecessary searching.
 *
 * @param rb The RootBase to add.
 */
	void addRootBase(RootBase rb)
	{
		this.rbID = rb.getId();
		if(this.nodeID <= 0) {this.nodeID = this.getId();}
	}
	

/**Calculates the age of the plant based on temperature.*/
void calcAge(){

	age_pre = age;
	ageGdd_pre = ageGdd;
	ageTd_pre = ageTd;
	
	/** updating the age */
	ageD = ageD + DT;

	ageGdd = ageGdd_pre + deltaAgeGdd(Ta, baseT, DT);

	ageTd  = ageTd_pre + wangEngelTempFunction(Ta, MIN_TEMP, OPT_TEMP, MAX_TEMP,REFTMP) * DT;
	
	//this is needed because of initial age assignment at initiation, like plant age
	//we also want to keep track of all age calculation for cross validation in future
	double deltaAge = 0;
	if (thermalUnit.equals("thermalDay")) {
		deltaAge = wangEngelTempFunction(Ta, MIN_TEMP, OPT_TEMP, MAX_TEMP,REFTMP) * DT;
	} else if(thermalUnit.equals("growingDegreeDay")) {
		deltaAge = Ta > baseT ? (Ta - baseT) * DT : 0;
	} else if(thermalUnit.equals("day")) {
		deltaAge = DT;
	} 
	
	// Check for valid deltaAge before updating age
	if (!Double.isNaN(deltaAge) && Double.isFinite(deltaAge)) {
		age += deltaAge;
	} else {
		// Handle invalid deltaAge value, e.g., log an error or use a default value
		if (printFlag) { println("Invalid deltaAge encountered: " + deltaAge); }
	}
	
	if(this.nodeID <= 0) {this.nodeID = this.getId();}
		// Set rbID from parent if not already set
	if (this.rbID <= 0 && step >= 2) {
		RootBase r = first((*rt:RootBase, (rt.plantNumber == plantNumber)*));
		if (r != null) {
			this.rbID = r.getId();
		}
	}
	
	if (this.childTrunkID <= 0 && step >= 2) {
		if(count((*t:Trunk, (t.plantNumber == plantNumber)*))>=1) {
			int minRank = min((* it:Trunk*)[rank]);
			Trunk tr = first((*t:Trunk,
			(t.plantNumber == plantNumber && t.rank == minRank)*));
			childTrunkID = tr.getId();
		} else if(count((* in0:Internode, (in0.plantNumber == plantNumber)*))>=1) {
			int minOrder = min((* it:Internode *)[order]);
			int minRank = min((* it:Internode, (it.order == minOrder) *)[rank]);

			Internode it = first((*t:Internode,
			(t.plantNumber == plantNumber &&
			 t.order == minOrder && t.rank == minRank)*));
			if (it != null) {
				childTrunkID = it.getId();
			}
		} else if ("fieldRandomCanopy".equals(initiation_method)) {
			// Statistical leaf clouds have no explicit shoot conduit topology.
			childTrunkID = -1;
		}
	}

	
	 
}
/**
 * Updates the water flux of the plant based on environmental conditions.
 * 
 * This function dynamically calculates the plant's water flux potential and updates water-related variables.
 * It accounts for different environmental factors such as global radiation, water logging conditions, 
 * and night transpiration. The function also manages a historical buffer to compute the maximum weekly water flux.
 * 
 * @return The updated water flux value.
 */
	 transient int bufferSize2 = 120; // 120-hour rolling window for water-flux potential
	 transient double[] waterFluxPotentialBuffer = new double[bufferSize2];
	 transient int bufferIndex2 = 0;
	 transient int waterFluxPotentialBufferCount = 0;
	double weekly_maxWaterFluxPotential;

	double updateWaterFlux()
	{
		return plantHydraulics.updateWaterFlux(this);
	}
/**
 * Calculates the carbon assimilation of the plant based on environmental conditions.
 *
 * This method calculates the carbon assimilation of the plant, taking into account the global radiation
 * and other factors. It updates the assimilated CO2, carbon assimilation, mean net photosynthesis,
 * and mean potential photosynthesis. The calculations are performed during the daytime when global
 * radiation is above a certain threshold.
 *
 * @return The updated carbon assimilation value.
 */
	double updateCarbonAssimilation()
	{  
		//calculate the assimilated co2 per hour during daytime 
		if(globalRadiation > LIGHT_THRESHOLD ) {
			assimilatedCO2 = sum((* v:PhotosynthateOrgan, (v.plantNumber == plantNumber) *)[assimilatedCO2]);  //umol co2 per hour
			carbonAssimilation = sum((* v:PhotosynthateOrgan, (v.plantNumber == plantNumber) *)[carbonAssimilation]);  //mg C per hour
			meanAnet = mean((* v:PhotosynthateOrgan, (v.plantNumber == plantNumber) *)[AlimActual]); 
			meanPAnet = mean((* v:PhotosynthateOrgan, (v.plantNumber == plantNumber) *)[Alim]);
		
		}  
		else {
			carbonAssimilation = 0;
			assimilatedCO2 = 0; 
			meanAnet = -mean((* v:PhotosynthateOrgan, (v.plantNumber == plantNumber) *)[Rd]);
			meanPAnet = -mean((* v:PhotosynthateOrgan, (v.plantNumber == plantNumber) *)[Rd]);
		}  //println("hourOfday" + assimilatedCO2 ); //set assimilatedCO2 to zero when it is night, there is memory for it. 
		
	}

	public double safeDouble(double x) {
		if (Double.isNaN(x) || Double.isInfinite(x)) return 0.0;
		return x;
	}

	public void updateDailyCarbonStressAtHour0() {
		if (hourOfDay != 0) return;

		previousDailyNetCarbonBalance =
			safeDouble(dailyCarbonAssimilationAccum) +
			safeDouble(dailyFlowerSelfAssimCAccum) -
			safeDouble(dailyGrowthCostAccum) -
			safeDouble(dailyMaintenanceDMAccum);

		if (Double.isNaN(previousDailyNetCarbonBalance) ||
			Double.isInfinite(previousDailyNetCarbonBalance)) {
			previousDailyNetCarbonBalance = 0.0;
		}

		dailyCarbonBalanceNegative = previousDailyNetCarbonBalance < 0.0;
		plantCarbonStressForSecondaryGrowth =
			enableDailyCarbonStressControls &&
			dailyCarbonBalanceNegative;
		plantCarbonGainForGrowthControl = previousDailyNetCarbonBalance;
		plantCarbonGainNegative = dailyCarbonBalanceNegative;

		dailyCarbonAssimilationAccum = 0.0;
		dailyFlowerSelfAssimCAccum = 0.0;
		dailyGrowthCostAccum = 0.0;
		dailyMaintenanceDMAccum = 0.0;
	}

	public void accumulateHourlyDailyCarbonBalance() {
		dailyCarbonAssimilationAccum += safeDouble(carbonAssimilation);
		dailyFlowerSelfAssimCAccum += safeDouble(flowerSelfAssimC);
		dailyGrowthCostAccum += safeDouble(growthCost);
		dailyMaintenanceDMAccum += safeDouble(maintenanceDM);
	}



	double calcShootRootRatio()
	{  
		//this accounts for the number of bunches as each bunch is treated as one object
		biomassLeaf = sum((* g:Leaf, (g.plantNumber == plantNumber) *).biomass);
		biomassFineRoot = sum((* g:FineRoot, (g.plantNumber == plantNumber) *).biomass);
		biomassStructuralRoot = sum((* g:StructuralRoot, (g.plantNumber == plantNumber) *).biomass);
		biomassInternode = sum((* g:Internode, (g.plantNumber == plantNumber) *).biomass);
	
	
	}
	

	
