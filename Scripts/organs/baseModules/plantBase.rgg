/**
 * Determine whether water flux and photosynthesis calculations should commence.
 *
 * This method checks if the plant has enough active leaf source area for the
 * water-flux solve. Non-fallback runs keep the historical 0.01 m2 threshold;
 * early fallback runs start as soon as a leaf is present.
 *
 * @return `true` if water flux and photosynthesis calculations should start, `false` otherwise.
 */
public boolean shouldCalcWaterFlux() 
	{	
		
		if(!isLeafHydraulicBypassTestScenario()) {
			if (enableLAILeafPhotosynthesisFallback) {
				boolean hasLeaf = leafArea > 0.0;
				if (!hasLeaf) {
					hasLeaf = count((* lf:Leaf, (lf.plantNumber == plantNumber) *)) > 0;
				}
				return(globalRadiation > LIGHT_THRESHOLD && hasLeaf);
			}
			return(globalRadiation > LIGHT_THRESHOLD && leafArea > 1e-2);
		} else {
			return true;
		} 
	} 

