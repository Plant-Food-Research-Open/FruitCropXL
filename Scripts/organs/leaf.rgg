	/**
	 * Carbon-deficit leaf-removal logic
	 * --------------------------------
	 *
	 * This block tracks whether a mature leaf can sustain its own carbon cost over
	 * a recent rolling time window. At each model time step, the leaf calculates:
	 *
	 *     current-step carbon balance = carbon assimilation - own carbon cost
	 *
	 * The value is stored in a circular buffer. The buffer length is calculated from
	 * the configured window length and the model time step:
	 *
	 *     carbonSelfBalanceWindowSteps = leafCarbonDeficitWindowDays / DT
	 *
	 * With hourly time steps and a 10-day window, the buffer contains 240 values.
	 * Once the buffer is full, each new value overwrites the oldest value. A running
	 * sum is maintained by subtracting the overwritten value and adding the new one.
	 *
	 * Therefore, carbonSelfBalance10d represents the cumulative carbon balance over
	 * the most recent window. It is a rolling sum, not a rolling average.
	 *
	 * A leaf can be removed only if it is mature, has enough valid history in the
	 * buffer, has non-trivial area, and its rolling cumulative carbon balance is
	 * below leafCarbonDeficitBalanceThresholdMgC.
	 */
	/**
	 * Lazily initializes this leaf's circular buffer for carbon self-balance
	 * records. The buffer length is derived from calendar days divided by
	 * {@code DT}; with the default 10 d window and hourly steps it stores
	 * 240 step-level records.
	 */
	private void ensureCarbonSelfBalanceBuffer() {
		int n = (int) Math.round(leafCarbonDeficitWindowDays / Math.max(1.0e-9, DT));
		if (n < 1) n = 1;

		if (carbonSelfBalanceBuffer == null || carbonSelfBalanceWindowSteps != n) {
			carbonSelfBalanceWindowSteps = n;
			carbonSelfBalanceBuffer = new double[n];
			for (int i = 0; i < n; i++) {
				carbonSelfBalanceBuffer[i] = 0.0;
			}
			carbonSelfBalanceBufferIndex = 0;
			carbonSelfBalanceBufferCount = 0;
			carbonSelfBalanceWindowSum = 0.0;
			carbonSelfBalance10d = 0.0;
			carbonDeficitRemovalCandidate = 0;
		}
	}

	/**
	 * Returns the current-step leaf carbon gain (mg C leaf-1 step-1).
	 * Negative, NaN, or infinite assimilation values are treated as zero.
	 */
	double currentLeafCarbonGainMgC() {
		double gain = this.carbonAssimilation;
		if (Double.isNaN(gain) || Double.isInfinite(gain)) gain = 0.0;
		return Math.max(0.0, gain);
	}

	/**
	 * Returns the current-step self carbon cost for this leaf
	 * (mg C leaf-1 step-1). Exported loading is intentionally not counted as
	 * a self-maintenance cost, so productive source leaves are not penalized
	 * for exporting carbon.
	 */
	double currentLeafCarbonCostMgC() {
		double cost = 0.0;
		if (!Double.isNaN(this.maintenanceDM_PT) && !Double.isInfinite(this.maintenanceDM_PT)) {
			cost += Math.max(0.0, this.maintenanceDM_PT);
		}
		if (!Double.isNaN(this.carbonMobilizationCost) && !Double.isInfinite(this.carbonMobilizationCost)) {
			cost += Math.max(0.0, this.carbonMobilizationCost);
		}
		return cost;
	}

	/**
	 * Updates this leaf's rolling carbon self-balance history for the configured
	 * carbon-deficit leaf-removal window.
	 *
	 * <p>The current-step self-balance is {@code carbon gain - carbon cost},
	 * in mg C leaf-1 step-1. Each value is written into a circular buffer and
	 * maintained as an incremental rolling sum. With
	 * {@code leafCarbonDeficitWindowDays = 10.0} and {@code DT = 1.0 / 24.0},
	 * {@code carbonSelfBalance10d} is the cumulative balance over the previous
	 * 10 calendar days, not a moving average.</p>
	 *
	 * <p>After updating the buffer, this method refreshes
	 * {@code carbonDeficitRemovalCandidate} from the mature-leaf removal
	 * predicate.</p>
	 */
	public void updateCarbonSelfBalanceHistory() {
		if (!enableCarbonDeficitLeafRemoval) return;

		ensureCarbonSelfBalanceBuffer();

		double gain = currentLeafCarbonGainMgC();
		double cost = currentLeafCarbonCostMgC();
		double balance = gain - cost;
		if (Double.isNaN(balance) || Double.isInfinite(balance)) {
			balance = 0.0;
		}

		if (carbonSelfBalanceBufferCount == carbonSelfBalanceWindowSteps) {
			carbonSelfBalanceWindowSum -= carbonSelfBalanceBuffer[carbonSelfBalanceBufferIndex];
		} else {
			carbonSelfBalanceBufferCount++;
		}

		carbonSelfBalanceBuffer[carbonSelfBalanceBufferIndex] = balance;
		carbonSelfBalanceWindowSum += balance;
		carbonSelfBalanceBufferIndex =
			(carbonSelfBalanceBufferIndex + 1) % carbonSelfBalanceWindowSteps;

		carbonGainLastStep = gain;
		carbonCostLastStep = cost;
		carbonSelfBalanceLastStep = balance;
		carbonSelfBalance10d = carbonSelfBalanceWindowSum;
		carbonDeficitRemovalCandidate = shouldRemoveForCarbonDeficit() ? 1 : 0;
	}

	/**
	 * Returns whether this leaf is mature enough for carbon-deficit removal.
	 * The threshold is {@code te * leafCarbonDeficitMatureAgeFactor}; the
	 * default factor of 1.0 means only leaves with {@code age >= te} qualify.
	 */
	public boolean isMatureForCarbonDeficitRemoval() {
		double matureAge = this.te * leafCarbonDeficitMatureAgeFactor;
		if (Double.isNaN(matureAge) || Double.isInfinite(matureAge)) matureAge = this.te;
		return this.age >= matureAge;
	}

	/**
	 * Returns whether this leaf has enough valid step-level records to make a
	 * rolling-window removal decision. The required record count is
	 * {@code ceil(windowSteps * leafCarbonDeficitMinValidFraction)}, with the
	 * fraction clamped to {@code [0, 1]} for configuration safety.
	 */
	public boolean hasEnoughCarbonBalanceHistory() {
		ensureCarbonSelfBalanceBuffer();
		double validFraction = leafCarbonDeficitMinValidFraction;
		if (Double.isNaN(validFraction) || Double.isInfinite(validFraction)) validFraction = 0.95;
		validFraction = Math.max(0.0, Math.min(1.0, validFraction));
		int required = (int) Math.ceil(carbonSelfBalanceWindowSteps * validFraction);
		if (required < 1) required = 1;
		return carbonSelfBalanceBufferCount >= required;
	}

	/**
	 * Tests whether this mature leaf should be removed for persistent carbon
	 * deficit. Removal requires the feature switch and {@code leafSenescence},
	 * mature age, enough rolling-history records, non-trivial leaf area, the
	 * plant-level minimum leaf-area guard, and a rolling cumulative balance
	 * below {@code leafCarbonDeficitBalanceThresholdMgC} (mg C leaf-1 window-1).
	 */
	public boolean shouldRemoveForCarbonDeficit() {
		if (!enableCarbonDeficitLeafRemoval) return false;
		if (!leafSenescence) return false;
		if (!isMatureForCarbonDeficitRemoval()) return false;
		if (!hasEnoughCarbonBalanceHistory()) return false;
		if (this.area <= 1.0e-4) return false;

		PlantBase pb = getPlantBase();
		if (pb != null && pb.leafArea <= leafCarbonDeficitMinPlantLeafArea) return false;

		return carbonSelfBalance10d < leafCarbonDeficitBalanceThresholdMgC;
	}
	
	@Override
	public void initializeCarbonTransport() {
		this.r = 0;
		this.xp = 0;
		this.cpb = this.cpt = SOURCEcp;
		//float Rs = ( R0 * PhloemResistanceRatio(initial_c0)/(PressureRatio(initial_c0)*R*Tk));   // resistance per unit length (initial case)
		//this.cpt = SOURCEcp - cpn * length * SOURCEj * Rs;
		//this.cpb = SOURCEcp - (cpn - 1) * length * SOURCEj * Rs;
		this.j = j;
	}
	@Override
	public void updateCTRs(double carbonConcentration) {		
		this.r = 0; 
		this.xp = 0;
	}	
	
	
	@Override
	void calcLeakage(double sugarConcentration_phloem) 
	{ //leakage only calculates for shoot, leaf is zero
		leakage = 0;
	}
	
	
	@Override
	double reserveHydrolysis()
	{
/* 		if(debug) {
			checkForNaN(printFlag, 
				"carbonAssimilation", carbonAssimilation, 
				"carbon_nonStructure", carbon_nonStructure
				);
		} */
						
	double res = 0;
	
	if(globalRadiation > LIGHT_THRESHOLD) {
		if(this.carbon_nonStructure > 0.8 * this.carbon_structure *this.maxRes/(1-this.maxRes)) {
			res = carbonAssimilation + carbon_nonStructure * Math.min(HYDROLYSIS_LEAF_DAY, HYDROLYSIS_LEAF_NIGHT * 2);
		} else {
			res = carbonAssimilation * HYDROLYSIS_LEAF_DAY + carbon_nonStructure * HYDROLYSIS_LEAF_NIGHT;
		}
		
	} else {
		res = this.carbon_nonStructure > 0.8 * this.carbon_structure *this.maxRes/(1-this.maxRes) ? 
				carbon_nonStructure * Math.min(HYDROLYSIS_LEAF_DAY, HYDROLYSIS_LEAF_NIGHT * 2) :
				carbon_nonStructure * HYDROLYSIS_LEAF_NIGHT;
	}
	
	if(res < 0) res = 0;
	return res;
	}

	 /**
     * Calculate the rate of reserve synthesis in the organ.
     * @return Rate of reserve synthesis
     */
    @Override
    double reserveSynthesis() {
        if (this.fNSC < MINIMUM_NSC) {
			double calculatedPotentialSynthesis = synRate *
				(biomass * maxRes * CARBON_FRACTION_SUCROSE - carbon_nonStructure) *
				tempRes_enzyme(Ta) * MINIMUM_NSC;
			return Math.max(0.0, calculatedPotentialSynthesis);
        } else return 0;
    }
	
	@Override	
	void calcPTCTRAM(double sc) {
		structureDM_SEC_PT = 0;
		calcLeakage(sc);

		if (this.age < this.te) {
			// Potential growth in length, avoiding NaN issues
			float growthFactor = (plantBaseID > 0) ? getPlantBase().fMb_shoot : 1.0f;
			float primaryGrowth = primaryGrowthRate();
			
			deltalength_PT = growthFactor * primaryGrowth;
			
			float newLength = length + deltalength_PT;
			
			deltaArea = calcLeafPolygonArea(newLength, newLength / lwRatio, fid) - area;
			
			structureDM_PRI_PT = C_content * growthCoff * density * deltaArea;
			if (Float.isNaN(structureDM_PRI_PT) || Float.isInfinite(structureDM_PRI_PT)) {
				structureDM_PRI_PT = 0.0f; // Default if invalid
			}
		} else {
			deltalength_PT = 0;
			structureDM_PRI_PT = 0;
		}

		// Ensure maintenance respiration does not produce NaN
		maintenanceDM_PT = calcMaintanceRespiration(this.fNSCtoSC);
		
		reserveDM_PT = reserveSynthesis();
	
		loading_PT = reserveHydrolysis();
	}

	/**
	 * Debug-only decomposition of leaf expansion into potential, water-limited, and final terms.
	 *
	 * <p>The final leaf primary-growth term shown here matches the production logic in
	 * {@link #calcUnloading(double)} and uses the dominant-limiter rule
	 * {@code min(fw, fc)} (not {@code fw * fc}).
	 */
	void debugLeafExpansionDecomp(double sugarConcentration_phloem) {
		if (!outputLeafGrowthDiagnostics) {
			return;
		}

		dbg_validStep = step;
		dbg_growthActive = (this.age < this.te) ? 1 : 0;
		dbg_sc_phloem = sugarConcentration_phloem;
		dbg_area_pre = this.area;
		dbg_dt = this.age - this.age_pre;
		if (Double.isNaN(dbg_dt) || Double.isInfinite(dbg_dt) || dbg_dt <= 0) {
			dbg_dt = 1.0;
		}

		// Match production primaryGrowthPotential(): no length/potLength self-penalty.
		dbg_ratio = 1.0;

		dbg_Lpot = primaryGrowthPotential();
		if (Double.isNaN(dbg_Lpot) || Double.isInfinite(dbg_Lpot)) {
			dbg_Lpot = 0.0;
		}

		float growthFactor = (this.plantBaseID > 0) ? getPlantBase().fMb_shoot : 1.0f;

		if (organGrowthMethod.equals("TempLimited")) {
			dbg_fw = 1.0;
		} else {
			double psi = (Double.isNaN(this.waterPotential) || Double.isInfinite(this.waterPotential)) ? -0.1 : this.waterPotential;
			dbg_fw = waterPotentialRes(psi, this.growth_a, this.growth_b);
			if (Double.isNaN(dbg_fw) || Double.isInfinite(dbg_fw)) {
				dbg_fw = 1.0;
			}
			dbg_fw = Math.max(0.0, Math.min(1.0, dbg_fw));
		}

		dbg_fc = sinkUnloading(sugarConcentration_phloem, km_pri);
		if (Double.isNaN(dbg_fc) || Double.isInfinite(dbg_fc)) {
			dbg_fc = 0.0;
		}
		dbg_fc = Math.max(0.0, Math.min(1.0, dbg_fc));
		if (shouldUsePreT1PotentialGrowth()) {
			dbg_fc = 1.0;
		}
		double dbg_stress = (dbg_fw < dbg_fc) ? dbg_fw : dbg_fc;

		dbg_dL_pot = growthFactor * dbg_Lpot;
		dbg_dL_w = growthFactor * dbg_Lpot * dbg_fw;
		dbg_dL_final = growthFactor * dbg_Lpot * dbg_stress;

		double L0 = this.length;
		double W0 = L0 / lwRatio;
		double area0 = calcLeafPolygonArea((float) L0, (float) W0, fid);

		double L_pot = L0 + dbg_dL_pot;
		double L_w = L0 + dbg_dL_w;
		double L_final = L0 + dbg_dL_final;

		dbg_dA_pot = calcLeafPolygonArea((float) L_pot, (float) (L_pot / lwRatio), fid) - area0;
		dbg_dA_w = calcLeafPolygonArea((float) L_w, (float) (L_w / lwRatio), fid) - area0;
		dbg_dA_final = calcLeafPolygonArea((float) L_final, (float) (L_final / lwRatio), fid) - area0;
	}

	@Override
	void calcUnloading(double sugarConcentration_phloem) {
		debugLeafExpansionDecomp(sugarConcentration_phloem);
		if (this.age < this.te) {
			float growthFactor = (this.plantBaseID > 0) ? getPlantBase().fMb_shoot : 1.0f;
			// Leaf primary elongation uses a dominant-limiter rule for water/carbon coupling:
			// apply min(fw, fc) to the potential elongation (Lpot) to avoid compounding
			// limitations as fw * fc.
			double fc = sinkUnloading(sugarConcentration_phloem, km_pri);
			if (Double.isNaN(fc) || Double.isInfinite(fc)) fc = 0.0;
			if (fc < 0.0) fc = 0.0;
			if (fc > 1.0) fc = 1.0;
			if (shouldUsePreT1PotentialGrowth()) {
				fc = 1.0;
			}

			double Lpot = primaryGrowthPotential();
			double fw = primaryGrowthWaterEffect();
			double stress = (fw < fc) ? fw : fc;

			deltalength = growthFactor * Lpot * stress;
			
			float newLength = length + deltalength;
			
			deltaArea = calcLeafPolygonArea(newLength, newLength / lwRatio, fid) - 
						calcLeafPolygonArea(length, length / lwRatio, fid);
			
			
			structureDM = C_content * growthCoff * density * deltaArea;
			if (Float.isNaN(structureDM) || Float.isInfinite(structureDM)) {
				structureDM = 0.0f;
			}
		} else {
			deltalength = 0;
			structureDM = 0;
		}
	
		maintenanceDM = calcMaintanceRespiration(this.fNSCtoSC) * 
						sinkUnloading(sugarConcentration_phloem, KM_MTNCE);
		
		//println("maintenanceDM: " + maintenanceDM + " Rd: " + Rd);
		
		reserveDM = reserveSynthesis()* 
					sinkUnloading(sugarConcentration_phloem, km_res);	
	
		unloading = structureDM + maintenanceDM + reserveDM;
		
		if (Float.isNaN(unloading) || Float.isInfinite(unloading)) {
			unloading = 0.0f;
		}
	}

	
	@Override
	void calcLoading(double sugarConcentration_phloem)
	{
		if (fNSC > MINIMUM_NSC) {
			double potentialLoading = reserveHydrolysis() * 
									  sourceLoading(sugarConcentration_phloem, sourceLoading_b, sourceLoading_cp);
	
			// Estimate post-loading fNSC assuming simple linear relation (adjust as needed)
			double potentialLeafNSC = carbon_nonStructure - potentialLoading;
			double potential_fNSC = potentialLeafNSC / carbon_total; // Assuming leafBiomass exists and is > 0
	
			if (potential_fNSC >= MINIMUM_NSC) {
				loading = potentialLoading;
			} else {
				// Limit loading to avoid dropping below MINIMUM_NSC
				double safeLeafNSC = MINIMUM_NSC * carbon_total;
				double maxAllowedLoading = carbon_nonStructure - safeLeafNSC;
				loading = Math.max(0, maxAllowedLoading); // Ensure loading isn't negative
			}
		} else {
			loading = 0;
		}
	
		// Optional debug print
		// if (printFlag) {
		//     println("leaf " + "node " + nodeNumber + " rank " + this.rank +
		//             " loading: " + loading + " fNSC: " + fNSC + " reserveHydrolysis: " + reserveHydrolysis());
		// }
	}

	@Override
	double calcMaintanceRespiration(double fNSCtoSC) 
	{ 
		//Rd is umol CO2 m-2 s-1
		float deltaT;
		if (globalRadiation > LIGHT_THRESHOLD ) {
			deltaT = timeInterval; 
			if(this.carbonAssimilation < 0) {
				maintenanceDM = Math.abs(carbonAssimilation);
				return maintenanceDM;
			} else {
				maintenanceDM = 0; 
				return 0;
			} 
		} else {
			/** this seems too big compared to all other organs*/
			/* deltaT = 3600; 	//DT = 1/24, this make deltaT into 1 hour
			//almost the same as Rd
			/* float mainTS = carbon_total * maintenanceCoff;
			float teff = Q10MN**( ((Ta - REFTMP)/10f) );
			maintenanceDM = mainTS*teff; */
			
			/* float cp_adj;   //adjustment by phloem carbon concentration
		  //assume that the basic maintenance is 25% of the parameterized value,it decreases with the neighbouring phloem concentration. 
		   // Check for NaN and handle gracefully
			if (Float.isNaN(fNSCtoSC) || Float.isInfinite(fNSCtoSC)) {
				fNSCtoSC = 0.5; // Default to 0 if NaN is detected
			}
			
		    cp_adj = 0.25+ Math.max(0.1, Math.min(0.75, fNSCtoSC));  
		
			Rd = Rd(Ta, leafNcontent);  //umol CO2 m-2 s-1
			
			if (Double.isNaN(Rd) || Double.isInfinite(Rd)) {
				println("Invalid Rd value: " + Rd);
				Rd = 0.1;
			}
			
			
			maintenanceDM = Rd * area * deltaT * 1e-6 * 12 * 1e3*cp_adj;  // mg/leaf/hour
			
			} */
			  
			maintenanceDM = super.calcMaintanceRespiration(this.fNSCtoSC);
			 			
			return maintenanceDM;
		}
	}
	
	
	@Override
	void calcNSynthesis()
	{
	
		Nsynthesis = Ta > 0 ? Ta*DT * NSynthRate * biomass * 
					 (getPlantBase().mobileNContent / (getPlantBase().mobileNContent + kNpool)) * (EP/ (EP + kEP))
					 : 0;
		nitrogen_nonStructure += Nsynthesis;
		nitrogen_total += Nsynthesis;  //= nitrogen_structure + nitrogen_nonStructure;
	}
	
	
	// update the leaf RH
		
	double leafRH;
	void calcLeafRH() {
		 leafRH = random(-10,10);
	}


	
	
	/**
	 * Updates the state and pointer variables of the leaf. This method performs various updates
	 * including searching and setting state variables, updating organ size and area, and managing 
	 * carbon and nitrogen status of the leaf based on the current growth conditions and environmental inputs.
	 * 
	 * The method calculates new dimensions, biomass, and nitrogen content depending on 
	 * whether potential growth is used or other growth constraints are applied.
	 */

	@Override
	void update()
	{
		super.update();

		/**searching and update state and pointer variables */
		if(this.plantBaseID <= 0) { this.plantBaseID = first((* p:PlantBase, (p.plantNumber == this.plantNumber)*)).nodeID;} 
		
		if (parentID <= 0) {  // Assuming 0 is an uninitialized ID
			GrowingOrgan parentOrgan = (GrowingOrgan) first((* this (<--)+ Internode*));
			if (parentOrgan != null) {
				this.parentID = parentOrgan.nodeID;
				parentOrgan.addChildLeafId(this.nodeID);
			}
		}
			
		if(trunkHeight == 0) {
			trunkHeight = mean((* t:Trunk, (t.plantNumber == this.plantNumber) *)[length]);
			//println("trunkHeight: " + trunkHeight);
		}
		
				
		if(outputIndividualLeaf && (leafAreaAbove_plant == 0 || leafAreaAbove_shoot == 0)) {
		
			leafAreaAbove_plant = sum( (* lf:Leaf, (lf.plantNumber == this.plantNumber && 
										  lf.z > this.z) *)[area]);
			leafAreaAbove_shoot = sum( (* lf:Leaf, (lf.plantNumber == this.plantNumber &&
				lf.cordonNumber == this.cordonNumber && lf.nodeNumber == this.nodeNumber &&
									lf.z > this.z) *)[area]);
			double boundBox = 0.2; //currently put 20 cm as the bouding box size						
			leafAreaDensity_local = sum( (* lf:Leaf, (lf.plantNumber == this.plantNumber &&
									(lf.x + lf.endX)/2 <= this.x + boundBox &&
									(lf.x + lf.endX)/2 >= this.x - boundBox &&
									(lf.y + lf.endY)/2 <= this.y + boundBox &&
									(lf.y + lf.endY)/2 >= this.y - boundBox &&
									(lf.z + lf.endZ)/2 <= this.z + boundBox &&
									(lf.z + lf.endZ)/2 >= this.z - boundBox
									) *)[area]) / (boundBox * boundBox * boundBox);
		
		} 
		
		if (parentID >= 0 && getPlantBase().height_low >= trunkHeight && step <= 2) {
			assignLeafLayersByZ(getPlantBase().height_low, getPlantBase().height_mid);
			//default input
			assignLeafTraits(0.0, 10);
		} 


		/** update organ size and area */
		double prevLength = this.length;
		if(this.age >= te) {
			this.potLength = this.maxLength;
		} else {
			this.potLength = this.maxLength * betaGrowthFunction(this.age, this.tm, this.te);
		}
		this.potLength = clampNonShrinkingPotentialLength(prevLength, this.potLength, this.maxLength);
		//println("age:" + this.age + " potLength: " + potLength);
		//if organGrowthMethod.equals("TempLimited") is true, length increase by potential length
		if(organGrowthMethod.equals("TempLimited")) {
			this.length = this.potLength;
		} else if(organGrowthMethod.equals("TempWaterLimited")) { 
			this.length = length + deltalength_PT;
		} else if(organGrowthMethod.equals("TempWaterCarbonLimited")){
			this.length = length + deltalength;
		} else {
			this.length = length + deltalength;
		}
		
		//if (printFlag) { println("delta length " + deltalength); }
		width =  length/lwRatio;
		//for leaf, make diameter equal to width
		this.diameter = width;
		area = calcLeafPolygonArea(length, width, fid);
			if (!this.profileFinalSizeLocked && this.potentialFinalSize > 0.0 && !Double.isNaN(area) && !Double.isInfinite(area)) {
				this.realizedFinalSize = area;
			}
			if (this.realizedFinalSize > 1.0e-12 && !Double.isNaN(area) && !Double.isInfinite(area)) {
				this.currentAreaToRealizedFinalRatio = area / this.realizedFinalSize;
			} else {
				this.currentAreaToRealizedFinalRatio = 0.0;
			}
			if (Double.isNaN(this.currentAreaToRealizedFinalRatio) || Double.isInfinite(this.currentAreaToRealizedFinalRatio)) this.currentAreaToRealizedFinalRatio = 0.0;
			if (this.currentAreaToRealizedFinalRatio < 0.0) this.currentAreaToRealizedFinalRatio = 0.0;
			if (this.currentAreaToRealizedFinalRatio > 2.0) this.currentAreaToRealizedFinalRatio = 2.0;
			updateRealizationRatio();
			shapeCoefficient = area/(length * width);
		adjustedWidth = width * shapeCoefficient;
		
		/** update organ carbon and nitrogen status */
		if(organGrowthMethod.equals("TempLimited")) {
			biomass = area*density;
			this.initCN_content(this.biomass);
			//if (printFlag) { println("biomass leaf: " + this.biomass); }
			
		} else {
			delta_str = structureDM - growthCost; //maintenanceDM + reserveDM
			delta_NSC = carbonAssimilation + maintenanceDM + reserveDM 
							- loading - carbonMobilizationCost - maintenanceDM_PT;
			updateCarbonStatus(delta_str, delta_NSC);
			
			//setting the fNSC for photosynthesis test
			if("photosynthesisTest".equals(special_scenario)) {
				this.fNSC = 0.1; 
			}
			//updating specific leaf area based on new leaf area and biomass;
			//SLA is not fluctuating based on nonstructural carbon,
			//but this variation is removed in Nitrogen content calculation
			//because accumulation of strach etc does not accompanied by N
			if(!Double.isNaN(this.biomass) && this.area > 4e-4) {
				this.SLA = this.area/this.biomass;
                this.density	  = 1/SLA;
			}
			/* if(Double.isNaN(this.biomass)) {
				this.initCN_content(this.biomass_pre);
			} */
		}
		
	
		
		//calcNdegradation();
		//calcNSynthesis(); 
		//leafNcontent = nitrogen_total * mgTogram/area;
		if (outputLeafGrowthDiagnostics) {
			writeLeafExpansionDiagnostic(this);
		}

		//for float it is not a good idea to use == sign
		//println(leafNcontent + " " + (leafNcontent >= leafNContent_input)); 
	}
	
	/**
	 * Calculates and returns the scale factor for the leaf length relative to the reference length.
	 *
	 * @return The scale factor for the leaf length.
	 */
	double getLengthScaleFactor()
	{
		return length/getRefLengthForLeaf();
	}
	/**
	 * Calculates and returns the scale factor for the leaf width relative to the reference width.
	 *
	 * @return The scale factor for the leaf width.
	 */
	double getWidthScaleFactor()
	{
		return width/getRefWidthForLeaf();
	}
}	 //everything is using multifacet leaf now. this is just a convention
