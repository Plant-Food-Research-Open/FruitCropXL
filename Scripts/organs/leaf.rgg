	// petiole module
module Petiole extends GrowingOrgan
{
	double vol;  //m3 the volume of the petiole
	double width; 
	
	double fpetio; // = 0.5;				// petiole length (expressed as fraction of leaf blade length)
		
	public void loadParameters() {
			
		/** Set the context for file name parameters*/
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();

		
		/** Configuration context for carbon-related parameters */
		config.setCategoryContext("leaf-carbon");
		//common parameters
		maintenanceCoff        = config.getDouble("MTNCE", 0.000336);
		growthCoff             = config.getDouble("GROWTHRQ", 1.2);
		C_content              = config.getDouble("C_CONTENT", 0.46);
		maxRes                 = config.getDouble("RESERVES", 0.2);
		
		km_pri                 = config.getDouble("KM_PRI", 0.00029);
		km_sec                 = 0;
		km_res                 = 0;
		
		hydRate                = config.getDouble("HYDROLYSIS_LEAF_DAY", 0.8);
		synRate                = 0; 
		
		
		fpetio = config.getDouble("fpetio", 0.5);
		tm	 = config.getDouble("tm", 4.5);
		te	 = config.getDouble("te", 7.5);
		initialLength = fpetio*config.getDouble("initialLength", 0.01);
		maxLength = fpetio*config.getDouble("Lmax", 0.15);
		//the density was in unit of mg/cm3, so need to times 1e6 to convert into mg/m3;
		density = config.getDouble("PETIOLE_DENSITY", 50)*1e6;  
		
 		config.setCategoryContext("leaf-water");
 		growth_a	 = config.getDouble("growth_a", -10);
		growth_b	 = config.getDouble("growth_b", -0.5);
		
		waterContent = config.getDouble("WATER_CONTENT", 0.85);
		
		config.setCategoryContext("leaf-nitrogen");
		/** Slope of Nm decline with thermal time (fraction per °C·d). */
		aN_slope = config.getDouble("aN_slope", -8.1e-6);
		
		/** Clamps for Nm and LMA. */
		Nm_min  = config.getDouble("Nm_min",  0.005);  // 0.5% N
		Nm_max  = config.getDouble("Nm_max",  0.060);  // 6.0% N
		
		
		
		
		/** INITIAL CONDITIONS*/
		CategoryStore config_Init = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_INITIAL_CONDITIONS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();			
		
		config_Init.setCategoryContext("leaf");
		
		fNSC                   = config_Init.getDouble("fNSC", 0.1);
		structure_C            = 1- fNSC; 
	
		

		
	}
	
	
	Petiole initiate_pi(PlantIdentifier pi, float length_, float diameter_)
	{ 
		//initialize the parameters
		loadParameters();
		//IDENTIFIERS
		
		plantNumber = pi.plantNumber;
		if(this.plantBaseID <= 0) { this.plantBaseID = first((* p:PlantBase, (p.plantNumber == this.plantNumber)*)).nodeID;}
		
		border = pi.border;
		
		length =Math.max(length_, 1e-2);
		this.potLength = length; 
		width = 2e-3;
				
		area = Math.PI * (width*width/4);
		vol = calcVol(length, width);
		//CARBON
		biomass = vol * density; 
		Ka = 1e5;		 //the hydraulic resistence of petiole has been accounted by leaf
		
		// Initialize carbon and nitrogen content 
		this.initCN_content(this.biomass);
		
		this.organType = "Petiole";
		return this;
	}
	
	
	void initiate_pb(PlantBase pb, int i, int k, int l)
	{ 
		//initialize the parameters
		loadParameters();
		//IDENTIFIERS
		this.plantBaseID = pb.nodeID;
		plantNumber = pb.plantNumber;
		border = pb.border;
		rank = i;
		nodeNumber = k; 
		cordonNumber = l;
		cpn = i;
		order = 0; 
		assignAge(pb, this.cpn);
		//STATE VARIABLES
		try {
			if(i == 0) i = i+1;
			length = organSize[i][4];
		} catch (ArrayIndexOutOfBoundsException e) {
			length = organSize[organSize.length-1][4];	
		}
		this.potLength = length; 
	//	if (printFlag) { println("width " + width); }
		width =  2e-3;

		area = Math.PI * (width*width/4);
		vol = calcVol(length, width);
		
		//CARBON
	
		biomass = vol * density; 
		Ka = 1e5;		 //the hydraulic resistence of petiole has been accounted by leaf
	
		// Initialize carbon and nitrogen content
		this.initCN_content(this.biomass);
		
		this.organType = "Petiole";
	}
	
	void initiate_apex(ApexService a)
	{
		//initialize the parameters
		loadParameters();
		plantNumber = a.plantNumber;
		if(plantBaseID <= 0) { this.plantBaseID = first((* p:PlantBase, (p.plantNumber == this.plantNumber)*)).nodeID;}
		border = a.border;
		rank = a.rank;
		nodeNumber = a.nodeNumber; 
		cordonNumber = a.cordonNumber;
		age = Math.max(1e-3, a.age - plastochron);
		cpn = a.cpn ;
		order = a.order;
		
		length = initialLength;
		this.potLength = length;
		
		width =  2e-3;
		area = Math.PI * (width*width/4);
		vol = calcVol(length, width);
		
		biomass = vol * density;
		//CARBON
		Ka = 1e5;		
		
		// Initialize carbon and nitrogen content
		this.initCN_content(this.biomass);
		this.organType = "Petiole";

	}
	
	@Override
	public void initializeCarbonTransport() {
		double length_cm = this.length * 1e2;
	    double area_cm2   = this.area * 1e4;
		float Rs = ( R0 * PhloemResistanceRatio_mixture(initial_c0, FRACTION_SORBITOL)/(PressureRatio(initial_c0)*R_ct*Tk));   // resistance per unit length (initial case)
		this.r =  Rs * length_cm / area_cm2; //r is in unit of cm //divided by diameter
		float h_internode_rs = 0; //1/o.Ka /3.6; 	// hydraulic resistance
		this.xp = 0;//(-Jw * h_internode_rs * initial_c0)/(PressureRatio(initial_c0)*R*Tk);  //need to update this term
		
		this.cpb = this.cpt =  SOURCEcp;
		 
		//this.cpt = SOURCEcp - cpn * ini_length * SOURCEj * Rs;
		//this.cpb = SOURCEcp - (cpn - 1) * length * SOURCEj * Rs;
		this.j = j;
	}
	@Override
	public void updateCTRs(double carbonConcentration) {
		double length_cm = this.length * 1e2;
	    double area_cm2   = this.area * 1e4;
		float Rs = ( R0 * PhloemResistanceRatio_mixture(carbonConcentration, FRACTION_SORBITOL)/(PressureRatio(carbonConcentration)*R_ct*Tk));   // resistance per unit length (initial case)
		this.r =  Rs * length_cm / area_cm2; //r is in unit of cm //divided by diameter
		float h_internode_rs = 0; //1/o.Ka /3.6; 	// hydraulic resistance
		this.xp = 0;//(-Jw * h_internode_rs * initial_c0)/(PressureRatio(initial_c0)*R*Tk);  //need to update this term
		//println("petiole: r: " + r);
	}	

	@Override
	void calcLeakage(double sugarConcentration_phloem) 
	{ //leakage only calculates for shoot, leaf is zero
		leakage = 0;
	}	
	
	@Override
	double reserveHydrolysis()
	{
		return (0);
	}
	
	@Override
	boolean shouldRemove(double odd)
	{
		return (random(0,1) > odd);
	}
	@Override
	void calcPTCTRAM(double sc) {
		structureDM_SEC_PT = 0;
		calcLeakage(sc);
	
		if (this.age < this.te) {
			float growthFactor = (this.plantBaseID > 0) ? getPlantBase().fMb_shoot : 1.0f;
			float primaryGrowth = primaryGrowthRate();
	
			deltalength_PT = growthFactor * primaryGrowth;
			
			float calculatedVolume = calcVol(deltalength_PT, width);
			
			structureDM_PRI_PT = C_content * growthCoff * density * calculatedVolume;
			
			if (Float.isNaN(structureDM_PRI_PT) || Float.isInfinite(structureDM_PRI_PT)) {
				structureDM_PRI_PT = 0.0f;
			}
		} else {
			deltalength_PT = 0;
			structureDM_PRI_PT = 0;
		}
	
		maintenanceDM_PT = calcMaintanceRespiration(this.fNSCtoSC);

		reserveDM_PT = 0;
	
		loading_PT = 0;
	
	}

	@Override
	void calcUnloading(double sugarConcentration_phloem) {
		if (this.age < this.te) {
			float growthFactor = (this.plantBaseID > 0) ? getPlantBase().fMb_shoot : 1.0f;
			float primaryGrowth = primaryGrowthRate();
			double fc = sinkUnloading(sugarConcentration_phloem, km_pri);
			if (Double.isNaN(fc) || Double.isInfinite(fc)) fc = 0.0;
			if (fc < 0.0) fc = 0.0;
			if (fc > 1.0) fc = 1.0;
			if (shouldUsePreT1PotentialGrowth()) {
				fc = 1.0;
			}
			
			deltalength = growthFactor * primaryGrowth * fc;

			float calculatedVolume = calcVol(deltalength, width);
	
			structureDM = C_content * growthCoff * density * calculatedVolume;
			if (Float.isNaN(structureDM) || Float.isInfinite(structureDM)) {
				structureDM = 0.0f;
			}
		} else {
			deltalength = 0;
			structureDM = 0;
		}
	
		float unloadingFactor = sinkUnloading(sugarConcentration_phloem, KM_MTNCE);
		
		maintenanceDM = calcMaintanceRespiration(this.fNSCtoSC) * unloadingFactor;
	
		reserveDM = 0;
	
		unloading = structureDM + maintenanceDM + reserveDM;
		
		if (Float.isNaN(unloading) || Float.isInfinite(unloading)) {
			unloading = 0.0f;
		}
	}
	
	
	@Override
	void calcLoading(double sugarConcentration_phloem)
	{
		loading =  0;
	    //if (printFlag) { println("this is loading from internode " + "node " + nodeNumber + " rank "+ this.rank + " loading " + loading); }
	} 
	
	@Override
	void update()
	{
		super.update();
		
		if(this.plantBaseID <= 0) { this.plantBaseID = first((* p:PlantBase, (p.plantNumber == this.plantNumber)*)).getId();} 
		
		if (parentID <= 0) {  // Assuming 0 is an uninitialized ID
			GrowingOrgan parentOrgan = (GrowingOrgan) first((* this (<--)+ Internode*));
			if (parentOrgan != null) {
				storeParentId(parentOrgan);
				//this is based on the organ type of the current organ
				parentOrgan.addChildPetioleId(this.getId());
				
			}
		}
		
		if ( parentID > 0) {
			this.waterPotential = getParent().waterPotential;	
		}

		
		Ka = 1e3;
		/** update organ size and area */
		double prevLength = this.length;
		this.potLength = this.maxLength * betaGrowthFunction(this.age, this.tm, this.te);
		this.potLength = clampNonShrinkingPotentialLength(prevLength, this.potLength, this.maxLength);
		//if organGrowthMethod.equals("TempLimited") is true, length increase by potential length
		if(organGrowthMethod.equals("TempLimited")) {
			this.length = this.potLength;
		} else if(organGrowthMethod.equals("TempWaterLimited")) { 
			this.length = length + deltalength_PT;
		} else if(organGrowthMethod.equals("TempWaterCarbonLimited")){
			this.length = length + deltalength;
		} else {
			this.length = length + deltalength;
		}
		//if (printFlag) { println(" delta length " + deltalength); }
		
		area = Math.PI * (width*width/4);
		vol = calcVol(length, width); 
		
		
		/** update organ carbon and nitrogen status */
		if(organGrowthMethod.equals("TempLimited")) {
			biomass = vol * density;
			this.initCN_content(this.biomass);
		} else {
			delta_str = structureDM - growthCost; //maintenanceDM + reserveDM
			delta_NSC = maintenanceDM + reserveDM + leakage 
						- loading - carbonMobilizationCost - maintenanceDM_PT;
						   
			updateCarbonStatus(delta_str, delta_NSC);
		
			/* if(Double.isNaN(this.biomass)) {
				this.initCN_content(this.biomass_pre);
			} */
		}
		
	}
	
}
