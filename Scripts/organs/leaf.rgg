	/**
     * Fraction of NSC (Non-Structural Carbohydrates) ready to be loaded during the day.
     * This is a fraction, not a rate, so it does not need to be multiplied by dt.
     * Based on Chew 2014 PNAS and Vivian thesis Fig. 33.
     */
    static float HYDROLYSIS_LEAF_DAY = 0.8; 

    /**
     * Fraction of NSC ready to be loaded during the night.
     * Based on Chew 2014 PNAS and Vivian thesis Fig. 33.
     */
    static float HYDROLYSIS_LEAF_NIGHT; 
    
    
    transient PPTask pptask;
	transient TranspirationTask trtask;
	transient AnetTask antask;
	{
		pptask = new PPTask(this);
		trtask = new TranspirationTask(this);
		antask = new AnetTask(this);
	}
	 
	
    /**
     * Loads the parameters for the leaf from the configuration files.
     * This method sets the context for file name parameters and retrieves
     * various leaf-related parameters such as carbon content, structure, 
     * water content, and photosynthesis rates.
     */
	
	public void loadParameters() {
		
		/** Set the context for file name initial conditions*/
		//Need to load SLA first before leaf calculate the density
		CategoryStore config_Init = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_INITIAL_CONDITIONS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();			
		config_Init.setCategoryContext("leaf");
		fNSC                   = config_Init.getDouble("fNSC", 0.1);
		structure_C            = 1- fNSC; 
		//SLA                    = config_Init.getDouble("SLA");
		
		
		/** Set the context for file name parameters*/
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();

		
		/** Configuration context for carbon-related parameters */
		config.setCategoryContext("leaf-carbon");
		//common parameters
		maintenanceCoff        = config.getDouble("MTNCE", 0.0003);
		growthCoff             = config.getDouble("GROWTHRQ", 1.2);
		C_content              = config.getDouble("C_CONTENT", 0.46);
		maxRes                 = config.getDouble("RESERVES", 0.2);
		
		km_pri                 = config.getDouble("KM_PRI", 0.07);
		km_sec                 = 0;
		km_res                 = 0;
		
		hydRate                = config.getDouble("HYDROLYSIS_LEAF_DAY", 0.8);
		synRate                = 0; 
			
		HYDROLYSIS_LEAF_DAY	   = config.getDouble("HYDROLYSIS_LEAF_DAY", 0.8);
		//night rate is not calculated
		//HYDROLYSIS_LEAF_NIGHT  = config.getDouble("HYDROLYSIS_LEAF_NIGHT", 0.05);
		
		tm	 = config.getDouble("tm", 4.5);
		te	 = config.getDouble("te", 7.5);
		initialLength = config.getDouble("initialLength", 0.01);
		maxLength = config.getDouble("Lmax", 0.2);
		LMA_min = config.getDouble("LMA_min", 45.0);   // g m⁻²
		LMA_max = config.getDouble("LMA_max", 80.0);   // g m⁻²
		//SLA is not updated yet, so use SLA_middle as a proxy 
		density = 1.0/SLA_middle;  //(mgDW/m2) leaf density is in terms of area not volume, see the denfition for SLA
		//println("leaf density: " + density);
 		/** Configuration context for water-related parameters */
		/** Parameters for hydraulic conductance sensitivity to transpiration, water potential amplitude, and ABA.*/
		config.setCategoryContext("leaf-water");
		//paragxl a list of parameters for the sensitivities of hydraulic conductance leaf to transpiration (equation 8 in Tardieu, Simonneau and Parent, Journal of Experimental Botany, 2015), amplitude of water potential (equation 7) and ABA (equation 9).		 
		Gxl0		 = config.getDouble("Gxl0", 1);
		Gxlmin		 = config.getDouble("Gxlmin", 1);
		Gxlmax		 = config.getDouble("Gxlmax", 12.5);
		Tautranspigxl= config.getDouble("Tautranspigxl", 4);
		Taucircadgxl = config.getDouble("Taucircadgxl", 0.12);
		TauABAgxl	 = config.getDouble("TauABAgxl", -0.01);
		eq1_beta	 = config.getDouble("eq1_beta", -0.00251);
		eq1_delta	 = config.getDouble("eq1_delta", -0.48985);
		eq1_a		 = config.getDouble("eq1_a", -2);
		eq1_b		 = config.getDouble("eq1_b", -1.6);
		
		PLC_a		 = config.getDouble("PLC_a", 6.59);
		PLC_b		 = config.getDouble("PLC_b", -1.52);
		growth_a	 = config.getDouble("growth_a", -10);
		growth_b	 = config.getDouble("growth_b", -0.5);
		
		waterContent = config.getDouble("WATER_CONTENT", 0.76);
		
		
		config.setCategoryContext("leaf-nitrogen");
		/** Slope of Nm decline with thermal time (fraction per °C·d). */
		aN_slope = config.getDouble("aN_slope", -8.1e-6);
		
		/** SLA–PPFD regression coefficients (Prieto mode). */
		aM = config.getDouble("aM", 6.3);
		bM = config.getDouble("bM", 53.5);
		
		/** Clamps for Nm and LMA. */
		Nm_min  = config.getDouble("Nm_min",  0.005);  // 0.5% N
		Nm_max  = config.getDouble("Nm_max",  0.060);  // 6.0% N


	}
	
	
	
	/**
	 * Initializes the leaf parameters and sets up the leaf object with the provided plant identifier,
	 * length, and diameter. This method calculates the dimensions, biomass, carbon, and nitrogen
	 * content of the leaf, as well as water potential and other physiological properties.
	 *
	 * @param pb        The plant identifier containing plant-specific attributes.
	 * @param length_   The initial length of the leaf.
	 * @param diameter_ The initial diameter of the leaf.
	 * @return The initialized Leaf object with the specified parameters and calculated values.
	 */
	Leaf initiate_pi(PlantIdentifier pb, float length_, float diameter_) 
	{
		//initialize the parameters
		loadParameters();
		//IDENTIFIERS
		plantNumber = pb.plantNumber;
		
		if(this.plantBaseID <= 0) { this.plantBaseID = first((* p:PlantBase, (p.plantNumber == this.plantNumber)*)).nodeID;}
		
		border = pb.border;
		
		length = Math.max(length_, 1e-2);
		this.potLength = length; 
		
		lwRatio	 = getRefLength()/getRefWidth();
		calcLeafRH();
		//calcShapeCoefficient();
		lobe = getLobes();
		
		//use fixed lwratio based on the reference leaf to make the area calculation more acculate
		width = length/lwRatio;
		//refArea[lobe];
		//leaf shape stuffs
		numFacets = polyleaf[lobe].length;
		//facet polygonArea is updated during initiation as 
		//it is easier to update in the initiation than revise all the initate method to include facet id 
		area = calcLeafPolygonArea(length, width, fid);
		
		//CARBON
		biomass = area*density;
		
		//NITROGEN
		
		// Initialize carbon and nitrogen content based on biomass and 
		//carbon and nitrogen concentration
		//if (printFlag) { println("biomass leaf:" + biomass); }
		this.initCN_content(this.biomass);
		
		
		// seed PPFD buffer & assign initial traits with a benign PPFD10
		for (int i = 0; i < PPFD_BUF_LEN; i++) ppfdBuf[i] = 10.0;
		ppfdIdx = 0; ppfdCount = PPFD_BUF_LEN;
		assignLeafTraits(0.0, 10.0);  // will be refined once real layer is known
		//leafNcontent = inputLeafN ? leafNContent_input : nitrogen_total * mgTogram/area;
		
		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential+1e-2;;
		waterPotential_pre = waterPotential;
		
		Gxltranspi = Gxlmin;
				
		numFacets = polyleaf[lobe].length;
		//if (printFlag) { println(" TauABAgxl " + TauABAgxl + " Gxlmin " + Gxlmin); }
		initFromArchReader = true;
		
		return this;
	}

	/**
	 * Initializes the leaf parameters based on the given PlantBase object and other
	 * identifying attributes such as rank, node number, and cordon number.
	 * This method sets up various properties of the leaf, including its dimensions, 
	 * carbon and nitrogen content, and state variables.
	 *
	 * @param pb           The PlantBase object containing plant-specific information.
	 * @param Rank         The rank of the leaf on the plant.
	 * @param NodeNumber   The node number where the leaf is located.
	 * @param CordonNumber The cordon number associated with the leaf.
	 */
	static void initLeafSizeScaleIfNeeded(double targetArea_m2, int fid) {
		if (targetArea_m2 <= 0) {
			leafSizeScale = 1.0;
			leafTargetArea_m2 = 0.0;
			leafScaleInitialized = false;
			return;
		}
		if (leafScaleInitialized && Math.abs(leafTargetArea_m2 - targetArea_m2) < 1e-12) return;

		// Species-specific calibration windows keep the shared linear scale factor from being dominated
		// by padded tail leaves while preserving the rank-size profile shape.
		int refMaxRank = MAX_PHYTOMER_NUM;
		if ("apple".equals(species)) {
			refMaxRank = Math.min(MAX_PHYTOMER_NUM, 8);
			if (refMaxRank < 1) refMaxRank = 1;
		} else if ("grapevine".equals(species)) {
			refMaxRank = Math.min(MAX_PHYTOMER_NUM, 16);
			if (refMaxRank < 1) refMaxRank = 1;
		}

		double sumArea = 0.0;
		int cnt = 0;
		for (int r = 1; r <= refMaxRank; r++) {
			try {
				double l0 = organSize[r][1];
				double w0 = organSize[r][2];
				if (l0 > 0 && w0 > 0) {
					double a0 = calcLeafPolygonArea(l0, w0, fid);
					if (a0 > 0 && Double.isFinite(a0)) {
						sumArea += a0;
						cnt++;
					}
				}
			} catch (ArrayIndexOutOfBoundsException e) {
				// Compatibility-safe skip for legacy organ-size tables.
			}
		}

		double baselineMean = (cnt > 0) ? (sumArea / cnt) : 0.0;
		double scale = 1.0;
		if (baselineMean > 0 && Double.isFinite(baselineMean)) {
			scale = Math.sqrt(targetArea_m2 / baselineMean);
		}
		if (!Double.isFinite(scale)) scale = 1.0;
		scale = Math.max(0.1, Math.min(10.0, scale));
		leafSizeScale = scale;
		leafTargetArea_m2 = targetArea_m2;
		leafScaleInitialized = true;
			if (printFlag) {
				println("[Leaf] meanLeafArea_m2=" + targetArea_m2 +
					", baselineRanks=1-" + refMaxRank +
					", baselineMean=" + baselineMean +
					", leafSizeScale=" + leafSizeScale);
			}
		}

	void initiate_pb(PlantBase pb, int Rank, int NodeNumber, int CordonNumber)
	{ 
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS
		this.plantBaseID = pb.nodeID;
		plantNumber = pb.plantNumber;
		border = pb.border;
		rank = Rank;
		nodeNumber = NodeNumber; 
		cordonNumber = CordonNumber;
		age = pb.age - (rank+4) * plastochron;
		cpn = Rank;
		order = 0; 
		assignAge(pb, cpn);
		//STATE VARIABLES
			//STATE VARIABLES
		double targetMeanLeafArea_m2;
		try {
			targetMeanLeafArea_m2 = pb.meanLeafAreaTarget_m2;
		} catch (NoSuchFieldError e) {
			// Compatibility fallback: older serialized/runtime PlantBase may miss this field.
			targetMeanLeafArea_m2 = 0.0;
		} catch (RuntimeException e) {
			// Some GroIMP/Groovy runtimes surface missing fields as a runtime MissingPropertyException
			// that is not available as a compile-time type in RGG.
			if ("groovy.lang.MissingPropertyException".equals(e.getClass().getName())) {
				targetMeanLeafArea_m2 = 0.0;
			} else {
				throw e;
			}
		}
		int rankIdx = (Rank == 0) ? 1 : Rank;
		boolean useTargetMeanLeafAreaScaling = scaleLeafSizeToTargetMeanLeafArea && (targetMeanLeafArea_m2 > 0);
		try {
			if (useTargetMeanLeafAreaScaling) {
				initLeafSizeScaleIfNeeded(targetMeanLeafArea_m2, fid);
				length = organSize[rankIdx][1] * leafSizeScale;
				width = organSize[rankIdx][2] * leafSizeScale;
			} else {
				length = organSize[rankIdx][1];
				width = organSize[rankIdx][2];
			}
		} catch (ArrayIndexOutOfBoundsException e) {
			double fallbackLength = organSize[MAX_PHYTOMER_NUM][1];
			double fallbackWidth = organSize[MAX_PHYTOMER_NUM][2];
			if (useTargetMeanLeafAreaScaling) {
				length = fallbackLength * leafSizeScale;
				width = fallbackWidth * leafSizeScale;
			} else {
				length = fallbackLength;
				width = fallbackWidth;
			}
		} finally {
			if(length == 0) length = 5e-2;
			if(width == 0) width = length;
		}
		
		this.potLength = length; 
		
		calcLeafRH();
		//calcShapeCoefficient();
		lobe = getLobes();
		lwRatio	 = getRefLength()/getRefWidth();
		//use fixed lwratio based on the reference leaf to make the area calculation more acculate
		width = length/lwRatio;
				
		//leaf shape stuffs
		numFacets = polyleaf[lobe].length;	
		area = calcLeafPolygonArea(length, width, fid);
		
		//CARBON
		biomass = area*density;
		
		//NITROGEN
		  // seed PPFD buffer & assign initial traits with a benign PPFD10
		for (int i = 0; i < PPFD_BUF_LEN; i++) ppfdBuf[i] = 10.0;
		ppfdIdx = 0; ppfdCount = PPFD_BUF_LEN;
		assignLeafTraits(0.0, 10.0);  // will be refined once real layer is known
		//leafNcontent = inputLeafN ? leafNContent_input : nitrogen_total * mgTogram/area;
		
		// Initialize carbon and nitrogen content based on biomass and 
		//carbon and nitrogen concentration
		this.initCN_content(this.biomass);
		
		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential+1e-2;;
		waterPotential_pre = waterPotential;
		
		this.organType = "Leaf";
		Gxltranspi = Gxlmin;
		numFacets = polyleaf[lobe].length;
		initFromArchReader = false;
		TT_birth = tt;
		
		
	}

	void initiate_fieldRandomCanopy(PlantBase pb,
									double leafLength_,
									int patchId_,
									int layerId_,
									double zmin_,
									double lad_)
	{
		loadParameters();

		this.plantBaseID = pb.nodeID;
		this.plantNumber = pb.plantNumber;
		this.border = pb.border;

		this.rank = 0;
		this.nodeNumber = 0;
		this.cordonNumber = 0;
		this.order = 0;
		this.cpn = 0;

		this.fieldPatchId = patchId_;
		this.fieldLayerId = layerId_;
		this.fieldLayerZmin = zmin_;
		this.fieldLayerLAD = lad_;

		this.shapeSpecies = getLeafShapeSpecies();
		this.initFromFieldCanopy = true;
		this.initFromArchReader = false;

		this.length = Math.max((float) leafLength_, 1e-3f);
		this.potLength = this.length;

		this.lobe = getLobes();
		this.lwRatio = getRefLengthForLeaf() / getRefWidthForLeaf();
		this.width = this.length / this.lwRatio;

		this.fid = 0;
		this.numFacets = polyleaf[lobe].length;
		this.area = leafShape.calcLeafPolygonArea(this.getLeafShapeSpecies(), this.length, this.width, this.fid);

		this.biomass = this.area * density;
		this.initCN_content(this.biomass);

		for (int i = 0; i < PPFD_BUF_LEN; i++) ppfdBuf[i] = 10.0;
		ppfdIdx = 0;
		ppfdCount = PPFD_BUF_LEN;
		assignLeafTraits(0.0, 10.0);

		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential + 1e-2;
		this.waterPotential_pre = this.waterPotential;

		this.organType = "Leaf";
		this.Gxltranspi = Gxlmin;
		this.TT_birth = tt;

		this.nodeID = this.getId();
		this.parentID = pb.nodeID;
	}

	/**
	 * Initializes the leaf parameters based on the given ApexService object.
	 * This method sets up various properties of the leaf, including its dimensions,
	 * carbon and nitrogen content, and state variables.
	 *
	 * @param a The ApexService object providing apex-specific information for leaf initialization.
	 */
	void initiate_apex(ApexService a)
	{ 
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS
		plantNumber = a.plantNumber;
		if(this.plantBaseID <= 0) { this.plantBaseID = first((* p:PlantBase, (p.plantNumber == this.plantNumber)*)).nodeID;}
		
		border = a.border;
		rank = a.rank;
		nodeNumber = a.nodeNumber; 
		cordonNumber = a.cordonNumber;
		cpn = a.cpn;
		order = a.order;
		age = Math.max(0.01 *plastochron, a.age - plastochron);
		
		//STATE VARIABLES
		length = initialLength;
		this.potLength = this.length; 
		
		calcLeafRH();		
		lobe = getLobes();
		lwRatio	 = getRefLength()/getRefWidth();
		width = this.initialLength/lwRatio; //use fixed lwratio based on the reference leaf to make the area calculation more acculate 
				
		area = calcLeafPolygonArea(length, width, fid);
		//CARBON
		biomass = area*density;
		//if (printFlag) { println("length : " + length + "width: "+ width + "area: " + this.area + " SLA " + SLA + "bomass: " + biomass); }
		
		//NITROGEN
		// Initialize carbon and nitrogen content based on biomass and 
		//carbon and nitrogen concentration
		this.initCN_content(this.biomass);
		// seed PPFD buffer & assign initial traits with a benign PPFD10
		for (int i = 0; i < PPFD_BUF_LEN; i++) ppfdBuf[i] = 10.0;
		ppfdIdx = 0; ppfdCount = PPFD_BUF_LEN;
		assignLeafTraits(0.0, 10.0);  // will be refined once real layer is known
		//leafNcontent = inputLeafN ? leafNContent_input : nitrogen_total * mgTogram/area;
		
		this.waterPotential_b = a.waterPotential;
		this.waterPotential = a.waterPotential+1e-2;;
		Gxltranspi = Gxlmin;
		numFacets = polyleaf[lobe].length;
		
		this.organType = "Leaf";
		initFromArchReader = false;
		
		PlantBase pb = getPlantBase();
		if (pb != null) {
			TT_birth = (Double.isNaN(pb.ageGdd) ? 0.0 : pb.ageGdd);
		} else {
			TT_birth = 0.0;
		}
		LMA_locked = false;
		LMA_lock   = Double.NaN;
		TT_lock    = Double.NaN;
			rosetteRankIndex = -1;
			rosetteLeafCount = 0;
			rosetteRankScale = 1.0;
			appleLeafDevelopmentClass = "";
			fastEarlyExpansionLeaf = false;
			rosetteExpansionScaleUsed = 1.0;
			updateRealizationRatio();
		}

	public void applyRosetteRankScaleAtInit() {
		if (!"rosetteLeaf".equals(this.organType)) return;
		double scale = rosetteRankScale;
		if (Double.isNaN(scale) || Double.isInfinite(scale)) return;
		scale = Math.max(0.05, Math.min(2.0, scale));
		this.maxLength = this.maxLength * scale;
		this.initialLength = this.initialLength * scale;
		this.length = this.length * scale;
		this.potLength = this.potLength * scale;
		if (Double.isNaN(this.lwRatio) || this.lwRatio <= 0) {
			this.lwRatio = getRefLength()/getRefWidth();
		}
		this.width = this.length / this.lwRatio;
	}
	
