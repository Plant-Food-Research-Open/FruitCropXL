// Module to adjust the angle between petiole and leaf
module JMidrib(super.angle) extends RL(angle)
{
    
	// ---- reference to the controlled leaf (ID-based, lazy resolved) ----
    private long   parentLeafId = 0L;     // set in initiate(Leaf)
    private transient Leaf leafRef = null;
    int rank = 1;
    float finalBladeInsertionAngle = 0;

    // NEW: sampled once per leaf
    float petioleDeclDeg = 45f;   // petiole declination wrt shoot
    float bladeRollDeg   = 0f;    // roll around midrib
    // bend angle is the results returned from calcLeafDeclination(int rank, int order, float scale) {
    float bladeBendDeg;
    // Constants (grapevine; Schmidt et al., 2019)
    static float i  = 50.2723362857435f;
    static float c1 = -6.1389930787212f;
    static float c2 = -5.44651247774916f;
    static float c3 = 0.474933577122149f;

    static float scaleFactor = 1.602614f;
    static float primaryAngleConstant = -40.0441f;
    static float lateralAngleConstant = -35.623863f;
    static float lateralMidribAngle   = -25.0179f;

    void initiateWithAngles(Leaf leaf, float petDeclDeg, float rollDeg) {
	 if (leaf != null) {
				this.parentLeafId = leaf.getId();
				this.leafRef = leaf;             // immediate use if valid now
				this.rank = leaf.rank;
			} else {
				this.parentLeafId = 0L;
				this.leafRef = null;
			}
			 // Sample angle scheme ONCE per leaf
			this.petioleDeclDeg = petioleDeclDeg; // ~N(90°-incl, sd)
			this.bladeRollDeg   = rollDeg;    // ~N(0, 0.3491 rad) in deg
    }

    // (optional) keep the old initiate() for backward-compat
    void initiate(Leaf leaf) {
        initiateWithAngles(
            leaf,
            samplePetioleDeclDeg(),
            sampleLeafRollDeg()
        );
    }

    // ---------- getters so rules can fetch the current scheme ----------
    float getPetioleDeclDeg() { return this.petioleDeclDeg; }
    float getBladeRollDeg()   { return this.bladeRollDeg; }

    // ---------- (optional) resample utilities if you ever need them ----------
    void resampleAngles() {
        this.petioleDeclDeg = samplePetioleDeclDeg();
        this.bladeRollDeg   = sampleLeafRollDeg();
    }

    	
	/** Get any node by id (null if id<=0 or not found). */
	public Node getNode(long id) {
		if (id <= 0) return null;
		return graph() != null ? (Node) graph().getNodeForId(id) : null;
	}
	
    	/** Get any Organ by id (null if not an Organ). */
	public Organ getOrgan(long id) {
		Node n = getNode(id);
		return (n instanceof Organ) ? (Organ) n : null;
	}
	
    // ---------- lazy resolver (safe for Java 1.5; assumes getOrgan(long) exists) ----------
    Leaf resolveLeaf() {
        if (leafRef != null) return leafRef;
        if (parentLeafId > 0L) {
            Organ o = getOrgan(parentLeafId);
            if (o instanceof Leaf) {
                leafRef = (Leaf) o;
                this.rank = leafRef.rank;
                return leafRef;
            }
            
        }
        return null;
    }

    // --------- sampling helpers (unchanged) ----------
    static float samplePetioleDeclDeg() {
        double x = PET_DECL_MEAN_DEG + PET_DECL_SD_DEG * rng.nextGaussian();
        return (float)Math.max(0, Math.min(85, x));
    }
    static float sampleLeafBendDeg() { return (float)(LEAF_BEND_MEAN_DEG + LEAF_BEND_SD_DEG * rng.nextGaussian()); }
    static float sampleLeafRollDeg() { return (float)(LEAF_ROLL_SD_DEG * rng.nextGaussian()); }
    
    
    
    // ---------- species-specific declination (grapevine vs apple) ----------
    static float calcLeafDeclination(int rank, int order, float scale) {
        float midribAngle = 1.0f;
        float res = -30;
        if (species.equals("grapevine")) {
            if (order == 0) {
                float lsl = scale / scaleFactor * 100f;
                midribAngle = i + c1*lsl + c2*rank + c3*lsl*rank + primaryAngleConstant;
            } else {
                midribAngle = lateralAngleConstant + lateralMidribAngle;
            }
            res = midribAngle - PET_DECL_MEAN_DEG;
            return res;     // petiole→blade offset around the petiole declination
            
        }  else if ("apple".equals(species)) {
         // simple: follow petiole insertion with small random deviation (±5°)
         res = Math.min(0, sampleLeafBendDeg());
         
         // midrib around petiole axis (0 means co-planar with petiole plane)
         return res;
      } else {
        return 0f;
      }
      
    }

    /**
     * Update and return the current blade declination (deg) relative to petiole.
     * Robust to missing leaf on first call:
     *  - If leaf can’t be resolved yet → use a safe default (55–65° for rosette; else 45°)
     *  - On later ticks, it will re-attempt resolution and switch to the calibrated angle.
     */
    float updateDeclinationAngle() {
        Leaf lf = resolveLeaf();

        // If we don't have the leaf yet, provide a safe default and retry next time.
        if (lf == null) {
            if (Math.abs(this.finalBladeInsertionAngle) < 1f) {
                // conservative default if no leaf object yet
                this.finalBladeInsertionAngle = 45f;
            }
            return this.finalBladeInsertionAngle; // static until we can resolve
        }

        // First-time setup of the final target angle
        if (Math.abs(this.finalBladeInsertionAngle) < 1f) {
            if ("rosetteLeaf".equals(lf.organType)) {
                finalBladeInsertionAngle = random(55, 65);     // apple rosette
            } else {
                finalBladeInsertionAngle = calcLeafDeclination(
                        lf.rank, lf.order, lf.getLengthScaleFactor());
            }
        }

        // Growth progression (from ~vertical to final angle)
        if (lf.age < 0.1f * lf.tm) {
            return 1.0f;
        } else if (lf.age < lf.te) {
            return finalBladeInsertionAngle * lf.age / lf.te;
        } else {
            return finalBladeInsertionAngle;
        }
    }
}
