	/** True when early-leaf fallback already calculated actual photosynthesis this step. */
	public transient boolean earlyLeafFallbackUsedThisStep = false;
	/** Diagnostic: true when this leaf has finite, positive light inputs for photosynthesis. */
	public boolean hasValidLeafLightForPhotosynthesis = false;

	public boolean shouldUseEarlyLeafPhotosynthesisFallback() {
		return shouldUseLAILeafPhotosynthesisFallback();
	}

	public String getLeafShapeSpecies() {
		if (shapeSpecies != null && shapeSpecies.length() > 0) return shapeSpecies;
		if (leafShapeSpecies != null && leafShapeSpecies.length() > 0) return leafShapeSpecies;
		return species;
	}

	public double getRefLengthForLeaf() {
		return leafShape.getRefLength(getLeafShapeSpecies());
	}

	public double getRefWidthForLeaf() {
		return leafShape.getRefWidth(getLeafShapeSpecies());
	}

	public boolean shouldContributeToActualWaterFlux() {
		return shouldCalcAnet() || earlyLeafFallbackUsedThisStep;
	}

	public boolean shouldUseLAILeafPhotosynthesisFallback() {
		if (!enableLAILeafPhotosynthesisFallback) return false;
		if (isLeafGasExchangeTestScenario()) return false;
		if (!calcPotential_PT) return false;
		if (globalRadiation <= LIGHT_THRESHOLD) return false;
		if (area <= 0.0) return false;

		double threshold = leafPhotosynthesisFallbackLAI;
		if (Double.isNaN(threshold) || Double.isInfinite(threshold) || threshold < 0.0) {
			threshold = 1.0e-4;
		}

		boolean lowLAI = FieldBase.lai <= threshold;
		boolean noFieldLight = !lightInterceptionComputed;
		boolean invalidLeafLight =
			continueFallbackUntilLeafLightValid &&
			!hasValidLeafLightForPhotosynthesis();

		return lowLAI || noFieldLight || invalidLeafLight;
	}

	public boolean hasValidLeafLightForPhotosynthesis() {
		boolean valid =
			area > 0.0 &&
			!Double.isNaN(absPAR) && !Double.isInfinite(absPAR) &&
			!Double.isNaN(incPARm2) && !Double.isInfinite(incPARm2) &&
			!Double.isNaN(absm2) && !Double.isInfinite(absm2) &&
			(absPAR > 0.0 || incPARm2 > 0.0 || absm2 > 0.0);
		hasValidLeafLightForPhotosynthesis = valid;
		return valid;
	}

	public void calcEarlyLeafPhotosynthesisFallback() {
		applyLAILeafPhotosynthesisFallback();
	}

	public void applyLAILeafPhotosynthesisFallback() {
		if (!shouldUseLAILeafPhotosynthesisFallback()) return;

		/*
		 * Units: globalRadiation is a radiation flux density; multiplying by the
		 * fallback fPAR gives a provisional incident PAR flux density
		 * (umol m-2 s-1) only when the proper light model is unavailable.
		 */
		double fallbackFpar = leafPhotosynthesisFallbackFpar;
		if (Double.isNaN(fallbackFpar) || Double.isInfinite(fallbackFpar)) fallbackFpar = 0.30;
		if (fallbackFpar < 0.0) fallbackFpar = 0.0;
		if (fallbackFpar > 1.0) fallbackFpar = 1.0;
		double fallbackPARm2 = Math.max(0.0, globalRadiation * fallbackFpar);

		incPARm2 = fallbackPARm2;
		absm2 = fallbackPARm2;
		absPAR = fallbackPARm2 * Math.max(0.0, area);
		abs = absPAR;
		fpar = fallbackFpar;
		fabs = fallbackFpar;

		updateWindSpeed();
		earlyLeafFallbackUsedThisStep = true;
		hasValidLeafLightForPhotosynthesis();
		calcPotentialPhotosynthesis();
	}

	public void calcActualPhotosynthesisForFallback() {
		calcActualPhotosynthesisAndTranspiration();
		if (Double.isNaN(AlimActual) || Double.isInfinite(AlimActual)) AlimActual = 0.0;
		if (Double.isNaN(carbonAssimilation) || Double.isInfinite(carbonAssimilation)) {
			carbonAssimilation = 0.0;
			assimilatedCO2 = 0.0;
		}
	}

	public double getRosetteExpansionScaleSafe() {
		double s = rosettePhyllochronFactor;
		if (Double.isNaN(s) || Double.isInfinite(s) || s <= 0.0) s = 1.0;
		if (s > 1.0) s = 1.0;
		return s;
	}

	public void markFastEarlyExpansionLeaf(String developmentClass) {
		appleLeafDevelopmentClass = developmentClass;
		fastEarlyExpansionLeaf = true;
		double s = getRosetteExpansionScaleSafe();
		tm = tm * s;
		te = te * s;
		if (tm < 1.0) tm = 1.0;
		if (te <= tm) te = tm + 1.0;
		rosetteExpansionScaleUsed = s;
	}

