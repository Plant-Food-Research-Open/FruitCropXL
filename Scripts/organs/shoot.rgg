	void initiate_reconstruction(PlantBase pb, int i, int shootNumber, int k, int l, boolean isPrimary)
	{
		this.shootNumber = shootNumber;
		this.primaryShoot = isPrimary;
		initiate_pb(pb, i, k, l);
		
	}
	
