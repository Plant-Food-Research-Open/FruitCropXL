	@Override
	public void initializeCarbonTransport() {
		double length_cm = this.length * 1e2;
	    double area_cm2   = this.area * 1e4;
		float Rs = ( R0 * PhloemResistanceRatio_mixture(initial_c0, FRACTION_SORBITOL)/(PressureRatio(initial_c0)*R_ct*Tk));   // resistance per unit length (initial case)
		this.r =  Rs * length_cm / area_cm2; //r is in unit of cm //divided by diameter
		
		float h_internode_rs = 0; //1/o.Ka /3.6; 	// hydraulic resistance
		this.xp = 0;//(-Jw * h_internode_rs * initial_c0)/(PressureRatio(initial_c0)*R*Tk);  //need to update this term
		
		this.cpb = this.cpt =  SOURCEcp;
		 
		//this.cpt = SOURCEcp - cpn * ini_length * SOURCEj * Rs;
		//this.cpb = SOURCEcp - (cpn - 1) * length * SOURCEj * Rs;
		this.j = j;
	}
	@Override
	public void updateCTRs(double carbonConcentration) {
		double length_cm = this.length * 1e2;
	    double area_cm2   = this.area * 1e4;
		float Rs = ( R0 * PhloemResistanceRatio_mixture(carbonConcentration, FRACTION_SORBITOL)/(PressureRatio(carbonConcentration)*R_ct*Tk));   // resistance per unit length (initial case)
		this.r =  Rs * length_cm / area_cm2; //r is in unit of cm //divided by diameter
		float h_internode_rs = 1/this.Ka/3.6; 	// hydraulic resistance
	  
		if (this.waterFlux == 0 | Double.isNaN(this.waterFlux)) {
			 this.xp = 0;
		} else {	  		
			 this.xp = Double.isNaN(this.waterFlux)? 
			 0 : 
			 Math.max(0,(this.waterFlux * 3.6 * h_internode_rs * carbonConcentration)/
								  (PressureRatio(carbonConcentration)*R_ct*Tk));
		}
		
		
	}		
	
	/**
     * Potential early radial growth (logistic phase) of a young internode.
     *
     * <p>This is the developmental/temperature-driven radial increment for the early primary
     * expansion phase before water and carbon limitation are applied. It is paired with
     * {@link #radiusLogisticPhase()} (water-limited) and is used in {@code calcUnloading(...)}
     * to apply a dominant-limiter rule ({@code min(fw, fc)}) consistently to both internode
     * primary elongation and early radial expansion.
     *
     * @return Potential early radial increment (m per timestep)
     */
    double radiusLogisticPhasePotential() {
    	double dt = this.age - this.age_pre;
    	refreshMaxDiameterFromTopologyIfNeeded();
    	//the function is sensitive to scale, so need to use mm
    	//double newMaxLength = Math.max(10, this.maxLength* lengthPotentialRatio * 1000);  //mm
		//maxDia_phase1 = dia_a * Math.pow(newMaxLength, dia_b)/1000;
		if (Double.isNaN(dt) || Double.isInfinite(dt) || dt <= 0) {
			dt = 1.0;
		}
		
        double r_growthRate = betaGrowthRate(this.age, this.maxDia_phase1/2, this.tm, this.te) * dt;
        if (Double.isNaN(r_growthRate) || Double.isInfinite(r_growthRate)) {
        	r_growthRate = 0.0;
        }
		double targetRadius = this.maxDia_phase1 / 2.0;
		double currentRadius = this.diameter / 2.0;
		double remaining = Math.max(0.0, targetRadius - currentRadius);
		r_growthRate = Math.min(r_growthRate, remaining);
        return r_growthRate;
    }

    /**
     * Water-limited early radial growth (logistic phase) for young internodes.
     *
     * <p>Equivalent to {@code radiusLogisticPhasePotential() * fw} for the current water status.
     *
     * @return Water-limited early radial increment (m per timestep)
     */
    float radiusLogisticPhase() {    
    	double r_growthRate = radiusLogisticPhasePotential();
        if(organGrowthMethod.equals("TempLimited")) {
        	return r_growthRate;
        } else return r_growthRate * waterPotentialRes(this.waterPotential, this.growth_a, this.growth_b); 
    }

		boolean isPerennialWoodyOrgan() {
			if (this.organType == null) return false;
			String type = this.organType.toLowerCase();
			return type.indexOf("cordon") >= 0 ||
				   type.indexOf("trunk") >= 0 ||
				   type.indexOf("oldshoot") >= 0 ||
				   type.indexOf("old_shoot") >= 0 ||
				   type.indexOf("old shoot") >= 0 ||
				   type.indexOf("cane") >= 0 ||
				   type.indexOf("arm") >= 0 ||
				   type.indexOf("upright") >= 0 ||
				   type.indexOf("spur") >= 0 ||
				   type.indexOf("dropper") >= 0;
		}

		boolean shouldKeepWoodyLengthFixed() {
			return isPerennialWoodyOrgan();
		}

		boolean useTempLimitedPerennialSecondaryGrowth() {
			return "TempLimited".equalsIgnoreCase(organGrowthMethod) && isPerennialWoodyOrgan();
		}

		int getCurrentSecondaryGrowthSeasonKey() {
			try {
				return year;
			} catch (Throwable t) {
				return START_YEAR + (day / 365);
			}
		}

		double capPerennialSeasonalDeltaRadius(double proposedDeltaRadius) {
			if (!useTempLimitedPerennialSecondaryGrowth()) {
				return proposedDeltaRadius;
			}
			if (Double.isNaN(proposedDeltaRadius) || Double.isInfinite(proposedDeltaRadius) || proposedDeltaRadius < 0.0) {
				return 0.0;
			}
			if (Double.isNaN(this.diameter) || Double.isInfinite(this.diameter) || this.diameter <= 0.0) {
				return 0.0;
			}

			// Cap TempLimited trunk/cordon secondary growth to 0.005 m diameter per season.
			double maxSeasonRadiusIncrease = 0.0025;
			int currentSeason = getCurrentSecondaryGrowthSeasonKey();
			if (secondaryGrowthSeasonYear != currentSeason ||
				secondaryGrowthSeasonStartDiameter <= 0.0 ||
				Double.isNaN(secondaryGrowthSeasonStartDiameter) ||
				Double.isInfinite(secondaryGrowthSeasonStartDiameter)) {
				secondaryGrowthSeasonYear = currentSeason;
				secondaryGrowthSeasonStartDiameter = this.diameter;
			}

			double seasonDiameterIncrease = Math.max(0.0, this.diameter - secondaryGrowthSeasonStartDiameter);
			double remainingRadius = Math.max(0.0, maxSeasonRadiusIncrease - seasonDiameterIncrease / 2.0);
			return Math.min(proposedDeltaRadius, remainingRadius);
		}

		double capTempLimitedPerennialDiameterUpdate(double candidateDiameter, double currentDiameter) {
			if (!useTempLimitedPerennialSecondaryGrowth()) {
				return candidateDiameter;
			}
			if (Double.isNaN(currentDiameter) || Double.isInfinite(currentDiameter) || currentDiameter <= 0.0) {
				return currentDiameter;
			}
			if (Double.isNaN(candidateDiameter) || Double.isInfinite(candidateDiameter) || candidateDiameter <= 0.0) {
				return currentDiameter;
			}

			// Final geometry guard: no more than 0.005 m diameter increase per season.
			double maxSeasonDiameterIncrease = 0.005;
			int currentSeason = getCurrentSecondaryGrowthSeasonKey();
			if (secondaryGrowthSeasonYear != currentSeason ||
				secondaryGrowthSeasonStartDiameter <= 0.0 ||
				Double.isNaN(secondaryGrowthSeasonStartDiameter) ||
				Double.isInfinite(secondaryGrowthSeasonStartDiameter)) {
				secondaryGrowthSeasonYear = currentSeason;
				secondaryGrowthSeasonStartDiameter = currentDiameter;
			}

			double seasonIncreaseNow = Math.max(0.0, currentDiameter - secondaryGrowthSeasonStartDiameter);
			double remainingDiameter = Math.max(0.0, maxSeasonDiameterIncrease - seasonIncreaseNow);
			double proposedIncrease = Math.max(0.0, candidateDiameter - currentDiameter);
			return currentDiameter + Math.min(proposedIncrease, remainingDiameter);
		}

		double secondaryGrowthDeltaRadiusForCordonTrunk(double sugarConcentration_phloem, boolean potentialPath) {
			double dr = secondaryGrowthRate();
			if (useTempLimitedPerennialSecondaryGrowth()) {
				dr = capPerennialSeasonalDeltaRadius(dr);
			}
			if (!potentialPath) {
				dr *= sinkUnloading(sugarConcentration_phloem, km_sec);
			}
			dr *= woodySecondaryGrowthCarbonStatusScale();
			if (Double.isNaN(dr) || Double.isInfinite(dr) || dr < 0.0) {
				dr = 0.0;
			}
			return dr;
		}

		@Override
		void calcPTCTRAM(double sc)
	{
		calcLeakage(sc);
		double radius = this.diameter / 2;
		deltalength = (!shouldKeepWoodyLengthFixed() && this.age <= this.te) ? primaryGrowthRate() : 0;
		deltalength_PT = deltalength;
		
		double deltaRadius1 =  this.age <= this.te ? radiusLogisticPhase() : 0; 
		if(this.age <= this.te)  {
			deltaRadius = radiusLogisticPhase();
			structureDM_PRI_PT = C_content * growthCoff * Math.PI * radius * radius * density * deltalength + 
								 C_content *growthCoff * 2.0 * Math.PI * radius * length * density *deltaRadius;	
			
		} else if(this.age > this.te && this.age <= this.te + this.te_sec)  {
			//cambial grwoth;
			deltaRadius = secondaryGrowthRate();
			if (isAnnualShootInternode()) {
				double remainingSecondary = Math.max(0.0, pipeDiaMax / 2.0 - this.diameter / 2.0);
				deltaRadius = Math.min(deltaRadius, remainingSecondary);
			}
			deltaRadius *= woodySecondaryGrowthCarbonStatusScale();
			structureDM_SEC_PT = C_content *growthCoff * 2.0 * Math.PI * radius * length * density *deltaRadius;
			structureDM_PRI_PT = 0; 
		}
		if (shouldSyncAnnualInternodeBiomassFromLeaves()) {
			structureDM_PRI_PT = leafAllometryStructuralDemandForInternode(sc, true);
			structureDM_SEC_PT = 0;
		}
        
		if(shouldLignify()) this.calcLignification();
       
      //if (printFlag) { println(" lignificationDemand " + lignificationDemand + "structureDM_SEC_PT " + structureDM_SEC_PT + " maintenanceDM_PT " + maintenanceDM_PT ); }
		maintenanceDM_PT = calcMaintanceRespiration(this.fNSCtoSC); 
		reserveDM_PT = reserveSynthesis();
		loading_PT =  reserveHydrolysis(); 
	}
	
	boolean shouldLignify() {
		if(FruitService.veraison == true && ageAtVeraison <= 0.5) {
			ageAtVeraison = age;
		}
		return(FruitService.veraison && (this.age - this.ageAtVeraison) < te);
	}
	
	
	void calcLignification()
	{
		double dt = this.age - this.age_pre; //this dt include temperature effect	

		lignificationDemand =   this.carbon_structure * (CORDON_DENSITY/this.density - 1) * 
								betaGrowthRate(this.age - this.ageAtVeraison+3, 1, this.tm, this.te) * dt; 		
	    //if (printFlag) { println("this is loading from internode " + "node " + nodeNumber + " rank "+ this.rank + " loading " + loading); }
	}
	
	@Override
	void calcLoading(double sugarConcentration_phloem)
	{
		loading =  fNSC > MINIMUM_NSC ? reserveHydrolysis() * 
				   sourceLoading(sugarConcentration_phloem, sourceLoading_b, sourceLoading_cp) : 0;
	    //if (printFlag) { println("this is loading from internode " + "node " + nodeNumber + " rank "+ this.rank + " loading " + loading); }
	}
		
	@Override
	void calcUnloading(double sugarConcentration_phloem)
	{
		//internode has two structural demand part, length growth and diameter
		//diameter growth has two parts: short-term logistic expansion for young
		//internodes, and long-term radial expansion that is proportional to the internode�s surface area.
		// Primary internode elongation and early radial expansion use a dominant-limiter rule
		// (min of water limiter fw and carbon sink limiter fc) to avoid compounding stress
		// as fw * fc. Secondary growth and reserve/maintenance paths remain unchanged.
		double radius = this.diameter / 2;
		double fc_pri = sinkUnloading(sugarConcentration_phloem, km_pri);
		if (Double.isNaN(fc_pri) || Double.isInfinite(fc_pri)) fc_pri = 0.0;
		if (fc_pri < 0.0) fc_pri = 0.0;
		if (fc_pri > 1.0) fc_pri = 1.0;
		if (shouldUsePreT1PotentialGrowth()) {
			fc_pri = 1.0;
		}
		double fw_pri = primaryGrowthWaterEffect();
		double stress_pri = (fw_pri < fc_pri) ? fw_pri : fc_pri;
		if (shouldSyncAnnualInternodeBiomassFromLeaves()) {
			// In leafAllometry mode, biomass follows leaf allometry; keep primary geometry carbon-neutral.
			stress_pri = fw_pri;
		}
		
		deltalength = (!shouldKeepWoodyLengthFixed() && this.age <= this.te) ? primaryGrowthPotential() * stress_pri : 0;
        
        if(this.age <= this.te)  {
			// Use the same dominant limiter rule for internode primary elongation and
			// early radial expansion to avoid compounding water and carbon limits.
			deltaRadius = radiusLogisticPhasePotential() * stress_pri;
                          
            structureDM_PRI = C_content * growthCoff * Math.PI * radius * radius * density * deltalength + 
				              C_content *growthCoff * 2.0 * Math.PI * radius * length * density *deltaRadius;	
			structureDM_SEC = 0;				                 
		                          
		} else if(this.age > this.te && this.age <= this.te + this.te_sec)  {
			//cambial grwoth;
			deltaRadius = secondaryGrowthRate() * sinkUnloading(sugarConcentration_phloem, km_sec); 
			if (isAnnualShootInternode()) {
				double remainingSecondary = Math.max(0.0, pipeDiaMax / 2.0 - this.diameter / 2.0);
				deltaRadius = Math.min(deltaRadius, remainingSecondary);
			}
			deltaRadius *= woodySecondaryGrowthCarbonStatusScale();
			structureDM_SEC = C_content *growthCoff * 2.0 * Math.PI * radius * length * density *deltaRadius;
			structureDM_PRI = 0; 
		}
		if (shouldSyncAnnualInternodeBiomassFromLeaves()) {
			structureDM_PRI = leafAllometryStructuralDemandForInternode(sugarConcentration_phloem, false);
			structureDM_SEC = 0;
		}
				  
        
        if(shouldLignify()) { 
        	this.calcLignification();
        	//println("lignificationDemand: " + lignificationDemand);
        }
        
       	//need to separate the primary diameter growth and secondary growth	
      						  	
        structureDM = structureDM_PRI + structureDM_SEC + 
        			  lignificationDemand *
        			  sinkUnloading(sugarConcentration_phloem, km_sec);	
		        			  
        
		maintenanceDM = calcMaintanceRespiration(this.fNSCtoSC) * 
         				sinkUnloading(sugarConcentration_phloem, KM_MTNCE);
		
		reserveDM = reserveSynthesis() * sinkUnloading(sugarConcentration_phloem, km_res);			
		
		unloading = structureDM + maintenanceDM + reserveDM;
		
 		if(debug)
 		//if(true)
		{	
		checkForNaN(printFlag, // Assuming printFlag is already defined as true or false
            //"deltalength", deltalength,
            //"deltaRadius", deltaRadius,
            //"radius", radius,
            //"rank", rank,
           // "shootType", organType,
            //"structureDM_PRI", structureDM_PRI,
            //"structureDM_SEC", structureDM_SEC,
            "structureDM", structureDM,
            "maintenanceDM", maintenanceDM,
            "reserveDM", reserveDM);
           } 
					
	}
	
	void calcWaterFlux(double f_waterFlux) 
	{	
		waterFlux = f_waterFlux * sum((*this (-->)+ v:PhotosynthateOrgan *)[waterFluxPotential]) ; 				
	}
	//hydraulic conductivity per meter length of shoot calculated by diameter
	
	void calcKmax() {
		Kmax = Math.max(cx2 * Math.pow(diameter, cx3), cx2 * Math.pow(pipeDiaMin, cx3))
				/ this.length * 1e6; //mg  s-1 m MPa-1
	}
	
	void calcKa() {
		Ka = Kmax * 1/(1 + Math.pow(this.waterPotential/phi_stem, cx1));
	}
	
	void calcWaterPotential() 
	{
		if(parentID > 0 && plantBaseID > 0) {
			this.waterPotential_b = Math.min(getParent().waterPotential, getPlantBase().xylemWaterPotential);
		} else if(parentID <= 0 && plantBaseID > 0) {
			this.waterPotential_b = getPlantBase().xylemWaterPotential;
		} else {
			this.waterPotential_b = inputWaterPotential;
		}
			
		this.waterPotential = waterPotential_b - 1/Ka * this.waterFlux - Dw * gacc * this.length*1e-3; 
		if(Double.isNaN(this.waterPotential)) this.waterPotential = inputWaterPotential;
		
/* 		println("this rank:" + rank + " getParent().waterPotential " + getParent().waterPotential + 
				" getPlantBase()xylemWaterPotential " + getPlantBase()xylemWaterPotential + 
				"this water potential: " + waterPotential +	
				"waterFlux " + this.waterFlux); */
	}
		
	void updateWaterPotential()
	{
		calcWaterPotential();
		calcKa();
		calcWaterPotential();
	}
	
	void updateWaterFlux()
	{
		if(plantBaseID <= 0) {
			PlantBase pb = first((* this (<--)+ PlantBase*));
			if(pb != null) {
				this.plantBaseID = pb.getId();
			}
		}
		if(plantBaseID > 0) {
			calcWaterFlux(getPlantBase().f_waterFlux);
		}
	}
	
	@Override
	void update()
	{
		super.update();

		if(plantBaseID <= 0) {
			PlantBase pb = first((* this (<--)+ PlantBase*));
			if(pb != null) {
				this.plantBaseID = pb.getId();
			}
		}
		
		if (parentID <= 0) {  // Assuming 0 is an uninitialized ID
			GrowingOrgan parentOrgan = (GrowingOrgan) first((* this (<--)+ Internode*));
			if (parentOrgan != null) {
				storeParentId(parentOrgan);
				parentOrgan.addChildInternodeId(this.nodeID);
			}
		}
		
			
		if(shootShader == null) shootShader = this.age > 100 ?  cordonTexture : petiole;
		
		
		/** update organ size and area, potential length at certain time point if no stress besides temperature */
			biomass_pre = biomass;
			double prevLength = this.length;
			double prevDiameter = this.diameter;
			if (shouldKeepWoodyLengthFixed()) {
				this.potLength = prevLength;
				lengthPotentialRatio = 1.0;
				deltalength = 0.0;
				deltalength_PT = 0.0;
			} else {
				this.potLength = this.maxLength * betaGrowthFunction(this.age, this.tm, this.te);
				this.potLength = clampNonShrinkingPotentialLength(prevLength, this.potLength, this.maxLength);
				lengthPotentialRatio = (this.potLength > 1.0e-9) ? length / potLength : 1.0;
			}
			//if organGrowthMethod.equals("TempLimited") is true, length increase by potential length
					
			if(organGrowthMethod.equals("TempLimited")) {
				this.length = shouldKeepWoodyLengthFixed() ? prevLength : safePositiveOrFallback(this.potLength, prevLength);
				double cappedDiameter = capTempLimitedPerennialDiameterUpdate(diameter + 2 * deltaRadius_PT, prevDiameter);
				deltaRadius_PT = Math.max(0.0, 0.5 * (cappedDiameter - prevDiameter));
				this.diameter = safePositiveOrFallback(cappedDiameter, prevDiameter);
			} else if(organGrowthMethod.equals("TempWaterLimited")) {
				//the calculation of PT includes water potential response already
				this.length = length + deltalength_PT;
				this.diameter = diameter + 2 * deltaRadius_PT;
		} else if(organGrowthMethod.equals("TempWaterCarbonLimited")){
			this.length = length + deltalength;
			this.diameter = diameter + 2 * deltaRadius;
		} else {
			this.length = length + deltalength;
			this.diameter = diameter + 2 * deltaRadius;
		}
		
			double vol = calcVol(length, diameter);
		
			/** update organ carbon and nitrogen status */
			if(organGrowthMethod.equals("TempLimited")) {
				biomass = safePositiveOrFallback(vol * density, biomass_pre);
				this.initCN_content(this.biomass);
			} else {
			delta_str = structureDM - growthCost; //maintenanceDM + reserveDM
			delta_NSC = maintenanceDM + reserveDM + leakage 
						- loading - carbonMobilizationCost - maintenanceDM_PT;
						   
			updateCarbonStatus(delta_str, delta_NSC);
		
			if(Double.isNaN(this.biomass)) {
				this.initCN_content(this.biomass_pre);
			}
		}
/* 		println(" delta_str " + delta_str + "delta_NSC " + delta_NSC + " carbon_structure " +
					carbon_structure + "carbon_nonStructure" + carbon_nonStructure);
					
		if (printFlag) { println(" biomass " + biomass + "fNSCtoSC " + fNSCtoSC ); }
		 */
			km_res = adjustKmResSeasonally(daysSinceWinterSolstice, km_res_early, km_res_late);	
			updateRealizationRatio();
			calcKmax();
			calcKa();
		//calcNdegradation();
		//calcNSynthesis(); 
		//nitrogen_total = nitrogen_structure + nitrogen_nonStructure;
	}
}
==> if (border == false) (
		Cylinder(length,diameter/2).(setLayer(border?borderLayer:0), 
				setShader(new AlgorithmSwitchShader(shootShader,LightOpaqueShader))
		) //cylinder settings
		
	) else (
		Cylinder(length,diameter/2).(setLayer(border?borderLayer:0), setShader(new AlgorithmSwitchShader(shootShader,LightOpaqueShader)))
	)
