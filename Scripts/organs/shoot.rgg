// Module for joint between internodes
module Joint extends RP(new Point3d(0, 0, 0), 0)
{
	
	// Constants used in calcStrength
	static final float setStrength = 0.3;
	static final float strength45 = 0.15;
	static final float maxUpwardStrength = 0.5;
	
	int rank; // Used to determine how strong tropism of Joint will be
		
	void initiate(Internode i)
	{
		this.rank =  Math.max(i.rank,1);
	}
	
	void initiate(Point3d target, float strength, int rank)
	{
		this.target = target; 			// Point tropism moves towards
		this.strength = strength;		// Strength of tropism
		this.rank = Math.max(rank,1);
	}
	
	// Set the tropism for repositioning growing internodes in dynamic architecture
	void setTropism(ApexService a)
	{
		this.target = calcTarget(a);
		this.strength = calcStrength(a);
	}

	// Get target for tropism for repositioning growing internodes in dynamic architecture
	static Point3d calcTarget(ApexService a)
	{
		Point3d currentLocation = location(a);
		return new Point3d(currentLocation.x, currentLocation.y, currentLocation.z + 10);
	}
	
	// Get the strength of the tropism based on the current orientation of the apex
	static float calcStrength(ApexService a) 
	{
		Vector3d dir = new Vector3d();
		dir = direction(a);
		Vector3d z = new Vector3d(dir.x, dir.y, 0);
		float strength = setStrength;
		if(dir.z < 0){
			strength = angle(dir, z) / 45;
			if(strength < setStrength) {strength = setStrength;}
		}
		if(dir.z >= 0){
			if(angle(dir, z) >= 45){
				strength = strength45;
			}
		}
		if(strength > maxUpwardStrength){
			strength = maxUpwardStrength;
		}
		double scaledStrength = strength * JOINT_TROPISM_SCALE;
		if (Double.isNaN(scaledStrength) || Double.isInfinite(scaledStrength)) {
			scaledStrength = strength;
		}
		scaledStrength = Math.max(0.0, Math.min(1.0, scaledStrength));
		return (float) scaledStrength;
	}
}
