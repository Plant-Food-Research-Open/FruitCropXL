// internode module, parameterized for annual stem segment
module Internode extends GrowingOrgan
{
	/** Type of shoot (e.g., spurs, vegetative shoots), mainly for apple. 
    can be potentially combined with budType*/
    String shootType="";
    
	double deltaRadius;
	double deltaRadius_PT;
	double secondaryGrowthSeasonStartDiameter = -1.0;
	int secondaryGrowthSeasonYear = -9999;
	double highestBend = 0;
	/** for dealing with multiple shoots from the same node, 
		Increase shoot number if another shoot has been produced from this node*/
	int shootNumber;
	/**This is to track the number of branching happens in one growing season and to control the bud behaviour*/
	int syllepticOrder; 
	boolean primaryShoot;
	double lignificationDemand;
	double ageAtVeraison;
	/** Saved leaf-allometry frozen potential demand, mg dry matter step-1 before ratio. */
	public boolean leafAllometryFrozenPotentialDemandValid = false;
	/** Saved leaf-allometry frozen actual demand, mg dry matter step-1 before ratio. */
	public boolean leafAllometryFrozenActualDemandValid = false;
	/** Saved leaf-allometry frozen potential demand, mg dry matter step-1 before ratio. */
	public double leafAllometryFrozenPotentialDemand = Double.NaN;
	/** Saved leaf-allometry frozen actual demand, mg dry matter step-1 before ratio. */
	public double leafAllometryFrozenActualDemand = Double.NaN;
	  
	Shader shootShader;
	/** maximum diameter for the fast growth phase of the internode
	 * 1.5e-2;	//maximum 15 mm for the logistic growth phase
	 */
	double maxDia_phase1;  	  
	boolean maxDiameterResolvedFromTopology = false;
	double lastDiameterTopologyUpdateAge = -9999.0;
	int lastDistalNodeCount = -1;
	double initialDia;
	double CORDON_DENSITY;
	/**
	 * Shoot vigour factor (unitless).
	 * 
	 * This scaling factor modulates the radial growth potential of shoots or internodes
	 * based on site-specific or plant-level variability in vigour.
	 * It can be influenced by genotype, environmental stress, parent shoot status,
	 * or competition from nearby sinks.
	 * 
	 * Typical range: 0.7 (low vigour) to 1.2 (high vigour).
	 */
	double fvigour; 
	/**
	 * Cambial duration for secondary growth (te_sec), in thermal days.
	 * 
	 * Represents the length of the secondary growth period after primary elongation.
	 * Used in young internodes to limit the duration of cambial activity, typically
	 * lasting 20–40 days after elongation ends.
	 */
	double te_sec;
	/**
	 * Diameter scaling coefficient ‘a’ for allometric function.
	 * 
	 * Used in the internode diameter-length relationship:
	 * d = dia_a × L^b
	 * 
	 * Species-specific parameter — e.g., 1.2 for grapevine, 0.9 for apple.
	 */
	//double dia_a;
	/**
	 * Diameter allometric exponent ‘b’ in the function:
	 * d = dia_a × L^dia_b
	 * 
	 * Empirically derived, typically around 0.35 for both apple and grapevine.
	 * Captures nonlinear scaling between internode length and diameter during primary growth.
	 */
	//double dia_b;
	/**current length vs potential length causued by reductions*/
	double lengthPotentialRatio = 1.0;
	/** Realized-to-potential final size ratio (-), for calibration/export. */
	public double realizationRatio = 1.0;
	//hydraulic conductivity for shoot 
	//Rx decrease with diameter, and increase with length. The trunk crossing area for the reference Rx value is 35 cm^2
	//the diameter is 6.66 cm. from W�nsche J.N., Palmer J.W. & Greer D.H. (2000) Hall and Minchin., 2013
	//const float Rx = 3.62e-4;  //362 kg-1 s m-1 MPa = 362/1e6 mg-1 s m-1 MPa; resistance per meter length of xylem  Rx times length get the resistance for one internode from Hall and Minchin., 2013
	//from Rami et al., 2018 HydroShoot
	float cx1 				; //= 1.171;  //shape parameters for the curve of shoot Ks decrease with water potential
	float cx2 				; //= 1.6;  //relationship between diameter and Ks
	float cx3 				; //= 2.0; //c?2 and c?3 are dimensionless shape parameters, mostly given within the ranges of [2.5, 2.8] and [2.0, 5.0], respectively (Tyree and Zimmermann, 2002).
	float phi_stem 			; //= -0.76; //shape factor regulating the steepness of the reduction in K due to caviation
 	

	
	transient WaterFluxTask wftask;
	//transient GrowthTask gtask;
	{
		wftask = new WaterFluxTask(this);
		//gtask = new GrowthTask(this);
	}

	void updateRealizationRatio() {
		double ratio = 1.0;
		if (potentialFinalSize > 1.0e-12 && !Double.isNaN(potentialFinalSize) && !Double.isInfinite(potentialFinalSize)) {
			ratio = realizedFinalSize / potentialFinalSize;
		}
		if (Double.isNaN(ratio) || Double.isInfinite(ratio)) ratio = 1.0;
		realizationRatio = Math.max(0.0, ratio);
	}
	 
	@Override
	public void loadParameters() {
			
		/** Set the context for file name parameters*/
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();

		
		/** Configuration context for internode carbon-related parameters */
		config.setCategoryContext("internode-carbon");
		//common parameters
		maintenanceCoff        = config.getDouble("MTNCE", 7.67e-05);
		growthCoff             = config.getDouble("GROWTHRQ", 1.2);		
		C_content              = config.getDouble("C_CONTENT", 0.46);
		maxRes                 = config.getDouble("RESERVES", 0.2);
		
		/** pass the plant level carbon parameters*/
		km_pri                 = config.getDouble("KM_PRI", 0.05);
		km_sec                 = config.getDouble("KM_SECONDARY", 0.12); 
		configureReserveKmAbsolute(config, 0.48, 0.096);
		
			/** Nonstructural carbon hydrolysis and synthesis rates (h-1). */
			configureReserveTurnover(config, 0.0060, 0.0010);
		
		tm	 = config.getDouble("tm", 5);
		te	 = config.getDouble("te", 8);
		initialLength = config.getDouble("initialLength", 1e-2);
		maxLength = config.getDouble("Lmax", 0.1);
		
		//New secondary growth
		secondaryGrowthRate = config.getDouble("SEC_GROWTH_RATE", 7e-06);
		secBase = 0.0;
		secBump = 0.0;
		k_age = 0.0;
		fvigour = config.getDouble("fvigour", 1.0);
		te_sec  = config.getDouble("te_sec", 25.0);
		
	/* 	dia_a  = config.getDouble("dia_a", 1.2);
		dia_b  = config.getDouble("dia_b", 0.35); */
		//the function is sensitive to scale, so need to use mm
		
		
		// Diameter at initiation:
		// - Annual shoots: topology-based taper from planned distal node count.
		// - Other internodes: keep existing allometry.
		try {
			// pipe_alpha units: m diameter increment per distal annual-shoot node.
			pipe_alpha = config.getDouble("pipe_alpha", Double.valueOf(pipe_alpha).doubleValue());
			pipeDiaMin = config.getDouble("pipeDiaMin", Double.valueOf(pipeDiaMin).doubleValue());
			pipeDiaMax = config.getDouble("pipeDiaMax", Double.valueOf(pipeDiaMax).doubleValue());
		
		} catch (Throwable t) {
			println("[Config] WARN: Failed to load pipe parameters; keeping in-memory defaults.");
			t.printStackTrace();
		}
		maxDia_phase1 = (pipeDiaMin + pipeDiaMax)/2;
		

		
		//println("maxLength: " + maxLength + " dia: " + maxDia_phase1);
		
		//SHOOT_DENSITY*1e6;  // times 1e6 to convert from mg/cm3 into mg/m3
		density = config.getDouble("SHOOT_DENSITY", 300) * 1e6;
		
		//use for calculating potential shoot density increase
		config.setCategoryContext("wood-carbon");
		CORDON_DENSITY = config.getDouble("CORDON_DENSITY", 750) * 1e6;
		
		/** Set the context for common plant level water parameters*/
		config.setCategoryContext("internode-water");
				
		cx1		 = config.getDouble("cx1", 1.171);
		cx2		 = config.getDouble("cx2", 2.6);
		cx3		 = config.getDouble("cx3", 2);
		phi_stem = config.getDouble("phi_stem", -2.5);
		
		growth_a	 = config.getDouble("growth_a", -10);
		growth_b	 = config.getDouble("growth_b", -0.6);
		
		waterContent = config.getDouble("WATER_CONTENT", 0.8);
		
		config.setCategoryContext("internode-nitrogen");
		/** Slope of Nm decline with thermal time (fraction per °C·d). */
		aN_slope = config.getDouble("aN_slope", -4.1e-6);
		
		/** Clamps for Nm and LMA. */
		Nm_min  = config.getDouble("Nm_min",  0.005);  // 0.5% N
		Nm_max  = config.getDouble("Nm_max",  0.020);  // 6.0% N
		

		
		
	/** INITIAL CONDITIONS*/	
	CategoryStore config_Init = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_INITIAL_CONDITIONS, 
		DocumentCategoryNameGroup.class)).getCategoryStore();
		
		config_Init.setCategoryContext("internode");
		fNSC                   = config_Init.getDouble("fNSC", 0.1);
		structure_C            = 1- fNSC; 
		Nm  = config_Init.getDouble("Nm",  0.020);  // 2.0% N
		lengthPotentialRatio = 1;
		
		
		
	}
	
	
	
	
	// internode initiation
	
	void initiate_pb(PlantBase pb, int i, int k, int l)
	{
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS
		plantBaseID = pb.nodeID;
		plantNumber = pb.plantNumber;
		border = pb.border;
		rank = Math.max(i, 1);
		nodeNumber = k; 
		cordonNumber = l;
		age = pb.age - (rank+4) * plastochron;
		//TAU = TAU_ITNDE;
		cpn = i;
		//it is very hard to give a consistent order for this ad it does not contains in the data
		//based on the i, k, l identification, this should be 3.
		order = 3; 
		assignAge(pb, this.cpn);
		
		
		if (!initiation_method.equals("ArchReader")) {
			initDimensions_DevelopmentRules();
		}
		this.potLength = length; 
		lengthPotentialRatio = 1;
		//CARBON
		biomass = woodBiomassCalcMethod == 0? BIOMASS_INTERNODE/(ENDING_PHYTOMER_NUM) :   
											  Math.PI * (diameter*diameter/4) * length * density; 
		area = Math.PI * (diameter*diameter/4); 											  
		
		freshWeight = biomass/(1-waterContent);
		carbon_total = biomass * C_content;
		carbon_structure = carbon_total * structure_C;  //mg, amount of structure carbon
		carbon_nonStructure = carbon_total * fNSC;    //mg, amount of starch carbon
		fNSCtoSC = carbon_nonStructure/carbon_structure; 
		fNSC = carbon_nonStructure/carbon_total;
		
		//NITROGEN
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total * (1 - N_CONTENT_MOBILE) -  nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		//water potential initialize		
		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential;
		calcKmax();
		calcKa();
			this.organType = "Internode";
			this.shootType = "F";
			if(shootShader == null) shootShader = this.age > 100 ?  cordonTexture : petiole;
			updateRealizationRatio();
		
	}
	
	// internode initiation
	Internode initiate_pi(PlantIdentifier pb, float length_, float diameter_)
	{
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS
		plantNumber = pb.plantNumber;
		border = pb.border;
			
		length = length_;
		diameter = diameter_;
		this.potLength = length;
		lengthPotentialRatio = 1;
		//CARBON
		biomass = Math.PI * (diameter*diameter/4) * length * density; 
		area = Math.PI * (diameter*diameter/4); 											  
		
		freshWeight = biomass/(1-waterContent);
		carbon_total = biomass * C_content;
		carbon_structure = carbon_total * structure_C;  //mg, amount of structure carbon
		carbon_nonStructure = carbon_total * fNSC;    //mg, amount of starch carbon
		fNSCtoSC = carbon_nonStructure/carbon_structure; 
		fNSC = carbon_nonStructure/carbon_total;
		//NITROGEN
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total * (1 - N_CONTENT_MOBILE) -  nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		//water potential initialize		
		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential+1e-2;
		calcKmax();
		calcKa();
			this.organType = "Internode";
			if(shootShader == null) shootShader = this.age > 100 ?  cordonTexture : petiole;
			updateRealizationRatio();
			return this;
	}
	
	
	
	void initiate_apex(ApexService a)
	{
		loadParameters();
		
		//IDENTIFIERS
		plantNumber = a.plantNumber;
		border = a.border;
		rank = Math.max(a.rank,1);
		nodeNumber = a.nodeNumber; 
		cordonNumber = a.cordonNumber;
		age = Math.max(1e-3, a.age - plastochron);
		
		this.order = a.order; 
		this.axis2ID = a.axis2ID; 
		this.axis3ID = a.axis3ID;
		this.axis4ID = a.axis4ID;
		this.axis5ID = a.axis5ID;
		this.axis6ID = a.axis6ID;
		this.axis7ID = a.axis7ID;
		this.axis8ID = a.axis8ID;
		this.axis9ID = a.axis9ID;
		this.cpn = axis2ID + axis3ID + axis4ID + axis5ID + axis6ID + axis7ID + axis8ID + axis9ID + rank;
		
		//TAU = TAU_ITNDE;
		//devAge = indeInitialDevAge();
		cpn = a.cpn ;
		order = a.order; 
		this.shootType = a.shootType;
		//This is to track the number of branching happens in one growing season and to control the bud behaviour
		this.syllepticOrder = a.syllepticOrder; 
		if(this.syllepticOrder == 0) 
		{
			this.primaryShoot = true;
		} else {this.primaryShoot = false;}
		this.shootNumber = resolveDynamicShootNumber(a);
		if ((printFlag || debug) && this.rank == 1) {
			println("[apple][internode-init] step=" + step
				+ " internodeId=" + this.getId()
				+ " apexId=" + ((a != null) ? a.getId() : 0L)
				+ " parentOrganId=" + ((a != null) ? a.parentID : 0L)
				+ " order=" + this.order
				+ " rank=" + this.rank
				+ " shootType=" + this.shootType
				+ " shootNumber=" + this.shootNumber
				+ " syllepticOrder=" + this.syllepticOrder
				+ " primaryShoot=" + this.primaryShoot
				+ " axis2=" + this.axis2ID
				+ " axis3=" + this.axis3ID
				+ " axis4=" + this.axis4ID
				+ " axis5=" + this.axis5ID
				+ " axis6=" + this.axis6ID
				+ " axis7=" + this.axis7ID
				+ " axis8=" + this.axis8ID
				+ " axis9=" + this.axis9ID
				+ " cpn=" + this.cpn);
		}
		
		length = initialLength;
		this.potLength = length;
		lengthPotentialRatio = 1;
		// Diameter at initiation:
		// - Annual shoots: topology-based taper from planned distal node count.
		// - Other internodes: keep existing allometry.
		int nAbove = estimateDistalNodeCountFromPlan(a);
		maxDia_phase1  = diameterFromDistalNodeCount(nAbove);
		lastDistalNodeCount = nAbove;
		lastDiameterTopologyUpdateAge = this.age;
		maxDiameterResolvedFromTopology = true;
		this.diameter  = pipeDiaMin;
		
		
		
		
		//Boltzmann_initialLength = indeInitialLength(rank);
		
		
		
		//CARBON
		biomass = Math.PI * (this.diameter*this.diameter/4) * this.length * density; 
		area = Math.PI * (diameter*diameter/4);
		
		freshWeight = biomass/(1-waterContent);
		carbon_total = biomass * C_content;
		carbon_structure = carbon_total * structure_C;  //mg, amount of structure carbon
		carbon_nonStructure = carbon_total * fNSC;    //mg, amount of starch carbon
		fNSCtoSC = carbon_nonStructure/carbon_structure; 
		fNSC = carbon_nonStructure/carbon_total;
		
		//NITROGEN		
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total * (1 - N_CONTENT_MOBILE) -  nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		
		calcKmax();
		this.waterPotential_b = a.waterPotential;
		this.waterPotential = a.waterPotential+1e-2;;
		calcKa();
			this.organType = "Internode";
			this.shootType = a.shootType;
			updateRealizationRatio();
		}
	
	
	private static double clampd(double v, double lo, double hi) {
		return (v < lo) ? lo : (v > hi) ? hi : v;
	}

	private boolean isAnnualShootInternode() {
		if (species == null) return false;
		if (this.organType == null || !this.organType.equalsIgnoreCase("Internode")) return false;
		return this.order >= 3;
	}

	boolean shouldSyncAnnualInternodeBiomassFromLeaves() {
		if (annualInternodeBiomassMode == null || !annualInternodeBiomassMode.equals("leafAllometry")) return false;
		if (isPerennialWoodyOrgan()) return false;
		return this.order >= 3;
	}

	private static int leafAllometryCacheStep = Integer.MIN_VALUE;
	private static java.util.Map leafAllometryDirectLeavesByInternode = new java.util.HashMap(); // Internode -> List
	private static java.util.Map leafAllometryFallbackLeafByInternode = new java.util.HashMap(); // Internode -> PhotosynthateOrgan
	private static java.util.Map leafAllometryFrozenPotentialDemandByInternode = new java.util.HashMap(); // Internode -> Double, mg dry matter step-1 before ratio
	private static java.util.Map leafAllometryFrozenActualDemandByInternode = new java.util.HashMap(); // Internode -> Double, mg dry matter step-1 before ratio

	private static boolean isLeafLikePhotosynthateOrgan(PhotosynthateOrgan organ) {
		if (organ == null || organ.organType == null) return false;
		return organ.organType.toLowerCase().indexOf("leaf") >= 0;
	}

	private static boolean usableLeafBiomass(PhotosynthateOrgan organ) {
		return isLeafLikePhotosynthateOrgan(organ) &&
			!Double.isNaN(organ.biomass) && !Double.isInfinite(organ.biomass) && organ.biomass > 0.0;
	}

	private static Internode nearestInternodeForLeaf(PhotosynthateOrgan organ) {
		if (organ == null) return null;
		try {
			return first((* organ (<--)+ parentLeafInternode:Internode *));
		} catch (RuntimeException ex) {
			return null;
		}
	}

	private double directLeafBiomassForInternode() {
		double leafBiomass = 0.0;
		for (PhotosynthateOrgan leafCandidate : (* this (-->)+ directLeafCandidate:PhotosynthateOrgan *)) {
			if (!usableLeafBiomass(leafCandidate)) continue;
			Internode owner = nearestInternodeForLeaf(leafCandidate);
			if (owner == this) {
				leafBiomass += leafCandidate.biomass;
			}
		}
		return leafBiomass;
	}

	private double nearbyLeafScore(Internode leafOwner, PhotosynthateOrgan lf) {
		double score = 1000000.0;
		if (leafOwner != null) {
			score = Math.abs(leafOwner.order - this.order) * 1000.0 +
				Math.abs(leafOwner.nodeNumber - this.nodeNumber) * 10.0 +
				Math.abs(leafOwner.rank - this.rank);
		} else if (lf != null) {
			score = Math.abs(lf.rank - this.rank) + 10000.0;
		}
		return score;
	}

	private double nearbyLeafBiomassForInternode() {
		double bestBiomass = Double.NaN;
		double bestScore = Double.POSITIVE_INFINITY;
		for (PhotosynthateOrgan leafCandidate : (* samePlantLeafCandidate:PhotosynthateOrgan,
			(samePlantLeafCandidate.plantNumber == this.plantNumber) *)) {
			if (!usableLeafBiomass(leafCandidate)) continue;
			Internode owner = nearestInternodeForLeaf(leafCandidate);
			if (owner != null && owner.getId() == this.getId()) continue;
			if (owner != null && !owner.shouldSyncAnnualInternodeBiomassFromLeaves()) continue;
			double score = nearbyLeafScore(owner, leafCandidate);
			if (score < bestScore) {
				bestScore = score;
				bestBiomass = leafCandidate.biomass;
			}
		}
		return bestBiomass;
	}

	private double annualInternodeLeafBiomassRatioSafe() {
		double k = annualInternodeLeafBiomassRatio;
		if (Double.isNaN(k) || Double.isInfinite(k) || k < 0.0) {
			k = 0.4;
		}
		return k;
	}

	private static double leafStructuralDemand(PhotosynthateOrgan leafCandidate, boolean potentialPath) {
		if (leafCandidate == null) return 0.0;
		double demand = potentialPath ? leafCandidate.structureDM_PRI_PT : leafCandidate.structureDM;
		if (Double.isNaN(demand) || Double.isInfinite(demand) || demand < 0.0) return 0.0;
		return demand;
	}

	private static double readLeafAllometryDoubleField(Object organ, String fieldName) {
		if (organ == null) return Double.NaN;
		Class c = organ.getClass();
		while (c != null) {
			try {
				java.lang.reflect.Field f = c.getDeclaredField(fieldName);
				f.setAccessible(true);
				return f.getDouble(organ);
			} catch (NoSuchFieldException ex) {
				c = c.getSuperclass();
			} catch (Exception ex) {
				return Double.NaN;
			}
		}
		return Double.NaN;
	}

	private static boolean isPastLeafAllometryExpansion(Object organ) {
		double organAge = readLeafAllometryDoubleField(organ, "age");
		double organTe = readLeafAllometryDoubleField(organ, "te");
		if (Double.isNaN(organAge) || Double.isInfinite(organAge)) return false;
		if (Double.isNaN(organTe) || Double.isInfinite(organTe) || organTe < 0.0) return false;
		return organAge > organTe;
	}

	private static java.util.Map frozenLeafAllometryDemandMap(boolean potentialPath) {
		return potentialPath ? leafAllometryFrozenPotentialDemandByInternode : leafAllometryFrozenActualDemandByInternode;
	}

	public static void resetLeafAllometryRuntimeCache() {
		leafAllometryCacheStep = Integer.MIN_VALUE;
		leafAllometryDirectLeavesByInternode.clear();
		leafAllometryFallbackLeafByInternode.clear();
		leafAllometryFrozenPotentialDemandByInternode.clear();
		leafAllometryFrozenActualDemandByInternode.clear();
	}

	private static boolean validFrozenLeafAllometryDemand(double demand) {
		return !Double.isNaN(demand) && !Double.isInfinite(demand) && demand >= 0.0;
	}

	private static boolean hasFrozenLeafAllometryDemand(Internode itn, boolean potentialPath) {
		if (itn == null) return false;
		if (frozenLeafAllometryDemandMap(potentialPath).containsKey(itn)) return true;
		if (potentialPath) {
			return itn.leafAllometryFrozenPotentialDemandValid &&
				validFrozenLeafAllometryDemand(itn.leafAllometryFrozenPotentialDemand);
		}
		return itn.leafAllometryFrozenActualDemandValid &&
			validFrozenLeafAllometryDemand(itn.leafAllometryFrozenActualDemand);
	}

	private static double getFrozenLeafAllometryDemand(Internode itn, boolean potentialPath) {
		if (itn == null) return Double.NaN;
		java.util.Map frozenMap = frozenLeafAllometryDemandMap(potentialPath);
		Object value = frozenMap.get(itn);
		if (value instanceof Double) return ((Double) value).doubleValue();
		double savedDemand = potentialPath ? itn.leafAllometryFrozenPotentialDemand : itn.leafAllometryFrozenActualDemand;
		boolean savedValid = potentialPath ? itn.leafAllometryFrozenPotentialDemandValid : itn.leafAllometryFrozenActualDemandValid;
		if (savedValid && validFrozenLeafAllometryDemand(savedDemand)) {
			frozenMap.put(itn, Double.valueOf(savedDemand));
			return savedDemand;
		}
		return Double.NaN;
	}

	private static void freezeLeafAllometryDemand(Internode itn, boolean potentialPath, double demand) {
		if (itn == null) return;
		if (Double.isNaN(demand) || Double.isInfinite(demand) || demand < 0.0) demand = 0.0;
		frozenLeafAllometryDemandMap(potentialPath).put(itn, Double.valueOf(demand));
		if (potentialPath) {
			itn.leafAllometryFrozenPotentialDemand = demand;
			itn.leafAllometryFrozenPotentialDemandValid = true;
		} else {
			itn.leafAllometryFrozenActualDemand = demand;
			itn.leafAllometryFrozenActualDemandValid = true;
		}
	}

	private static boolean allSelectedLeavesPastExpansion(java.util.List selectedLeaves) {
		if (selectedLeaves == null || selectedLeaves.isEmpty()) return false;
		for (int i = 0; i < selectedLeaves.size(); i++) {
			Object o = selectedLeaves.get(i);
			if (!(o instanceof PhotosynthateOrgan)) return false;
			if (!isPastLeafAllometryExpansion((PhotosynthateOrgan) o)) return false;
		}
		return true;
	}

	private static void ensureLeafAllometryCacheForStep() {
		if (leafAllometryCacheStep == step) return;
		if (step <= 0 || step < leafAllometryCacheStep) {
			resetLeafAllometryRuntimeCache();
		}
		leafAllometryCacheStep = step;
		leafAllometryDirectLeavesByInternode.clear();
		leafAllometryFallbackLeafByInternode.clear();

		java.util.List internodes = new java.util.ArrayList();
		java.util.List leaves = new java.util.ArrayList();
		java.util.List leafOwners = new java.util.ArrayList();

		for (Internode itn : (* syncInternode:Internode, (syncInternode.shouldSyncAnnualInternodeBiomassFromLeaves()) *)) {
			internodes.add(itn);
		}
		if (internodes.isEmpty()) return;

		for (PhotosynthateOrgan leafCandidate : (* leafQuery:PhotosynthateOrgan *)) {
			if (!isLeafLikePhotosynthateOrgan(leafCandidate)) continue;
			Internode owner = nearestInternodeForLeaf(leafCandidate);
			if (owner != null && !owner.shouldSyncAnnualInternodeBiomassFromLeaves()) continue;
			leaves.add(leafCandidate);
			leafOwners.add(owner);
			if (owner != null) {
				java.util.List direct = (java.util.List) leafAllometryDirectLeavesByInternode.get(owner);
				if (direct == null) {
					direct = new java.util.ArrayList();
					leafAllometryDirectLeavesByInternode.put(owner, direct);
				}
				direct.add(leafCandidate);
			}
		}

		for (int i = 0; i < internodes.size(); i++) {
			Internode target = (Internode) internodes.get(i);
			if (leafAllometryDirectLeavesByInternode.containsKey(target)) continue;
			double bestScore = Double.POSITIVE_INFINITY;
			PhotosynthateOrgan bestLeaf = null;
			for (int j = 0; j < leaves.size(); j++) {
				PhotosynthateOrgan leafCandidate = (PhotosynthateOrgan) leaves.get(j);
				if (leafCandidate == null || leafCandidate.plantNumber != target.plantNumber) continue;
				Internode owner = (Internode) leafOwners.get(j);
				if (owner != null && owner == target) continue;
				double score = target.nearbyLeafScore(owner, leafCandidate);
				if (score < bestScore) {
					bestScore = score;
					bestLeaf = leafCandidate;
				}
			}
			if (bestLeaf != null) {
				leafAllometryFallbackLeafByInternode.put(target, bestLeaf);
			}
		}
	}

	private double cachedLeafStructuralDemandForInternode(boolean potentialPath) {
		if (hasFrozenLeafAllometryDemand(this, potentialPath)) {
			return getFrozenLeafAllometryDemand(this, potentialPath);
		}
		ensureLeafAllometryCacheForStep();
		java.util.List direct = (java.util.List) leafAllometryDirectLeavesByInternode.get(this);
		if (direct != null) {
			double demand = 0.0;
			for (int i = 0; i < direct.size(); i++) {
				demand += leafStructuralDemand((PhotosynthateOrgan) direct.get(i), potentialPath);
			}
			if (isPastLeafAllometryExpansion(this) || allSelectedLeavesPastExpansion(direct)) {
				freezeLeafAllometryDemand(this, potentialPath, demand);
			}
			return demand;
		}
		PhotosynthateOrgan fallback = (PhotosynthateOrgan) leafAllometryFallbackLeafByInternode.get(this);
		if (fallback == null) {
			if (isPastLeafAllometryExpansion(this)) {
				freezeLeafAllometryDemand(this, potentialPath, 0.0);
				return 0.0;
			}
			return Double.NaN;
		}
		double demand = leafStructuralDemand(fallback, potentialPath);
		if (isPastLeafAllometryExpansion(this) || isPastLeafAllometryExpansion(fallback)) {
			freezeLeafAllometryDemand(this, potentialPath, demand);
		}
		return demand;
	}

	private double directLeafStructuralDemandForInternode(double sugarConcentration_phloem, boolean potentialPath) {
		boolean foundLeaf = false;
		double demand = 0.0;
		for (PhotosynthateOrgan leafCandidate : (* this (-->)+ directLeafCandidate:PhotosynthateOrgan *)) {
			if (!isLeafLikePhotosynthateOrgan(leafCandidate)) continue;
			Internode owner = nearestInternodeForLeaf(leafCandidate);
			if (owner != this) continue;
			foundLeaf = true;
			demand += leafStructuralDemand(leafCandidate, potentialPath);
		}
		return foundLeaf ? demand : Double.NaN;
	}

	private double nearbyLeafStructuralDemandForInternode(double sugarConcentration_phloem, boolean potentialPath) {
		double bestDemand = Double.NaN;
		double bestScore = Double.POSITIVE_INFINITY;
		for (PhotosynthateOrgan leafCandidate : (* samePlantLeafCandidate:PhotosynthateOrgan,
			(samePlantLeafCandidate.plantNumber == this.plantNumber) *)) {
			if (!isLeafLikePhotosynthateOrgan(leafCandidate)) continue;
			Internode owner = nearestInternodeForLeaf(leafCandidate);
			if (owner != null && owner.getId() == this.getId()) continue;
			if (owner != null && !owner.shouldSyncAnnualInternodeBiomassFromLeaves()) continue;
			double score = nearbyLeafScore(owner, leafCandidate);
			if (score < bestScore) {
				bestScore = score;
				bestDemand = leafStructuralDemand(leafCandidate, potentialPath);
			}
		}
		return bestDemand;
	}

	private double leafAllometryStructuralDemandForInternode(double sugarConcentration_phloem, boolean potentialPath) {
		if (!shouldSyncAnnualInternodeBiomassFromLeaves()) return Double.NaN;
		double leafDemand = Double.NaN;
		try {
			leafDemand = cachedLeafStructuralDemandForInternode(potentialPath);
		} catch (RuntimeException ex) {
			// Compatibility fallback for older/partial graphs if cache construction fails.
			leafDemand = directLeafStructuralDemandForInternode(sugarConcentration_phloem, potentialPath);
			if (Double.isNaN(leafDemand) || Double.isInfinite(leafDemand)) {
				leafDemand = nearbyLeafStructuralDemandForInternode(sugarConcentration_phloem, potentialPath);
			}
		}
		if (Double.isNaN(leafDemand) || Double.isInfinite(leafDemand) || leafDemand < 0.0) {
			leafDemand = 0.0;
		}
		return annualInternodeLeafBiomassRatioSafe() * leafDemand;
	}

	void syncAnnualInternodeBiomassFromLocalOrNearbyLeaf() {
		if (!shouldSyncAnnualInternodeBiomassFromLeaves()) return;
		double leafBiomass = directLeafBiomassForInternode();
		if (Double.isNaN(leafBiomass) || Double.isInfinite(leafBiomass) || leafBiomass <= 0.0) {
			leafBiomass = nearbyLeafBiomassForInternode();
		}
		if (Double.isNaN(leafBiomass) || Double.isInfinite(leafBiomass) || leafBiomass <= 0.0) return;

		double candidateBiomass = annualInternodeLeafBiomassRatioSafe() * leafBiomass; // mg dry matter, leaf-to-internode allometry.
		if (Double.isNaN(candidateBiomass) || Double.isInfinite(candidateBiomass) || candidateBiomass <= 0.0) return;
		biomass_pre = biomass;
		biomass = candidateBiomass;
		initCN_content(biomass);
		updateRealizationRatio();
	}

	private double safeTopologyUpdateCadence() {
		double cadence = plastochron;
		try {
			cadence = phyllochron;
		} catch (RuntimeException ex) {
			cadence = plastochron;
		}
		if (Double.isNaN(cadence) || Double.isInfinite(cadence) || cadence <= 0.0) cadence = 1.0;
		return cadence;
	}

	private boolean hasActiveDistalApex() {
		ApexService apx = first((* this (-->)+ a:ApexService *));
		return apx != null;
	}

	int countAnnualShootNodesAbove() {
		Internode cursor = this;
		int count = 0;
		int guard = 0;
		while (guard < 512) {
			guard++;
			Internode next = first((* cursor --> nx:Internode *));
			if (next == null) break;
			if (next == cursor) break;
			if (next.organType == null || !next.organType.equalsIgnoreCase("Internode")) break;
			if (next.order <= 2) break;
			count++;
			cursor = next;
		}
		return count;
	}

	double diameterFromDistalNodeCount(int nAbove) {
		double D = pipeDiaMin + pipe_alpha * Math.max(0, nAbove);
		return clampd(D, pipeDiaMin, pipeDiaMax);
	}

		private void refreshMaxDiameterFromTopologyIfNeeded() {
			if (!isAnnualShootInternode()) return;
			if (useStaticArc) {
				// Static/imported architectures already carry initialized diameters.
				// Do not overwrite their diameter target with a topology-count taper.
				maxDiameterResolvedFromTopology = true;
				return;
			}
			double fallbackDia = (pipeDiaMin + pipeDiaMax) / 2.0;
			if (Double.isNaN(maxDia_phase1) || Double.isInfinite(maxDia_phase1) || maxDia_phase1 <= 0.0) {
				maxDia_phase1 = fallbackDia;
			}
			double cadence = safeTopologyUpdateCadence();
			boolean hasDistalApex = hasActiveDistalApex();
			boolean canUpdateNow = hasDistalApex
				&& ((!maxDiameterResolvedFromTopology)
					|| ((this.age - lastDiameterTopologyUpdateAge) >= cadence));
			if (canUpdateNow) {
				int nAbove = countAnnualShootNodesAbove();
				if (nAbove != lastDistalNodeCount || !maxDiameterResolvedFromTopology) {
					maxDia_phase1 = diameterFromDistalNodeCount(nAbove);
					lastDistalNodeCount = nAbove;
				}
				lastDiameterTopologyUpdateAge = this.age;
				maxDiameterResolvedFromTopology = true;
			}
			if (Double.isNaN(maxDia_phase1) || Double.isInfinite(maxDia_phase1) || maxDia_phase1 < pipeDiaMin) {
				maxDia_phase1 = pipeDiaMin;
		}
		if (maxDia_phase1 > pipeDiaMax) maxDia_phase1 = pipeDiaMax;
	}

	private int resolveDynamicShootNumber(ApexService a) {
		if (a == null) return 1;
		int sn = 0;
		if (a.order >= 9) sn = a.axis9ID;
		else if (a.order == 8) sn = a.axis8ID;
		else if (a.order == 7) sn = a.axis7ID;
		else if (a.order == 6) sn = a.axis6ID;
		else if (a.order == 5) sn = a.axis5ID;
		else if (a.order == 4) sn = a.axis4ID;
		else if (a.order == 3) sn = a.axis3ID;
		else sn = a.axis2ID;

		if (sn <= 0) {
			if (a.axis9ID > 0) sn = a.axis9ID;
			else if (a.axis8ID > 0) sn = a.axis8ID;
			else if (a.axis7ID > 0) sn = a.axis7ID;
			else if (a.axis6ID > 0) sn = a.axis6ID;
			else if (a.axis5ID > 0) sn = a.axis5ID;
			else if (a.axis4ID > 0) sn = a.axis4ID;
			else if (a.axis3ID > 0) sn = a.axis3ID;
			else if (a.axis2ID > 0) sn = a.axis2ID;
		}
		if (sn <= 0) sn = Math.max(1, a.nodeNumber);
		return sn;
	}

	static double safePositiveOrFallback(double candidate, double fallback) {
		if (Double.isNaN(candidate) || Double.isInfinite(candidate) || candidate <= 0.0) {
			return fallback;
		}
		return candidate;
	}
	
	/** Quick estimate of distal annual-shoot nodes from the *plan* at initiation time. */
	private int estimateDistalNodeCountFromPlan(ApexService a) {
		if (a == null) return 0;
		return Math.max(0, a.phytomerNumber - a.rank);
	}
	

