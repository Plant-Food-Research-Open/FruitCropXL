// Trunk module
module Trunk extends Internode 
{
	@Override
	public void loadParameters() {
			
	/** Set the context for file name parameters*/
		CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_PLANT_PARAMETERS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();

		/** Configuration context for internode carbon-related parameters */
		config.setCategoryContext("wood-carbon");
		//common parameters
		maintenanceCoff        = config.getDouble("MTNCE", 5e-05);
		growthCoff             = config.getDouble("GROWTHRQ", 1.2);
		C_content              = config.getDouble("C_CONTENT", 0.46);
		maxRes                 = config.getDouble("RESERVES", 0.3);
		
		/** pass the plant level carbon parameters*/
		km_sec                 = config.getDouble("KM_SECONDARY", 0.14); 
		configureReserveKmAbsolute(config, 0.56, 0.112);
			configureReserveTurnover(config, 0.0060, 0.0010);
		
		secondaryGrowthRate = config.getDouble("SEC_GROWTH_RATE", 2.5e-06);
		k_age = config.getDouble("k_age", 0.18);
		try {
			secBase = config.getDouble("SEC_BASE", SEC_BASE);
		} catch (Throwable t) {
			// compatibility fallback: older wood-carbon categories omit organ-level timing keys
			secBase = SEC_BASE;
		}
		try {
			secBump = config.getDouble("SEC_BUMP", SEC_BUMP);
		} catch (Throwable t) {
			// compatibility fallback: older wood-carbon categories omit organ-level timing keys
			secBump = SEC_BUMP;
		}
		secBase = Math.max(0.0, Math.min(1.0, secBase));
		secBump = Math.max(0.0, Math.min(1.0, secBump));
		//times 1e6 to convert from mg/cm3 into mg/m3
		density = config.getDouble("WOOD_DENSITY", 750) * 1e6;
		
		/** Set the context for water parameters*/
		config.setCategoryContext("wood-water");		 
		waterContent = config.getDouble("WATER_CONTENT", 0.56);
		
		config.setCategoryContext("wood-nitrogen");
		/** Clamps for Nm and LMA. */
		Nm_min  = config.getDouble("Nm_min",  0.005);  // 0.5% N
		Nm_max  = config.getDouble("Nm_max",  0.020);  // 6.0% N

		
		/** Set the context for common plant level water parameters*/
		config.setCategoryContext("internode-water");		 
		cx1		 = config.getDouble("cx1", 1.171);
		cx2		 = config.getDouble("cx2", 2.6);
		cx3		 = config.getDouble("cx3", 2);
		phi_stem = config.getDouble("phi_stem", -2.5);
		growth_a	 = config.getDouble("growth_a", -10);
		growth_b	 = config.getDouble("growth_b", -0.6);
		
		
		/** Set the context for file name parameters*/
		CategoryStore config_Init = ((DocumentCategoryNameGroup) CONFIG.getGroup(FILE_NAME_INITIAL_CONDITIONS, 
			DocumentCategoryNameGroup.class)).getCategoryStore();
			
		config_Init.setCategoryContext("wood");
		fNSC                   = config_Init.getDouble("fNSC", 0.1);
		structure_C            = 1- fNSC; 
		this.Nm  = config_Init.getDouble("Nm",  0.020);  // 2.0% N

		
	}
	
	
	@Override
	void initiate_pb(PlantBase pb)
	{
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS
		this.plantNumber = pb.plantNumber;
		this.border = pb[border];
		plantBaseID = pb.nodeID;
		age = pb.age;
		ageD = pb.ageD;
		cpn = 1;
		//set trunk order to 1 for consistentce
		order = 1;
		rank = 1;
		assignAge(pb, cpn);
		//STATE VARIABLES
		if (!initiation_method.equals("ArchReader")) {
			initDimensions_DevelopmentRules();
		}
		println("WOOD_LENGTH" + WOOD_LENGTH);
		this.potLength = length; 
		//CARBON
		double trunkBiomassGeom = Math.PI * (diameter*diameter/4) * length * density;
		if (woodBiomassCalcMethod == 0) {
			biomass = BIOMASS_WOOD;
		} else if (woodBiomassCalcMethod == 1) {
			biomass = BIOMASS_WOOD * CORDEN_NUM * SHOOT_NUM;
		} else {
			biomass = trunkBiomassGeom;
		}
		area = Math.PI * (diameter*diameter/4);
		
		freshWeight = biomass/(1-waterContent);
		carbon_total = biomass * C_content;
		carbon_structure = carbon_total * structure_C;  //mg, amount of structure carbon
		carbon_nonStructure = carbon_total * fNSC;    //mg, amount of starch carbon
		fNSCtoSC = carbon_nonStructure/carbon_structure; 
		fNSC = carbon_nonStructure/carbon_total;
		//NITROGEN
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total * (1 - N_CONTENT_MOBILE) -  nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		//water potential initialize		
		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential;
		calcKmax();
		calcKa();
		this.organType = "Trunk";
	}
	
	@Override
	Internode initiate_pi(PlantIdentifier pi, float length_, float diameter_)
	{
		//initialize the parameters
		loadParameters();
		
		//IDENTIFIERS		
		this.plantNumber = pi.plantNumber;
		this.border = pi[border];
		
		if(plantBaseID <= 0) {
			PlantBase pb = first((* this (<--)+ PlantBase*));
			if(pb != null) {
				this.plantBaseID = pb.getId();
			}
		}

		this.diameter = diameter_;
		this.length = length_;
		this.potLength = length; 
		//CARBON
		double trunkBiomassGeom = Math.PI * (diameter*diameter/4) * length * density;
		if (woodBiomassCalcMethod == 2) {
			biomass = trunkBiomassGeom;
		} else if (woodBiomassCalcMethod == 1) {
			// Reconstructed trunk may contain multiple Trunk segments. Using the whole-trunk
			// total on each segment inflates structure-based sums, so initialize each segment
			// from its geometry and let later updates evolve biomass dynamically.
			biomass = trunkBiomassGeom;
			if (biomass <= 0) biomass = BIOMASS_WOOD * CORDEN_NUM * SHOOT_NUM;
		} else {
			// calcMethod 0 (direct input total): avoid duplicating BIOMASS_WOOD on every
			// reconstructed trunk segment; use per-segment geometric biomass placeholder.
			biomass = trunkBiomassGeom;
			if (biomass <= 0) biomass = BIOMASS_WOOD;
		}
		area = Math.PI * (diameter*diameter/4);
		freshWeight = biomass/(1-waterContent);
		carbon_total = biomass * C_content;
		carbon_structure = carbon_total * structure_C;  //mg, amount of structure carbon
		carbon_nonStructure = carbon_total * fNSC;    //mg, amount of starch carbon
		fNSCtoSC = carbon_nonStructure/carbon_structure; 
		fNSC = carbon_nonStructure/carbon_total;
		//NITROGEN
		nitrogen_total = biomass * Nm;
		nitrogen_structure = biomass * Nm_min; 
		nitrogen_nonStructure = nitrogen_total * (1 - N_CONTENT_MOBILE) -  nitrogen_structure;
		nitrogen_mobile = nitrogen_total * N_CONTENT_MOBILE;
		//water potential initialize		
		this.waterPotential_b = inputWaterPotential;
		this.waterPotential = inputWaterPotential;
		calcKmax();
		calcKa();
		this.organType = "Trunk";
		return this;
	}
	
	
	// Initiation method used with grapevine reconstruction from digitalized lidar data
	@Override
	void initiate_reconstruction(PlantBase pb, int i)
	{
		this.rank = Math.max(i,1);
		initiate_pb(pb);
	}
	
	// Method for initiating dimensions if lidar reconstruction has not been used
	@Override
	void initDimensions_DevelopmentRules()
	{
		
		this.length = WOOD_LENGTH;
		this.diameter = WOOD_DIAMETER;
		
	}
	
	// Method for initiating dimensions if lidar reconstruction has been used
	@Override
	void initDimensions_Reconstruction()
	{
	/* 	Vector3D start = trunkData.start[rank];
		Vector3D end = trunkData.end[rank];
		this.length = start.distance(end);
		this.diameter = trunkData.diameter[rank]; */
	}
	
	
	@Override
	void calcPTCTRAM(double sc) 
	{ 
		calcLeakage(sc);
		double radius = this.diameter / 2;
		deltalength_PT = 0;
        deltaRadius_PT = secondaryGrowthDeltaRadiusForCordonTrunk(sc, true);
		structureDM_PRI_PT = 0;
        structureDM_SEC_PT = C_content * growthCoff * 2.0 * Math.PI * radius * length * density *deltaRadius_PT;
       				
		maintenanceDM_PT = calcMaintanceRespiration(this.fNSCtoSC); 
		reserveDM_PT = reserveSynthesis();
		loading_PT =  reserveHydrolysis(); 
	}
	@Override
	void calcLoading(double sugarConcentration_phloem)
	{
		loading =  fNSC > MINIMUM_NSC ? reserveHydrolysis() * 
				   sourceLoading(sugarConcentration_phloem, sourceLoading_b, sourceLoading_cp) : 1e-6;
	    //if (printFlag) { println("this is loading from internode " + "node " + nodeNumber + " rank "+ this.rank + " loading " + loading); }
	} 
	@Override
	void calcUnloading(double sugarConcentration_phloem)
	{
		//internode has two structural demand part, length growth and diameter
		//diameter growth has two parts: short-term logistic expansion for young
		//internodes, and long-term radial expansion that is proportional to the internode�s surface area.
		double radius = this.diameter / 2;
		deltalength = 0;
        deltaRadius = secondaryGrowthDeltaRadiusForCordonTrunk(sugarConcentration_phloem, false);
		structureDM_PRI = 0;
        structureDM_SEC = C_content * growthCoff * 2.0 * Math.PI * radius * length * density *deltaRadius;
		structureDM = structureDM_PRI + structureDM_SEC;
		
		maintenanceDM = calcMaintanceRespiration(this.fNSCtoSC) * 
         				sinkUnloading(sugarConcentration_phloem, KM_MTNCE);
			
		reserveDM = reserveSynthesis() * sinkUnloading(sugarConcentration_phloem, km_res);			
		
		unloading = structureDM + maintenanceDM + reserveDM;				
	}
	
	
	@Override
	void calcWaterFlux(double f_waterFlux) 
	{
		//first step pb[0] could be null
		waterFlux = plantBaseID <= 0? 1e-5 : f_waterFlux * getPlantBase().waterFluxPotential;
		
	}
	@Override
	void calcWaterPotential() 
	{
		if(parentID > 0 && plantBaseID > 0) {
			this.waterPotential_b = Math.min(getParent().waterPotential, getPlantBase().xylemWaterPotential);
		} else if(parentID <= 0 && plantBaseID > 0) {
			this.waterPotential_b = getPlantBase().xylemWaterPotential;
		} else {
			this.waterPotential_b = inputWaterPotential;
		}
			
		this.waterPotential = waterPotential_b - 1/Ka * this.waterFlux - Dw * gacc * this.length*1e-3;;
		if(Double.isNaN(this.waterPotential)) this.waterPotential = inputWaterPotential;
	}
	//hydraulic conductivity per meter length of shoot calculated by diameter
	@Override
	void calcKmax() {
		Kmax = Math.max(cx2 * Math.pow(diameter, cx3), cx2 * Math.pow(pipeDiaMin, cx3))
				/ this.length * 1e6; //mg  s-1 m MPa-1/ this.length * 1e6; //mg  s-1 m MPa-1
	}
	@Override
	void calcKa() {
		Ka = Kmax * 1/(1 + Math.pow(this.waterPotential/phi_stem, cx1));
	}
	

	
	@Override
	void update()
	{
		super.update();
		
		if(plantBaseID <= 0) {
			PlantBase pb = first((* this (<--)+ PlantBase*));
			if(pb != null) {
				this.plantBaseID = pb.getId();
				
			}
		}
		if(parentID <= 0 && step <= 2 && this.rank > 1) {  //trunk may not have parent internode, especially for the first one 
			GrowingOrgan parentOrgan = (GrowingOrgan) first((* this (<--)+ Internode*));
			if (parentOrgan != null) {
				storeParentId(parentOrgan);
				parentOrgan.addChildInternodeId(this.nodeID);
			}
		}
		if(parentID <= 0 && this.rank == 1) {
			if(plantBaseID > 0){
				getPlantBase().childTrunkID = this.getId(); 
			} 
		}
		
		/** update organ size and area */
				biomass_pre = biomass;
				double prevDiameter = this.diameter;
				if(organGrowthMethod.equals("TempLimited")) {
					double cappedDiameter = capTempLimitedPerennialDiameterUpdate(diameter + 2 * deltaRadius_PT, prevDiameter);
					deltaRadius_PT = Math.max(0.0, 0.5 * (cappedDiameter - prevDiameter));
					this.diameter = safePositiveOrFallback(cappedDiameter, prevDiameter);
				} else if(organGrowthMethod.equals("TempWaterLimited")) {
				this.diameter = diameter + 2 * deltaRadius_PT;
			} else if(organGrowthMethod.equals("TempWaterCarbonLimited")){
			this.diameter = diameter + 2 * deltaRadius;
		} else {
			this.diameter = diameter + 2 * deltaRadius;
		}
		
			double vol = calcVol(length, diameter);
			
			/** update organ carbon and nitrogen status */
			if(organGrowthMethod.equals("TempLimited")) {
				biomass = safePositiveOrFallback(vol * density, biomass_pre);
				this.initCN_content(this.biomass);
			} else {
			delta_str = structureDM - growthCost; //maintenanceDM + reserveDM
			delta_NSC = maintenanceDM + reserveDM + leakage 
						- loading - carbonMobilizationCost - maintenanceDM_PT;
						   
			updateCarbonStatus(delta_str, delta_NSC);
		
			if(Double.isNaN(this.biomass)) {
				this.initCN_content(this.biomass_pre);
			}
		}
		km_res = adjustKmResSeasonally(daysSinceWinterSolstice, km_res_early, km_res_late);
		
		
		calcKmax();
		calcKa();
		
	/* 	println("delta_str " + delta_str + " delta_NSC " + delta_NSC + 
				" loading " + (loading) +  " cflux " + Cflux);
				
		println("cur_biomass " + biomass + " biomass_pre " + biomass_pre + 
				" dif " + (biomass-biomass_pre) +  " cflux " + Cflux); */
				
		//calcNdegradation();
		//calcNSynthesis(); 
		//nitrogen_total = nitrogen_structure + nitrogen_nonStructure;
	}
} 
