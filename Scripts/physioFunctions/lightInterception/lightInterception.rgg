public static final String LIGHT_MODE_GPU = "gpu";
public static final String LIGHT_MODE_EMPIRICAL = "empiricalRegression";
public static final String LIGHT_MODE_SURROGATE = "surrogateModel";
public static final String LIGHT_MODE_DIRECT = "directInput";

