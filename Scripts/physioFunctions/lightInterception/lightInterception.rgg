/** Raw three-channel result returned by GroIMP CPU/GPU light engines. */
private class RawLightMeasurement implements Serializable {
	private static final long serialVersionUID = 3474457789206145043L;

	double channel0;
	double channel1;
	double channel2;
	double integrated;
	boolean valid;
}


/** One ordered predictor in a self-describing deterministic linear model. */
private class LightLinearPredictor implements Serializable {
	private static final long serialVersionUID = -8464971328976341057L;

	int order;
	String name;
	String units;
	String transformation;
	double coefficient;
	double validMin;
	double validMax;
}


/** Parsed empirical regression or manifest-gated deterministic test surrogate. */
private class LightLinearModel implements Serializable {
	private static final long serialVersionUID = 7210231772094624958L;

	String modelVersion;
	String responseVariable;
	String responseUnits;
	String radiationComponents;
	String spatialResolution;
