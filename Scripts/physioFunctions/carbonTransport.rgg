// carbon transport model
// XL port of L+C model Mechanistic modelling of coupled phloem/xylem transport for L-systems:
// combining analytical and computational methods
// Original model by Seleznyova and Hanan. (2018)
// Port by Junqi zhu <junqi.zhu@plantandfood.co.nz>
import static globalParameters.*;
import static absOrgan.*;
import static leaf.*;
import static shoot.*;
import static budBase.*;
import static plantBase.*;
import static modelOptions.*;
import static initialConditions.*;
import static plantParameters.*;
import static rootSystem.*;
import static flowerBase.*;
import static fruitBase.*;
import static fineRoot.*;
