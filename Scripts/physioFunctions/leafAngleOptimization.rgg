public static boolean hasBeenOptimized = false;				// True if leaf angles have been optimized
public static LightModel optimizationLightModel;	// Light model used for computing absorbed light from each direction
public static int optimizationStep;					// Number of step in optimization process
public static int optimizationRank;					// Rank of leaves which are currently being optimized

public static int numDiffuseLights = useTurtleRadiation ? 46 : 72;			// Number of diffuse lights
public static 	Vector3D[] diffuseLightLocations = new Vector3D[numDiffuseLights];	// Location of each diffuse light 
public static float[] diffuseLightXRotation = new float[numDiffuseLights];			// Rotation around x axis for placing each light
public static float[] diffuseLightYRotation = new float[numDiffuseLights];			// Rotation around y axis for placing each light

