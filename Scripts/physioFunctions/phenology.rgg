// Update thermal time and check if transition between fruit phenologyical stages should occur
public static void updateBerryStage(FruitService fruit)
{
	//fruit.thermalTime += extraTools.wangEngelTempFunction(Ta, MIN_TEMP, OPT_TEMP, MAX_TEMP,REFTMP)*DT;
	
	if(fruit.phenologyStage == FRUIT_SET && fruit.age >= VERAISON_TARGET) {
		//fruit.calcYield();
		fruit.phenologyStage = VERAISON;
		fruit.veraison = true;
		veraisonNum++;
		if(veraisonNum/totalBudNum >= 0.5) println("50% veraison happened");	
	}
}

// Load grapevine phenology properties
public static boolean loadPhenologyParameters(String file_name) 
{
	boolean error = false;
	error = error || loadPhenologyPropertyFile(file_name);

	if (error == true) if (printFlag) { println("Error during reading of phenology parameter file(s)!"); }
	return error;
}

// Load the file with parameters which determine phenology
private static boolean loadPhenologyPropertyFile(String file_name) {
	ConfigLoader loader = new ConfigLoader(new LoadPhenologyCommand());
	
	// groupName: file_path, path: CONFIG_PATH_SCENARIOS + file_path
	return loader.load(file_name, PATH_SCENARIOS + file_name);
}

private class LoadPhenologyCommand implements LoadCommand {
	public void execute(String file_name) {
		loadPhenologyProperties(file_name);
	}
}


private static void loadPhenologyProperties(String file_name) {
	CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(file_name, 
			DocumentCategoryNameGroup.class)).getCategoryStore();

	config.setCategoryContext("parameters");

	DORMANCY_DAY_LENGTH = config.getDouble("DORMANCY_DAY_LENGTH");
	ENDODORMANCY_TARGET = config.getDouble("ENDODORMANCY_TARGET");
	ECODORMANCY_TARGET = config.getDouble("ECODORMANCY_TARGET");
	YMAX = config.getDouble("YMAX");
	X0 = config.getDouble("X0");
	B = config.getDouble("B");
	BASE_TEMP = config.getDouble("BASE_TEMP");
	FLOWERING_TARGET = config.getDouble("FLOWERING_TARGET");
	FRUIT_SET_TARGET = config.getDouble("FRUIT_SET_TARGET");
	VERAISON_TARGET = config.getDouble("VERAISON_TARGET");
	BUDBURST_CANE_DIFF = config.getDoubleArray("BUDBURST_CANE_DIFF", new Double[0]); // Default to empty array if not provided in phenology file.
}