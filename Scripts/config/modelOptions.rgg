	// ================================================================
	// budPlanner
	// ================================================================
	config.setCategoryContext("budPlanner");
	
	// mode 0..6 or 8 (JSON key is "targetMode")
	budTargetMode = (int) config.getDouble("targetMode",
						 Double.valueOf(budTargetMode).doubleValue());
	println("budTargetMode: " + budTargetMode);
	
	// density
	budNumberPerMeter = (int) config.getDouble("budNumberPerMeter",
					   Double.valueOf(budNumberPerMeter).doubleValue());
	
	// whole-tree bud target (mode 4)
	budNumberTargetPerTree = (int) config.getDouble("budNumberTargetPerTree",
							 Double.valueOf(budNumberTargetPerTree).doubleValue());
	
	// Only read grid when those modes are active (4/5)
	if (budTargetMode == 4 || budTargetMode == 5) {
	
	  Double[] gridBudTargetsWrapper = null;
	  try {
		gridBudTargetsWrapper = safeGetDoubleArray(config, "budNumberTargetsGrid");
	  } catch (RuntimeException e) {
		println("[Config] INFO: budNumberTargetsGrid is not an array (" + e
		  + "), using default grid.");
	  }
	
	  if (gridBudTargetsWrapper != null && gridBudTargetsWrapper.length > 0) {
		budNumberTargetsGrid = toPrimitiveOrDefault(gridBudTargetsWrapper, budNumberTargetsGrid);
		if (budNumberTargetsGrid != null) {
		  println("budNumberTargetsGrid: " + budNumberTargetsGrid.length);
		} else {
		  println("[Config] INFO: budNumberTargetsGrid array empty after conversion,"
			+ " keeping existing default.");
		}
	  } else {
		if (budNumberTargetsGrid != null) {
		  println("[Config] INFO: budNumberTargetsGrid not supplied; using default grid"
			+ " (length = " + budNumberTargetsGrid.length + ").");
		} else {
		  println("[Config] INFO: budNumberTargetsGrid not supplied; no grid override.");
		}
	  }
	} else {
	  println("budTargetMode=" + budTargetMode + ", skipping budNumberTargetsGrid.");
	}

	try {
	  Double[] uprightBudTargetsWrapper = safeGetDoubleArray(config, "budNumberTargetsUprightRegion");
	  budNumberTargetsUprightRegion = toPrimitiveOrDefault(uprightBudTargetsWrapper, budNumberTargetsUprightRegion);
	} catch (RuntimeException e) {
	  budNumberTargetsUprightRegion = null;
	  println("[Config] INFO: budNumberTargetsUprightRegion unavailable (" + e + "); using legacy bud upright-region behavior.");
	}
	
		// placement / uprights
		MgmtMainAxisOnly = (int) config.getDouble("mainAxisOnly",
						Double.valueOf(MgmtMainAxisOnly).doubleValue());
		MgmtPlacementOrder = (int) config.getDouble("placementOrder",
						  Double.valueOf(MgmtPlacementOrder).doubleValue());
		MgmtUprightOrder = (int) config.getDouble("uprightOrder",
						Double.valueOf(MgmtUprightOrder).doubleValue());
		MgmtMaxNewBudsAllow = (int) config.getDouble("maxNewBudsAllow",
							 Double.valueOf(MgmtMaxNewBudsAllow).doubleValue());
		boolean spurSpacingProvided = true;

		try {
			minBudSpacingM = config.getDouble("minBudSpacingM",
					   Double.valueOf(minBudSpacingM).doubleValue());
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.minBudSpacingM
		}
		try {
			allowAddOnSecondaryAxes = (int) config.getDouble("allowAddOnSecondaryAxes",
						 Double.valueOf(allowAddOnSecondaryAxes).doubleValue());
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.allowAddOnSecondaryAxes
		}
		try {
			enableSpurBalancer = config.getBoolean("enableSpurBalancer", enableSpurBalancer);
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.enableSpurBalancer
		}
		try {
			spurOrder = (int) config.getDouble("spurOrder",
					 Double.valueOf(spurOrder).doubleValue());
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.spurOrder
		}
		try {
			spurChildOrder = (int) config.getDouble("spurChildOrder",
					 Double.valueOf(spurChildOrder).doubleValue());
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.spurChildOrder
		}
		try {
			maxBudsPerSpur = (int) config.getDouble("maxBudsPerSpur",
					 Double.valueOf(maxBudsPerSpur).doubleValue());
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.maxBudsPerSpur
		}
		try {
			removeFromChildFirst = config.getBoolean("removeFromChildFirst", removeFromChildFirst);
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.removeFromChildFirst
		}
		try {
			addSpurUnitWhenAdding = config.getBoolean("addSpurUnitWhenAdding", addSpurUnitWhenAdding);
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.addSpurUnitWhenAdding
		}
		try {
			spurSpacingM = config.getDouble("spurSpacingM",
					 Double.valueOf(spurSpacingM).doubleValue());
		} catch (Throwable t) {
			// compatibility: older scenarios may not define budPlanner.spurSpacingM
			spurSpacingProvided = false;
		}
		if (minBudSpacingM < 0.0) {
			minBudSpacingM = 0.10;
		}
		if (!spurSpacingProvided) {
			// compatibility: for single-spacing setups, mirror bud spacing.
			spurSpacingM = minBudSpacingM;
		}
		if (spurSpacingM < 0.0) {
			spurSpacingM = minBudSpacingM;
		}
		
		// T1 apex potential knobs
		apexPotentialEnable_T1 =
		   config.getBoolean("apexPotentialEnable_T1", apexPotentialEnable_T1);
	
	apexPotentialScale_T1 =
	   config.getDouble("apexPotentialScale_T1",
			 Double.valueOf(apexPotentialScale_T1).doubleValue());
	

	apexPotentialMaxDeviation_T1 =
	   config.getDouble("apexPotentialMaxDeviation_T1",
			 Double.valueOf(apexPotentialMaxDeviation_T1).doubleValue());


	
	// ================================================================
	// leafPlanner
	// ================================================================
	config.setCategoryContext("leafPlanner");
	
	leafTargetMode = config.getString("targetMode", leafTargetMode);
	
	// pre-prune LA remains for BudPlanner etc.
	expectedLeafArea_prePrune =
		config.getDouble("expectedLeafArea_prePrune",
			Double.valueOf(expectedLeafArea_prePrune).doubleValue());
	
	// NEW: stage-specific whole-tree twinning targets
	leafAreaTargetPerTree_T1 =
		config.getDouble("leafAreaTargetPerTree_T1",
			Double.valueOf(leafAreaTargetPerTree_T1).doubleValue());
	leafAreaTargetPerTree_T2 =
		config.getDouble("leafAreaTargetPerTree_T2",
			Double.valueOf(leafAreaTargetPerTree_T2).doubleValue());
	
	// NEW: use getDoubleArray for leafAreaTargetsGrid (shared by T1/T2 grid mode)
	
    Double[] leafAreaWrapper1 = safeGetDoubleArray(config, "leafAreaTargetsGrid_T1");
	leafAreaTargetsGrid_T1 = toPrimitiveOrDefault(leafAreaWrapper1, leafAreaTargetsGrid_T1);
	Double[] leafAreaWrapper2 = safeGetDoubleArray(config, "leafAreaTargetsGrid_T2");
	leafAreaTargetsGrid_T2 = toPrimitiveOrDefault(leafAreaWrapper2, leafAreaTargetsGrid_T1);
	try {
	  Double[] leafAreaUprightWrapper1 = safeGetDoubleArray(config, "leafAreaTargetsUprightRegion_T1");
	  leafAreaTargetsUprightRegion_T1 = toPrimitiveOrDefault(leafAreaUprightWrapper1, leafAreaTargetsUprightRegion_T1);
	} catch (RuntimeException e) {
	  leafAreaTargetsUprightRegion_T1 = null;
	  println("[Config] INFO: leafAreaTargetsUprightRegion_T1 unavailable (" + e + "); using legacy leaf upright-region behavior.");
	}
	try {
	  Double[] leafAreaUprightWrapper2 = safeGetDoubleArray(config, "leafAreaTargetsUprightRegion_T2");
	  leafAreaTargetsUprightRegion_T2 = toPrimitiveOrDefault(leafAreaUprightWrapper2, leafAreaTargetsUprightRegion_T2);
	} catch (RuntimeException e) {
	  leafAreaTargetsUprightRegion_T2 = null;
	  println("[Config] INFO: leafAreaTargetsUprightRegion_T2 unavailable (" + e + "); using legacy leaf upright-region behavior.");
	}

	
	// NEW: pruning fields (independent management)
	leafPruningMode =
		(int) config.getDouble("leafPruningMode",
			Double.valueOf(leafPruningMode).doubleValue());
	leafPruningDOY =
		(int) config.getDouble("leafPruningDOY",
			Double.valueOf(leafPruningDOY).doubleValue());
	leafPruningFraction =
		config.getDouble("leafPruningFraction",
			Double.valueOf(leafPruningFraction).doubleValue());
	desiredLeafArea_postPrune =
		config.getDouble("desiredLeafArea_postPrune",
			Double.valueOf(desiredLeafArea_postPrune).doubleValue());

	
	// ================================================================
	// fruitPlanner
	// ================================================================
	config.setCategoryContext("fruitPlanner");
	
	// mode: "none", "wholeTree", "gridBased", or "uprightRegions"
	fruitTargetMode = config.getString("targetMode", fruitTargetMode);
	
	// T0 bud planner raw target
	expectedFruitNumber_prePrune =
		(int) config.getDouble("expectedFruitNumber_prePrune",
			Double.valueOf(expectedFruitNumber_prePrune).doubleValue());
	
	// T1/T2 whole-tree twinning targets
	fruitTargetPerTree_T1 =
		(int) config.getDouble("fruitTargetPerTree_T1",
			Double.valueOf(fruitTargetPerTree_T1).doubleValue());
	fruitTargetPerTree_T2 =
		(int) config.getDouble("fruitTargetPerTree_T2",
			Double.valueOf(fruitTargetPerTree_T2).doubleValue());
	
	// T1/T2 grid twinning targets
	
	  Double[] fruitGridT1 = safeGetDoubleArray(config, "fruitTargetsGrid_T1");
	  fruitTargetsGrid_T1 = toPrimitiveOrDefault(fruitGridT1, fruitTargetsGrid_T1);

	  Double[] fruitGridT2 = safeGetDoubleArray(config, "fruitTargetsGrid_T2");
	  fruitTargetsGrid_T2 = toPrimitiveOrDefault(fruitGridT2, fruitTargetsGrid_T2);
	try {
	  Double[] fruitUprightT1 = safeGetDoubleArray(config, "fruitTargetsUprightRegion_T1");
	  fruitTargetsUprightRegion_T1 = toPrimitiveOrDefault(fruitUprightT1, fruitTargetsUprightRegion_T1);
	} catch (RuntimeException e) {
	  fruitTargetsUprightRegion_T1 = null;
	  println("[Config] INFO: fruitTargetsUprightRegion_T1 unavailable (" + e + "); using legacy fruit upright-region behavior.");
	}
	try {
	  Double[] fruitUprightT2 = safeGetDoubleArray(config, "fruitTargetsUprightRegion_T2");
	  fruitTargetsUprightRegion_T2 = toPrimitiveOrDefault(fruitUprightT2, fruitTargetsUprightRegion_T2);
	} catch (RuntimeException e) {
	  fruitTargetsUprightRegion_T2 = null;
	  println("[Config] INFO: fruitTargetsUprightRegion_T2 unavailable (" + e + "); using legacy fruit upright-region behavior.");
	}
	
	
	// Fruit pruning (separate from twinning)
	fruitPruningDOY =
		(int) config.getDouble("fruitPruningDOY",
			Double.valueOf(fruitPruningDOY).doubleValue());
	fruitPruningMode =
		(int) config.getDouble("fruitPruningMode",
			Double.valueOf(fruitPruningMode).doubleValue());
	fruitSeparationHeight =
		config.getDouble("fruitSeparationHeight",
			Double.valueOf(fruitSeparationHeight).doubleValue());
	desiredFruitNumber_postPrune =
		(int) config.getDouble("desiredFruitNumber_postPrune",
			Double.valueOf(desiredFruitNumber_postPrune).doubleValue());

	// Optional fruit adding controls (compatibility-safe for legacy scenarios)
	try {
		allowFruitAdding =
			config.getBoolean("allowFruitAdding", allowFruitAdding);
	} catch (Exception e) {
		allowFruitAdding = false;
	}
	try {
		maxFruitAddsPerTree =
			(int) config.getDouble("maxFruitAddsPerTree",
				Double.valueOf(maxFruitAddsPerTree).doubleValue());
	} catch (Exception e) {
		maxFruitAddsPerTree = 999999;
	}
	try {
		maxFruitPerInternode =
			(int) config.getDouble("maxFruitPerInternode",
				Double.valueOf(maxFruitPerInternode).doubleValue());
	} catch (Exception e) {
		maxFruitPerInternode = 1;
	}
	try {
		fruitAddMode = config.getString("fruitAddMode", fruitAddMode);
	} catch (Exception e) {
		fruitAddMode = "toTarget";
	}
	try {
		fruitAddDebug = config.getBoolean("fruitAddDebug", fruitAddDebug);
	} catch (Exception e) {
		fruitAddDebug = false;
	}
	try {
		allowAddOnOccupiedCordon =
			config.getBoolean("allowAddOnOccupiedCordon", allowAddOnOccupiedCordon);
	} catch (Exception e) {
		allowAddOnOccupiedCordon = true;
	}
	try {
		maxFruitPerCordonPosition =
			(int) config.getDouble("maxFruitPerCordonPosition",
				Double.valueOf(maxFruitPerCordonPosition).doubleValue());
	} catch (Exception e) {
		maxFruitPerCordonPosition = 1;
	}
	try {
		maxFruitPerCordonPositionFallback =
			(int) config.getDouble("maxFruitPerCordonPositionFallback",
				Double.valueOf(maxFruitPerCordonPositionFallback).doubleValue());
	} catch (Exception e) {
		maxFruitPerCordonPositionFallback = 2;
	}
	try {
		fruitInitFromNearbyTemplate =
			config.getBoolean("fruitInitFromNearbyTemplate", fruitInitFromNearbyTemplate);
	} catch (Exception e) {
		fruitInitFromNearbyTemplate = true;
	}
	if (maxFruitAddsPerTree < 0) maxFruitAddsPerTree = 0;
	if (maxFruitPerInternode < 1) maxFruitPerInternode = 1;
	if (maxFruitPerCordonPosition < 1) maxFruitPerCordonPosition = 1;
	if (maxFruitPerCordonPositionFallback < maxFruitPerCordonPosition) {
		maxFruitPerCordonPositionFallback = maxFruitPerCordonPosition;
	}
	// ================================================================
	// leafRemovalCarbonDeficit
	// ================================================================
	boolean hasLeafRemovalCarbonDeficit = true;
	try {
		config.setCategoryContext("leafRemovalCarbonDeficit");
	} catch (RuntimeException e) {
		// Compatibility fallback: legacy model options may omit this category.
		hasLeafRemovalCarbonDeficit = false;
	}
	if (hasLeafRemovalCarbonDeficit) {
		try {
			enableCarbonDeficitLeafRemoval = config.getBoolean("enableCarbonDeficitLeafRemoval", enableCarbonDeficitLeafRemoval);
		} catch (RuntimeException e) {
			// Keep the value loaded from model_functionality or the global default.
		}
		try {
			leafCarbonDeficitWindowDays = config.getDouble("leafCarbonDeficitWindowDays", leafCarbonDeficitWindowDays);
		} catch (RuntimeException e) {
			// Keep the value loaded from model_functionality or the global default.
		}
		try {
			leafCarbonDeficitBalanceThresholdMgC = config.getDouble("leafCarbonDeficitBalanceThresholdMgC", leafCarbonDeficitBalanceThresholdMgC);
		} catch (RuntimeException e) {
			// Keep the value loaded from model_functionality or the global default.
		}
		try {
			leafCarbonDeficitMinValidFraction = config.getDouble("leafCarbonDeficitMinValidFraction", leafCarbonDeficitMinValidFraction);
		} catch (RuntimeException e) {
			// Keep the value loaded from model_functionality or the global default.
		}
		try {
			leafCarbonDeficitMatureAgeFactor = config.getDouble("leafCarbonDeficitMatureAgeFactor", leafCarbonDeficitMatureAgeFactor);
		} catch (RuntimeException e) {
			// Keep the value loaded from model_functionality or the global default.
		}
		try {
			leafCarbonDeficitRemovalHour = config.getInteger("leafCarbonDeficitRemovalHour", leafCarbonDeficitRemovalHour);
		} catch (RuntimeException e) {
			// Keep the value loaded from model_functionality or the global default.
		}
		try {
			leafCarbonDeficitMinPlantLeafArea = config.getDouble("leafCarbonDeficitMinPlantLeafArea", leafCarbonDeficitMinPlantLeafArea);
		} catch (RuntimeException e) {
			// Keep the value loaded from model_functionality or the global default.
		}
	}


	/* desiredLeafArea_postPrune = config.getDouble("desiredLeafArea_postPrune", 0);
	desiredFruitNumber_postPrune = config.getInteger("desiredFruitNumber_postPrune", 0);
	 */
	
	/** Validation keeps shading-factor simplification but preserves an explicit backend selection. */
	if (ModelArgs.validationMode != null) {
		useShadingFactor = true;
		if (lightInterceptionValidationModeOverride == null
			&& !lightInterceptionModeExplicit && !lightInterceptionLegacyModeExplicit) {
			lightInterceptionModeRequested = "cpu";
			lightInterceptionModeResolved = "cpu";
		}
	}

	// Low-core headless execution is a GPU limitation only. Reduced modes must not be rewritten.
	if (Boolean.parseBoolean(ModelArgs.headless) == true && ModelArgs.nCores <= 2
		&& "gpu".equals(lightInterceptionModeResolved)) {
		if (lightInterceptionFallbackMode != null) {
			println("Warning: GPU light interception is unavailable with nCores <= 2; using explicit fallback '"
				+ lightInterceptionFallbackMode + "'.");
			lightInterceptionModeResolved = lightInterceptionFallbackMode;
		} else {
			recordLightInterceptionConfigurationError(
				"GPU light interception requires more than two cores in headless mode; configure lightInterceptionFallbackMode or select another mode");
		}
	}
	
	// Only override if provided
	if (ModelArgs.shadingFactor != null) {
		if (ModelArgs.shadingFactor.equalsIgnoreCase("true")) {
			globalParameters.useShadingFactor = true;
		} else if (ModelArgs.shadingFactor.equalsIgnoreCase("false")) {
			globalParameters.useShadingFactor = false;
		}
	}

	// Instance-clone shading is currently reliable only with the GPU light backend.
	// Warn when model options select the cloneFieldBase() path but keep the CPU light model.
	if (useShadingFactor == false
		&& (cloneX > 0 || cloneY > 0)
		&& ("standard".equals(initiation_method) || "ArchReaderGPU".equals(initiation_method))
		&& !"gpu".equals(lightInterceptionModeResolved)) {
		println("Warning: cloneFieldBase shading with initiation_method=" + initiation_method
			+ " is reliable only with lightInterceptionMode='gpu'."
			+ " Please use GridClonerNode with backend '" + lightInterceptionModeResolved + "'.");
	}

	try {
		String rayCountEnv = System.getenv("FRUITCROPXL_RAYCOUNT");
		if (rayCountEnv != null && rayCountEnv.trim().length() > 0) {
			int parsedRayCount = Integer.parseInt(rayCountEnv.trim());
			if (parsedRayCount > 0) {
				globalParameters.rayCount = parsedRayCount;
			}
		}
	} catch (RuntimeException e) {
		// Compatibility-safe fallback: keep the scenario/default rayCount.
	}
	println("lightInterceptionModeRequested: " + lightInterceptionModeRequested);
	println("lightInterceptionModeResolved: " + lightInterceptionModeResolved);

}

private static void calcValuesFromInput() {
	// some calculations for updating some values
	totalPlants = nrRows * nrPlants * nrStrips;
	if("grapevine".equals(species)) {
	if(bunchNumPerVine > bunchNumPerShoot * SHOOT_NUM ) 
	{
		totalFruitNum = bunchNumPerVine * berryNumPerBunch;
	} else { 
		totalFruitNum = berryNumPerBunch * bunchNumPerShoot * CORDEN_NUM * SHOOT_NUM;
	}
		BIOMASS_FRUIT	 = FRUIT_DRY_WEIGHT * totalFruitNum;//config.getDouble("BIOMASS_FRUIT");
	//berryNumPerBunch = (int) Math.round(BIOMASS_FRUIT/MEAN_BERRY_WEIGHT/(1+seedFraction));
	}

	dayOfYear = START_DAY;
	
	
	if (thermalUnit.equals("thermalDay")) {
		thermaltimeUnit = OPT_TEMP == 0 ? 0.5 : (Tmax + Tmin) / 2 / OPT_TEMP;
	} else if (thermalUnit.equals("growingDegreeDay")) {
		thermaltimeUnit = Math.min(1, ((Tmax + Tmin) / 2 - baseT));
	} else if (thermalUnit.equals("day")) {
		thermaltimeUnit = 1;
	}
	
	
	
	if(special_scenario != null && (special_scenario.equals("berry_population") ||
	   special_scenario.equals("singleRoot"))) {
		inputVesselConditions = true;
		if (printFlag) { println("inputVesselConditions " + inputVesselConditions); }
	}
	
	
		
	double woodRef = rootWoodRefMode == 1 ?
					 calcAbovegroundPerennialStructureBiomass(woodBiomassCalcMethod) :
					 calcTrunkBiomass(woodBiomassCalcMethod);
	applyRootBiomassInitializationFromWoodRef(woodRef, null);
		
		
}

/** Compatibility entry point retained for callers while backend construction is centralized. */
public static void ensureLightModelInitialized() {
	if (lightInterceptionConfigurationError != null
		&& lightInterceptionConfigurationError.trim().length() > 0) {
		throw new IllegalArgumentException("Invalid light-interception configuration: "
			+ lightInterceptionConfigurationError);
	}
	initializeLightInterceptionBackend();
	println("lightInterceptionModeRequested: " + lightInterceptionModeRequested);
	println("lightInterceptionModeResolved: " + lightInterceptionModeResolved);
	println("lightInterceptionModelFile: " + lightInterceptionModelFile);
	println("lightInterceptionFeatureManifestFile: " + lightInterceptionFeatureManifestFile);
	println("lightInterceptionInputFile: " + lightInterceptionInputFile);
	if (isMeteoDirectLeafLightMode()) {
		println("directLightInputSource: climate_file.totalRadiation*fPAR");
		println("directLightInputFile: " + climate_file);
		println("directLightInputUnit: umol/m2/s");
		println("directLightInputInterpretation: incident leaf PAR");
	}
	println("lightInterceptionFallbackMode: " + lightInterceptionFallbackMode);
	println("lightInterceptionBackendVersion: " + lightInterceptionBackendVersion);
	println("lightInterceptionAssetChecksum: " + lightInterceptionAssetChecksum);
	if (hasActiveBeerLambertLightModel()) {
		println("empiricalLightModel: beerLambertLaiAbove");
		println("empiricalLightTopRelativePAR: " + getActiveBeerLambertTopRelativePAR());
		println("empiricalLightExtinctionCoefficient: " + getActiveBeerLambertExtinctionCoefficient());
		println("empiricalLightUseHeightCoefficient: " + getActiveBeerLambertUseHeightCoefficient());
		println("empiricalLightHeightCoefficient: " + getActiveBeerLambertHeightCoefficient());
		println("empiricalLightStrict: " + getActiveBeerLambertStrict());
	}
}


/* static double[][] berryWeight_sim = new double[13][31];
static String  berryWeight_simfile;
 */

/**
 * Class to hold climate data.
 * <p>
 * Sequence of Execution:
 * </p>
 * <ol>
 *   <li>
 *     <strong>Initialization</strong>: First, the program starts by calling {@code initClimateData()}.
 *     Within this method, a {@code CsvMapper} object and a {@code CsvSchema} object are created.
 *   </li>
 *   <li>
 *     <strong>Reading CSV</strong>: The {@code CsvMapper} reads the values from the CSV file specified by "PATH_INPUT + climate_file.csv".
 *     It attempts to map these values to a {@code JsonNode} object according to the provided {@code CsvSchema}.
 *   </li>
 *   <li>
 *     <strong>Deserialization</strong>: When the {@code CsvMapper} encounters the {@code soilWater} field, it knows that this field
 *     requires special treatment for deserialization. This is specified by the {@code @JsonDeserialize(using = ClimateListDeserializer.class)} annotation.
 *   </li>
 *   <li>
 *     <strong>Custom Deserialization</strong>: The {@code ClimateListDeserializer} class, which extends {@code JsonDeserializer}, is invoked.
 *     The {@code deserialize} method within this class is responsible for converting the {@code soilWater} field from a string to an {@code ArrayList} of doubles.
 *   </li>
 * </ol>
 *
 * @see ClimateListDeserializer
 */
   class ClimateData implements Serializable {
   	   /**
     * The weather station where the data was recorded.
     */
    public String station;
    
    /**
     * The year the data was recorded.
     * Unit: YYYY (e.g., 2022)
     */
    public int year;
    
    /**
     * The day of the year the data was recorded.
     * Unit: Day of year (1-365 or 1-366 for leap years)
     */
    public int day;
    
    /**
     * The hour of the day the data was recorded.
     * Unit: Hour of day (0-23)
     */
    public int hour;
    
    /**
     * The temperature at the time of recording.
     * Unit: Degrees Celsius
     */
    public double temp;
    
    /**
     * The relative humidity at the time of recording.
     * Unit: Percentage (%)
     */
    public double rh;
    
    /**
     * The total radiation at the time of recording.
     * Unit: µmol/m²/s (micro moles per square meter per second)
     */
	    public double totalRadiation = Double.NaN;
    
    /**
     * The CO2 concentration at the time of recording.
     * Unit: ppm (parts per million)
     */
    public double CO2;
    
    /**
     * The wind speed at the time of recording.
     * Unit: m/s (meters per second)
     */
    public double wind;
        
    /**
     * The soil water content values.
     * Deserialization of this field is customized using the ClimateListDeserializer class.
     * @see ClimateListDeserializer
     */
    @JsonDeserialize(using = ClimateListDeserializer.class)
    public Object soilWater_potential;  //MPa, Object since no generics
        
    @JsonDeserialize(using = ClimateListDeserializer.class)
    public Object soilWater_content;  //Vol_Content Object since no generics
    
     /**
     * The hourly rainfall
     * Unit: mm
     * optional
     */
    public double rainfall;

    }

/**
 * Custom deserializer for soil water fields in the ClimateData class.
 */
 class ClimateListDeserializer extends JsonDeserializer {

    /**
     * Converts a string of comma-separated values into an ArrayList of doubles.
     * @param p The JSON parser.
     * @param ctxt The deserialization context.
     * @return An ArrayList of doubles.
     * @throws IOException If an input or output exception occurred.
     */
    @Override
    public Object deserialize(JsonParser p, DeserializationContext ctxt) throws IOException {
        String fieldValue = p.getValueAsString();
        StringTokenizer tokenizer = new StringTokenizer(fieldValue, ",");
        ArrayList list = new ArrayList();
        while (tokenizer.hasMoreTokens()) {
            list.add(Double.valueOf(tokenizer.nextToken().trim()));
        }
        return list;  // return as Object
    }
    }

global ArrayList climateList;  // Changed to ArrayList due to no generics
   
static void initClimateData() {
	climateList = null;
	    try {
    	
        CsvMapper csvMapper = new CsvMapper();
        //HANDLE extra columns
        csvMapper.enable(CsvParser.Feature.IGNORE_TRAILING_UNMAPPABLE);
        //slight changes in the column name in excel is fine, but sequence needs to be right
      CsvSchema csvSchema = CsvSchema.builder()
		.addColumn("station")
		.addColumn("year")
      	.addColumn("day")
		.addColumn("hour")
		.addColumn("temp")
		.addColumn("rh")
		.addColumn("totalRadiation")
		.addColumn("CO2")
		.addColumn("wind")
		.addColumn("soilWater_potential")
		.addColumn("soilWater_content")
		.addColumn("rainfall")
		.setUseHeader(true)
		.build();
        
        File inputFile = new File(PATH_INPUT + climate_file);
        if (!inputFile.exists()) {
            if (printFlag) { println("File does not exist: " + inputFile.getAbsolutePath()); }
            return;
        }

        climateList = new ArrayList(csvMapper.readerFor(ClimateData.class)
                .with(csvSchema)
                .readValues(inputFile)
                .readAll());


        if (climateList == null) {
            if (printFlag) { println("climateList is still null after reading"); }
        } else {
            if (printFlag) { println("Successfully read " + climateList.size() + " records."); }
        }

	} catch (Exception e) {
		if (calcLightInterception && isMeteoDirectLeafLightMode()) {
			throw new IllegalArgumentException("Unable to load climate_file for meteo direct leaf light: "
				+ climate_file + ". " + e.getMessage(), e);
		}
		e.printStackTrace();
		if (printFlag) { println("Exception while initializing climate data: " + e.getMessage()); }
	}
}

    
public static void readCsvFiles() {
	PATH = PATH_INPUT;
	if (printFlag) { println(FILE_NAME_MODEL_OPTIONS); }
	if (calcLightInterception && isMeteoDirectLeafLightMode()) {
		resolveMeteoDirectClimateFile();
	}

	if (!isStringNull(organSize_file)) {
		organSize = readData(organSize_file);
	}
	if (hasOrganSizeInput()) {
		ensureOrganSizeProfilesLoaded();
	}
	
	if (!isStringNull(climate_file)) {
		initClimateData();
	}
	if (calcLightInterception && isMeteoDirectLeafLightMode()
		&& (climateList == null || climateList.size() == 0)) {
		throw new IllegalArgumentException("lightInterceptionMode=directInput in leaf gas-exchange test mode requires "
			+ "inputEnvironmentCondition=true and a readable climate_file containing totalRadiation in umol m-2 s-1.");
	}
	
	
	if (useShadingFactor == true) {
		if (!isStringNull(shadingFactor_file)) {
			if (printFlag) { println("Shading factor enabled; loading file: " + PATH_INPUT + shadingFactor_file); }
			SFT = new ShadingFactorTable();
			SFT.load(PATH_INPUT + shadingFactor_file); // your uploaded file
		} else {
			if (printFlag) { println("Shading factor enabled; no shading-factor file configured; using neutral ratios (all 1.0)"); }
			SFT = null;
		}
	} else {
		if (printFlag) { println("Shading factor disabled; using neutral ratios (all 1.0)"); }
		SFT = null;
	}
	
		
	if (useStructuralVariation == true) {
		if (!isStringNull(structuralVariationShoot_file)) {
			structuralVariationShoot = readData(structuralVariationShoot_file);
		}
		if (!isStringNull(structuralVariationLeaf_file)) {
			structuralVariationLeaf = readData(structuralVariationLeaf_file);
		}
	}
	                                                     
	if (!isStringNull(berryModelInput_file)
		|| (organGrowthMethod.equals("TempLimited")
			&& main.FRUIT_CREATOR.usesComplexBerryService())) {
		if (printFlag) { println(" berryModelInput " + berryModelInput_file); }
		berryModelInput = readData(berryModelInput_file);
	}
	if (!isStringNull(rootModelInput_file)) {
		if(printFlag) { println(" rootModelInput " + rootModelInput_file); }
		rootModelInput = readData(rootModelInput_file);
	}
	
	
	if (!isStringNull(berryWeight_file)) {
		berryWeight = readData(berryWeight_file);
	}
	
	if (!isStringNull(climate_file)) {			
		//check the start step
	 	setStartStep();
		if (printFlag) { println("climate data length " + climateList.size()); }
		if (printFlag) { println(" startStep " + startStep); }
		
		climateList = reduceListSize(climateList, startStep, halt*24 + 1);

		if (printFlag) { println("climate data length " + climateList.size()); }
		
	}
	
	//if(par_sampling_file.length() > 3) {
		// parSampling = readData(par_sampling_file);	
	//}
	
	
	//test the log likelihood
	//berryWeight_simfile = "Exp2013_Bobeica_Italy_12_leaves_berry_simulation_results.test.likelood.csv";
	//berryWeight_sim = readData(berryWeight_simfile);
	//if (printFlag) { println(berryWeight_sim[1][1]); }
	
	
}
// end property loader ********************************************************/



// ---- helpers (Java 1.5 compatible) -----------------------------------------

/**
 * Copy the contents of one file to another using a byte buffer.
 * Creates parent directories for the destination file if they do not exist.
 *
 * @param src   source file
 * @param dest  destination file
 * @throws java.io.IOException if file IO fails
 */
static void copyFile(File src, File dest) throws java.io.IOException {
    java.io.FileInputStream input = null;
    java.io.FileOutputStream out = null;
    try {
        if (dest.getParentFile() != null) dest.getParentFile().mkdirs();
        input = new java.io.FileInputStream(src);
        out = new java.io.FileOutputStream(dest);
        byte[] buf = new byte[8192];
        int len;
        while ((len = input.read(buf)) > 0) out.write(buf, 0, len);
    } finally {
        try { if (input != null) input.close(); } catch (Exception e) {}
        try { if (out != null) out.close(); } catch (Exception e) {}
    }
}

/**
 * Convert a possibly null path string to a File.
 *
 * @param path  path string (may be null)
 * @return      File for the path, or null if path was null
 */
private static File nullSafeFile(String path) {
    return path == null ? null : new File(path);
}

/**
 * Extract the base name (last component) of a file path string.
 *
 * @param path  input path (may be null)
 * @return      name of the file, or null if path was null
 */
private static String baseName(String path) {
    if (path == null) return null;
    return new File(path).getName();
}

/**
 * Copy a file into a target directory if the source exists and is a regular file.
 * The copied file keeps its original name.
 *
 * @param src   source File
 * @param dir   destination directory
 */
private static void copyIfExistsToDir(File src, File dir) {
    if (src == null) return;
    try {
        if (src.exists() && src.isFile()) {
            copyFile(src, new File(dir, src.getName())); // keep original name
        }
    } catch (Exception e) {
        e.printStackTrace(); // non-fatal
    }
}

// ----------------------------------------------------------------------------

/**
 * Save a reproducible record of the current run configuration:
 * <ul>
 *   <li>Copies the main config file into run-config/</li>
 *   <li>Copies required and optional input files (from PATH_SCENARIOS or PATH_INPUT)</li>
 *   <li>Writes a minimal snapshot of selected parameters to run-settings.snapshot.properties</li>
 * </ul>
 *
 * @param outputPath      path to the main output directory
 * @param configFileUsed  path to the configuration file used for this run
 */
static void saveRunInputsAndSnapshot(String outputPath, String configFileUsed) {
    File runCfgDir = new File(outputPath, "run-config");
    // remove old folder if exists
    deleteRecursively(runCfgDir);
    runCfgDir.mkdirs();

    // 1) Copy the main config
    if (configFileUsed != null) {
        copyIfExistsToDir(new File(configFileUsed), runCfgDir);
    }

    // 2) Copy referenced inputs
    // Required: resolve relative to PATH_SCENARIOS
    copyResolved(FILE_NAME_INITIAL_CONDITIONS, PATH_SCENARIOS, runCfgDir);
    copyResolved(FILE_NAME_PLANT_PARAMETERS,   PATH_SCENARIOS, runCfgDir);
    copyResolved(FILE_NAME_SOIL_PARAMETERS,    PATH_SCENARIOS, runCfgDir);
    copyResolved(FILE_NAME_OPTIMAL_CANOPY_ARCHITECTURE, PATH_SCENARIOS, runCfgDir);
    copyResolved(FILE_NAME_PHENOLOGY_PARAMETERS, PATH_INPUT, runCfgDir);
    
    // Optional: resolve relative to PATH_INPUT
    copyResolved(climate_file,                   PATH_INPUT, runCfgDir);
    copyResolved(virtualFruitParameter_file,     PATH_INPUT, runCfgDir);
    copyResolved(virtualFruitModelInput_file,    PATH_INPUT, runCfgDir);
    copyResolved(organSize_file,                 PATH_INPUT, runCfgDir);
    copyResolved(rosetteProfileFile,             PATH_INPUT, runCfgDir);
    copyResolved(bourseProfileFile,              PATH_INPUT, runCfgDir);
    copyResolved(vegShootProfileFile,            PATH_INPUT, runCfgDir);
    copyResolved(berryWeight_file,               PATH_INPUT, runCfgDir);
    copyResolved(structuralVariationShoot_file,  PATH_INPUT, runCfgDir);
    copyResolved(structuralVariationLeaf_file,   PATH_INPUT, runCfgDir);
    copyResolved(berryModelInput_file,           PATH_INPUT, runCfgDir);
    copyResolved(shootArchitecture_file,         PATH_INPUT, runCfgDir);
	    copyResolved(rootArchitecture_file,          PATH_INPUT, runCfgDir);
	    copyResolved(rootModelInput_file,            PATH_INPUT, runCfgDir);
	    copyIfExistsToDir(getResolvedLightInterceptionModelAsset(), runCfgDir);
	    copyResolved(lightInterceptionFeatureManifestFile, PATH_INPUT, runCfgDir);
	    copyResolved(lightInterceptionInputFile,     PATH_INPUT, runCfgDir);
    

    // 3) Minimal snapshot (only a few key fields; add more if you want)
    java.io.PrintWriter pw = null;
    try {
        pw = new java.io.PrintWriter(new java.io.File(runCfgDir, "run-settings.snapshot.properties"));
        pw.println("timestamp=" + new java.text.SimpleDateFormat("yyyy-MM-dd_HH-mm-ss").format(new java.util.Date()));
        pw.println("config_file_used=" + baseName(configFileUsed));
        pw.println("species=" + species);
        pw.println("initiation_method=" + initiation_method);
        pw.println("special_scenario=" + special_scenario);

        // core toggles that affect physics/outputs
	        pw.println("fruitModule=" + fruitModule);
		        pw.println("calcLightInterception=" + calcLightInterception);
		        pw.println("lightInterceptionModeRequested=" + lightInterceptionModeRequested);
		        pw.println("lightInterceptionModeResolved=" + lightInterceptionModeResolved);
			        pw.println("lightInterceptionModelFile=" + (lightInterceptionModelFile == null ? "" : lightInterceptionModelFile));
			        pw.println("lightInterceptionFeatureManifestFile=" + lightInterceptionFeatureManifestFile);
			        pw.println("lightInterceptionInputFile=" + (lightInterceptionInputFile == null ? "" : lightInterceptionInputFile));
			        pw.println("directLightInputSource=" + (isMeteoDirectLeafLightMode() ? "climate_file.totalRadiation*fPAR" : ""));
			        pw.println("directLightInputFile=" + (isMeteoDirectLeafLightMode() ? climate_file : ""));
			        pw.println("directLightInputUnit=" + (isMeteoDirectLeafLightMode() ? "umol/m2/s" : ""));
			        pw.println("directLightInputInterpretation=" + (isMeteoDirectLeafLightMode() ? "incident leaf PAR" : ""));
		        pw.println("lightInterceptionFallbackMode=" + lightInterceptionFallbackMode);
			        pw.println("lightInterceptionBackendVersion=" + lightInterceptionBackendVersion);
			        pw.println("lightInterceptionAssetChecksum=" + lightInterceptionAssetChecksum);
			        pw.println("empiricalLightModel=" + (hasActiveBeerLambertLightModel() ? "beerLambertLaiAbove" : ""));
			        pw.println("empiricalLightTopRelativePAR=" + (hasActiveBeerLambertLightModel() ? String.valueOf(getActiveBeerLambertTopRelativePAR()) : ""));
			        pw.println("empiricalLightExtinctionCoefficient=" + (hasActiveBeerLambertLightModel() ? String.valueOf(getActiveBeerLambertExtinctionCoefficient()) : ""));
			        pw.println("empiricalLightUseHeightCoefficient=" + (hasActiveBeerLambertLightModel() ? String.valueOf(getActiveBeerLambertUseHeightCoefficient()) : ""));
			        pw.println("empiricalLightHeightCoefficient=" + (hasActiveBeerLambertLightModel() ? String.valueOf(getActiveBeerLambertHeightCoefficient()) : ""));
			        pw.println("empiricalLightStrict=" + (hasActiveBeerLambertLightModel() ? String.valueOf(getActiveBeerLambertStrict()) : ""));
		        pw.println("calcCarbonAllocation=" + calcCarbonAllocation);
	        pw.println("groundShaderMode=" + groundShaderMode);
	        pw.println("scaleLeafSizeToTargetMeanLeafArea=" + scaleLeafSizeToTargetMeanLeafArea);
	        pw.println("outputLeafGrowthDiagnostics=" + outputLeafGrowthDiagnostics);
	        pw.println("debugLeafExpansion=" + debugLeafExpansion);
	        pw.println("debugLeafExpansionSampleEvery=" + debugLeafExpansionSampleEvery);
	        pw.println("outputAppleDevelopmentDiagnostics=" + outputAppleDevelopmentDiagnostics);
	        pw.println("outputCarbonTransportDiagnostics=" + outputCarbonTransportDiagnostics);
	        pw.println("outputWaterFluxSolverDebug=" + outputWaterFluxSolverDebug);

        // timing (useful for reproducing a specific run window)
        pw.println("START_YEAR=" + START_YEAR);
        pw.println("START_DAY=" + START_DAY);
        pw.println("harvestDAWS=" + harvestDAWS);

        // file refs (resolved)
        pw.println("FILE_NAME_INITIAL_CONDITIONS=" + FILE_NAME_INITIAL_CONDITIONS);
        pw.println("FILE_NAME_PLANT_PARAMETERS=" + FILE_NAME_PLANT_PARAMETERS);
        pw.println("FILE_NAME_SOIL_PARAMETERS=" + FILE_NAME_SOIL_PARAMETERS);
        pw.println("climate_file=" + climate_file);
        // (add any extras you care about below)
        // pw.println("virtualFruitParameter_file=" + virtualFruitParameter_file);
        // ...
    } catch (Exception e) {
        e.printStackTrace();
    } finally {
	    if (pw != null) pw.close();
	    }
	}


/** Refresh retained configuration provenance after a successful runtime backend fallback. */
public static void refreshLightInterceptionSnapshotProvenanceIfNeeded() {
	if (consumeLightInterceptionProvenanceRefreshRequest()) {
		updateLightInterceptionSnapshotProvenance();
	}
}


private static void updateLightInterceptionSnapshotProvenance() {
	File snapshot = new File(new File(PATH_OUTPUT, "run-config"), "run-settings.snapshot.properties");
	if (!snapshot.isFile()) return;
	java.io.FileInputStream input = null;
	java.io.FileOutputStream output = null;
	try {
		java.util.Properties properties = new java.util.Properties();
		input = new java.io.FileInputStream(snapshot);
		properties.load(input);
		input.close();
		input = null;
		properties.setProperty("lightInterceptionModeRequested", String.valueOf(lightInterceptionModeRequested));
		properties.setProperty("lightInterceptionModeResolved", String.valueOf(lightInterceptionModeResolved));
		properties.setProperty("lightInterceptionModelFile", String.valueOf(lightInterceptionModelFile));
		properties.setProperty("lightInterceptionFeatureManifestFile", String.valueOf(lightInterceptionFeatureManifestFile));
		properties.setProperty("lightInterceptionInputFile", String.valueOf(lightInterceptionInputFile));
		properties.setProperty("directLightInputSource", isMeteoDirectLeafLightMode()
			? "climate_file.totalRadiation*fPAR" : "");
		properties.setProperty("directLightInputFile", isMeteoDirectLeafLightMode() ? String.valueOf(climate_file) : "");
		properties.setProperty("directLightInputUnit", isMeteoDirectLeafLightMode() ? "umol/m2/s" : "");
		properties.setProperty("directLightInputInterpretation", isMeteoDirectLeafLightMode()
			? "incident leaf PAR" : "");
		properties.setProperty("lightInterceptionFallbackMode", String.valueOf(lightInterceptionFallbackMode));
		properties.setProperty("lightInterceptionBackendVersion", String.valueOf(lightInterceptionBackendVersion));
		properties.setProperty("lightInterceptionAssetChecksum", String.valueOf(lightInterceptionAssetChecksum));
		properties.setProperty("empiricalLightModel", hasActiveBeerLambertLightModel()
			? "beerLambertLaiAbove" : "");
		properties.setProperty("empiricalLightTopRelativePAR", hasActiveBeerLambertLightModel()
			? String.valueOf(getActiveBeerLambertTopRelativePAR()) : "");
		properties.setProperty("empiricalLightExtinctionCoefficient", hasActiveBeerLambertLightModel()
			? String.valueOf(getActiveBeerLambertExtinctionCoefficient()) : "");
		properties.setProperty("empiricalLightUseHeightCoefficient", hasActiveBeerLambertLightModel()
			? String.valueOf(getActiveBeerLambertUseHeightCoefficient()) : "");
		properties.setProperty("empiricalLightHeightCoefficient", hasActiveBeerLambertLightModel()
			? String.valueOf(getActiveBeerLambertHeightCoefficient()) : "");
		properties.setProperty("empiricalLightStrict", hasActiveBeerLambertLightModel()
			? String.valueOf(getActiveBeerLambertStrict()) : "");
		output = new java.io.FileOutputStream(snapshot);
		properties.store(output, "FruitCropXL run settings; light-interception provenance refreshed after fallback");
	} catch (Exception e) {
		println("[LightInterception] Warning: unable to refresh run-settings snapshot after fallback: " + e.getMessage());
	} finally {
		if (input != null) {
			try { input.close(); } catch (Exception ignored) {}
		}
		if (output != null) {
			try { output.close(); } catch (Exception ignored) {}
		}
	}
}

	/**
	 * Resolve a file path relative to a given base directory if not absolute,
 * and copy it into the target directory.
 *
 * @param path      path string to resolve
 * @param baseDir   base directory (used only if path is not absolute)
 * @param destDir   destination directory
 */
private static void copyResolved(String path, String baseDir, File destDir) {
    if (path == null) return;

    File f = new File(path);
    if (!f.isAbsolute() && baseDir != null) {
        f = new File(baseDir, path);
    }

    copyIfExistsToDir(f, destDir);
}
private static double[] toPrimitiveOrDefault(Double[] wrapper, double[] current) {
    // If nothing came from config, keep the in-memory defaults
    if (wrapper == null) {
        return current;
    }

    int n = wrapper.length;
    double[] result = new double[n];

    for (int i = 0; i < n; i++) {
        // if an element is null, fall back to 0.0 (or keep old value if lengths match)
        if (wrapper[i] != null) {
            result[i] = wrapper[i].doubleValue();
        } else if (current != null && i < current.length) {
            result[i] = current[i];
        } else {
            result[i] = 0.0;
        }
    }
    return result;
}

private static Double[] safeGetDoubleArray(CategoryStore config, String key) {

    // 1) Try reading raw string value first (debug aid)
    String raw = null;
    try {
        raw = config.getString(key, null);
    } catch (RuntimeException e) {
        // Compatibility: some scenario files store this key as a real JSON array.
        raw = null;
    }

    if (raw != null) {
        String trimmed = raw.trim();

        // Case: empty / blank / "null" → treat as no array
        if (trimmed.length() == 0 || trimmed.equalsIgnoreCase("null")) {
            println("[Config] INFO: Key '" + key + "' is empty or null-string; skipping.");
            return null;
        }

        // Case: Looks like CSV (contains commas / semicolons / spaces)
        if (trimmed.indexOf(',') >= 0 || trimmed.indexOf(';') >= 0 || trimmed.matches(".*\\s+.*")) {
            println("[Config] DEBUG: Key '" + key + "' looks like CSV → parsing manually: " + trimmed);

            String[] tokens = trimmed.split("[,;\\s]+");
            Double[] out = new Double[tokens.length];

            for (int i = 0; i < tokens.length; i++) {
                try {
                    out[i] = Double.valueOf(tokens[i]);
                } catch (Throwable t) {
                    println("[Config] WARN: Failed to parse token '" + tokens[i] + "' for key '" + key + "'");
                    out[i] = null;
                }
            }
            return out;
        }
    }

    // 2) If not CSV → try using the normal array parser
    try {
        Double[] fromConfig = config.getDoubleArray(key);
        return fromConfig;
    }
    catch (Throwable ex) {
        println("[Config] WARN: getDoubleArray('" + key + "') failed: " + ex);
        println("[Config] Value for '" + key + "' (raw) = " + raw);
        return null;
    }
}
