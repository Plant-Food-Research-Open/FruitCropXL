		leafPhotosynthesisFallbackFpar = config.getDouble("leafPhotosynthesisFallbackFpar", 0.30);
		continueFallbackUntilLeafLightValid = config.getBoolean("continueFallbackUntilLeafLightValid", true);
	} catch (RuntimeException e) {
