/**
 * Specifies soil conditions, including the number of root and soil layers, soil water potential, soil water content, and grid cell size for complex soil simulation.
 * These values are essential for initializing the model and will be overwritten when the climate file is read to avoid compile errors.
 */

/** Number of root and soil layers, essential for model initialization. */
global int numofSoilLayers = 4;

/** Mean of the input soil water potential, vital for simulating soil water availability. */
global double inputWaterPotential = -0.1;

/** Array representing soil water potential at different soil layers. */
global double[] soilWaterPotentialArray = {-0.05, -0.1, -0.1, -0.1};

/** Array representing volumetric water content at different soil layers. */
global double[] soilWaterContentArray = {0.2, 0.25, 0.25, 0.25};

/** Array representing soluble NO3 content at different soil layers. */
global double[] soilSoluteNO3ContentArray = {0.0, 0.0, 0.0, 0.0};

/** Array representing temperature at different soil layers. */
global double[] soilTempContentArray = {0.0, 0.0, 0.0, 0.0};

/**
 * Height where the light intensity was measured.
 * for validating the light penetration in canopy
 * light sensors were placed in the same height
 */
global double [] output_height = {0.9, 1.4, 2, 3};

/**
 * Light-sensor placement heights.
 * Keeps reported output_height bands unchanged and appends one extra top layer
 * for the sky-reference sensor when light sensors are enabled.
 */
global double [] sensor_heights = {0.9, 1.4, 2, 3};

private static void refreshSensorHeights() {
	if (output_height == null || output_height.length == 0) {
		sensor_heights = new double[0];
		return;
	}

	int sensorCount = output_height.length;
	if (useLightSensors == true) {
		sensorCount++;
	}

	sensor_heights = new double[sensorCount];
	System.arraycopy(output_height, 0, sensor_heights, 0, output_height.length);

	if (useLightSensors == true) {
		sensor_heights[output_height.length] = output_height[output_height.length - 1] * 1.5;
	}
}

static void validateSoilWaterContent(double[] soilWaterContentArray) {

    for (int i = 0; i < soilWaterContentArray.length; i++) {
        float value = soilWaterContentArray[i];

        if (value <= 0 || value != value) { // value != value checks for NaN in XL
            println("Error: Invalid soil water content at index " + i + ": " + value);
            
            println("setting to default value");
            soilWaterContentArray[i] = 0.25;
        }
    }

    println("All soil water content values are valid.");
}

/** Grid cell size for the complex soil simulation, impacting the spatial resolution of soil processes. */
global double soilGridSize = 0.2;  // dx (along row)      ← from CSV 'gridSize'
global double soilGridWidth = 0.2; // dy (across row)     ← from CSV 'gridWidth' (optional)


/**
 * Mode for stomatal water response function.
 * Determines how stomatal behavior is affected by environmental signals.
 * Options:
 * <ul>
 *   <li>{@link #WATER_POTENTIAL_ONLY}: Stomatal response is based only on water potential.</li>
 *   <li>{@link #WATER_POTENTIAL_AND_ABA}: Stomatal response incorporates both water potential and abscisic acid (ABA) signaling.</li>
 * </ul>
 */
 /**
 * Stomatal response mode: only water potential is considered in determining stomatal conductance.
 * Suitable for simple hydraulic-driven models.
 */
global int WATER_POTENTIAL_ONLY = 1;

/**
 * Stomatal response mode: both water potential and ABA signaling are considered.
 * Suitable for models that account for chemical signaling under drought stress.
 */
global int WATER_POTENTIAL_AND_ABA = 2;

global int stomataWaterResFunction = WATER_POTENTIAL_ONLY;



/**
 * Mode for root Relative Growth Rate (RGR) calculation.
 * Determines how the RGR of roots is computed over the season.
 * Options:
 * <ul>
 *   <li>{@link #RGR_MODE_SEASONAL}: RGR varies based on the time of year (days since winter solstice).</li>
 *   <li>{@link #RGR_MODE_CONSTANT}: RGR is constant throughout the growing season.</li>
 * </ul>
 */
/**
 * Root RGR mode: seasonal time-dependent RGR based on phenology.
 * Uses a dynamic function (e.g., beta function) to model variation in growth rate.
 */
global int RGR_MODE_SEASONAL = 1;

/**
 * Root RGR mode: constant relative growth rate.
 * Applies a fixed RGR value regardless of time of year or phenological stage.
 */
 
global int RGR_MODE_CONSTANT = 2;

global int rootRGRMode = RGR_MODE_CONSTANT;



