		try {
				useLightTreatment = config.getBoolean("useLightTreatment", false);
				lightTreatmentIntensity = config.getDouble("lightTreatmentIntensity", 1.0);
				lightTreatmentStartDOY = config.getInteger("lightTreatmentStartDOY", 1);
				lightTreatmentEndDOY = config.getInteger("lightTreatmentEndDOY", 365);
		} catch (Exception e) {
			if (printFlag) { println("[Config] WARN: failed to read light treatment settings; using defaults (false, 1.0). " + e.getMessage()); }
				useLightTreatment = false;
				lightTreatmentIntensity = 1.0;
				lightTreatmentStartDOY = 1;
				lightTreatmentEndDOY = 365;
			}

				try {
					groundShaderMode = config.getString("groundShaderMode", "AUTO");
				} catch (Exception e) {
					groundShaderMode = "AUTO";
				}
				if (groundShaderMode == null) {
					groundShaderMode = "AUTO";
				}
				String groundShaderModeNormalized = groundShaderMode.trim().toUpperCase();
				if ("AUTO".equals(groundShaderModeNormalized)) {
					SelectedGroundShader = OrchardFloorShader;
				} else if ("ORCHARD".equals(groundShaderModeNormalized) || "ORCHARD_FLOOR".equals(groundShaderModeNormalized)
						|| "DEFAULT".equals(groundShaderModeNormalized)) {
					SelectedGroundShader = OrchardFloorShader;
				} else if ("EXTENDAY".equals(groundShaderModeNormalized) || "REFLECTIVE_FILM".equals(groundShaderModeNormalized)
						|| "FILM".equals(groundShaderModeNormalized) || "REFLECTIVE".equals(groundShaderModeNormalized)) {
					SelectedGroundShader = ExtendayFilmShader;
				} else if ("BLACK".equals(groundShaderModeNormalized) || "NO_REFLECTION".equals(groundShaderModeNormalized)
						|| "DARK".equals(groundShaderModeNormalized)) {
					SelectedGroundShader = BlackGroundShader;
				} else {
					SelectedGroundShader = OrchardFloorShader;
					if (printFlag && !warnedGroundShaderMode) {
						println("[WARN] mean_climate.groundShaderMode invalid (" + groundShaderMode + "); using AUTO mode.");
						warnedGroundShaderMode = true;
					}
					groundShaderModeNormalized = "AUTO";
				}
				groundShaderMode = groundShaderModeNormalized;
				lightTreatmentStartDOY = Math.max(1, Math.min(366, lightTreatmentStartDOY));
				lightTreatmentEndDOY = Math.max(1, Math.min(366, lightTreatmentEndDOY));
			if (lightTreatmentIntensity < 0) {
			if (printFlag) { println("[Config] WARN: lightTreatmentIntensity < 0; clamping to 0."); }
			lightTreatmentIntensity = 0;
		}
		if (lightTreatmentIntensity > 2 && printFlag) {
			println("[Config] INFO: lightTreatmentIntensity > 2 (" + lightTreatmentIntensity + ").");
		}
		inputRadiation = config.getBoolean("inputRadiation", false);
