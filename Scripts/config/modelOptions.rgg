		leafPhotosynthesisFallbackLAI = 1.0e-4;
		leafPhotosynthesisFallbackFpar = 0.30;
		continueFallbackUntilLeafLightValid = true;
	}
	if (Double.isNaN(leafPhotosynthesisFallbackLAI) || Double.isInfinite(leafPhotosynthesisFallbackLAI) ||
		leafPhotosynthesisFallbackLAI < 0.0) {
		leafPhotosynthesisFallbackLAI = 1.0e-4;
	}
	if (Double.isNaN(leafPhotosynthesisFallbackFpar) || Double.isInfinite(leafPhotosynthesisFallbackFpar) ||
		leafPhotosynthesisFallbackFpar < 0.0) {
		leafPhotosynthesisFallbackFpar = 0.30;
	}
	if (leafPhotosynthesisFallbackFpar > 1.0) {
