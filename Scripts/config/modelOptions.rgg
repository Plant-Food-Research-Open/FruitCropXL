public static boolean hasOrganSizeInput() {
	return !isStringNull(organSize_file);
}

private static String resolveInputPath(String path) {
	if (isStringNull(path)) return null;
	File f = new File(path);
	if (!f.isAbsolute()) {
		f = new File(PATH_INPUT, path);
	}
	return f.getPath();
}

public static void ensureOrganSizeProfilesLoaded() {
	if (organSizeProfilesLoaded) return;
	if (!hasOrganSizeInput()) return;

	String rosettePath = resolveInputPath(rosetteProfileFile);
	String boursePath = resolveInputPath(bourseProfileFile);
	String vegPath = resolveInputPath(vegShootProfileFile);

	if (isStringNull(rosettePath)) {
		throw new RuntimeException("organ-size input is active but rosetteProfileFile is not configured");
	}
	if (isStringNull(boursePath)) {
		throw new RuntimeException("organ-size input is active but bourseProfileFile is not configured");
	}

	rosetteLeafProfile = loadProfile(rosettePath, "leaf.rank", "leaf.area");
	rosetteLeafLengthProfile = loadProfile(rosettePath, "leaf.rank", "leaf.length");
	rosetteLeafWidthProfile = loadProfile(rosettePath, "leaf.rank", "leaf.width");
	rosetteInternodeProfile = loadProfile(rosettePath, "leaf.rank", "internode.length");
	rosettePetioleProfile = loadOptionalProfile(rosettePath, "leaf.rank", "petile.length");
	bourseLeafProfile = loadProfile(boursePath, "leaf.rank", "leaf.area");
	bourseLeafLengthProfile = loadProfile(boursePath, "leaf.rank", "leaf.length");
	bourseLeafWidthProfile = loadProfile(boursePath, "leaf.rank", "leaf.width");
	bourseInternodeProfile = loadProfile(boursePath, "leaf.rank", "internode.length");
	boursePetioleProfile = loadOptionalProfile(boursePath, "leaf.rank", "petile.length");
	if (!isStringNull(vegPath)) {
		vegShootLeafProfile = loadProfile(vegPath, "leaf.rank", "leaf.area");
		vegShootLeafLengthProfile = loadProfile(vegPath, "leaf.rank", "leaf.length");
		vegShootLeafWidthProfile = loadProfile(vegPath, "leaf.rank", "leaf.width");
		vegShootInternodeProfile = loadProfile(vegPath, "leaf.rank", "internode.length");
		vegShootPetioleProfile = loadOptionalProfile(vegPath, "leaf.rank", "petile.length");
	} else {
		vegShootLeafProfile = null;
		vegShootLeafLengthProfile = null;
		vegShootLeafWidthProfile = null;
		vegShootInternodeProfile = null;
		vegShootPetioleProfile = null;
	}
	organSizeProfilesLoaded = true;
	if (printFlag) {
		println("[organ-size] loaded profiles: rosette=" + rosettePath + ", bourse=" + boursePath + ", vegetative=" + vegPath);
	}
}

public static boolean isNumeric(String v) {
	if (v == null || v.length() == 0) return false;
	try {
		Double.parseDouble(v);
		return true;
	} catch (NumberFormatException e) {
		return false;
	}
}

public static double[][] loadProfile(String path, String xColumn, String yColumn) {
	File f = new File(path);
	if (!f.exists() || !f.isFile()) {
		throw new RuntimeException("Organ-size profile file not found: " + path);
	}
	ArrayList xList = new ArrayList();
	ArrayList yList = new ArrayList();
	BufferedReader br = null;
	int xIdx = -1;
	int yIdx = -1;
	boolean headerProcessed = false;
	try {
		br = new BufferedReader(new FileReader(f));
		String line = null;
		while ((line = br.readLine()) != null) {
			line = line.trim();
			if (line.length() == 0 || line.startsWith("#")) continue;
			String[] parts = line.split(",");
			if (parts.length < 2) continue;
			if (!headerProcessed) {
				headerProcessed = true;
				if (!isNumeric(parts[0].trim())) {
					int i;
					for (i = 0; i < parts.length; i++) {
						String h = parts[i].trim();
						if (h.equalsIgnoreCase(xColumn)) xIdx = i;
						if (h.equalsIgnoreCase(yColumn)) yIdx = i;
					}
					if (xIdx < 0 || yIdx < 0) {
						throw new RuntimeException("Organ-size profile columns not found: " + xColumn + ", " + yColumn + " in " + path);
					}
					continue;
				}
				xIdx = 0;
				yIdx = 1;
			}
			if (xIdx >= parts.length || yIdx >= parts.length) continue;
			double x = Double.parseDouble(parts[xIdx].trim());
			double y = Double.parseDouble(parts[yIdx].trim());
			if (Double.isNaN(x) || Double.isInfinite(x)) continue;
			if (Double.isNaN(y) || Double.isInfinite(y)) continue;
			xList.add(Double.valueOf(x));
			yList.add(Double.valueOf(y));
		}
	} catch (IOException e) {
		throw new RuntimeException("Failed reading organ-size profile: " + path, e);
	} catch (NumberFormatException e) {
		throw new RuntimeException("Invalid numeric value in organ-size profile: " + path, e);
	} finally {
		if (br != null) {
			try { br.close(); } catch (IOException ioe) { }
		}
	}
	if (xList.size() <= 0) {
		throw new RuntimeException("Organ-size profile contains no usable rows: " + path);
	}
	int n = xList.size();
	double[] xs = new double[n];
	double[] ys = new double[n];
	int i;
	for (i = 0; i < n; i++) {
		xs[i] = ((Double) xList.get(i)).doubleValue();
		ys[i] = ((Double) yList.get(i)).doubleValue();
	}
	return new double[][] { xs, ys };
}

public static double[][] loadOptionalProfile(String path, String xColumn, String yColumn) {
	try {
		return loadProfile(path, xColumn, yColumn);
	} catch (RuntimeException e) {
		String msg = e.getMessage();
		if (msg != null &&
			(msg.indexOf("columns not found") >= 0 ||
			 msg.indexOf("Invalid numeric value") >= 0 ||
			 msg.indexOf("contains no usable rows") >= 0)) {
			if (printFlag) {
				println("[organ-size] optional profile missing for " + yColumn + " in " + path + "; using in-module fallback.");
			}
			return null;
		}
		throw e;
	}
}


/**
 * Loads the model input data from configuration files.
 * This function orchestrates the loading of the global parameter file
 * followed by plant parameters from their respective configuration files.
 *
 * The sequence of events is as follows:
 * 1. Attempts to load the main property file that contains model settings.
 * 2. If there is an error during the loading of the property file, a message is printed.
 * 3. Load plant parameters after the success of the property file loading
 * 4. Load plant phenology parameters after the success of the property file loading
 *
 * @return A boolean indicating whether an error occurred during the loading process.
 */
 

/**
 * SimulationLoader handles the structured loading of model configuration,
 * parameters, and derived values. This class is intended to be invoked
 * after deserialization (e.g., from a `.gsz` file) to ensure state restoration.
 */
public class SimulationLoader implements Serializable, RunAfterLoad {

	private static final long serialVersionUID = 1L;
	
	/**
	 * Invoked automatically after GroIMP deserializes this class.
	 * Useful when restoring simulations from `.gsz` files.
	 * Those are okay only if they are pure Java (file I/O, parsing, setting flags). 
	 * They must not:
	 * touch the graph,
	 * rely on producers,
	 * or construct scene nodes.
	 * Be aware of that halt is filtering the climate file. 
	 * so the maximum number of steps (including the previous steps at the resume) should smaller than 24*halt-1 
	 */
	@Override
	public void load(RegistryContext ctx) {
		//command line load from the headless mode, for keeping the state variables, we need
		//to set reset to false. However, we can still reload the parameters and file names	
		if("false".equalsIgnoreCase(ModelArgs.reset)) {
			//Object f = getFileFromProject("globalParameters.rgg");
			// Clear all data stored in Config Module
			CONFIG.reset();
			initSimulationInstance();  // Re-run the simulation input loaders
			//need to update the climate data if you want to run a different time period
			readCsvFiles();
		  if (printFlag) {
			println("🔁 Reloading simulation configuration after file reload...");
		}
		}
	}
	/**
	 * Executes the simulation initialization sequence.
	 * 
	 * @return true if any error occurred during loading; false otherwise.
	 */
	public static boolean initSimulationInstance() {
		boolean error = false;

		// Step 1: Load main property file
		error = error || loadPropertyFile();
		if (!error) {
			readOptimalCanopyArchitectureFile();
		}

		if (error && printFlag) {
			println("Error during reading of parameter file(s)!");
		}

		// Step 2: Load model inputs only if properties loaded successfully
		if (!error && !isStringNull(FILE_NAME_PLANT_PARAMETERS)) {
			loadInitialConditions(FILE_NAME_INITIAL_CONDITIONS);
			loadPlantParameters(FILE_NAME_PLANT_PARAMETERS);
			loadSoilParameters(FILE_NAME_SOIL_PARAMETERS);

			if (usePhenology) {
				loadPhenologyParameters(FILE_NAME_PHENOLOGY_PARAMETERS);
			}

			// Step 3: Final calculations after input is loaded
			calcValuesFromInput();
		}

		return error;
	}


}


/**
 * Loads the main property file which includes the model settings.
 * It utilizes the ConfigLoader utility class to read configurations
 * and apply them to the simulation environment.
 *
 * @return A boolean indicating if the loading process encountered an error.
 */
private static boolean loadPropertyFile() {
	ConfigLoader loader = new ConfigLoader(new LoadModelInputCommand());

	String file_path = PATH_SCENARIOS + FILE_NAME_MODEL_OPTIONS;
	return loader.load(FILE_NAME_MODEL_OPTIONS, file_path);
}

/**
 * Inner class implementing a command pattern for loading model input properties.
 * This command is passed to the ConfigLoader which then invokes the execute method
 * to perform the actual loading of properties.
 */
private class LoadModelInputCommand implements LoadCommand {
	/**
	 * Executes the loading of model input properties from a given file name.
	 * It is called by the ConfigLoader when the load method is invoked.
	 *
	 * @param file_name The name of the file from which properties will be loaded.
	 */
	public void execute(String file_name) {
		loadProperties(file_name);

	}
}

private class LoadOptimalCanopyArchitectureCommand implements LoadCommand {
	public void execute(String file_name) {
		loadOptimalCanopyArchitectureProperties(file_name);
	}
}

public static void readOptimalCanopyArchitectureFile() {
	if (!useOptimalCanopyArchitectureFile) {
		return;
	}

	ConfigLoader loader = new ConfigLoader(new LoadOptimalCanopyArchitectureCommand());
	String file_path = PATH_SCENARIOS + FILE_NAME_OPTIMAL_CANOPY_ARCHITECTURE;
	boolean error = loader.load(FILE_NAME_OPTIMAL_CANOPY_ARCHITECTURE, file_path);
	if (error && printFlag) {
		println("[Config] WARN: failed to load optimal canopy architecture file: " +
				FILE_NAME_OPTIMAL_CANOPY_ARCHITECTURE);
	}
}

private static void loadOptimalCanopyArchitectureProperties(String file_name) {
	CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(file_name,
			DocumentCategoryNameGroup.class)).getCategoryStore();

	config.setCategoryContext("optimal_canopy_architecture");
	try {
		optimalCanopyLayoutMode = config.getString("layoutMode", optimalCanopyLayoutMode);
	} catch (RuntimeException e) {
		optimalCanopyLayoutMode = "layer_row_grid";
	}
	try {
		optimalCanopyDeriveNrRowsFromLayers =
				config.getBoolean("deriveNrRowsFromLayers", optimalCanopyDeriveNrRowsFromLayers);
	} catch (RuntimeException e) {
		optimalCanopyDeriveNrRowsFromLayers = true;
	}
	try {
		optimalCanopyLayerCount = config.getInteger("layerCount", optimalCanopyLayerCount);
	} catch (RuntimeException e) {
		optimalCanopyLayerCount = 1;
	}
	try {
		optimalCanopyRowsPerLayer = config.getInteger("rowsPerLayer", optimalCanopyRowsPerLayer);
	} catch (RuntimeException e) {
		optimalCanopyRowsPerLayer = 1;
	}
	try {
		optimalCanopyRowYSpacingMode = config.getString("rowYSpacingMode", optimalCanopyRowYSpacingMode);
	} catch (RuntimeException e) {
		optimalCanopyRowYSpacingMode = "use_rowDistance";
	}
	try {
		optimalCanopyLayerHeightMode = config.getString("layerHeightMode", optimalCanopyLayerHeightMode);
	} catch (RuntimeException e) {
		optimalCanopyLayerHeightMode = "wood_length_linear";
	}
	try {
		optimalCanopyWoodLengthBase = config.getDouble("woodLengthBase", optimalCanopyWoodLengthBase);
	} catch (RuntimeException e) {
		optimalCanopyWoodLengthBase = 0.95;
	}
	try {
		optimalCanopyWoodLengthStep = config.getDouble("woodLengthStep", optimalCanopyWoodLengthStep);
	} catch (RuntimeException e) {
		optimalCanopyWoodLengthStep = 0.95;
	}
	if ("wood_length_explicit".equals(optimalCanopyLayerHeightMode)) {
		try {
			Double[] woodLengthWrapper = safeGetDoubleArray(config, "woodLengthValues");
			if (woodLengthWrapper != null) {
				optimalCanopyWoodLengthValues = new double[woodLengthWrapper.length];
				for (int i = 0; i < woodLengthWrapper.length; i++) {
					if (woodLengthWrapper[i] != null) {
						optimalCanopyWoodLengthValues[i] = woodLengthWrapper[i].doubleValue();
					} else {
						optimalCanopyWoodLengthValues[i] = optimalCanopyWoodLengthBase;
					}
				}
			}
		} catch (RuntimeException e) {
			// Compatibility fallback: explicit heights are optional; linear mode remains authoritative.
			optimalCanopyWoodLengthValues = new double[0];
		}
	}
	try {
		optimalCanopyStripSpacingMode = config.getString("stripSpacingMode", optimalCanopyStripSpacingMode);
	} catch (RuntimeException e) {
		optimalCanopyStripSpacingMode = "derived_block_width";
	}
	try {
		optimalCanopyCloneSpacingMode = config.getString("cloneSpacingMode", optimalCanopyCloneSpacingMode);
	} catch (RuntimeException e) {
		optimalCanopyCloneSpacingMode = "derived_block_width";
	}
	try {
		optimalCanopyDensityCalculationMode =
				config.getString("densityCalculationMode", optimalCanopyDensityCalculationMode);
	} catch (RuntimeException e) {
		optimalCanopyDensityCalculationMode = "derived_block_width";
	}
	try {
		optimalCanopyStaggerAlternateRows =
				config.getBoolean("staggerAlternateRows", optimalCanopyStaggerAlternateRows);
	} catch (RuntimeException e) {
		optimalCanopyStaggerAlternateRows = false;
	}
	try {
		optimalCanopyAlternateRowXOffsetFraction =
				config.getDouble("alternateRowXOffsetFraction", optimalCanopyAlternateRowXOffsetFraction);
	} catch (RuntimeException e) {
		optimalCanopyAlternateRowXOffsetFraction = 0.5;
	}
	try {
		optimalCanopyLegacyMode = config.getString("legacyMode", optimalCanopyLegacyMode);
	} catch (RuntimeException e) {
		optimalCanopyLegacyMode = "none";
	}
	try {
		optimalCanopyUseLegacyScenarioPreset =
				config.getBoolean("useLegacyScenarioPreset", optimalCanopyUseLegacyScenarioPreset);
	} catch (RuntimeException e) {
		optimalCanopyUseLegacyScenarioPreset = false;
	}
	try {
		optimalCanopyWarnIfNrRowsMismatch =
				config.getBoolean("warnIfNrRowsMismatch", optimalCanopyWarnIfNrRowsMismatch);
	} catch (RuntimeException e) {
		optimalCanopyWarnIfNrRowsMismatch = true;
	}
	try {
		optimalCanopyPrintEffectiveConfig =
				config.getBoolean("printEffectiveArchitectureConfig", optimalCanopyPrintEffectiveConfig);
	} catch (RuntimeException e) {
		optimalCanopyPrintEffectiveConfig = true;
	}
}

	
static double calcTrunkBiomass(int calcMethod) 
{
	//CARBON
	if(calcMethod == 0) return(BIOMASS_WOOD); //direct input
	//proportional increase based on the relationship between shoot and wood in cuttings
	if(calcMethod == 1) return(BIOMASS_WOOD * CORDEN_NUM * SHOOT_NUM); 
	//the density was in unit of mg/cm3, so need to times 1e6
	if(calcMethod == 2) 
		if (printFlag && !("ArchReader".equals(initiation_method) || "ArchReaderGPU".equals(initiation_method)))
			{
				println(" WOOD_DIAMETER " + WOOD_DIAMETER +" WOOD_LENGTH " + WOOD_LENGTH ); 
			}
		return(Math.PI * (WOOD_DIAMETER*WOOD_DIAMETER/4) * WOOD_LENGTH * WOOD_DENSITY*1e6);  
}


static double calcCordonBiomass(int calcMethod)
{
	return Math.max(0.0, sum((* g:Cordon, (g.plantNumber == 1) *).biomass));
}

static double calcPerennialWoodBiomass(int calcMethod)
{
	// Trunk/Cordon sums are intended to reflect live structure biomass. Trunk segment
	// initialization in shoot.rgg now avoids assigning whole-trunk totals to every
	// reconstructed segment, so summing Trunk.biomass is safe for structure-based woodRef.
	double biomassTrunk = sum((* g:Trunk, (g.plantNumber == 1) *).biomass);
	double biomassPerennialWood = biomassTrunk + calcCordonBiomass(calcMethod);
	return Math.max(0.0, biomassPerennialWood);
}

static double calcAbovegroundPerennialStructureBiomass(int calcMethod)
{
	double biomassPerennialWood = calcPerennialWoodBiomass(calcMethod);
	if (printFlag && biomassPerennialWood < 100) {
		println(" WARN: low BIOMASS_WOOD(ref):" + biomassPerennialWood);
	}
	return Math.max(0.0, biomassPerennialWood);
}

static double calcAbovegroundPerennialStructureBiomassFromStructure()
{
	// Kept as a separate alias for call-site clarity (sync path vs config/startup path).
	// Current implementation uses the same typed XL sums as calcAbovegroundPerennialStructureBiomass(...).
	return calcAbovegroundPerennialStructureBiomass(woodBiomassCalcMethod);
}

static String normalizeTwinningGridBoundsMode(String rawMode)
{
	if (rawMode == null) return "PREDEFINED";

	String m = rawMode.trim();
	if (m.length() == 0) return "PREDEFINED";
	m = m.toUpperCase();

	if ("PREDEFINED".equals(m) || "AUTO_FIT".equals(m)) return m;

	if ("AUTOFIT".equals(m) || "AUTO-FIT".equals(m) || "AUTO".equals(m)) {
		return "AUTO_FIT";
	}
	if ("PRESET".equals(m) || "FIXED".equals(m) || "MANUAL".equals(m)) {
		return "PREDEFINED";
	}

	if (printFlag) {
		println(" WARN: invalid twinningGrids.boundsMode '" + rawMode + "', using PREDEFINED");
	}
	return "PREDEFINED";
}

public static boolean twinningStageIncludesObject(int stage, String objectName)
{
	String s = "";
	if (stage == 1) {
		s = twinningObjects_T1;
	} else if (stage == 2) {
		s = twinningObjects_T2;
	}
	if (s == null || objectName == null) return false;
	s = "," + s.toLowerCase().replace(" ", "") + ",";
	String key = "," + objectName.toLowerCase() + ",";
	return s.indexOf(key) >= 0;
}

static String normalizeRootBiomassInitMode(String rawMode)
{
	if (rawMode == null) return "LEGACY_THRESHOLD_AUTO";

	String normalizedMode = rawMode.trim();
	if (normalizedMode.length() == 0) return "LEGACY_THRESHOLD_AUTO";
	normalizedMode = normalizedMode.toUpperCase();

	if ("LEGACY_THRESHOLD_AUTO".equals(normalizedMode) ||
		"EXPLICIT_TOTAL".equals(normalizedMode) ||
		"RATIO_TO_WOOD_REF".equals(normalizedMode)) {
		return normalizedMode;
	}

	// Compatibility aliases for hand-edited scenario files.
	if ("LEGACY".equals(normalizedMode) || "AUTO".equals(normalizedMode)) {
		return "LEGACY_THRESHOLD_AUTO";
	}
	if ("EXPLICIT".equals(normalizedMode) || "EXPLICIT_ROOT".equals(normalizedMode)) {
		return "EXPLICIT_TOTAL";
	}
	if ("RATIO".equals(normalizedMode) || "RATIO_TO_WOOD".equals(normalizedMode) ||
		"AUTO_FROM_RATIO".equals(normalizedMode)) {
		return "RATIO_TO_WOOD_REF";
	}

	if (printFlag) {
		println(" WARN: invalid rootBiomassInitMode '" + rawMode + "', using LEGACY_THRESHOLD_AUTO");
	}
	return "LEGACY_THRESHOLD_AUTO";
}

static String normalizeAnnualInternodeBiomassMode(String mode)
{
	if (mode == null) return "density";

	String m = mode.trim();
	if (m.length() == 0) return "density";

	if ("density".equalsIgnoreCase(m)) return "density";
	if ("leafAllometry".equalsIgnoreCase(m)) return "leafAllometry";

	// Compatibility aliases for hand-edited or legacy scenario files.
	if ("leafBiomassRatio".equalsIgnoreCase(m)) return "leafAllometry";
	if ("leafBiomass".equalsIgnoreCase(m)) return "leafAllometry";
	if ("leafRatio".equalsIgnoreCase(m)) return "leafAllometry";

	if (printFlag) {
		println("[Config] WARN: Unknown annualInternodeBiomassMode='" + mode
			+ "'. Falling back to 'density'.");
	}
	return "density";
}

static int normalizeRootRGRMode(int mode)
{
	if (mode == RGR_MODE_SEASONAL) return RGR_MODE_SEASONAL;
	if (mode == RGR_MODE_CONSTANT) return RGR_MODE_CONSTANT;

	if (printFlag) {
		println("[Config] WARN: invalid rootGrowthFunction/rootRGRMode=" + mode
			+ "; using RGR_MODE_SEASONAL.");
	}
	return RGR_MODE_SEASONAL;
}

static void applyRootBiomassInitializationFromWoodRef(double woodRef, String syncStage)
{
	if (woodRef <= 1e-9) return;

	BIOMASS_WOOD = woodRef;

	double rootInitThr = rootBiomassAutoInitThreshold;
	if (rootInitThr <= 0) rootInitThr = 10.0;

	double ratioFromDefault = defaultStrRootToWood;
	if (ratioFromDefault <= 0) ratioFromDefault = 0.35;

	String initMode = normalizeRootBiomassInitMode(rootBiomassInitMode);
	boolean syncLog = (syncStage != null) && (syncStage.length() > 0);

	int rootWoodRefModeNormalized = (rootWoodRefMode == 1) ? 1 : 0;
	if ((rootWoodRefMode != 0) && (rootWoodRefMode != 1) && printFlag) {
		println(" WARN: invalid rootWoodRefMode=" + rootWoodRefMode + ", using trunk mode (0)");
	}
	// The key name StrRootToTrunk is kept for backward compatibility, but in mode=1
	// it is interpreted as root:woodRef (not strictly root:trunk).
	boolean ratioUsesWoodRef = (rootWoodRefModeNormalized == 1);
	String ratioRefLabel = ratioUsesWoodRef ? "woodRef" : "trunk";
	String ratioUsedLabel = ratioUsesWoodRef ? "StrRootToWood(used)" : "StrRootToTrunk(used)";
	String ratioUpdatedLabel = ratioUsesWoodRef ? "StrRootToWood(updated)" : "StrRootToTrunk(updated)";
	String ratioUpdatedSyncLabel = ratioUsesWoodRef ? "StrRootToWood updated from structure" : "StrRootToTrunk updated from structure";

	if ("RATIO_TO_WOOD_REF".equals(initMode)) {
		double rootToRefRatio;
		if (ratioUsesWoodRef) {
			// mode=1: ratio is explicitly root:woodRef and comes from the dedicated option.
			rootToRefRatio = ratioFromDefault;
		} else {
			// mode=0: legacy ratio is root:trunk and is stored in StrRootToTrunk.
			rootToRefRatio = StrRootToTrunk;
			if (rootToRefRatio <= 0) rootToRefRatio = ratioFromDefault;
			StrRootToTrunk = rootToRefRatio;
		}
		BIOMASS_ROOT = BIOMASS_WOOD * rootToRefRatio;

		if (printFlag) {
			if (syncLog) {
				println(" [" + syncStage + "] BIOMASS_ROOT re-init from structure, woodRef=" + BIOMASS_WOOD +
						" ratio=" + rootToRefRatio + " ratioRef=" + ratioRefLabel +
						" BIOMASS_ROOT=" + BIOMASS_ROOT +
						" mode=" + rootWoodRefModeNormalized + " initMode=" + initMode);
			} else {
				println(" BIOMASS_WOOD(ref) " + BIOMASS_WOOD + " rootWoodRefMode=" + rootWoodRefModeNormalized +
						" rootBiomassInitMode=" + initMode);
				println(" " + ratioUsedLabel + " " + rootToRefRatio);
				println(" BIOMASS_ROOT(init) " + BIOMASS_ROOT);
			}
		}
		return;
	}

	if ("EXPLICIT_TOTAL".equals(initMode)) {
		if (BIOMASS_ROOT < 0) BIOMASS_ROOT = 0;
		if (BIOMASS_WOOD > 1e-9) {
			StrRootToTrunk = BIOMASS_ROOT / BIOMASS_WOOD;
		}

		if (printFlag) {
			if (syncLog) {
				println(" [" + syncStage + "] " + ratioUpdatedSyncLabel + ", woodRef=" + BIOMASS_WOOD +
						" BIOMASS_ROOT=" + BIOMASS_ROOT + " mode=" + rootWoodRefModeNormalized + " initMode=" + initMode);
			} else {
				println(" BIOMASS_WOOD(ref) " + BIOMASS_WOOD + " rootWoodRefMode=" + rootWoodRefModeNormalized +
						" rootBiomassInitMode=" + initMode);
				println(" BIOMASS_ROOT(given) " + BIOMASS_ROOT);
				println(" " + ratioUpdatedLabel + " " + StrRootToTrunk);
			}
		}
		return;
	}

	// Legacy compatibility path: threshold-based switch between explicit and ratio initialization.
	if (BIOMASS_ROOT < rootInitThr) {
		double rootToTrunkRatio = StrRootToTrunk;
		if (rootToTrunkRatio <= 0) rootToTrunkRatio = ratioFromDefault;
		double legacyWoodRef = BIOMASS_WOOD;
		// Historical compatibility: legacy threshold-auto ratio init used trunk biomass as the reference,
		// especially in grapevine scenarios where perennial-structure refs were introduced later.
		double legacyTrunkWoodRef = calcTrunkBiomass(woodBiomassCalcMethod);
		if (legacyTrunkWoodRef > 1e-9) {
			legacyWoodRef = legacyTrunkWoodRef;
		}
			BIOMASS_WOOD = legacyWoodRef;
			BIOMASS_ROOT = BIOMASS_WOOD * rootToTrunkRatio;
			if (printFlag) {
				if (syncLog) {
					println(" [" + syncStage + "] BIOMASS_ROOT re-init from structure, woodRef=" + BIOMASS_WOOD +
							" ratio=" + rootToTrunkRatio + " ratioRef=trunk(legacy)" +
							" BIOMASS_ROOT=" + BIOMASS_ROOT +
							" mode=" + rootWoodRefModeNormalized + " initMode=" + initMode);
				} else {
					println(" BIOMASS_WOOD(ref) " + BIOMASS_WOOD + " rootWoodRefMode=" + rootWoodRefModeNormalized +
							" rootBiomassInitMode=" + initMode);
					println(" StrRootToTrunk(used) " + rootToTrunkRatio);
					println(" BIOMASS_ROOT(init) " + BIOMASS_ROOT);
				}
			}
	} else {
		if (BIOMASS_WOOD > 1e-9) {
			StrRootToTrunk = BIOMASS_ROOT / BIOMASS_WOOD;
		}
		if (printFlag) {
			if (syncLog) {
				println(" [" + syncStage + "] " + ratioUpdatedSyncLabel + ", woodRef=" + BIOMASS_WOOD +
						" BIOMASS_ROOT=" + BIOMASS_ROOT + " mode=" + rootWoodRefModeNormalized + " initMode=" + initMode);
			} else {
				println(" BIOMASS_WOOD(ref) " + BIOMASS_WOOD + " rootWoodRefMode=" + rootWoodRefModeNormalized +
						" rootBiomassInitMode=" + initMode);
				println(" BIOMASS_ROOT(given) " + BIOMASS_ROOT);
				println(" " + ratioUpdatedLabel + " " + StrRootToTrunk);
			}
		}
	}
}

public static void syncRootBiomassAfterArchitectureRead(String syncStage)
{
	boolean allowStep1AfterUpdatesResync = "step1_after_updates".equals(syncStage);
	if (allowStep1AfterUpdatesResync) {
		if (rootBiomassPostStep1UpdateSyncDone) return;
	} else {
		if (rootBiomassPostArchSyncDone) return;
	}
	if (!("ArchReader".equals(initiation_method) || "ArchReaderGPU".equals(initiation_method))) return;

	double abovegroundPerennialStructureBiomassTotal = calcAbovegroundPerennialStructureBiomassFromStructure();
	if (printFlag) {
		println(" [" + syncStage + "] AbovegroundPerennialStructureBiomass(total) " + abovegroundPerennialStructureBiomassTotal);
	}

	double woodRef = rootWoodRefMode == 1 ?
					 abovegroundPerennialStructureBiomassTotal :
					 calcTrunkBiomass(woodBiomassCalcMethod);
	if (woodRef <= 1e-9) return;

	applyRootBiomassInitializationFromWoodRef(woodRef, syncStage);

	rootBiomassPostArchSyncDone = true;
	if (allowStep1AfterUpdatesResync) {
		rootBiomassPostStep1UpdateSyncDone = true;
	}
}

private static void recordLightInterceptionConfigurationError(String message) {
	if (message == null || message.trim().length() == 0) return;
	if (lightInterceptionConfigurationError == null || lightInterceptionConfigurationError.length() == 0) {
		lightInterceptionConfigurationError = message;
	} else {
		lightInterceptionConfigurationError = lightInterceptionConfigurationError + "; " + message;
	}
}

public static String resolveConfiguredLightInterceptionMode(
		String rawMode, Boolean legacyMode, boolean hasMode, boolean hasLegacy) {
	if (hasMode) return normalizeLightInterceptionMode(rawMode);
	if (hasLegacy && legacyMode != null) return legacyMode.booleanValue() ? "gpu" : "cpu";
	return "cpu";
}

private static void loadLightInterceptionOptions(CategoryStore config) {
	lightInterceptionConfigurationError = null;
	lightInterceptionModeExplicit = false;
	lightInterceptionLegacyModeExplicit = false;
	lightInterceptionModeRequested = "cpu";
	lightInterceptionModeResolved = "cpu";
	lightInterceptionFallbackMode = null;
	lightInterceptionStrict = true;

	boolean hasMode = false;
	boolean hasLegacy = false;
	String rawMode = null;
	Boolean legacyMode = null;

	try {
		rawMode = config.getString("lightInterceptionMode");
		hasMode = true;
	} catch (KeyNotFoundException e) {
		// Expected for legacy model-options files.
	} catch (RuntimeException e) {
		hasMode = true;
		recordLightInterceptionConfigurationError("Could not read lightInterceptionMode: " + e.getMessage());
	}

	try {
		legacyMode = config.getBoolean("useFluxLightModel");
		hasLegacy = true;
	} catch (KeyNotFoundException e) {
		// Expected after migration to lightInterceptionMode.
	} catch (RuntimeException e) {
		hasLegacy = true;
		recordLightInterceptionConfigurationError("Deprecated useFluxLightModel must be boolean: " + e.getMessage());
	}

	String requested = "cpu";
	if (hasMode) {
		lightInterceptionModeExplicit = true;
		try {
			requested = resolveConfiguredLightInterceptionMode(rawMode, legacyMode, true, hasLegacy);
		} catch (RuntimeException e) {
			recordLightInterceptionConfigurationError(e.getMessage());
		}
		if (hasLegacy && legacyMode != null) {
			String legacyMapped = legacyMode.booleanValue() ? "gpu" : "cpu";
			if (!requested.equals(legacyMapped)) {
				println("Warning: lightInterceptionMode='" + requested
					+ "' overrides conflicting deprecated useFluxLightModel=" + legacyMode + ".");
			}
		}
	} else if (hasLegacy && legacyMode != null) {
		lightInterceptionLegacyModeExplicit = true;
		requested = resolveConfiguredLightInterceptionMode(null, legacyMode, false, true);
		if (!lightInterceptionLegacyWarningPrinted) {
			println("Warning: model option useFluxLightModel is deprecated; use lightInterceptionMode='"
				+ requested + "'.");
			lightInterceptionLegacyWarningPrinted = true;
		}
	}

	if (lightInterceptionValidationModeOverride != null) {
		try {
			requested = normalizeLightInterceptionMode(lightInterceptionValidationModeOverride);
			println("[Validation] lightInterceptionMode override: " + requested);
		} catch (RuntimeException e) {
			recordLightInterceptionConfigurationError("Invalid validation light-interception-mode: " + e.getMessage());
		}
	}

	lightInterceptionModeRequested = requested;
	lightInterceptionModeResolved = requested;

	try {
		lightInterceptionStrict = config.getBoolean("lightInterceptionStrict");
	} catch (KeyNotFoundException e) {
		lightInterceptionStrict = true;
	} catch (RuntimeException e) {
		recordLightInterceptionConfigurationError("lightInterceptionStrict must be boolean: " + e.getMessage());
	}
	try {
		String rawFallback = config.getString("lightInterceptionFallbackMode");
		if (rawFallback != null && rawFallback.trim().length() > 0) {
			lightInterceptionFallbackMode = normalizeLightInterceptionMode(rawFallback);
			if (lightInterceptionFallbackMode.equals(lightInterceptionModeRequested)) {
				recordLightInterceptionConfigurationError(
					"lightInterceptionFallbackMode must differ from lightInterceptionMode");
			}
		}
	} catch (KeyNotFoundException e) {
		lightInterceptionFallbackMode = null;
	} catch (RuntimeException e) {
		recordLightInterceptionConfigurationError("Invalid lightInterceptionFallbackMode: " + e.getMessage());
	}
}


/**
 * Normalize the public fruit-module selector at the configuration boundary.
 */
private static String normalizeFruitModule(String value) {
	if (value == null) {
		throw new IllegalArgumentException(
			"fruitModule must be one of: simpleFruit, complexBerry, virtualFruit");
	}
	String normalized = value.trim();
	if ("simpleFruit".equals(normalized)
		|| "complexBerry".equals(normalized)
		|| "virtualFruit".equals(normalized)) {
		return normalized;
	}
	throw new IllegalArgumentException("Unknown fruitModule '" + value
		+ "'. Accepted values: simpleFruit, complexBerry, virtualFruit");
}

/**
 * Resolve fruit selection once, including the narrow legacy-boolean fallback.
 *
 * The former factory explicitly gave useVirtualFruit precedence when both
 * legacy booleans were true. That documented behavior is retained with a
 * warning so old apple/virtual-fruit scenarios do not change silently.
 */
private static String resolveFruitModule(CategoryStore config) {
	String missing = "__FRUITCROPXL_FRUIT_MODULE_MISSING__";
	String rawModule = missing;
	String rawComplex = missing;
	String rawVirtual = missing;
	try {
		rawModule = config.getString("fruitModule");
	} catch (KeyNotFoundException e) {
		// New selector is optional only for the localized legacy fallback.
	} catch (RuntimeException e) {
		throw new IllegalArgumentException(
			"Could not read fruitModule: " + e.getMessage());
	}
	try {
		rawComplex = config.getString("useComplexBerry");
	} catch (KeyNotFoundException e) {
		// Compatibility guard: optional legacy field is absent.
	} catch (RuntimeException e) {
		throw new IllegalArgumentException(
			"Could not read legacy useComplexBerry: " + e.getMessage());
	}
	try {
		rawVirtual = config.getString("useVirtualFruit");
	} catch (KeyNotFoundException e) {
		// Compatibility guard: optional legacy field is absent.
	} catch (RuntimeException e) {
		throw new IllegalArgumentException(
			"Could not read legacy useVirtualFruit: " + e.getMessage());
	}

	boolean hasModule = rawModule != null && !missing.equals(rawModule);
	boolean hasComplex = rawComplex != null && !missing.equals(rawComplex);
	boolean hasVirtual = rawVirtual != null && !missing.equals(rawVirtual);

	// These defaults preserve the previous loader defaults when legacy keys are partial or absent.
	boolean legacyComplex = true;
	boolean legacyVirtual = true;
	if (hasComplex) {
		try {
			legacyComplex = config.getBoolean("useComplexBerry");
		} catch (RuntimeException e) {
			throw new IllegalArgumentException(
				"Legacy useComplexBerry must be boolean: " + e.getMessage());
		}
	}
	if (hasVirtual) {
		try {
			legacyVirtual = config.getBoolean("useVirtualFruit");
		} catch (RuntimeException e) {
			throw new IllegalArgumentException(
				"Legacy useVirtualFruit must be boolean: " + e.getMessage());
		}
	}

	String legacyModule;
	if (legacyVirtual) {
		legacyModule = "virtualFruit";
		if (legacyComplex && hasComplex && hasVirtual) {
			println("[Config] WARN: legacy useComplexBerry=true and useVirtualFruit=true"
				+ " resolves to virtualFruit using the former documented virtual precedence."
				+ " Migrate to fruitModule=\"virtualFruit\".");
		}
	} else if (legacyComplex) {
		legacyModule = "complexBerry";
	} else {
		legacyModule = "simpleFruit";
	}

	if (hasModule) {
		String selected = normalizeFruitModule(rawModule);
		if ((hasComplex || hasVirtual) && !selected.equals(legacyModule)) {
			throw new IllegalArgumentException("fruitModule=\"" + selected
				+ "\" conflicts with supplied legacy fruit switches, which resolve to \""
				+ legacyModule + "\". Remove the legacy keys or make them consistent.");
		}
		return selected;
	}

	if (!hasComplex && !hasVirtual) {
		println("[Config] WARN: fruitModule is absent; preserving the former default virtualFruit."
			+ " Add fruitModule explicitly.");
	} else {
		println("[Config] WARN: translating legacy fruit switches to fruitModule=\""
			+ legacyModule + "\". Migrate this scenario to fruitModule.");
	}
	return legacyModule;
}

private static void loadProperties(String file_name) {

	CategoryStore config = ((DocumentCategoryNameGroup) CONFIG.getGroup(file_name, 
			DocumentCategoryNameGroup.class)).getCategoryStore();

	// file configuration
	config.setCategoryContext("module_configuration");

	species = config.getString("species", "apple");
	leafShapeSpecies = null;
	try {
		leafShapeSpecies = config.getString("leafShapeSpecies", leafShapeSpecies);
	} catch (Exception e) {
		// Compatibility fallback: legacy scenarios use the physiological species for leaf geometry.
		leafShapeSpecies = null;
	}
	if (species.equals("apple")) {
		FRACTION_SORBITOL = 0.75;
	} else {FRACTION_SORBITOL = 0;}
	
	initiation_method = config.getString("initiation_method", "ArchReader");
	if ("fieldRandomCanopy".equals(initiation_method)
			&& (leafShapeSpecies == null || leafShapeSpecies.length() == 0)) {
		leafShapeSpecies = "kiwifruit";
	}
	special_scenario = config.getString("special_scenario", special_scenario); // Use initial value at declaration as default.	
	FILE_NAME_INITIAL_CONDITIONS = config.getString("FILE_NAME_INITIAL_CONDITIONS", "initial.conditions.default.json");	
	FILE_NAME_PLANT_PARAMETERS = config.getString("FILE_NAME_PLANT_PARAMETERS",  "plant.parameters.FJ.json");
	FILE_NAME_SOIL_PARAMETERS = config.getString("FILE_NAME_SOIL_PARAMETERS", "soil-parameters-clayloam-4.json");
	
	useComplexRoot = config.getBoolean("useComplexRoot", false);
	useComplexLeaf = config.getBoolean("useComplexLeaf", false);
	fruitModule = resolveFruitModule(config);
	try {
		String rootBiomassInitModeCandidate = config.getString("rootBiomassInitMode", "__CODEX_ROOT_BIOMASS_INIT_MODE_MISSING__");
		if ((rootBiomassInitModeCandidate != null) &&
			!rootBiomassInitModeCandidate.equals("__CODEX_ROOT_BIOMASS_INIT_MODE_MISSING__")) {
			rootBiomassInitMode = rootBiomassInitModeCandidate;
			rootBiomassInitModeSetByModelOptions = true;
		} else {
			rootBiomassInitMode = "LEGACY_THRESHOLD_AUTO";
			rootBiomassInitModeSetByModelOptions = false;
		}
	} catch (Exception e) {
		rootBiomassInitMode = "LEGACY_THRESHOLD_AUTO";
		rootBiomassInitModeSetByModelOptions = false;
	}
	try {
		rootWoodRefMode = config.getInteger("rootWoodRefMode", rootWoodRefMode);
	} catch (Exception e) {
		rootWoodRefMode = 1;
	}
	try {
		defaultStrRootToWood = config.getDouble("defaultStrRootToWood", defaultStrRootToWood);
	} catch (Exception e) {
		defaultStrRootToWood = 0.35;
	}
	try {
		rootBiomassAutoInitThreshold = config.getDouble("rootBiomassAutoInitThreshold", rootBiomassAutoInitThreshold);
	} catch (Exception e) {
		rootBiomassAutoInitThreshold = 10.0;
	}
	rootBiomassPostArchSyncDone = false;
	rootBiomassPostStep1UpdateSyncDone = false;
	
	//boolean variables for controlling model functionalities	
	config.setCategoryContext("model_functionality");
	
	thermalUnit = config.getString("thermalUnit", "thermalDay");
	//for back compatibility with the old json files
	try {
			organGrowthMethod = config.getString("organGrowthMethod", "TempWaterCarbonLimited");
		} catch (Exception e) {
			organGrowthMethod = "TempWaterCarbonLimited";
		} 
	try {
		rootRGRMode = normalizeRootRGRMode(config.getInteger("rootGrowthFunction"));
	} catch (RuntimeException e) {
		try {
			// Compatibility alias for hand-edited or future scenario files.
			rootRGRMode = normalizeRootRGRMode(config.getInteger("rootRGRMode"));
		} catch (RuntimeException ignored) {
			// Compatibility fallback: legacy model options files omit the root RGR mode.
			rootRGRMode = rootRGRMode;
		}
	}
	if (printFlag) {
		println("[Config] rootRGRMode=" + rootRGRMode + " (1=seasonal, 2=constant)");
	}
	try {
		annualInternodeBiomassMode = normalizeAnnualInternodeBiomassMode(
				config.getString("annualInternodeBiomassMode"));
		} catch (RuntimeException e) {
			annualInternodeBiomassMode = "density";
		}
	try {
			calcNUptake = config.getBoolean("calcNUptake", true);
		} catch (Exception e) {
			calcNUptake = true;
		} 
	try {
			nitrogenMode = config.getBoolean("nitrogenMode", true);
		} catch (Exception e) {
			nitrogenMode = "fixed";
		} 
			
	
	
	calcLightInterception = config.getBoolean("calcLightInterception", true);
	calcPotential_PT = config.getBoolean("calcPotential_PT", true);
	calcActual_PT = config.getBoolean("calcActual_PT", true);
	calcCarbonAllocation = config.getBoolean("calcCarbonAllocation", true);
	
	//simple control for inputs
	inputEnvironmentCondition = config.getBoolean("inputEnvironmentCondition");
	inputVesselConditions = config.getBoolean("inputVesselConditions", false);
	inputSoilWaterPotential = config.getBoolean("inputSoilWaterPotential", true);
	
	//Choose the stomata response function to water potential
	stomataWaterResFunction = config.getInteger("stomataWaterResFunction", 1);
	
	//dynamic growth, yield estimation, Carbon transport
	useStaticArc = config.getBoolean("useStaticArc", true);
	usePhenology = config.getBoolean("usePhenology", false);
	useYieldEst = config.getBoolean("useYieldEst", false);
	useCTRAM = config.getBoolean("useCTRAM", false);
	useStructuralVariation = config.getBoolean("useStructuralVariation", false);

	//does not need to show in DHS console,
	

	
	//controlling the light model configuration
	useDirectRadiation = config.getBoolean("useDirectRadiation", true);
	useDiffuseRadiation = config.getBoolean("useDiffuseRadiation", true);
	useTurtleRadiation = config.getBoolean("useTurtleRadiation", false);
	loadLightInterceptionOptions(config);
	try {
		useShadingFactor= config.getBoolean("useShadingFactor", true);
		} catch (Exception e) {
			useShadingFactor = true;
		} 
	try {
		// Compatibility fallback: legacy model options files may not provide the PAR sensor toggle.
		useLightSensors = config.getBoolean("useLightSensors", false);
	} catch (RuntimeException e) {
		useLightSensors = false;
	}
	try {
		associatePlantsToTiles = config.getBoolean("associatePlantsToTiles");
	} catch (KeyNotFoundException e) {
		// Legacy behavior associates plants with soil tiles unless explicitly disabled.
		associatePlantsToTiles = true;
	} catch (RuntimeException e) {
		recordLightInterceptionConfigurationError(
			"associatePlantsToTiles must be boolean: " + e.getMessage());
	}
	
	// demonstration/initiation toggles
