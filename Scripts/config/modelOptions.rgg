// ============================================================================
// Twinning Plans 
// ============================================================================
// see details at twinning planner, BudPlanner, LeafPlanner, FruitPlanner
// Twinning T1/T2 = “calibration” events → they can adjust both leaf and fruit.
// Leaf pruning / fruit pruning = separate management operations → each has its own DOY and can happen independently.
// If the target for a component is 0 or missing, we just skip that component at that stage.
// If leafAreaTargetPerTree_T1 <= 0 → no leaf twinning at T1.
// If leafAreaTargetPerTree_T2 <= 0 → no leaf twinning at T2.
// leafPruningDOY and fruitPruningDOY controls the separate pruning pass, not TwinningPlanner.
// ============================================================================

// ============================================================================
// Twinning planner options
global boolean useTwinningPlanner = false;
global String  twinningStage  = "AUTO";   // "T0", "T1", "T2", ...

/**
 * DOY at which Twinning Stage T0 (pre‑season, bud-level planning) is executed.
 * If <= 0, the T0 twinning step is NOT auto-triggered by the TwinningPlanner.
 */
global int twinningDOY_T0 = -1;

/**
 * DOY at which Twinning Stage T1 (in‑season apex/leaf tuning) is executed.
 * If <= 0, the T1 twinning step is NOT auto-triggered.
 */
global int twinningDOY_T1 = -1;

/**
 * DOY at which Twinning Stage T2 (late‑season / summer pruning & fruit thinning)
 * is executed. If <= 0, the T2 twinning step is NOT auto-triggered.
 */
global int twinningDOY_T2 = -1;

/** If true, Stage-A planner only prints the plan (no structural edits). */
global boolean dry_run = false;

/** If true, growing organs can bypass carbon limitation until T1 twinning completes. */
global boolean enablePotentialGrowthBeforeT1 = false;
/** Runtime latch for the pre-T1 potential-growth mode; reset false immediately after T1. */
global boolean preT1PotentialGrowthActive = false;
/** Comma-separated object mask for T1 twinning, e.g. "leaf,fruit". */
global String twinningObjects_T1 = "leaf";
/** Comma-separated object mask for T2 twinning, e.g. "leaf,fruit". */
global String twinningObjects_T2 = "leaf";

// Twinning grid geometry
/**
 * Twinning grid geometry for gridBased leaf/fruit/bud targets.
 * PREDEFINED uses xMin/xMax/zMin/zMax; AUTO_FIT fits to the current tree bounds.
 * Upright-region modes do not use this rectangular grid: they use
 * MgmtUprightOrder plus each upright's z/endZ span split into bottom/middle/top.
 */
global String twinningGridBoundsMode = "PREDEFINED";
global int    twinningNx   = 3;
global int    twinningNz   = 3;
global double twinningXMin = -1.5;
global double twinningXMax =  1.5;
global double twinningZMin =  0.0;
global double twinningZMax =  4.5;


// ============================================================================
// Bud Twinning
// ============================================================================
/**
 * budTargetMode:
 *
 * 0 – Density-based, remove-only
 *     - Use target budNumberPerMeter.
 *     - Only remove buds when density is above the target.
 *     - Prioritize removals in dense local zones, close-neighbor buds,
 *       and buds on non-terminal parent internodes.
 *     - Never add buds.
 *
 * 1 – Density-based local rebalance (fast)
 *     - Use target budNumberPerMeter.
 *     - Remove where local zones are too crowded.
 *     - Add where local zones are too loose.
 *     - Keep add-site eligibility spacing checks.
 *     - Skip expensive global per-bud spacing cleanup.
 *
 * 2 – Leaf-area & fruit driven (pre-prune, no density step)
 *     - Compute a target bud number from the leaf-area model (LA-driven).
 *     - When removing buds, protect buds that support existing RAW fruits
 *       (respect the RAW fruit floor).
 *     - Ensure at least the number of floral buds required to hit the fruit
 *       target.
 *     - No additional budNumberPerMeter density clean-up step.
 *
 * 3 – Density constraint first, then LA & fruit
 *     - Step 1: enforce budNumberPerMeter using remove-only (as in mode 0).
 *     - Step 2: apply the LA- and fruit-based logic (as in mode 2).
 *
 * 4 – Whole-tree bud target
 *     - Use a total bud target per tree.
 *     - Remove and/or add buds anywhere inside the management domain
 *       to reach the whole-tree target.
 *
 * 5 – Grid-based bud targets
 *     - Split the management domain into grid cells.
 *     - Each grid cell has its own bud target.
 *     - Remove and/or add buds within each cell to reach its local target.
 *     - Respect the RAW fruit floor when removing buds.
 *
 * 6 – Legacy density+spacing (slow)
 *     - Run the previous mode-1 full pipeline.
 *     - Includes expensive per-bud spacing cleanup and optional refill fallback.
 *
 * 8 – Upright 3-region density mode
 *     - Identify each upright using MgmtUprightOrder.
 *     - Split each upright into bottom/middle/top vertical regions.
 *     - Target buds per region = round(region length * budNumberPerMeter).
 *     - Remove excess buds within the region, preferring vegetative buds.
 *     - Add missing buds within the region, respecting placement and spacing guards.
 *     - Protect the RAW fruit floor when removing floral buds.
 */

global int budTargetMode = 0;  

/** Bud density target in buds per meter for density modes, including upright-region mode 8. */
global int budNumberPerMeter = 15;

/**
 * Core bud spacing control in meters.
 * Applied along the same axis for:
 * - mode 0/1 remove priority and add eligibility checks,
 * - mode 6 legacy spacing cleanup.
 *
 * If you want one spacing knob for both bud and spur operations, keep
 * `spurSpacingM` unset (or negative) and it will fall back to this value.
 */
global double minBudSpacingM = 0.10;

/**
 * Legacy mode-6 fallback switch.
 * 1 = when upright candidates are spacing-saturated, allow density refill on
 *     secondary axes.
 * 0 = keep refill attempts on the primary upright axis only.
 */
global int allowAddOnSecondaryAxes = 1;

/**
 * Spur pre-balancing switch for modes 0/1.
 * true  = run spur-bucket cap enforcement before density balancing.
 * false = skip spur-bucket pre-balancing.
 */
global boolean enableSpurBalancer = false;

/** Spur bucket root axis order (typically 4 for apple spur root internodes). */
global int spurOrder = 4;

/** Spur child axis order grouped with the same bucket (typically 5). */
global int spurChildOrder = 5;

/** Maximum buds retained per spur bucket (root + child orders). */
global int maxBudsPerSpur = 1;

/**
 * Spur removal priority inside a bucket.
 * true  = remove child-order buds first, then root-order buds.
 * false = remove root-order buds first.
 */
global boolean removeFromChildFirst = true;

/**
 * Spur-centric addition preference (mode 1).
 * true  = prefer empty spur candidates before generic zone-based candidates.
 * false = use generic zone-based candidate flow directly.
 */
global boolean addSpurUnitWhenAdding = true;

/**
 * Spur-root spacing in meters for spur-centric candidate selection.
 * If omitted in scenario JSON (or set negative), loader falls back to
 * `minBudSpacingM` to support a single spacing control.
 */
global double spurSpacingM = 0.10;

/** bud number per tree */
global int budNumberTargetPerTree = 456; 

/**
 * Optional grid of bud targets per tree for twinning / pruning.
 * 
 * Values are stored in row-major order (z rows × x columns) with length
 * nx * nz from the "twinningGrids" section. If null or length == 0, no
 * grid-based bud target is enforced and the model falls back to simpler
 * bud-number logic.
 */
global double[] budNumberTargetsGrid = null;
/**
 * Optional explicit upright-region bud targets for budPlanner targetMode 8.
 * Flattened order is upright-major with three vertical regions per upright:
 * U0_low, U0_mid, U0_upper, U1_low, ...
 *
 * Length should be number_of_detected_uprights * 3, where detected uprights
 * are order-root groups with vertical span greater than 2.0 m. Missing entries
 * are skipped; negative values mean "leave this upright-region unchanged".
 */
global double[] budNumberTargetsUprightRegion = null;

/**
 * Enable / disable apex potential tuning at T1.
 * 0 = disabled (skip apex tuning even if T1 DOY matches),
 * 1 = enabled (allow BudPlanner T1 apex adjustment to run).
 */
global boolean apexPotentialEnable_T1 = true;

/**
 * Baseline multiplicative scale for apex node / branch capacities at T1.
 * 1.0 = no change; >1.0 increases potential (longer shoots, more nodes);
 * <1.0 decreases potential (shorter shoots, fewer nodes).
 *
 * This is combined with any LA-based scale inside the T1 apex tuner.
 */
global double apexPotentialScale_T1 = 1.0;


/**
 * Maximum allowed relative deviation (fraction) between current expected
 * leaf area and the T1 target before we consider that the system is "too far"
 * and may need a reset / re-plan (e.g. change bud density & rerun).
 *
 * Example: 0.30 → 30% difference.
 * If <= 0, the deviation check is effectively disabled.
 */
global double apexPotentialMaxDeviation_T1 = 0.30;

// ============================================================================
// Addition controls for bud planning
// These fields are used by management/AddBudsByLeafArea.rgg.
// Quick usage:
//   - globalMgmtMainAxisOnly = 1 to restrict new buds to a specific order.
//   - globalMgmtPlacementOrder = 3 to place only on your order-3 uprights.
//   - globalMgmtUprightKeyMode = 0 (AUTO): axis3_ID → axis2_ID → order-root(order=globalMgmtUprightOrder).
//   - globalMgmtMaxNewBudsAllow: safety cap on how many buds can be added.
// ============================================================================

/** If 1, restrict bud placement to a specific axis order (see globalMgmtPlacementOrder). If 0, allow any order. */
global int  MgmtMainAxisOnly     = 1;    // {0,1}

/** Which order to place buds on when main-axis restriction is enabled. Typical add sites are order 4 on apple uprights. */
global int  MgmtPlacementOrder   = 4;    // ≥1 (e.g., 1=trunk/cane, 2=primary lateral, 3=upright, 4=internode)

/** Which order defines an upright root for BudPlanner, LeafPlanner, and FruitPlanner upright-region modes. */
global int  MgmtUprightOrder     = 3;    // ≥1; default 3 to match your current uprights

/** Safety cap on total number of new buds the management module is allowed to add at t=0. */
global int  MgmtMaxNewBudsAllow  = 100; // ≥0 (raise if your targets are large)

// warning thresholds
global double WARN_20 = 0.20;
global double WARN_30 = 0.30;

/**
 * Root biomass reference mode.
 * 0: legacy trunk-only reference.
 * 1: aboveground perennial structure reference (trunk + cordon + old wood proxy).
 */
global int rootWoodRefMode = 1;

/**
 * Default structural root:wood ratio (root:woodRef, unitless) used when BIOMASS_ROOT is auto-initialized.
 *Most likely for tall spindle (given TCA₈=19.2) palmer annual dry matter production:
 *  Age 7: ~15.5–17.5 cm²
 *   Age 5: ~11–13 cm²

 */
global double defaultStrRootToWood = 0.35;

/**
 * BIOMASS_ROOT auto-initialization threshold (mg).
 * If BIOMASS_ROOT < threshold, root biomass is initialized from wood reference and ratio.
 */
global double rootBiomassAutoInitThreshold = 10.0;

/**
 * True after one post-architecture synchronization of root biomass reference
 * under ArchReader / ArchReaderGPU initialization.
 */
global boolean rootBiomassPostArchSyncDone = false;
/** True after one forced resync at step 1 after updatesService.updates() (ArchReader path). */
global boolean rootBiomassPostStep1UpdateSyncDone = false;
/**decide whether or not resetting bud at step 1 
it will set to true if during twinning the 
difference in leaf area is bigger than 30% compared to the expecteLeafArea_preprune*/
global boolean resetBudNumber = false;



// ============================================================================
// Leaf twinning 
// ============================================================================
/**
 * Leaf target mode for the leaf planner.
 *
 * Typical values:
 *  "none"      = ignore leaf targets
 *  "wholeTree" = use whole-tree totals only
 *  "gridBased" = use grid-based targets (leafAreaTargetsGrid).
 *  "uprightRegions" = split each upright into bottom/middle/top regions
 *      and reconcile leaf area per region. Accepted aliases in LeafPlanner:
 *      "upright_region", "upright-region", "upright_regions",
 *      "upright-regions", and "upright3".
 *
 * Default "none" means no twinning-specific leaf control.
 */
global String leafTargetMode = "none";

/** Crop load in terms of number of fruits per plant. */
global double expectedLeafArea_prePrune = 27;  // m² planning objective

/**
 * Optional grid of leaf-area targets (m² per cell) at twinning. The array
 * is flattened in row-major order (z rows × x columns) and should have
 * length nx * nz from "twinningGrids".
 *
 * If null or length == 0, the model ignores grid-based leaf targets and
 * instead uses whole-tree values (if any).
 */
global double[] leafAreaTargetsGrid_T1 = null;
global double[] leafAreaTargetsGrid_T2 = null;
/**
 * Optional explicit upright-region leaf-area targets (m2 per upright-region).
 * Flattened order is upright-major with three vertical regions per upright:
 * U0_low, U0_mid, U0_upper, U1_low, ...
 *
 * Length should be number_of_detected_uprights * 3, where detected uprights
 * are order-root groups with vertical span greater than 2.0 m. Missing entries
 * are skipped; negative values mean "leave this upright-region unchanged".
 */
global double[] leafAreaTargetsUprightRegion_T1 = null;
global double[] leafAreaTargetsUprightRegion_T2 = null;

/**
 * Target total leaf area (m2 per tree) at twinning stages 1 and 2.
 * For wholeTree, this is the direct tree target. For uprightRegions, this is
 * distributed across all upright bottom/middle/top regions proportional to
 * region length. A negative value means no target specified.
 */
global double leafAreaTargetPerTree_T1 = -1.0;

global double leafAreaTargetPerTree_T2 = -1.0;



// ============================================================================
// Leaf prunning
/**
 * Executes T2 (post-twinning) leaf pruning based on project configuration.
 *
 * <p>T2 pruning is a physical pruning stage that removes canopy biomass to
 * meet post-pruning management targets. The procedure consists of two steps:
 *
 * <ol>
 *   <li><b>Structural pruning</b>: removal of entire vegetative shoots
 *       (including internodes and leaves) to achieve a coarse reduction
 *       in canopy size.</li>
 *   <li><b>Leaf-area-driven pruning</b>: proportional removal of remaining
 *       leaves to meet either a target leaf area or a fixed pruning fraction.</li>
 * </ol>
 *
 * <p>Pruning is applied only on the configured pruning DOY (if specified).
 * When {@code dryRun == true}, no structural changes are made and no pruning
 * statistics are recorded.
 *
 * <p>During real runs, removed leaf area, leaf biomass, and internode biomass
 * are tracked for mass-balance reporting.
 *
 * @param dryRun if {@code true}, evaluates pruning logic without modifying
 *               plant structure or recording pruning statistics
 */
// ============================================================================

/**
 * Day-of-year when the leaf prunning becomes active. A value of
 * -1 indicates that no specific DOY is set and the twinning leaf target
 * should be ignored.
 */
global int leafPruningDOY = 260;
//summerPruneFrac can be calculated by actual leaf area later
// the prunning method remove the vegetative shoots first and remove other leaf. 
//if everything set well, this can set to 0, else it will affect the vegetative shoot removal
// veg‑shoot only optional if you also set both LA targets
global double leafPruningFraction = 0;   //   
// (keep existing)
//can set a small number as guard but not affecting the vegetative shoot removal
global double desiredLeafArea_postPrune = 18;


// NEW: pruning strategy for T2
/**
pruneMode = 1 — Target Leaf Area Mode
Purpose: Achieve a specific post-pruning leaf area
Behaviour:
	After vegetative shoot removal, remaining leaf area is compared to
	pruneTargetLA; If leaf area exceeds the target, a proportional fraction of leaves
	is removed to reach the target

pruneMode = 0 — Fractional Pruning Mode

Purpose: Apply a fixed pruning intensity

Behaviour:
	A fixed fraction (pruneFraction) of remaining leaves is removed; No explicit leaf area target is enforced

pruneMode = 2 → vegetative shoot removal with LA target constraint	
*/

global int leafPruningMode = 2;  



/**
 * Fruit target mode for the fruit planner.
 *
 * Typical values:
 *  "none"      = no explicit fruit targets
 *  "wholeTree" = use whole-tree fruit-number targets
 *  "gridBased" = use fruitTargetsGrid for spatial crop-load control.
 *  "uprightRegions" = distribute fruit/flower targets over each upright's
 *      bottom/middle/top regions by region length. Accepted aliases in
 *      FruitPlanner: "upright_region", "upright-region", "upright_regions",
 *      "upright-regions", and "upright3".
 *
 * Default "none" keeps behaviour unchanged if the JSON block is omitted.
 */
global String fruitTargetMode = "none";

global int expectedFruitNumber_prePrune = 750; //bud number * 0.8 * 1.8 fruits planning objective (pre-thinning)

global int desiredFruitNumber_postPrune = 500; // Crop load goal, varies by plant type (e.g., FOPS apple ~400-500 or 2-cane grape ~45).

/**
 * Day-of-year when twinningFruitNumberTarget becomes active. A value of
 * -1 means "unused / not specified".
 */
global int fruitPruningDOY = -1;

// Mode for pruning:
//   1 = everywhere: max 1 organ/cluster
//   2 = height-based: below sepHeight → 1, above → 2
global int fruitPruningMode = 1;

/**
 * Target total fruit number per tree at the twinning stage (e.g. after
 * final thinning). A value of -1 indicates that no explicit twinning target
 * was specified. In uprightRegions mode, this tree target is distributed over
 * bottom/middle/top regions proportional to region length. In T2 gridBased
 * mode, the planner instead uses the rounded sum of fruitTargetsGrid_T2 as the
 * global floor/total target when that grid is available; fruitTargetPerTree_T2
 * then acts only as a compatibility fallback.
 */
global int fruitTargetPerTree_T1 = -1;
global int fruitTargetPerTree_T2 = -1;


/**
 * Optional grid of fruit-number targets per cell for spatial crop-load
 * management. The array is flattened in row-major order (z rows × x
 * columns) and should have length nx * nz.
 *
 * If null or length == 0, no grid-based fruit targeting is applied and the
 * model uses wholeTree or uprightRegions targets only if those modes are selected.
 */
global double[] fruitTargetsGrid_T1 = null;
global double[] fruitTargetsGrid_T2 = null;
/**
 * Optional explicit upright-region fruit-number targets (fruits per
 * upright-region). Flattened order is upright-major with three vertical
 * regions per upright: U0_low, U0_mid, U0_upper, U1_low, ...
 *
 * Length should be number_of_detected_uprights * 3, where detected uprights
 * are order-root groups with vertical span greater than 2.0 m. Missing entries
 * are skipped; negative values mean "leave this upright-region unchanged".
 */
global double[] fruitTargetsUprightRegion_T1 = null;
global double[] fruitTargetsUprightRegion_T2 = null;
// ---------------------------------------------------------------------------
// Fruit adding options (numeric initialization / gap-filling)
// ---------------------------------------------------------------------------
/**
 * FruitPlanner add-phase controls.
 *
 * Put these keys under category "fruitPlanner" in model options JSON, e.g.
 * "fruitPlanner": {
 *   "allowFruitAdding": true,
 *   "maxFruitAddsPerTree": 50,
 *   "maxFruitPerInternode": 2,
 *   "fruitAddMode": "toTarget",
 *   "fruitAddDebug": false,
 *   "allowAddOnOccupiedCordon": true,
 *   "maxFruitPerCordonPosition": 1,
 *   "maxFruitPerCordonPositionFallback": 2,
 *   "fruitInitFromNearbyTemplate": true
 * }
 *
 * Notes:
 * - Add runs in T1/T2 twinning via runTwinningStage(..., enableAdd=true).
 * - Prune flow can pre-fill once before remove-only pruning.
 * - maxFruitAddsPerTree is a hard cap per call.
 */
global boolean allowFruitAdding = true;               // master switch
global int     maxFruitAddsPerTree = 550;           // safety cap per tree
