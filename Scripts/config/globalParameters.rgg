/** Reflectance of PAR by leaves and stem. */
global double reflectancePAR = 0.06;
/** Transmittance of PAR by leaves. */
global double transmittancePAR = 0.07;
/** Reflectance of red light by leaves and stem. */
const double reflectanceRed = 0.04;
/** Transmittance of red light by leaves. */
const double transmittanceRed = 0.03;
/** Reflectance of far-red light by leaves and stem. */
const double reflectanceFarRed = 0.38;
/** Transmittance of far-red light by leaves and stem. */
const double transmittanceFarRed = 0.45;

/** Phong shader for light properties. */
const Phong LightShader = new Phong().(setDiffuse(new RGBColor(reflectancePAR, reflectanceRed, reflectanceFarRed)), 
                                      setDiffuseTransparency(new RGBColor(transmittancePAR, transmittanceRed, transmittanceFarRed)));

/** Phong shader for opaque light properties. */
const Phong LightOpaqueShader = new Phong().(setDiffuse(new RGBColor(reflectancePAR + transmittancePAR,
                                                               reflectanceRed + transmittanceRed,
                                                               reflectanceFarRed + transmittanceFarRed)), 
                                            setDiffuseTransparency(new Graytone(0)));

                                             
const Phong AdaxialShader = new Phong().(setDiffuse(new RGBColor(reflectancePAR, reflectanceRed, reflectanceFarRed)), 
                                      setDiffuseTransparency(new RGBColor(transmittancePAR, transmittanceRed, transmittanceFarRed)));


const Phong AbaxialShader = new Phong().(setDiffuse(new RGBColor(reflectancePAR * 1.2, reflectanceRed, reflectanceFarRed)), 
                                      setDiffuseTransparency(new RGBColor(transmittancePAR*1.2, transmittanceRed, transmittanceFarRed)));


const SideSwitchShader leafSideSwitchShader = new SideSwitchShader(AdaxialShader, AbaxialShader);


/**
 * Understory optical properties (diffuse reflectance / transmittance) used by GroIMP {@link Phong} shaders.
 *
 * <p><b>Band definitions in this model:</b></p>
 * <ul>
 *   <li><b>PAR</b>: 400–700 nm</li>
 *   <li><b>Red</b>: ~600–700 nm (proxy band for phytochrome-related R)</li>
 *   <li><b>Far-red</b>: ~700–800 nm (proxy band for phytochrome-related FR)</li>
 * </ul>
 *
 * <p><b>Literature basis for reflective films:</b> In orchards with traditional grass ground cover,
 * reflected PAR is typically ~5–10%, while reflective ground covers can increase reflected PAR
 * up to ~30–40% of incoming PAR.</p>
 *
 * <p><b>Reference:</b> Bastías, R.M. &amp; Corelli-Grappadelli, L. (2012).
 * <i>Light quality management in fruit orchards: physiological and technological aspects</i>.
 * Chilean Journal of Agricultural Research 72(4):574–581.
 * (See section “Light reflection management”, p. 578: grass 5–10% vs reflective covers 30–40% PAR.)</p>
 *
 * :contentReference[oaicite:0]{index=0}
 */

/* =========================
 * A) Typical NZ apple-orchard floor (grass/soil mix)
 * ========================= */
/**
 * Diffuse reflectance of PAR from a typical orchard floor (grassed alley / soil mix).
 *
 * <p>Default is set near measured grass-strip PAR reflection (~0.066) reported by Blanke (2008).
 * You may tune this upward (e.g., 0.07–0.10) if your floor is brighter (dry soil, short turf) or
 * downward if darker (wet soil, dense green cover).</p>
 *
 * @see Blanke (2008), PAR reflection for uncovered grass strips ~6.6%. :contentReference[oaicite:3]{index=3}

 */
global double floor_reflectancePAR = 0.066;

/**
 * Diffuse reflectance of red light (approx. 650 nm) from the orchard floor.
 *
 * <p>Red reflectance is typically lower than broadband PAR for green vegetation due to chlorophyll
 * absorption; soil can increase it. This is a pragmatic modelling default.</p>
 */
global double floor_reflectanceRed = 0.05;

/**
 * Diffuse reflectance of far-red light (approx. 730 nm) from the orchard floor.
 *
 * <p>Far-red reflectance is often higher than red for vegetation and many soils; this parameter mainly
 * affects R:FR composition of upward flux.</p>
 */
global double floor_reflectanceFarRed = 0.18;


global double floor_transmittancePAR    = 0.00;  // opaque
global double floor_transmittanceRed    = 0.00;
global double floor_transmittanceFarRed = 0.00;

const Phong OrchardFloorShader =
  new Phong().(
    setDiffuse(new RGBColor(floor_reflectancePAR, floor_reflectanceRed, floor_reflectanceFarRed)),
    setDiffuseTransparency(new RGBColor(floor_transmittancePAR, floor_transmittanceRed, floor_transmittanceFarRed))
  );


/* =========================
 * B) Extenday®-like reflective film (reflective groundcover)
 * ========================= */

/**
 * Diffuse reflectance of PAR from a reflective woven groundcover (Extenday™/Extenday® class).
 *
 * <p>Default is set near measured Extenday™ PAR reflection (~0.139) reported by Blanke (2008),
 * measured shortly after deployment (i.e., "fresh" condition). Field performance can vary with
 * soiling, ageing, moisture, and installation geometry.</p>
 *  orchard with traditional grass ground cover, the PAR reflected is almost 5-10%, while with reflective ground covers PAR
 	reflection incoming reached up to 30-40% (Widmer et al., 2001; Layne, 2001; Glenn and Puterka, 2007;
	Blanke, 2007; Figure 1).
 
 * Richard M. Bastías1, 2*, and Luca Corelli-Grappadell 2012, review
 * @see Extenday product concept and use as reflective groundcover. :contentReference[oaicite:5]{index=5}
 */
global double film_reflectancePAR     = 0.35;   // reflective covers often ~30–40% reflected PAR
global double film_reflectanceRed     = 0.25;
global double film_reflectanceFarRed  = 0.55;

global double film_transmittancePAR    = 0.00;  // assume opaque fabric
global double film_transmittanceRed    = 0.00;
global double film_transmittanceFarRed = 0.00;

const Phong ExtendayFilmShader =
  new Phong().(
    setDiffuse(new RGBColor(film_reflectancePAR, film_reflectanceRed, film_reflectanceFarRed)),
    setDiffuseTransparency(new RGBColor(film_transmittancePAR, film_transmittanceRed, film_transmittanceFarRed))
  );

/* =========================
 * C) Black ground (diagnostic: maximize apparent light penetration)
 * ========================= */
/**
 * Black ground shader used for light-penetration diagnostics.
 *
 * <p>Set reflectance/transmittance to ~0 so almost no upward reflected radiation is contributed
 * by the ground. This helps evaluate light reaching the floor without reflection feedback.</p>
 */
const Phong BlackGroundShader =
  new Phong().(
    setDiffuse(new RGBColor(0.0, 0.0, 0.0)),
    setDiffuseTransparency(new RGBColor(0.0, 0.0, 0.0))
  );

/**
 * Selected ground/understory shader.
 * Updated from model options (mean_climate.groundShaderMode) in modelOptions.rgg.
 * AUTO mode defaults to orchard floor shading.
 */
global Phong SelectedGroundShader = OrchardFloorShader;




