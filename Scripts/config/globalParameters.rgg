const float Ds = 1.60;
/** Gravitational acceleration (m/s^2). */
const float gacc = 9.81;
/** Specific water volume (cm3/mol). */
const float SpVw = 18;
/** Carbon fraction of sucrose. */
const float CARBON_FRACTION_SUCROSE = 0.4210526;
/** Carbon fraction of glucose. */
const float CARBON_FRACTION_GLUCOSE = 0.399556;
/** Carbon fraction of sorbitol. */
const float CARBON_FRACTION_SORBITOL = 0.3956;
/** Carbon fraction of dry matter in the fruit. */
const float CARBON_FRACTION_DM_Berry = 0.41;
/** Conversion factor to calculate maintenance cost using biomass. */
const float CONVERT_CH2O_TO_C = 12.0 / (12.0 + 2.0 + 16.0);
