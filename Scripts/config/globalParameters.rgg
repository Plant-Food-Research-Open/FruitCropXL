/** True for the dedicated leaf gas-exchange scenarios that share imposed light handling. */
public static boolean isLeafGasExchangeTestScenario() {
	return "photosynthesisTest".equals(special_scenario) || "singleLeaf".equals(special_scenario);
}

/**
 * True only when the whole-plant hydraulic solve is intentionally bypassed.
 * singleLeaf shares the light/test leaf path but retains its existing plant hydraulics.
 */
public static boolean isLeafHydraulicBypassTestScenario() {
	return isLeafGasExchangeTestScenario() && "photosynthesisTest".equals(special_scenario);
}
