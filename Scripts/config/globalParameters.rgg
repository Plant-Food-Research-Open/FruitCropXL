/**
 * Determines whether an XEG file should be output at a given simulation step.
 *
 * The first output is delayed by (outputXEG / 2) steps, and all subsequent outputs follow
 * at intervals of outputXEG steps, shifted by this initial delay.
 * output format is year-dayOfYear-hourOfDay
 * @param step       The current simulation step.
 * @param outputXEG  The interval at which XEG output occurs.
 * @return           {@code true} if an XEG file should be output at this step, {@code false} otherwise.
 */
static boolean shouldOutputXEG(int step, int outputFreq3DScene) {
    if (outputFreq3DScene <= 0) {
        return false; // No output if interval is zero or negative
    }

    int firstDelay = Math.max(1, outputFreq3DScene / 2); // Calculate first delay

    if (step == firstDelay) {
        return true; // First delayed output
    }

    return (step > firstDelay) && ((step - firstDelay) % outputFreq3DScene == 0);
}


