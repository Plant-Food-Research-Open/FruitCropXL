/**
 * Map<String, StepwiseCsvWriter>
 */
static HashMap csvWriters = new HashMap();

static void initCsvWriters(String outputTable_name) {
	// Init file paths
	plantLevelOutputFilePath = PATH_OUTPUT + "plant-level" + "-" + outputTable_name + ".csv";
	meanFruitOutputFilePath = PATH_OUTPUT + "mean-fruit"+ "-" + outputTable_name + ".csv";
	fieldLevelOutputFilePath = PATH_OUTPUT + "field-level"+ "-" + outputTable_name + ".csv";
	waterFluxSolverDebugOutputFilePath = PATH_OUTPUT + "waterFluxSolverDebug_" + outputTable_name + ".csv";

	plantLevelMetadataFilePath = PATH_OUTPUT + "plant-level.metadata.json";
	meanFruitMetadataFilePath = PATH_OUTPUT + "mean-fruit.metadata.json";
	fieldLevelMetadataFilePath = PATH_OUTPUT + "field-level.metadata.json";
	waterFluxSolverDebugMetadataFilePath = PATH_OUTPUT + "waterFluxSolverDebug.metadata.json";
	// Write metadata for data models
	ObjectMapper objectMapper = new ObjectMapper();

	(new SchemaMetadataWriter(plantLevelMetadataFilePath, PlantLevelOutputData.class, objectMapper)).writeMetadata();
	(new SchemaMetadataWriter(meanFruitMetadataFilePath, MeanFruitOutputData.class, objectMapper)).writeMetadata();
	(new SchemaMetadataWriter(fieldLevelMetadataFilePath, FieldLevelOutputData.class, objectMapper)).writeMetadata();

	// Instantiate data model CSV writers
	CsvMapper csvMapper = new CsvMapper();
	csvMapper.setVisibility(PropertyAccessor.ALL, Visibility.NONE);
	csvMapper.setVisibility(PropertyAccessor.FIELD, Visibility.DEFAULT);

	csvWriters.put(plantLevelOutputFilePath, new StepwiseCsvWriter(plantLevelOutputFilePath, csvMapper));
	csvWriters.put(meanFruitOutputFilePath, new StepwiseCsvWriter(meanFruitOutputFilePath, csvMapper));
	csvWriters.put(fieldLevelOutputFilePath, new StepwiseCsvWriter(fieldLevelOutputFilePath, csvMapper));
}
