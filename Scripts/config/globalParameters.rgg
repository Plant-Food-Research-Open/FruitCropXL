const float UNIT_CONVERSION_STOMATA = -0.1424 * Ta + 43.917;
/** Conversion factor for ABA from ng/mL to umol/m3. */
const float ngML_umolM3 = 3.783293;
/** Density of water (kg/m^3) at 4 degrees. */
const float DENSITY_OF_WATER = 1000.0;
/** Conversion factor from [W/m2] to Photosynthetic Photon Flux Density (PAR) [umolPPFD/(m2s)]. */
const float WATT_TO_PPFD = 4.55;
/** Wind speed measurement height. */
const float windSpeed_refHeight = 10;

/** Conversion factor to hydraulic conductivity from mm/h to m2/s/MPa */
const float SOILKs_HOURLY_TO_PLANTKs= 2.8344e-05; //m2/s/MPa;

/** Conversion factor to hydraulic conductivity from mm/day to m2/s/MPa */
const float SOILKs_DAILY_TO_PLANTKs = 1.181e-6; //m2/s/MPa;


 /**
 * Converts phloem carbon concentration to sugar concentration.
 * This function calculates sugar concentration based on the carbon concentration in the phloem.
 * The calculation is species-dependent, with specific formulas used for apples.
 * For apple species, the sugar concentration is derived from both sucrose and sorbitol carbon fractions.
 * For other species, the calculation uses only the sucrose carbon fraction.
 *
 * @param carbonConcentration_phloem The carbon concentration in the phloem (mg/L).
 * @return The sugar concentration derived from the carbon concentration.
 */

/**percetage of sorbitol in the sugar transport in phloem. 
   Apple is about 75% sorbitol, while grape is zero */
global float FRACTION_SORBITOL;


static float convertPhloemCtoSugar(float carbonConcentration_phloem) {
	float sugarConcentration = 0; // Initialize sugarConcentration to ensure all paths return a value
	if (species.equals("apple")) {
		FRACTION_SORBITOL = 0.75;
		sugarConcentration = (1 - FRACTION_SORBITOL) * carbonConcentration_phloem / CARBON_FRACTION_SUCROSE + 
							 FRACTION_SORBITOL * carbonConcentration_phloem / CARBON_FRACTION_SORBITOL;
	} else {
		FRACTION_SORBITOL = 0;
		sugarConcentration = carbonConcentration_phloem / CARBON_FRACTION_SUCROSE;
	}
	return sugarConcentration;
}


//Mol concentration in the input of virtual fruit model is 
//[mol sucre.dm-3 sève 0.05 - 0.53, divided by 1000 to convert into mol sucre.dm-3 sève which is used inside the model
static float convertSugarToMol(float sugarConcentration_phloem) {
	float MolConcentration = 0; // Initialize MolConcentration to ensure all paths return a value
	if (species.equals("apple")) {
		FRACTION_SORBITOL = 0.75;
		MolConcentration = 1000 * sugarConcentration_phloem/(FRACTION_SORBITOL*MOL_SORBITOL +  (1 - FRACTION_SORBITOL) * MOL_SURCROSE);
	} else {
		FRACTION_SORBITOL = 0;
		MolConcentration = 1000 * sugarConcentration_phloem / MOL_SURCROSE;
	}
	return MolConcentration;
}

static float calculateCarbonFraction() {
    float carbonFraction;
    if (species.equalsIgnoreCase("apple")) {
    	FRACTION_SORBITOL = 0.75;
        carbonFraction = (1 - FRACTION_SORBITOL) * CARBON_FRACTION_SUCROSE +
                          FRACTION_SORBITOL * CARBON_FRACTION_SORBITOL;
    } else {
        carbonFraction = CARBON_FRACTION_SUCROSE;
    }
    return carbonFraction;
}


/**
 * Convert phloem sugar concentration (g sugar cm^-3) to carbon concentration
 * used by the transport model (g C cm^-3), i.e. the inverse of
 * {@code convertPhloemCtoSugar(float)}.
 *
 * <p>Derivation:
 * For non-apple: sugar = c / CARBON_FRACTION_SUCROSE  =>  c = sugar * CARBON_FRACTION_SUCROSE.
 * For apple: sugar = c * [ (1 - f)/CARBON_FRACTION_SUCROSE + f/CARBON_FRACTION_SORBITOL ],
 * where f = FRACTION_SORBITOL, so
 * c = sugar / [ (1 - f)/CARBON_FRACTION_SUCROSE + f/CARBON_FRACTION_SORBITOL ].
 *
 * @param sugarConcentration sugar concentration in phloem (g sugar cm^-3)
 * @return carbon concentration in phloem (g C cm^-3)
 */
static float convertSugarToPhloemC(float sugarConcentration) {
    // clamp non-physical negatives defensively
    if (sugarConcentration < 0f) sugarConcentration = 0f;

    float carbonConcentration;
    if (species.equals("apple")) {
        float f = FRACTION_SORBITOL;
        float denom = (1f - f) / CARBON_FRACTION_SUCROSE
                    + f / CARBON_FRACTION_SORBITOL;
        // numerical guard
        if (denom <= 0f) denom = 1e-12f;
        carbonConcentration = sugarConcentration / denom;
    } else {
        carbonConcentration = sugarConcentration * CARBON_FRACTION_SUCROSE;
    }
    return carbonConcentration;
}


