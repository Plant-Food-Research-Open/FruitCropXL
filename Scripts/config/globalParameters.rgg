/**
 * Main path and folder structure for the model folder.
 * The MAINPATH is stored and read from the prop file in the GroIMP installing folder.
 * One can add different paths for different models.
 */
global String MAINPATH = Library.getWD() + "/../";
global String PATH_INPUT = MAINPATH + "Model_input/";
global String PATH_SCENARIOS = MAINPATH + "Model_scenarios/";
global String PATH_OUTPUT = MAINPATH + "Model_output/";

/**
 * PATH INITIATION.
 * Path properties are stored in the GroIMP installing folder.
 * If not set previously, you can set it in the following pathInit method.
 * Just change the path in the writeProp.setProperty.
 */
global String propFile = "config.properties.txt";
global Properties readProp = new Properties();

/**
 * Initializes path variables, including MAINPATH, PATH_INPUT, PATH_SCENARIOS,
 * PATH_SNAPSHOT, PATH_OUTPUT, and propFile. 
 * The paths are stored in the GroIMP installation folder.
 * You can set the paths in this method by changing the values in writeProp.setProperty.
 */
protected static void pathInit() {
	println(System.getProperty("user.dir")); // Relative to GroIMP installation
	// Create new properties file in GroIMP directory     
	Properties writeProp = new Properties();
	OutputStream output = new FileOutputStream(propFile);
	writeProp.setProperty("fruitCropModel.dir", "/var/model/");
	writeProp.store(output, null);	 
}  

/**
 * Updates the MAINPATH variable based on the current working directory (CWD).
 * It extracts the parent directory of the CWD (normally is the script folder) and sets it as the new MAINPATH.
 * Note: Replace 'getWD()' with the actual method to retrieve the current working directory.
 */
static void updateMainPath() {
    String currentPath = getWD();  // Replace this with your actual getWD() method
   // println("current path: " + currentPath);

    char lastChar = currentPath.charAt(currentPath.length() - 1);

    if (lastChar == '/' || lastChar == '\\') {
        currentPath = currentPath.substring(0, currentPath.length() - 1); // Remove the trailing slash if present
    }

    int lastSlashIndex = Math.max(currentPath.lastIndexOf('/'), currentPath.lastIndexOf('\\'));

    if (lastSlashIndex != -1) {
        MAINPATH = currentPath.substring(0, lastSlashIndex + 1);  // +1 to include the slash
    } else {
        // Handle the case where a last slash doesn't exist
        MAINPATH = currentPath;
    }
    
   // println("MAINPATH path: " + MAINPATH + " lastSlashIndex: " + lastSlashIndex);
}

/**
 * Initializes the path variables for the model based on configuration files.
 * Reads the 'config.properties.txt' file to retrieve path information or initializes it if not found.
 */
static void initPath() {
 	boolean isPropertyFile = false;
	File f = new File(System.getProperty("user.dir") + "/" + propFile);
	isPropertyFile = f.isFile(); 
	println("System usr.dir path: " + System.getProperty("user.dir"));
	//println(System.getProperty("user.dir") + "/" + propFile); //works in init() in main
	//If f does not exist initially—as in your scenario where the file represented 
	//by the File object has not been created or does not exist at the 
	//specified path—the method f.isFile() will return false.
	if(!f.isFile()) 
	{ 
		println("initiating path");
		pathInit(); 
	} //only need to run once if the path property not been set before
	
	readProp.load(new FileInputStream(f));
	MAINPATH = readProp.getProperty("fruitCropModel.dir"); 
    
	// Check if MAINPATH is not "/var/model/"
    if (!MAINPATH.equals("/var/model/") && !isPropertyFile) {
      updateMainPath();
    }
	println("Model MAINPATH is "  + MAINPATH);
	
	assignPath();
}   

/** assign the path after getting the main path*/
static void assignPath() {
	PATH_INPUT = MAINPATH + "Model_input/";
	PATH_SCENARIOS = MAINPATH + "Model_scenarios/";
	PATH_OUTPUT = MAINPATH + "Model_output/";
	
	
}
