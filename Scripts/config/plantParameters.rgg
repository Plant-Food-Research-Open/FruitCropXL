/** Reserve-storage KM is resolved per organ from absolute KM_RES_EARLY / KM_RES_LATE values. */
/**
Day after winter solstice when maximal rate of increase in KM reserve occurs (typically ~160 around flowering time or mid of the season when carbohydrate reserves start to refill)
*/
global float km_res_tm = 160;
/**
* Day after winter solstice when KM res reaches maximum, typically when fruit matures and close to the end of the growing season
*/
global float km_res_te = 300;
