/**peak growth time for secondary growth, normally around April for northern, and October for southern hemersphere */
global float SEC_gauss_center; 
/**the width of the Gaussian (e.g., 35 days) controls the duration of active secondary growth,  usually spanning **March to June**. */
global float SEC_gauss_width;

/**
 * Post-harvest bump amplitude for secondary growth (dimensionless).
 *
 * <p>Scales the late-season increase in cambial activity once fruit demand is
 * removed and carbon becomes more available. Used as a multiplier:
 * {@code if (phGate > 0.0) dawsEffect = Math.max(dawsEffect, SEC_BUMP);} </p>
 *
 * <p><b>Biology.</b> After harvest, if leaves remain active and temperatures
 * are permissive, carbon allocation to perennial tissues (reserve refill and
 * wood) often increases, producing a modest second hump in radial growth.</p>
 *
 * <p><b>Units:</b> – (adds to 1 as a fraction).<br>
 * <b>Typical range:</b> 0.20–0.50 (0 disables the bump).<br>
 * <b>Default:</b> 0.35 → peak*0.35 additional capacity when {@code phGate=1}.</p>
 *
 * <p><b>Use with gates.</b> Apply with a post-harvest gate and, ideally, a
 * leaf/senescence and temperature gate; optionally scale by a carbon-surplus
 * logistic to avoid boosting on carbon-limited days.</p>
 *
 * <p><b>References (post-veraison/late-season allocation & cambium control):</b>
 * Keller, <i>The Science of Grapevines</i>; Netzer et&nbsp;al. (2019);
 * García-Forner et&nbsp;al. (2019); Deslauriers et&nbsp;al. (2008).</p>
 *
 * @see #secondaryGrowthRate()
 */


// Seasonal effect from Gaussian growth curve (normalized + baseline)
global double SEC_BASE = 0.08;  // floor: 0.05–0.20 typical
//postharvest bump, as a percentag of the peak
global double SEC_BUMP = 0.2;      //For grape/apple cambium, a realistic post-harvest window is usually 20–40% of peak while leaves are still active.  0.20–0.35 typical
		

/** Passive reserve synthesis. */
/** Leakage rate; initially set to 0 but can be up to 2e-3 mgC/mgDM/h based on specific conditions. */
global float Kleakage = 0;

/** Minimum non-structural carbohydrate (NSC) as a percentage of total carbon, based on Greven 2016 and Hoch. */
global float MINIMUM_NSC = 5e-2;

/** Source loading function depends on the phloem carbon concentration. */
/** Reflects the steepness of the curve that loading decreases with carbon potential. */
global float sourceLoading_b = 35;

/** Loading threshold, reflects the observed mean phloem carbon concentration; calculated as c^2/2 for c = 0.098 (Jensen et al., 2013), with sucrose concentration 0.235 Wt/Wt% and C is 0.42 in sucrose. */
global float sourceLoading_cp = 2.0e-1;


