public class InitiationServiceFactory implements Serializable {
	public static InitiationService getService(String initiation_method) {

		if ("ArchReader".equals(initiation_method)) 
		{
			return new InitiationArchReader();
		}
		else if ("ArchReaderGPU".equals(initiation_method)) {
			return new InitiationArchReaderGPU();
		} 
		else if ("virtualFruit".equals(initiation_method)) 
		{
			return new InitiationVirtualFruit();
		}
		else if ("structuralVariation".equals(initiation_method)) {
			return new InitiationStructuralVariation();	
		}
		else if ("singleRoot".equals(initiation_method)) {
			return new InitiationSingleRoot();	
		}
		else if ("singleLeaf".equals(initiation_method)) {
			return new InitiationSingleLeaf();	
		}
		else if ("optimal_canopy_architecture".equals(initiation_method)) {
			return new InitiationOptimalCanopyArchitecture();	
		}
		else if ("berry_population".equals(initiation_method)) {
			return new InitiationBerryPopulation();	
		}
		else if ("standard".equals(initiation_method)) {
			return new InitiationStandard();
		}
		else if ("standardGridClone".equals(initiation_method)) {
			return new InitiationStandardGridClone();
		}
		else if ("fieldRandomCanopy".equals(initiation_method)) {
			return new InitiationFieldRandomCanopy();
		}
		else
		{
			return new InitiationArchReader(); // Default case
		}
	}
}

public abstract class InitiationService implements Serializable {
	public abstract void initiate();
	public static void initializeReportableFieldMetadata() {
	[ f:FieldBase ::> {
		f.isReportable = true;
		f.fieldInstanceId = 0;
	} ]
	[ t:Tile ::> {
		t.isReportable = true;
		t.fieldInstanceId = 0;
	} ]
	[ p:PlantIdentifier ::> {
		p.isReportable = true;
		p.fieldInstanceId = 0;
	} ]
	[ o:Organ ::> {
		o.isReportable = true;
		o.fieldInstanceId = 0;
		o.nodeID = o.getId();
	} ]
	[ s:Soil ::> {
		s.isReportable = true;
		s.fieldInstanceId = 0;
	} ]
}

public static long getMaxFieldBaseId() {
	long maxId = 1L;
	[ f:FieldBase ::> {
		if (f.getId() > maxId) maxId = f.getId();
	} ]
	return maxId;
}

public static void finalizeCloneFieldCopies(long fieldIdCutoff) {
	final java.util.ArrayList newFields = new java.util.ArrayList();
	[ f:FieldBase, (f.getId() > fieldIdCutoff) ::> {
		newFields.add(f);
	} ]
	if (newFields.isEmpty()) return;

	java.util.Collections.sort(newFields, new java.util.Comparator() {
		public int compare(Object a, Object b) {
			long idA = ((FieldBase) a).getId();
			long idB = ((FieldBase) b).getId();
			if (idA < idB) return -1;
			if (idA > idB) return 1;
			return 0;
		}
	});

	int originalPlantCount = Math.max(1, (int) totalPlants);
	int nextFieldInstanceId = 1;
	for (FieldBase existing : (* f:FieldBase *)) {
		nextFieldInstanceId = Math.max(nextFieldInstanceId, existing.fieldInstanceId + 1);
	}

	int i;
	for (i = 0; i < newFields.size(); i++) {
		FieldBase fb = (FieldBase) newFields.get(i);
		finalizeClonedField(fb, nextFieldInstanceId++, originalPlantCount);
	}
}

private static void finalizeClonedField(FieldBase fb, int fieldInstanceId, int originalPlantCount) {
	java.util.HashMap plantNumberMap = new java.util.HashMap();
	fb.isReportable = false;
	fb.fieldInstanceId = fieldInstanceId;

	for (PlantIdentifier pi : (* fb (-->)+ p:PlantIdentifier *)) {
		Integer oldPlant = Integer.valueOf(pi.plantNumber);
		Integer newPlant = (Integer) plantNumberMap.get(oldPlant);
		if (newPlant == null) {
			newPlant = Integer.valueOf(fieldInstanceId * originalPlantCount + pi.plantNumber);
			plantNumberMap.put(oldPlant, newPlant);
		}
		pi.plantNumber = newPlant.intValue();
		pi.isReportable = false;
		pi.fieldInstanceId = fieldInstanceId;

		if (pi instanceof PlantBase) {
			PlantBase pb = (PlantBase) pi;
			pb.nodeID = pb.getId();
			pb.rbID = 0L;
			pb.childTrunkID = 0L;
			pb.childStructuralRootID = 0L;
		}
	}

	for (Organ org : (* fb (-->)+ orgQuery:Organ *)) {
		Integer newPlant = (Integer) plantNumberMap.get(Integer.valueOf(org.plantNumber));
		if (newPlant != null) org.plantNumber = newPlant.intValue();
		org.isReportable = false;
		org.fieldInstanceId = fieldInstanceId;
		org.nodeID = org.getId();
		org.plantBaseID = 0L;
		org.parentID = 0L;

		if (org instanceof RootBase) {
			RootBase rb = (RootBase) org;
			rb.plantBaseID = 0L;
			rb.parentID = 0L;
			if (rb.frIDs != null) java.util.Arrays.fill(rb.frIDs, 0L);
			if (rb.srIDs != null) java.util.Arrays.fill(rb.srIDs, 0L);
			if (rb.slIDs != null) java.util.Arrays.fill(rb.slIDs, 0L);
		} else if (org instanceof FineRoot) {
			FineRoot fr = (FineRoot) org;
			fr.rbID = 0L;
			fr.slID = 0L;
		} else if (org instanceof StructuralRoot) {
			StructuralRoot sr = (StructuralRoot) org;
			sr.frID = 0L;
			sr.verticalParentID = 0L;
		}
	}

	for (Soil soilNode : (* fb (-->)+ soilQuery:Soil *)) {
		Integer newPlant = (Integer) plantNumberMap.get(Integer.valueOf(soilNode.plantNumber));
		if (newPlant != null) soilNode.plantNumber = newPlant.intValue();
		soilNode.isReportable = false;
		soilNode.fieldInstanceId = fieldInstanceId;
	}

	for (Tile tileNode : (* fb (-->)+ tileQuery:Tile *)) {
		Integer newPlant = (Integer) plantNumberMap.get(Integer.valueOf(tileNode.plantNumber));
		if (newPlant != null) tileNode.plantNumber = newPlant.intValue();
		tileNode.isReportable = false;
		tileNode.fieldInstanceId = fieldInstanceId;
	}

	for (PlantBase pb : (* fb (-->)+ p:PlantBase *)) {
		pb.nodeID = pb.getId();
		pb.isReportable = false;
		pb.fieldInstanceId = fieldInstanceId;

		Trunk tr = first((* pb (-->)+ trunkQuery:Trunk *));
		if (tr != null) {
			pb.childTrunkID = tr.getId();
		} else {
			Internode it = first((* pb (-->)+ internodeQuery:Internode *));
			if (it != null) pb.childTrunkID = it.getId();
		}

		StructuralRoot sr = first((* pb (-->)+ srt:StructuralRoot, (srt.layer == 0) *));
		if (sr != null) pb.childStructuralRootID = sr.getId();

		RootBase rb = first((* pb (-->)+ rbq:RootBase *));
		if (rb != null) {
			rb.nodeID = rb.getId();
			rb.parentID = pb.getId();
			rb.plantBaseID = pb.getId();
			pb.addRootBase(rb);
			rebuildRootCloneIds(pb, rb);
			pb.initializeCarbonTransport();
		}
	}

	for (Organ org : (* fb (-->)+ orgParentQuery:Organ *)) {
		PlantBase pb = first((* org (<--)+ parentPlantQuery:PlantBase *));
		Organ parent = first((* org (<--)+ parentOrganQuery:Organ *));
		if (pb != null) org.plantBaseID = pb.getId();
		org.parentID = (parent != null) ? parent.getId() : ((pb != null) ? pb.getId() : 0L);
	}

	for (GrowingOrgan growOrg : (* fb (-->)+ growOrgQuery:GrowingOrgan *)) {
		growOrg.initializeCarbonTransport();
	}
}

private static void rebuildRootCloneIds(PlantBase pb, RootBase rb) {
	int layers = Math.max(1, numofSoilLayers);
	if (rb.frIDs == null || rb.frIDs.length != layers) rb.frIDs = new long[layers];
	if (rb.srIDs == null || rb.srIDs.length != layers) rb.srIDs = new long[layers];
	if (rb.slIDs == null || rb.slIDs.length != layers) rb.slIDs = new long[layers];

	java.util.Arrays.fill(rb.frIDs, 0L);
	java.util.Arrays.fill(rb.srIDs, 0L);
	java.util.Arrays.fill(rb.slIDs, 0L);

	int layer;
	for (layer = 0; layer < layers; layer++) {
		Soil s = first((* sl:Soil, (sl.plantNumber == pb.plantNumber && sl.fieldInstanceId == pb.fieldInstanceId && sl.layer == layer) *));
		FineRoot fr = first((* fr1:FineRoot, (fr1.plantNumber == pb.plantNumber && fr1.fieldInstanceId == pb.fieldInstanceId && fr1.layer == layer) *));
		StructuralRoot sr = first((* sr1:StructuralRoot, (sr1.plantNumber == pb.plantNumber && sr1.fieldInstanceId == pb.fieldInstanceId && sr1.layer == layer) *));

		if (s != null) rb.slIDs[layer] = s.getId();
		if (fr != null) {
			rb.frIDs[layer] = fr.getId();
			fr.rbID = rb.getId();
			fr.plantBaseID = pb.getId();
			if (s != null) fr.slID = s.getId();
		}
		if (sr != null) {
			rb.srIDs[layer] = sr.getId();
			sr.plantBaseID = pb.getId();
			if (fr != null) sr.frID = fr.getId();
		}
	}

	rb.filterAndResizeArrays();
}

	/**
	 * Initialize the architecture if applicable by extending this class and overriding this method.
	 */
	public void initArchitecture();
}


/**
 * Abstract class for initiation methods.
 */
public abstract class InitArch implements Serializable {

    /**
     * Flag to indicate if roots have been initialized.
     */
    public static boolean rootsInitialised = false;

    /**
     * Flag to indicate if shoots have been initiated.
     */
    public static boolean shootsInitiated = false;

    /**
     * Counter for the number of bunches.
     */
    public static int bunchCount = 0;
    
    // 1. Validate soil parameters only
	static boolean validateSoilParams() {
		try {
			totalSoilDepth = sum((* s:Soil, (s[plantNumber] == 1) *)[length]);
			int layers = (int) count((* s:Soil, (s[plantNumber] == 1) *));
			if (layers != 0 && layers != numofSoilLayers && !useComplexRoot) {
				println("Validation error: Mismatch between numofSoilLayers and computed layers value");
				return false;
			}
			return true;
		} catch (Exception e) {
			println("Unexpected error during soil validation: " + e.getMessage());
			return false;
		}
	}
	
	// 2. Validate root proportions only
	static boolean validateRootProportions() {
		try {
			float frootProportion = sum((* f:FineRoot, (f[plantNumber] == 1) *)[fiRootProportion]);
			float srootProportion = sum((* f:StructuralRoot, (f[plantNumber] == 1) *)[stRootProportion]);
			if (frootProportion > 1 || srootProportion > 1 || (frootProportion + srootProportion) > 2.1) {
				println("Validation error: The sum of frootProportion and srootProportion needs to be 1");
				return false;
			}
			return true;
		} catch (Exception e) {
			println("Unexpected error during root proportion validation: " + e.getMessage());
			return false;
		}
	}
	
