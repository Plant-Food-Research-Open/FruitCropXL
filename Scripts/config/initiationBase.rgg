	// Wrapper method to orchestrate all checks
	public static void checkSoilParams() {
		boolean validSoil = validateSoilParams();
		if (!validSoil) {
			println("Soil validation failed. Resetting and re-initializing model.");
			mainInstance.reCompile();
			mainInstance.init();
			mainInstance.initiationService.initArchitecture();
			derive();
	
			validSoil = validateSoilParams();
			if (!validSoil) {
				println("Soil validation failed after re-initialization. Please check model setup.");
				return;  // early exit if soil validation fails again
			}
		}
	}
	
	public static void checkRootParams() {
		boolean validRoot = validateRootProportions();
		if (!validRoot) {
			println("Root proportion validation failed. Resetting and re-initializing model.");
