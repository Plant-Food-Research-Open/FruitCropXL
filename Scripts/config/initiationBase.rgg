			} */
		}
	}
public static void finalizeIDReference() {

    // Prefer totalPlants if set; otherwise count PlantBase by scanning
    int nPlants = (int) totalPlants;
    if (nPlants <= 0) {
        int nPlantsCount = 0;
        [ pscan:PlantBase ::> { nPlantsCount++; } ]
        nPlants = nPlantsCount;
    }

    for (int i = 1; i <= nPlants; i++) {
        // Use unique selector names to avoid "Duplicate declaration of local variable p"
        PlantBase pb = first((* pbq:PlantBase, (pbq.plantNumber == i) *));
        RootBase  rb = first((* rbq:RootBase,  (rbq.plantNumber == i) *));
        
        if (pb == null && rb == null) {
            // Nothing to do for this plantNumber
            continue;
        }

        if (pb != null) {
            // getId() is long; cast to int to fix "long not assignable to int"
            if (pb.nodeID <= 0) { pb.nodeID = (int) pb.getId(); }

            if (rb != null) {
                if (rb.nodeID <= 0) { rb.nodeID = (int) rb.getId(); }
                pb.addRootBase(rb);
            } else {
                println("⚠️ No RootBase found for plantNumber = " + i + " (skipping root linkage)");
            }

            // Only call if your implementation requires roots; otherwise guard it
            if (rb != null) {
                pb.initializeCarbonTransport();
            }

            // Link all organs for this plant to the PlantBase
            [
                o:Organ, (o.plantNumber == i && o.plantBaseID <= 0) ::> {
                    if (o.nodeID <= 0) { o.nodeID = (int) o.getId(); }
                    o.plantBaseID = pb.nodeID;
                }
            ]
        } else {
            println("⚠️ No PlantBase found for plantNumber = " + i);
        }

        if (rb != null) {
            rb.finalizeSoilRootIDs();
            rb.filterAndResizeArrays();
            initiationArchReader.InitArchReader.debugRootBaseCounts("[RootSoilGrid:linked]", rb);
            println("new soil grid number: " + rb.frIDs.length);
        }
    }
}


public static void setStructuralRootParentID()
{
  for (int i = 1; i <= totalPlants; i++) {

    PlantBase pb = first((* p:PlantBase, (p.plantNumber == i) *));
    int maxL = max((* r:StructuralRoot, (r.plantNumber==i) *)[layer]);
    println("maxL: " + maxL);

    // ---------- L >= 1 : link diagonally toward origin to the NEXT UPPER layer (L-1)
    for (int L = maxL; L >= 1; L--) {
      [
        r:StructuralRoot, (r.plantNumber==i & r.layer==L) ::> {
          int sx = (r.gridX > 0 ? 1 : (r.gridX < 0 ? -1 : 0));
          int sy = (r.gridY > 0 ? 1 : (r.gridY < 0 ? -1 : 0));
          int tx = r.gridX - sx;
          int ty = r.gridY - sy;

          StructuralRoot parent =
            first((* p:StructuralRoot,
                    (p.plantNumber==i & p.layer==L-1 &
                     p.gridX==tx & p.gridY==ty) *));
          if (parent == null && sx != 0)
            parent = first((* p:StructuralRoot,
                             (p.plantNumber==i & p.layer==L-1 &
                              p.gridX==tx & p.gridY==r.gridY) *));
          if (parent == null && sy != 0)
            parent = first((* p:StructuralRoot,
                             (p.plantNumber==i & p.layer==L-1 &
                              p.gridX==r.gridX & p.gridY==ty) *));
          if (parent == null)
            parent = first((* p:StructuralRoot,
                             (p.plantNumber==i & p.layer==L-1 &
                              p.gridX==0 & p.gridY==0) *));

          if (parent != null) {
            r.storeParentAndBacklink(parent);
           /*  println("Diag Z L" + L + ": " + r.getId() + " ("+r.gridX+","+r.gridY+") -> "
                    + parent.getId() + " ("+parent.gridX+","+parent.gridY+")"); */
          }
        }
      ]
    }

    // ---------- L == 0 : link diagonally toward origin within the SAME layer (0)
    [
      r0:StructuralRoot, (r0.plantNumber==i & r0.layer==0 &
                          !(r0.gridX==0 & r0.gridY==0)) ::> {
        int sx0 = (r0.gridX > 0 ? 1 : (r0.gridX < 0 ? -1 : 0));
        int sy0 = (r0.gridY > 0 ? 1 : (r0.gridY < 0 ? -1 : 0));
        int tx0 = r0.gridX - sx0;
        int ty0 = r0.gridY - sy0;

        StructuralRoot parent0 =
          first((* p:StructuralRoot,
                  (p.plantNumber==i & p.layer==0 &
                   p.gridX==tx0 & p.gridY==ty0) *));
        if (parent0 == null && sx0 != 0)
          parent0 = first((* p:StructuralRoot,
                           (p.plantNumber==i & p.layer==0 &
                            p.gridX==tx0 & p.gridY==r0.gridY) *));
        if (parent0 == null && sy0 != 0)
          parent0 = first((* p:StructuralRoot,
                           (p.plantNumber==i & p.layer==0 &
                            p.gridX==r0.gridX & p.gridY==ty0) *));
        if (parent0 == null)
          parent0 = first((* p:StructuralRoot,
                           (p.plantNumber==i & p.layer==0 &
                            p.gridX==0 & p.gridY==0) *));

        if (parent0 != null) {
          r0.storeParentAndBacklink(parent0);
          println("Diag XY L0: " + r0.getId() + " ("+r0.gridX+","+r0.gridY+") -> "
                  + parent0.getId() + " ("+parent0.gridX+","+parent0.gridY+")");
        }
      }
    ]

    // ---------- Anchor the hub (0,0,0) to PlantBase
    [
      base:StructuralRoot,
      ( base.plantNumber==i & base.layer==0 & base.gridX==0 & base.gridY==0 ) ::> {
        base.storeParentId(pb);
        pb.childStructuralRootID = base.getId();
        //println("Anchor: " + base.getId() + " -> PlantBase");
      }
    ]
  }
}




	

    
	public static void checkStatus()
    {
    	[
    		g:GrowingOrgan ::> {
    			g.initializeCarbonTransport();
    			g.update();
		}
		]
    	derive();
    	
    	totalBudNum = count((*b:BudService*)); 
		if (printFlag) println(" \n totalBudNum is: " + totalBudNum);
		
		long RosetteLeaf = count((* l:Leaf, (l.organType.contains("Rosette"))*));
		long otherLeaf = count((* l:Leaf, (!l.organType.contains("Rosette"))*));
		double leafArea = sum((* l:Leaf *).area);
		println( " \n RosetteLeaf : " + RosetteLeaf + "other: " + otherLeaf +
				" total leaf area: " + String.format("%.4f",leafArea));
		//handled by leaf planner now
				 
	}

