module DirectLight
{
	float power;				 // Radiation intensity for every node
	float anglecorection; 
	void update() {
		power = directRadiation + 1e-6;
		anglecorection = Math.max(0, Math.cos(toRadians(zenith)))+1e-6;
		// if (printFlag) { println("direct light  " + power); }
	}
		 
} 
