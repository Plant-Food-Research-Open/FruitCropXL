// diffuse sky light
module DiffuseLight
{
	float power;
	
	{
	numDiffuseLights = 72;
	numDiffuseLights = useTurtleRadiation ? 46 : 72;}
	float powers[] = new float[numDiffuseLights];
	//float[] turtlePowers = new float[numDiffuseLights];	// Power of each single light for when turtle radiation used

	void update() {		
		power = diffuseRadiation + 1e-6; 
		// if (printFlag) { println("diffuse light  " + power); }
		if (useTurtleRadiation == true) {
		     for (int i : (0 : numDiffuseLights - 1)) {
		     	 //0.51 is the correction factor for the incoming diffuse radition from a isotropic radiation distribution 
					   powers[i] = power*1/numDiffuseLights/0.517374915;	   
				   }
		   } else {
		   	   //the last column is the correction factor for the light from that angle cos(zenith)
		   	   for (int i : (0 : 11)) { powers[i] = power*0.003218/0.205; }
		   	   for (int i : (12 : 23)) { powers[i] = power*0.01163/0.563; }
		   	   for (int i : (24 : 35)) { powers[i] = power*0.019812/0.817; }
		   	   for (int i : (36 : 47)) { powers[i] = power*0.023022/0.945; }
		   	   for (int i : (48 : 59)) { powers[i] = power*0.018522/0.991; }
		   	   for (int i : (60 : 71)) { powers[i] = power*0.007096/0.998; }
		   }
	}
		
}
