static boolean isLightTreatmentActiveByDAWS(int currentDAWS) {
	if (modelOptions.useLightTreatment == false) return false;
	if (modelOptions.lightTreatmentStartDOY == 1 && modelOptions.lightTreatmentEndDOY >= 365) return true;
	int startDAWS = modelOptions.lightTreatmentStartDAWS;
	int endDAWS = modelOptions.lightTreatmentEndDAWS;
	if (startDAWS <= endDAWS) {
		return currentDAWS >= startDAWS && currentDAWS <= endDAWS;
	}
	return currentDAWS >= startDAWS || currentDAWS <= endDAWS;
}

static String getTimeZoneOffset(double longitude) {
        // Each time zone is roughly 15 degrees of longitude wide
        int timeZoneOffset = (int)Math.round(longitude / 15);

        // Adjust for UTC and format the string
        String offsetString;
        if(timeZoneOffset >= 0) {
            offsetString = "UTC+" + timeZoneOffset;
        } else {
            // Convert negative offset to positive and format
            offsetString = "UTC-" + Math.abs(timeZoneOffset);
        }

        return offsetString;
}
    
    
//note the model use solar noon, it is slightly different from the local time
//for example, in Bordeaux the solar noon is at 13:00 or 14:00 in the summer time due to the change of time
static float calcDayLength(int dayOfYear, float latitude) {

	float sinDelta = -Math.sin(tilt) * Math.cos(2*Math.PI*(dayOfYear+10)/365); //delta is the declination of the sun with respect to the earth equator
	float cosDelta = Math.sqrt(1-(sinDelta)**2);  
	float a = Math.sin(latitude)*sinDelta;  // the season-dependent solar shift with respect to the equator
	float b = Math.cos(latitude)*cosDelta;  // the season-dependent amlitude of tthe sine of solar height
	float dayLength = 12 *(1+(2/Math.PI)*Math.asin(a/b));

    return(dayLength);
}

static int calcSunriseTime(float dayLength) {
      float tsr = 12 - dayLength/2;			// time of sun rise
	  int sunrise = (int) Math.round(tsr);  //the hour of the model starts from 0, hour 1 means 1-2. the calculated sunrise is using 1 as start, thus need to minus 1
	  return(sunrise);
}

static int calcSunsetTime(float dayLength) {
      float tst = 12 + dayLength/2;			// time of sun rise
	  int sunset = Math.round(tst)+1;  //works better with NZ data
	  return(sunset);
}
//hourOfDay starts from 0, 7 o'clock represent the hourly mean condition between 6 to 7. thus larger than the sunrise hour is better
static boolean calcDaytime(int hourOfDay, int sunriseTime, int sunsetTime) { //check it is daytime or nighttime
	  return(hourOfDay > sunriseTime && hourOfDay < sunsetTime);
}

static float calcTemperature(float Tmax, float Tmin) {
     int hour_i = (hourOfDay - 6 < 1 ? hourOfDay-6 + 24 : hourOfDay-6);
	 return 0.5*((Tmax+Tmin)+(Tmax-Tmin)*Math.cos(Math.PI*(hour_i - 8)/12));
}

static float calcHumidity(float RHmax, float RHmin) {
     int hour_i = (hourOfDay - 6 < 1 ? hourOfDay-6 + 24 : hourOfDay-6);
	 return 0.5*((RHmax+RHmin)+(RHmax-RHmin)*Math.cos(Math.PI*(hour_i +4)/12));
}
 

