/**
 * Allows passing and setting by reference between module and classes.
 */
public class ModuleLength {
    public float value;

    public ModuleLength(float value) {
        this.value = value;
    }
}



module Soil extends M(length) implements Configurable {

    public SoilService service;

    public void setService(SoilService service) {
        this.service = service;

        this.service.length = new ModuleLength(length);
    }

    @Override 
    public void loadParameters() {
        this.service.loadParameters();
    }

    public void initiate(int i, PlantBase pb) {
        this.service.initiate(i, pb);
    }
} ==> 
